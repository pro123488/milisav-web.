local busy = {} -- evita que un jugador ejecute dos acciones a la vez

actionRemote.OnServerInvoke = function(player, actionName, payload)
	if type(actionName) ~= "string" or not Actions[actionName] then
		return { ok = false, message = "Acción desconocida." }
	end
	if not limiter:Allow(player) then
		return { ok = false, message = "Vas demasiado rápido. Espera un momento." }
	end
	if not DataService.Get(player) then
		return { ok = false, message = "Tu club todavía se está cargando." }
	end
	if busy[player] then
		return { ok = false, message = "Procesando la acción anterior…" }
	end
	busy[player] = true
	local success, ok, message, rerender, extra = pcall(Actions[actionName], player, payload)
	busy[player] = nil
	if not success then
		warn("[Main] Error en la acción ", actionName, " de ", player.Name, ": ", ok)
		return { ok = false, message = "Error del servidor. Inténtalo de nuevo." }
	end
	if rerender then
		PlotService.RequestRender(player)
	end
	if ok == true and ACTION_METRICS[actionName] then
		MissionService.Track(player, ACTION_METRICS[actionName], 1)
	end
	if ok == true and actionName == "HatchEgg" then
		MissionService.Track(player, "hatch", type(payload) == "table" and payload.amount == 3 and 3 or 1)
	end
	if ok == true and ACTION_XP[actionName] then
		SeasonService.AddXP(player, SeasonConfig.XP[ACTION_XP[actionName]])
	end
	if ok == true then
		MissionService.EvaluateAchievements(player)
	end
	pushState(player)
	return { ok = ok == true, message = message, data = extra }
end

-- ===== Ciclo de vida de los jugadores =====

local function onPlayerAdded(player)
	PlotService.Assign(player)
	GamePassService.PlayerAdded(player)
	task.spawn(AdminService.PlayerAdded, player)
	player.CharacterAdded:Connect(function()
		-- En pleno partido en grupo se reaparece en el campo, no en el estadio propio
		if not ArenaService.HandleRespawn(player) then
			PlotService.CharacterAdded(player)
		end
		task.spawn(OutfitService.CharacterAdded, player) -- vuelve a ponerse su traje de futbolista
		PetService.CharacterAdded(player) -- las mascotas equipadas vuelven a seguir al personaje nuevo
	end)

	local data = DataService.Load(player)
	if not data or not player.Parent then
		return
	end
	if not PlotService.GetPlot(player) then
		notifyRemote:FireClient(player, "error", "El servidor está lleno de estadios. Tu club funciona, pero tu estadio no se mostrará en este servidor.")
	end
	SquadService.EnsureSquad(data)
	MatchService.PlayerReady(player)
	TransferService.PlayerReady(player)
	LeagueService.PlayerReady(player)
	UniverseService.PlayerReady(player)
	NetworkService.PlayerReady(player)
	task.spawn(function()
		local rewardMessage = UniverseService.ClaimWeekly(player)
		if rewardMessage then
			notifyRemote:FireClient(player, "success", rewardMessage)
			pushState(player)
		end
	end)
	EconomyService.PlayerReady(player)
	SponsorService.PlayerReady(player)
	PlotService.Render(player)
	InteractionService.SetBallSkin(PlotService.GetPlot(player), data.collection.ball)
	if player.Character then
		PlotService.TeleportHome(player)
		task.spawn(PetService.CharacterAdded, player)
		task.spawn(OutfitService.CharacterAdded, player)
	end
	SeasonService.DailyLogin(player)
	pushState(player)
	if not DataService.IsSaveEnabled(player) then
		notifyRemote:FireClient(player, "warning", "Guardado desactivado en esta sesión (DataStore no disponible). Tu progreso no se guardará.")
	end
	if DataService.IsNew(player) then
		notifyRemote:FireClient(player, "info", "¡Bienvenido, presidente! Ponle nombre a tu club en «Mi club».")
	end
end

local function onPlayerRemoving(player)
	EconomyService.PlayerRemoving(player)
	GamePassService.PlayerRemoving(player)
	limiter:Remove(player)
	busy[player] = nil
	lastSent[player] = nil
	UniverseService.PlayerRemoving(player) -- último perfil público antes de liberar los datos
	HalloweenService.PlayerRemoving(player)
	NetworkService.PlayerRemoving(player)
	ArenaService.PlayerRemoving(player)
	LeaderboardService.PlayerRemoving(player) -- guarda sus goles antes de liberar los datos
	AdminService.PlayerRemoving(player)
	PetService.PlayerRemoving(player)
	DataService.Release(player)
	PlotService.Release(player)
end

-- Cuando cambia la propiedad de un pase: se reconstruye el estadio y se actualiza la interfaz.
GamePassService.OnOwnershipChanged(function(player)
	if DataService.Get(player) then
		PlotService.RequestRender(player)
		pushState(player)
	end
end)

GamePassService.OnPurchaseConfirmed(function(player, passKey)
	local data = DataService.Get(player)
	if data then
		-- Registro informativo; NUNCA se usa como prueba de propiedad.
		table.insert(data.premium.purchaseLog, { pass = passKey, t = os.time() })
		while #data.premium.purchaseLog > 20 do
			table.remove(data.premium.purchaseLog, 1)
		end
	end
end)

EconomyService.OnCycle(function(player, cycle)
	local sponsorMessages = SponsorService.AfterCycle(player)
	for _, message in ipairs(sponsorMessages) do
		notifyRemote:FireClient(player, "info", message)
	end
	if #sponsorMessages > 0 then
		PlotService.RequestRender(player) -- quita vallas o nombre del estadio caducados
	end
	-- Liga y copa ANTES de que SquadService avance el reloj de la temporada
	local clubData = DataService.Get(player)
	if clubData then
		local leagueOut = LeagueService.AfterCycle(player, ClubService.DisplayName(clubData), ClubService.ShortName(clubData))
		for _, message in ipairs(leagueOut.messages) do
			notifyRemote:FireClient(player, "info", message)
		end
		UniverseService.AddWeeklyPoints(player, leagueOut.points)
		if leagueOut.result then
			notifyRemote:FireClient(player, "match", leagueOut.result) -- resumen para el visor de partidos
			PlotService.RequestRender(player) -- marcador y sala de trofeos
		end
	end
	for _, message in ipairs(SquadService.AfterCycle(player)) do
		notifyRemote:FireClient(player, "info", message)
	end
	for _, message in ipairs(TransferService.AfterCycle(player)) do -- después de SquadService (fin de cesiones)
		notifyRemote:FireClient(player, "info", message)
	end
	for _, message in ipairs(MatchService.AfterCycle(player)) do
		notifyRemote:FireClient(player, "info", message)
	end
	HistoryService.AfterCycle(player)
	MissionService.Track(player, "cycles", 1)
	SeasonService.AddXP(player, SeasonConfig.XP.cycle)
	MissionService.EvaluateAchievements(player)
	PlotService.UpdateCrowd(player, cycle.occupancy)
	pushState(player)
	local data = DataService.Get(player)
	if data and data.settings.notifications then
		notifyRemote:FireClient(player, cycle.net >= 0 and "success" or "warning",
			string.format("Jornada: %d espectadores · balance %s%d %s", cycle.attendance,
				cycle.net >= 0 and "+" or "", cycle.net, GameConfig.CURRENCY))
	end
end)

-- ===== Arranque =====
PlotService.CreateWorld()
DataService.Start()
GamePassService.Start()
EconomyService.Start()
UniverseService.Start()
InteractionService.OnFacility(HalloweenService.AttachDoor)
InteractionService.Start()
TournamentService.Start()
CommunityService.Start()
MatchService.OnUserMatch(function(player, _, goalsFor, goalsAgainst)
	MissionService.Track(player, "matches", 1)
	MissionService.Track(player, "goals", goalsFor)
	if goalsFor > goalsAgainst then
		MissionService.Track(player, "wins", 1)
	end
end)
HalloweenService.OnCandy(function(player, amount)
	MissionService.Track(player, "candy", amount)
end)
HalloweenService.Start()
ArenaService.OnMatchEnd(function(player, goals, teamGoals, otherGoals, result, isMvp)
	local trophyDelta = TrophyService.AfterMatch(player, result, goals, isMvp)
	if trophyDelta > 0 then
		MissionService.Track(player, "trophies", trophyDelta)
	end
	MissionService.Track(player, "arena", 1)
	PlotService.RefreshNameTag(player)
	MissionService.Track(player, "matches", 1)
	MissionService.Track(player, "goals", goals)
	if teamGoals > otherGoals then
		MissionService.Track(player, "wins", 1)
	end
	MissionService.EvaluateAchievements(player)
	local data = DataService.Get(player)
	if data then
		data.stats.arenaMatches += 1
		data.stats.arenaGoals += goals
		if teamGoals > otherGoals then
			data.stats.arenaWins += 1
		end
	end
	SeasonService.AddXP(player, SeasonConfig.XP.match + (teamGoals > otherGoals and SeasonConfig.XP.win or 0)
		+ math.min(goals, SeasonConfig.MAX_GOALS_XP) * SeasonConfig.XP.goal)
	LeaderboardService.Submit(player) -- clasificación mundial de goleadores
	pushState(player) -- dinero, misiones, pase y tabla de líderes al momento
end)
AdminService.Start()
HubService.Start()
LeaderboardService.OnUpdate(HubService.SetLeaderboard)
LeaderboardService.Start()
SeasonService.Start()
SeasonService.OnChanged(function(player)
	if DataService.Get(player) then
		pushState(player)
	end
end)
PetService.Start()
PetService.OnBallChanged(function(player, ballId)
	InteractionService.SetBallSkin(PlotService.GetPlot(player), ballId)
end)
ArenaService.Start()

Players.PlayerAdded:Connect(onPlayerAdded)
Players.PlayerRemoving:Connect(onPlayerRemoving)
for _, player in ipairs(Players:GetPlayers()) do
	task.spawn(onPlayerAdded, player)
end

-- Envío periódico ligero del estado (cuenta atrás del ciclo, etc.)
task.spawn(function()
	while true do
		task.wait(15)
		for _, player in ipairs(Players:GetPlayers()) do
			pushState(player)
		end
	end
end)

print(string.format("[%s] Servidor iniciado · versión %s", GameConfig.GAME_NAME, GameConfig.VERSION))
]]></ProtectedString></Properties></Item><Item class="Folder" referent="RBX0000004C"><Properties><string name="Name">Services</string></Properties><Item class="ModuleScript" referent="RBX0000002C"><Properties><string name="Name">AdminService</string><ProtectedString name="Source"><![CDATA[-- AdminService (ModuleScript)
-- Ubicación: ServerScriptService/Server/Services/AdminService
--
-- EVENTOS «ADMIN ABUSE». Solo los admins (decidido aquí, en el servidor) pueden lanzarlos.
-- Cada evento se aplica en este servidor y se publica con MessagingService para que llegue
-- a TODOS los servidores del juego a la vez.
--   * Recompensas x2     -> multiplica las recompensas de los partidos en grupo y las monedas.
--   * Supervelocidad     -> atributo global que el cliente aplica a su velocidad.
--   * Lluvia de monedas  -> monedas por los estadios; cada una da dinero al club (validado aquí).
--   * Balón de oro       -> los goles de los partidos en grupo dan x3 de recompensa.
--   * Suerte x2          -> más probabilidad de rarezas altas en huevos y cajas de balones.
--   * Anuncio            -> mensaje (filtrado por Roblox) en pantalla para todos.

local MessagingService = game:GetService("MessagingService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TextService = game:GetService("TextService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage.Shared
local AdminConfig = require(Shared.Config.AdminConfig)
local Remotes = require(Shared.Modules.Remotes)

local DataService = require(script.Parent.DataService)
local EconomyService = require(script.Parent.EconomyService)
local PlotService = require(script.Parent.PlotService)

local AdminService = {}

local notifyRemote = Remotes.Get("Notify")
local admins = {} -- [player] = true
local activeUntil = {} -- [id del evento] = os.time() en que termina
local lastLaunch = {} -- [id del evento] = os.clock() (espera entre lanzamientos en este servidor)
local lastAnnounce = 0
local rng = Random.new()
local coinFolder

local function attributeName(id)
	return "FEU_Event_" .. id
end

-- ===== ¿Quién es admin? =====

local function computeIsAdmin(player)
	if RunService:IsStudio() then
		return true
	end
	if table.find(AdminConfig.ADMIN_USER_IDS, player.UserId) then
		return true
	end
	if game.CreatorType == Enum.CreatorType.User then
		return player.UserId == game.CreatorId
	end
	local ok, rank = pcall(function()
		return player:GetRankInGroup(game.CreatorId)
	end)
	return ok and type(rank) == "number" and rank >= AdminConfig.GROUP_MIN_RANK
end

function AdminService.IsAdmin(player)
	return admins[player] == true
end

-- ===== Efectos =====

function AdminService.IsActive(id)
	local untilTime = activeUntil[id]
	return untilTime ~= nil and os.time() < untilTime
end

function AdminService.RewardMultiplier()
	return AdminService.IsActive("double") and 2 or 1
end

function AdminService.GoalMultiplier()
	local event = AdminConfig.Event("goldball")
	return AdminService.IsActive("goldball") and event.goalMultiplier or 1
end

-- Multiplica las probabilidades de rareza épica o superior en huevos y cajas de balones.
function AdminService.LuckMultiplier()
	local event = AdminConfig.Event("luck")
	return AdminService.IsActive("luck") and event.luckMultiplier or 1
end

local function spawnCoin(origin, value)
	local coin = Instance.new("Part")
	coin.Name = "AdminCoin"
	coin.Shape = Enum.PartType.Cylinder
	coin.Size = Vector3.new(0.4, 2.4, 2.4)
	coin.Material = Enum.Material.Neon
	coin.Color = Color3.fromRGB(255, 205, 40)
	coin.Anchored = true
	coin.CanCollide = false
	local spot = Vector3.new(rng:NextInteger(-60, 60), 2, rng:NextInteger(-30, 95))
	coin.CFrame = origin * CFrame.new(spot) * CFrame.Angles(0, rng:NextNumber(0, math.pi), math.pi / 2)
	coin:SetAttribute("Value", value)
	coin.Parent = coinFolder
	local taken = false
	coin.Touched:Connect(function(hit)
		if taken then
			return
		end
		local character = hit:FindFirstAncestorOfClass("Model")
		local player = character and Players:GetPlayerFromCharacter(character)
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if not player or not humanoid or humanoid.Health <= 0 or not DataService.Get(player) then
			return
		end
		taken = true
		coin:Destroy()
		local amount = value * AdminService.RewardMultiplier()
		EconomyService.Earn(player, amount, EconomyService.Category.ADMIN_EVENT, "Lluvia de monedas")
		notifyRemote:FireClient(player, "coin", { gained = amount })
	end)
	task.delay(90, function()
		if coin.Parent then
			coin:Destroy()
		end
	end)
end

local function coinRain(event)
	local origins = {}
	for _, player in ipairs(Players:GetPlayers()) do
		local plot = PlotService.GetPlot(player)
		if plot then
			table.insert(origins, plot.origin)
		end
	end
	if #origins == 0 then
		return
	end
	-- Las monedas caen poco a poco durante el minuto del evento
	task.spawn(function()
		for wave = 1, 5 do
			for _, origin in ipairs(origins) do
				for _ = 1, math.ceil(event.coinsPerPlot / 5) do
					spawnCoin(origin, event.coinValue)
				end
			end
			if wave < 5 then
				task.wait(event.minutes * 60 / 5)
			end
		end
	end)
end

-- Aplica un evento en ESTE servidor (llamado al lanzarlo aquí o al recibirlo de otro servidor).
local function apply(id, byName)
	local event = AdminConfig.Event(id)
	if not event then
		return
	end
	local endsAt = os.time() + event.minutes * 60
	activeUntil[id] = endsAt
	Workspace:SetAttribute(attributeName(id), endsAt)
	if event.speedMultiplier then
		Workspace:SetAttribute("FEU_SpeedMultiplier", event.speedMultiplier)
	end
	if id == "coinrain" then
		coinRain(event)
	end
	notifyRemote:FireAllClients("admin", { icon = event.icon, text = event.text, by = byName })
	task.delay(event.minutes * 60, function()
		if activeUntil[id] == endsAt then
			activeUntil[id] = nil
			Workspace:SetAttribute(attributeName(id), nil)
			if event.speedMultiplier then
				Workspace:SetAttribute("FEU_SpeedMultiplier", nil)
			end
		end
	end)
end

local function publish(message)
	message.server = game.JobId
	task.spawn(function()
		local ok, err = pcall(function()
			MessagingService:PublishAsync(AdminConfig.MESSAGING_TOPIC, message)
		end)
		if not ok then
			warn("[AdminService] No se pudo enviar el evento a otros servidores: ", err)
		end
	end)
end

-- ===== Acciones (Action remote) =====

function AdminService.Launch(player, payload)
	if not AdminService.IsAdmin(player) then
		return false, "Solo los admins pueden lanzar eventos."
	end
	local id = type(payload) == "table" and payload.id
	local event = type(id) == "string" and AdminConfig.Event(id)
	if not event then
		return false, "Evento no válido."
	end
	local last = lastLaunch[id]
	if last and os.clock() - last < event.cooldown then
		return false, string.format("Espera %d s para volver a lanzar %s.", math.ceil(event.cooldown - (os.clock() - last)), event.name)
	end
	lastLaunch[id] = os.clock()
	apply(id, player.DisplayName)
	publish({ kind = "event", id = id, by = player.DisplayName })
	return true, string.format("%s %s lanzado en todos los servidores.", event.icon, event.name)
end

local function filterBroadcast(player, text)
	local ok, result = pcall(function()
		local filtered = TextService:FilterStringAsync(text, player.UserId, Enum.TextFilterContext.PublicChat)
		return filtered:GetNonChatStringForBroadcastAsync()
	end)
	return ok and result or nil
end

function AdminService.Announce(player, payload)
	if not AdminService.IsAdmin(player) then
		return false, "Solo los admins pueden enviar anuncios."
	end
	local text = type(payload) == "table" and payload.text
	if type(text) ~= "string" then
		return false, "Escribe un mensaje."
	end
	text = text:gsub("[%c]", " "):gsub("^%s+", ""):gsub("%s+$", "")
	local length = utf8.len(text)
	if not length or length == 0 or length > AdminConfig.ANNOUNCE_MAX_LENGTH then
		return false, string.format("El anuncio debe tener entre 1 y %d caracteres.", AdminConfig.ANNOUNCE_MAX_LENGTH)
	end
	if os.clock() - lastAnnounce < 10 then
		return false, "Espera unos segundos entre anuncios."
	end
	local filtered = filterBroadcast(player, text)
	if not filtered then
		return false, "Roblox no pudo revisar el mensaje. Inténtalo de nuevo."
	end
	lastAnnounce = os.clock()
	notifyRemote:FireAllClients("admin", { icon = "📢", text = filtered, by = player.DisplayName })
	publish({ kind = "announce", text = filtered, by = player.DisplayName })
	return true, "Anuncio enviado a todos los servidores."
end

-- Estado para el panel (solo se envía a los admins).
function AdminService.BuildState(player)
	if not AdminService.IsAdmin(player) then
		return nil
	end
	local events = {}
	for _, event in ipairs(AdminConfig.Events) do
		local last = lastLaunch[event.id]
		table.insert(events, {
			id = event.id, icon = event.icon, name = event.name, minutes = event.minutes,
			activeUntil = activeUntil[event.id],
			cooldownLeft = last and math.max(0, math.ceil(event.cooldown - (os.clock() - last))) or 0,
		})
	end
	return { events = events, maxAnnounce = AdminConfig.ANNOUNCE_MAX_LENGTH }
end

function AdminService.PlayerAdded(player)
	admins[player] = computeIsAdmin(player)
end

function AdminService.PlayerRemoving(player)
	admins[player] = nil
end

function AdminService.Start()
	coinFolder = Instance.new("Folder")
	coinFolder.Name = "AdminCoins"
	coinFolder.Parent = Workspace
	task.spawn(function()
		local ok, err = pcall(function()
			MessagingService:SubscribeAsync(AdminConfig.MESSAGING_TOPIC, function(message)
				local data = type(message) == "table" and message.Data
				if type(data) ~= "table" or data.server == game.JobId then
					return
				end
				local by = type(data.by) == "string" and data.by or "Admin"
				if data.kind == "event" and type(data.id) == "string" then
					apply(data.id, by)
				elseif data.kind == "announce" and type(data.text) == "string" then
					notifyRemote:FireAllClients("admin", { icon = "📢", text = data.text, by = by })
				end
			end)
		end)
		if not ok then
			warn("[AdminService] Sin eventos entre servidores (MessagingService): ", err)
		end
	end)
end

return AdminService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000002D"><Properties><string name="Name">ArenaService</string><ProtectedString name="Source"><![CDATA[-- ArenaService (ModuleScript)
-- Ubicación: ServerScriptService/Server/Services/ArenaService
--
-- PARTIDOS EN GRUPO: fútbol jugable en tiempo real.
--   * Cola: botón «JUGAR PARTIDO» o la plataforma de la avenida (tecla E). Cuenta atrás y a jugar.
--   * Equipos Rojo y Azul repartidos al azar; los huecos se rellenan con bots.
--   * Balón controlado por el SERVIDOR: el cliente solo pide «chutar con esta fuerza»;
--     aquí se comprueba que está cerca del balón, en partido y sin abusar del botón.
--   * Goles, marcador, tiempo, celebración y recompensas en dinero del club (con límite por hora).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Teams = game:GetService("Teams")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage.Shared
local Cfg = require(Shared.Config.ArenaConfig)
local SoundConfig = require(Shared.Config.SoundConfig)
local WeeklyConfig = require(Shared.Config.WeeklyConfig)
local RebirthConfig = require(Shared.Config.RebirthConfig)
local Remotes = require(Shared.Modules.Remotes)

local DataService = require(script.Parent.DataService)
local EconomyService = require(script.Parent.EconomyService)
local PlotService = require(script.Parent.PlotService)
local AdminService = require(script.Parent.AdminService)
local PetService = require(script.Parent.PetService)
local BallSkin = require(script.Parent.Parent.Util.BallSkin)

local ArenaService = {}

local arenaRemote = Remotes.Get("Arena")
local notifyRemote = Remotes.Get("Notify")

local HALF_L = Cfg.FIELD_LENGTH / 2
local HALF_W = Cfg.FIELD_WIDTH / 2
local WHITE = Color3.fromRGB(245, 245, 245)

local folder -- Folder del estadio de partidos
local scoreboardLabel
local teamObjects = {} -- [teamId] = Team
local floorPart
local pitchParts = {} -- franjas del césped (para cambiar de estadio)
local lineParts = {}
local currentTheme = Cfg.Themes[1]
local ball
local kickSound
local rng = Random.new()

-- Estado del partido
local queue = {} -- lista de jugadores
local phase = "idle" -- idle | countdown | kickoff | playing | goal | result
local countdownEnds = 0
local remaining = 0
local goldenGoal = false -- prórroga a gol de oro tras un empate
local score = { red = 0, blue = 0 }
local participants = {} -- [player] = { team, goals }
local bots = {} -- lista { model, team, name, keeper, lastKick, slot }
local lastTouch = nil -- { name, team, player? }
local pendingGoal = nil -- equipo que ha marcado y aún no se ha celebrado
local lastResult = nil
local kickCooldown = {} -- [player] = os.clock()
local dribbleCooldown = {} -- [player] = os.clock()
local rewardLog = {} -- [userId] = { os.time() de partidos premiados }
local endCallbacks = {}

local passBall, findMate -- definidas más abajo

local function teamInfo(id)
	return id == "red" and Cfg.TEAMS[1] or Cfg.TEAMS[2]
end

-- Rojo defiende la portería de -X y ataca hacia +X; Azul al revés.
local function defendSign(team)
	return team == "red" and -1 or 1
end

local function toWorld(x, y, z)
	return (Cfg.ORIGIN * CFrame.new(x, y, z)).Position
end

local function toLocal(position)
	return Cfg.ORIGIN:PointToObjectSpace(position)
end

-- ===== Construcción del estadio =====

local function part(props)
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for key, value in pairs(props) do
		if key ~= "Parent" then
			p[key] = value
		end
	end
	p.Parent = props.Parent or folder
	return p
end

local function line(x, z, sx, sz)
	table.insert(lineParts, part({ Name = "Line", Size = Vector3.new(sx, 0.06, sz), CFrame = Cfg.ORIGIN * CFrame.new(x, 0.03, z),
		Color = WHITE, Material = Enum.Material.SmoothPlastic, CanCollide = false, CanQuery = false }))
end

local function materialOf(name, fallback)
	local ok, value = pcall(function()
		return Enum.Material[name]
	end)
	return ok and value or fallback
end

-- Cambia el aspecto del estadio (césped, suelo y líneas). No toca medidas ni física.
local function applyTheme(theme)
	currentTheme = theme
	local pitchMaterial = materialOf(theme.pitchMaterial, Enum.Material.Grass)
	for i, stripe in ipairs(pitchParts) do
		stripe.Color = i % 2 == 1 and theme.pitchA or theme.pitchB
		stripe.Material = pitchMaterial
	end
	if floorPart then
		floorPart.Color = theme.floor
		floorPart.Material = materialOf(theme.floorMaterial, Enum.Material.Grass)
	end
	local lineMaterial = materialOf(theme.lineMaterial or "SmoothPlastic", Enum.Material.SmoothPlastic)
	for _, linePart in ipairs(lineParts) do
		linePart.Color = theme.line
		linePart.Material = lineMaterial
	end
end

-- El estadio destacado de la semana sale la mitad de las veces; el resto, uno al azar.
local function pickTheme()
	if rng:NextNumber() < Cfg.FEATURED_THEME_CHANCE then
		return Cfg.Theme(WeeklyConfig.Current().themeId)
	end
	return Cfg.Themes[rng:NextInteger(1, #Cfg.Themes)]
end

local function buildGoal(sign)
	local x = sign * (HALF_L + Cfg.GOAL_DEPTH / 2)
	local backX = sign * (HALF_L + Cfg.GOAL_DEPTH)
	local net = { Color = WHITE, Material = Enum.Material.ForceField, Transparency = 0.2 }
	local function netPart(name, size, cf)
		local p = part({ Name = name, Size = size, CFrame = cf, Color = net.Color, Material = net.Material, Transparency = net.Transparency })
		return p
	end
	netPart("NetBack", Vector3.new(0.5, Cfg.GOAL_HEIGHT, Cfg.GOAL_WIDTH), Cfg.ORIGIN * CFrame.new(backX, Cfg.GOAL_HEIGHT / 2, 0))
	netPart("NetTop", Vector3.new(Cfg.GOAL_DEPTH, 0.5, Cfg.GOAL_WIDTH), Cfg.ORIGIN * CFrame.new(x, Cfg.GOAL_HEIGHT, 0))
	for _, side in ipairs({ -1, 1 }) do
		netPart("NetSide", Vector3.new(Cfg.GOAL_DEPTH, Cfg.GOAL_HEIGHT, 0.5), Cfg.ORIGIN * CFrame.new(x, Cfg.GOAL_HEIGHT / 2, side * Cfg.GOAL_WIDTH / 2))
		part({ Name = "Post", Shape = Enum.PartType.Cylinder, Size = Vector3.new(Cfg.GOAL_HEIGHT, 1, 1),
			CFrame = Cfg.ORIGIN * CFrame.new(sign * HALF_L, Cfg.GOAL_HEIGHT / 2, side * Cfg.GOAL_WIDTH / 2) * CFrame.Angles(0, 0, math.pi / 2),
			Color = WHITE, Material = Enum.Material.SmoothPlastic })
	end
	part({ Name = "Crossbar", Shape = Enum.PartType.Cylinder, Size = Vector3.new(Cfg.GOAL_WIDTH + 1, 1, 1),
		CFrame = Cfg.ORIGIN * CFrame.new(sign * HALF_L, Cfg.GOAL_HEIGHT, 0) * CFrame.Angles(0, math.pi / 2, 0),
		Color = WHITE, Material = Enum.Material.SmoothPlastic })
	-- Suelo dentro de la portería
	part({ Name = "GoalFloor", Size = Vector3.new(Cfg.GOAL_DEPTH, 1, Cfg.GOAL_WIDTH), CFrame = Cfg.ORIGIN * CFrame.new(x, -0.5, 0),
		Color = Color3.fromRGB(60, 140, 60), Material = Enum.Material.Grass })
end

local function buildWalls()
	local glass = { Transparency = 0.85, Color = Color3.fromRGB(200, 230, 255), Material = Enum.Material.Glass }
	local h = Cfg.WALL_HEIGHT
	-- Laterales (a lo largo de X)
	for _, side in ipairs({ -1, 1 }) do
		part({ Name = "Wall", Size = Vector3.new(Cfg.FIELD_LENGTH + 2, h, 1), CFrame = Cfg.ORIGIN * CFrame.new(0, h / 2, side * (HALF_W + 0.5)),
			Transparency = glass.Transparency, Color = glass.Color, Material = glass.Material })
	end
	-- Fondos, con hueco para la portería
	local segment = HALF_W - Cfg.GOAL_WIDTH / 2
	for _, sign in ipairs({ -1, 1 }) do
		for _, side in ipairs({ -1, 1 }) do
			part({ Name = "Wall", Size = Vector3.new(1, h, segment), CFrame = Cfg.ORIGIN * CFrame.new(sign * (HALF_L + 0.5), h / 2, side * (Cfg.GOAL_WIDTH / 2 + segment / 2)),
				Transparency = glass.Transparency, Color = glass.Color, Material = glass.Material })
		end
		part({ Name = "Wall", Size = Vector3.new(1, h - Cfg.GOAL_HEIGHT, Cfg.GOAL_WIDTH), CFrame = Cfg.ORIGIN * CFrame.new(sign * (HALF_L + 0.5), Cfg.GOAL_HEIGHT + (h - Cfg.GOAL_HEIGHT) / 2, 0),
			Transparency = glass.Transparency, Color = glass.Color, Material = glass.Material })
	end
	-- Techo invisible: el balón nunca sale del campo
	part({ Name = "Ceiling", Size = Vector3.new(Cfg.FIELD_LENGTH + 2 * Cfg.GOAL_DEPTH + 4, 1, Cfg.FIELD_WIDTH + 4), CFrame = Cfg.ORIGIN * CFrame.new(0, h, 0),
		Transparency = 1, CanQuery = false })
end

local function buildStands()
	for _, side in ipairs({ -1, 1 }) do
		for row = 1, 6 do
			local team = side < 0 and Cfg.TEAMS[1] or Cfg.TEAMS[2]
			part({ Name = "Stand", Size = Vector3.new(Cfg.FIELD_LENGTH + 20, 2, 4),
				CFrame = Cfg.ORIGIN * CFrame.new(0, row * 2 - 1, side * (HALF_W + 4 + row * 4)),
				Color = row % 2 == 0 and team.color or Color3.fromRGB(40, 45, 60), Material = Enum.Material.SmoothPlastic })
		end
	end
	for _, cx in ipairs({ -1, 1 }) do
		for _, cz in ipairs({ -1, 1 }) do
			local base = Cfg.ORIGIN * CFrame.new(cx * (HALF_L + 18), 0, cz * (HALF_W + 34))
			part({ Name = "LightPole", Size = Vector3.new(2, 60, 2), CFrame = base * CFrame.new(0, 30, 0), Color = Color3.fromRGB(30, 30, 40) })
			local lamp = part({ Name = "Lamp", Size = Vector3.new(10, 4, 2), CFrame = base * CFrame.new(0, 61, 0), Color = Color3.fromRGB(255, 250, 220), Material = Enum.Material.Neon })
			local light = Instance.new("SpotLight")
			light.Face = Enum.NormalId.Bottom
			light.Range = 60
			light.Angle = 120
			light.Brightness = 3
			light.Parent = lamp
		end
	end
end

local function buildScoreboard()
	local board = part({ Name = "Scoreboard", Size = Vector3.new(44, 14, 1),
		CFrame = Cfg.ORIGIN * CFrame.new(0, 34, -(HALF_W + 34)) , Color = Color3.fromRGB(15, 18, 28) })
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Back
	gui.CanvasSize = Vector2.new(880, 280)
	gui.Parent = board
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.TextColor3 = Color3.new(1, 1, 1)
	label.Font = Enum.Font.GothamBlack
	label.TextScaled = true
	label.RichText = true
	label.Text = "⚽ PARTIDOS EN GRUPO"
	label.Parent = gui
	scoreboardLabel = label
end

local function buildArena()
	folder = Instance.new("Folder")
	folder.Name = "PartidosEnGrupo"
	folder.Parent = Workspace
	-- Suelo y franjas
	floorPart = part({ Name = "Floor", Size = Vector3.new(Cfg.FIELD_LENGTH + 120, 1, Cfg.FIELD_WIDTH + 120), CFrame = Cfg.ORIGIN * CFrame.new(0, -0.6, 0),
		Color = Color3.fromRGB(70, 110, 60), Material = Enum.Material.Grass })
	local stripes = 10
	for i = 0, stripes - 1 do
		table.insert(pitchParts, part({ Name = "Pitch", Size = Vector3.new(Cfg.FIELD_LENGTH / stripes, 1, Cfg.FIELD_WIDTH),
			CFrame = Cfg.ORIGIN * CFrame.new(-HALF_L + (i + 0.5) * Cfg.FIELD_LENGTH / stripes, -0.5, 0),
			Color = i % 2 == 0 and Color3.fromRGB(52, 150, 64) or Color3.fromRGB(62, 168, 74), Material = Enum.Material.Grass }))
	end
	-- Líneas
	line(0, -HALF_W + 0.5, Cfg.FIELD_LENGTH, 0.6)
	line(0, HALF_W - 0.5, Cfg.FIELD_LENGTH, 0.6)
	line(-HALF_L + 0.5, 0, 0.6, Cfg.FIELD_WIDTH)
	line(HALF_L - 0.5, 0, 0.6, Cfg.FIELD_WIDTH)
	line(0, 0, 0.6, Cfg.FIELD_WIDTH)
	for i = 0, 23 do
		local a = i / 24 * math.pi * 2
		local p = part({ Name = "Line", Size = Vector3.new(0.6, 0.06, 4.2), Color = WHITE, CanCollide = false, CanQuery = false,
			CFrame = Cfg.ORIGIN * CFrame.new(math.cos(a) * 15, 0.03, math.sin(a) * 15) * CFrame.Angles(0, -a, 0) })
		p.Material = Enum.Material.SmoothPlastic
		table.insert(lineParts, p)
	end
	for _, sign in ipairs({ -1, 1 }) do
		line(sign * (HALF_L - 18), 0, 0.6, 50)
		line(sign * (HALF_L - 9), -25, 18, 0.6)
		line(sign * (HALF_L - 9), 25, 18, 0.6)
		buildGoal(sign)
	end
	buildWalls()
	buildStands()
	buildScoreboard()
end

-- Plataforma en la avenida para apuntarse con la tecla E
local function buildLobbyPad()
	local pad = part({ Name = "ArenaPad", Parent = folder, Size = Vector3.new(16, 0.6, 16), CFrame = Cfg.LOBBY_PAD * CFrame.new(0, 0.3, 0),
		Color = Color3.fromRGB(40, 220, 120), Material = Enum.Material.Neon, CanCollide = false })
	local sign = Instance.new("BillboardGui")
	sign.Size = UDim2.fromOffset(260, 70)
	sign.StudsOffset = Vector3.new(0, 7, 0)
	sign.AlwaysOnTop = false
	sign.MaxDistance = 140
	sign.Parent = pad
	local text = Instance.new("TextLabel")
	text.Size = UDim2.fromScale(1, 1)
	text.BackgroundTransparency = 1
	text.Font = Enum.Font.GothamBlack
	text.TextScaled = true
	text.TextColor3 = Color3.new(1, 1, 1)
	text.TextStrokeTransparency = 0.3
	text.Text = "⚽ PARTIDOS EN GRUPO"
	text.Parent = sign
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Jugar partido"
	prompt.ObjectText = "Partidos en grupo"
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.MaxActivationDistance = 14
	prompt.RequiresLineOfSight = false
	prompt.Parent = pad
	prompt.Triggered:Connect(function(player)
		local ok, message = ArenaService.Join(player)
		notifyRemote:FireClient(player, ok and "success" or "error", message)
	end)
end

-- ===== Jugadores =====

local function characterOf(player)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if root and humanoid and humanoid.Health > 0 then
		return character, root, humanoid
	end
	return nil
end

local function setFrozen(frozen)
	for player in pairs(participants) do
		local _, _, humanoid = characterOf(player)
		if humanoid then
			humanoid:SetAttribute("Frozen", frozen or nil)
		end
	end
end

local function slotPosition(team, slot, total)
	-- Formación sencilla en su mitad del campo
	local sign = defendSign(team)
	local spots = {
		{ x = 0.85, z = 0 }, -- portero
		{ x = 0.55, z = -0.3 }, { x = 0.55, z = 0.3 },
		{ x = 0.25, z = -0.45 }, { x = 0.25, z = 0.45 },
	}
	local spot = spots[((slot - 1) % #spots) + 1]
	if total == 1 then
		spot = { x = 0.4, z = 0 }
	end
	return sign * spot.x * HALF_L, spot.z * HALF_W
end

local function placeParticipant(player)
	local info = participants[player]
	local character, _, humanoid = characterOf(player)
	if not info or not character then
		return
	end
	local x, z = slotPosition(info.team, info.slot, info.teamSize)
	local lookX = -defendSign(info.team) * 100
	character:PivotTo(CFrame.lookAt(toWorld(x, 4, z), toWorld(lookX, 4, z)))
	humanoid:SetAttribute("Arena", true)
	-- Contorno del color del equipo: se distingue a los compañeros aunque lleven trajes distintos
	if not character:FindFirstChild("FEU_TeamHighlight") then
		local highlight = Instance.new("Highlight")
		highlight.Name = "FEU_TeamHighlight"
		highlight.FillTransparency = 1
		highlight.OutlineColor = teamInfo(info.team).color
		highlight.OutlineTransparency = 0
		highlight.DepthMode = Enum.HighlightDepthMode.Occluded
		highlight.Parent = character
	end
end

local function releaseParticipant(player, teleport)
	participants[player] = nil
	kickCooldown[player] = nil
	dribbleCooldown[player] = nil
	if player.Parent then
		player.Team = nil
		player.Neutral = true
		local character, _, humanoid = characterOf(player)
		if humanoid then
			humanoid:SetAttribute("Arena", nil)
			humanoid:SetAttribute("Frozen", nil)
		end
		local highlight = character and character:FindFirstChild("FEU_TeamHighlight")
		if highlight then
			highlight:Destroy()
		end
		if teleport then
			PlotService.TeleportHome(player)
		end
	end
end

local function humansInMatch()
	local count = 0
	for player in pairs(participants) do
		if player.Parent then
			count += 1
		end
	end
	return count
end

-- ===== Bots =====

local function makeBot(team, name)
	local info = teamInfo(team)
	local model = Instance.new("Model")
	model.Name = name
	local function botPart(partName, size, offset, color, shape)
		local p = Instance.new("Part")
		p.Name = partName
		p.Size = size
		p.Color = color
		p.Anchored = true
		p.CanCollide = false
		p.CanTouch = false
		p.CanQuery = false
		p.Material = Enum.Material.SmoothPlastic
		if shape then
			p.Shape = shape
		end
		p:SetAttribute("Offset", offset)
		p.Parent = model
		return p
	end
	local torso = botPart("Torso", Vector3.new(2, 2.2, 1.1), Vector3.new(0, 3.1, 0), info.color)
	botPart("Head", Vector3.new(1.5, 1.5, 1.5), Vector3.new(0, 4.95, 0), Color3.fromRGB(240, 200, 160), Enum.PartType.Ball)
	botPart("Legs", Vector3.new(1.8, 2, 0.9), Vector3.new(0, 1, 0), Color3.fromRGB(30, 30, 40))
	model.PrimaryPart = torso
	local tag = Instance.new("BillboardGui")
	tag.Size = UDim2.fromOffset(120, 24)
	tag.StudsOffset = Vector3.new(0, 3.2, 0)
	tag.MaxDistance = 90
	tag.Parent = torso
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBold
	label.TextScaled = true
	label.TextColor3 = Color3.new(1, 1, 1)
	label.TextStrokeTransparency = 0.4
	label.Text = "🤖 " .. name
	label.Parent = tag
	model.Parent = folder
	return model
end

local function placeBot(bot, x, z, faceX, faceZ)
	bot.x, bot.z = x, z
	local from, to = Vector3.new(x, 0, z), Vector3.new(faceX, 0, faceZ)
	if (to - from).Magnitude < 0.05 then
		to = from + Vector3.new(-defendSign(bot.team), 0, 0) -- mirando a la portería rival
	end
	local base = Cfg.ORIGIN * CFrame.lookAt(from, to)
	for _, p in ipairs(bot.model:GetChildren()) do
		if p:IsA("BasePart") then
			p.CFrame = base * CFrame.new(p:GetAttribute("Offset"))
		end
	end
end

local function clearBots()
	for _, bot in ipairs(bots) do
		bot.model:Destroy()
	end
	bots = {}
end

-- ===== Balón =====

-- El balón toma el aspecto del balón coleccionable del último jugador que lo toca.
-- Con el evento admin «Balón de oro» siempre es dorado.
local function applySkin(player)
	if AdminService.GoalMultiplier() > 1 then
		BallSkin.Apply(ball, "gold")
	elseif player then
		BallSkin.Apply(ball, PetService.BallOf(player))
	end
end

local function resetBall()
	ball.Anchored = true
	ball.AssemblyLinearVelocity = Vector3.zero
	ball.AssemblyAngularVelocity = Vector3.zero
	ball.CFrame = Cfg.ORIGIN * CFrame.new(0, Cfg.BALL_SIZE / 2 + 0.2, 0)
	applySkin(nil)
end

local function releaseBall()
	ball.Anchored = false
	pcall(function()
		ball:SetNetworkOwner(nil) -- el servidor controla el balón (goles fiables)
	end)
end

local function kickBall(direction, power)
	power = math.clamp(power, 0, 1)
	local speed = Cfg.KICK_MIN_SPEED + (Cfg.KICK_MAX_SPEED - Cfg.KICK_MIN_SPEED) * power
	local lift = Cfg.KICK_MIN_LIFT + (Cfg.KICK_MAX_LIFT - Cfg.KICK_MIN_LIFT) * power * power
	ball.AssemblyLinearVelocity = direction.Unit * speed + Vector3.new(0, lift, 0)
	kickSound:Play()
end

local function createBall()
	ball = Instance.new("Part")
	ball.Name = "ArenaBall"
	ball.Shape = Enum.PartType.Ball
	ball.Size = Vector3.new(Cfg.BALL_SIZE, Cfg.BALL_SIZE, Cfg.BALL_SIZE)
	ball.Material = Enum.Material.SmoothPlastic
	ball.CustomPhysicalProperties = PhysicalProperties.new(0.3, 0.35, Cfg.BALL_ELASTICITY, 1, 1)
	kickSound = Instance.new("Sound")
	kickSound.Name = "Kick"
	kickSound.SoundId = "rbxassetid://" .. SoundConfig.KICK
	kickSound.Volume = 0.9
	kickSound.RollOffMaxDistance = 160
	kickSound.Parent = ball
	ball.Parent = folder
	BallSkin.Apply(ball, "classic")
	resetBall()
	-- Conducción: al tocarlo corriendo, el balón sale en la dirección de la carrera
	ball.Touched:Connect(function(hit)
		if phase ~= "playing" then
			return
		end
		local character = hit:FindFirstAncestorOfClass("Model")
		local player = character and Players:GetPlayerFromCharacter(character)
		local info = player and participants[player]
		if not info then
			return
		end
		local _, root = characterOf(player)
		if not root then
			return
		end
		local now = os.clock()
		if dribbleCooldown[player] and now - dribbleCooldown[player] < 0.15 then
			return
		end
		dribbleCooldown[player] = now
		lastTouch = { name = player.DisplayName, team = info.team, player = player }
		applySkin(player)
		-- Cabezazo: el balón llega alto y toca la cabeza -> sale hacia donde mira el jugador
		if hit.Name == "Head" and ball.Position.Y > root.Position.Y + 1.2 then
			local look = root.CFrame.LookVector * Vector3.new(1, 0, 1)
			if look.Magnitude > 0.01 then
				ball.AssemblyLinearVelocity = look.Unit * Cfg.HEADER_SPEED + Vector3.new(0, Cfg.HEADER_LIFT, 0)
				kickSound:Play()
				return
			end
		end
		local velocity = root.AssemblyLinearVelocity * Vector3.new(1, 0, 1)
		local direction = velocity.Magnitude > 4 and velocity.Unit or ((ball.Position - root.Position) * Vector3.new(1, 0, 1))
		if direction.Magnitude < 0.01 then
			return
		end
		ball.AssemblyLinearVelocity = direction.Unit * math.max(Cfg.DRIBBLE_SPEED, velocity.Magnitude * 1.15) + Vector3.new(0, 2, 0)
	end)
end

-- Envía el balón a un compañero con la fuerza justa, adelantado a su carrera.
-- offset = vector horizontal del balón al compañero
passBall = function(offset, distance, velocity)
	local speed = math.clamp(distance * 1.5 + 28, Cfg.PASS_MIN_SPEED, Cfg.PASS_MAX_SPEED)
	local target = offset + velocity * math.min(distance / speed, 1.2)
	ball.AssemblyLinearVelocity = target.Unit * speed + Vector3.new(0, 3 + distance * 0.06, 0)
	kickSound:Play()
end

-- Comprobaciones comunes de chut y pase: en partido, cerca del balón y sin abusar del botón.
-- Devuelve la ficha del jugador y su HumanoidRootPart, o nil si la acción no vale.
local function validTouch(player)
	if phase ~= "playing" or not ball then
		return nil
	end
	local info = participants[player]
	if not info then
		return nil
	end
	local _, root = characterOf(player)
	if not root then
		return nil
	end
	local now = os.clock()
	if kickCooldown[player] and now - kickCooldown[player] < Cfg.KICK_COOLDOWN then
		return nil
	end
	if (ball.Position - root.Position).Magnitude > Cfg.KICK_RANGE then
		return nil
	end
	kickCooldown[player] = now
	lastTouch = { name = player.DisplayName, team = info.team, player = player }
	applySkin(player)
	return info, root
end

-- Dirección horizontal del chut: hacia donde apunta la cámara del jugador (lo envía el cliente).
-- Si no es un vector válido, se usa hacia donde mira el personaje.
local function aimDirection(root, aim)
	if typeof(aim) == "Vector3" then
		local flat = aim * Vector3.new(1, 0, 1)
		if flat.Magnitude > 0.1 and flat.Magnitude < 10 then
			return flat.Unit
		end
	end
	local look = root.CFrame.LookVector * Vector3.new(1, 0, 1)
	return look.Magnitude > 0.01 and look.Unit or nil
end

-- Chut pedido por un cliente: todo se valida aquí.
local function onKick(player, power, aim)
	if type(power) ~= "number" or power ~= power then
		return
	end
	local info, root = validTouch(player)
	if not info then
		return
	end
	local direction = aimDirection(root, aim)
	if direction then
		kickBall(direction, power)
	end
end

-- Pase: el servidor busca al compañero mejor colocado en la dirección a la que apuntas
-- y le envía el balón con la fuerza justa para que le llegue.
local function onPass(player, aim)
	local info, root = validTouch(player)
	if not info then
		return
	end
	local direction = aimDirection(root, aim)
	if not direction then
		return
	end
	local best, bestScore = nil, 0.3 -- solo compañeros dentro de un cono de unos 70° a cada lado
	local function consider(position, velocity)
		local offset = (position - ball.Position) * Vector3.new(1, 0, 1)
		local distance = offset.Magnitude
		if distance < 6 or distance > 110 then
			return
		end
		local score = offset.Unit:Dot(direction)
		if score > bestScore then
			best, bestScore = { offset = offset, distance = distance, velocity = velocity }, score
		end
	end
	for other, otherInfo in pairs(participants) do
		if other ~= player and otherInfo.team == info.team then
			local _, otherRoot = characterOf(other)
			if otherRoot then
				consider(otherRoot.Position, otherRoot.AssemblyLinearVelocity * Vector3.new(1, 0, 1))
			end
		end
	end
	for _, bot in ipairs(bots) do
		if bot.team == info.team then
			consider(toWorld(bot.x, 0, bot.z), Vector3.zero)
		end
	end
	if not best then
		kickBall(direction, 0.3) -- nadie a quien pasar: toque corto hacia delante
		return
	end
	passBall(best.offset, best.distance, best.velocity)
end

-- ===== Retransmisión al cliente =====

local function teamLists()
	local lists = { red = {}, blue = {} }
	for player, info in pairs(participants) do
		table.insert(lists[info.team], player.DisplayName)
	end
	for _, bot in ipairs(bots) do
		table.insert(lists[bot.team], "🤖 " .. bot.name)
	end
	return lists
end

local function broadcast()
	local lists = (phase ~= "idle" and phase ~= "countdown") and teamLists() or nil
	local base = {
		phase = phase,
		queue = #queue,
		countdown = phase == "countdown" and math.max(0, math.ceil(countdownEnds - os.clock())) or nil,
		timeLeft = math.max(0, math.ceil(remaining)),
		goldenGoal = goldenGoal,
		score = { red = score.red, blue = score.blue },
		teams = lists,
		goldBall = AdminService.GoalMultiplier() > 1,
		theme = currentTheme.icon .. " " .. currentTheme.name,
	}
	for _, player in ipairs(Players:GetPlayers()) do
		local info = participants[player]
		local message = table.clone(base)
		message.role = info and "playing" or (table.find(queue, player) and "queued" or "none")
		message.team = info and info.team or nil
		arenaRemote:FireClient(player, "state", message)
	end
	if scoreboardLabel then
		if phase == "idle" or phase == "countdown" then
			scoreboardLabel.Text = "⚽ PARTIDOS EN GRUPO"
		else
			scoreboardLabel.Text = string.format("<font color='#FF6B6B'>ROJO %d</font>  -  <font color='#6BA8FF'>%d AZUL</font>\n⏱ %d:%02d",
				score.red, score.blue, math.floor(base.timeLeft / 60), base.timeLeft % 60)
		end
	end
end

local function event(kind, data)
	for player in pairs(participants) do
		arenaRemote:FireClient(player, kind, data)
	end
end

-- ===== Lógica de los bots (cada frame) =====

-- Compañero (humano o bot) más adelantado hacia la portería rival, a distancia de pase.
findMate = function(bot, ballLocal, attackX, distanceToGoal)
	local best, bestGain = nil, Cfg.BOT_PASS_MIN_GAIN
	local function consider(position, velocity)
		local localPos = toLocal(position)
		local gain = distanceToGoal - math.abs(attackX - localPos.X)
		local offset = (position - ball.Position) * Vector3.new(1, 0, 1)
		local distance = offset.Magnitude
		if gain > bestGain and distance > 12 and distance < 60 then
			best, bestGain = { offset = offset, distance = distance, velocity = velocity }, gain
		end
	end
	for player, info in pairs(participants) do
		if info.team == bot.team then
			local _, root = characterOf(player)
			if root then
				consider(root.Position, root.AssemblyLinearVelocity * Vector3.new(1, 0, 1))
			end
		end
	end
	for _, other in ipairs(bots) do
		if other ~= bot and other.team == bot.team and not other.keeper then
			consider(toWorld(other.x, 0, other.z), Vector3.zero)
		end
	end
	return best
end

local function updateBots(dt)
	if phase ~= "playing" or not ball then
		return
	end
	local b = toLocal(ball.Position)
	-- El bot de campo más cercano al balón de cada equipo va a por él
	local chaser = {}
	for _, team in ipairs({ "red", "blue" }) do
		local best, bestDist = nil, math.huge
		for _, bot in ipairs(bots) do
			if bot.team == team and not bot.keeper then
				local d = (Vector2.new(bot.x, bot.z) - Vector2.new(b.X, b.Z)).Magnitude
				if d < bestDist then
					best, bestDist = bot, d
				end
			end
		end
		chaser[team] = best
	end
	for _, bot in ipairs(bots) do
		local sign = defendSign(bot.team)
		local attackX = -sign * HALF_L
		local tx, tz, speed
		if bot.keeper then
			speed = Cfg.BOT_KEEPER_SPEED
			local near = math.abs(b.X - sign * HALF_L) < 22 and math.abs(b.Z) < HALF_W * 0.6
			if near then
				tx, tz = b.X, b.Z
			else
				tx = sign * (HALF_L - 4)
				tz = math.clamp(b.Z, -Cfg.GOAL_WIDTH / 2 + 2, Cfg.GOAL_WIDTH / 2 - 2)
			end
		elseif chaser[bot.team] == bot then
			speed = Cfg.BOT_SPEED
			-- Se coloca detrás del balón respecto a la portería rival
			local toGoal = Vector2.new(attackX - b.X, -b.Z)
			local behind = toGoal.Magnitude > 0 and toGoal.Unit * -2.2 or Vector2.zero
			tx, tz = b.X + behind.X, b.Z + behind.Y
		else
			speed = Cfg.BOT_SPEED * 0.8
			local hx, hz = slotPosition(bot.team, bot.slot, bot.teamSize)
			tx = (hx + b.X) / 2
			tz = hz
		end
		local delta = Vector2.new(tx - bot.x, tz - bot.z)
		local step = math.min(speed * dt, delta.Magnitude)
		local nx, nz = bot.x, bot.z
		if delta.Magnitude > 0.05 then
			nx += delta.Unit.X * step
			nz += delta.Unit.Y * step
		end
		nx = math.clamp(nx, -HALF_L + 1, HALF_L - 1)
		nz = math.clamp(nz, -HALF_W + 1, HALF_W - 1)
		placeBot(bot, nx, nz, b.X, b.Z)
		-- Chut
		local dist = (Vector2.new(nx, nz) - Vector2.new(b.X, b.Z)).Magnitude
		local now = os.clock()
		if dist < 4.5 and b.Y < 6 and now - (bot.lastKick or 0) > Cfg.BOT_KICK_COOLDOWN then
			bot.lastKick = now
			local aimZ = rng:NextNumber(-Cfg.GOAL_WIDTH * 0.4, Cfg.GOAL_WIDTH * 0.4)
			local aim = toWorld(attackX, 0, aimZ) - toWorld(b.X, 0, b.Z)
			local distanceToGoal = math.abs(attackX - b.X)
			local power = bot.keeper and 0.9 or (distanceToGoal > 60 and rng:NextNumber(0.45, 0.65) or rng:NextNumber(0.7, 0.95))
			lastTouch = { name = bot.name, team = bot.team }
			-- Lejos de la portería, a veces pasa a un compañero mejor colocado (más cerca del área rival)
			local mate = nil
			if not bot.keeper and distanceToGoal > Cfg.BOT_PASS_MIN_DISTANCE and rng:NextNumber() < Cfg.BOT_PASS_CHANCE then
				mate = findMate(bot, b, attackX, distanceToGoal)
			end
			local flatAim = aim * Vector3.new(1, 0, 1)
			if mate then
				passBall(mate.offset, mate.distance, mate.velocity)
			elseif flatAim.Magnitude > 0.01 then
				kickBall(flatAim, power)
			end
		end
	end
end

-- ===== Goles =====

local function checkBall()
	if not ball or phase ~= "playing" then
		return
	end
	local p = toLocal(ball.Position)
	if math.abs(p.X) > HALF_L + Cfg.BALL_SIZE / 2 and math.abs(p.Z) < Cfg.GOAL_WIDTH / 2 and p.Y < Cfg.GOAL_HEIGHT then
		-- En la portería de +X defiende Azul: marca Rojo, y al revés
		pendingGoal = p.X > 0 and "red" or "blue"
		score[pendingGoal] += 1
		phase = "goal"
		local scorer = lastTouch
		local ownGoal = scorer ~= nil and scorer.team ~= pendingGoal
		if scorer and scorer.player and not ownGoal and participants[scorer.player] then
			participants[scorer.player].goals += 1
		end
		event("goal", {
			team = pendingGoal,
			scorer = scorer and scorer.name or nil,
			ownGoal = ownGoal,
			score = { red = score.red, blue = score.blue },
		})
		broadcast()
	elseif p.Y < -25 or math.abs(p.X) > HALF_L + 40 or math.abs(p.Z) > HALF_W + 40 then
		resetBall() -- se escapó por un fallo de física: vuelve al centro
		releaseBall()
	end
end

-- ===== Desarrollo del partido =====

local function kickoff()
	phase = "kickoff"
	resetBall()
	for player in pairs(participants) do
		placeParticipant(player)
	end
	for _, bot in ipairs(bots) do
		local x, z = slotPosition(bot.team, bot.slot, bot.teamSize)
		placeBot(bot, x, z, 0, z)
	end
	setFrozen(true)
	broadcast()
	task.wait(Cfg.KICKOFF_FREEZE)
	setFrozen(false)
	releaseBall()
	phase = "playing"
	broadcast()
end

local function rewardFor(player, result, goals)
	local base = result == "win" and Cfg.REWARD_WIN or (result == "draw" and Cfg.REWARD_DRAW or Cfg.REWARD_LOSS)
	-- Las mascotas equipadas suman su bonus (se consiguen jugando, no pagando)
	-- El bonus de la semana (partidos x1,5 o goles x2) también cuenta
	local weekly = WeeklyConfig.ActiveBonus()
	-- Y los renacimientos (+10 % por cada uno)
	local data = DataService.Get(player)
	local rebirthBonus = RebirthConfig.ArenaBonus(data and data.rebirth.count or 0)
	local amount = math.floor((base + goals * Cfg.REWARD_GOAL * AdminService.GoalMultiplier() * (weekly.goalMultiplier or 1))
		* AdminService.RewardMultiplier() * (weekly.matchMultiplier or 1) * (1 + PetService.Bonus(player) + rebirthBonus))
	local now = os.time()
	local log = rewardLog[player.UserId] or {}
	local recent = {}
	for _, t in ipairs(log) do
		if now - t < 3600 then
			table.insert(recent, t)
		end
	end
	if #recent >= Cfg.MAX_REWARDED_PER_HOUR then
		rewardLog[player.UserId] = recent
		return 0
	end
	table.insert(recent, now)
	rewardLog[player.UserId] = recent
	return amount
end

-- Mejor jugador: el humano con más goles (si empatan, uno del equipo ganador)
local function pickMvp(winner)
	local mvp, best = nil, 0
	for player, info in pairs(participants) do
		if player.Parent then
			local points = info.goals * 2 + (info.team == winner and 1 or 0)
			if info.goals > 0 and points > best then
				mvp, best = player, points
			end
		end
	end
	return mvp
end

local function finish(aborted)
	phase = "result"
	local winner = score.red > score.blue and "red" or (score.blue > score.red and "blue" or nil)
	lastResult = { winner = winner, score = { red = score.red, blue = score.blue } }
	local mvp = not aborted and pickMvp(winner) or nil
	for player, info in pairs(participants) do
		if player.Parent and not aborted and DataService.Get(player) then
			local result = winner == nil and "draw" or (winner == info.team and "win" or "loss")
			local reward = rewardFor(player, result, info.goals)
			if reward > 0 and player == mvp then
				reward += Cfg.REWARD_MVP
			end
			if reward > 0 then
				EconomyService.Earn(player, reward, EconomyService.Category.ARENA, "Partido en grupo")
			end
			arenaRemote:FireClient(player, "result", {
				result = result, winner = winner, score = lastResult.score, goals = info.goals, reward = reward,
				capped = reward == 0, petBonus = PetService.Bonus(player),
				mvp = mvp and mvp.DisplayName or nil, isMvp = player == mvp,
			})
			local own = info.team == "red" and score.red or score.blue
			local other = info.team == "red" and score.blue or score.red
			for _, callback in ipairs(endCallbacks) do
				task.spawn(callback, player, info.goals, own, other, result, player == mvp)
			end
		end
	end
	broadcast()
	task.wait(aborted and 0 or Cfg.RESULT_SECONDS)
	for player in pairs(participants) do
		releaseParticipant(player, true)
	end
	clearBots()
	if ball then
		ball:Destroy()
		ball = nil
	end
	phase = "idle"
	broadcast()
end

local function runMatch(players)
	score = { red = 0, blue = 0 }
	lastTouch = nil
	pendingGoal = nil
	applyTheme(pickTheme())
	-- Reparto al azar y equilibrado
	for i = #players, 2, -1 do
		local j = rng:NextInteger(1, i)
		players[i], players[j] = players[j], players[i]
	end
	local teamSize = math.max(Cfg.MIN_PER_TEAM, math.ceil(#players / 2))
	local counts = { red = 0, blue = 0 }
	for i, player in ipairs(players) do
		local team = i % 2 == 1 and "red" or "blue"
		counts[team] += 1
		participants[player] = { team = team, goals = 0, slot = counts[team] + 1, teamSize = teamSize }
		player.Neutral = false
		player.Team = teamObjects[team]
		arenaRemote:FireClient(player, "joined", { team = team, theme = currentTheme.icon .. " " .. currentTheme.name })
	end
	-- Los humanos ocupan los puestos de campo; el primer bot de un equipo es el portero.
	local names = table.clone(Cfg.BOT_NAMES)
	for _, team in ipairs({ "red", "blue" }) do
		local missing = teamSize - counts[team]
		for k = 1, missing do
			local name = table.remove(names, rng:NextInteger(1, #names)) or ("Bot " .. k)
			local bot = { model = makeBot(team, name), team = team, name = name, keeper = (k == 1), teamSize = teamSize }
			bot.slot = bot.keeper and 1 or (counts[team] + k)
			table.insert(bots, bot)
		end
	end
	createBall()
	goldenGoal = false
	remaining = Cfg.MATCH_SECONDS
	local function play()
		while remaining > 0 and humansInMatch() > 0 do
			local dt = task.wait(0.1)
			if phase == "playing" then
				remaining -= dt
			elseif phase == "goal" then
				task.wait(Cfg.GOAL_CELEBRATION)
				pendingGoal = nil
				if goldenGoal then
					remaining = 0 -- en el gol de oro, el primer gol gana
				elseif humansInMatch() > 0 then
					kickoff()
				end
			end
		end
	end
	kickoff()
	play()
	-- Empate al final: prórroga a gol de oro (una sola vez)
	if score.red == score.blue and humansInMatch() > 0 then
		goldenGoal = true
		remaining = Cfg.GOLDEN_GOAL_SECONDS
		event("goldengoal", { seconds = Cfg.GOLDEN_GOAL_SECONDS })
		kickoff()
		play()
	end
	finish(humansInMatch() == 0)
	goldenGoal = false
end

-- ===== API pública =====

function ArenaService.Join(player)
	if not DataService.Get(player) then
		return false, "Tu club todavía se está cargando."
	end
	if participants[player] then
		return false, "Ya estás jugando un partido."
	end
	if table.find(queue, player) then
		return false, "Ya estás en la cola."
	end
	table.insert(queue, player)
	broadcast()
	if phase == "idle" or phase == "countdown" then
		return true, "⚽ ¡Te has apuntado! El partido empieza en unos segundos."
	end
	return true, "⚽ Estás en la cola: jugarás el próximo partido."
end

function ArenaService.Leave(player)
	local index = table.find(queue, player)
	if index then
		table.remove(queue, index)
		broadcast()
		return true, "Has salido de la cola."
	end
	if participants[player] then
		releaseParticipant(player, true)
		broadcast()
		return true, "Has abandonado el partido."
	end
	return false, "No estás en ningún partido."
end

-- Espectador: te lleva a la grada del estadio de partidos (para volver: «Volver a mi estadio»).
function ArenaService.Watch(player)
	if participants[player] then
		return false, "Ya estás jugando el partido."
	end
	local character = characterOf(player)
	if not character then
		return false, "No se pudo teletransportar ahora."
	end
	local side = rng:NextNumber() < 0.5 and -1 or 1
	character:PivotTo(CFrame.lookAt(toWorld(rng:NextInteger(-40, 40), 15, side * (HALF_W + 26)), toWorld(0, 2, 0)))
	return true, "👀 Estás en la grada. Para volver, pulsa «Volver a mi estadio»."
end

-- Al reaparecer durante un partido, vuelve al campo en vez de a su estadio.
function ArenaService.HandleRespawn(player)
	if not participants[player] then
		return false
	end
	task.wait(0.2)
	placeParticipant(player)
	local _, _, humanoid = characterOf(player)
	if humanoid and phase == "kickoff" then
		humanoid:SetAttribute("Frozen", true)
	end
	return true
end

function ArenaService.OnMatchEnd(callback)
	table.insert(endCallbacks, callback)
end

function ArenaService.PlayerRemoving(player)
	local index = table.find(queue, player)
	if index then
		table.remove(queue, index)
	end
	if participants[player] then
		releaseParticipant(player, false)
	end
	kickCooldown[player] = nil
	dribbleCooldown[player] = nil
end

function ArenaService.Start()
	buildArena()
	buildLobbyPad()
	for _, info in ipairs(Cfg.TEAMS) do
		local team = Instance.new("Team")
		team.Name = info.name
		team.TeamColor = BrickColor.new(info.brick)
		team.AutoAssignable = false
		team.Parent = Teams
		teamObjects[info.id] = team
	end
	arenaRemote.OnServerEvent:Connect(function(player, kind, a, b)
		if kind == "kick" then
			onKick(player, a, b) -- potencia (0..1) y dirección de la cámara
		elseif kind == "pass" then
			onPass(player, a) -- dirección de la cámara
		end
	end)
	RunService.Heartbeat:Connect(function(dt)
		checkBall()
		updateBots(dt)
	end)
	-- Bucle de la cola y de los partidos
	task.spawn(function()
		while true do
			if phase == "idle" and #queue > 0 then
				phase = "countdown"
				countdownEnds = os.clock() + Cfg.QUEUE_COUNTDOWN
			end
			if phase == "countdown" then
				if #queue == 0 then
					phase = "idle"
				else
					if #queue >= Cfg.MAX_PER_TEAM * 2 then
						countdownEnds = math.min(countdownEnds, os.clock() + Cfg.QUEUE_COUNTDOWN_FULL)
					end
					if os.clock() >= countdownEnds then
						local players = {}
						while #queue > 0 and #players < Cfg.MAX_PER_TEAM * 2 do
							local player = table.remove(queue, 1)
							if player.Parent and characterOf(player) then
								table.insert(players, player)
							end
						end
						if #players > 0 then
							local ok, err = pcall(runMatch, players)
							if not ok then
								warn("[ArenaService] Error en el partido: ", err)
								pcall(finish, true)
							end
						else
							phase = "idle"
						end
					end
				end
			end
			task.wait(0.25)
		end
	end)
	-- Marcador y cola en pantalla dos veces por segundo
	task.spawn(function()
		while true do
			broadcast()
			task.wait(0.5)
		end
	end)
end

return ArenaService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000002E"><Properties><string name="Name">BuildService</string><ProtectedString name="Source"><![CDATA[-- BuildService (ModuleScript)
-- Ubicación: ServerScriptService/Server/Services/BuildService
--
-- Construcción validada en el servidor:
--   * Mejorar instalaciones (coste, nivel máximo, etapa del estadio, requisitos, deuda).
--   * CONSTRUCCIÓN AVANZADA (FASE 2): colocar, mover y retirar decoraciones en
--     posición libre dentro de la zona de decoración del propio terreno.
--     PlacementRules valida zona, áreas reservadas, colisiones, rejilla y rotación.
--   * Constructor Pro: rejilla fina (1 stud), rotación a 45° y +6 decoraciones,
--     con exactamente las mismas zonas, colisiones y costes que el resto.
-- Solo se puede modificar el estadio propio: ninguna acción recibe el ID de otro jugador.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local GameConfig = require(Shared.Config.GameConfig)
local FacilityConfig = require(Shared.Config.FacilityConfig)
local CosmeticConfig = require(Shared.Config.CosmeticConfig)
local GamePassConfig = require(Shared.Config.GamePassConfig)
local EconomyFormulas = require(Shared.Modules.EconomyFormulas)
local PlacementRules = require(Shared.Modules.PlacementRules)
local StadiumPieces = require(Shared.Config.StadiumPieces)

local DataService = require(script.Parent.DataService)
local EconomyService = require(script.Parent.EconomyService)
local GamePassService = require(script.Parent.GamePassService)

local BuildService = {}

function BuildService.IsPro(player)
	return GamePassService.Owns(player, "CONSTRUCTOR_PRO")
end

-- Límite de decoraciones: el de la etapa del estadio + extra de Constructor Pro.
function BuildService.MaxDecorations(player, data)
	local limit = EconomyFormulas.FreeDecorationLimit(data.stadium.stage)
	if BuildService.IsPro(player) then
		limit += GameConfig.PRO_EXTRA_DECORATIONS
	end
	return math.min(limit, GameConfig.MAX_DECORATIONS)
end

function BuildService.Tools(player)
	return PlacementRules.Tools(BuildService.IsPro(player))
end

function BuildService.Upgrade(player, facilityId)
	local data = DataService.Get(player)
	if type(facilityId) ~= "string" then
		return false, "Solicitud no válida."
	end
	local ok, reason, levelData = EconomyFormulas.CanUpgrade(data, facilityId)
	if not ok then
		return false, reason
	end
	local def = FacilityConfig.Get(facilityId)
	local newLevel = (data.stadium.facilities[facilityId] or 0) + 1
	local paid, payError = EconomyService.Spend(player, levelData.cost, EconomyService.Category.CONSTRUCTION,
		string.format("%s nivel %d", def.name, newLevel))
	if not paid then
		return false, payError
	end
	data.stadium.facilities[facilityId] = newLevel
	data.stats.buildings += 1
	local verb = newLevel == 1 and "construida" or "mejorada a nivel " .. newLevel
	return true, string.format("%s %s %s.", def.icon, def.name, verb)
end

local function readPlacement(payload)
	if type(payload) ~= "table" then
		return nil
	end
	local x, z, r = tonumber(payload.x), tonumber(payload.z), tonumber(payload.rotation)
	if not x or not z or not r then
		return nil
	end
	return x, z, r
end

local function passCheck(player, item)
	if item.requiredUnlock and not DataService.Get(player).unlocks[item.requiredUnlock] then
		return false, string.format("«%s» se consigue canjeando caramelos en el evento de Halloween.", item.name)
	end
	if item.requiredPass and not GamePassService.Owns(player, item.requiredPass) then
		local pass = GamePassConfig.Get(item.requiredPass)
		return false, string.format("«%s» requiere el pase %s.", item.name, pass and pass.name or "?")
	end
	return true
end

function BuildService.PlaceDecoration(player, payload)
	local data = DataService.Get(player)
	local decoId = type(payload) == "table" and payload.decoration
	local item = type(decoId) == "string" and CosmeticConfig.ById.decoration[decoId]
	if not item then
		return false, "Esa decoración no existe."
	end
	local x, z, rotation = readPlacement(payload)
	if not x then
		return false, "Posición no válida."
	end
	local allowed, passError = passCheck(player, item)
	if not allowed then
		return false, passError
	end
	local list = data.stadium.decorations
	local max = BuildService.MaxDecorations(player, data)
	if #list >= max then
		if not BuildService.IsPro(player) then
			return false, string.format("Has alcanzado el límite de %d decoraciones de tu etapa. Asciende el estadio o usa Constructor Pro.", max)
		end
		return false, string.format("Has alcanzado el límite de %d decoraciones.", max)
	end
	local ok, reason = PlacementRules.Validate({
		decorations = list, decoId = decoId, x = x, z = z, rotation = rotation, isPro = BuildService.IsPro(player),
	})
	if not ok then
		return false, reason
	end
	if data.economy.debt > GameConfig.DEBT_BUILD_LIMIT then
		return false, "Tu deuda es demasiado alta para construir. Págala primero."
	end
	local paid, payError = EconomyService.Spend(player, item.cost, EconomyService.Category.DECORATION, item.name)
	if not paid then
		return false, payError
	end
	table.insert(list, { id = decoId, x = x, z = z, r = rotation })
	return true, string.format("«%s» colocada.", item.name)
end

-- Comprueba que el índice enviado corresponde a la decoración esperada (evita estados obsoletos).
local function findDecoration(data, payload)
	if type(payload) ~= "table" then
		return nil
	end
	local index = tonumber(payload.index)
	if not index or index ~= math.floor(index) then
		return nil
	end
	local entry = data.stadium.decorations[index]
	if not entry or entry.id ~= payload.decoration then
		return nil
	end
	return index, entry
end

function BuildService.MoveDecoration(player, payload)
	local data = DataService.Get(player)
	local index, entry = findDecoration(data, payload)
	if not index then
		return false, "Esa decoración ya no está ahí. Vuelve a intentarlo."
	end
	local x, z, rotation = readPlacement(payload)
	if not x then
		return false, "Posición no válida."
	end
	local ok, reason = PlacementRules.Validate({
		decorations = data.stadium.decorations, decoId = entry.id, x = x, z = z, rotation = rotation,
		isPro = BuildService.IsPro(player), ignoreIndex = index,
	})
	if not ok then
		return false, reason
	end
	entry.x, entry.z, entry.r = x, z, rotation
	return true, "Decoración movida."
end

function BuildService.RemoveDecoration(player, payload)
	local data = DataService.Get(player)
	local index, entry = findDecoration(data, payload)
	if not index then
		return false, "Esa decoración ya no está ahí. Vuelve a intentarlo."
	end
	local item = CosmeticConfig.ById.decoration[entry.id]
	table.remove(data.stadium.decorations, index)
	local refund = math.floor((item and item.cost or 0) * CosmeticConfig.DECORATION_REFUND)
	EconomyService.Earn(player, refund, EconomyService.Category.REFUND, "Retirada: " .. (item and item.name or entry.id))
	return true, string.format("Decoración retirada (+%d %s).", refund, GameConfig.CURRENCY)
end

-- ===== CONSTRUCCIÓN LIBRE DEL ESTADIO (piezas sueltas) =====

-- Altura de una pieza enviada por el cliente: entero entre 0 y MAX_HEIGHT (nil si no vale).
local function readHeight(payload)
	if type(payload) ~= "table" then
		return nil
	end
	local height = tonumber(payload.y) or 0
	if height ~= height or height ~= math.floor(height) or height < 0 or height > StadiumPieces.MAX_HEIGHT then
		return nil
	end
	return height
end

function BuildService.PlacePiece(player, payload)
	local data = DataService.Get(player)
	local pieceId = type(payload) == "table" and payload.piece
	local piece = type(pieceId) == "string" and StadiumPieces.ById[pieceId]
	if not piece then
		return false, "Esa pieza no existe."
	end
	local x, z, rotation = readPlacement(payload)
	if not x then
		return false, "Posición no válida."
	end
	if piece.requiresRebirth and data.rebirth.count < piece.requiresRebirth then
		return false, string.format("%s se desbloquea con %d renacimientos.", piece.name, piece.requiresRebirth)
	end
	local list = data.stadium.pieces
	if #list >= StadiumPieces.MAX_PIECES then
		return false, string.format("Has llegado al máximo de %d piezas. Quita alguna para poner otra.", StadiumPieces.MAX_PIECES)
	end
	local y = readHeight(payload)
	if not y then
		return false, "Altura no válida."
	end
	local ok, reason = PlacementRules.ValidatePiece({ pieceId = pieceId, x = x, z = z, rotation = rotation, y = y, isPro = BuildService.IsPro(player) })
	if not ok then
		return false, reason
	end
	if data.economy.debt > GameConfig.DEBT_BUILD_LIMIT then
		return false, "Tu deuda es demasiado alta para construir. Págala primero."
	end
	local paid, payError = EconomyService.Spend(player, piece.cost, EconomyService.Category.CONSTRUCTION, piece.name)
	if not paid then
		return false, payError
	end
	table.insert(list, { id = pieceId, x = x, z = z, r = rotation, y = y })
	return true, string.format("%s %s colocada.", piece.icon, piece.name), true
end

-- Comprueba que el índice enviado corresponde a la pieza esperada (evita estados obsoletos).
local function findPiece(data, payload)
	if type(payload) ~= "table" then
		return nil
	end
	local index = tonumber(payload.index)
	if not index or index ~= math.floor(index) then
		return nil
	end
	local entry = data.stadium.pieces[index]
	if not entry or entry.id ~= payload.piece then
		return nil
	end
	return index, entry
end

function BuildService.MovePiece(player, payload)
	local data = DataService.Get(player)
	local index, entry = findPiece(data, payload)
	if not index then
		return false, "Esa pieza ya no está ahí. Vuelve a intentarlo."
	end
	local x, z, rotation = readPlacement(payload)
	if not x then
		return false, "Posición no válida."
	end
	local y = readHeight(payload)
	if not y then
		return false, "Altura no válida."
	end
	local ok, reason = PlacementRules.ValidatePiece({ pieceId = entry.id, x = x, z = z, rotation = rotation, y = y, isPro = BuildService.IsPro(player) })
	if not ok then
		return false, reason
	end
	entry.x, entry.z, entry.r, entry.y = x, z, rotation, y
	return true, "Pieza movida.", true
end

function BuildService.RemovePiece(player, payload)
	local data = DataService.Get(player)
	local index, entry = findPiece(data, payload)
	if not index then
		return false, "Esa pieza ya no está ahí. Vuelve a intentarlo."
	end
	local piece = StadiumPieces.ById[entry.id]
	table.remove(data.stadium.pieces, index)
	local refund = math.floor((piece and piece.cost or 0) * StadiumPieces.REFUND)
	EconomyService.Earn(player, refund, EconomyService.Category.REFUND, "Retirada: " .. (piece and piece.name or entry.id))
	return true, string.format("Pieza retirada (+%d %s).", refund, GameConfig.CURRENCY), true
end

-- Modo libre: oculta el estadio automático para construirlo entero a mano.
-- La economía (instalaciones, aforo…) no cambia: solo lo que se ve.
function BuildService.SetFreeBuild(player, payload)
	local data = DataService.Get(player)
	local enabled = type(payload) == "table" and payload.enabled == true
	data.stadium.freeBuild = enabled
	return true, enabled and "🧱 Modo libre: tu estadio automático se oculta. ¡Constrúyelo pieza a pieza!"
		or "🏟️ Vuelve el estadio automático (tus piezas se mantienen).", true
end

-- Qué decoraciones se muestran: dentro del límite actual y con su pase confirmado.
-- Devuelve una lista de booleanos alineada con data.stadium.decorations.
-- Las que no se muestran se conservan y reaparecen al recuperar el límite o la propiedad.
function BuildService.DecorationVisibility(player, data)
	local visible = {}
	local max = BuildService.MaxDecorations(player, data)
	local shown = 0
	for index, entry in ipairs(data.stadium.decorations) do
		local item = CosmeticConfig.ById.decoration[entry.id]
		local ok = item ~= nil and shown < max
			and (item.requiredPass == nil or GamePassService.Owns(player, item.requiredPass))
			and (item.requiredUnlock == nil or data.unlocks[item.requiredUnlock] == true)
		if ok then
			shown += 1
		end
		visible[index] = ok
	end
	return visible
end

return BuildService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000002F"><Properties><string name="Name">ClubService</string><ProtectedString name="Source"><![CDATA[-- ClubService (ModuleScript)
-- Ubicación: ServerScriptService/Server/Services/ClubService
--
-- Identidad del club: nombre (filtrado por Roblox), abreviatura y apariencia
-- (escudo, colores, equipación, efectos y diseños de construcción).
-- Las opciones de pago se validan con GamePassService.Owns en el SERVIDOR.

local TextService = game:GetService("TextService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local GameConfig = require(Shared.Config.GameConfig)
local CosmeticConfig = require(Shared.Config.CosmeticConfig)
local GamePassConfig = require(Shared.Config.GamePassConfig)

local GamePassService = require(script.Parent.GamePassService)
local DataService = require(script.Parent.DataService)

local ClubService = {}

local function filterText(player, text)
	local ok, result = pcall(function()
		local filterResult = TextService:FilterStringAsync(text, player.UserId, Enum.TextFilterContext.PublicChat)
		return filterResult:GetNonChatStringForBroadcastAsync()
	end)
	if not ok then
		return nil
	end
	return result
end

local function cleanInput(text, maxLen)
	if type(text) ~= "string" then
		return nil
	end
	text = text:gsub("[%c]", ""):gsub("^%s+", ""):gsub("%s+$", ""):gsub("%s+", " ")
	if utf8.len(text) == nil then
		return nil
	end
	if utf8.len(text) > maxLen then
		return nil
	end
	return text
end

-- Filtro de texto de Roblox reutilizable (devuelve nil si no se pudo filtrar o si cambia el texto).
function ClubService.FilterExact(player, text)
	local filtered = filterText(player, text)
	if filtered == nil or filtered ~= text then
		return nil
	end
	return filtered
end

-- Devuelve ok, mensaje
function ClubService.SetName(player, name, shortName)
	local data = DataService.Get(player)
	name = cleanInput(name, GameConfig.CLUB_NAME_MAX)
	shortName = cleanInput(shortName, GameConfig.SHORT_NAME_LEN)
	if not name or utf8.len(name) < GameConfig.CLUB_NAME_MIN then
		return false, string.format("El nombre debe tener entre %d y %d caracteres.", GameConfig.CLUB_NAME_MIN, GameConfig.CLUB_NAME_MAX)
	end
	if not shortName or not shortName:match("^%w%w%w$") then
		return false, "La abreviatura debe tener exactamente 3 letras o números."
	end
	shortName = shortName:upper()

	local filteredName = filterText(player, name)
	local filteredShort = filterText(player, shortName)
	if not filteredName or not filteredShort then
		return false, "No se pudo verificar el nombre con el filtro de Roblox. Inténtalo de nuevo."
	end
	if filteredName ~= name or filteredShort ~= shortName then
		return false, "Ese nombre no está permitido. Prueba con otro."
	end
	data.club.name = filteredName
	data.club.shortName = filteredShort
	data.club.named = true
	return true, "Nombre del club actualizado."
end

local function catalogItem(slot, itemId)
	local rule = CosmeticConfig.AppearanceSlots[slot]
	if not rule then
		return nil
	end
	local item = CosmeticConfig.ById[rule.catalog][itemId]
	if not item then
		return nil
	end
	if rule.appliesTo and item.appliesTo ~= rule.appliesTo then
		return nil
	end
	return item
end

function ClubService.CanUse(player, item)
	if item.requiredUnlock then
		-- Desbloqueos gratuitos de eventos (guardados en los datos del club)
		local data = DataService.Get(player)
		if not (data and data.unlocks[item.requiredUnlock]) then
			return false
		end
	end
	return item.requiredPass == nil or GamePassService.Owns(player, item.requiredPass)
end

function ClubService.SetAppearance(player, slot, itemId)
	local data = DataService.Get(player)
	if type(slot) ~= "string" or type(itemId) ~= "string" then
		return false, "Solicitud no válida."
	end
	local item = catalogItem(slot, itemId)
	if not item then
		return false, "Esa opción no existe."
	end
	if not ClubService.CanUse(player, item) then
		if item.requiredUnlock then
			return false, string.format("«%s» se consigue canjeando caramelos en el evento de Halloween.", item.name)
		end
		local pass = GamePassConfig.Get(item.requiredPass)
		return false, string.format("Necesitas el pase %s para usar «%s».", pass and pass.name or "?", item.name)
	end
	data.club.appearance[slot] = itemId
	return true, string.format("«%s» aplicado.", item.name)
end

-- Apariencia que REALMENTE se muestra: si una opción guardada requiere un pase
-- cuya propiedad no está confirmada ahora mismo, se usa la opción gratuita por defecto.
-- La selección guardada no se borra: vuelve a mostrarse cuando Roblox confirme la propiedad.
function ClubService.EffectiveAppearance(player, data)
	local effective = {}
	for slot in pairs(CosmeticConfig.AppearanceSlots) do
		local item = catalogItem(slot, data.club.appearance[slot])
		if item and ClubService.CanUse(player, item) then
			effective[slot] = item.id
		else
			effective[slot] = CosmeticConfig.Defaults[slot]
		end
	end
	return effective
end

function ClubService.IsVip(player)
	return GamePassService.Owns(player, "VIP_CLUB")
end

function ClubService.DisplayName(data)
	if data.club.named and data.club.name ~= "" then
		return data.club.name
	end
	return "Club de " .. tostring(data.club.ownerName)
end

function ClubService.ShortName(data)
	if data.club.named and data.club.shortName ~= "" then
		return data.club.shortName
	end
	return "FEU"
end

return ClubService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000030"><Properties><string name="Name">CommunityService</string><ProtectedString name="Source"><![CDATA[-- CommunityService (ModuleScript)
-- Ubicación: ServerScriptService/Server/Services/CommunityService
--
-- EVENTOS COMUNITARIOS (FASE 9): cada hora, un objetivo compartido por todos los clubes
-- del servidor (marcar goles, ganar o jugar partidos). Cuentan los partidos reales de
-- cualquier competición. Al cumplirse, todos los que han contribuido y siguen conectados
-- reciben la recompensa.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local GameConfig = require(Shared.Config.GameConfig)
local NetworkConfig = require(Shared.Config.NetworkConfig)
local Remotes = require(Shared.Modules.Remotes)

local EconomyService = require(script.Parent.EconomyService)
local MatchService = require(script.Parent.MatchService)

local CommunityService = {}

local notifyRemote = Remotes.Get("Notify")
local state = { period = -1 }

local function ensurePeriod()
	local period = math.floor(os.time() / NetworkConfig.COMMUNITY_PERIOD)
	if state.period ~= period then
		local goal = NetworkConfig.COMMUNITY_GOALS[period % #NetworkConfig.COMMUNITY_GOALS + 1]
		state = { period = period, goal = goal, progress = 0, contributors = {}, completed = false }
	end
	return state
end

local function complete(s)
	s.completed = true
	local text = string.format(s.goal.text, s.goal.target)
	for userId in pairs(s.contributors) do
		local player = Players:GetPlayerByUserId(userId)
		if player then
			EconomyService.Earn(player, s.goal.reward, EconomyService.Category.PRIZE, "Evento comunitario")
		end
	end
	for _, player in ipairs(Players:GetPlayers()) do
		local contributed = s.contributors[player.UserId]
		notifyRemote:FireClient(player, "success", string.format("🤝 ¡Objetivo comunitario cumplido! «%s»%s", text,
			contributed and string.format(" · +%d %s por contribuir", s.goal.reward, GameConfig.CURRENCY) or ""))
	end
end

function CommunityService.Report(player, _, goalsFor, goalsAgainst)
	local s = ensurePeriod()
	if s.completed then
		return
	end
	local metric = s.goal.metric
	local amount = 0
	if metric == "goals" then
		amount = goalsFor
	elseif metric == "wins" then
		amount = goalsFor > goalsAgainst and 1 or 0
	elseif metric == "matches" then
		amount = 1
	end
	if amount > 0 then
		s.progress += amount
		s.contributors[player.UserId] = true
		if s.progress >= s.goal.target then
			complete(s)
		end
	end
end

function CommunityService.BuildState(player)
	local s = ensurePeriod()
	return {
		text = string.format(s.goal.text, s.goal.target),
		progress = math.min(s.progress, s.goal.target),
		target = s.goal.target,
		reward = s.goal.reward,
		completed = s.completed,
		contributed = s.contributors[player.UserId] == true,
		secondsLeft = NetworkConfig.COMMUNITY_PERIOD - (os.time() % NetworkConfig.COMMUNITY_PERIOD),
	}
end

function CommunityService.Start()
	MatchService.OnUserMatch(CommunityService.Report)
end

return CommunityService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000031"><Properties><string name="Name">DataService</string><ProtectedString name="Source"><![CDATA[-- DataService (ModuleScript)
-- Ubicación: ServerScriptService/Server/Services/DataService
--
-- Guardado persistente con DataStoreService:
--   * UpdateAsync con BLOQUEO DE SESIÓN (evita que dos servidores pisen los datos).
--   * Reintentos controlados con espera exponencial.
--   * Validación/reparación de datos al cargar (DefaultData.Reconcile).
--   * Guardado periódico, al salir y al cerrar el servidor (BindToClose).
--   * Si DataStore no está disponible (p. ej. Studio sin "API Services"), el juego
--     sigue funcionando en MODO SIN GUARDADO y se avisa al jugador.

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameConfig = require(ReplicatedStorage.Shared.Config.GameConfig)
local Util = script.Parent.Parent.Util
local DefaultData = require(Util.DefaultData)
local Retry = require(Util.Retry)

local DataService = {}

local profiles = {} -- [player] = { data = table, saveEnabled = bool, lastSave = number }
local loadedCallbacks = {}
local store = nil
local storeAvailable = true

local LOCK_WAIT_SECONDS = 5
local LOCK_WAIT_ATTEMPTS = 6

local function jobId()
	-- En Studio el JobId está vacío: usamos un identificador fijo por sesión.
	if game.JobId == "" then
		return "studio-session"
	end
	return game.JobId
end

local function key(userId)
	return "club_" .. tostring(userId)
end

local function isAccessError(err)
	local msg = tostring(err)
	return msg:find("403") ~= nil
		or msg:find("API Services") ~= nil
		or msg:find("API access") ~= nil
		or msg:find("Studio") ~= nil
		or msg:find("publish") ~= nil
end

do
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(GameConfig.DATASTORE_NAME)
	end)
	if ok then
		store = result
	else
		storeAvailable = false
		warn("[DataService] DataStore no disponible: ", result)
	end
end

-- Intenta cargar y bloquear los datos. Devuelve: estado ("ok" | "locked" | "error" | "noaccess"), datos
local function tryLoad(player)
	local status, loaded = "ok", nil
	local ok, err = Retry.Call(3, 1, function()
		store:UpdateAsync(key(player.UserId), function(stored)
			local now = os.time()
			if type(stored) == "table" and type(stored.lock) == "table"
				and stored.lock.jobId ~= jobId()
				and now - (tonumber(stored.lock.time) or 0) < GameConfig.SESSION_LOCK_SECONDS then
				status = "locked"
				return nil -- cancela la escritura
			end
			status = "ok"
			local data = (type(stored) == "table" and stored.data) or nil
			loaded = data
			return {
				data = data,
				lock = { jobId = jobId(), time = now },
			}
		end)
	end)
	if not ok then
		if isAccessError(err) then
			return "noaccess", nil
		end
		warn("[DataService] Error cargando datos de ", player.Name, ": ", err)
		return "error", nil
	end
	return status, loaded
end

function DataService.Load(player)
	local saveEnabled = storeAvailable
	local rawData = nil

	if storeAvailable then
		local status
		for _ = 1, LOCK_WAIT_ATTEMPTS do
			status, rawData = tryLoad(player)
			if status ~= "locked" then
				break
			end
			if not player.Parent then
				return nil
			end
			task.wait(LOCK_WAIT_SECONDS)
		end
		if status == "locked" then
			player:Kick("Tus datos siguen abiertos en otro servidor. Vuelve a entrar en un minuto.")
			return nil
		elseif status == "noaccess" then
			warn("[DataService] Sin acceso a DataStore (activa 'Enable Studio Access to API Services'). MODO SIN GUARDADO.")
			saveEnabled = false
		elseif status == "error" then
			-- No sobrescribimos datos que no hemos podido leer: sesión sin guardado.
			saveEnabled = false
		end
	end

	local data = DefaultData.Reconcile(rawData, player)
	profiles[player] = { data = data, saveEnabled = saveEnabled, lastSave = os.clock(), isNew = rawData == nil }

	if not player.Parent then
		-- Se fue mientras cargaba: liberamos el bloqueo que acabamos de tomar.
		DataService.Release(player)
		return nil
	end
	for _, callback in ipairs(loadedCallbacks) do
		task.spawn(callback, player, data)
	end
	return data
end

function DataService.Save(player, release)
	local profile = profiles[player]
	if not profile or not profile.saveEnabled then
		return false
	end
	profile.data.lastSave = os.time()
	local lostLock = false
	local ok, err = Retry.Call(3, 1, function()
		store:UpdateAsync(key(player.UserId), function(stored)
			if type(stored) == "table" and type(stored.lock) == "table" and stored.lock.jobId ~= jobId() then
				lostLock = true
				return nil -- otro servidor tiene la sesión: no sobrescribimos
			end
			return {
				data = profile.data,
				lock = (not release) and { jobId = jobId(), time = os.time() } or nil,
			}
		end)
	end)
	if not ok then
		warn("[DataService] Error guardando datos de ", player.Name, ": ", err)
		return false
	end
	if lostLock then
		warn("[DataService] Bloqueo de sesión perdido para ", player.Name, "; no se guardó.")
		profile.saveEnabled = false
		return false
	end
	profile.lastSave = os.clock()
	return true
end

function DataService.Get(player)
	local profile = profiles[player]
	return profile and profile.data or nil
end

function DataService.IsSaveEnabled(player)
	local profile = profiles[player]
	return profile ~= nil and profile.saveEnabled
end

function DataService.IsNew(player)
	local profile = profiles[player]
	return profile ~= nil and profile.isNew
end

function DataService.OnLoaded(callback)
	table.insert(loadedCallbacks, callback)
end

function DataService.Release(player)
	if profiles[player] then
		DataService.Save(player, true)
		profiles[player] = nil
	end
end

function DataService.Start()
	-- Guardado periódico
	task.spawn(function()
		while true do
			task.wait(GameConfig.AUTOSAVE_SECONDS)
			for player in pairs(profiles) do
				if player.Parent then
					task.spawn(DataService.Save, player, false)
				end
			end
		end
	end)

	game:BindToClose(function()
		local pending = 0
		for player in pairs(profiles) do
			pending += 1
			task.spawn(function()
				DataService.Save(player, true)
				pending -= 1
			end)
		end
		local start = os.clock()
		while pending > 0 and os.clock() - start < 25 do
			task.wait(0.2)
		end
		if RunService:IsStudio() then
			task.wait(1)
		end
	end)
end

return DataService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000032"><Properties><string name="Name">EconomyService</string><ProtectedString name="Source"><![CDATA[-- EconomyService (ModuleScript)
-- Ubicación: ServerScriptService/Server/Services/EconomyService
--
-- Economía AUTORITATIVA del servidor:
--   * Ciclo económico periódico (jornada) con ingresos y gastos reales.
--   * Gastos puntuales (construcción) validados.
--   * Deuda con intereses y amortización.
--   * Historial de transacciones.
-- El cliente nunca envía cantidades de dinero: solo intenciones (p. ej. "mejorar gradas").

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local GameConfig = require(Shared.Config.GameConfig)
local EconomyFormulas = require(Shared.Modules.EconomyFormulas)
local RebirthConfig = require(Shared.Config.RebirthConfig)
local CommercialConfig = require(Shared.Config.CommercialConfig)

local DataService = require(script.Parent.DataService)

local EconomyService = {}

local nextCycleAt = {} -- [player] = os.clock() del próximo ciclo
local cycleCallbacks = {}

EconomyService.Category = {
	TICKETS = "Entradas",
	SHOP = "Tienda",
	RESTAURANT = "Restaurante",
	SPONSORS = "Patrocinadores",
	VIP = "Zona VIP",
	MAINTENANCE = "Mantenimiento",
	STAFF = "Personal",
	WAGES = "Salarios",
	INTEREST = "Intereses",
	CONSTRUCTION = "Construcción",
	DECORATION = "Decoración",
	DEBT = "Deuda",
	REFUND = "Reembolso",
	SPONSOR = "Patrocinio",
	ACADEMY = "Academia",
	ARENA = "Partidos en grupo",
	ADMIN_EVENT = "Evento admin",
	COLLECTION = "Mascotas y balones",
	REBIRTH = "Renacimiento",
	REBIRTH_BONUS = "Bonus de renacimiento",
	TRANSFER = "Fichajes",
	PRIZE = "Premios",
}
local C = EconomyService.Category

function EconomyService.AddTransaction(data, amount, category, note)
	local list = data.economy.transactions
	table.insert(list, {
		t = os.time(),
		amount = math.floor(amount),
		category = category,
		note = note,
	})
	while #list > GameConfig.MAX_TRANSACTIONS do
		table.remove(list, 1)
	end
end

-- Gasto puntual validado. Devuelve ok, mensaje.
function EconomyService.Spend(player, amount, category, note)
	local data = DataService.Get(player)
	amount = math.floor(tonumber(amount) or -1)
	if amount < 0 then
		return false, "Cantidad no válida."
	end
	if data.economy.money < amount then
		return false, "Dinero insuficiente."
	end
	data.economy.money -= amount
	data.economy.totalSpent += amount
	EconomyService.AddTransaction(data, -amount, category, note)
	return true
end

function EconomyService.Earn(player, amount, category, note)
	local data = DataService.Get(player)
	amount = math.floor(tonumber(amount) or 0)
	if amount <= 0 then
		return
	end
	data.economy.money += amount
	data.economy.totalEarned += amount
	EconomyService.AddTransaction(data, amount, category, note)
end

function EconomyService.RunCycle(player)
	local data = DataService.Get(player)
	if not data then
		return
	end
	local result = EconomyFormulas.Cycle(data)
	local economy = data.economy

	economy.money += result.totalIncome
	economy.totalEarned += result.totalIncome
	-- Bonus permanente de los renacimientos (+20 % de los ingresos por cada uno)
	local rebirthBonus = math.floor(result.totalIncome * RebirthConfig.IncomeBonus(data.rebirth and data.rebirth.count))
	if rebirthBonus > 0 then
		economy.money += rebirthBonus
		economy.totalEarned += rebirthBonus
	end
	economy.money -= result.totalExpenses
	economy.totalSpent += result.totalExpenses

	-- Déficit -> deuda
	local newDebt = 0
	if economy.money < 0 then
		newDebt = -economy.money
		economy.debt += newDebt
		economy.money = 0
	end

	-- Amortización automática con parte del beneficio
	local repaid = 0
	if result.net > 0 and economy.debt > 0 then
		repaid = math.min(economy.debt, math.floor(result.net * GameConfig.DEBT_AUTO_REPAY_SHARE), economy.money)
		economy.debt -= repaid
		economy.money -= repaid
	end

	data.club.fans = math.max(0, data.club.fans + result.fanDelta)
	data.club.members = math.clamp((data.club.members or 0) + result.memberDelta, 0, data.club.fans)
	data.club.satisfaction = math.clamp((data.club.satisfaction or GameConfig.SATISFACTION_START) + result.satisfactionDelta, 0, 100)
	data.stats.cycles += 1

	economy.lastCycle = {
		t = os.time(),
		attendance = result.attendance,
		capacity = result.capacity,
		income = result.income,
		expenses = result.expenses,
		totalIncome = result.totalIncome,
		totalExpenses = result.totalExpenses,
		net = result.net,
		fanDelta = result.fanDelta,
		memberDelta = result.memberDelta,
		satisfaction = data.club.satisfaction,
		occupancy = result.occupancy,
		contracts = result.contracts,
		newDebt = newDebt,
		repaid = repaid,
	}

	local summary = string.format("%d espectadores", result.attendance)
	EconomyService.AddTransaction(data, result.totalIncome, "Jornada", "Ingresos · " .. summary)
	EconomyService.AddTransaction(data, -result.totalExpenses, "Jornada", "Gastos (mantenimiento, personal, estadio, intereses)")
	if rebirthBonus > 0 then
		EconomyService.AddTransaction(data, rebirthBonus, C.REBIRTH_BONUS, string.format("+%d %% por %d renacimiento(s)",
			math.floor(RebirthConfig.IncomeBonus(data.rebirth.count) * 100 + 0.5), data.rebirth.count))
	end
	if newDebt > 0 then
		EconomyService.AddTransaction(data, 0, C.DEBT, string.format("Déficit de %d convertido en deuda", newDebt))
	end
	if repaid > 0 then
		EconomyService.AddTransaction(data, -repaid, C.DEBT, "Amortización automática de deuda")
	end

	for _, callback in ipairs(cycleCallbacks) do
		task.spawn(callback, player, economy.lastCycle)
	end
end

function EconomyService.RepayDebt(player, amount)
	local data = DataService.Get(player)
	local economy = data.economy
	if economy.debt <= 0 then
		return false, "No tienes deuda."
	end
	amount = math.floor(tonumber(amount) or 0)
	if amount ~= amount or amount <= 0 or amount == math.huge then -- NaN/inf enviados por un cliente = pagar todo lo posible
		amount = economy.debt -- 0 o vacío = pagar todo lo posible
	end
	amount = math.min(amount, economy.debt, economy.money)
	if amount <= 0 then
		return false, "No tienes dinero para pagar la deuda."
	end
	economy.money -= amount
	economy.debt -= amount
	economy.totalSpent += amount
	EconomyService.AddTransaction(data, -amount, C.DEBT, "Pago de deuda")
	return true, "Has pagado " .. amount .. " " .. GameConfig.CURRENCY .. " de deuda."
end

function EconomyService.SetTicketPrice(player, optionId)
	local data = DataService.Get(player)
	for _, option in ipairs(GameConfig.TICKET_PRICES) do
		if option.id == optionId then
			data.economy.ticketPrice = option.id
			return true, "Precio de entradas: " .. option.name
		end
	end
	return false, "Precio no válido."
end

-- kind: "shop" | "food" | "member"
function EconomyService.SetPricePolicy(player, kind, optionId)
	local data = DataService.Get(player)
	local field, list, label
	if kind == "shop" then
		field, list, label = "shopPrice", CommercialConfig.PricePolicies, "Precios de la tienda"
	elseif kind == "food" then
		field, list, label = "foodPrice", CommercialConfig.PricePolicies, "Precios de restauración"
	elseif kind == "member" then
		field, list, label = "memberPrice", GameConfig.MEMBER_PRICES, "Precio de los abonos"
	else
		return false, "Solicitud no válida."
	end
	for _, option in ipairs(list) do
		if option.id == optionId then
			data.economy[field] = option.id
			return true, label .. ": " .. option.name
		end
	end
	return false, "Opción no válida."
end

function EconomyService.SecondsToNextCycle(player)
	local at = nextCycleAt[player]
	if not at then
		return GameConfig.ECONOMY_CYCLE_SECONDS
	end
	return math.max(0, at - os.clock())
end

-- Resumen económico para la interfaz.
function EconomyService.Summary(player, data)
	local forecast = EconomyFormulas.Cycle(data)
	local averageIncome = forecast.totalIncome
	return {
		money = data.economy.money,
		debt = data.economy.debt,
		debtLimit = GameConfig.DEBT_BUILD_LIMIT,
		ticketPrice = data.economy.ticketPrice,
		totalEarned = data.economy.totalEarned,
		totalSpent = data.economy.totalSpent,
		clubValue = EconomyFormulas.ClubValue(data),
		wageBudget = math.floor(averageIncome * GameConfig.WAGE_BUDGET_SHARE_OF_INCOME),
		transferBudget = math.floor(data.economy.money * GameConfig.TRANSFER_BUDGET_SHARE_OF_MONEY),
		lastCycle = data.economy.lastCycle,
		forecast = {
			attendance = forecast.attendance,
			capacity = forecast.capacity,
			attractiveness = forecast.attractiveness,
			income = forecast.income,
			expenses = forecast.expenses,
			totalIncome = forecast.totalIncome,
			totalExpenses = forecast.totalExpenses,
			net = forecast.net,
			fanCap = forecast.fanCap,
			occupancy = forecast.occupancy,
			overcrowded = forecast.overcrowded,
			membersAttending = forecast.membersAttending,
			casual = forecast.casual,
			satisfactionTarget = forecast.satisfactionTarget,
			satisfactionFactors = forecast.satisfactionFactors,
			spendMultiplier = forecast.spendMultiplier,
			memberTarget = forecast.memberTarget,
			contracts = forecast.contracts,
		},
		memberPrice = data.economy.memberPrice,
		shopPrice = data.economy.shopPrice,
		foodPrice = data.economy.foodPrice,
		reputation = forecast.reputation,
		cycleSeconds = GameConfig.ECONOMY_CYCLE_SECONDS,
		nextCycleIn = EconomyService.SecondsToNextCycle(player),
		transactions = data.economy.transactions,
	}
end

function EconomyService.OnCycle(callback)
	table.insert(cycleCallbacks, callback)
end

function EconomyService.PlayerReady(player)
	nextCycleAt[player] = os.clock() + GameConfig.ECONOMY_CYCLE_SECONDS
end

function EconomyService.PlayerRemoving(player)
	nextCycleAt[player] = nil
end

function EconomyService.Start()
	task.spawn(function()
		while true do
			task.wait(1)
			local now = os.clock()
			for player, at in pairs(nextCycleAt) do
				if now >= at then
					nextCycleAt[player] = at + GameConfig.ECONOMY_CYCLE_SECONDS
					if player.Parent and DataService.Get(player) then
						local ok, err = pcall(EconomyService.RunCycle, player)
						if not ok then
							warn("[EconomyService] Error en el ciclo de ", player.Name, ": ", err)
						end
					end
				end
			end
		end
	end)
end

return EconomyService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000033"><Properties><string name="Name">GamePassService</string><ProtectedString name="Source"><![CDATA[-- GamePassService (ModuleScript)
-- Ubicación: ServerScriptService/Server/Services/GamePassService
--
-- Integración REAL con MarketplaceService:
--   * UserOwnsGamePassAsync   -> comprobación de propiedad (con reintentos y caché en memoria)
--   * GetProductInfo          -> nombre/precio reales del pase cuando exista
--   * PromptGamePassPurchase  -> lo lanza el SERVIDOR con el ID del módulo de configuración
--   * PromptGamePassPurchaseFinished -> confirmación de compra emitida por Roblox en el servidor
--
-- Reglas de seguridad:
--   * La propiedad NUNCA se lee de los datos guardados ni del cliente.
--   * Solo el estado "owned" concede ventajas. "error", "checking" o "pending_config" no.
--   * Si Roblox no responde, el juego sigue funcionando y se reintenta en segundo plano.
--   * No existe ninguna ruta de código que marque un pase como comprado sin confirmación de Roblox.

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local GameConfig = require(Shared.Config.GameConfig)
local GamePassConfig = require(Shared.Config.GamePassConfig)
local Remotes = require(Shared.Modules.Remotes)
local Retry = require(script.Parent.Parent.Util.Retry)

local GamePassService = {}

-- Estados posibles de un pase para un jugador:
GamePassService.Status = {
	PENDING_CONFIG = "pending_config", -- ID = 0: aún no creado en el Creator Dashboard
	INACTIVE = "inactive", -- pase de una fase futura
	CHECKING = "checking", -- consultando a Roblox
	OWNED = "owned", -- propiedad confirmada por Roblox
	NOT_OWNED = "not_owned", -- Roblox confirma que no lo tiene
	ERROR = "error", -- Roblox no respondió; se reintenta
}
local S = GamePassService.Status

local ownership = {} -- [player] = { [passKey] = status }
local priceCache = {} -- [passKey] = { time, ok, price, forSale, name }
local changedCallbacks = {}
local promptOpen = {} -- [player] = passKey

local shopRemote = Remotes.Get("Shop")
local notifyRemote = Remotes.Get("Notify")

local function fireChanged(player, passKey)
	for _, callback in ipairs(changedCallbacks) do
		task.spawn(callback, player, passKey)
	end
end

local function getPrice(passKey)
	local def = GamePassConfig.Get(passKey)
	if not def or not GamePassConfig.IsConfigured(passKey) then
		return nil
	end
	local cached = priceCache[passKey]
	if cached and os.clock() - cached.time < GameConfig.PRICE_CACHE_SECONDS then
		return cached
	end
	local ok, info = Retry.Call(2, 1, function()
		return MarketplaceService:GetProductInfo(def.id, Enum.InfoType.GamePass)
	end)
	local entry = { time = os.clock(), ok = ok }
	if ok and type(info) == "table" then
		entry.price = info.PriceInRobux
		entry.forSale = info.IsForSale == true and info.PriceInRobux ~= nil
		entry.name = info.Name
	else
		warn("[GamePassService] No se pudo obtener el precio de ", passKey, ": ", info)
		-- caché corta para reintentar pronto
		entry.time = os.clock() - GameConfig.PRICE_CACHE_SECONDS + 30
	end
	priceCache[passKey] = entry
	return entry
end

-- Construye el estado de la Tienda Premium para un jugador (solo datos públicos de su propia sesión).
function GamePassService.BuildShopState(player)
	local list = {}
	local states = ownership[player] or {}
	for _, passKey in ipairs(GamePassConfig.Order) do
		local def = GamePassConfig.Get(passKey)
		if def then
			local price = def.active and getPrice(passKey) or nil
			table.insert(list, {
				key = passKey,
				name = def.name,
				icon = def.icon,
				iconImage = def.iconImage,
				accent = def.accent,
				description = def.description,
				benefits = def.benefits,
				active = def.active,
				phase = def.phase,
				configured = GamePassConfig.IsConfigured(passKey),
				status = states[passKey] or (def.active and S.PENDING_CONFIG or S.INACTIVE),
				priceKnown = price ~= nil and price.ok == true,
				price = price and price.price or nil,
				forSale = price ~= nil and price.forSale == true,
			})
		end
	end
	return list
end

function GamePassService.PushShop(player)
	if player.Parent then
		shopRemote:FireClient(player, GamePassService.BuildShopState(player))
	end
end

local function setStatus(player, passKey, status)
	local states = ownership[player]
	if not states then
		return
	end
	local previous = states[passKey]
	states[passKey] = status
	if previous ~= status then
		GamePassService.PushShop(player)
		fireChanged(player, passKey)
	end
end

local function checkOwnership(player, passKey)
	local def = GamePassConfig.Get(passKey)
	if not def.active then
		setStatus(player, passKey, S.INACTIVE)
		return
	end
	if not GamePassConfig.IsConfigured(passKey) then
		setStatus(player, passKey, S.PENDING_CONFIG)
		return
	end
	-- Si ya está confirmado, no se vuelve a consultar.
	if ownership[player] and ownership[player][passKey] == S.OWNED then
		return
	end
	setStatus(player, passKey, S.CHECKING)
	local ok, owns = Retry.Call(GameConfig.OWNERSHIP_RETRY_ATTEMPTS, 1, function()
		return MarketplaceService:UserOwnsGamePassAsync(player.UserId, def.id)
	end)
	if not player.Parent or not ownership[player] then
		return
	end
	if ok then
		setStatus(player, passKey, owns and S.OWNED or S.NOT_OWNED)
	else
		warn("[GamePassService] Roblox no respondió al comprobar ", passKey, " de ", player.Name, ": ", owns)
		setStatus(player, passKey, S.ERROR)
		-- Reintento en segundo plano sin bloquear el juego.
		task.delay(GameConfig.OWNERSHIP_RECHECK_SECONDS, function()
			if player.Parent and ownership[player] and ownership[player][passKey] == S.ERROR then
				checkOwnership(player, passKey)
			end
		end)
	end
end

-- ===== API pública =====

-- La ÚNICA función que debe usarse para decidir si se concede una ventaja de pago.
function GamePassService.Owns(player, passKey)
	local states = ownership[player]
	return states ~= nil and states[passKey] == S.OWNED
end

function GamePassService.GetStatus(player, passKey)
	local states = ownership[player]
	return states and states[passKey] or S.PENDING_CONFIG
end

-- Lista de claves de pases confirmados (para el estado que se envía al cliente).
function GamePassService.OwnedList(player)
	local result = {}
	for passKey, status in pairs(ownership[player] or {}) do
		if status == S.OWNED then
			result[passKey] = true
		end
	end
	return result
end

-- Vuelve a consultar a Roblox los pases que no constan como comprados (botón «Comprobar mis pases»).
local lastRecheck = {} -- [player] = os.clock()
function GamePassService.Recheck(player)
	if lastRecheck[player] and os.clock() - lastRecheck[player] < 30 then
		return false, string.format("Ya lo comprobamos hace poco. Inténtalo en %d s.", math.ceil(30 - (os.clock() - lastRecheck[player])))
	end
	lastRecheck[player] = os.clock()
	for _, passKey in ipairs(GamePassConfig.Order) do
		local status = ownership[player] and ownership[player][passKey]
		if status ~= S.OWNED and status ~= S.CHECKING then
			task.spawn(checkOwnership, player, passKey)
		end
	end	return true, "Comprobando tus pases con Roblox…"
end

function GamePassService.OnOwnershipChanged(callback)
	table.insert(changedCallbacks, callback)
end

function GamePassService.PlayerAdded(player)
	ownership[player] = {}
	for _, passKey in ipairs(GamePassConfig.Order) do
		task.spawn(checkOwnership, player, passKey)
	end
	task.spawn(GamePassService.PushShop, player)
end

function GamePassService.PlayerRemoving(player)
	ownership[player] = nil
	promptOpen[player] = nil
	lastRecheck[player] = nil
end

-- Solicitud de compra enviada por el cliente. Devuelve ok, mensaje.
function GamePassService.RequestPurchase(player, passKey)
	if type(passKey) ~= "string" then
		return false, "Solicitud no válida."
	end
	local def = GamePassConfig.Get(passKey)
	if not def then
		return false, "Ese pase no existe."
	end
	if not def.active then
		return false, string.format("%s llegará en una fase posterior.", def.name)
	end
	if not GamePassConfig.IsConfigured(passKey) then
		return false, string.format("%s está pendiente de configuración: todavía no tiene un ID de Game Pass.", def.name)
	end
	local status = GamePassService.GetStatus(player, passKey)
	if status == S.OWNED then
		return false, "Ya tienes este pase."
	end
	if status == S.CHECKING then
		return false, "Estamos comprobando tus pases con Roblox. Inténtalo en unos segundos."
	end
	local price = getPrice(passKey)
	if price and price.ok and not price.forSale then
		return false, "Este pase no está a la venta en este momento."
	end
	if promptOpen[player] then
		return false, "Ya tienes una ventana de compra abierta."
	end
	local ok, err = pcall(function()
		MarketplaceService:PromptGamePassPurchase(player, def.id)
	end)
	if not ok then
		warn("[GamePassService] PromptGamePassPurchase falló: ", err)
		return false, "Roblox no pudo abrir la ventana de compra. Inténtalo más tarde."
	end
	promptOpen[player] = passKey
	-- Salvaguarda por si Roblox nunca llega a emitir el evento de cierre.
	task.delay(120, function()
		if promptOpen[player] == passKey then
			promptOpen[player] = nil
		end
	end)
	return true, "Abriendo la compra de Roblox…"
end

function GamePassService.Start()
	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, gamePassId, wasPurchased)
		promptOpen[player] = nil
		local passKey = GamePassConfig.GetKeyById(gamePassId)
		if not passKey or not ownership[player] then
			return
		end
		local def = GamePassConfig.Get(passKey)
		if wasPurchased then
			-- Confirmación emitida por Roblox en el servidor: el cliente no puede falsificarla.
			setStatus(player, passKey, S.OWNED)
			notifyRemote:FireClient(player, "success", string.format("¡Compra confirmada! %s %s activado.", def.icon, def.name))
			for _, callback in ipairs(GamePassService._purchaseCallbacks) do
				task.spawn(callback, player, passKey)
			end
		else
			notifyRemote:FireClient(player, "info", "Compra cancelada. No se ha realizado ningún cargo.")
			-- Por si el jugador ya lo tenía, volvemos a comprobar.
			task.spawn(checkOwnership, player, passKey)
		end
	end)
end

GamePassService._purchaseCallbacks = {}
function GamePassService.OnPurchaseConfirmed(callback)
	table.insert(GamePassService._purchaseCallbacks, callback)
end

return GamePassService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000034"><Properties><string name="Name">HalloweenService</string><ProtectedString name="Source"><![CDATA[-- HalloweenService (ModuleScript)
-- Ubicación: ServerScriptService/Server/Services/HalloweenService
--
-- EVENTO «DOCES OU TRAVESSURAS» (truco o trato):
--   * Caramelos por el campo, la plaza y los carriles de cada estadio. Se recogen tocándolos
--     (también en estadios ajenos: ¡a visitar a los vecinos!).
--   * En las puertas de las instalaciones (tecla F): trato = caramelos, truco = efecto divertido.
--   * Canje de caramelos por dinero o cosméticos de Halloween (gratuitos, sin Game Pass).
-- Todo se valida en el servidor: el cliente nunca decide cuántos caramelos tiene.

local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local HalloweenConfig = require(Shared.Config.HalloweenConfig)
local Remotes = require(Shared.Modules.Remotes)
local Layout = require(Shared.Modules.StadiumLayout)

local DataService = require(script.Parent.DataService)
local EconomyService = require(script.Parent.EconomyService)
local StadiumService = require(script.Parent.StadiumService)

local HalloweenService = {}

local candyCallbacks = {}
-- Avisa de cada caramelo conseguido (misiones, etc.)
function HalloweenService.OnCandy(callback)
	table.insert(candyCallbacks, callback)
end

local function fireCandy(player, amount)
	for _, callback in ipairs(candyCallbacks) do
		task.spawn(callback, player, amount)
	end
end

local notifyRemote = Remotes.Get("Notify")
local rng = Random.new()
local doorCooldowns = {} -- [player] = { [clave de puerta] = os.clock() }
local plotFolders = {} -- [plot] = Folder

function HalloweenService.IsActive()
	return HalloweenConfig.IsActive()
end

-- ===== Caramelos =====

-- Punto aleatorio por donde se puede caminar: césped, plaza o huecos de los carriles.
local function randomSpot()
	local roll = rng:NextNumber()
	if roll < 0.4 then
		return Vector3.new(rng:NextInteger(-45, 45), 1.6, Layout.PITCH_CENTER_Z + rng:NextInteger(-28, 28))
	elseif roll < 0.8 then
		local x = rng:NextInteger(-90, 90)
		if math.abs(x) < 16 then
			x = 16 * (x < 0 and -1 or 1) + x -- deja libre el cartel
		end
		return Vector3.new(x, 1.6, rng:NextInteger(74, 100))
	end
	local gaps = { -40, 13, 63 }
	local side = rng:NextNumber() < 0.5 and -1 or 1
	return Vector3.new(side * rng:NextInteger(100, 140), 1.6, gaps[rng:NextInteger(1, #gaps)] + rng:NextInteger(-6, 6))
end

local spawnCandy -- declarada más abajo

local function collect(player, candy, plot)
	local data = DataService.Get(player)
	if not data or not candy.Parent then
		return
	end
	local value = candy:GetAttribute("Value") or HalloweenConfig.CANDY_VALUE
	candy:Destroy()
	data.halloween.candy += value
	data.halloween.total += value
	notifyRemote:FireClient(player, "candy", { candy = data.halloween.candy, gained = value })
	fireCandy(player, value)
	task.delay(HalloweenConfig.CANDY_RESPAWN_SECONDS, function()
		if plotFolders[plot] and plotFolders[plot].Parent then
			spawnCandy(plot)
		end
	end)
end

spawnCandy = function(plot)
	local folder = plotFolders[plot]
	if not folder then
		return
	end
	local golden = rng:NextNumber() < HalloweenConfig.GOLDEN_CHANCE
	local candy = Instance.new("Part")
	candy.Name = "Candy"
	candy.Shape = Enum.PartType.Ball
	candy.Size = golden and Vector3.new(2.2, 2.2, 2.2) or Vector3.new(1.6, 1.6, 1.6)
	candy.Anchored = true
	candy.CanCollide = false
	candy.Material = Enum.Material.Neon
	candy.Color = golden and Color3.fromRGB(255, 215, 60) or (rng:NextNumber() < 0.5 and Color3.fromRGB(255, 120, 20) or Color3.fromRGB(170, 70, 220))
	candy.CFrame = plot.origin * CFrame.new(randomSpot())
	candy:SetAttribute("Value", golden and HalloweenConfig.GOLDEN_VALUE or HalloweenConfig.CANDY_VALUE)
	local light = Instance.new("PointLight")
	light.Color = candy.Color
	light.Range = 6
	light.Brightness = 1.5
	light.Parent = candy
	local sparkle = Instance.new("Sparkles")
	sparkle.SparkleColor = candy.Color
	sparkle.Enabled = golden
	sparkle.Parent = candy
	candy.Touched:Connect(function(hit)
		local character = hit:FindFirstAncestorOfClass("Model")
		local player = character and Players:GetPlayerFromCharacter(character)
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if player and humanoid and humanoid.Health > 0 then
			collect(player, candy, plot)
		end
	end)
	candy.Parent = folder
end

-- Ambientación: calabazas en la puerta y en las esquinas de la plaza.
local function decoratePlot(plot, folder)
	local spots = { Vector3.new(-14, 0, 103), Vector3.new(14, 0, 103), Vector3.new(-95, 0, 75), Vector3.new(95, 0, 75) }
	for _, pos in ipairs(spots) do
		local pumpkin = Instance.new("Part")
		pumpkin.Shape = Enum.PartType.Ball
		pumpkin.Size = Vector3.new(4, 3.4, 4)
		pumpkin.Anchored = true
		pumpkin.Color = Color3.fromRGB(240, 120, 20)
		pumpkin.Material = Enum.Material.SmoothPlastic
		pumpkin.CFrame = plot.origin * CFrame.new(pos + Vector3.new(0, 1.7, 0))
		pumpkin.Parent = folder
		local glow = Instance.new("PointLight")
		glow.Color = Color3.fromRGB(255, 150, 50)
		glow.Range = 12
		glow.Brightness = 2
		glow.Parent = pumpkin
	end
end

function HalloweenService.SetupPlot(plot)
	if not HalloweenService.IsActive() or plotFolders[plot] then
		return
	end
	local folder = Instance.new("Folder")
	folder.Name = "Halloween"
	folder.Parent = plot.model
	plotFolders[plot] = folder
	decoratePlot(plot, folder)
	for _ = 1, HalloweenConfig.CANDIES_PER_PLOT do
		spawnCandy(plot)
	end
end

function HalloweenService.ClearPlot(plot)
	local folder = plotFolders[plot]
	if folder then
		folder:Destroy()
		plotFolders[plot] = nil
	end
end

-- ===== Puertas: ¿truco o trato? =====

local function applyTrick(player, trick)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid and trick.walkSpeed then
		-- El controlador de movimiento del cliente lee este atributo (también controla el sprint)
		humanoid:SetAttribute("TrickSpeed", trick.walkSpeed)
		task.delay(trick.seconds, function()
			if humanoid.Parent and humanoid:GetAttribute("TrickSpeed") == trick.walkSpeed then
				humanoid:SetAttribute("TrickSpeed", nil)
			end
		end)
	elseif humanoid and trick.jumpPower then
		local usedPower, power, height = humanoid.UseJumpPower, humanoid.JumpPower, humanoid.JumpHeight
		humanoid.UseJumpPower = true
		humanoid.JumpPower = trick.jumpPower
		task.delay(trick.seconds, function()
			if humanoid.Parent then
				humanoid.UseJumpPower = usedPower
				humanoid.JumpPower = power
				humanoid.JumpHeight = height
			end
		end)
	end
	notifyRemote:FireClient(player, "trick", { id = trick.id, seconds = trick.seconds or 2, text = trick.text })
end

local function knock(player, plot, facilityId)
	local data = DataService.Get(player)
	if not data or not HalloweenService.IsActive() then
		return
	end
	local key = tostring(plot.index) .. ":" .. facilityId
	doorCooldowns[player] = doorCooldowns[player] or {}
	local last = doorCooldowns[player][key]
	if last and os.clock() - last < HalloweenConfig.DOOR_COOLDOWN then
		notifyRemote:FireClient(player, "info", string.format("🚪 Ya llamaste a esta puerta. Vuelve en %d s.",
			math.ceil(HalloweenConfig.DOOR_COOLDOWN - (os.clock() - last))))
		return
	end
	doorCooldowns[player][key] = os.clock()
	if rng:NextNumber() < HalloweenConfig.TREAT_CHANCE then
		local amount = rng:NextInteger(HalloweenConfig.TREAT_MIN, HalloweenConfig.TREAT_MAX)
		data.halloween.candy += amount
		data.halloween.total += amount
		notifyRemote:FireClient(player, "candy", { candy = data.halloween.candy, gained = amount, treat = true })
		fireCandy(player, amount)
	else
		applyTrick(player, HalloweenConfig.Tricks[rng:NextInteger(1, #HalloweenConfig.Tricks)])
	end
end

function HalloweenService.AttachDoor(part, plot, _, facilityId)
	if not HalloweenService.IsActive() or not HalloweenConfig.DOOR_FACILITIES[facilityId] then
		return
	end
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "TrickOrTreat"
	prompt.ActionText = "🎃 ¿Truco o trato?"
	prompt.ObjectText = HalloweenConfig.NAME
	prompt.KeyboardKeyCode = Enum.KeyCode.F
	prompt.UIOffset = Vector2.new(0, 70)
	prompt.HoldDuration = 0.3
	prompt.MaxActivationDistance = 16
	prompt.RequiresLineOfSight = false
	prompt.Parent = part
	prompt.Triggered:Connect(function(player)
		knock(player, plot, facilityId)
	end)
end

-- ===== Canje =====

function HalloweenService.Exchange(player, payload)
	local data = DataService.Get(player)
	local reward = HalloweenConfig.Reward(type(payload) == "table" and payload.reward)
	if not reward then
		return false, "Premio no válido."
	end
	if reward.unlock and data.unlocks[reward.unlock] then
		return false, "Ya tienes este premio."
	end
	if data.halloween.candy < reward.cost then
		return false, string.format("Necesitas %d caramelos (tienes %d).", reward.cost, data.halloween.candy)
	end
	data.halloween.candy -= reward.cost
	if reward.money then
		EconomyService.Earn(player, reward.money, EconomyService.Category.PRIZE, HalloweenConfig.NAME .. ": " .. reward.name)
	end
	if reward.unlock then
		data.unlocks[reward.unlock] = true
	end
	StadiumService.LogEvent(data, "halloween_reward", { name = reward.name })
	return true, string.format("%s ¡%s conseguido! (−%d 🍬)", reward.icon, reward.name, reward.cost)
end

function HalloweenService.BuildState(data)
	local rewards = {}
	for _, reward in ipairs(HalloweenConfig.Rewards) do
		table.insert(rewards, {
			id = reward.id, name = reward.name, icon = reward.icon, cost = reward.cost, money = reward.money,
			owned = reward.unlock ~= nil and data.unlocks[reward.unlock] == true,
		})
	end
	return {
		active = HalloweenService.IsActive(),
		name = HalloweenConfig.NAME,
		candy = data.halloween.candy,
		total = data.halloween.total,
		rewards = rewards,
	}
end

function HalloweenService.PlayerRemoving(player)
	doorCooldowns[player] = nil
end

function HalloweenService.Start()
	if HalloweenService.IsActive() then
		-- Atardecer de Halloween para que luzcan las calabazas y los focos
		Lighting.ClockTime = 18.6
		Lighting.Ambient = Color3.fromRGB(70, 50, 90)
		Lighting.OutdoorAmbient = Color3.fromRGB(90, 70, 110)
	end
end

return HalloweenService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000035"><Properties><string name="Name">HistoryService</string><ProtectedString name="Source"><![CDATA[-- HistoryService (ModuleScript)
-- Ubicación: ServerScriptService/Server/Services/HistoryService
--
-- HISTORIA DEL CLUB (FASE 8). Todo sale de acontecimientos reales ya registrados:
--   temporadas (LeagueService), títulos (trophies), ascensos/descensos y resultados
--   importantes (history), récords (records), estadísticas de todos los tiempos
--   (allTimeStats, MatchService), leyendas (SquadService), fichajes destacados
--   (TransferService) y evolución de la reputación (aquí).

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local GameConfig = require(Shared.Config.GameConfig)
local FootballConfig = require(Shared.Config.FootballConfig)
local EconomyFormulas = require(Shared.Modules.EconomyFormulas)

local DataService = require(script.Parent.DataService)

local HistoryService = {}

local SNAPSHOT_EVERY = 5 -- jornadas entre puntos de la gráfica de reputación

-- Texto legible de cada tipo de evento de la cronología
local function describe(e)
	local k = e.kind
	if k == "stadium_stage" then
		return "🏟️", string.format("El estadio asciende a %s (etapa %s)", tostring(e.name), tostring(e.stage))
	elseif k == "trophy" then
		return "🏆", string.format("¡Título! %s (temporada %s)", tostring(e.name), tostring(e.season))
	elseif k == "promotion" then
		return "⬆️", string.format("Ascenso de %s a %s", tostring(e.from), tostring(e.to))
	elseif k == "relegation" then
		return "⬇️", string.format("Descenso de %s a %s", tostring(e.from), tostring(e.to))
	elseif k == "big_result" then
		return "⚽", string.format("Resultado histórico: %s-%s contra %s (%s)", tostring(e.gf), tostring(e.ga), tostring(e.opponent), tostring(e.competition))
	elseif k == "transfer_in" then
		return "✍️", string.format("Fichaje de %s (media %s) por %s %s", tostring(e.name), tostring(e.ovr), tostring(e.fee), GameConfig.CURRENCY)
	elseif k == "transfer_out" then
		return "💰", string.format("Venta de %s a %s por %s %s", tostring(e.name), tostring(e.club), tostring(e.fee), GameConfig.CURRENCY)
	elseif k == "loan_in" then
		return "🔁", string.format("%s llega cedido de %s", tostring(e.name), tostring(e.club))
	elseif k == "loan_out" then
		return "🔁", string.format("%s se va cedido a %s", tostring(e.name), tostring(e.club))
	elseif k == "youth_promoted" then
		return "🧬", string.format("%s debuta desde la cantera con %s años", tostring(e.name), tostring(e.age))
	elseif k == "player_retired" then
		return "👋", string.format("Se retira %s (media máxima %s)%s", tostring(e.name), tostring(e.peak), e.legend and " · leyenda del club" or "")
	elseif k == "player_left" then
		return "🚪", string.format("%s se va al terminar su contrato", tostring(e.name))
	elseif k == "player_released" then
		return "🚪", string.format("Rescisión del contrato de %s", tostring(e.name))
	elseif k == "sponsor_signed" then
		return "🤝", string.format("Contrato de patrocinio con %s", tostring(e.brand))
	elseif k == "sponsor_expired" or k == "sponsor_terminated" then
		return "🤝", string.format("Termina el patrocinio de %s", tostring(e.brand))
	elseif k == "season_end" then
		return "📅", string.format("Fin de la temporada %s", tostring(e.season))
	elseif k == "achievement" then
		return "🎖️", string.format("Logro desbloqueado: %s", tostring(e.name))
	elseif k == "halloween_reward" then
		return "🎃", string.format("Premio del evento de Halloween: %s", tostring(e.name))
	elseif k == "rebirth" then
		return "🔄", string.format("¡Renacimiento número %s!", tostring(e.count))
	elseif k == "weekly_reward" then
		return "🌎", string.format("Puesto %s en la competición semanal del universo", tostring(e.rank))
	end
	return "•", k
end

function HistoryService.AfterCycle(player)
	local data = DataService.Get(player)
	if not data then
		return
	end
	local reputation = EconomyFormulas.Reputation(data)
	if data.records.highestReputation == nil or reputation > data.records.highestReputation.value then
		data.records.highestReputation = { value = reputation, season = data.season.number }
	end
	if data.stats.cycles % SNAPSHOT_EVERY == 0 then
		table.insert(data.reputationHistory, { season = data.season.number, cycle = data.season.cycle, value = reputation })
		while #data.reputationHistory > 60 do
			table.remove(data.reputationHistory, 1)
		end
	end
end

local function topBy(stats, field, n)
	local list = {}
	for _, s in pairs(stats) do
		if s[field] > 0 then
			table.insert(list, s)
		end
	end
	table.sort(list, function(a, b)
		if a[field] ~= b[field] then
			return a[field] > b[field]
		end
		return a.name < b.name
	end)
	local out = {}
	for i = 1, math.min(n, #list) do
		local s = list[i]
		table.insert(out, { name = s.name, pos = FootballConfig.Position(s.pos).short, value = s[field], origin = s.origin })
	end
	return out
end

function HistoryService.BuildState(data)
	local timeline = {}
	for i = #data.history, math.max(1, #data.history - 59), -1 do
		local e = data.history[i]
		if e.kind ~= "season_end" or i == #data.history then
			local icon, text = describe(e)
			table.insert(timeline, { t = e.t, icon = icon, text = text, kind = e.kind })
		end
	end
	local league = data.league or {}
	local s = data.stats
	return {
		founded = data.club.founded,
		seasons = league.history or {},
		trophies = data.trophies,
		records = data.records,
		topScorers = topBy(data.allTimeStats, "goals", 10),
		topAssists = topBy(data.allTimeStats, "assists", 10),
		topApps = topBy(data.allTimeStats, "apps", 10),
		legends = data.legends,
		reputationHistory = data.reputationHistory,
		reputationNow = EconomyFormulas.Reputation(data),
		timeline = timeline,
		totals = {
			matches = s.matchesPlayed or 0, wins = s.wins or 0, draws = s.draws or 0, losses = s.losses or 0,
			goalsFor = s.goalsFor or 0, goalsAgainst = s.goalsAgainst or 0,
			graduates = s.academyGraduates or 0, buildings = s.buildings or 0,
		},
	}
end

return HistoryService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000036"><Properties><string name="Name">HubService</string><ProtectedString name="Source"><![CDATA[-- HubService (ModuleScript)
-- Ubicación: ServerScriptService/Server/Services/HubService
--
-- PLAZA CENTRAL (junto al punto de aparición, en la avenida):
--   * Puesto de huevos y puesto de cajas de balones: tecla E abre su pantalla.
--   * Tablón del pase de temporada y de la semana (bonus y estadio destacado).
--   * Tablón con el top 10 mundial de goleadores.
--   * Ambiente: atmósfera, brillo suave y rayos de sol.
-- Son carteles e indicaciones: comprar y abrir se sigue validando en el servidor como siempre.

local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage.Shared
local CollectionConfig = require(Shared.Config.CollectionConfig)
local SeasonConfig = require(Shared.Config.SeasonConfig)
local WeeklyConfig = require(Shared.Config.WeeklyConfig)
local ArenaConfig = require(Shared.Config.ArenaConfig)
local Remotes = require(Shared.Modules.Remotes)

local PetService = require(script.Parent.PetService)

local HubService = {}

local notifyRemote = Remotes.Get("Notify")
local folder
local seasonLabel
local boardLabels = {} -- [idClasificación] = TextLabel
local eggLabels = {} -- [id] = TextLabel con el precio

local DARK = Color3.fromRGB(18, 22, 34)
local GOLD = Color3.fromRGB(255, 200, 60)

local function part(props)
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for key, value in pairs(props) do
		p[key] = value
	end
	p.Parent = folder
	return p
end

local function billboard(adornee, text, height, width)
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(width or 240, 50)
	gui.StudsOffset = Vector3.new(0, height, 0)
	gui.MaxDistance = 120
	gui.Parent = adornee
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBlack
	label.TextScaled = true
	label.RichText = true
	label.TextColor3 = Color3.new(1, 1, 1)
	label.TextStrokeTransparency = 0.3
	label.Text = text
	label.Parent = gui
	return label
end

-- Indicación con la tecla E que abre una pantalla del menú del jugador
local function openPrompt(target, actionText, objectText, screen, params)
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = actionText
	prompt.ObjectText = objectText
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.MaxActivationDistance = 16
	prompt.RequiresLineOfSight = false
	prompt.Parent = target
	prompt.Triggered:Connect(function(player)
		notifyRemote:FireClient(player, "open", { screen = screen, params = params })
	end)
end

local function board(cframe, face, title, color)
	for _, dx in ipairs({ -10, 10 }) do
		part({ Name = "Leg", Size = Vector3.new(1, 6, 1), CFrame = cframe * CFrame.new(dx, -8, 0), Color = Color3.fromRGB(60, 62, 72), Material = Enum.Material.Metal })
	end
	local panel = part({ Name = "Board", Size = Vector3.new(26, 14, 1), CFrame = cframe, Color = DARK })
	part({ Name = "Trim", Size = Vector3.new(27, 1, 1.2), CFrame = cframe * CFrame.new(0, 7.5, 0), Color = color, Material = Enum.Material.Neon })
	local gui = Instance.new("SurfaceGui")
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 30
	gui.Parent = panel
	local heading = Instance.new("TextLabel")
	heading.Size = UDim2.fromScale(1, 0.2)
	heading.BackgroundTransparency = 1
	heading.Font = Enum.Font.GothamBlack
	heading.TextScaled = true
	heading.TextColor3 = color
	heading.Text = title
	heading.Parent = gui
	local body = Instance.new("TextLabel")
	body.Position = UDim2.fromScale(0.04, 0.22)
	body.Size = UDim2.fromScale(0.92, 0.74)
	body.BackgroundTransparency = 1
	body.Font = Enum.Font.GothamBold
	body.TextScaled = true
	body.RichText = true
	body.TextColor3 = Color3.new(1, 1, 1)
	body.TextXAlignment = Enum.TextXAlignment.Left
	body.TextYAlignment = Enum.TextYAlignment.Top
	body.Text = ""
	body.Parent = gui
	return panel, body
end

local function buildEggStand()
	local center = CFrame.new(-44, 0, 0)
	local base = part({ Name = "EggStand", Shape = Enum.PartType.Cylinder, Size = Vector3.new(1, 40, 40),
		CFrame = center * CFrame.new(0, 0.5, 0) * CFrame.Angles(0, 0, math.pi / 2), Color = Color3.fromRGB(70, 50, 110), Material = Enum.Material.Marble })
	billboard(base, "🥚 HUEVOS DE MASCOTAS", 13, 300)
	openPrompt(base, "Abrir huevos", "Mascotas", "collection", { tab = "pets" })
	local looks = {
		basic = { color = Color3.fromRGB(250, 245, 230), material = Enum.Material.SmoothPlastic },
		golden = { color = GOLD, material = Enum.Material.Neon },
		champion = { color = Color3.fromRGB(170, 90, 255), material = Enum.Material.Neon },
		jungle = { color = Color3.fromRGB(70, 170, 70), material = Enum.Material.LeafyGrass },
		ocean = { color = Color3.fromRGB(60, 150, 230), material = Enum.Material.Glass },
		rebirth = { color = Color3.fromRGB(255, 120, 40), material = Enum.Material.Neon },
	}
	for i, egg in ipairs(CollectionConfig.Eggs) do
		local x = (i - (#CollectionConfig.Eggs + 1) / 2) * 6
		part({ Name = "Pedestal", Size = Vector3.new(3, 3, 3), CFrame = center * CFrame.new(x, 2.5, 0), Color = Color3.fromRGB(235, 235, 240), Material = Enum.Material.Marble })
		local look = looks[egg.id] or looks.basic
		local shell = part({ Name = "Egg", Size = Vector3.new(3, 4, 3), CFrame = center * CFrame.new(x, 6, 0), Color = look.color, Material = look.material, CanCollide = false })
		local mesh = Instance.new("SpecialMesh")
		mesh.MeshType = Enum.MeshType.Sphere
		mesh.Parent = shell
		eggLabels[egg.id] = billboard(shell, "", 3.2, 200)
	end
end

local function buildCrateStand()
	local center = CFrame.new(-84, 0, 0)
	local base = part({ Name = "CrateStand", Size = Vector3.new(12, 1, 12), CFrame = center * CFrame.new(0, 0.5, 0), Color = Color3.fromRGB(40, 70, 120), Material = Enum.Material.Marble })
	billboard(base, "📦 CAJAS DE BALONES", 11, 300)
	openPrompt(base, "Abrir cajas", "Balones", "collection", { tab = "balls" })
	part({ Name = "Crate", Size = Vector3.new(5, 5, 5), CFrame = center * CFrame.new(-3, 3.5, 0) * CFrame.Angles(0, math.rad(20), 0), Color = Color3.fromRGB(160, 110, 60), Material = Enum.Material.WoodPlanks })
	part({ Name = "EliteCrate", Size = Vector3.new(4, 4, 4), CFrame = center * CFrame.new(3, 3, 1) * CFrame.Angles(0, math.rad(-15), 0), Color = GOLD, Material = Enum.Material.Metal })
	local ballShow = part({ Name = "Ball", Shape = Enum.PartType.Ball, Size = Vector3.new(2.6, 2.6, 2.6), CFrame = center * CFrame.new(0, 7.5, 0),
		Color = Color3.fromRGB(110, 60, 220), Material = Enum.Material.Neon, CanCollide = false })
	local sparkles = Instance.new("Sparkles")
	sparkles.SparkleColor = Color3.fromRGB(200, 160, 255)
	sparkles.Parent = ballShow
end

local function formatDate(timestamp)
	return os.date("!%d/%m", timestamp)
end

-- Textos que dependen de la fecha (temporada, semana y precios con descuento)
local function refreshTexts()
	local season = SeasonConfig.Current()
	local weekly = WeeklyConfig.Current()
	local bonus = WeeklyConfig.Bonus(weekly.bonusId)
	local theme = ArenaConfig.Theme(weekly.themeId)
	seasonLabel.Text = string.format(
		"%s <b>%s</b> (temporada %d)\nTermina el %s · 20 niveles de premios\n\n📅 <b>Esta semana:</b> %s %s\n%s Estadio destacado: %s\nCambia el %s",
		season.theme.icon, season.theme.name, season.number, formatDate(season.endsAt),
		bonus.icon, bonus.name, theme.icon, theme.name, formatDate(weekly.endsAt))
	for _, egg in ipairs(CollectionConfig.Eggs) do
		local label = eggLabels[egg.id]
		if label then
			label.Text = string.format("%s %s\n<font color='#FFD23C'>%d $</font>", egg.icon, egg.name, PetService.EggCost(egg))
		end
	end
end

-- Lo llama LeaderboardService con el top 10 mundial de cada clasificación
function HubService.SetLeaderboard(boardId, list, available)
	local label = boardLabels[boardId]
	if not label then
		return
	end
	if not available then
		label.Text = "La clasificación mundial no está disponible en esta sesión."
		return
	end
	if #list == 0 then
		label.Text = "Todavía no hay nadie.\n¡Juega un partido en grupo y sé el primero!"
		return
	end
	local lines = {}
	for position, entry in ipairs(list) do
		local medal = position == 1 and "🥇" or (position == 2 and "🥈" or (position == 3 and "🥉" or string.format("%d.", position)))
		table.insert(lines, string.format("%s %s — <b>%d</b>", medal, entry.name, entry.value))
	end
	label.Text = table.concat(lines, "\n")
end

local function polishLighting()
	if not Lighting:FindFirstChildOfClass("Atmosphere") then
		local atmosphere = Instance.new("Atmosphere")
		atmosphere.Density = 0.28
		atmosphere.Offset = 0.2
		atmosphere.Haze = 1.2
		atmosphere.Glare = 0.2
		atmosphere.Color = Color3.fromRGB(200, 215, 235)
		atmosphere.Decay = Color3.fromRGB(110, 125, 150)
		atmosphere.Parent = Lighting
	end
	if not Lighting:FindFirstChildOfClass("BloomEffect") then
		local bloom = Instance.new("BloomEffect")
		bloom.Intensity = 0.35
		bloom.Size = 24
		bloom.Threshold = 1.1
		bloom.Parent = Lighting
	end
	if not Lighting:FindFirstChildOfClass("ColorCorrectionEffect") then
		local color = Instance.new("ColorCorrectionEffect")
		color.Saturation = 0.12
		color.Contrast = 0.06
		color.Parent = Lighting
	end
	if not Lighting:FindFirstChildOfClass("SunRaysEffect") then
		local rays = Instance.new("SunRaysEffect")
		rays.Intensity = 0.06
		rays.Spread = 0.8
		rays.Parent = Lighting
	end
end

function HubService.Start()
	folder = Instance.new("Folder")
	folder.Name = "FEU_Hub"
	folder.Parent = Workspace
	buildEggStand()
	buildCrateStand()
	-- Tablones a los lados del punto de aparición, mirando hacia él
	local seasonBoard, seasonBody = board(CFrame.new(0, 11, 22), Enum.NormalId.Front, "🎟️ PASE DE TEMPORADA", GOLD)
	seasonLabel = seasonBody
	openPrompt(seasonBoard, "Ver el pase", "Pase de temporada", "season")
	local _, goalsBody = board(CFrame.new(0, 11, -22), Enum.NormalId.Back, "⚽ TOP GOLEADORES DEL MUNDO", Color3.fromRGB(90, 220, 255))
	boardLabels.goals = goalsBody
	goalsBody.Text = "Cargando la clasificación…"
	local trophyBoard, trophyBody = board(CFrame.new(30, 11, -22), Enum.NormalId.Back, "🏆 TOP TROFEOS DEL MUNDO", GOLD)
	boardLabels.trophies = trophyBody
	trophyBody.Text = "Cargando la clasificación…"
	openPrompt(trophyBoard, "Ver mi camino", "Camino de trofeos", "trophies")
	polishLighting()
	task.spawn(function()
		while true do
			refreshTexts()
			task.wait(600)
		end
	end)
end

return HubService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000037"><Properties><string name="Name">InteractionService</string><ProtectedString name="Source"><![CDATA[-- InteractionService (ModuleScript)
-- Ubicación: ServerScriptService/Server/Services/InteractionService
--
-- ESTADIO INTERACTIVO: el estadio se juega caminando, como cualquier juego de Roblox.
--   * Cada instalación tiene una indicación (ProximityPrompt, tecla E): el dueño abre
--     su menú directamente; un visitante ve de quién es el estadio (sin datos privados).
--   * Un balón físico en cada campo: se chuta al tocarlo y los goles se celebran.
-- Otros servicios (p. ej. el evento de Halloween) pueden añadir más indicaciones con OnFacility.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Remotes = require(Shared.Modules.Remotes)
local BallSkin = require(script.Parent.Parent.Util.BallSkin)
local Layout = require(Shared.Modules.StadiumLayout)

local InteractionService = {}

local notifyRemote = Remotes.Get("Notify")

-- Qué abre cada instalación: { texto, pantalla, parámetros }
local ACTIONS = {
	lockers = { "Vestuario: ver la plantilla", "squad" },
	training = { "Entrenamiento: plantilla", "squad" },
	academy = { "Academia: ver la cantera", "academy" },
	trophyRoom = { "Sala de trofeos: historia", "history" },
	shop = { "Tienda: gestión comercial", "economy", { tab = "commercial" } },
	restaurant = { "Restaurante: gestión comercial", "economy", { tab = "commercial" } },
	kiosks = { "Quioscos: gestión comercial", "economy", { tab = "commercial" } },
	tour = { "Tour del estadio", "economy", { tab = "commercial" } },
	vip = { "Zona VIP: patrocinadores", "economy", { tab = "sponsors" } },
	sign = { "Mi club", "club" },
}

local facilityHooks = {}
local balls = {} -- [plot] = { ball, origin, lastKicker, cooldown }

function InteractionService.OnFacility(fn)
	table.insert(facilityHooks, fn)
end

-- Añade las indicaciones a las instalaciones recién construidas de un terreno.
function InteractionService.Attach(plot, owner, clubName)
	for _, part in ipairs(plot.stadium:GetDescendants()) do
		local facilityId = part:IsA("BasePart") and part:GetAttribute("Facility")
		local action = facilityId and ACTIONS[facilityId]
		if action then
			local prompt = Instance.new("ProximityPrompt")
			prompt.Name = "OpenPrompt"
			prompt.ActionText = action[1]
			prompt.ObjectText = clubName
			prompt.KeyboardKeyCode = Enum.KeyCode.E
			prompt.HoldDuration = 0
			prompt.MaxActivationDistance = 16
			prompt.RequiresLineOfSight = false
			prompt.Parent = part
			prompt.Triggered:Connect(function(player)
				if player == owner then
					notifyRemote:FireClient(player, "open", { screen = action[2], params = action[3] })
				else
					notifyRemote:FireClient(player, "info", string.format("🏟️ Estás visitando el estadio de %s (%s). Solo su dueño puede gestionarlo.",
						clubName, owner.DisplayName))
				end
			end)
			for _, hook in ipairs(facilityHooks) do
				hook(part, plot, owner, facilityId, clubName)
			end
		end
	end
end

-- ===== Balón =====

local KICK_SPEED = 55
local KICK_LIFT = 16
local BALL_SIZE = 2.6

local function centerCFrame(origin)
	return origin * CFrame.new(0, 3, Layout.PITCH_CENTER_Z)
end

local function resetBall(entry)
	entry.ball.AssemblyLinearVelocity = Vector3.zero
	entry.ball.AssemblyAngularVelocity = Vector3.zero
	entry.ball.CFrame = centerCFrame(entry.origin)
end

function InteractionService.EnsureBall(plot, owner)
	if balls[plot] and balls[plot].ball.Parent then
		balls[plot].owner = owner
		return
	end
	local ball = Instance.new("Part")
	ball.Name = "Ball"
	ball.Shape = Enum.PartType.Ball
	ball.Size = Vector3.new(BALL_SIZE, BALL_SIZE, BALL_SIZE)
	ball.Color = Color3.fromRGB(250, 250, 250)
	ball.Material = Enum.Material.SmoothPlastic
	ball.CustomPhysicalProperties = PhysicalProperties.new(0.25, 0.4, 0.5, 1, 1)
	ball.CFrame = centerCFrame(plot.origin)
	ball.Parent = plot.model
	ball:SetNetworkOwner(nil) -- el servidor controla el balón (goles fiables)
	local entry = { ball = ball, origin = plot.origin, owner = owner, kickCooldown = {}, celebrating = false }
	balls[plot] = entry
	ball.Touched:Connect(function(hit)
		local character = hit:FindFirstAncestorOfClass("Model")
		local player = character and Players:GetPlayerFromCharacter(character)
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if not player or not root or entry.celebrating then
			return
		end
		local now = os.clock()
		if entry.kickCooldown[player] and now - entry.kickCooldown[player] < 0.25 then
			return
		end
		entry.kickCooldown[player] = now
		entry.lastKicker = player
		local direction = (ball.Position - root.Position) * Vector3.new(1, 0, 1)
		if direction.Magnitude < 0.1 then
			direction = root.CFrame.LookVector
		end
		ball.AssemblyLinearVelocity = direction.Unit * KICK_SPEED + Vector3.new(0, KICK_LIFT, 0)
	end)
end

-- Aspecto del balón del estadio (balón coleccionable equipado por su dueño).
function InteractionService.SetBallSkin(plot, skinId)
	local entry = plot and balls[plot]
	if entry and entry.ball.Parent then
		BallSkin.Apply(entry.ball, skinId)
	end
end

function InteractionService.RemoveBall(plot)
	local entry = balls[plot]
	if entry then
		entry.ball:Destroy()
		balls[plot] = nil
	end
end

local function celebrate(entry, side)
	entry.celebrating = true
	local kicker = entry.lastKicker
	local goalPos = entry.origin * CFrame.new(side * Layout.PITCH_LENGTH / 2, 4, Layout.PITCH_CENTER_Z)
	local burst = Instance.new("Part")
	burst.Anchored = true
	burst.CanCollide = false
	burst.Transparency = 1
	burst.CFrame = goalPos
	burst.Parent = entry.ball.Parent
	local confetti = Instance.new("ParticleEmitter")
	confetti.Color = ColorSequence.new(Color3.fromRGB(255, 200, 40), Color3.fromRGB(40, 200, 120))
	confetti.Size = NumberSequence.new(0.5)
	confetti.Speed = NumberRange.new(15, 25)
	confetti.SpreadAngle = Vector2.new(60, 60)
	confetti.Lifetime = NumberRange.new(2, 3)
	confetti.Acceleration = Vector3.new(0, -20, 0)
	confetti.Rate = 0
	confetti.Parent = burst
	confetti:Emit(120)
	local text = string.format("⚽ ¡GOOOL%s en el estadio de %s!", kicker and (" de " .. kicker.DisplayName) or "",
		entry.owner and entry.owner.DisplayName or "?")
	local notified = {}
	for _, p in ipairs({ kicker or false, entry.owner or false }) do
		if p and p.Parent and not notified[p] then
			notified[p] = true
			notifyRemote:FireClient(p, "success", text)
		end
	end
	task.delay(3, function()
		burst:Destroy()
		if entry.ball.Parent then
			resetBall(entry)
		end
		entry.celebrating = false
	end)
end

function InteractionService.Start()
	RunService.Heartbeat:Connect(function()
		for _, entry in pairs(balls) do
			local ball = entry.ball
			if ball.Parent and not entry.celebrating then
				local p = entry.origin:PointToObjectSpace(ball.Position)
				local dz = math.abs(p.Z - Layout.PITCH_CENTER_Z)
				if math.abs(p.X) > Layout.PITCH_LENGTH / 2 + 0.5 and dz < 6 and p.Y < 6.5 then
					celebrate(entry, p.X > 0 and 1 or -1)
				elseif math.abs(p.X) > Layout.PITCH_LENGTH / 2 + 10 or dz > Layout.PITCH_WIDTH / 2 + 6 or p.Y < -10 or p.Y > 120 then
					resetBall(entry) -- fuera del campo: vuelve al centro
				end
			end
		end
	end)
end

return InteractionService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000038"><Properties><string name="Name">LeaderboardService</string><ProtectedString name="Source"><![CDATA[-- LeaderboardService (ModuleScript)
-- Ubicación: ServerScriptService/Server/Services/LeaderboardService
--
-- CLASIFICACIONES MUNDIALES (entre todos los servidores) con OrderedDataStore:
--   * «goals»: total de goles en partidos en grupo · «trophies»: trofeos actuales.
--   * Se guardan datos del servidor (nunca valores enviados por el cliente).
--   * Se escribe como mucho una vez por minuto por jugador y al salir, para no gastar el cupo.
--   * Cada 2 minutos se lee el top 10 y se avisa a quien lo muestre (el tablón de la plaza).
-- Si DataStore no está disponible (Studio sin acceso a la API), el juego sigue y el tablón lo indica.

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")

local DataService = require(script.Parent.DataService)

local LeaderboardService = {}

local WRITE_SECONDS = 60
local READ_SECONDS = 120
local TOP = 10

-- Clasificaciones: id -> almacén y valor que se guarda
local BOARDS = {
	{ id = "goals", store = "FEU_TopGoals_v1", value = function(data) return data.stats.arenaGoals end },
	{ id = "trophies", store = "FEU_TopTrophies_v1", value = function(data) return data.arena.trophies end },
}

local stores = {} -- [id] = OrderedDataStore | false
local lastWritten = {} -- [player] = { [id] = { value, time } }
local names = {} -- [userId] = nombre (caché)
local listeners = {}

local function getStore(board)
	if stores[board.id] == nil then
		local ok, result = pcall(function()
			return DataStoreService:GetOrderedDataStore(board.store)
		end)
		stores[board.id] = ok and result or false
	end
	return stores[board.id] or nil
end

local function nameOf(userId)
	if names[userId] then
		return names[userId]
	end
	local player = Players:GetPlayerByUserId(userId)
	if player then
		names[userId] = player.Name
		return player.Name
	end
	local ok, result = pcall(function()
		return Players:GetNameFromUserIdAsync(userId)
	end)
	names[userId] = ok and result or ("Jugador " .. userId)
	return names[userId]
end

-- Guarda los valores del jugador que han cambiado (force = sin esperar al minuto, p. ej. al salir).
function LeaderboardService.Submit(player, force)
	local data = DataService.Get(player)
	if not data or not DataService.IsSaveEnabled(player) then
		return
	end
	lastWritten[player] = lastWritten[player] or {}
	for _, board in ipairs(BOARDS) do
		local ordered = getStore(board)
		local value = board.value(data)
		local last = lastWritten[player][board.id]
		local changed = not last or last.value ~= value
		local due = force or not last or os.clock() - last.time >= WRITE_SECONDS
		if ordered and changed and due and (value > 0 or last) then
			lastWritten[player][board.id] = { value = value, time = os.clock() }
			local userId = player.UserId
			task.spawn(function()
				local ok, err = pcall(function()
					ordered:SetAsync(tostring(userId), value)
				end)
				if not ok then
					warn("[LeaderboardService] No se pudo guardar la clasificación ", board.id, ": ", err)
				end
			end)
		end
	end
end

-- Devuelve el top de una clasificación, o nil si no está disponible
local function read(board)
	local ordered = getStore(board)
	if not ordered then
		return nil
	end
	local ok, result = pcall(function()
		local pages = ordered:GetSortedAsync(false, TOP)
		return pages:GetCurrentPage()
	end)
	if not ok then
		return nil
	end
	local list = {}
	for _, entry in ipairs(result) do
		local userId = tonumber(entry.key)
		if userId and entry.value > 0 then
			table.insert(list, { name = nameOf(userId), value = entry.value })
		end
	end
	return list
end

-- callback(idClasificación, lista { name, value }, disponible)
function LeaderboardService.OnUpdate(callback)
	table.insert(listeners, callback)
end

function LeaderboardService.PlayerRemoving(player)
	LeaderboardService.Submit(player, true)
	lastWritten[player] = nil
end

function LeaderboardService.Start()
	task.spawn(function()
		while true do
			for _, board in ipairs(BOARDS) do
				local list = read(board)
				for _, callback in ipairs(listeners) do
					task.spawn(callback, board.id, list or {}, list ~= nil)
				end
			end
			task.wait(READ_SECONDS)
		end
	end)
end

return LeaderboardService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000039"><Properties><string name="Name">LeagueService</string><ProtectedString name="Source"><![CDATA[-- LeagueService (ModuleScript)
-- Ubicación: ServerScriptService/Server/Services/LeagueService
--
-- FASE 7: LIGAS (10 equipos, ida y vuelta), COPA (eliminatorias), CALENDARIO,
-- CLASIFICACIÓN, ASCENSOS/DESCENSOS y MODO CARRERA (objetivos de la junta directiva,
-- historial de temporadas y palmarés). Todo se simula en el servidor con MatchEngine.
-- Los partidos del usuario se juegan automáticamente en cada jornada con su alineación
-- y su táctica (MatchService.Play), y se presentan como partidos SIMULADOS.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local GameConfig = require(Shared.Config.GameConfig)
local LeagueConfig = require(Shared.Config.LeagueConfig)
local TacticsConfig = require(Shared.Config.TacticsConfig)
local MatchEngine = require(Shared.Modules.MatchEngine)

local DataService = require(script.Parent.DataService)
local EconomyService = require(script.Parent.EconomyService)
local StadiumService = require(script.Parent.StadiumService)
local MatchService = require(script.Parent.MatchService)

local LeagueService = {}

local rng = Random.new()
local USER = "user"

-- ===== Equipos y calendario =====

local function newTeamId(league)
	league.nextTeamId = (league.nextTeamId or 0) + 1
	return "t" .. league.nextTeamId
end

local function makeAITeam(league, strength)
	local name, short = MatchService.RandomClubName()
	return {
		id = newTeamId(league),
		name = name,
		short = short,
		strength = math.clamp(math.floor(strength + 0.5), 30, 95),
		formation = TacticsConfig.Formations[rng:NextInteger(1, #TacticsConfig.Formations)].id,
		mentality = TacticsConfig.Mentalities[rng:NextInteger(1, #TacticsConfig.Mentalities)].id,
		style = TacticsConfig.Styles[rng:NextInteger(1, #TacticsConfig.Styles)].id,
		seed = rng:NextInteger(1, 2 ^ 30),
	}
end

local function randomStrength(division)
	return rng:NextInteger(division.strength[1], division.strength[2])
end

-- Liga de ida y vuelta por el método del círculo.
local function roundRobin(ids)
	local list = table.clone(ids)
	if #list % 2 == 1 then
		table.insert(list, "bye")
	end
	local n = #list
	local rounds = {}
	for r = 1, n - 1 do
		local pairs_ = {}
		for i = 1, n / 2 do
			local a, b = list[i], list[n - i + 1]
			if a ~= "bye" and b ~= "bye" then
				if (r + i) % 2 == 0 then
					table.insert(pairs_, { h = a, a = b })
				else
					table.insert(pairs_, { h = b, a = a })
				end
			end
		end
		table.insert(rounds, pairs_)
		-- rotar todos menos el primero
		table.insert(list, 2, table.remove(list, n))
	end
	local second = {}
	for _, round in ipairs(rounds) do
		local mirrored = {}
		for _, p in ipairs(round) do
			table.insert(mirrored, { h = p.a, a = p.h })
		end
		table.insert(second, mirrored)
	end
	for _, round in ipairs(second) do
		table.insert(rounds, round)
	end
	return rounds
end

local function teamMap(league)
	local map = {}
	for _, t in ipairs(league.teams) do
		map[t.id] = t
	end
	return map
end

-- ===== Copa =====

local function newCup(data, league)
	local strength = MatchService.TeamStrength(data)
	local teams = { USER }
	league.cupTeams = {}
	for _ = 1, LeagueConfig.CUP_TEAMS - 1 do
		local t = makeAITeam(league, strength + rng:NextInteger(-10, 8))
		table.insert(league.cupTeams, t)
		table.insert(teams, t.id)
	end
	-- sorteo
	for i = #teams, 2, -1 do
		local j = rng:NextInteger(1, i)
		teams[i], teams[j] = teams[j], teams[i]
	end
	league.cup = { participants = teams, rounds = {}, alive = true, champion = nil }
end

-- ===== Objetivo de la junta =====

local function boardObjective(data, league)
	local division = LeagueConfig.Division(league.division)
	local userStrength = MatchService.TeamStrength(data)
	local rank = 1
	for _, t in ipairs(league.teams) do
		if t.strength > userStrength then
			rank += 1
		end
	end
	local objective
	if division.promote == 0 and rank <= 2 then
		objective = { type = "title", target = 1, text = "Ganar la liga" }
	elseif division.promote > 0 and rank <= division.promote + 1 then
		objective = { type = "position", target = division.promote, text = string.format("Ascender (quedar entre los %d primeros)", division.promote) }
	elseif rank <= 6 then
		objective = { type = "position", target = 5, text = "Quedar entre los 5 primeros" }
	else
		local safe = LeagueConfig.TEAMS - math.max(2, division.relegate)
		objective = { type = "position", target = safe, text = division.relegate > 0 and "Evitar el descenso" or string.format("Quedar entre los %d primeros", safe) }
	end
	objective.expectedRank = rank
	return objective
end

-- Crea (o renueva) la liga de una temporada.
function LeagueService.NewLeague(data, seasonNumber, level, keepTeams)
	local old = data.league or {}
	local league = {
		season = seasonNumber,
		division = level,
		teams = {},
		fixtures = {},
		results = {},
		nextTeamId = old.nextTeamId or 0,
		boardConfidence = old.boardConfidence or LeagueConfig.BOARD_START,
		history = old.history or {},
	}
	local division = LeagueConfig.Division(level)
	for _, t in ipairs(keepTeams or {}) do
		t.strength = math.clamp(t.strength + rng:NextInteger(-LeagueConfig.AI_DRIFT, LeagueConfig.AI_DRIFT), 30, 95)
		table.insert(league.teams, t)
	end
	while #league.teams < LeagueConfig.TEAMS - 1 do
		table.insert(league.teams, makeAITeam(league, randomStrength(division)))
	end
	local ids = { USER }
	for _, t in ipairs(league.teams) do
		table.insert(ids, t.id)
	end
	league.fixtures = roundRobin(ids)
	data.league = league
	newCup(data, league)
	league.objective = boardObjective(data, league)
	return league
end

-- ===== Clasificación =====

function LeagueService.Standings(data)
	local league = data.league
	local rows, byId = {}, {}
	local function row(id, name, short)
		local r = { id = id, name = name, short = short, p = 0, w = 0, d = 0, l = 0, gf = 0, ga = 0, pts = 0, form = {} }
		byId[id] = r
		table.insert(rows, r)
	end
	row(USER, data.__clubName or "Tu club", data.__clubShort or "TÚ")
	for _, t in ipairs(league.teams) do
		row(t.id, t.name, t.short)
	end
	for round = 1, LeagueConfig.LEAGUE_ROUNDS do
		for _, m in ipairs(league.results[tostring(round)] or {}) do
			local h, a = byId[m.h], byId[m.a]
			if h and a then
				h.p += 1
				a.p += 1
				h.gf += m.hg
				h.ga += m.ag
				a.gf += m.ag
				a.ga += m.hg
				if m.hg > m.ag then
					h.w += 1
					a.l += 1
					h.pts += LeagueConfig.POINTS_WIN
					table.insert(h.form, "V")
					table.insert(a.form, "D")
				elseif m.hg < m.ag then
					a.w += 1
					h.l += 1
					a.pts += LeagueConfig.POINTS_WIN
					table.insert(h.form, "D")
					table.insert(a.form, "V")
				else
					h.d += 1
					a.d += 1
					h.pts += LeagueConfig.POINTS_DRAW
					a.pts += LeagueConfig.POINTS_DRAW
					table.insert(h.form, "E")
					table.insert(a.form, "E")
				end
			end
		end
	end
	table.sort(rows, function(x, y)
		if x.pts ~= y.pts then
			return x.pts > y.pts
		end
		local dx, dy = x.gf - x.ga, y.gf - y.ga
		if dx ~= dy then
			return dx > dy
		end
		if x.gf ~= y.gf then
			return x.gf > y.gf
		end
		return x.name < y.name
	end)
	for i, r in ipairs(rows) do
		r.position = i
		while #r.form > 5 do
			table.remove(r.form, 1)
		end
	end
	return rows
end

-- ===== Jugar =====

local function aiVsAi(home, away)
	local result = MatchEngine.Simulate(MatchService.BuildAISheet(home), MatchService.BuildAISheet(away), rng, { crowd = 0.5 })
	return result.home.goals, result.away.goals
end

local function countAvailable(data)
	local n = 0
	for _, p in ipairs(data.squad) do
		if (p.injury or 0) <= 0 and not (p.loan and p.loan.type == "out") then
			n += 1
		end
	end
	return n
end

-- Partido del usuario (o incomparecencia si no tiene 11 jugadores disponibles).
local function playUserMatch(player, data, opponent, home, competition, prizeScale)
	if countAvailable(data) < 11 then
		return nil, home and 0 or 3, home and 3 or 0, "⚠️ Sin 11 jugadores disponibles: partido perdido 0-3 por incomparecencia."
	end
	local result = MatchService.Play(player, opponent, {
		clubName = data.__clubName, clubShort = data.__clubShort, home = home,
		competition = competition, prizeScale = prizeScale,
	})
	return result, result.home.goals, result.away.goals, nil
end

local function playLeagueRound(player, data, round, out)
	local league = data.league
	local map = teamMap(league)
	local division = LeagueConfig.Division(league.division)
	local results = {}
	for _, pair in ipairs(league.fixtures[round] or {}) do
		local hg, ag
		if pair.h == USER or pair.a == USER then
			local home = pair.h == USER
			local opponent = map[home and pair.a or pair.h]
			local result, g1, g2, warning = playUserMatch(player, data, opponent, home, "Liga", division.prize * LeagueConfig.MATCH_PRIZE_SCALE)
			hg, ag = g1, g2
			if warning then
				table.insert(out.messages, warning)
			end
			if result then
				out.result = result
				out.points = (out.points or 0) + (result.outcome == "W" and 3 or (result.outcome == "D" and 1 or 0))
				local us = home and hg or ag
				local them = home and ag or hg
				table.insert(out.messages, string.format("⚽ Liga, jornada %d: %s %d - %d %s", round,
					home and data.__clubShort or opponent.short, hg, ag, home and opponent.short or data.__clubShort)
					.. (us > them and " · ¡Victoria!" or (us == them and " · Empate" or " · Derrota")))
			end
		else
			hg, ag = aiVsAi(map[pair.h], map[pair.a])
		end
		table.insert(results, { h = pair.h, a = pair.a, hg = hg, ag = ag })
	end
	league.results[tostring(round)] = results
end

local function strengthOf(data, league, id)
	if id == USER then
		return MatchService.TeamStrength(data)
	end
	for _, t in ipairs(league.cupTeams) do
		if t.id == id then
			return t.strength
		end
	end
	return 50
end

local function cupTeam(league, id)
	for _, t in ipairs(league.cupTeams) do
		if t.id == id then
			return t
		end
	end
	return nil
end

local function playCupRound(player, data, roundIndex, out)
	local league = data.league
	local cup = league.cup
	local entrants = roundIndex == 1 and cup.participants or (cup.rounds[roundIndex - 1] and cup.rounds[roundIndex - 1].winners) or {}
	local division = LeagueConfig.Division(league.division)
	local matches, winners = {}, {}
	for i = 1, #entrants, 2 do
		local a, b = entrants[i], entrants[i + 1]
		if not b then
			table.insert(winners, a)
			break
		end
		local hg, ag, winner, penalties
		if a == USER or b == USER then
			local home = a == USER
			local opponent = cupTeam(league, home and b or a)
			local result, g1, g2, warning = playUserMatch(player, data, opponent, home, "Copa", division.prize)
			hg, ag = g1, g2
			if warning then
				table.insert(out.messages, warning)
			end
			if result then
				out.result = result
			end
		else
			local sa, sb = strengthOf(data, league, a), strengthOf(data, league, b)
			local pa = 1 / (1 + math.exp(-(sa - sb) / 6))
			hg = rng:NextNumber() < pa and rng:NextInteger(1, 3) or rng:NextInteger(0, 1)
			ag = hg > 0 and rng:NextInteger(0, hg) or rng:NextInteger(0, 1)
		end
		if hg > ag then
			winner = a
		elseif ag > hg then
			winner = b
		else
			-- Penaltis: favorece ligeramente al mejor equipo
			local sa, sb = strengthOf(data, league, a), strengthOf(data, league, b)
			winner = rng:NextNumber() < math.clamp(0.5 + (sa - sb) / 100, 0.2, 0.8) and a or b
			penalties = true
		end
		table.insert(matches, { h = a, a = b, hg = hg, ag = ag, winner = winner, penalties = penalties })
		table.insert(winners, winner)
		if a == USER or b == USER then
			local name = LeagueConfig.CUP_ROUND_NAMES[roundIndex]
			if winner == USER then
				out.points = (out.points or 0) + 2
				local prize = LeagueConfig.CUP_ROUND_PRIZE[roundIndex] * division.prize
				EconomyService.Earn(player, prize, EconomyService.Category.PRIZE, LeagueConfig.CUP_NAME .. ": " .. name)
				table.insert(out.messages, string.format("🏆 %s · %s: ¡pasas de ronda%s! Premio %d %s.", LeagueConfig.CUP_NAME, name,
					penalties and " en los penaltis" or "", prize, GameConfig.CURRENCY))
			else
				cup.alive = false
				cup.eliminatedIn = name
				table.insert(out.messages, string.format("❌ %s · %s: eliminado%s.", LeagueConfig.CUP_NAME, name, penalties and " en los penaltis" or ""))
			end
		end
	end
	cup.rounds[roundIndex] = { matches = matches, winners = winners }
	if roundIndex == #LeagueConfig.CUP_CYCLES then
		cup.champion = winners[1]
		if cup.champion == USER then
			out.points = (out.points or 0) + 10
			local rep = LeagueConfig.REP_CUP_BASE + LeagueConfig.REP_CUP_PER_LEVEL * league.division
			data.club.reputationEarned += rep
			table.insert(data.trophies, { kind = "cup", name = LeagueConfig.CUP_NAME, season = data.season.number })
			StadiumService.LogEvent(data, "trophy", { kind = "cup", name = LeagueConfig.CUP_NAME, season = data.season.number })
			table.insert(out.messages, string.format("🏆🏆 ¡CAMPEONES DE LA %s! Reputación +%d.", string.upper(LeagueConfig.CUP_NAME), rep))
		end
	end
end

-- ===== Cierre de temporada =====

local function finalize(player, data, out)
	local league = data.league
	local division = LeagueConfig.Division(league.division)
	local standings = LeagueService.Standings(data)
	local position = 1
	for _, r in ipairs(standings) do
		if r.id == USER then
			position = r.position
		end
	end
	local teams = LeagueConfig.TEAMS
	local promoted = division.promote > 0 and position <= division.promote
	local relegated = division.relegate > 0 and position > teams - division.relegate
	local champion = position == 1

	-- Premios
	local positionPrize = math.floor(LeagueConfig.POSITION_PRIZE * division.prize * (teams + 1 - position) / teams)
	EconomyService.Earn(player, positionPrize, EconomyService.Category.PRIZE, string.format("%s: %dº puesto", division.name, position))
	if champion then
		out.points = (out.points or 0) + 10
		EconomyService.Earn(player, LeagueConfig.TITLE_BONUS * division.prize, EconomyService.Category.PRIZE, "Título de " .. division.name)
		local rep = LeagueConfig.REP_TITLE_BASE + LeagueConfig.REP_TITLE_PER_LEVEL * league.division
		data.club.reputationEarned += rep
		table.insert(data.trophies, { kind = "league", name = division.name, season = league.season })
		StadiumService.LogEvent(data, "trophy", { kind = "league", name = division.name, season = league.season })
		table.insert(out.messages, string.format("🏆 ¡CAMPEONES DE %s! Reputación +%d.", string.upper(division.name), rep))
	end
	if promoted then
		EconomyService.Earn(player, LeagueConfig.PROMOTION_BONUS * division.prize, EconomyService.Category.PRIZE, "Ascenso")
		data.club.reputationEarned += LeagueConfig.REP_PROMOTION
		StadiumService.LogEvent(data, "promotion", { from = division.name, to = LeagueConfig.Division(league.division + 1).name, season = league.season })
		table.insert(out.messages, string.format("⬆️ ¡ASCENSO a %s!", LeagueConfig.Division(league.division + 1).name))
	elseif relegated then
		data.club.reputationEarned = math.max(0, data.club.reputationEarned + LeagueConfig.REP_RELEGATION)
		StadiumService.LogEvent(data, "relegation", { from = division.name, to = LeagueConfig.Division(league.division - 1).name, season = league.season })
		table.insert(out.messages, string.format("⬇️ Descenso a %s.", LeagueConfig.Division(league.division - 1).name))
	end

	-- Objetivo de la junta
	local objective = league.objective
	local met = objective and position <= objective.target
	if met then
		EconomyService.Earn(player, LeagueConfig.OBJECTIVE_BONUS * division.prize, EconomyService.Category.PRIZE, "Objetivo de la junta cumplido")
		league.boardConfidence = math.clamp(league.boardConfidence + LeagueConfig.BOARD_MET, 0, 100)
		table.insert(out.messages, "✅ Objetivo de la junta cumplido: " .. objective.text)
	elseif objective then
		league.boardConfidence = math.clamp(league.boardConfidence + LeagueConfig.BOARD_FAILED, 0, 100)
		table.insert(out.messages, "❌ Objetivo de la junta no cumplido: " .. objective.text)
	end

	-- Historial de temporadas (base de la HISTORIA DEL CLUB)
	local userRow
	for _, r in ipairs(standings) do
		if r.id == USER then
			userRow = r
		end
	end
	local cup = league.cup
	-- Máximo goleador y mejor asistente de la temporada (eventos reales de los partidos)
	local topScorer, topAssist
	for _, p in ipairs(data.squad) do
		local s = p.seasonStats
		if s and s.goals > 0 and (not topScorer or s.goals > topScorer.goals) then
			topScorer = { name = p.name, goals = s.goals }
		end
		if s and s.assists > 0 and (not topAssist or s.assists > topAssist.assists) then
			topAssist = { name = p.name, assists = s.assists }
		end
	end
	if topScorer and (data.records.mostGoalsSeason == nil or topScorer.goals > data.records.mostGoalsSeason.goals) then
		data.records.mostGoalsSeason = { name = topScorer.name, goals = topScorer.goals, season = league.season }
	end
	if userRow and (data.records.bestSeasonPoints == nil or userRow.pts > data.records.bestSeasonPoints.points) then
		data.records.bestSeasonPoints = { points = userRow.pts, season = league.season, division = division.name }
	end
	table.insert(league.history, {
		topScorer = topScorer,
		topAssist = topAssist,
		season = league.season,
		division = league.division,
		divisionName = division.name,
		position = position,
		points = userRow and userRow.pts or 0,
		w = userRow and userRow.w or 0, d = userRow and userRow.d or 0, l = userRow and userRow.l or 0,
		gf = userRow and userRow.gf or 0, ga = userRow and userRow.ga or 0,
		champion = champion,
		promoted = promoted,
		relegated = relegated,
		cup = cup.champion == USER and "Campeón" or (cup.eliminatedIn or "—"),
		objectiveMet = met == true,
	})
	while #league.history > 30 do
		table.remove(league.history, 1)
	end
	table.insert(out.messages, string.format("📊 %s, temporada %d: terminas %dº con %d puntos.", division.name, league.season, position, userRow and userRow.pts or 0))

	-- Siguiente temporada
	local newLevel = league.division + (promoted and 1 or 0) - (relegated and 1 or 0)
	local keep = {}
	if newLevel == league.division then
		for _, r in ipairs(standings) do
			local isPromoted = division.promote > 0 and r.position <= division.promote
			local isRelegated = division.relegate > 0 and r.position > teams - division.relegate
			if r.id ~= USER and not isPromoted and not isRelegated then
				for _, t in ipairs(league.teams) do
					if t.id == r.id then
						table.insert(keep, t)
					end
				end
			end
		end
	end
	LeagueService.NewLeague(data, league.season + 1, newLevel, keep)
end

-- ===== Jornada =====

function LeagueService.Ensure(data)
	if type(data.league) ~= "table" or not data.league.season then
		-- Liga nueva: empieza ya si estamos al principio de la temporada; si no, la próxima
		local startSeason = (data.season.cycle <= 0) and data.season.number or data.season.number + 1
		local level = type(data.league) == "table" and data.league.division or 1
		LeagueService.NewLeague(data, startSeason, level, nil)
	elseif data.league.season < data.season.number then
		LeagueService.NewLeague(data, data.season.number, data.league.division, data.league.teams)
	end
end

-- Se llama en cada jornada ANTES de que SquadService avance el reloj de la temporada.
function LeagueService.AfterCycle(player, clubName, clubShort)
	local data = DataService.Get(player)
	local out = { messages = {}, result = nil }
	if not data then
		return out
	end
	data.__clubName, data.__clubShort = clubName, clubShort
	LeagueService.Ensure(data)
	local league = data.league
	local cycle = data.season.cycle
	if league.season == data.season.number then
		-- Liga (con recuperación de jornadas pendientes)
		local round = cycle - LeagueConfig.LEAGUE_FIRST_CYCLE + 1
		for r = 1, math.min(round, LeagueConfig.LEAGUE_ROUNDS) do
			if not league.results[tostring(r)] then
				playLeagueRound(player, data, r, out)
			end
		end
		-- Copa
		for index, cupCycle in ipairs(LeagueConfig.CUP_CYCLES) do
			if cycle >= cupCycle and not league.cup.rounds[index] then
				playCupRound(player, data, index, out)
			end
		end
		if cycle >= LeagueConfig.FINALIZE_CYCLE then
			finalize(player, data, out)
		end
	end
	data.__clubName, data.__clubShort = nil, nil
	return out
end

-- ===== Estado para el cliente =====

function LeagueService.BuildState(data, clubName, clubShort)
	LeagueService.Ensure(data)
	data.__clubName, data.__clubShort = clubName, clubShort
	local league = data.league
	local division = LeagueConfig.Division(league.division)
	local map = teamMap(league)
	local function label(id)
		if id == USER then
			return clubShort, clubName
		end
		local t = map[id] or cupTeam(league, id)
		return t and t.short or "?", t and t.name or "?"
	end
	local fixtures = {}
	for round, pairs_ in ipairs(league.fixtures) do
		for _, pair in ipairs(pairs_) do
			if pair.h == USER or pair.a == USER then
				local result
				for _, m in ipairs(league.results[tostring(round)] or {}) do
					if m.h == pair.h and m.a == pair.a then
						result = m
					end
				end
				local hs, hn = label(pair.h)
				local as, an = label(pair.a)
				table.insert(fixtures, {
					round = round, cycle = LeagueConfig.LEAGUE_FIRST_CYCLE + round - 1, home = pair.h == USER,
					homeShort = hs, homeName = hn, awayShort = as, awayName = an,
					hg = result and result.hg or nil, ag = result and result.ag or nil,
				})
			end
		end
	end
	local cupRounds = {}
	for index, round in ipairs(league.cup.rounds) do
		local matches = {}
		for _, m in ipairs(round.matches) do
			local hs = label(m.h)
			local as = label(m.a)
			table.insert(matches, { home = hs, away = as, hg = m.hg, ag = m.ag, penalties = m.penalties, user = m.h == USER or m.a == USER,
				userWon = m.winner == USER })
		end
		cupRounds[index] = { name = LeagueConfig.CUP_ROUND_NAMES[index], matches = matches }
	end
	local strengths = {}
	for _, t in ipairs(league.teams) do
		strengths[t.id] = t.strength
	end
	local standings = LeagueService.Standings(data)
	for _, r in ipairs(standings) do
		r.strength = r.id == USER and math.floor(MatchService.TeamStrength(data) + 0.5) or strengths[r.id]
		r.isUser = r.id == USER
	end
	data.__clubName, data.__clubShort = nil, nil
	return {
		season = league.season,
		started = league.season == data.season.number,
		division = league.division,
		divisionName = division.name,
		divisions = #LeagueConfig.Divisions,
		promote = division.promote,
		relegate = division.relegate,
		standings = standings,
		fixtures = fixtures,
		cup = { name = LeagueConfig.CUP_NAME, rounds = cupRounds, alive = league.cup.alive, champion = league.cup.champion == USER,
			eliminatedIn = league.cup.eliminatedIn, cycles = LeagueConfig.CUP_CYCLES, roundNames = LeagueConfig.CUP_ROUND_NAMES },
		objective = league.objective,
		boardConfidence = league.boardConfidence,
		history = league.history,
		trophies = data.trophies,
		cycle = data.season.cycle,
	}
end

function LeagueService.PlayerReady(player)
	local data = DataService.Get(player)
	if data then
		LeagueService.Ensure(data)
	end
end

return LeagueService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000003A"><Properties><string name="Name">MatchService</string><ProtectedString name="Source"><![CDATA[-- MatchService (ModuleScript)
-- Ubicación: ServerScriptService/Server/Services/MatchService
--
-- FASE 5: alineaciones, formaciones, tácticas y PARTIDOS SIMULADOS.
--   * Solo el servidor simula (MatchEngine + Random del servidor).
--   * Efectos reales: premios, reputación, satisfacción, estadísticas de jugadores,
--     forma física, lesiones, historial y récords.
--   * Los rivales de los amistosos son clubes ficticios generados en el servidor.
--     Las ligas (FASE 7) y los partidos entre usuarios (FASE 9) reutilizan
--     BuildUserSheet / BuildAISheet / Play.
-- Los partidos se presentan siempre como SIMULACIONES, no como partidos controlables.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local FootballConfig = require(Shared.Config.FootballConfig)
local TacticsConfig = require(Shared.Config.TacticsConfig)
local FootballFormulas = require(Shared.Modules.FootballFormulas)
local MatchEngine = require(Shared.Modules.MatchEngine)
local UniverseConfig = require(Shared.Config.UniverseConfig)

local DataService = require(script.Parent.DataService)
local EconomyService = require(script.Parent.EconomyService)
local StadiumService = require(script.Parent.StadiumService)

local MatchService = {}

local rng = Random.new()

-- ===== Alineación =====

local function available(p)
	return (p.injury or 0) <= 0 and not (p.loan and p.loan.type == "out")
end

local function slotScore(p, slotPos)
	local factor = MatchEngine.PlayerFactor({ pos = p.pos, slotPos = slotPos, fitness = p.fitness })
	return FootballFormulas.Overall(p) * factor
end

-- Mejor once posible para la formación actual (respeta lesiones y forma física).
function MatchService.AutoLineup(data)
	local formation = TacticsConfig.Formation(data.tactics.formation)
	local used, lineup = {}, {}
	for index, slotPos in ipairs(formation.slots) do
		local best, bestScore = nil, -1
		for _, p in ipairs(data.squad) do
			if not used[p.id] and available(p) then
				local score = slotScore(p, slotPos)
				if score > bestScore then
					best, bestScore = p, score
				end
			end
		end
		if best then
			used[best.id] = true
			lineup[index] = best.id
		else
			lineup[index] = ""
		end
	end
	data.tactics.lineup = lineup
	return lineup
end

-- Repara la alineación guardada: quita lesionados, duplicados o jugadores que ya no están.
function MatchService.ValidateLineup(data)
	local formation = TacticsConfig.Formation(data.tactics.formation)
	local byId = {}
	for _, p in ipairs(data.squad) do
		byId[p.id] = p
	end
	local lineup, used, missing = {}, {}, false
	for index = 1, #formation.slots do
		local id = data.tactics.lineup[index]
		local p = byId[id]
		if p and available(p) and not used[id] then
			lineup[index] = id
			used[id] = true
		else
			lineup[index] = ""
			missing = true
		end
	end
	if missing then
		-- Rellena los huecos con el mejor disponible para cada puesto
		for index, slotPos in ipairs(formation.slots) do
			if lineup[index] == "" then
				local best, bestScore = nil, -1
				for _, p in ipairs(data.squad) do
					if not used[p.id] and available(p) then
						local score = slotScore(p, slotPos)
						if score > bestScore then
							best, bestScore = p, score
						end
					end
				end
				if best then
					lineup[index] = best.id
					used[best.id] = true
				end
			end
		end
	end
	data.tactics.lineup = lineup
	return lineup
end

function MatchService.TeamStrength(data)
	local values = {}
	for _, p in ipairs(data.squad) do
		table.insert(values, FootballFormulas.Overall(p))
	end
	table.sort(values, function(a, b)
		return a > b
	end)
	local total, n = 0, math.min(11, #values)
	for i = 1, n do
		total += values[i]
	end
	return n > 0 and total / n or 40
end

function MatchService.BuildUserSheet(data, name, short)
	local formation = TacticsConfig.Formation(data.tactics.formation)
	local lineup = MatchService.ValidateLineup(data)
	local byId = {}
	for _, p in ipairs(data.squad) do
		byId[p.id] = p
	end
	local players = {}
	for index, slotPos in ipairs(formation.slots) do
		local p = byId[lineup[index]]
		if p then
			table.insert(players, {
				id = p.id, name = p.nickname or p.name, pos = p.pos, slotPos = slotPos, attrs = p.attrs, fitness = p.fitness or 100,
			})
		end
	end
	return {
		name = name, short = short,
		formation = formation.id, mentality = data.tactics.mentality, style = data.tactics.style,
		players = players,
	}
end

-- Rival generado de forma determinista a partir de su descripción (mismo rival = misma plantilla).
function MatchService.BuildAISheet(opponent)
	local seeded = Random.new(opponent.seed or 1)
	local formation = TacticsConfig.Formation(opponent.formation)
	local players = {}
	for index, slotPos in ipairs(formation.slots) do
		local attrs = {}
		local bias = FootballConfig.Bias[slotPos]
		for _, attr in ipairs(FootballConfig.Attributes) do
			attrs[attr.id] = math.clamp(opponent.strength + bias[attr.id] + seeded:NextInteger(-6, 6), 5, 97)
		end
		local probe = { pos = slotPos, attrs = attrs }
		local diff = opponent.strength - FootballFormulas.Overall(probe)
		for id, v in pairs(attrs) do
			attrs[id] = math.clamp(v + diff, 5, 97)
		end
		local first = FootballConfig.FirstNames[seeded:NextInteger(1, #FootballConfig.FirstNames)]
		local last = FootballConfig.LastNames[seeded:NextInteger(1, #FootballConfig.LastNames)]
		table.insert(players, {
			id = "ai" .. index, name = first .. " " .. last, pos = slotPos, slotPos = slotPos, attrs = attrs, fitness = 100,
		})
	end
	return {
		name = opponent.name, short = opponent.short,
		formation = formation.id, mentality = opponent.mentality, style = opponent.style,
		players = players,
	}
end

function MatchService.RandomClubName(random)
	random = random or rng
	local prefix = TacticsConfig.ClubPrefixes[random:NextInteger(1, #TacticsConfig.ClubPrefixes)]
	local town = TacticsConfig.ClubTowns[random:NextInteger(1, #TacticsConfig.ClubTowns)]
	local name = prefix .. " " .. town
	local short = string.upper(string.sub(town:gsub("[^%a]", ""), 1, 3))
	return name, short
end

-- ===== Amistosos =====

local function generateFriendlies(data)
	local strength = MatchService.TeamStrength(data)
	local offers = {}
	for i, difficulty in ipairs(TacticsConfig.FRIENDLY_DIFFICULTY) do
		local name, short = MatchService.RandomClubName()
		local formations = TacticsConfig.Formations
		table.insert(offers, {
			id = string.format("f%d-%d", data.stats.cycles, i),
			name = name,
			short = short,
			difficulty = difficulty.id,
			strength = math.clamp(math.floor(strength + difficulty.delta + rng:NextInteger(-2, 2) + 0.5), 35, 92),
			formation = formations[rng:NextInteger(1, #formations)].id,
			mentality = TacticsConfig.Mentalities[rng:NextInteger(1, #TacticsConfig.Mentalities)].id,
			style = TacticsConfig.Styles[rng:NextInteger(1, #TacticsConfig.Styles)].id,
			seed = rng:NextInteger(1, 2 ^ 30),
		})
	end
	data.friendlies.offers = offers
end

function MatchService.RefreshFriendlies(data, force)
	if force or #data.friendlies.offers == 0 then
		generateFriendlies(data)
	end
end

-- ===== Aplicar resultado =====

local function countAvailable(data)
	local n = 0
	for _, p in ipairs(data.squad) do
		if available(p) then
			n += 1
		end
	end
	return n
end

-- Aplica a los jugadores del usuario las consecuencias de un partido.
local function applyPlayerEffects(data, sheet, result, messages)
	local byId = {}
	for _, p in ipairs(data.squad) do
		byId[p.id] = p
	end
	local intense = data.training.intensity == "INTENSE"
	for _, entry in ipairs(sheet.players) do
		local p = byId[entry.id]
		if p then
			p.stats.apps += 1
			p.seasonStats = p.seasonStats or { apps = 0, goals = 0, assists = 0 }
			p.seasonStats.apps += 1
			local ps = result.playerStats[p.id]
			local goals, assists = ps and ps.goals or 0, ps and ps.assists or 0
			p.stats.goals += goals
			p.stats.assists += assists
			p.seasonStats.goals += goals
			p.seasonStats.assists += assists
			-- Estadísticas de todos los tiempos del club (sobreviven a ventas y retiradas)
			local all = data.allTimeStats[p.id]
			if not all then
				all = { name = p.name, pos = p.pos, origin = p.origin, apps = 0, goals = 0, assists = 0 }
				data.allTimeStats[p.id] = all
			end
			all.apps += 1
			all.goals += goals
			all.assists += assists
			local stamina = p.attrs.stamina or 50
			local cost = TacticsConfig.FITNESS_COST_MAX - (TacticsConfig.FITNESS_COST_MAX - TacticsConfig.FITNESS_COST_MIN) * stamina / 99
			p.fitness = math.clamp((p.fitness or 100) - cost, 0, 100)
			local injuryChance = TacticsConfig.INJURY_CHANCE + (intense and TacticsConfig.INJURY_CHANCE_INTENSE or 0)
			if rng:NextNumber() < injuryChance then
				p.injury = rng:NextInteger(TacticsConfig.INJURY_MIN, TacticsConfig.INJURY_MAX)
				table.insert(messages, string.format("🚑 %s se lesiona: %d jornadas de baja.", p.name, p.injury))
			end
		end
	end
end

local function updateRecords(data, entry)
	local records = data.records
	local diff = entry.gf - entry.ga
	local function better(current, value)
		return current == nil or value > current
	end
	if diff > 0 and better(records.biggestWin and (records.biggestWin.gf - records.biggestWin.ga), diff) then
		records.biggestWin = { gf = entry.gf, ga = entry.ga, opponent = entry.opponent, season = entry.season }
	end
	if diff < 0 and better(records.worstDefeat and (records.worstDefeat.ga - records.worstDefeat.gf), -diff) then
		records.worstDefeat = { gf = entry.gf, ga = entry.ga, opponent = entry.opponent, season = entry.season }
	end
	if diff >= 0 then
		records.unbeatenCurrent = (records.unbeatenCurrent or 0) + 1
	else
		records.unbeatenCurrent = 0
	end
	if (records.unbeatenCurrent or 0) > (records.unbeatenBest or 0) then
		records.unbeatenBest = records.unbeatenCurrent
	end
end

local matchCallbacks = {}

-- Avisa a otros servicios de cada partido de un usuario (eventos comunitarios, etc.).
function MatchService.OnUserMatch(callback)
	table.insert(matchCallbacks, callback)
end

local function fireMatch(player, result, us, them)
	for _, callback in ipairs(matchCallbacks) do
		task.spawn(callback, player, result, us, them)
	end
end

MatchService.ApplyPlayerEffects = applyPlayerEffects

function MatchService.SimulateSheets(homeSheet, awaySheet, crowd)
	return MatchEngine.Simulate(homeSheet, awaySheet, rng, { crowd = crowd or 0.5 })
end

-- Registra un partido en el historial, los totales y los récords del club.
-- entry = { competition, opponent, short, home, gf, ga, scorers, mvp, prize }
function MatchService.RecordMatch(data, entry)
	entry.t = os.time()
	entry.season = data.season.number
	entry.outcome = entry.gf > entry.ga and "W" or (entry.gf == entry.ga and "D" or "L")
	table.insert(data.matches, entry)
	while #data.matches > TacticsConfig.MAX_MATCH_HISTORY do
		table.remove(data.matches, 1)
	end
	local s = data.stats
	s.matchesPlayed = (s.matchesPlayed or 0) + 1
	s.wins = (s.wins or 0) + (entry.outcome == "W" and 1 or 0)
	s.draws = (s.draws or 0) + (entry.outcome == "D" and 1 or 0)
	s.losses = (s.losses or 0) + (entry.outcome == "L" and 1 or 0)
	s.goalsFor = (s.goalsFor or 0) + entry.gf
	s.goalsAgainst = (s.goalsAgainst or 0) + entry.ga
	updateRecords(data, entry)
	if math.abs(entry.gf - entry.ga) >= 4 then
		StadiumService.LogEvent(data, "big_result", { opponent = entry.opponent, gf = entry.gf, ga = entry.ga, competition = entry.competition })
	end
	return entry.outcome
end

function MatchService.Scorers(result, side)
	local scorers = {}
	for _, event in ipairs(result.events) do
		if event.type == "goal" and event.side == side then
			table.insert(scorers, string.format("%s %d'", event.player, event.minute))
		end
	end
	return scorers
end

-- Juega un partido del usuario y aplica todo.
-- opponent: rival ficticio { name, short, strength, ... } o, con opts.opponentSheet, un club real (hoja pública).
-- opts: competition ("Amistoso", "Liga", "Copa", "Reto", "Torneo"...), home, prizeScale,
--       noEconomy = true -> sin premio, reputación ni satisfacción (partidos entre usuarios y torneos)
function MatchService.Play(player, opponent, opts)
	local data = DataService.Get(player)
	local userSheet = MatchService.BuildUserSheet(data, opts.clubName, opts.clubShort)
	local opponentSheet = opts.opponentSheet or MatchService.BuildAISheet(opponent)
	local home = opts.home ~= false
	local crowd = (data.economy.lastCycle and data.economy.lastCycle.occupancy) or 0
	local result
	if home then
		result = MatchEngine.Simulate(userSheet, opponentSheet, rng, { crowd = crowd })
	else
		result = MatchEngine.Simulate(opponentSheet, userSheet, rng, { crowd = 0.7 })
	end
	local us = home and result.home or result.away
	local them = home and result.away or result.home
	local messages = {}
	applyPlayerEffects(data, userSheet, result, messages)

	-- Premios, reputación y satisfacción
	local outcome = us.goals > them.goals and "W" or (us.goals == them.goals and "D" or "L")
	local prize, repGain, satisfaction = 0, 0, 0
	if not opts.noEconomy then
		prize = TacticsConfig.FRIENDLY_PRIZE_BASE * (opponent.strength / 50) ^ 2 * (opts.prizeScale or 1)
			* UniverseConfig.Multiplier("matchPrize") -- evento del universo
		if outcome == "D" then
			prize *= TacticsConfig.PRIZE_DRAW
		elseif outcome == "L" then
			prize *= TacticsConfig.PRIZE_LOSS
		end
		prize = math.floor(prize)
		EconomyService.Earn(player, prize, EconomyService.Category.PRIZE, string.format("%s vs %s (%d-%d)", opts.competition, opponent.name, us.goals, them.goals))
		if outcome == "W" and opponent.strength >= MatchService.TeamStrength(data) - 3 then
			repGain = TacticsConfig.REPUTATION_WIN * (opts.reputationScale or 1)
			data.club.reputationEarned += repGain
		end
		satisfaction = outcome == "W" and TacticsConfig.SATISFACTION_WIN or (outcome == "L" and TacticsConfig.SATISFACTION_LOSS or 0)
		data.club.satisfaction = math.clamp(data.club.satisfaction + satisfaction, 0, 100)
	end

	MatchService.RecordMatch(data, {
		competition = opts.competition,
		opponent = opponent.name,
		short = opponent.short,
		home = home,
		gf = us.goals,
		ga = them.goals,
		scorers = MatchService.Scorers(result, home and 1 or 2),
		mvp = result.mvp and result.mvp.name or nil,
		prize = prize,
	})

	result.userSide = home and 1 or 2
	result.prize = prize
	result.reputation = repGain
	result.satisfaction = satisfaction
	result.outcome = outcome
	result.competition = opts.competition
	result.messages = messages
	fireMatch(player, result, us.goals, them.goals)
	result.playerStats = nil -- no hace falta en el cliente (ya se resume en los eventos)
	result.ratings = nil
	return result, messages
end

-- Partido entre dos usuarios conectados (FASE 9). Aplica efectos y registros a ambos.
-- Devuelve el resultado (sin datos internos) o nil y un motivo.
function MatchService.PlayUsers(homePlayer, awayPlayer, competition, homeInfo, awayInfo)
	local homeData, awayData = DataService.Get(homePlayer), DataService.Get(awayPlayer)
	if not homeData or not awayData then
		return nil, "Uno de los clubes no está disponible."
	end
	local homeSheet = MatchService.BuildUserSheet(homeData, homeInfo.name, homeInfo.short)
	local awaySheet = MatchService.BuildUserSheet(awayData, awayInfo.name, awayInfo.short)
	if #homeSheet.players < 11 or #awaySheet.players < 11 then
		return nil, "Uno de los clubes no tiene 11 jugadores disponibles."
	end
	local crowd = (homeData.economy.lastCycle and homeData.economy.lastCycle.occupancy) or 0
	local result = MatchEngine.Simulate(homeSheet, awaySheet, rng, { crowd = crowd })
	local sides = { { player = homePlayer, data = homeData, sheet = homeSheet, side = 1, other = awayInfo },
		{ player = awayPlayer, data = awayData, sheet = awaySheet, side = 2, other = homeInfo } }
	for _, entry in ipairs(sides) do
		applyPlayerEffects(entry.data, entry.sheet, result, {})
		local us = entry.side == 1 and result.home or result.away
		local them = entry.side == 1 and result.away or result.home
		MatchService.RecordMatch(entry.data, {
			competition = competition, opponent = entry.other.name, short = entry.other.short, home = entry.side == 1,
			gf = us.goals, ga = them.goals, scorers = MatchService.Scorers(result, entry.side),
			mvp = result.mvp and result.mvp.name or nil, prize = 0,
		})
		fireMatch(entry.player, result, us.goals, them.goals)
	end
	result.playerStats = nil
	result.ratings = nil
	result.competition = competition
	result.prize, result.reputation, result.satisfaction = 0, 0, 0
	return result
end

function MatchService.PlayFriendly(player, payload, clubName, clubShort)
	local data = DataService.Get(player)
	local offerId = type(payload) == "table" and payload.offer
	local opponent
	for _, offer in ipairs(data.friendlies.offers) do
		if offer.id == offerId then
			opponent = offer
		end
	end
	if not opponent then
		return false, "Ese amistoso ya no está disponible."
	end
	if data.friendlies.lastCycle == data.stats.cycles then
		return false, "Ya has jugado un amistoso en esta jornada. Espera a la próxima."
	end
	if countAvailable(data) < 11 then
		return false, "No tienes 11 jugadores disponibles (lesiones)."
	end
	local result = MatchService.Play(player, opponent, {
		clubName = clubName, clubShort = clubShort, home = true, competition = "Amistoso",
	})
	data.friendlies.lastCycle = data.stats.cycles
	data.friendlies.offers = {}
	return true, string.format("Amistoso simulado: %s %d - %d %s.", clubShort, result.home.goals, result.away.goals, opponent.short), result
end

-- ===== Acciones tácticas =====

function MatchService.SetFormation(player, payload)
	local data = DataService.Get(player)
	local id = type(payload) == "table" and payload.formation
	for _, f in ipairs(TacticsConfig.Formations) do
		if f.id == id then
			data.tactics.formation = f.id
			MatchService.ValidateLineup(data)
			return true, "Formación " .. f.name
		end
	end
	return false, "Formación no válida."
end

function MatchService.SetTactic(player, payload)
	local data = DataService.Get(player)
	if type(payload) ~= "table" then
		return false, "Solicitud no válida."
	end
	if payload.kind == "mentality" then
		for _, m in ipairs(TacticsConfig.Mentalities) do
			if m.id == payload.value then
				data.tactics.mentality = m.id
				return true, "Mentalidad " .. m.name
			end
		end
	elseif payload.kind == "style" then
		for _, st in ipairs(TacticsConfig.Styles) do
			if st.id == payload.value then
				data.tactics.style = st.id
				return true, "Estilo: " .. st.name
			end
		end
	end
	return false, "Táctica no válida."
end

function MatchService.SetLineupSlot(player, payload)
	local data = DataService.Get(player)
	if type(payload) ~= "table" then
		return false, "Solicitud no válida."
	end
	local formation = TacticsConfig.Formation(data.tactics.formation)
	local slot = tonumber(payload.slot)
	if not slot or slot ~= math.floor(slot) or slot < 1 or slot > #formation.slots then
		return false, "Puesto no válido."
	end
	local target
	for _, p in ipairs(data.squad) do
		if p.id == payload.id then
			target = p
		end
	end
	if not target then
		return false, "Ese jugador no es de tu plantilla."
	end
	if not available(target) then
		return false, target.name .. " está lesionado."
	end
	MatchService.ValidateLineup(data)
	local lineup = data.tactics.lineup
	-- Si ya estaba en el once, intercambia los puestos
	for index, id in ipairs(lineup) do
		if id == target.id then
			lineup[index] = lineup[slot]
		end
	end
	lineup[slot] = target.id
	return true, string.format("%s al puesto %d (%s).", target.name, slot, FootballConfig.Position(formation.slots[slot]).short)
end

function MatchService.AutoLineupAction(player)
	local data = DataService.Get(player)
	MatchService.AutoLineup(data)
	return true, "Alineación automática: mejor once disponible."
end

-- ===== Jornada =====

function MatchService.AfterCycle(player)
	local data = DataService.Get(player)
	if not data then
		return {}
	end
	local messages = {}
	for _, p in ipairs(data.squad) do
		p.fitness = math.clamp((p.fitness or 100) + TacticsConfig.FITNESS_RECOVERY, 0, 100)
		if (p.injury or 0) > 0 then
			p.injury -= 1
			if p.injury <= 0 then
				p.injury = 0
				table.insert(messages, "✅ " .. p.name .. " se ha recuperado de su lesión.")
			end
		end
	end
	MatchService.RefreshFriendlies(data, false)
	MatchService.ValidateLineup(data)
	return messages
end

function MatchService.PlayerReady(player)
	local data = DataService.Get(player)
	if data then
		if #data.tactics.lineup == 0 then
			MatchService.AutoLineup(data)
		end
		MatchService.RefreshFriendlies(data, false)
	end
end

function MatchService.BuildState(data)
	local formation = TacticsConfig.Formation(data.tactics.formation)
	local lineupInfo = {}
	local byId = {}
	for _, p in ipairs(data.squad) do
		byId[p.id] = p
	end
	for index, slotPos in ipairs(formation.slots) do
		local p = byId[data.tactics.lineup[index]]
		lineupInfo[index] = { slotPos = slotPos, id = p and p.id or "" }
	end
	return {
		tactics = {
			formation = formation.id,
			mentality = data.tactics.mentality,
			style = data.tactics.style,
			lineup = lineupInfo,
		},
		friendlies = data.friendlies.offers,
		friendlyPlayed = data.friendlies.lastCycle == data.stats.cycles,
		matches = data.matches,
		records = data.records,
		strength = math.floor(MatchService.TeamStrength(data) * 10 + 0.5) / 10,
		totals = {
			played = data.stats.matchesPlayed or 0, wins = data.stats.wins or 0, draws = data.stats.draws or 0,
			losses = data.stats.losses or 0, goalsFor = data.stats.goalsFor or 0, goalsAgainst = data.stats.goalsAgainst or 0,
		},
	}
end

return MatchService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000003B"><Properties><string name="Name">MissionService</string><ProtectedString name="Source"><![CDATA[-- MissionService (ModuleScript)
-- Ubicación: ServerScriptService/Server/Services/MissionService
--
-- MISIONES Y LOGROS (FASE 10).
--   * Track(jugador, métrica, cantidad): lo llama el servidor ante acontecimientos reales
--     (partidos, construcciones, fichajes, jornadas, caramelos…). El cliente no puede sumar progreso.
--   * Misiones diarias (3 al día, recompensa al reclamarlas) y cadenas de progreso permanentes.
--   * Logros comprobados con los datos reales del club; se conceden una sola vez.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local GameConfig = require(Shared.Config.GameConfig)
local MissionConfig = require(Shared.Config.MissionConfig)
local HalloweenConfig = require(Shared.Config.HalloweenConfig)
local EconomyFormulas = require(Shared.Modules.EconomyFormulas)
local Remotes = require(Shared.Modules.Remotes)

local DataService = require(script.Parent.DataService)
local EconomyService = require(script.Parent.EconomyService)
local StadiumService = require(script.Parent.StadiumService)

local MissionService = {}

local notifyRemote = Remotes.Get("Notify")
local rng = Random.new()

local function today()
	return math.floor(os.time() / 86400)
end

local function divisionScale(data)
	local division = data.league and data.league.division or 1
	return 1 + (division - 1) * 0.25 -- de ×1 (Regional) a ×2 (Primera)
end

-- Genera las misiones del día si ha cambiado el día.
function MissionService.EnsureDaily(data)
	local m = data.missions
	if m.day == today() and #m.daily > 0 then
		return
	end
	m.day = today()
	m.daily = {}
	local pool = {}
	for _, def in ipairs(MissionConfig.DailyPool) do
		if def.event ~= "halloween" or HalloweenConfig.IsActive() then
			table.insert(pool, def)
		end
	end
	for _ = 1, math.min(MissionConfig.DAILY_COUNT, #pool) do
		local def = table.remove(pool, rng:NextInteger(1, #pool))
		table.insert(m.daily, {
			id = def.id,
			target = math.max(1, math.floor(def.target * divisionScale(data) + 0.5)),
			progress = 0,
			claimed = false,
		})
	end
end

function MissionService.Track(player, metric, amount)
	local data = DataService.Get(player)
	amount = math.floor(tonumber(amount) or 0)
	if not data or amount <= 0 or not MissionConfig.Metrics[metric] then
		return
	end
	MissionService.EnsureDaily(data)
	local m = data.missions
	m.counters[metric] = (m.counters[metric] or 0) + amount
	for _, mission in ipairs(m.daily) do
		local def = MissionConfig.Daily(mission.id)
		if def and def.metric == metric and mission.progress < mission.target then
			mission.progress = math.min(mission.target, mission.progress + amount)
			if mission.progress >= mission.target then
				notifyRemote:FireClient(player, "success", "🎯 Misión diaria completada: " .. string.format(def.text, mission.target) .. ". ¡Reclama la recompensa en Misiones!")
			end
		end
	end
end

local function reward(player, data, money, reputation, label)
	if money and money > 0 then
		EconomyService.Earn(player, money, EconomyService.Category.PRIZE, label)
	end
	if reputation and reputation > 0 then
		data.club.reputationEarned += reputation
	end
end

function MissionService.ClaimDaily(player, payload)
	local data = DataService.Get(player)
	MissionService.EnsureDaily(data)
	local id = type(payload) == "table" and payload.id
	for _, mission in ipairs(data.missions.daily) do
		if mission.id == id then
			if mission.claimed then
				return false, "Ya has reclamado esta misión."
			end
			if mission.progress < mission.target then
				return false, "Todavía no has completado esta misión."
			end
			local def = MissionConfig.Daily(id)
			mission.claimed = true
			reward(player, data, def.money, def.reputation, "Misión diaria")
			return true, string.format("🎯 Recompensa: +%d %s%s", def.money, GameConfig.CURRENCY,
				def.reputation > 0 and string.format(" y +%d de reputación", def.reputation) or "")
		end
	end
	return false, "Esa misión no está disponible hoy."
end

function MissionService.ClaimChain(player, payload)
	local data = DataService.Get(player)
	local chain = MissionConfig.Chain(type(payload) == "table" and payload.id)
	if not chain then
		return false, "Misión no válida."
	end
	local level = (data.missions.chainLevels[chain.id] or 0) + 1
	local target = chain.targets[level]
	if not target then
		return false, "Ya has completado toda la cadena."
	end
	if (data.missions.counters[chain.metric] or 0) < target then
		return false, "Todavía no has llegado al objetivo."
	end
	data.missions.chainLevels[chain.id] = level
	reward(player, data, chain.money[level], 0, chain.name .. " " .. level)
	return true, string.format("🏁 %s nivel %d completado: +%d %s", chain.name, level, chain.money[level], GameConfig.CURRENCY)
end

-- ===== Logros =====

function MissionService.Stat(data, stat)
	if stat == "wins" then
		return data.stats.wins or 0
	elseif stat == "goals" then
		return data.stats.goalsFor or 0
	elseif stat == "titles" then
		return #data.trophies
	elseif stat == "stage" then
		return data.stadium.stage
	elseif stat == "fans" then
		return data.club.fans
	elseif stat == "graduates" then
		return data.stats.academyGraduates or 0
	elseif stat == "legends" then
		return #data.legends
	elseif stat == "division" then
		return data.league and data.league.division or 1
	elseif stat == "earned" then
		return data.economy.totalEarned
	elseif stat == "networkPoints" then
		return data.network.points
	elseif stat == "candy" then
		return data.halloween.total
	elseif stat == "reputation" then
		return EconomyFormulas.Reputation(data)
	elseif stat == "arenaGoals" then
		return data.stats.arenaGoals or 0
	elseif stat == "trophies" then
		return data.arena and data.arena.best or 0
	elseif stat == "rebirths" then
		return data.rebirth and data.rebirth.count or 0
	elseif stat == "petsDiscovered" or stat == "goldenPets" then
		local count = 0
		for petId in pairs(data.collection.discovered or {}) do
			local golden = string.sub(petId, 1, 5) == "gold_"
			if golden == (stat == "goldenPets") then
				count += 1
			end
		end
		return count
	elseif stat == "balls" then
		local count = 1 -- el clásico
		for _ in pairs(data.collection.balls) do
			count += 1
		end
		return count
	elseif stat == "pieces" then
		return #data.stadium.pieces
	end
	return 0
end

function MissionService.EvaluateAchievements(player)
	local data = DataService.Get(player)
	if not data then
		return
	end
	for _, a in ipairs(MissionConfig.Achievements) do
		if not data.missions.achievements[a.id] and MissionService.Stat(data, a.stat) >= a.target then
			data.missions.achievements[a.id] = os.time()
			reward(player, data, a.money, a.reputation, "Logro: " .. a.name)
			StadiumService.LogEvent(data, "achievement", { name = a.name })
			notifyRemote:FireClient(player, "success", string.format("%s ¡Logro desbloqueado! %s%s", a.icon, a.name,
				(a.money > 0 and string.format(" · +%d %s", a.money, GameConfig.CURRENCY) or "")))
		end
	end
end

function MissionService.BuildState(data)
	MissionService.EnsureDaily(data)
	local m = data.missions
	local daily = {}
	for _, mission in ipairs(m.daily) do
		local def = MissionConfig.Daily(mission.id)
		if def then
			table.insert(daily, {
				id = mission.id, text = string.format(def.text, mission.target), progress = mission.progress, target = mission.target,
				claimed = mission.claimed, money = def.money, reputation = def.reputation,
			})
		end
	end
	local chains = {}
	for _, chain in ipairs(MissionConfig.Chains) do
		local level = m.chainLevels[chain.id] or 0
		local nextTarget = chain.targets[level + 1]
		table.insert(chains, {
			id = chain.id, name = chain.name, metric = MissionConfig.Metrics[chain.metric], level = level, levels = #chain.targets,
			progress = m.counters[chain.metric] or 0, target = nextTarget, money = nextTarget and chain.money[level + 1] or 0,
		})
	end
	local achievements = {}
	for _, a in ipairs(MissionConfig.Achievements) do
		table.insert(achievements, {
			id = a.id, icon = a.icon, name = a.name, target = a.target, progress = math.min(MissionService.Stat(data, a.stat), a.target),
			unlockedAt = m.achievements[a.id], money = a.money, reputation = a.reputation,
		})
	end
	return { daily = daily, chains = chains, achievements = achievements, resetIn = 86400 - (os.time() % 86400) }
end

return MissionService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000003C"><Properties><string name="Name">NetworkService</string><ProtectedString name="Source"><![CDATA[-- NetworkService (ModuleScript)
-- Ubicación: ServerScriptService/Server/Services/NetworkService
--
-- RED DE CLUBES (FASE 9):
--   * Invitaciones a partidos entre clubes conectados al mismo servidor (en directo).
--   * Retos contra la hoja PÚBLICA de cualquier club del universo (aunque esté en otro
--     servidor); el club retado recibe el aviso en su buzón la próxima vez que entra.
--   * Clasificación entre amigos, comparación de clubes e historial de enfrentamientos.
-- Solo se usan datos públicos de otros clubes (perfil y once titular), nunca su economía.

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local NetworkConfig = require(Shared.Config.NetworkConfig)
local TacticsConfig = require(Shared.Config.TacticsConfig)
local FootballConfig = require(Shared.Config.FootballConfig)
local Remotes = require(Shared.Modules.Remotes)

local DataService = require(script.Parent.DataService)
local ClubService = require(script.Parent.ClubService)
local MatchService = require(script.Parent.MatchService)
local UniverseService = require(script.Parent.UniverseService)

local NetworkService = {}

-- FASE 12: un UserId enviado por el cliente debe ser un entero positivo (descarta NaN, inf y decimales).
local function validUserId(userId)
	return type(userId) == "number" and userId == math.floor(userId) and userId > 0 and userId < 2 ^ 53
end

local notifyRemote = Remotes.Get("Notify")
local invites = {} -- [jugador invitado] = { from, expires }
local friendsCache = {} -- [player] = { time, list }
local inboxStore, rankStore
pcall(function()
	inboxStore = DataStoreService:GetDataStore(NetworkConfig.INBOX_STORE)
	rankStore = DataStoreService:GetOrderedDataStore(NetworkConfig.NETWORK_RANK_STORE)
end)

local function clubInfo(player, data)
	return { name = ClubService.DisplayName(data), short = ClubService.ShortName(data) }
end

local function countAvailable(data)
	local n = 0
	for _, p in ipairs(data.squad) do
		if (p.injury or 0) <= 0 and not (p.loan and p.loan.type == "out") then
			n += 1
		end
	end
	return n
end

-- ===== Hoja pública del equipo (se publica en el perfil del universo) =====

local function publicSheet(data, name, short)
	local sheet = MatchService.BuildUserSheet(data, name, short)
	local players = {}
	for i, p in ipairs(sheet.players) do
		local attrs = {}
		for id, v in pairs(p.attrs) do
			attrs[id] = math.floor(v + 0.5)
		end
		table.insert(players, { id = "u" .. i, name = p.name, pos = p.pos, slotPos = p.slotPos, attrs = attrs })
	end
	return { formation = sheet.formation, mentality = sheet.mentality, style = sheet.style, players = players }
end

local VALID_POS = { GK = true, DEF = true, MID = true, FWD = true }

-- Nunca se confía en una hoja leída de DataStore sin revisarla.
local function sanitizeSheet(sheet, name, short)
	if type(sheet) ~= "table" or type(sheet.players) ~= "table" or #sheet.players ~= 11 then
		return nil
	end
	local players = {}
	for i, p in ipairs(sheet.players) do
		if type(p) ~= "table" or type(p.name) ~= "string" or not VALID_POS[p.pos] or not VALID_POS[p.slotPos] or type(p.attrs) ~= "table" then
			return nil
		end
		local attrs = {}
		for _, attr in ipairs(FootballConfig.Attributes) do
			local v = tonumber(p.attrs[attr.id])
			if not v or v ~= v then
				return nil
			end
			attrs[attr.id] = math.clamp(v, 1, 99)
		end
		table.insert(players, { id = "r" .. i, name = p.name:sub(1, 40), pos = p.pos, slotPos = p.slotPos, attrs = attrs, fitness = 100 })
	end
	return {
		name = name, short = short,
		formation = TacticsConfig.Formation(sheet.formation).id,
		mentality = TacticsConfig.Mentality(sheet.mentality).id,
		style = TacticsConfig.Style(sheet.style).id,
		players = players,
	}
end

UniverseService.ExtendProfile(function(_, data, profile)
	profile.sheet = publicSheet(data, profile.clubName, profile.short)
	profile.strength = math.floor(MatchService.TeamStrength(data) + 0.5)
	profile.networkPoints = data.network.points
end)

-- ===== Historial de enfrentamientos =====

local function recordH2H(data, userId, name, gf, ga, kind)
	local key = tostring(userId)
	local h = data.network.h2h[key]
	if not h then
		h = { name = name, w = 0, d = 0, l = 0, gf = 0, ga = 0 }
		data.network.h2h[key] = h
	end
	h.name = name
	h.gf += gf
	h.ga += ga
	if gf > ga then
		h.w += 1
	elseif gf == ga then
		h.d += 1
	else
		h.l += 1
	end
	h.last = { gf = gf, ga = ga, t = os.time(), kind = kind }
	-- Límite: se olvida el rival más antiguo
	local count, oldestKey, oldestT = 0, nil, math.huge
	for k, v in pairs(data.network.h2h) do
		count += 1
		local t = v.last and v.last.t or 0
		if t < oldestT then
			oldestKey, oldestT = k, t
		end
	end
	if count > NetworkConfig.H2H_MAX_OPPONENTS and oldestKey then
		data.network.h2h[oldestKey] = nil
	end
end

local function addPoints(player, data, points)
	if points <= 0 then
		return
	end
	data.network.points += points
	if rankStore then
		task.spawn(pcall, function()
			rankStore:SetAsync(tostring(player.UserId), data.network.points)
		end)
	end
end

-- ===== Invitaciones (mismo servidor) =====

function NetworkService.Invite(player, payload)
	local data = DataService.Get(player)
	local target = Players:GetPlayerByUserId(tonumber(type(payload) == "table" and payload.userId) or 0)
	local targetData = target and DataService.Get(target)
	if not targetData or target == player then
		return false, "Ese club no está en este servidor."
	end
	local pending = invites[target]
	if pending and pending.expires > os.clock() then
		return false, "Ese club ya tiene una invitación pendiente."
	end
	if countAvailable(data) < 11 then
		return false, "No tienes 11 jugadores disponibles."
	end
	invites[target] = { from = player, expires = os.clock() + NetworkConfig.INVITE_SECONDS }
	local info = clubInfo(player, data)
	notifyRemote:FireClient(target, "invite", {
		fromUserId = player.UserId, fromName = player.DisplayName, clubName = info.name, short = info.short,
		strength = math.floor(MatchService.TeamStrength(data) + 0.5), seconds = NetworkConfig.INVITE_SECONDS,
	})
	return true, string.format("📨 Invitación enviada a %s. Tiene %d segundos para aceptar.", target.DisplayName, NetworkConfig.INVITE_SECONDS)
end

function NetworkService.RespondInvite(player, payload)
	local invite = invites[player]
	invites[player] = nil
	if not invite or invite.expires < os.clock() or not invite.from.Parent then
		return false, "La invitación ya no está disponible."
	end
	local inviter = invite.from
	if type(payload) ~= "table" or payload.accept ~= true then
		notifyRemote:FireClient(inviter, "info", player.DisplayName .. " ha rechazado tu invitación.")
		return true, "Invitación rechazada."
	end
	local homeData, awayData = DataService.Get(inviter), DataService.Get(player)
	if not homeData or not awayData then
		return false, "Uno de los clubes no está disponible."
	end
	local homeInfo, awayInfo = clubInfo(inviter, homeData), clubInfo(player, awayData)
	local result, err = MatchService.PlayUsers(inviter, player, "Amistoso entre clubes", homeInfo, awayInfo)
	if not result then
		return false, err
	end
	recordH2H(homeData, player.UserId, awayInfo.name, result.home.goals, result.away.goals, "amistoso")
	recordH2H(awayData, inviter.UserId, homeInfo.name, result.away.goals, result.home.goals, "amistoso")
	-- Cada cliente recibe el resumen con su lado marcado
	for side, p in ipairs({ inviter, player }) do
		local copy = table.clone(result)
		copy.userSide = side
		local us = side == 1 and result.home.goals or result.away.goals
		local them = side == 1 and result.away.goals or result.home.goals
		copy.outcome = us > them and "W" or (us == them and "D" or "L")
		notifyRemote:FireClient(p, "match", copy)
	end
	return true, string.format("⚽ %s %d - %d %s", homeInfo.short, result.home.goals, result.away.goals, awayInfo.short)
end

-- ===== Retos (cualquier club del universo) =====

local function today()
	return math.floor(os.time() / 86400)
end

function NetworkService.Challenge(player, payload)
	local data = DataService.Get(player)
	local userId = tonumber(type(payload) == "table" and payload.userId)
	if not validUserId(userId) or userId == player.UserId then
		return false, "Club no válido."
	end
	local c = data.network.challenges
	if c.day ~= today() then
		c.day, c.count, c.targets = today(), 0, {}
	end
	if c.count >= NetworkConfig.CHALLENGES_PER_DAY then
		return false, string.format("Ya has hecho tus %d retos de hoy.", NetworkConfig.CHALLENGES_PER_DAY)
	end
	if (c.targets[tostring(userId)] or 0) >= NetworkConfig.CHALLENGE_SAME_TARGET_PER_DAY then
		return false, "Ya has retado a ese club hoy."
	end
	if countAvailable(data) < 11 then
		return false, "No tienes 11 jugadores disponibles."
	end
	-- Perfil del rival: en directo si está en este servidor, si no el publicado en el universo
	local profile
	local live = Players:GetPlayerByUserId(userId)
	if live and DataService.Get(live) then
		profile = UniverseService.PublicProfile(live, DataService.Get(live))
	else
		profile = UniverseService.FetchProfile(userId)
	end
	local sheet = profile and sanitizeSheet(profile.sheet, profile.clubName, profile.short)
	if not sheet then
		return false, "Ese club todavía no ha publicado su once (o el universo no está disponible)."
	end
	c.count += 1
	c.targets[tostring(userId)] = (c.targets[tostring(userId)] or 0) + 1
	local info = clubInfo(player, data)
	local opponent = { name = profile.clubName, short = profile.short, strength = tonumber(profile.strength) or 50 }
	local result = MatchService.Play(player, opponent, {
		clubName = info.name, clubShort = info.short, home = true, competition = "Reto", noEconomy = true, opponentSheet = sheet,
	})
	local gf, ga = result.home.goals, result.away.goals
	recordH2H(data, userId, profile.clubName, gf, ga, "reto")
	local points = gf > ga and NetworkConfig.POINTS_WIN or (gf == ga and NetworkConfig.POINTS_DRAW or 0)
	addPoints(player, data, points)
	result.networkPoints = points
	-- Aviso al club retado (buzón), sin tocar sus datos guardados
	if inboxStore then
		task.spawn(pcall, function()
			inboxStore:UpdateAsync(tostring(userId), function(list)
				list = type(list) == "table" and list or {}
				table.insert(list, { t = os.time(), fromId = player.UserId, fromName = player.DisplayName, fromClub = info.name, gf = ga, ga = gf })
				while #list > NetworkConfig.INBOX_MAX do
					table.remove(list, 1)
				end
				return list
			end)
		end)
	end
	if live and live.Parent then
		notifyRemote:FireClient(live, "info", string.format("⚔️ %s ha retado a tu club: %s %d - %d %s.", info.name, info.short, gf, ga, profile.short))
	end
	return true, string.format("⚔️ Reto contra %s: %d - %d%s", profile.clubName, gf, ga, points > 0 and string.format(" (+%d puntos de red)", points) or ""), result
end

-- Avisos de retos recibidos mientras estabas desconectado.
function NetworkService.ProcessInbox(player)
	local data = DataService.Get(player)
	if not data or not inboxStore then
		return {}
	end
	local entries = {}
	local ok = pcall(function()
		inboxStore:UpdateAsync(tostring(player.UserId), function(list)
			entries = type(list) == "table" and list or {}
			return {}
		end)
	end)
	if not ok then
		return {}
	end
	local messages = {}
	for _, e in ipairs(entries) do
		if type(e) == "table" and tonumber(e.fromId) and tonumber(e.gf) and tonumber(e.ga) then
			recordH2H(data, e.fromId, tostring(e.fromClub), e.gf, e.ga, "reto recibido")
			table.insert(messages, string.format("⚔️ %s retó a tu club mientras no estabas: %d - %d para ti.", tostring(e.fromClub), e.gf, e.ga))
		end
	end
	return messages
end

-- ===== Amigos =====

function NetworkService.RefreshFriends(player)
	local data = DataService.Get(player)
	if not data then
		return
	end
	local ids = {}
	pcall(function()
		local pages = Players:GetFriendsAsync(player.UserId)
		while #ids < NetworkConfig.MAX_FRIENDS_SHOWN do
			for _, friend in ipairs(pages:GetCurrentPage()) do
				if #ids < NetworkConfig.MAX_FRIENDS_SHOWN then
					table.insert(ids, friend.Id)
				end
			end
			if pages.IsFinished then
				break
			end
			pages:AdvanceToNextPageAsync()
		end
	end)
	local list = { UniverseService.PublicProfile(player, data) }
	list[1].isMe = true
	for _, id in ipairs(ids) do
		local live = Players:GetPlayerByUserId(id)
		local profile = (live and DataService.Get(live)) and UniverseService.PublicProfile(live, DataService.Get(live)) or UniverseService.FetchProfile(id)
		if profile then
			profile.inServer = live ~= nil
			table.insert(list, profile)
		end
	end
	for _, p in ipairs(list) do
		p.sheet = nil -- no hace falta en la interfaz
	end
	friendsCache[player] = { time = os.clock(), list = list }
end

-- ===== Comparar clubes =====

function NetworkService.Compare(player, payload)
	local data = DataService.Get(player)
	local userId = tonumber(type(payload) == "table" and payload.userId)
	if not validUserId(userId) then
		return false, "Club no válido."
	end
	local live = Players:GetPlayerByUserId(userId)
	local other = (live and DataService.Get(live)) and UniverseService.PublicProfile(live, DataService.Get(live)) or UniverseService.FetchProfile(userId)
	if not other then
		return false, "No se encontró el perfil público de ese club."
	end
	local me = UniverseService.PublicProfile(player, data)
	me.sheet, other.sheet = nil, nil
	return true, nil, { me = me, other = other, h2h = data.network.h2h[tostring(userId)] }
end

-- ===== Estado =====

function NetworkService.BuildState(player, data)
	local h2h = {}
	for userId, h in pairs(data.network.h2h) do
		table.insert(h2h, { userId = tonumber(userId), name = h.name, w = h.w, d = h.d, l = h.l, gf = h.gf, ga = h.ga, last = h.last })
	end
	table.sort(h2h, function(a, b)
		return (a.last and a.last.t or 0) > (b.last and b.last.t or 0)
	end)
	local c = data.network.challenges
	local used = c.day == today() and c.count or 0
	local cache = friendsCache[player]
	return {
		points = data.network.points,
		challengesLeft = NetworkConfig.CHALLENGES_PER_DAY - used,
		h2h = h2h,
		friends = cache and cache.list or nil,
		hasInvite = invites[player] ~= nil and invites[player].expires > os.clock(),
	}
end

function NetworkService.PlayerReady(player)
	task.spawn(function()
		NetworkService.RefreshFriends(player)
		for _, message in ipairs(NetworkService.ProcessInbox(player)) do
			notifyRemote:FireClient(player, "info", message)
		end
	end)
end

function NetworkService.PlayerRemoving(player)
	invites[player] = nil
	friendsCache[player] = nil
	for target, invite in pairs(invites) do
		if invite.from == player then
			invites[target] = nil
		end
	end
end

return NetworkService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000003D"><Properties><string name="Name">OutfitService</string><ProtectedString name="Source"><![CDATA[-- OutfitService (ModuleScript)
-- Ubicación: ServerScriptService/Server/Services/OutfitService
--
-- TRAJES DE FUTBOLISTA: pinta una equipación sobre el personaje (camiseta, pantalón, medias,
-- botas y dorsal en la espalda). Se compran con dinero del club o salen del pase de temporada.
-- Para que la equipación se vea, se quitan la ropa clásica (Shirt/Pants) y la ropa 3D del avatar;
-- el pelo, los gorros y el resto de accesorios se conservan. «Tu avatar» devuelve el aspecto normal.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local OutfitConfig = require(Shared.Config.OutfitConfig)
local CosmeticConfig = require(Shared.Config.CosmeticConfig)

local DataService = require(script.Parent.DataService)
local EconomyService = require(script.Parent.EconomyService)
local ClubService = require(script.Parent.ClubService)

local OutfitService = {}

-- Ropa 3D (layered clothing) que taparía la equipación
local LAYERED = {
	[Enum.AccessoryType.Shirt] = true, [Enum.AccessoryType.TShirt] = true, [Enum.AccessoryType.Jacket] = true,
	[Enum.AccessoryType.Sweater] = true, [Enum.AccessoryType.Pants] = true, [Enum.AccessoryType.Shorts] = true,
	[Enum.AccessoryType.DressSkirt] = true, [Enum.AccessoryType.LeftShoe] = true, [Enum.AccessoryType.RightShoe] = true,
}
local DARK_BOOTS = Color3.fromRGB(25, 25, 30)

local function readable(color)
	local luminance = 0.299 * color.R + 0.587 * color.G + 0.114 * color.B
	return luminance > 0.6 and Color3.fromRGB(20, 20, 25) or Color3.fromRGB(255, 255, 255)
end

-- Colores finales del traje (el del club usa la paleta real del club)
local function resolve(player, data, def)
	if def.club then
		local appearance = ClubService.EffectiveAppearance(player, data)
		local palette = CosmeticConfig.ById.palette[appearance.palette]
		return { shirt = palette.primary, shorts = palette.secondary, socks = palette.primary, boots = DARK_BOOTS, trim = readable(palette.primary) }
	end
	return def
end

function OutfitService.Owns(data, outfitId)
	local def = OutfitConfig.ById[outfitId]
	if not def then
		return false
	end
	return def.id == OutfitConfig.DEFAULT or def.club == true or data.collection.outfits[outfitId] == true
end

local function paint(character, names, color)
	for _, name in ipairs(names) do
		local limb = character:FindFirstChild(name)
		if limb and limb:IsA("BasePart") then
			limb.Color = color
			if limb:IsA("MeshPart") then
				limb.TextureID = ""
			end
		end
	end
end

local function applyTo(player, character, def, data)
	for _, child in ipairs(character:GetChildren()) do
		if child:IsA("Shirt") or child:IsA("Pants") or child:IsA("ShirtGraphic") or child:IsA("BodyColors") then
			child:Destroy()
		elseif child:IsA("Accessory") and LAYERED[child.AccessoryType] then
			child:Destroy()
		end
	end
	local colors = resolve(player, data, def)
	-- Nombres de R15 y de R6 (los que no existan se ignoran)
	paint(character, { "UpperTorso", "Torso", "LeftUpperArm", "RightUpperArm" }, colors.shirt)
	paint(character, { "LowerTorso", "LeftUpperLeg", "RightUpperLeg", "Left Leg", "Right Leg" }, colors.shorts)
	paint(character, { "LeftLowerLeg", "RightLowerLeg" }, colors.socks)
	paint(character, { "LeftFoot", "RightFoot" }, colors.boots)
	if colors.gloves then
		paint(character, { "LeftHand", "RightHand" }, colors.gloves)
	end

	local torso = character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso")
	local old = torso and torso:FindFirstChild("FEU_Dorsal")
	if old then
		old:Destroy()
	end
	local number = data.collection.dorsal or def.number
	if torso and number then
		local gui = Instance.new("SurfaceGui")
		gui.Name = "FEU_Dorsal"
		gui.Face = Enum.NormalId.Back
		gui.SizingMode = Enum.SurfaceGuiSizingMode.FixedSize
		gui.CanvasSize = Vector2.new(120, 120)
		gui.LightInfluence = 0.3
		gui.Parent = torso
		local label = Instance.new("TextLabel")
		label.Size = UDim2.fromScale(0.8, 0.7)
		label.Position = UDim2.fromScale(0.1, 0.12)
		label.BackgroundTransparency = 1
		label.Font = Enum.Font.GothamBlack
		label.TextScaled = true
		label.TextColor3 = colors.trim
		label.Text = tostring(number)
		label.Parent = gui
	end
	character:SetAttribute("Outfit", def.id)
end

-- Aplica al personaje actual el traje equipado (o devuelve el avatar normal si es «Tu avatar»).
function OutfitService.Apply(player)
	local data = DataService.Get(player)
	local character = player.Character
	if not data or not character then
		return
	end
	local def = OutfitConfig.ById[data.collection.outfit] or OutfitConfig.ById[OutfitConfig.DEFAULT]
	if def.id == OutfitConfig.DEFAULT then
		if character:GetAttribute("Outfit") then
			-- Volver al avatar normal: Roblox lo vuelve a cargar entero
			task.spawn(function()
				pcall(function()
					player:LoadCharacter()
				end)
			end)
		end
		return
	end
	-- La ropa del avatar llega un momento después de aparecer: se espera para poder quitarla
	if not player:HasAppearanceLoaded() then
		local loaded = false
		local connection = player.CharacterAppearanceLoaded:Connect(function()
			loaded = true
		end)
		local startedAt = os.clock()
		while not loaded and os.clock() - startedAt < 8 and player.Parent do
			task.wait(0.2)
		end
		connection:Disconnect()
	end
	if player.Character ~= character or not character.Parent then
		return
	end
	local current = DataService.Get(player)
	if current then
		applyTo(player, character, OutfitConfig.ById[current.collection.outfit] or def, current)
	end
end

function OutfitService.CharacterAdded(player)
	local data = DataService.Get(player)
	if data and data.collection.outfit ~= OutfitConfig.DEFAULT then
		OutfitService.Apply(player)
	end
end

-- ===== Acciones =====

function OutfitService.Buy(player, payload)
	local data = DataService.Get(player)
	local def = type(payload) == "table" and type(payload.outfit) == "string" and OutfitConfig.ById[payload.outfit]
	if not def then
		return false, "Ese traje no existe."
	end
	if OutfitService.Owns(data, def.id) then
		return false, "Ya tienes ese traje."
	end
	if def.exclusive then
		return false, "Ese traje solo se consigue en el pase de temporada."
	end
	local paid, payError = EconomyService.Spend(player, def.cost, EconomyService.Category.COLLECTION, "Traje: " .. def.name)
	if not paid then
		return false, payError
	end
	data.collection.outfits[def.id] = true
	return true, string.format("%s Traje «%s» comprado. ¡Equípatelo!", def.icon, def.name)
end

function OutfitService.Equip(player, payload)
	local data = DataService.Get(player)
	local def = type(payload) == "table" and type(payload.outfit) == "string" and OutfitConfig.ById[payload.outfit]
	if not def then
		return false, "Ese traje no existe."
	end
	if not OutfitService.Owns(data, def.id) then
		return false, "Todavía no tienes ese traje."
	end
	data.collection.outfit = def.id
	task.spawn(OutfitService.Apply, player)
	return true, def.id == OutfitConfig.DEFAULT and "Vuelves a llevar tu avatar." or string.format("%s Llevas «%s».", def.icon, def.name)
end

-- Dorsal personalizado (1-99). Con 0 o vacío se usa el número propio de cada traje.
function OutfitService.SetDorsal(player, payload)
	local data = DataService.Get(player)
	if type(payload) ~= "table" then
		return false, "Solicitud no válida."
	end
	local number = tonumber(payload.number) or 0
	if number ~= number or number ~= math.floor(number) or number < 0 or number > OutfitConfig.MAX_NUMBER then
		return false, string.format("El dorsal debe ser un número entre %d y %d.", OutfitConfig.MIN_NUMBER, OutfitConfig.MAX_NUMBER)
	end
	data.collection.dorsal = number >= OutfitConfig.MIN_NUMBER and number or nil
	if data.collection.outfit ~= OutfitConfig.DEFAULT then
		task.spawn(OutfitService.Apply, player)
	end
	return true, data.collection.dorsal and string.format("Dorsal %d guardado.", number) or "Dorsal por defecto de cada traje."
end

function OutfitService.BuildState(data)
	return {
		owned = data.collection.outfits,
		equipped = data.collection.outfit,
		dorsal = data.collection.dorsal,
	}
end

return OutfitService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000003E"><Properties><string name="Name">PetService</string><ProtectedString name="Source"><![CDATA[-- PetService (ModuleScript)
-- Ubicación: ServerScriptService/Server/Services/PetService
--
-- MASCOTAS Y BALONES COLECCIONABLES.
--   * Huevos y cajas: se pagan con dinero del club; el SERVIDOR sortea la rareza con las
--     probabilidades de CollectionConfig (las mismas que ve el jugador) y guarda el resultado.
--   * Mascotas equipadas (máx. 3): siguen al jugador y suman un bonus a las recompensas de los
--     partidos en grupo. Se pueden vender las repetidas.
--   * Balones: aspecto del balón de tu estadio y del balón de los partidos cuando lo tocas tú.
-- El cliente solo envía «abre este huevo» o «equipa esto»: nunca decide qué le toca.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage.Shared
local CollectionConfig = require(Shared.Config.CollectionConfig)
local WeeklyConfig = require(Shared.Config.WeeklyConfig)
local RebirthConfig = require(Shared.Config.RebirthConfig)
local Remotes = require(Shared.Modules.Remotes)

local DataService = require(script.Parent.DataService)
local EconomyService = require(script.Parent.EconomyService)
local AdminService = require(script.Parent.AdminService)

local PetService = {}

local notifyRemote = Remotes.Get("Notify")
local rng = Random.new()
local petFolder
local models = {} -- [player] = { Model, ... }
local ballCallbacks = {}

-- Posición de cada mascota respecto al jugador (detrás y a los lados; el frente es -Z)
local OFFSETS = {
	Vector3.new(-3.4, -0.8, 3.6), Vector3.new(3.4, -0.8, 3.6), Vector3.new(0, -0.8, 5.8),
	Vector3.new(-5.6, -0.8, 6.4), Vector3.new(5.6, -0.8, 6.4),
}
local SCALE = { common = 1, rare = 1.06, epic = 1.14, legendary = 1.24, mythic = 1.34 }

-- Mascotas por grupo (pool) y rareza: cada huevo solo da mascotas de su grupo
local DEFAULT_POOL = "classic"
local petsByPool, ballsByRarity = {}, {}
for _, pet in ipairs(CollectionConfig.Pets) do
	local pool = pet.pool or DEFAULT_POOL
	petsByPool[pool] = petsByPool[pool] or {}
	petsByPool[pool][pet.rarity] = petsByPool[pool][pet.rarity] or {}
	table.insert(petsByPool[pool][pet.rarity], pet)
end
-- Aviso en Output si un huevo puede sacar una rareza sin mascotas en su grupo
for _, egg in ipairs(CollectionConfig.Eggs) do
	local pool = petsByPool[egg.pool or DEFAULT_POOL] or {}
	for rarityId, weight in pairs(egg.weights) do
		if weight > 0 and not pool[rarityId] then
			warn(string.format("[PetService] El huevo %s puede dar %s pero su grupo no tiene mascotas de esa rareza", egg.id, rarityId))
		end
	end
end
for _, ball in ipairs(CollectionConfig.Balls) do
	if not ball.exclusive then -- los exclusivos del pase de temporada no salen en las cajas
		ballsByRarity[ball.rarity] = ballsByRarity[ball.rarity] or {}
		table.insert(ballsByRarity[ball.rarity], ball)
	end
end

-- Precios con el descuento de la semana (si esta semana toca huevos o cajas)
function PetService.EggCost(egg)
	return WeeklyConfig.Price(egg.cost, WeeklyConfig.ActiveBonus().eggDiscount)
end

function PetService.CrateCost(crate)
	return WeeklyConfig.Price(crate.cost, WeeklyConfig.ActiveBonus().crateDiscount)
end

-- ===== Sorteo =====

local function rollRarity(weights)
	local odds = CollectionConfig.Odds(weights, AdminService.LuckMultiplier())
	local roll = rng:NextNumber(0, 100)
	local accumulated, last = 0, nil
	for _, rarity in ipairs(CollectionConfig.Rarities) do
		local chance = odds[rarity.id] or 0
		if chance > 0 then
			last = rarity.id
			accumulated += chance
			if roll < accumulated then
				return rarity.id
			end
		end
	end
	return last
end

local function announce(player, text)
	notifyRemote:FireAllClients("info", string.format("🎉 %s %s", player.DisplayName, text))
end

-- Mascotas posibles para esa rareza en el grupo del huevo. Si no hubiera ninguna (error de
-- configuración), se usa la rareza más cercana hacia abajo y, si no, hacia arriba.
local function poolFor(egg, rarityId)
	local groups = petsByPool[egg.pool or DEFAULT_POOL] or petsByPool[DEFAULT_POOL]
	if groups[rarityId] then
		return groups[rarityId]
	end
	local order = {}
	for i, rarity in ipairs(CollectionConfig.Rarities) do
		order[rarity.id] = i
	end
	local start = order[rarityId] or 1
	for distance = 1, #CollectionConfig.Rarities do
		for _, index in ipairs({ start - distance, start + distance }) do
			local rarity = CollectionConfig.Rarities[index]
			if rarity and groups[rarity.id] then
				return groups[rarity.id]
			end
		end
	end
	return petsByPool[DEFAULT_POOL].common
end

-- Huecos de mascota equipada de este jugador (3, más los que dan los renacimientos)
function PetService.MaxPets(data)
	return math.min(CollectionConfig.ABSOLUTE_MAX_PETS,
		RebirthConfig.PetSlots(data.rebirth and data.rebirth.count, CollectionConfig.MAX_EQUIPPED_PETS))
end

-- Sortea una mascota de ese huevo y la guarda. Devuelve la mascota, su rareza y si es nueva.
local function hatchInto(player, data, egg)
	local pool = poolFor(egg, rollRarity(egg.weights))
	local pet = pool[rng:NextInteger(1, #pool)]
	local rarityId = pet.rarity
	local collection = data.collection
	collection.pets[pet.id] = math.min(999, (collection.pets[pet.id] or 0) + 1)
	collection.discovered[pet.id] = true
	collection.hatched += 1
	local rarity = CollectionConfig.RarityById[rarityId]
	local isNew = collection.pets[pet.id] == 1
	if rarityId == "legendary" or rarityId == "mythic" then
		announce(player, string.format("ha conseguido la mascota %s %s (%s)", pet.icon, pet.name, rarity.name))
	end
	return pet, rarity, isNew
end

local RARITY_ORDER = {}
for index, rarity in ipairs(CollectionConfig.Rarities) do
	RARITY_ORDER[rarity.id] = index
end

-- payload = { egg, amount = 1 | 3 }. Con 3 se abren tres seguidos (cuesta el triple).
function PetService.Hatch(player, payload)
	local data = DataService.Get(player)
	local egg = type(payload) == "table" and type(payload.egg) == "string" and CollectionConfig.EggById[payload.egg]
	if not egg then
		return false, "Ese huevo no existe."
	end
	if egg.requiresRebirth and data.rebirth.count < egg.requiresRebirth then
		return false, string.format("El %s se desbloquea al renacer %d vez.", egg.name, egg.requiresRebirth)
	end
	local amount = payload.amount == 3 and 3 or 1
	local paid, payError = EconomyService.Spend(player, PetService.EggCost(egg) * amount, EconomyService.Category.COLLECTION,
		amount > 1 and (egg.name .. " x3") or egg.name)
	if not paid then
		return false, payError
	end
	local texts, best = {}, nil
	for _ = 1, amount do
		local pet, rarity, isNew = hatchInto(player, data, egg)
		table.insert(texts, string.format("%s %s (%s)%s", pet.icon, pet.name, rarity.name, isNew and " ¡NUEVA!" or ""))
		if not best or RARITY_ORDER[pet.rarity] > RARITY_ORDER[best.pet.rarity] or (isNew and not best.isNew and pet.rarity == best.pet.rarity) then
			best = { pet = pet, isNew = isNew }
		end
	end
	return true, "🥚 " .. table.concat(texts, " · "), false, { kind = "pet", id = best.pet.id, isNew = best.isNew, count = amount }
end

-- FUSIÓN: FUSE_COUNT copias de una mascota normal se convierten en su versión dorada.
function PetService.Fuse(player, payload)
	local data = DataService.Get(player)
	local pet = type(payload) == "table" and type(payload.pet) == "string" and CollectionConfig.PetById[payload.pet]
	if not pet or pet.golden then
		return false, "Esa mascota no se puede fusionar."
	end
	local golden = CollectionConfig.PetById["gold_" .. pet.id]
	local collection = data.collection
	local count = collection.pets[pet.id] or 0
	if count < CollectionConfig.FUSE_COUNT then
		return false, string.format("Necesitas %d %s para fusionarlas (tienes %d).", CollectionConfig.FUSE_COUNT, pet.name, count)
	end
	count -= CollectionConfig.FUSE_COUNT
	collection.pets[pet.id] = count > 0 and count or nil
	if count == 0 then
		local index = table.find(collection.equippedPets, pet.id)
		if index then
			table.remove(collection.equippedPets, index)
		end
	end
	collection.pets[golden.id] = math.min(999, (collection.pets[golden.id] or 0) + 1)
	collection.discovered[golden.id] = true
	PetService.Refresh(player)
	if pet.rarity == "legendary" or pet.rarity == "mythic" then
		announce(player, string.format("ha fusionado un %s %s", golden.icon, golden.name))
	end
	return true, string.format("✨ ¡Fusión! %s %s (+%d %% en partidos).", golden.icon, golden.name, math.floor(golden.bonus * 100 + 0.5)), false,
		{ kind = "pet", id = golden.id, isNew = collection.pets[golden.id] == 1 }
end

-- Vende las copias repetidas de las mascotas comunes y raras (siempre se queda una).
function PetService.SellDuplicates(player)
	local data = DataService.Get(player)
	local collection = data.collection
	local total, sold = 0, 0
	for petId, count in pairs(collection.pets) do
		local pet = CollectionConfig.PetById[petId]
		if pet and not pet.golden and CollectionConfig.SELL_DUPLICATES_RARITIES[pet.rarity] and count > 1 then
			local extra = count - 1
			collection.pets[petId] = 1
			total += extra * CollectionConfig.RarityById[pet.rarity].sell
			sold += extra
		end
	end
	if sold == 0 then
		return false, "No tienes mascotas comunes o raras repetidas."
	end
	EconomyService.Earn(player, total, EconomyService.Category.COLLECTION, string.format("Venta de %d repetidas", sold))
	return true, string.format("💰 Has vendido %d mascotas repetidas por %d $.", sold, total)
end

-- ÍNDICE: premio por descubrir todas las mascotas normales de un grupo (una vez).
function PetService.ClaimIndex(player, payload)
	local data = DataService.Get(player)
	local poolId = type(payload) == "table" and payload.pool
	local reward
	for _, entry in ipairs(CollectionConfig.IndexRewards) do
		if entry.pool == poolId then
			reward = entry
		end
	end
	if not reward then
		return false, "Ese índice no existe."
	end
	local collection = data.collection
	if collection.indexClaimed[reward.pool] then
		return false, "Ya has reclamado ese premio del índice."
	end
	for _, pet in ipairs(CollectionConfig.PetsOfPool(reward.pool)) do
		if not collection.discovered[pet.id] then
			return false, string.format("Te falta descubrir %s %s.", pet.icon, pet.name)
		end
	end
	collection.indexClaimed[reward.pool] = true
	EconomyService.Earn(player, reward.money, EconomyService.Category.PRIZE, "Índice " .. reward.name)
	local egg = reward.egg and PetService.GrantEgg(player, reward.egg)
	return true, string.format("📖 ¡Índice %s completo! +%d $%s", reward.name, reward.money, egg and (" · " .. egg) or "")
end

-- Huevo regalado (recompensa del pase de temporada): se abre al momento, sin cobrar.
function PetService.GrantEgg(player, eggId)
	local data = DataService.Get(player)
	local egg = CollectionConfig.EggById[eggId]
	if not data or not egg then
		return nil
	end
	local pet, rarity, isNew = hatchInto(player, data, egg)
	return string.format("%s %s (%s)%s", pet.icon, pet.name, rarity.name, isNew and " · ¡nueva!" or "")
end

-- Balón regalado (recompensa del pase): sortea la rareza de esa caja y da un balón que NO tengas.
-- Si ya tienes todos los de esa rareza, busca en las demás; devuelve nil si ya los tienes todos.
function PetService.GrantBall(player, crateId)
	local data = DataService.Get(player)
	local crate = CollectionConfig.CrateById[crateId]
	if not data or not crate then
		return nil
	end
	local collection = data.collection
	local function missing(rarityId)
		local list = {}
		for _, ball in ipairs(ballsByRarity[rarityId] or {}) do
			if ball.id ~= CollectionConfig.DEFAULT_BALL and not collection.balls[ball.id] then
				table.insert(list, ball)
			end
		end
		return list
	end
	local candidates = missing(rollRarity(crate.weights))
	if #candidates == 0 then
		for _, rarity in ipairs(CollectionConfig.Rarities) do
			for _, ball in ipairs(missing(rarity.id)) do
				table.insert(candidates, ball)
			end
		end
	end
	if #candidates == 0 then
		return nil
	end
	local ball = candidates[rng:NextInteger(1, #candidates)]
	collection.balls[ball.id] = true
	return string.format("%s Balón %s (%s)", ball.icon, ball.name, CollectionConfig.RarityById[ball.rarity].name)
end

function PetService.OpenCrate(player, payload)
	local data = DataService.Get(player)
	local crate = type(payload) == "table" and type(payload.crate) == "string" and CollectionConfig.CrateById[payload.crate]
	if not crate then
		return false, "Esa caja no existe."
	end
	local cost = PetService.CrateCost(crate)
	local paid, payError = EconomyService.Spend(player, cost, EconomyService.Category.COLLECTION, crate.name)
	if not paid then
		return false, payError
	end
	local rarityId = rollRarity(crate.weights)
	local pool = ballsByRarity[rarityId]
	local ball = pool[rng:NextInteger(1, #pool)]
	local collection = data.collection
	local rarity = CollectionConfig.RarityById[rarityId]
	local owned = ball.id == CollectionConfig.DEFAULT_BALL or collection.balls[ball.id] == true
	collection.crates += 1
	if owned then
		local refund = math.floor(cost * CollectionConfig.DUPLICATE_BALL_REFUND)
		EconomyService.Earn(player, refund, EconomyService.Category.REFUND, "Balón repetido: " .. ball.name)
		return true, string.format("%s %s (%s) repetido: te devolvemos %d $.", ball.icon, ball.name, rarity.name, refund), false,
			{ kind = "ball", id = ball.id, isNew = false, refund = refund }
	end
	collection.balls[ball.id] = true
	if rarityId == "legendary" or rarityId == "mythic" then
		announce(player, string.format("ha conseguido el balón %s %s (%s)", ball.icon, ball.name, rarity.name))
	end
	return true, string.format("%s ¡%s! Balón %s · ¡NUEVO!", ball.icon, ball.name, rarity.name), false,
		{ kind = "ball", id = ball.id, isNew = true }
end

-- ===== Equipar y vender =====

function PetService.EquipPet(player, payload)
	local data = DataService.Get(player)
	local pet = type(payload) == "table" and type(payload.pet) == "string" and CollectionConfig.PetById[payload.pet]
	if not pet then
		return false, "Esa mascota no existe."
	end
	local collection = data.collection
	local index = table.find(collection.equippedPets, pet.id)
	if payload.equip == true then
		if (collection.pets[pet.id] or 0) < 1 then
			return false, "No tienes esa mascota."
		end
		if index then
			return false, "Ya la llevas equipada."
		end
		local maxPets = PetService.MaxPets(data)
		if #collection.equippedPets >= maxPets then
			return false, string.format("Solo puedes llevar %d mascotas a la vez. Quita una primero (renacer da más huecos).", maxPets)
		end
		table.insert(collection.equippedPets, pet.id)
		PetService.Refresh(player)
		return true, string.format("%s %s te acompaña (+%d%% en partidos).", pet.icon, pet.name, math.floor(pet.bonus * 100 + 0.5))
	end
	if not index then
		return false, "No la llevas equipada."
	end
	table.remove(collection.equippedPets, index)
	PetService.Refresh(player)
	return true, string.format("%s %s descansa.", pet.icon, pet.name)
end

function PetService.SellPet(player, payload)
	local data = DataService.Get(player)
	local pet = type(payload) == "table" and type(payload.pet) == "string" and CollectionConfig.PetById[payload.pet]
	if not pet then
		return false, "Esa mascota no existe."
	end
	local collection = data.collection
	local count = collection.pets[pet.id] or 0
	if count < 1 then
		return false, "No tienes esa mascota."
	end
	count -= 1
	collection.pets[pet.id] = count > 0 and count or nil
	if count == 0 then
		local index = table.find(collection.equippedPets, pet.id)
		if index then
			table.remove(collection.equippedPets, index)
			PetService.Refresh(player)
		end
	end
	local value = CollectionConfig.RarityById[pet.rarity].sell * (pet.golden and CollectionConfig.GOLDEN_SELL or 1)
	EconomyService.Earn(player, value, EconomyService.Category.COLLECTION, "Venta: " .. pet.name)
	return true, string.format("%s %s vendida por %d $.", pet.icon, pet.name, value)
end

function PetService.EquipBall(player, payload)
	local data = DataService.Get(player)
	local ball = type(payload) == "table" and type(payload.ball) == "string" and CollectionConfig.BallById[payload.ball]
	if not ball then
		return false, "Ese balón no existe."
	end
	local collection = data.collection
	if ball.id ~= CollectionConfig.DEFAULT_BALL and collection.balls[ball.id] ~= true then
		return false, "Todavía no tienes ese balón."
	end
	collection.ball = ball.id
	for _, callback in ipairs(ballCallbacks) do
		task.spawn(callback, player, ball.id)
	end
	return true, string.format("%s Balón %s equipado.", ball.icon, ball.name)
end

function PetService.OnBallChanged(callback)
	table.insert(ballCallbacks, callback)
end

-- ===== Consultas =====

local function bonusOf(data)
	local total = 0
	for _, petId in ipairs(data.collection.equippedPets) do
		local pet = CollectionConfig.PetById[petId]
		if pet then
			total += pet.bonus
		end
	end
	return total
end

-- Bonus (fracción) que las mascotas equipadas suman a las recompensas de los partidos en grupo.
function PetService.Bonus(player)
	local data = DataService.Get(player)
	return data and bonusOf(data) or 0
end

function PetService.BallOf(player)
	local data = DataService.Get(player)
	return data and data.collection.ball or CollectionConfig.DEFAULT_BALL
end

function PetService.BuildState(data)
	local collection = data.collection
	return {
		pets = collection.pets,
		equippedPets = collection.equippedPets,
		balls = collection.balls,
		ball = collection.ball,
		bonus = bonusOf(data),
		maxPets = PetService.MaxPets(data),
		discovered = collection.discovered,
		indexClaimed = collection.indexClaimed,
		rebirths = data.rebirth.count,
		hatched = collection.hatched,
		luck = AdminService.LuckMultiplier(),
	}
end

-- ===== Mascotas en el mundo =====

local function petPart(model, className, size, color, material)
	local p = Instance.new(className)
	p.Size = size
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.Anchored = false
	p.CanCollide = false
	p.CanTouch = false
	p.CanQuery = false
	p.Massless = true
	p.CastShadow = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = model
	return p
end

local function buildPet(def, cframe)
	local s = SCALE[def.rarity] or 1
	local material = def.neon and Enum.Material.Neon or Enum.Material.SmoothPlastic
	local model = Instance.new("Model")
	model.Name = "Pet_" .. def.id
	local root = petPart(model, "Part", Vector3.new(2.2, 2.2, 2.2) * s, def.body, material)
	root.Name = "Body"
	root.Shape = Enum.PartType.Ball
	root.CFrame = cframe
	model.PrimaryPart = root

	local function add(className, size, offset, color, shape, partMaterial)
		local p = petPart(model, className, size * s, color, partMaterial or material)
		if shape then
			p.Shape = shape
		end
		p.CFrame = cframe * CFrame.new(offset.Position * s) * offset.Rotation
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = root
		weld.Part1 = p
		weld.Parent = p
		return p
	end
	local ball = Enum.PartType.Ball
	local plastic = Enum.Material.SmoothPlastic
	add("Part", Vector3.new(1.6, 1.6, 1.6), CFrame.new(0, 0.9, -0.9), def.body, ball)
	add("Part", Vector3.new(0.5, 0.5, 0.5), CFrame.new(0, 0.1, 1.15), def.accent, ball)
	for _, side in ipairs({ -1, 1 }) do
		add("Part", Vector3.new(0.28, 0.28, 0.28), CFrame.new(side * 0.38, 1.15, -1.58), Color3.fromRGB(20, 20, 25), ball, plastic)
	end
	if def.beak then
		add("Part", Vector3.new(0.45, 0.35, 0.7), CFrame.new(0, 0.8, -1.8), Color3.fromRGB(255, 150, 40), nil, plastic)
	else
		add("Part", Vector3.new(0.7, 0.6, 0.6), CFrame.new(0, 0.7, -1.55), def.accent, ball, plastic)
	end
	for _, side in ipairs({ -1, 1 }) do
		if def.ears == "floppy" then
			add("Part", Vector3.new(0.3, 0.9, 0.6), CFrame.new(side * 0.85, 0.85, -0.9), def.accent, nil, plastic)
		elseif def.ears == "pointy" then
			add("Part", Vector3.new(0.5, 0.75, 0.25), CFrame.new(side * 0.5, 1.8, -0.9) * CFrame.Angles(0, 0, math.rad(-side * 18)), def.body)
		elseif def.ears == "long" then
			add("Part", Vector3.new(0.35, 1.4, 0.25), CFrame.new(side * 0.4, 2.2, -0.9), def.body)
		elseif def.ears == "round" then
			add("Part", Vector3.new(0.6, 0.6, 0.6), CFrame.new(side * 0.6, 1.7, -0.9), def.accent, ball, plastic)
		end
		if def.wings then
			add("Part", Vector3.new(0.15, 0.9, 1.3), CFrame.new(side * 1.3, 0.45, 0.1) * CFrame.Angles(0, 0, math.rad(-side * 28)), def.accent, nil, plastic)
		end
	end
	if def.mane then
		-- Disco detrás de la cara (el eje del cilindro es X: se gira para ponerlo de frente)
		add("Part", Vector3.new(0.5, 2.3, 2.3), CFrame.new(0, 0.9, -0.55) * CFrame.Angles(0, math.rad(90), 0), def.accent, Enum.PartType.Cylinder, plastic)
	end
	if def.horn then
		add("Part", Vector3.new(0.22, 0.9, 0.22), CFrame.new(0, 1.95, -1.2) * CFrame.Angles(math.rad(-20), 0, 0), Color3.fromRGB(255, 205, 70), nil, Enum.Material.Neon)
	end
	if def.fin then
		add("WedgePart", Vector3.new(0.15, 0.9, 1), CFrame.new(0, 1.4, 0.2), def.body:Lerp(Color3.new(0, 0, 0), 0.25), nil, plastic)
	end
	if def.sparkles then
		local sparkles = Instance.new("Sparkles")
		sparkles.SparkleColor = def.sparkles
		sparkles.Parent = root
	end
	if def.fire then
		local fire = Instance.new("Fire")
		fire.Size = 3 * s
		fire.Heat = 5
		fire.Color = Color3.fromRGB(255, 170, 40)
		fire.SecondaryColor = Color3.fromRGB(255, 230, 120)
		fire.Parent = root
	end

	local rarity = CollectionConfig.RarityById[def.rarity]
	local tag = Instance.new("BillboardGui")
	tag.Size = UDim2.fromOffset(130, 22)
	tag.StudsOffset = Vector3.new(0, 2.6 * s, 0)
	tag.MaxDistance = 45
	tag.Parent = root
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBold
	label.TextScaled = true
	label.TextColor3 = rarity.color
	label.TextStrokeTransparency = 0.3
	label.Text = def.name
	label.Parent = tag
	return model, root
end

local function clear(player)
	for _, model in ipairs(models[player] or {}) do
		model:Destroy()
	end
	models[player] = nil
end

-- Vuelve a crear las mascotas equipadas junto al personaje actual del jugador.
function PetService.Refresh(player)
	clear(player)
	local data = DataService.Get(player)
	local character = player.Character
	local hrp = character and character:FindFirstChild("HumanoidRootPart")
	if not data or not hrp or not petFolder then
		return
	end
	local list = {}
	for i, petId in ipairs(data.collection.equippedPets) do
		local def = CollectionConfig.PetById[petId]
		local offset = OFFSETS[i]
		if def and offset then
			local model, root = buildPet(def, hrp.CFrame * CFrame.new(offset))
			-- La mascota sigue un punto fijo junto al jugador (sin empujarlo: no hay fuerza de reacción)
			local target = Instance.new("Attachment")
			target.Name = "PetTarget" .. i
			target.Position = offset
			target:SetAttribute("Base", offset) -- el cliente del dueño la hace flotar arriba y abajo
			target.Parent = hrp
			local anchor = Instance.new("Attachment")
			anchor.Parent = root
			local position = Instance.new("AlignPosition")
			position.Attachment0 = anchor
			position.Attachment1 = target
			position.MaxForce = 100000
			position.Responsiveness = 22
			position.Parent = root
			local orientation = Instance.new("AlignOrientation")
			orientation.Attachment0 = anchor
			orientation.Attachment1 = target
			orientation.MaxTorque = 100000
			orientation.Responsiveness = 16
			orientation.Parent = root
			model.Destroying:Connect(function()
				target:Destroy()
			end)
			model.Parent = petFolder
			pcall(function()
				root:SetNetworkOwner(player) -- movimiento fluido en la pantalla de su dueño
			end)
			table.insert(list, model)
		end
	end
	models[player] = list
end

function PetService.CharacterAdded(player)
	task.wait(0.6) -- deja que el personaje se coloque en su estadio
	if player.Parent then
		PetService.Refresh(player)
	end
end

function PetService.PlayerRemoving(player)
	clear(player)
end

function PetService.Start()
	petFolder = Instance.new("Folder")
	petFolder.Name = "FEU_Pets"
	petFolder.Parent = Workspace
end

return PetService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000003F"><Properties><string name="Name">PlotService</string><ProtectedString name="Source"><![CDATA[-- PlotService (ModuleScript)
-- Ubicación: ServerScriptService/Server/Services/PlotService
--
-- Terrenos del servidor:
--   * Crea el mundo base (avenida central + terrenos) por código.
--   * Asigna un terreno a cada jugador y construye su estadio desde sus datos.
--   * Teletransporta al jugador a su estadio y muestra su etiqueta (club / VIP).
-- Cualquier jugador puede caminar por los estadios ajenos (visita), pero solo
-- el servidor modifica un estadio y únicamente con los datos de su dueño.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage.Shared
local GameConfig = require(Shared.Config.GameConfig)
local CosmeticConfig = require(Shared.Config.CosmeticConfig)
local TrophyConfig = require(Shared.Config.TrophyConfig)
local StadiumStages = require(Shared.Config.StadiumStages)

local DataService = require(script.Parent.DataService)
local ClubService = require(script.Parent.ClubService)
local BuildService = require(script.Parent.BuildService)
local StadiumRenderer = require(script.Parent.StadiumRenderer)
local InteractionService = require(script.Parent.InteractionService)
local HalloweenService = require(script.Parent.HalloweenService)
local GamePassService = require(script.Parent.GamePassService)

local PlotService = {}

local plots = {} -- array de { index, origin, model, stadium, owner }
local playerPlot = {} -- [player] = plot
local pendingRender = {}

local AVENUE_WIDTH = 60

local function makePart(parent, cf, size, color, mat, name)
	local p = Instance.new("Part")
	p.Anchored = true
	p.CFrame = cf
	p.Size = size
	p.Color = color
	p.Material = mat
	p.Name = name or "Part"
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end

local function setFreeSign(plot)
	local old = plot.model:FindFirstChild("FreeSign")
	if old then
		old:Destroy()
	end
	if plot.owner then
		return
	end
	local sign = makePart(plot.model, plot.origin * CFrame.new(0, 6, 82), Vector3.new(20, 6, 1),
		Color3.fromRGB(30, 40, 60), Enum.Material.SmoothPlastic, "FreeSign")
	for _, face in ipairs({ Enum.NormalId.Front, Enum.NormalId.Back }) do
		local gui = Instance.new("SurfaceGui")
		gui.Face = face
		gui.Parent = sign
		local t = Instance.new("TextLabel")
		t.Size = UDim2.fromScale(1, 1)
		t.BackgroundTransparency = 1
		t.TextColor3 = Color3.fromRGB(220, 230, 255)
		t.Font = Enum.Font.GothamBold
		t.TextScaled = true
		t.Text = "Terreno " .. plot.index .. " · libre"
		t.Parent = gui
	end
end

function PlotService.CreateWorld()
	local root = Workspace:FindFirstChild("FEU_World")
	if root then
		root:Destroy()
	end
	root = Instance.new("Folder")
	root.Name = "FEU_World"
	root.Parent = Workspace

	local perRow = math.ceil(GameConfig.PLOT_COUNT / 2)
	local stepX = GameConfig.PLOT_SIZE.X + GameConfig.PLOT_SPACING
	local rowOffset = AVENUE_WIDTH / 2 + GameConfig.PLOT_SIZE.Z / 2
	local totalX = perRow * stepX + 120
	local totalZ = (rowOffset + GameConfig.PLOT_SIZE.Z / 2) * 2 + 80

	makePart(root, CFrame.new(0, -0.6, 0), Vector3.new(totalX, 1, totalZ), Color3.fromRGB(70, 110, 60), Enum.Material.Grass, "Ground")
	makePart(root, CFrame.new(0, -0.48, 0), Vector3.new(totalX, 1, AVENUE_WIDTH - 10), Color3.fromRGB(150, 150, 155), Enum.Material.Concrete, "Avenue")

	local spawn = Instance.new("SpawnLocation")
	spawn.Anchored = true
	spawn.Size = Vector3.new(12, 1, 12)
	spawn.CFrame = CFrame.new(0, 0.05, 0)
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.Color = Color3.fromRGB(255, 196, 0)
	spawn.Material = Enum.Material.Neon
	spawn.Parent = root

	local plotsFolder = Instance.new("Folder")
	plotsFolder.Name = "Plots"
	plotsFolder.Parent = root

	for i = 1, GameConfig.PLOT_COUNT do
		local row = (i <= perRow) and 0 or 1
		local col = (i - 1) % perRow
		local x = (col - (perRow - 1) / 2) * stepX
		local origin
		if row == 0 then
			origin = CFrame.new(x, 0, -rowOffset) -- plaza (Z+ local) mirando a la avenida
		else
			origin = CFrame.new(x, 0, rowOffset) * CFrame.Angles(0, math.pi, 0)
		end
		local model = Instance.new("Model")
		model.Name = "Plot_" .. i
		model:SetAttribute("PlotIndex", i)
		model.Parent = plotsFolder
		local base = makePart(model, origin * CFrame.new(0, -0.5, 0), GameConfig.PLOT_SIZE,
			Color3.fromRGB(86, 125, 70), Enum.Material.Grass, "Base")
		model.PrimaryPart = base
		local stadium = Instance.new("Folder")
		stadium.Name = "Stadium"
		stadium.Parent = model
		local crowd = Instance.new("Folder")
		crowd.Name = "Crowd"
		crowd.Parent = model
		local plot = { index = i, origin = origin, model = model, stadium = stadium, crowd = crowd, owner = nil }
		plots[i] = plot
		setFreeSign(plot)
	end
end

function PlotService.Assign(player)
	if playerPlot[player] then
		return playerPlot[player]
	end
	for _, plot in ipairs(plots) do
		if not plot.owner then
			plot.owner = player
			plot.model:SetAttribute("OwnerUserId", player.UserId)
			plot.model:SetAttribute("OwnerName", player.DisplayName)
			playerPlot[player] = plot
			setFreeSign(plot)
			InteractionService.EnsureBall(plot, player) -- balón jugable en el campo
			HalloweenService.SetupPlot(plot) -- caramelos y calabazas (solo durante el evento)
			return plot
		end
	end
	return nil
end

function PlotService.Release(player)
	local plot = playerPlot[player]
	if not plot then
		return
	end
	playerPlot[player] = nil
	pendingRender[player] = nil
	plot.owner = nil
	plot.model:SetAttribute("OwnerUserId", nil)
	plot.model:SetAttribute("OwnerName", nil)
	plot.stadium:ClearAllChildren()
	plot.crowd:ClearAllChildren()
	plot.crowdKey = nil
	InteractionService.RemoveBall(plot)
	HalloweenService.ClearPlot(plot)
	setFreeSign(plot)
end

function PlotService.GetPlot(player)
	return playerPlot[player]
end

local function readableText(color)
	local luminance = 0.299 * color.R + 0.587 * color.G + 0.114 * color.B
	return luminance > 0.6 and Color3.fromRGB(20, 20, 25) or Color3.fromRGB(250, 250, 250)
end

function PlotService.BuildRenderInfo(player, data)
	local appearance = ClubService.EffectiveAppearance(player, data)
	local palette = CosmeticConfig.ById.palette[appearance.palette]
	local crest = CosmeticConfig.ById.crest[appearance.crest]
	local kit = CosmeticConfig.ById.kit[appearance.kit]
	local stage = StadiumStages.Get(data.stadium.stage)
	return {
		facilities = data.stadium.facilities,
		appearance = appearance,
		primary = palette.primary,
		secondary = palette.secondary,
		secondaryText = readableText(palette.primary),
		crestSymbol = crest.symbol,
		kitPattern = kit.pattern,
		clubName = ClubService.DisplayName(data),
		shortName = ClubService.ShortName(data),
		ownerName = player.DisplayName,
		stage = stage.stage,
		stageName = stage.name,
		stageVisual = stage.visual,
		trophyCount = #data.trophies,
		trophies = data.trophies,
		-- Pases de la FASE 11 (solo visuales; dependen de la propiedad confirmada por Roblox)
		eliteStadium = GamePassService.Owns(player, "ELITE_STADIUM"),
		eliteAcademy = GamePassService.Owns(player, "ELITE_ACADEMY"),
		clubLegends = GamePassService.Owns(player, "CLUB_LEGENDS"),
		legends = data.legends,
		lastMatch = data.matches[#data.matches],
		vip = ClubService.IsVip(player),
		decorations = data.stadium.decorations,
		pieces = data.stadium.pieces, -- construcción libre
		freeBuild = data.stadium.freeBuild,
		sponsors = {
			shirt = data.sponsors.contracts.shirt and data.sponsors.contracts.shirt.brand or nil,
			boards = data.sponsors.contracts.boards and data.sponsors.contracts.boards.brand or nil,
			naming = data.sponsors.contracts.naming and data.sponsors.contracts.naming.brand or nil,
		},
		decorationVisible = BuildService.DecorationVisibility(player, data),
	}
end

local function updateNameTag(player, data)
	local character = player.Character
	local head = character and character:FindFirstChild("Head")
	if not head or not data then
		return
	end
	local tag = head:FindFirstChild("FEU_Tag")
	if not tag then
		tag = Instance.new("BillboardGui")
		tag.Name = "FEU_Tag"
		tag.Size = UDim2.fromOffset(220, 66)
		tag.StudsOffset = Vector3.new(0, 2.6, 0)
		tag.MaxDistance = 80
		tag.Parent = head
		local layout = Instance.new("UIListLayout")
		layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
		layout.Parent = tag
	end
	tag:ClearAllChildren()
	local layout = Instance.new("UIListLayout")
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	layout.Parent = tag
	local info = PlotService.BuildRenderInfo(player, data)
	if info.vip then
		local vip = Instance.new("TextLabel")
		vip.Size = UDim2.new(0, 70, 0.3, 0)
		vip.BackgroundColor3 = Color3.fromRGB(255, 200, 70)
		vip.TextColor3 = Color3.fromRGB(40, 25, 0)
		vip.Font = Enum.Font.GothamBlack
		vip.TextScaled = true
		vip.Text = "👑 VIP"
		vip.Parent = tag
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0.4, 0)
		corner.Parent = vip
	end
	-- Rango del camino de trofeos (y renacimientos)
	local rank = TrophyConfig.Rank(data.arena and data.arena.trophies or 0)
	local badge = Instance.new("TextLabel")
	badge.Size = UDim2.new(1, 0, 0.28, 0)
	badge.BackgroundTransparency = 1
	badge.TextColor3 = rank.color
	badge.TextStrokeTransparency = 0.3
	badge.Font = Enum.Font.GothamBlack
	badge.TextScaled = true
	local rebirths = data.rebirth and data.rebirth.count or 0
	badge.Text = string.format("%s %s · %d🏆%s", rank.icon, rank.name, data.arena and data.arena.trophies or 0,
		rebirths > 0 and string.format("  🔄%d", rebirths) or "")
	badge.Parent = tag
	local club = Instance.new("TextLabel")
	club.Size = UDim2.new(1, 0, 0.4, 0)
	club.BackgroundTransparency = 1
	club.TextColor3 = Color3.fromRGB(255, 255, 255)
	club.TextStrokeTransparency = 0.4
	club.Font = Enum.Font.GothamBold
	club.TextScaled = true
	club.Text = info.crestSymbol .. " " .. info.clubName
	club.Parent = tag
end

-- Afición en las gradas: solo se reconstruye cuando cambia la ocupación (en tramos del 10 %)
-- o el tamaño/colores de las gradas, para no recrear piezas en cada jornada.
function PlotService.UpdateCrowd(player, occupancy)
	local plot = playerPlot[player]
	local data = DataService.Get(player)
	if not plot or not data then
		return
	end
	occupancy = math.clamp(tonumber(occupancy) or 0, 0, 1)
	local info = PlotService.BuildRenderInfo(player, data)
	-- En modo libre no hay gradas automáticas, así que tampoco su afición
	local standsLevel = data.stadium.freeBuild and 0 or (data.stadium.facilities.stands or 1)
	local key = string.format("%d|%d|%s|%s", math.floor(occupancy * 10 + 0.5), standsLevel, info.appearance.palette, tostring(info.stageVisual and info.stageVisual.corners))
	if plot.crowdKey == key then
		return
	end
	plot.crowdKey = key
	local ok, err = pcall(StadiumRenderer.RenderCrowd, plot.crowd, plot.origin, standsLevel, math.floor(occupancy * 10 + 0.5) / 10, info)
	if not ok then
		warn("[PlotService] Error dibujando la afición de ", player.Name, ": ", err)
	end
end

function PlotService.Render(player)
	local plot = playerPlot[player]
	local data = DataService.Get(player)
	if not plot or not data then
		return
	end
	local ok, err = pcall(function()
		local info = PlotService.BuildRenderInfo(player, data)
		StadiumRenderer.Render(plot.stadium, plot.origin, info)
		InteractionService.Attach(plot, player, info.clubName) -- indicaciones E/F en las instalaciones
	end)
	if not ok then
		warn("[PlotService] Error construyendo el estadio de ", player.Name, ": ", err)
	end
	updateNameTag(player, data)
	plot.crowdKey = nil
	local last = data.economy.lastCycle
	PlotService.UpdateCrowd(player, last and last.occupancy or 0)
end

-- Agrupa varios cambios seguidos en una sola reconstrucción.
function PlotService.RequestRender(player)
	if pendingRender[player] then
		return
	end
	pendingRender[player] = true
	task.delay(0.25, function()
		if pendingRender[player] then
			pendingRender[player] = nil
			if player.Parent then
				PlotService.Render(player)
			end
		end
	end)
end

function PlotService.TeleportHome(player)
	local plot = playerPlot[player]
	local character = player.Character
	if not plot or not character or not character:FindFirstChild("HumanoidRootPart") then
		return false, "No se pudo teletransportar ahora."
	end
	character:PivotTo(plot.origin * StadiumRenderer.SpawnOffset)
	return true, "Bienvenido a tu estadio."
end

-- Vuelve a dibujar el cartel sobre la cabeza (p. ej. al cambiar los trofeos o los renacimientos)
function PlotService.RefreshNameTag(player)
	updateNameTag(player, DataService.Get(player))
end

function PlotService.CharacterAdded(player)
	task.wait(0.2)
	if DataService.Get(player) then
		PlotService.TeleportHome(player)
		updateNameTag(player, DataService.Get(player))
	end
end

return PlotService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000040"><Properties><string name="Name">RebirthService</string><ProtectedString name="Source"><![CDATA[-- RebirthService (ModuleScript)
-- Ubicación: ServerScriptService/Server/Services/RebirthService
--
-- RENACIMIENTOS. El servidor comprueba los requisitos (etapa del estadio y dinero) y aplica el
-- reinicio: dinero, deuda, afición, instalaciones y etapa del estadio vuelven al principio.
-- Se conserva todo lo demás. Los bonus (ingresos, partidos, huecos de mascota…) se calculan a
-- partir del número de renacimientos guardado, así que no hay nada más que «dar».

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local RebirthConfig = require(Shared.Config.RebirthConfig)
local FacilityConfig = require(Shared.Config.FacilityConfig)
local GameConfig = require(Shared.Config.GameConfig)
local Remotes = require(Shared.Modules.Remotes)

local DataService = require(script.Parent.DataService)
local EconomyService = require(script.Parent.EconomyService)
local StadiumService = require(script.Parent.StadiumService)

local RebirthService = {}

local notifyRemote = Remotes.Get("Notify")

function RebirthService.Count(player)
	local data = DataService.Get(player)
	return data and data.rebirth.count or 0
end

function RebirthService.Rebirth(player, payload)
	local data = DataService.Get(player)
	if type(payload) ~= "table" or payload.confirm ~= true then
		return false, "Confirma el renacimiento."
	end
	local count = data.rebirth.count
	if count >= RebirthConfig.MAX then
		return false, string.format("Has llegado al máximo de %d renacimientos.", RebirthConfig.MAX)
	end
	local requirement = RebirthConfig.Requirement(count)
	if data.stadium.stage < requirement.stage then
		return false, string.format("Necesitas el estadio en la etapa %d (ahora estás en la %d).", requirement.stage, data.stadium.stage)
	end
	if data.economy.money < requirement.money then
		return false, string.format("Necesitas %d %s para renacer.", requirement.money, GameConfig.CURRENCY)
	end
	if data.economy.debt > 0 then
		return false, "Paga tu deuda antes de renacer."
	end

	-- Reinicio del estadio y de la economía
	local economy = data.economy
	local spent = economy.money
	economy.money = GameConfig.STARTING_MONEY
	economy.debt = 0
	EconomyService.AddTransaction(data, -spent, EconomyService.Category.REBIRTH, string.format("Renacimiento %d", count + 1))
	local facilities = {}
	for id, def in pairs(FacilityConfig.Facilities) do
		if def.startLevel > 0 then
			facilities[id] = def.startLevel
		end
	end
	data.stadium.facilities = facilities
	data.stadium.stage = 1
	data.club.fans = GameConfig.STARTING_FANS
	data.club.members = 0
	data.club.satisfaction = GameConfig.SATISFACTION_START

	data.rebirth.count = count + 1
	data.rebirth.lastAt = os.time()
	if data.rebirth.count >= RebirthConfig.BALL_AT then
		data.collection.balls[RebirthConfig.BALL] = true
	end
	StadiumService.LogEvent(data, "rebirth", { count = data.rebirth.count })
	notifyRemote:FireAllClients("info", string.format("🔄 %s ha renacido por %d.ª vez", player.DisplayName, data.rebirth.count))
	return true, string.format("🔄 ¡Renacimiento %d! Ahora ganas +%d %% en cada jornada y +%d %% en los partidos.",
		data.rebirth.count, math.floor(RebirthConfig.IncomeBonus(data.rebirth.count) * 100 + 0.5),
		math.floor(RebirthConfig.ArenaBonus(data.rebirth.count) * 100 + 0.5)), true
end

function RebirthService.BuildState(data)
	local count = data.rebirth.count
	return {
		count = count,
		max = RebirthConfig.MAX,
		next = count < RebirthConfig.MAX and RebirthConfig.Requirement(count) or nil,
	}
end

return RebirthService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000041"><Properties><string name="Name">RewardService</string><ProtectedString name="Source"><![CDATA[-- RewardService (ModuleScript)
-- Ubicación: ServerScriptService/Server/Services/RewardService
--
-- RECOMPENSA DIARIA con racha y CÓDIGOS DE REGALO. Todo se decide en el servidor:
--   * La diaria se puede reclamar una vez por día (UTC). Si entras días seguidos la racha sube;
--     si te saltas un día, vuelve al día 1.
--   * Cada código se canjea una sola vez por jugador y solo si existe en RewardConfig.Codes.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local RewardConfig = require(ReplicatedStorage.Shared.Config.RewardConfig)

local DataService = require(script.Parent.DataService)
local EconomyService = require(script.Parent.EconomyService)
local PetService = require(script.Parent.PetService)
local SeasonService = require(script.Parent.SeasonService)

local RewardService = {}

local function today()
	return math.floor(os.time() / 86400)
end

-- Racha que tendría el jugador si reclamara hoy
local function nextStreak(rewards)
	if rewards.lastClaimDay == today() - 1 then
		return rewards.streak + 1
	end
	return 1
end

local function grant(player, reward, note)
	local got = {}
	if reward.crate then
		table.insert(got, PetService.GrantBall(player, reward.crate) or "📦 Ya tienes todos los balones de las cajas")
	end
	if reward.money then
		EconomyService.Earn(player, reward.money, EconomyService.Category.PRIZE, note)
		table.insert(got, string.format("💰 +%d $", reward.money))
	end
	if reward.egg then
		table.insert(got, PetService.GrantEgg(player, reward.egg) or "🥚 Huevo")
	end
	if reward.xp then
		SeasonService.AddXP(player, reward.xp)
		table.insert(got, string.format("🎟️ +%d puntos del pase", reward.xp))
	end
	return table.concat(got, " · ")
end

function RewardService.ClaimDaily(player)
	local data = DataService.Get(player)
	local rewards = data.rewards
	if rewards.lastClaimDay >= today() then
		return false, "Ya has reclamado la recompensa de hoy. ¡Vuelve mañana!"
	end
	local streak = nextStreak(rewards)
	local day = RewardConfig.DayOf(streak)
	rewards.streak = streak
	rewards.lastClaimDay = today()
	local text = grant(player, RewardConfig.Daily[day], "Recompensa diaria")
	return true, string.format("🎁 Día %d de racha: %s", day, text)
end

function RewardService.RedeemCode(player, payload)
	local data = DataService.Get(player)
	local code = type(payload) == "table" and payload.code
	if type(code) ~= "string" or #code > RewardConfig.MAX_CODE_LENGTH then
		return false, "Código no válido."
	end
	code = string.upper((code:gsub("%s", "")))
	local reward = RewardConfig.Codes[code]
	if not reward then
		return false, "Ese código no existe."
	end
	if reward.expires and os.time() > reward.expires then
		return false, "Ese código ha caducado."
	end
	if data.rewards.codes[code] then
		return false, "Ya has canjeado ese código."
	end
	data.rewards.codes[code] = true
	return true, string.format("🎁 Código %s canjeado: %s", code, grant(player, reward, "Código " .. code))
end

-- RULETA: el servidor elige el premio (por peso) y lo entrega; el cliente solo anima el giro.
local rng = Random.new()

function RewardService.Spin(player)
	local data = DataService.Get(player)
	local rewards = data.rewards
	if rewards.lastSpinDay >= today() then
		return false, "Ya has girado la ruleta hoy. ¡Vuelve mañana!"
	end
	local total = 0
	for _, segment in ipairs(RewardConfig.Wheel) do
		total += segment.weight
	end
	local roll = rng:NextNumber(0, total)
	local index = #RewardConfig.Wheel
	for i, segment in ipairs(RewardConfig.Wheel) do
		roll -= segment.weight
		if roll < 0 then
			index = i
			break
		end
	end
	rewards.lastSpinDay = today()
	local text = grant(player, RewardConfig.Wheel[index], "Ruleta de la suerte")
	return true, "🎡 Ruleta: " .. text, false, { index = index }
end

function RewardService.BuildState(data)
	local rewards = data.rewards
	local canClaim = rewards.lastClaimDay < today()
	local streak = canClaim and nextStreak(rewards) or rewards.streak
	return {
		canClaim = canClaim,
		streak = streak,
		day = RewardConfig.DayOf(streak), -- día (1-7) de la recompensa de hoy
		canSpin = rewards.lastSpinDay < today(),
	}
end

return RewardService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000042"><Properties><string name="Name">SeasonService</string><ProtectedString name="Source"><![CDATA[-- SeasonService (ModuleScript)
-- Ubicación: ServerScriptService/Server/Services/SeasonService
--
-- PASE DE TEMPORADA.
--   * Los puntos los concede SOLO el servidor a partir de lo que haces de verdad (partidos,
--     misiones, huevos, jornadas, conexión diaria).
--   * Reclamar: el servidor comprueba el nivel, que no esté ya reclamado y, en la pista premium,
--     que tengas el premium de ESTA temporada.
--   * PREMIUM: se vende con un Developer Product. Solo se activa cuando Roblox entrega el recibo
--     de compra (ProcessReceipt) y los datos se han guardado. Nunca se simula una compra, y si el
--     ID del producto es 0 («pendiente de configuración») la compra está desactivada.

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local SeasonConfig = require(Shared.Config.SeasonConfig)
local WeeklyConfig = require(Shared.Config.WeeklyConfig)
local Remotes = require(Shared.Modules.Remotes)

local DataService = require(script.Parent.DataService)
local EconomyService = require(script.Parent.EconomyService)
local PetService = require(script.Parent.PetService)

local SeasonService = {}

local notifyRemote = Remotes.Get("Notify")
local MAX_XP = SeasonConfig.TIERS * SeasonConfig.XP_PER_TIER
local priceCache = nil -- { time, price }
local changedCallbacks = {}

local function configured()
	return type(SeasonConfig.PREMIUM_PRODUCT_ID) == "number" and SeasonConfig.PREMIUM_PRODUCT_ID > 0
end

-- Si ha empezado una temporada nueva, el progreso empieza de cero (el premium va por temporada).
local function ensureSeason(data)
	local current = SeasonConfig.Current()
	local pass = data.pass
	if pass.season ~= current.number then
		pass.season = current.number
		pass.xp = 0
		pass.claimedFree = {}
		pass.claimedPremium = {}
	end
	return current, pass
end

local function isPremium(pass, current)
	return pass.premiumSeason == current.number
end

local function fireChanged(player)
	for _, callback in ipairs(changedCallbacks) do
		task.spawn(callback, player)
	end
end

-- Avisa cuando el pase cambia fuera de una acción (compra premium confirmada, subida de nivel).
function SeasonService.OnChanged(callback)
	table.insert(changedCallbacks, callback)
end

-- ===== Puntos =====

function SeasonService.AddXP(player, amount)
	local data = DataService.Get(player)
	if not data or type(amount) ~= "number" or amount <= 0 then
		return
	end
	local _, pass = ensureSeason(data)
	local multiplier = WeeklyConfig.ActiveBonus().xpMultiplier or 1
	local before = SeasonConfig.Level(pass.xp)
	pass.xp = math.min(MAX_XP, pass.xp + math.floor(amount * multiplier + 0.5))
	local after = SeasonConfig.Level(pass.xp)
	if after > before then
		notifyRemote:FireClient(player, "success", string.format("🎟️ ¡Nivel %d del pase de temporada! Tienes recompensas por reclamar.", after))
	end
end

-- Puntos por la primera conexión de cada día (UTC).
function SeasonService.DailyLogin(player)
	local data = DataService.Get(player)
	if not data then
		return
	end
	local _, pass = ensureSeason(data)
	local today = math.floor(os.time() / 86400)
	if pass.lastLoginDay ~= today then
		pass.lastLoginDay = today
		SeasonService.AddXP(player, SeasonConfig.XP.dailyLogin)
	end
end

-- ===== Recompensas =====

local function grant(player, data, reward)
	if reward.type == "money" then
		EconomyService.Earn(player, reward.amount, EconomyService.Category.PRIZE, "Pase de temporada")
		return string.format("💰 +%d $", reward.amount)
	elseif reward.type == "egg" then
		return PetService.GrantEgg(player, reward.egg) or "🥚 Huevo"
	elseif reward.type == "crate" then
		return PetService.GrantBall(player, reward.crate) or "📦 Ya tienes todos los balones de las cajas"
	elseif reward.type == "ball" then
		data.collection.balls[reward.id] = true
		return SeasonConfig.Describe(reward)
	elseif reward.type == "outfit" then
		data.collection.outfits[reward.id] = true
		return SeasonConfig.Describe(reward)
	end
	return "?"
end

-- Reclama una recompensa si procede. Devuelve el texto de lo conseguido o nil + motivo.
local function claimOne(player, data, current, pass, tier, track)
	local rewards = SeasonConfig.Rewards(current.number)[tier]
	local reward = rewards and rewards[track]
	if not reward then
		return nil, "Esa recompensa no existe."
	end
	if tier > SeasonConfig.Level(pass.xp) then
		return nil, string.format("Todavía no has llegado al nivel %d del pase.", tier)
	end
	local claimed = track == "premium" and pass.claimedPremium or pass.claimedFree
	local key = tostring(tier)
	if claimed[key] then
		return nil, "Ya has reclamado esa recompensa."
	end
	if track == "premium" and not isPremium(pass, current) then
		return nil, "Esa recompensa es de la pista premium de esta temporada."
	end
	claimed[key] = true
	return grant(player, data, reward)
end

function SeasonService.Claim(player, payload)
	local data = DataService.Get(player)
	if type(payload) ~= "table" then
		return false, "Solicitud no válida."
	end
	local tier = tonumber(payload.tier)
	if not tier or tier ~= math.floor(tier) or tier < 1 or tier > SeasonConfig.TIERS then
		return false, "Nivel no válido."
	end
	local track = payload.track == "premium" and "premium" or "free"
	local current, pass = ensureSeason(data)
	local text, reason = claimOne(player, data, current, pass, tier, track)
	if not text then
		return false, reason
	end
	return true, string.format("🎟️ Nivel %d: %s", tier, text)
end

function SeasonService.ClaimAll(player)
	local data = DataService.Get(player)
	local current, pass = ensureSeason(data)
	local count = 0
	for tier = 1, SeasonConfig.Level(pass.xp) do
		for _, track in ipairs({ "free", "premium" }) do
			if claimOne(player, data, current, pass, tier, track) then
				count += 1
			end
		end
	end
	if count == 0 then
		return false, "No tienes recompensas del pase por reclamar."
	end
	return true, string.format("🎟️ Has reclamado %d recompensa%s del pase. Mira tus mascotas, balones y trajes.", count, count == 1 and "" or "s")
end

-- ===== Premium (Developer Product) =====

local function price()
	if not configured() then
		return nil
	end
	if priceCache and os.clock() - priceCache.time < 300 then
		return priceCache.price
	end
	local ok, info = pcall(function()
		return MarketplaceService:GetProductInfo(SeasonConfig.PREMIUM_PRODUCT_ID, Enum.InfoType.Product)
	end)
	priceCache = { time = os.clock(), price = ok and type(info) == "table" and info.PriceInRobux or nil }
	return priceCache.price
end

function SeasonService.RequestPremium(player)
	local data = DataService.Get(player)
	if not configured() then
		return false, "El premium del pase está pendiente de configuración: todavía no tiene un producto de Roblox."
	end
	local current, pass = ensureSeason(data)
	if isPremium(pass, current) then
		return false, "Ya tienes el premium de esta temporada."
	end
	local ok, err = pcall(function()
		MarketplaceService:PromptProductPurchase(player, SeasonConfig.PREMIUM_PRODUCT_ID)
	end)
	if not ok then
		warn("[SeasonService] PromptProductPurchase falló: ", err)
		return false, "Roblox no pudo abrir la ventana de compra. Inténtalo más tarde."
	end
	return true, "Abriendo la compra de Roblox…"
end

-- Roblox llama a esta función cuando una compra se ha pagado de verdad.
local function processReceipt(receipt)
	local player = Players:GetPlayerByUserId(receipt.PlayerId)
	local data = player and DataService.Get(player)
	if not data then
		return Enum.ProductPurchaseDecision.NotProcessedYet -- se reintentará cuando el jugador vuelva
	end
	if not configured() or receipt.ProductId ~= SeasonConfig.PREMIUM_PRODUCT_ID then
		return Enum.ProductPurchaseDecision.NotProcessedYet -- producto desconocido: no se da por entregado
	end
	local current, pass = ensureSeason(data)
	local receiptId = tostring(receipt.PurchaseId)
	if not pass.receipts[receiptId] then
		pass.receipts[receiptId] = os.time()
		pass.premiumSeason = current.number
		notifyRemote:FireClient(player, "success", string.format("¡Compra confirmada! 💎 Pista premium de la %s activada.", current.theme.name))
		fireChanged(player)
	end
	-- Solo se da por entregada cuando el progreso está guardado
	if not DataService.IsSaveEnabled(player) or not DataService.Save(player, false) then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

-- ===== Estado =====

function SeasonService.BuildState(data)
	local current, pass = ensureSeason(data)
	local free, premium = {}, {}
	for tier = 1, SeasonConfig.TIERS do
		free[tier] = pass.claimedFree[tostring(tier)] == true
		premium[tier] = pass.claimedPremium[tostring(tier)] == true
	end
	return {
		number = current.number,
		themeId = current.theme.id,
		name = current.theme.name,
		icon = current.theme.icon,
		endsAt = current.endsAt,
		xp = pass.xp,
		level = SeasonConfig.Level(pass.xp),
		premium = isPremium(pass, current),
		productConfigured = configured(),
		price = price(),
		claimedFree = free,
		claimedPremium = premium,
	}
end

function SeasonService.Start()
	MarketplaceService.ProcessReceipt = processReceipt
end

return SeasonService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000043"><Properties><string name="Name">SponsorService</string><ProtectedString name="Source"><![CDATA[-- SponsorService (ModuleScript)
-- Ubicación: ServerScriptService/Server/Services/SponsorService
--
-- Contratos de patrocinio (FASE 3):
--   * Ofertas generadas en el SERVIDOR según reputación y aficionados, guardadas en los
--     datos (no se pueden "volver a tirar" saliendo y entrando).
--   * Aceptar: cobra la prima de fichaje y empieza a pagar en cada jornada (EconomyFormulas).
--   * Objetivo del contrato evaluado con datos reales en cada jornada (+25 % si se cumple).
--   * Rescindir: penalización. Al terminar la duración, el contrato expira.
-- Todas las marcas son ficticias (SponsorConfig).

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local GameConfig = require(Shared.Config.GameConfig)
local SponsorConfig = require(Shared.Config.SponsorConfig)
local EconomyFormulas = require(Shared.Modules.EconomyFormulas)

local DataService = require(script.Parent.DataService)
local EconomyService = require(script.Parent.EconomyService)
local StadiumService = require(script.Parent.StadiumService)

local SponsorService = {}

local rng = Random.new()

local function brandName()
	local prefix = SponsorConfig.BrandPrefixes[rng:NextInteger(1, #SponsorConfig.BrandPrefixes)]
	local suffix = SponsorConfig.BrandSuffixes[rng:NextInteger(1, #SponsorConfig.BrandSuffixes)]
	return prefix .. " " .. suffix
end

local function makeObjective(data)
	local def = SponsorConfig.Objectives[rng:NextInteger(1, #SponsorConfig.Objectives)]
	if def.id == "occupancy" then
		return { type = "occupancy", target = rng:NextInteger(60, 95) / 100 }
	elseif def.id == "satisfaction" then
		return { type = "satisfaction", target = rng:NextInteger(50, 80) }
	end
	local members = math.max(20, data.club.members or 0)
	return { type = "members", target = math.floor(members * (1 + rng:NextInteger(5, 30) / 100)) }
end

function SponsorService.OfferValue(data, slot)
	local reputation = EconomyFormulas.Reputation(data)
	local base = SponsorConfig.BASE_VALUE + reputation * SponsorConfig.PER_REPUTATION
		+ math.sqrt(math.max(0, data.club.fans)) * SponsorConfig.PER_SQRT_FAN
	return base * slot.value
end

local function generateOffers(data, slot)
	local offers = {}
	local value = SponsorService.OfferValue(data, slot)
	for i = 1, SponsorConfig.OFFERS_PER_SLOT do
		local payment = math.floor(value * (SponsorConfig.RANDOM_MIN + rng:NextNumber() * (SponsorConfig.RANDOM_MAX - SponsorConfig.RANDOM_MIN)))
		local duration = rng:NextInteger(SponsorConfig.DURATION_MIN, SponsorConfig.DURATION_MAX)
		table.insert(offers, {
			id = string.format("%s-%d-%d", slot.id, data.stats.cycles, i),
			brand = brandName(),
			payment = payment,
			bonus = payment * rng:NextInteger(SponsorConfig.SIGNING_BONUS_MIN, SponsorConfig.SIGNING_BONUS_MAX),
			duration = duration,
			objective = makeObjective(data),
		})
	end
	return offers
end

function SponsorService.SlotUnlocked(data, slot)
	return (data.stadium.stage or 1) >= slot.minStage
end

-- Renueva las ofertas de los huecos libres cuando toca (o si no hay ninguna).
function SponsorService.RefreshOffers(data, force)
	local sponsors = data.sponsors
	local due = force or data.stats.cycles >= sponsors.nextRefresh
	for _, slot in ipairs(SponsorConfig.Slots) do
		local empty = sponsors.offers[slot.id] == nil or #sponsors.offers[slot.id] == 0
		if SponsorService.SlotUnlocked(data, slot) and not sponsors.contracts[slot.id] and (due or empty) then
			sponsors.offers[slot.id] = generateOffers(data, slot)
		end
	end
	if due then
		sponsors.nextRefresh = data.stats.cycles + SponsorConfig.OFFER_REFRESH_CYCLES
	end
end

function SponsorService.Accept(player, payload)
	local data = DataService.Get(player)
	if type(payload) ~= "table" or type(payload.slot) ~= "string" or type(payload.offer) ~= "string" then
		return false, "Solicitud no válida."
	end
	local slot = SponsorConfig.Slot(payload.slot)
	if not slot then
		return false, "Ese hueco de patrocinio no existe."
	end
	if not SponsorService.SlotUnlocked(data, slot) then
		return false, string.format("Este hueco se desbloquea en la etapa %d del estadio.", slot.minStage)
	end
	if data.sponsors.contracts[slot.id] then
		return false, "Ya tienes un contrato en este hueco."
	end
	local chosen
	for _, offer in ipairs(data.sponsors.offers[slot.id] or {}) do
		if offer.id == payload.offer then
			chosen = offer
		end
	end
	if not chosen then
		return false, "Esa oferta ya no está disponible."
	end
	data.sponsors.contracts[slot.id] = {
		brand = chosen.brand,
		payment = chosen.payment,
		objective = chosen.objective,
		cyclesLeft = chosen.duration,
		duration = chosen.duration,
		signedAt = os.time(),
	}
	data.sponsors.offers[slot.id] = {}
	EconomyService.Earn(player, chosen.bonus, EconomyService.Category.SPONSOR, "Prima de fichaje: " .. chosen.brand)
	StadiumService.LogEvent(data, "sponsor_signed", { slot = slot.id, brand = chosen.brand, payment = chosen.payment })
	return true, string.format("🤝 Contrato firmado con %s (%s). Prima: %d %s.", chosen.brand, slot.name, chosen.bonus, GameConfig.CURRENCY)
end

function SponsorService.TerminationPenalty(contract)
	return contract.payment * SponsorConfig.TERMINATION_PENALTY
end

function SponsorService.Terminate(player, payload)
	local data = DataService.Get(player)
	local slotId = type(payload) == "table" and payload.slot
	local contract = type(slotId) == "string" and data.sponsors.contracts[slotId]
	if not contract then
		return false, "No hay contrato en ese hueco."
	end
	local penalty = SponsorService.TerminationPenalty(contract)
	local paid, err = EconomyService.Spend(player, penalty, EconomyService.Category.SPONSOR, "Rescisión: " .. contract.brand)
	if not paid then
		return false, "No puedes pagar la penalización (" .. penalty .. " " .. GameConfig.CURRENCY .. "): " .. tostring(err)
	end
	data.sponsors.contracts[slotId] = nil
	StadiumService.LogEvent(data, "sponsor_terminated", { slot = slotId, brand = contract.brand })
	SponsorService.RefreshOffers(data, false)
	return true, "Contrato con " .. contract.brand .. " rescindido."
end

-- Se llama después de cada jornada: descuenta duración y expira contratos.
-- Devuelve una lista de mensajes para el jugador.
function SponsorService.AfterCycle(player)
	local data = DataService.Get(player)
	if not data then
		return {}
	end
	local messages = {}
	for slotId, contract in pairs(data.sponsors.contracts) do
		contract.cyclesLeft -= 1
		if contract.cyclesLeft <= 0 then
			data.sponsors.contracts[slotId] = nil
			StadiumService.LogEvent(data, "sponsor_expired", { slot = slotId, brand = contract.brand })
			table.insert(messages, "El contrato con " .. contract.brand .. " ha terminado. Tienes nuevas ofertas en Economía › Patrocinios.")
		end
	end
	SponsorService.RefreshOffers(data, false)
	return messages
end

function SponsorService.PlayerReady(player)
	local data = DataService.Get(player)
	if data then
		SponsorService.RefreshOffers(data, false)
	end
end

return SponsorService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000044"><Properties><string name="Name">SquadService</string><ProtectedString name="Source"><![CDATA[-- SquadService (ModuleScript)
-- Ubicación: ServerScriptService/Server/Services/SquadService
--
-- FASE 4: plantilla, contratos, entrenamiento y CANTERA GENERACIONAL.
--   * Evolución por jornada según potencial, edad, entrenamiento e instalaciones.
--   * Temporadas: edad, contratos, retiradas, leyendas y nueva hornada de juveniles.
--   * Ojeadores: mejoran el potencial de la cantera, la precisión del potencial
--     estimado y traen informes con juveniles que se pueden fichar.
-- Todo se valida aquí; el cliente solo envía intenciones con IDs de SUS jugadores.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local GameConfig = require(Shared.Config.GameConfig)
local FootballConfig = require(Shared.Config.FootballConfig)
local FootballFormulas = require(Shared.Modules.FootballFormulas)
local UniverseConfig = require(Shared.Config.UniverseConfig)

local DataService = require(script.Parent.DataService)
local EconomyService = require(script.Parent.EconomyService)
local StadiumService = require(script.Parent.StadiumService)
local PlayerFactory = require(script.Parent.Parent.Util.PlayerFactory)
local GamePassService = require(script.Parent.GamePassService)
local ClubService = require(script.Parent.ClubService)

local SquadService = {}

local rng = Random.new()

local function findIn(list, id)
	if type(id) ~= "string" then
		return nil
	end
	for index, p in ipairs(list) do
		if p.id == id then
			return p, index
		end
	end
	return nil
end
SquadService.FindIn = findIn

local function activeCount(data)
	local n = 0
	for _, p in ipairs(data.squad) do
		if not (p.loan and p.loan.type == "out") then
			n += 1
		end
	end
	return n
end

local function academyLevel(data)
	return data.stadium.facilities.academy or 0
end

function SquadService.EnsureSquad(data)
	if #data.squad == 0 then
		data.squad = PlayerFactory.StartingSquad(data)
	end
	if #data.academy.youths == 0 and data.academy.seededIntake ~= true then
		local level = academyLevel(data)
		for _ = 1, FootballConfig.Academy(level).intake + 1 do
			table.insert(data.academy.youths, PlayerFactory.Youth(data, level, data.academy.scouts))
		end
		data.academy.seededIntake = true
	end
end

-- ===== Acciones =====

function SquadService.SetIntensity(player, payload)
	local data = DataService.Get(player)
	local id = type(payload) == "table" and payload.intensity
	for _, option in ipairs(FootballConfig.TrainingIntensities) do
		if option.id == id then
			data.training.intensity = option.id
			return true, "Entrenamiento: " .. option.name
		end
	end
	return false, "Intensidad no válida."
end

function SquadService.SetFocus(player, payload)
	local data = DataService.Get(player)
	if type(payload) ~= "table" then
		return false, "Solicitud no válida."
	end
	local target = findIn(data.squad, payload.id) or findIn(data.academy.youths, payload.id)
	if not target then
		return false, "Ese jugador no es de tu club."
	end
	if payload.focus == nil or payload.focus == "" then
		target.focus = nil
		return true, target.name .. ": entrenamiento equilibrado."
	end
	for _, attr in ipairs(FootballConfig.Attributes) do
		if attr.id == payload.focus then
			target.focus = attr.id
			return true, string.format("%s: entrenamiento centrado en %s.", target.name, attr.name)
		end
	end
	return false, "Atributo no válido."
end

function SquadService.Renew(player, payload)
	local data = DataService.Get(player)
	local target = type(payload) == "table" and findIn(data.squad, payload.id)
	if not target then
		return false, "Ese jugador no es de tu plantilla."
	end
	local years = tonumber(type(payload) == "table" and payload.years)
	if not years or years ~= math.floor(years) or years < 1 or years > FootballConfig.CONTRACT_MAX_SEASONS then
		return false, "Duración no válida."
	end
	if target.loan then
		return false, "No se puede renovar a un jugador cedido."
	end
	if target.contract > FootballConfig.RENEW_WINDOW then
		return false, string.format("Solo se puede renovar cuando quedan %d temporadas o menos.", FootballConfig.RENEW_WINDOW)
	end
	if target.age >= FootballConfig.RETIRE_FORCED_AGE - 1 and years > 1 then
		return false, "Por su edad, solo acepta renovar 1 temporada."
	end
	local demand = FootballFormulas.SalaryDemand(target)
	target.salary = demand
	target.contract = years
	return true, string.format("%s renueva %d temporada(s) por %d %s/jornada.", target.name, years, demand, GameConfig.CURRENCY)
end

function SquadService.Release(player, payload)
	local data = DataService.Get(player)
	local target, index = findIn(data.squad, type(payload) == "table" and payload.id)
	if not target then
		return false, "Ese jugador no es de tu plantilla."
	end
	if target.loan then
		return false, "No se puede rescindir a un jugador cedido."
	end
	if activeCount(data) <= FootballConfig.MIN_SQUAD then
		return false, string.format("Necesitas al menos %d jugadores en la plantilla.", FootballConfig.MIN_SQUAD)
	end
	local cost = FootballFormulas.ReleaseCost(target)
	local paid, err = EconomyService.Spend(player, cost, EconomyService.Category.WAGES, "Rescisión: " .. target.name)
	if not paid then
		return false, "No puedes pagar la rescisión (" .. cost .. " " .. GameConfig.CURRENCY .. "): " .. tostring(err)
	end
	table.remove(data.squad, index)
	StadiumService.LogEvent(data, "player_released", { name = target.name, ovr = FootballFormulas.OverallInt(target) })
	return true, target.name .. " deja el club."
end

function SquadService.PromoteYouth(player, payload)
	local data = DataService.Get(player)
	local youth, index = findIn(data.academy.youths, type(payload) == "table" and payload.id)
	if not youth then
		return false, "Ese juvenil no está en tu academia."
	end
	if youth.age < FootballConfig.YOUTH_MIN_PROMOTE_AGE then
		return false, string.format("Debe tener al menos %d años.", FootballConfig.YOUTH_MIN_PROMOTE_AGE)
	end
	if activeCount(data) >= FootballConfig.MAX_SQUAD then
		return false, string.format("La plantilla está llena (%d). Haz sitio primero.", FootballConfig.MAX_SQUAD)
	end
	table.remove(data.academy.youths, index)
	youth.salary = math.max(2, math.floor(FootballFormulas.SalaryDemand(youth) * FootballConfig.YOUTH_SALARY_SHARE))
	youth.contract = 3
	youth.joinedSeason = data.season.number
	table.insert(data.squad, youth)
	data.stats.academyGraduates = (data.stats.academyGraduates or 0) + 1
	StadiumService.LogEvent(data, "youth_promoted", { name = youth.name, ovr = FootballFormulas.OverallInt(youth), age = youth.age })
	return true, string.format("🧬 %s sube al primer equipo.", youth.name)
end

function SquadService.ReleaseYouth(player, payload)
	local data = DataService.Get(player)
	local youth, index = findIn(data.academy.youths, type(payload) == "table" and payload.id)
	if not youth then
		return false, "Ese juvenil no está en tu academia."
	end
	table.remove(data.academy.youths, index)
	return true, youth.name .. " deja la academia."
end

-- Academia de Élite: apodos personalizados (texto filtrado por Roblox). Vacío = quitar apodo.
function SquadService.SetNickname(player, payload)
	local data = DataService.Get(player)
	if not GamePassService.Owns(player, "ELITE_ACADEMY") then
		return false, "Los apodos son una ventaja del pase Academia de Élite."
	end
	if type(payload) ~= "table" then
		return false, "Solicitud no válida."
	end
	local target = findIn(data.squad, payload.id) or findIn(data.academy.youths, payload.id)
	if not target then
		return false, "Ese jugador no es de tu club."
	end
	local nickname = type(payload.nickname) == "string" and payload.nickname:gsub("^%s+", ""):gsub("%s+$", "") or ""
	if nickname == "" then
		target.nickname = nil
		return true, "Apodo eliminado."
	end
	if utf8.len(nickname) == nil or utf8.len(nickname) > 20 then
		return false, "El apodo debe tener como máximo 20 caracteres."
	end
	if not ClubService.FilterExact(player, nickname) then
		return false, "Ese apodo no está permitido."
	end
	target.nickname = nickname
	return true, string.format("%s ahora se llama «%s».", target.name, nickname)
end

function SquadService.SetScouts(player, payload)
	local data = DataService.Get(player)
	local count = tonumber(type(payload) == "table" and payload.count)
	if not count or count ~= math.floor(count) or count < 0 or count > FootballConfig.MAX_SCOUTS then
		return false, "Número de ojeadores no válido."
	end
	data.academy.scouts = count
	if count > 0 and #data.academy.reports == 0 then
		data.academy.nextReport = data.stats.cycles + 1 -- primer informe en la próxima jornada
	end
	if count == 0 then
		data.academy.reports = {}
	end
	return true, count == 0 and "Has despedido a los ojeadores." or string.format("Ahora tienes %d ojeador(es).", count)
end

function SquadService.SignReport(player, payload)
	local data = DataService.Get(player)
	local candidate, index = findIn(data.academy.reports, type(payload) == "table" and payload.id)
	if not candidate then
		return false, "Ese informe ya no está disponible."
	end
	local level = academyLevel(data)
	if #data.academy.youths >= FootballConfig.Academy(level).capacity then
		return false, "La academia está llena. Mejora la Academia juvenil o haz sitio."
	end
	local fee = FootballFormulas.YouthSignFee(candidate.potential)
	local paid, err = EconomyService.Spend(player, fee, EconomyService.Category.ACADEMY, "Fichaje juvenil: " .. candidate.name)
	if not paid then
		return false, err
	end
	table.remove(data.academy.reports, index)
	table.insert(data.academy.youths, candidate)
	return true, string.format("🔎 %s se incorpora a la academia.", candidate.name)
end

-- ===== Evolución y temporadas =====

local function trainingMultiplier(data)
	local intensity = FootballConfig.Intensity(data.training.intensity)
	local trainingLevel = data.stadium.facilities.training or 0
	return intensity.growth * (1 + FootballConfig.TRAINING_FACILITY_BONUS * trainingLevel)
end

local function grow(player, multiplier)
	local delta = FootballFormulas.GrowthPerCycle(player, multiplier)
	FootballFormulas.ApplyGrowth(player, delta)
	local ovr = FootballFormulas.Overall(player)
	if ovr > (player.peak or 0) then
		player.peak = ovr
	end
end

local function legendCheck(data, p)
	local peak = math.floor((p.peak or 0) + 0.5)
	local apps = p.stats and p.stats.apps or 0
	local isLegend = peak >= FootballConfig.LEGEND_MIN_PEAK
		or (p.origin == "academy" and peak >= FootballConfig.LEGEND_MIN_ACADEMY_PEAK)
		or apps >= FootballConfig.LEGEND_MIN_APPS
	if isLegend then
		table.insert(data.legends, {
			name = p.name,
			pos = p.pos,
			peak = peak,
			origin = p.origin,
			seasons = math.max(1, data.season.number - (p.joinedSeason or data.season.number)),
			apps = apps,
			goals = p.stats and p.stats.goals or 0,
			assists = p.stats and p.stats.assists or 0,
			retiredSeason = data.season.number,
		})
		while #data.legends > 50 do
			table.remove(data.legends, 1)
		end
	end
	return isLegend
end

local function seasonEnd(data, messages)
	local finished = data.season.number
	data.season.number += 1
	data.season.cycle = 0

	-- Primer equipo: edad, contratos y retiradas
	local keep = {}
	for _, p in ipairs(data.squad) do
		p.seasonStats = { apps = 0, goals = 0, assists = 0 } -- nueva temporada
		p.age += 1
		p.contract -= 1
		local retireChance = (p.age - FootballConfig.RETIRE_MIN_AGE + 1) * FootballConfig.RETIRE_CHANCE_PER_YEAR
		if p.age >= FootballConfig.RETIRE_FORCED_AGE or (p.age >= FootballConfig.RETIRE_MIN_AGE and rng:NextNumber() < retireChance) then
			local legend = legendCheck(data, p)
			StadiumService.LogEvent(data, "player_retired", { name = p.name, age = p.age, peak = math.floor(p.peak + 0.5), legend = legend })
			table.insert(messages, string.format("👋 %s se retira con %d años%s.", p.name, p.age, legend and " y entra en las leyendas del club" or ""))
		elseif p.contract <= 0 and not p.loan then
			StadiumService.LogEvent(data, "player_left", { name = p.name, reason = "contract" })
			table.insert(messages, p.name .. " termina su contrato y deja el club.")
		else
			table.insert(keep, p)
		end
	end
	data.squad = keep

	-- Academia: edad y salidas
	local youths = {}
	for _, y in ipairs(data.academy.youths) do
		y.age += 1
		if y.age > FootballConfig.YOUTH_MAX_AGE then
			table.insert(messages, y.name .. " cumple " .. y.age .. " años y deja la academia sin debutar.")
		else
			table.insert(youths, y)
		end
	end
	data.academy.youths = youths

	-- Nueva hornada
	local level = academyLevel(data)
	local academy = FootballConfig.Academy(level)
	local free = academy.capacity - #data.academy.youths
	local intake = math.min(academy.intake, free)
	for _ = 1, intake do
		table.insert(data.academy.youths, PlayerFactory.Youth(data, level, data.academy.scouts))
	end
	if intake > 0 then
		table.insert(messages, string.format("🧬 Llega una nueva hornada a la cantera: %d juvenil(es).", intake))
	end
	if #data.squad < FootballConfig.MIN_SQUAD then
		-- Garantía de jugabilidad: se completan plazas con jugadores libres modestos.
		while #data.squad < FootballConfig.MIN_SQUAD do
			local positions = FootballConfig.Positions
			table.insert(data.squad, PlayerFactory.Create(data, {
				pos = positions[rng:NextInteger(1, #positions)].id,
				overall = rng:NextInteger(FootballConfig.STARTING_OVERALL.min, FootballConfig.STARTING_OVERALL.max),
				age = rng:NextInteger(20, 30),
				origin = "free",
			}))
		end
		table.insert(messages, "Se han incorporado jugadores libres para completar la plantilla mínima.")
	end
	StadiumService.LogEvent(data, "season_end", { season = finished })
	table.insert(messages, string.format("📅 Termina la temporada %d. ¡Empieza la temporada %d!", finished, data.season.number))
end

local function refreshReports(data)
	local academy = data.academy
	if academy.scouts <= 0 then
		academy.reports = {}
		return
	end
	if data.stats.cycles >= (academy.nextReport or 0) then
		academy.reports = {}
		for _ = 1, academy.scouts do
			local candidate = PlayerFactory.Youth(data, academyLevel(data), academy.scouts)
			table.insert(academy.reports, candidate)
		end
		academy.nextReport = data.stats.cycles + FootballConfig.SCOUT_REPORT_CYCLES
	end
end

-- Se llama después de cada jornada. Devuelve mensajes para el jugador.
function SquadService.AfterCycle(player)
	local data = DataService.Get(player)
	if not data then
		return {}
	end
	local messages = {}
	local multiplier = trainingMultiplier(data)
	for _, p in ipairs(data.squad) do
		grow(p, multiplier)
	end
	local youthMultiplier = FootballConfig.Academy(academyLevel(data)).growth * FootballConfig.Intensity(data.training.intensity).growth
		* UniverseConfig.Multiplier("youthGrowth") -- evento del universo
	for _, y in ipairs(data.academy.youths) do
		grow(y, youthMultiplier)
	end
	refreshReports(data)
	data.season.cycle += 1
	if data.season.cycle >= FootballConfig.SEASON_LENGTH then
		seasonEnd(data, messages)
	end
	return messages
end

-- ===== Estado para el cliente (sin el potencial exacto) =====

local function publicPlayer(p, scouts, multiplier)
	local low, high = FootballFormulas.PotentialRange(p, scouts)
	local attrs = {}
	for id, v in pairs(p.attrs) do
		attrs[id] = math.floor(v + 0.5)
	end
	return {
		id = p.id,
		name = p.nickname or p.name,
		realName = p.name,
		nickname = p.nickname,
		age = p.age,
		pos = p.pos,
		attrs = attrs,
		ovr = FootballFormulas.OverallInt(p),
		potentialLow = low,
		potentialHigh = high,
		star = low >= FootballConfig.STAR_POTENTIAL,
		value = FootballFormulas.MarketValue(p),
		salary = p.salary,
		salaryDemand = FootballFormulas.SalaryDemand(p),
		contract = p.contract,
		releaseCost = FootballFormulas.ReleaseCost(p),
		focus = p.focus,
		origin = p.origin,
		fitness = math.floor((p.fitness or 100) + 0.5),
		loan = p.loan,
		listed = p.listed,
		injury = p.injury or 0,
		stats = p.stats,
		growth = math.floor(FootballFormulas.GrowthPerCycle(p, multiplier or 1) * FootballConfig.SEASON_LENGTH * 10 + 0.5) / 10, -- media prevista por temporada
		signFee = p.origin == "academy" and FootballFormulas.YouthSignFee(p.potential) or nil,
	}
end

function SquadService.PublicPlayer(p, scouts)
	return publicPlayer(p, scouts, 1)
end

function SquadService.BuildState(data)
	local scouts = data.academy.scouts
	local squad, youths, reports = {}, {}, {}
	local squadMultiplier = trainingMultiplier(data)
	local youthMultiplier = FootballConfig.Academy(academyLevel(data)).growth * FootballConfig.Intensity(data.training.intensity).growth
	for _, p in ipairs(data.squad) do
		table.insert(squad, publicPlayer(p, scouts, squadMultiplier))
	end
	for _, y in ipairs(data.academy.youths) do
		table.insert(youths, publicPlayer(y, scouts, youthMultiplier))
	end
	for _, r in ipairs(data.academy.reports) do
		table.insert(reports, publicPlayer(r, scouts, youthMultiplier))
	end
	local level = academyLevel(data)
	return {
		squad = squad,
		academy = {
			youths = youths,
			reports = reports,
			scouts = scouts,
			level = level,
			capacity = FootballConfig.Academy(level).capacity,
			intake = FootballConfig.Academy(level).intake,
			nextReportIn = math.max(0, (data.academy.nextReport or 0) - data.stats.cycles),
		},
		training = {
			intensity = data.training.intensity,
			multiplier = trainingMultiplier(data),
		},
		season = { number = data.season.number, cycle = data.season.cycle, length = FootballConfig.SEASON_LENGTH },
		legends = data.legends,
		graduates = data.stats.academyGraduates or 0,
	}
end

return SquadService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000045"><Properties><string name="Name">StadiumRenderer</string><ProtectedString name="Source"><![CDATA[-- StadiumRenderer (ModuleScript)
-- Ubicación: ServerScriptService/Server/Services/StadiumRenderer
--
-- Construye el estadio físico a partir de los datos del club.
-- Optimización: cada grada es un bloque por fila (no un asiento por pieza),
-- las esquinas son 3 bloques escalonados, las instalaciones son volúmenes simples
-- y todo es Anchored. Un estadio legendario completo ronda las 300 piezas.
--
-- El plano (posiciones de todo) está en ReplicatedStorage/Shared/Modules/StadiumLayout.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local FacilityConfig = require(Shared.Config.FacilityConfig)
local CosmeticConfig = require(Shared.Config.CosmeticConfig)
local KitPattern = require(Shared.Modules.KitPattern)
local Layout = require(Shared.Modules.StadiumLayout)

local StadiumRenderer = {}

local PITCH_CENTER_Z = Layout.PITCH_CENTER_Z
local PITCH_LENGTH = Layout.PITCH_LENGTH
local PITCH_WIDTH = Layout.PITCH_WIDTH
local ROW_DEPTH = Layout.ROW_DEPTH
local ROW_STEP = Layout.ROW_STEP
local ROWS_BY_LEVEL = Layout.ROWS_BY_LEVEL

local GOLD = Color3.fromRGB(255, 200, 70)
local WHITE = Color3.fromRGB(245, 245, 245)

StadiumRenderer.SpawnOffset = CFrame.new(Layout.SPAWN)

-- ===== Utilidades de construcción =====

local function part(parent, origin, offset, size, color, material, props)
	local p = Instance.new("Part")
	p.Anchored = true
	p.Size = size
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.CFrame = origin * offset
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if props then
		for k, v in pairs(props) do
			p[k] = v
		end
	end
	p.Parent = parent
	return p
end

local function label(adornee, text, offsetY, color)
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(220, 46)
	gui.StudsOffset = Vector3.new(0, offsetY or 4, 0)
	gui.MaxDistance = 140
	gui.AlwaysOnTop = false
	gui.Adornee = adornee
	local t = Instance.new("TextLabel")
	t.Size = UDim2.fromScale(1, 1)
	t.BackgroundTransparency = 0.35
	t.BackgroundColor3 = Color3.fromRGB(15, 20, 30)
	t.TextColor3 = color or WHITE
	t.Font = Enum.Font.GothamBold
	t.TextScaled = true
	t.Text = text
	t.Parent = gui
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 8)
	corner.Parent = t
	gui.Parent = adornee
	return gui
end

local function surfaceText(partInstance, face, build)
	local gui = Instance.new("SurfaceGui")
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 20
	gui.LightInfluence = 0.2
	gui.Parent = partInstance
	build(gui)
	return gui
end

local function material(name, fallback)
	local ok, value = pcall(function()
		return Enum.Material[name]
	end)
	return ok and value or fallback
end

-- ===== Elementos del estadio =====

local function buildPitch(folder, origin, level, elite)
	local greens = {
		Color3.fromRGB(96, 140, 64),
		Color3.fromRGB(78, 150, 62),
		Color3.fromRGB(62, 160, 62),
		Color3.fromRGB(52, 168, 64),
		Color3.fromRGB(44, 176, 70),
	}
	local base = greens[math.clamp(level, 1, #greens)]
	local c = CFrame.new(0, 0.1, PITCH_CENTER_Z)
	part(folder, origin, c, Vector3.new(PITCH_LENGTH + 8, 0.2, PITCH_WIDTH + 8), base, Enum.Material.Grass, { Name = "Pitch" })
	-- Franjas de corte a partir del nivel 3
	if level >= 3 then
		local stripe = base:Lerp(Color3.new(0, 0, 0), 0.12)
		for i = 0, 4 do
			local x = -PITCH_LENGTH / 2 + 10 + i * 20
			part(folder, origin, CFrame.new(x, 0.21, PITCH_CENTER_Z), Vector3.new(10, 0.02, PITCH_WIDTH), stripe, Enum.Material.Grass, { CanCollide = false })
		end
	end
	-- Estadio de Élite: corte de ajedrez (franjas cruzadas semitransparentes)
	if elite then
		local cross = base:Lerp(Color3.new(1, 1, 1), 0.08)
		for i = 0, 2 do
			local z = PITCH_CENTER_Z - PITCH_WIDTH / 2 + 10.7 + i * 21.3
			part(folder, origin, CFrame.new(0, 0.215, z), Vector3.new(PITCH_LENGTH, 0.02, 10.7), cross, Enum.Material.Grass,
				{ CanCollide = false, Transparency = 0.45 })
		end
	end
	-- Líneas
	local y, w = 0.23, 0.5
	local lineProps = { CanCollide = false, Name = "Line" }
	local hl, hw = PITCH_LENGTH / 2, PITCH_WIDTH / 2
	part(folder, origin, CFrame.new(0, y, PITCH_CENTER_Z - hw), Vector3.new(PITCH_LENGTH, 0.02, w), WHITE, nil, lineProps)
	part(folder, origin, CFrame.new(0, y, PITCH_CENTER_Z + hw), Vector3.new(PITCH_LENGTH, 0.02, w), WHITE, nil, lineProps)
	part(folder, origin, CFrame.new(-hl, y, PITCH_CENTER_Z), Vector3.new(w, 0.02, PITCH_WIDTH), WHITE, nil, lineProps)
	part(folder, origin, CFrame.new(hl, y, PITCH_CENTER_Z), Vector3.new(w, 0.02, PITCH_WIDTH), WHITE, nil, lineProps)
	part(folder, origin, CFrame.new(0, y, PITCH_CENTER_Z), Vector3.new(w, 0.02, PITCH_WIDTH), WHITE, nil, lineProps)
	local circle = part(folder, origin, CFrame.new(0, y, PITCH_CENTER_Z) * CFrame.Angles(0, 0, math.rad(90)),
		Vector3.new(0.02, 18, 18), WHITE, nil, lineProps)
	circle.Shape = Enum.PartType.Cylinder
	part(folder, origin, CFrame.new(0, y + 0.01, PITCH_CENTER_Z) * CFrame.Angles(0, 0, math.rad(90)),
		Vector3.new(0.02, 17, 17), base, Enum.Material.Grass, lineProps).Shape = Enum.PartType.Cylinder
	-- Porterías
	for _, side in ipairs({ -1, 1 }) do
		local x = side * hl
		for _, dz in ipairs({ -6, 6 }) do
			part(folder, origin, CFrame.new(x, 3, PITCH_CENTER_Z + dz), Vector3.new(0.5, 6, 0.5), WHITE)
		end
		part(folder, origin, CFrame.new(x, 6, PITCH_CENTER_Z), Vector3.new(0.5, 0.5, 12.5), WHITE)
		part(folder, origin, CFrame.new(x + side * 2, 3, PITCH_CENTER_Z), Vector3.new(4, 6, 12), WHITE,
			Enum.Material.ForceField, { CanCollide = false, Transparency = 0.6 })
	end
end

-- side: "N", "S", "W", "E"
local function buildStandSide(folder, origin, side, rows, design, primary, secondary)
	local length = (side == "N" or side == "S") and PITCH_LENGTH or PITCH_WIDTH
	local mat = material(design.material, Enum.Material.Concrete)
	for r = 1, rows do
		local height = r * ROW_STEP
		local dist = 4 + (r - 0.5) * ROW_DEPTH
		local cf, size
		if side == "N" then
			cf = CFrame.new(0, height / 2, PITCH_CENTER_Z - PITCH_WIDTH / 2 - dist)
			size = Vector3.new(length, height, ROW_DEPTH)
		elseif side == "S" then
			cf = CFrame.new(0, height / 2, PITCH_CENTER_Z + PITCH_WIDTH / 2 + dist)
			size = Vector3.new(length, height, ROW_DEPTH)
		elseif side == "W" then
			cf = CFrame.new(-PITCH_LENGTH / 2 - dist, height / 2, PITCH_CENTER_Z)
			size = Vector3.new(ROW_DEPTH, height, length)
		else
			cf = CFrame.new(PITCH_LENGTH / 2 + dist, height / 2, PITCH_CENTER_Z)
			size = Vector3.new(ROW_DEPTH, height, length)
		end
		part(folder, origin, cf, size, (r % 2 == 0) and (design.gold and GOLD or secondary) or primary, mat, { Name = "StandRow" })
	end

	local backDist = 4 + rows * ROW_DEPTH
	local topY = rows * ROW_STEP
	-- Barandilla de neón (diseño Arena Futurista)
	if design.neon then
		local cf = (side == "N" and CFrame.new(0, 1, PITCH_CENTER_Z - PITCH_WIDTH / 2 - 3.6))
			or (side == "S" and CFrame.new(0, 1, PITCH_CENTER_Z + PITCH_WIDTH / 2 + 3.6))
			or (side == "W" and CFrame.new(-PITCH_LENGTH / 2 - 3.6, 1, PITCH_CENTER_Z))
			or CFrame.new(PITCH_LENGTH / 2 + 3.6, 1, PITCH_CENTER_Z)
		local size = (side == "N" or side == "S") and Vector3.new(length, 0.4, 0.4) or Vector3.new(0.4, 0.4, length)
		part(folder, origin, cf, size, design.gold and GOLD or secondary, Enum.Material.Neon, { CanCollide = false })
	end
	-- Cubierta
	if design.roof then
		local depth = rows * ROW_DEPTH + 2
		local mid = 4 + depth / 2
		local roofY = topY + 9
		local tilt = design.canopy and math.rad(8) or 0
		local cf, size
		if side == "N" then
			cf = CFrame.new(0, roofY, PITCH_CENTER_Z - PITCH_WIDTH / 2 - mid) * CFrame.Angles(-tilt, 0, 0)
			size = Vector3.new(length + 2, 0.6, depth)
		elseif side == "S" then
			cf = CFrame.new(0, roofY, PITCH_CENTER_Z + PITCH_WIDTH / 2 + mid) * CFrame.Angles(tilt, 0, 0)
			size = Vector3.new(length + 2, 0.6, depth)
		elseif side == "W" then
			cf = CFrame.new(-PITCH_LENGTH / 2 - mid, roofY, PITCH_CENTER_Z) * CFrame.Angles(0, 0, tilt)
			size = Vector3.new(depth, 0.6, length + 2)
		else
			cf = CFrame.new(PITCH_LENGTH / 2 + mid, roofY, PITCH_CENTER_Z) * CFrame.Angles(0, 0, -tilt)
			size = Vector3.new(depth, 0.6, length + 2)
		end
		local roofMat = design.canopy and Enum.Material.Metal or Enum.Material.SmoothPlastic
		part(folder, origin, cf, size, design.gold and Color3.fromRGB(212, 175, 55) or Color3.fromRGB(230, 232, 236), roofMat,
			{ Name = "StandRoof", Transparency = design.material == "Glass" and 0.35 or 0 })
		-- Pilares en la parte trasera
		for _, t in ipairs({ -0.45, 0.45 }) do
			local px, pz
			if side == "N" or side == "S" then
				px = t * length
				pz = PITCH_CENTER_Z + (side == "N" and -1 or 1) * (PITCH_WIDTH / 2 + backDist + 0.5)
			else
				pz = PITCH_CENTER_Z + t * length
				px = (side == "W" and -1 or 1) * (PITCH_LENGTH / 2 + backDist + 0.5)
			end
			part(folder, origin, CFrame.new(px, roofY / 2, pz), Vector3.new(1, roofY, 1), Color3.fromRGB(70, 75, 85), Enum.Material.Metal)
		end
	end
end

local function buildStands(folder, origin, level, design, primary, secondary)
	if level < 1 then
		return
	end
	local rows = ROWS_BY_LEVEL[math.clamp(level, 1, #ROWS_BY_LEVEL)]
	local sides = { "N" }
	if level >= 2 then
		sides = { "N", "S" }
	end
	if level >= 3 then
		sides = { "N", "S", "W", "E" }
	end
	for _, side in ipairs(sides) do
		buildStandSide(folder, origin, side, rows, design, primary, secondary)
	end
end

local function buildLighting(folder, origin, level, vip)
	if level < 1 then
		return
	end
	-- Torres en las esquinas exteriores del estadio (fuera de gradas y esquinas)
	local positions = { Vector3.new(-100, 0, -97), Vector3.new(100, 0, -97) }
	if level >= 2 then
		table.insert(positions, Vector3.new(-100, 0, 72))
		table.insert(positions, Vector3.new(100, 0, 72))
	end
	local height = 26 + level * 5
	-- VIP Club: iluminación dorada (ventaja visual, sin efecto económico)
	local lightColor = vip and Color3.fromRGB(255, 214, 130) or Color3.fromRGB(255, 252, 240)
	for _, pos in ipairs(positions) do
		part(folder, origin, CFrame.new(pos.X, height / 2, pos.Z), Vector3.new(1.4, height, 1.4), Color3.fromRGB(90, 95, 105), Enum.Material.Metal)
		local worldHead = (origin * CFrame.new(pos.X, height + 1.5, pos.Z)).Position
		local target = (origin * CFrame.new(0, 0, PITCH_CENTER_Z)).Position
		local head = Instance.new("Part")
		head.Anchored = true
		head.Size = Vector3.new(6, 3, 1)
		head.CFrame = CFrame.lookAt(worldHead, target)
		head.Material = Enum.Material.Neon
		head.Color = lightColor
		head.Parent = folder
		local spot = Instance.new("SpotLight")
		spot.Face = Enum.NormalId.Front
		spot.Angle = 90
		spot.Brightness = 1.5 + level
		spot.Range = 60
		spot.Color = lightColor
		spot.Parent = head
	end
end

local function buildScoreboard(folder, origin, level, info)
	if level < 1 then
		return
	end
	local width, height = 14 + level * 4, 7 + level * 2
	-- Detrás de la grada norte, por encima de su cubierta
	local baseY = 32
	local z = -100
	local pos = Vector3.new(0, baseY + height / 2, z)
	for _, dx in ipairs({ -width / 3, width / 3 }) do
		part(folder, origin, CFrame.new(dx, baseY / 2, z), Vector3.new(1, baseY, 1), Color3.fromRGB(60, 60, 70), Enum.Material.Metal)
	end
	local worldPos = (origin * CFrame.new(pos)).Position
	local target = (origin * CFrame.new(0, pos.Y, PITCH_CENTER_Z)).Position
	local board = Instance.new("Part")
	board.Name = "Scoreboard"
	board.Anchored = true
	board.Size = Vector3.new(width, height, 1)
	board.CFrame = CFrame.lookAt(worldPos, target)
	board.Color = Color3.fromRGB(15, 15, 20)
	board.Parent = folder
	surfaceText(board, Enum.NormalId.Front, function(gui)
		local bg = Instance.new("Frame")
		bg.Size = UDim2.fromScale(1, 1)
		bg.BackgroundColor3 = Color3.fromRGB(8, 10, 16)
		bg.Parent = gui
		local top = Instance.new("TextLabel")
		top.Size = UDim2.fromScale(1, 0.3)
		top.BackgroundTransparency = 1
		top.Font = Enum.Font.GothamBlack
		top.TextScaled = true
		top.TextColor3 = info.secondaryText
		top.Text = info.crestSymbol .. "  " .. info.clubName
		top.Parent = bg
		local score = Instance.new("TextLabel")
		score.Position = UDim2.fromScale(0, 0.3)
		score.Size = UDim2.fromScale(1, 0.5)
		score.BackgroundTransparency = 1
		score.Font = Enum.Font.Code
		score.TextScaled = true
		score.TextColor3 = Color3.fromRGB(255, 190, 40)
		local last = info.lastMatch
		if last then
			score.Text = last.home and string.format("%s  %d - %d  %s", info.shortName, last.gf, last.ga, last.short)
				or string.format("%s  %d - %d  %s", last.short, last.ga, last.gf, info.shortName)
		else
			score.Text = info.shortName .. "  0 - 0  ---"
		end
		score.Parent = bg
		local bottom = Instance.new("TextLabel")
		bottom.Position = UDim2.fromScale(0, 0.8)
		bottom.Size = UDim2.fromScale(1, 0.2)
		bottom.BackgroundTransparency = 1
		bottom.Font = Enum.Font.Gotham
		bottom.TextScaled = true
		bottom.TextColor3 = Color3.fromRGB(180, 190, 200)
		bottom.Text = last and string.format("Último partido · %s · Temporada %d", last.competition or "", last.season or 1) or "Sin partidos todavía"
		bottom.Parent = bg
	end)
end

-- facilityId: se guarda como atributo "Facility" para que InteractionService le añada interacción.
local function buildBuilding(folder, origin, pos, level, design, primary, secondary, title, facilityId)
	if level < 1 then
		return
	end
	local size = Vector3.new(12 + level * 3, 7 + level * 1.5, 10 + level * 2)
	local isNeon = design.material == "Neon"
	local bodyMat = isNeon and Enum.Material.SmoothPlastic or material(design.material, Enum.Material.Brick)
	local bodyColor = (design.material == "Glass") and Color3.fromRGB(170, 210, 230)
		or (design.material == "DiamondPlate" and Color3.fromRGB(150, 155, 165))
		or (isNeon and Color3.fromRGB(30, 30, 40))
		or Color3.fromRGB(170, 95, 70)
	local body = part(folder, origin, CFrame.new(pos.X, size.Y / 2, pos.Z), size, bodyColor, bodyMat,
		{ Transparency = design.material == "Glass" and 0.25 or 0 })
	part(folder, origin, CFrame.new(pos.X, size.Y + 0.5, pos.Z), Vector3.new(size.X + 1, 1, size.Z + 1),
		design.gold and GOLD or (isNeon and secondary or primary), (isNeon or design.gold) and Enum.Material.Neon or Enum.Material.SmoothPlastic)
	label(body, string.format("%s · Nv %d", title, level), size.Y / 2 + 3)
	if facilityId then
		body:SetAttribute("Facility", facilityId)
	end
	return body, size
end

-- Campo de entrenamiento pequeño (centro de entrenamiento y academia)
local function miniPitch(folder, origin, pos, length, width, withGoals)
	part(folder, origin, CFrame.new(pos.X, 0.1, pos.Z), Vector3.new(length, 0.2, width), Color3.fromRGB(60, 160, 65), Enum.Material.Grass)
	part(folder, origin, CFrame.new(pos.X, 0.22, pos.Z), Vector3.new(0.4, 0.02, width), WHITE, nil, { CanCollide = false })
	if withGoals then
		for _, side in ipairs({ -1, 1 }) do
			local x = pos.X + side * length / 2
			for _, dz in ipairs({ -3, 3 }) do
				part(folder, origin, CFrame.new(x, 1.5, pos.Z + dz), Vector3.new(0.3, 3, 0.3), WHITE)
			end
			part(folder, origin, CFrame.new(x, 3, pos.Z), Vector3.new(0.3, 0.3, 6.3), WHITE)
		end
	end
end

local GLASS_DESIGN = { material = "Glass" }
local ELITE_CAMPUS = { material = "Glass", gold = true }

local function buildLaneFacilities(folder, origin, facilities, design, info)
	local F = Layout.Facilities
	local function title(id)
		local def = FacilityConfig.Get(id)
		return def.icon .. " " .. def.name
	end
	buildBuilding(folder, origin, F.lockers, facilities.lockers or 0, design, info.primary, info.secondary, title("lockers"), "lockers")
	buildBuilding(folder, origin, F.shop, facilities.shop or 0, design, info.primary, info.secondary, title("shop"), "shop")
	buildBuilding(folder, origin, F.restaurant, facilities.restaurant or 0, design, info.primary, info.secondary, title("restaurant"), "restaurant")

	-- Zona VIP: pabellón de cristal con remate dorado
	local vipLevel = facilities.vip or 0
	if vipLevel > 0 then
		local body, size = buildBuilding(folder, origin, F.vip, vipLevel, GLASS_DESIGN, info.primary, info.secondary, title("vip"), "vip")
		part(folder, origin, CFrame.new(F.vip.X, size.Y + 1.2, F.vip.Z), Vector3.new(size.X + 1.4, 0.4, size.Z + 1.4), GOLD, Enum.Material.Neon, { CanCollide = false })
		body.Color = Color3.fromRGB(190, 220, 240)
	end

	-- Centro de entrenamiento: edificio + campo de entrenamiento
	local trainingLevel = facilities.training or 0
	if trainingLevel > 0 then
		buildBuilding(folder, origin, F.training + Vector3.new(0, 0, 12), trainingLevel, design, info.primary, info.secondary, title("training"), "training")
		miniPitch(folder, origin, F.training + Vector3.new(0, 0, -18), 20 + trainingLevel * 3, 14, trainingLevel >= 2)
	end

	-- Academia juvenil: edificio + campo pequeño
	local academyLevel = facilities.academy or 0
	if academyLevel > 0 then
		-- Academia de Élite: edificio «Campus de Élite»
		local academyDesign = info.eliteAcademy and ELITE_CAMPUS or design
		local academyTitle = info.eliteAcademy and "🧬 Campus de Élite" or title("academy")
		buildBuilding(folder, origin, F.academy + Vector3.new(0, 0, -6), academyLevel, academyDesign, info.primary, info.secondary, academyTitle, "academy")
		miniPitch(folder, origin, F.academy + Vector3.new(0, 0, 12), 18 + academyLevel * 2, 8, academyLevel >= 2)
	end

	-- Sala de trofeos: edificio con copa y contador REAL de títulos
	local trophyLevel = facilities.trophyRoom or 0
	if trophyLevel > 0 then
		local _, size = buildBuilding(folder, origin, F.trophyRoom, trophyLevel, design, info.primary, info.secondary, title("trophyRoom"), "trophyRoom")
		local cup = part(folder, origin, CFrame.new(F.trophyRoom.X, size.Y + 3, F.trophyRoom.Z) * CFrame.Angles(0, 0, math.rad(90)),
			Vector3.new(4, 3, 3), GOLD, Enum.Material.Metal, { Reflectance = 0.3 })
		cup.Shape = Enum.PartType.Cylinder
		label(cup, string.format("🏆 Títulos: %d", info.trophyCount or 0), 4, GOLD).MaxDistance = 90
		-- Vitrina física: una copa por título real (las 12 más recientes) y una placa con la lista
		local trophies = info.trophies or {}
		local shelfX = F.trophyRoom.X + size.X / 2 + 4
		part(folder, origin, CFrame.new(shelfX, 1, F.trophyRoom.Z), Vector3.new(3, 2, 26), Color3.fromRGB(60, 40, 25), Enum.Material.Wood)
		local shown = 0
		for i = #trophies, math.max(1, #trophies - 11), -1 do
			local t = trophies[i]
			shown += 1
			local z = F.trophyRoom.Z - 12 + (shown - 1) * 2.2
			local trophyCup = part(folder, origin, CFrame.new(shelfX, 3, z) * CFrame.Angles(0, 0, math.rad(90)),
				Vector3.new(2, 1.2, 1.2), t.kind == "cup" and Color3.fromRGB(220, 220, 230) or GOLD, Enum.Material.Metal, { Reflectance = 0.3 })
			trophyCup.Shape = Enum.PartType.Cylinder
		end
		local plaque = part(folder, origin, CFrame.new(shelfX + 1.6, 5, F.trophyRoom.Z) * CFrame.Angles(0, math.rad(90), 0),
			Vector3.new(26, 4, 0.3), Color3.fromRGB(30, 25, 15), Enum.Material.Wood)
		local lines = {}
		for i = #trophies, math.max(1, #trophies - 5), -1 do
			table.insert(lines, string.format("%s %s (T%d)", trophies[i].kind == "cup" and "🥇" or "🏆", trophies[i].name, trophies[i].season))
		end
		local function plaqueText(gui)
			local t = Instance.new("TextLabel")
			t.Size = UDim2.fromScale(1, 1)
			t.BackgroundTransparency = 1
			t.TextColor3 = GOLD
			t.Font = Enum.Font.GothamBold
			t.TextScaled = true
			t.Text = #lines > 0 and table.concat(lines, "   ·   ") or "La vitrina espera su primer título"
			t.Parent = gui
		end
		surfaceText(plaque, Enum.NormalId.Front, plaqueText)
		surfaceText(plaque, Enum.NormalId.Back, plaqueText)
	end
end

local function buildSign(folder, origin, info)
	for _, x in ipairs({ -12, 12 }) do
		part(folder, origin, CFrame.new(x, 4, Layout.SIGN.Z), Vector3.new(1, 8, 1), info.vip and GOLD or Color3.fromRGB(60, 60, 70), Enum.Material.Metal)
	end
	local board = part(folder, origin, CFrame.new(0, 11, Layout.SIGN.Z), Vector3.new(26, 10, 1), info.primary, Enum.Material.SmoothPlastic, { Name = "ClubSign" })
	board:SetAttribute("Facility", "sign")
	local function content(gui)
		local frame = Instance.new("Frame")
		frame.Size = UDim2.fromScale(1, 1)
		frame.BackgroundColor3 = Color3.fromRGB(12, 18, 32)
		frame.Parent = gui
		local stroke = Instance.new("UIStroke")
		stroke.Thickness = 10
		stroke.Color = info.vip and GOLD or info.primary
		stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		stroke.Parent = frame
		local crest = Instance.new("TextLabel")
		crest.Size = UDim2.fromScale(0.25, 0.7)
		crest.Position = UDim2.fromScale(0.02, 0.15)
		crest.BackgroundTransparency = 1
		crest.TextScaled = true
		crest.Text = info.crestSymbol
		crest.Parent = frame
		local name = Instance.new("TextLabel")
		name.Size = UDim2.fromScale(0.7, 0.38)
		name.Position = UDim2.fromScale(0.28, 0.1)
		name.BackgroundTransparency = 1
		name.Font = Enum.Font.GothamBlack
		name.TextScaled = true
		name.TextXAlignment = Enum.TextXAlignment.Left
		name.TextColor3 = WHITE
		name.Text = info.clubName
		name.Parent = frame
		local sub = Instance.new("TextLabel")
		sub.Size = UDim2.fromScale(0.7, 0.2)
		sub.Position = UDim2.fromScale(0.28, 0.5)
		sub.BackgroundTransparency = 1
		sub.Font = Enum.Font.Gotham
		sub.TextScaled = true
		sub.TextXAlignment = Enum.TextXAlignment.Left
		sub.TextColor3 = Color3.fromRGB(190, 200, 215)
		local naming = info.sponsors and info.sponsors.naming
		sub.Text = (naming and ("🏟️ Estadio " .. naming .. " · ") or "") .. "Presidente: " .. info.ownerName .. " · " .. info.stageName
		sub.Parent = frame
		if info.vip then
			local tag = Instance.new("TextLabel")
			tag.Size = UDim2.fromScale(0.3, 0.2)
			tag.Position = UDim2.fromScale(0.28, 0.74)
			tag.BackgroundColor3 = GOLD
			tag.Font = Enum.Font.GothamBlack
			tag.TextScaled = true
			tag.TextColor3 = Color3.fromRGB(30, 20, 0)
			tag.Text = "👑 VIP CLUB"
			tag.Parent = frame
			local corner = Instance.new("UICorner")
			corner.CornerRadius = UDim.new(0.3, 0)
			corner.Parent = tag
		end
	end
	surfaceText(board, Enum.NormalId.Front, content)
	surfaceText(board, Enum.NormalId.Back, content)

	-- Expositor de equipación
	part(folder, origin, CFrame.new(Layout.KIT_DISPLAY.X, 3, Layout.KIT_DISPLAY.Z), Vector3.new(0.6, 6, 0.6), Color3.fromRGB(60, 60, 70), Enum.Material.Metal)
	local kitBoard = part(folder, origin, CFrame.new(Layout.KIT_DISPLAY.X, 8, Layout.KIT_DISPLAY.Z), Vector3.new(5, 5, 0.4), info.primary)
	local function kit(gui)
		local holder = Instance.new("Frame")
		holder.Size = UDim2.fromScale(1, 1)
		holder.BorderSizePixel = 0
		holder.Parent = gui
		KitPattern.Build(holder, info.kitPattern, info.primary, info.secondary)
		local shirtSponsor = info.sponsors and info.sponsors.shirt
		if shirtSponsor then
			local t = Instance.new("TextLabel")
			t.Name = "KitPart"
			t.BackgroundTransparency = 1
			t.Position = UDim2.fromScale(0.1, 0.35)
			t.Size = UDim2.fromScale(0.8, 0.25)
			t.Font = Enum.Font.GothamBlack
			t.TextScaled = true
			t.TextColor3 = info.secondaryText
			t.TextStrokeTransparency = 0.5
			t.Text = string.upper(shirtSponsor)
			t.ZIndex = 5
			t.Parent = holder
		end
	end
	surfaceText(kitBoard, Enum.NormalId.Front, kit)
	surfaceText(kitBoard, Enum.NormalId.Back, kit)
end

local function buildEffect(folder, origin, effectId, primary, secondary)
	if effectId == "none" then
		return
	end
	local emitterPart = part(folder, origin, CFrame.new(0, 28, PITCH_CENTER_Z), Vector3.new(PITCH_LENGTH, 1, PITCH_WIDTH),
		WHITE, nil, { Transparency = 1, CanCollide = false, CanQuery = false, CanTouch = false, Name = "EffectEmitter" })
	local e = Instance.new("ParticleEmitter")
	e.Shape = Enum.ParticleEmitterShape.Box
	e.EmissionDirection = Enum.NormalId.Bottom
	if effectId == "confetti" then
		e.Color = ColorSequence.new(primary, secondary)
		e.Size = NumberSequence.new(0.4)
		e.Rate = 25
		e.Lifetime = NumberRange.new(6, 8)
		e.Speed = NumberRange.new(2, 4)
		e.RotSpeed = NumberRange.new(-180, 180)
		e.Acceleration = Vector3.new(0, -2, 0)
	elseif effectId == "sparkles" then
		e.Color = ColorSequence.new(WHITE, secondary)
		e.LightEmission = 1
		e.Size = NumberSequence.new(0.6, 0)
		e.Rate = 30
		e.Lifetime = NumberRange.new(2, 3)
		e.Speed = NumberRange.new(1, 3)
	elseif effectId == "smoke" then
		emitterPart.CFrame = origin * CFrame.new(0, 2, PITCH_CENTER_Z)
		e.EmissionDirection = Enum.NormalId.Top
		e.Color = ColorSequence.new(primary, secondary)
		e.Size = NumberSequence.new(3, 8)
		e.Transparency = NumberSequence.new(0.5, 1)
		e.Rate = 6
		e.Lifetime = NumberRange.new(4, 6)
		e.Speed = NumberRange.new(2, 4)
	elseif effectId == "bats" then
		e.Color = ColorSequence.new(Color3.fromRGB(40, 20, 50), Color3.fromRGB(10, 10, 10))
		e.Size = NumberSequence.new(1.2, 0.6)
		e.Rate = 12
		e.Lifetime = NumberRange.new(4, 6)
		e.Speed = NumberRange.new(6, 10)
		e.SpreadAngle = Vector2.new(60, 60)
		e.RotSpeed = NumberRange.new(-90, 90)
	elseif effectId == "vip_gold" then
		e.Color = ColorSequence.new(GOLD)
		e.LightEmission = 1
		e.Size = NumberSequence.new(0.5, 0)
		e.Rate = 35
		e.Lifetime = NumberRange.new(3, 4)
		e.Speed = NumberRange.new(1, 2)
	end
	e.Parent = emitterPart
end

-- ===== Decoraciones =====

local DecorationBuilders = {}

DecorationBuilders.flags = function(f, o, p, info)
	for i, dx in ipairs({ -3, 3 }) do
		part(f, o, CFrame.new(p.X + dx, 6, p.Z), Vector3.new(0.4, 12, 0.4), Color3.fromRGB(200, 200, 205), Enum.Material.Metal)
		part(f, o, CFrame.new(p.X + dx + 1.6, 10.5, p.Z), Vector3.new(3, 2, 0.1), i == 1 and info.primary or info.secondary, Enum.Material.Fabric)
	end
end
DecorationBuilders.planters = function(f, o, p)
	part(f, o, CFrame.new(p.X, 1, p.Z), Vector3.new(6, 2, 3), Color3.fromRGB(120, 80, 60), Enum.Material.Wood)
	local bush = part(f, o, CFrame.new(p.X, 3, p.Z), Vector3.new(5, 3, 3), Color3.fromRGB(50, 130, 50), Enum.Material.Grass)
	bush.Shape = Enum.PartType.Ball
end
DecorationBuilders.bench = function(f, o, p, info)
	part(f, o, CFrame.new(p.X, 1.4, p.Z), Vector3.new(7, 0.4, 2), info.primary, Enum.Material.Wood)
	part(f, o, CFrame.new(p.X, 2.6, p.Z + 0.9), Vector3.new(7, 2, 0.3), info.secondary, Enum.Material.Wood)
	part(f, o, CFrame.new(p.X, 0.6, p.Z), Vector3.new(6, 1.2, 1), Color3.fromRGB(70, 70, 75), Enum.Material.Metal)
end
DecorationBuilders.ball_statue = function(f, o, p)
	part(f, o, CFrame.new(p.X, 1.5, p.Z), Vector3.new(5, 3, 5), Color3.fromRGB(150, 150, 155), Enum.Material.Marble)
	local ball = part(f, o, CFrame.new(p.X, 5.5, p.Z), Vector3.new(5, 5, 5), WHITE, Enum.Material.SmoothPlastic)
	ball.Shape = Enum.PartType.Ball
end
DecorationBuilders.pro_arch = function(f, o, p, info)
	for _, dx in ipairs({ -4.5, 4.5 }) do
		part(f, o, CFrame.new(p.X + dx, 6, p.Z), Vector3.new(1.5, 12, 1.5), info.primary, Enum.Material.Metal)
	end
	part(f, o, CFrame.new(p.X, 12.5, p.Z), Vector3.new(11, 1.5, 1.5), info.secondary, Enum.Material.Metal)
	part(f, o, CFrame.new(p.X, 11.5, p.Z), Vector3.new(9, 0.3, 0.3), info.secondary, Enum.Material.Neon, { CanCollide = false })
end
DecorationBuilders.pro_fountain = function(f, o, p)
	local basin = part(f, o, CFrame.new(p.X, 0.8, p.Z) * CFrame.Angles(0, 0, math.rad(90)), Vector3.new(1.6, 9, 9), Color3.fromRGB(200, 200, 205), Enum.Material.Marble)
	basin.Shape = Enum.PartType.Cylinder
	local water = part(f, o, CFrame.new(p.X, 1.4, p.Z) * CFrame.Angles(0, 0, math.rad(90)), Vector3.new(0.4, 8, 8), Color3.fromRGB(80, 160, 230), Enum.Material.Glass, { Transparency = 0.3, CanCollide = false })
	water.Shape = Enum.PartType.Cylinder
	part(f, o, CFrame.new(p.X, 3, p.Z), Vector3.new(1.2, 4, 1.2), Color3.fromRGB(200, 200, 205), Enum.Material.Marble)
	local spray = Instance.new("ParticleEmitter")
	spray.Color = ColorSequence.new(Color3.fromRGB(170, 220, 255))
	spray.Size = NumberSequence.new(0.4, 0.1)
	spray.Rate = 20
	spray.Speed = NumberRange.new(5, 7)
	spray.Acceleration = Vector3.new(0, -12, 0)
	spray.SpreadAngle = Vector2.new(15, 15)
	spray.Lifetime = NumberRange.new(1, 1.2)
	spray.Parent = water
end
DecorationBuilders.pro_screen = function(f, o, p, info)
	part(f, o, CFrame.new(p.X, 4, p.Z), Vector3.new(1, 8, 1), Color3.fromRGB(60, 60, 70), Enum.Material.Metal)
	local screen = part(f, o, CFrame.new(p.X, 10, p.Z), Vector3.new(10, 5.5, 0.6), Color3.fromRGB(10, 10, 15))
	local function content(gui)
		local t = Instance.new("TextLabel")
		t.Size = UDim2.fromScale(1, 1)
		t.BackgroundColor3 = info.primary
		t.TextColor3 = info.secondaryText
		t.Font = Enum.Font.GothamBlack
		t.TextScaled = true
		t.Text = info.crestSymbol .. " " .. info.shortName
		t.Parent = gui
	end
	surfaceText(screen, Enum.NormalId.Front, content)
	surfaceText(screen, Enum.NormalId.Back, content)
end
DecorationBuilders.cos_banner = function(f, o, p, info)
	for _, dx in ipairs({ -4.5, 4.5 }) do
		part(f, o, CFrame.new(p.X + dx, 5, p.Z), Vector3.new(0.5, 10, 0.5), Color3.fromRGB(200, 200, 205), Enum.Material.Metal)
	end
	local banner = part(f, o, CFrame.new(p.X, 7, p.Z), Vector3.new(9, 4, 0.1), info.primary, Enum.Material.Fabric)
	local function content(gui)
		local t = Instance.new("TextLabel")
		t.Size = UDim2.fromScale(1, 1)
		t.BackgroundColor3 = info.primary
		t.TextColor3 = info.secondaryText
		t.Font = Enum.Font.GothamBlack
		t.TextScaled = true
		t.Text = "¡VAMOS " .. string.upper(info.shortName) .. "!"
		t.Parent = gui
	end
	surfaceText(banner, Enum.NormalId.Front, content)
	surfaceText(banner, Enum.NormalId.Back, content)
end
DecorationBuilders.cos_fireworks = function(f, o, p, info)
	local tower = part(f, o, CFrame.new(p.X, 3, p.Z), Vector3.new(2, 6, 2), Color3.fromRGB(40, 40, 50), Enum.Material.Metal)
	local fx = Instance.new("ParticleEmitter")
	fx.EmissionDirection = Enum.NormalId.Top
	fx.Color = ColorSequence.new(info.primary, info.secondary)
	fx.LightEmission = 1
	fx.Size = NumberSequence.new(0.6, 0)
	fx.Rate = 15
	fx.Speed = NumberRange.new(20, 28)
	fx.SpreadAngle = Vector2.new(10, 10)
	fx.Acceleration = Vector3.new(0, -10, 0)
	fx.Lifetime = NumberRange.new(2, 2.5)
	fx.Parent = tower
end
DecorationBuilders.vip_carpet = function(f, o, p)
	part(f, o, CFrame.new(p.X, 0.1, p.Z), Vector3.new(4, 0.2, 12), Color3.fromRGB(170, 15, 30), Enum.Material.Fabric, { CanCollide = false })
	for _, dz in ipairs({ -5, 0, 5 }) do
		for _, dx in ipairs({ -2.6, 2.6 }) do
			part(f, o, CFrame.new(p.X + dx, 1.2, p.Z + dz), Vector3.new(0.4, 2.4, 0.4), GOLD, Enum.Material.Metal)
		end
	end
end
DecorationBuilders.vip_statue = function(f, o, p)
	part(f, o, CFrame.new(p.X, 1.5, p.Z), Vector3.new(4, 3, 4), Color3.fromRGB(30, 30, 35), Enum.Material.Marble)
	part(f, o, CFrame.new(p.X, 6, p.Z), Vector3.new(2, 6, 1.2), GOLD, Enum.Material.Metal, { Reflectance = 0.3 })
	local head = part(f, o, CFrame.new(p.X, 9.8, p.Z), Vector3.new(1.6, 1.6, 1.6), GOLD, Enum.Material.Metal, { Reflectance = 0.3 })
	head.Shape = Enum.PartType.Ball
	local sparkle = Instance.new("Sparkles")
	sparkle.SparkleColor = GOLD
	sparkle.Parent = head
end

-- Decoraciones en posición libre: cada una se construye en su propio marco local
-- (posición + rotación), así los constructores no necesitan saber de rotaciones.
DecorationBuilders.pumpkin_giant = function(f, o, p)
	local body = part(f, o, CFrame.new(p.X, 2.6, p.Z), Vector3.new(6, 5, 6), Color3.fromRGB(240, 120, 20), Enum.Material.SmoothPlastic)
	body.Shape = Enum.PartType.Ball
	part(f, o, CFrame.new(p.X, 5.6, p.Z), Vector3.new(0.8, 1.4, 0.8), Color3.fromRGB(60, 120, 40), Enum.Material.Wood)
	local glow = Instance.new("PointLight")
	glow.Color = Color3.fromRGB(255, 150, 50)
	glow.Brightness = 2
	glow.Range = 14
	glow.Parent = body
	-- Cara iluminada
	for _, dx in ipairs({ -1.2, 1.2 }) do
		part(f, o, CFrame.new(p.X + dx, 3.4, p.Z - 2.7), Vector3.new(0.9, 0.9, 0.3), Color3.fromRGB(255, 220, 90), Enum.Material.Neon, { CanCollide = false })
	end
	part(f, o, CFrame.new(p.X, 2, p.Z - 2.7), Vector3.new(2.6, 0.6, 0.3), Color3.fromRGB(255, 220, 90), Enum.Material.Neon, { CanCollide = false })
end

local function buildDecorations(folder, origin, decorations, visibleFlags, info)
	for index, entry in ipairs(decorations) do
		local builder = DecorationBuilders[entry.id]
		if builder and visibleFlags[index] then
			local sub = Instance.new("Folder")
			sub.Name = "Decoration_" .. index
			sub.Parent = folder
			local frame = origin * CFrame.new(entry.x, 0, entry.z) * CFrame.Angles(0, math.rad(entry.r or 0), 0)
			builder(sub, frame, Vector3.zero, info)
		end
	end
end

-- ===== Comercial y patrocinio (FASE 3) =====

-- Vallas publicitarias alrededor del campo: muestran el patrocinador de vallas real.
local function buildAdBoards(folder, origin, info)
	local brand = info.sponsors and info.sponsors.boards
	local text = brand and string.upper(brand) or "¡ANÚNCIATE AQUÍ!"
	for _, sz in ipairs({ -1, 1 }) do
		for _, x in ipairs({ -25, 25 }) do
			local z = PITCH_CENTER_Z + sz * (PITCH_WIDTH / 2 + 2.5)
			local board = part(folder, origin, CFrame.new(x, 0.8, z), Vector3.new(40, 1.6, 0.4), Color3.fromRGB(15, 15, 20),
				Enum.Material.SmoothPlastic, { Name = "AdBoard" })
			local function content(gui)
				local t = Instance.new("TextLabel")
				t.Size = UDim2.fromScale(1, 1)
				t.BackgroundColor3 = brand and info.primary or Color3.fromRGB(30, 30, 40)
				t.TextColor3 = brand and info.secondaryText or Color3.fromRGB(200, 200, 210)
				t.Font = Enum.Font.GothamBlack
				t.TextScaled = true
				t.Text = text
				t.Parent = gui
			end
			surfaceText(board, Enum.NormalId.Front, content)
			surfaceText(board, Enum.NormalId.Back, content)
		end
	end
end

local function buildKiosks(folder, origin, level, info)
	if level < 1 then
		return
	end
	local xs = { -60, 60 }
	if level >= 2 then
		table.insert(xs, -80)
		table.insert(xs, 80)
	end
	if level >= 3 then
		table.insert(xs, -40)
		table.insert(xs, 40)
	end
	for i, x in ipairs(xs) do
		local counter = part(folder, origin, CFrame.new(x, 1.5, 72), Vector3.new(5, 3, 3), Color3.fromRGB(200, 170, 120), Enum.Material.WoodPlanks)
		part(folder, origin, CFrame.new(x, 4.2, 72), Vector3.new(6, 0.4, 4), info.primary, Enum.Material.Fabric)
		if i == 1 then
			label(counter, string.format("🌭 Quioscos · Nv %d", level), 4).MaxDistance = 80
		end
		counter:SetAttribute("Facility", "kiosks")
	end
end

local function buildTourBooth(folder, origin, level, info)
	if level < 1 then
		return
	end
	local booth = part(folder, origin, CFrame.new(20, 2.5, 72), Vector3.new(6, 5, 3), Color3.fromRGB(240, 240, 235), Enum.Material.SmoothPlastic)
	part(folder, origin, CFrame.new(20, 5.3, 72), Vector3.new(7, 0.6, 4), info.secondary, Enum.Material.SmoothPlastic)
	label(booth, string.format("🗺️ Tour del estadio · Nv %d", level), 4).MaxDistance = 80
	booth:SetAttribute("Facility", "tour")
end

-- Afición en las gradas (se dibuja en una carpeta aparte y solo cuando cambia la ocupación).
function StadiumRenderer.RenderCrowd(folder, origin, standsLevel, occupancy, info)
	folder:ClearAllChildren()
	if standsLevel < 1 or occupancy <= 0 then
		return
	end
	local rows = ROWS_BY_LEVEL[math.clamp(standsLevel, 1, #ROWS_BY_LEVEL)]
	local filled = math.clamp(math.floor(rows * occupancy + 0.5), 1, rows)
	local sides = { "N" }
	if standsLevel >= 2 then
		sides = { "N", "S" }
	end
	if standsLevel >= 3 then
		sides = { "N", "S", "W", "E" }
	end
	local colors = { info.primary, info.secondary, Color3.fromRGB(235, 235, 235) }
	local props = { CanCollide = false, CanQuery = false, CastShadow = false, Name = "Crowd" }
	for _, side in ipairs(sides) do
		local length = (side == "N" or side == "S") and PITCH_LENGTH - 2 or PITCH_WIDTH - 2
		for r = 1, filled do
			local y = r * ROW_STEP + 0.35
			local dist = 4 + (r - 0.5) * ROW_DEPTH
			local cf, size
			if side == "N" then
				cf, size = CFrame.new(0, y, PITCH_CENTER_Z - PITCH_WIDTH / 2 - dist), Vector3.new(length, 0.7, 1.6)
			elseif side == "S" then
				cf, size = CFrame.new(0, y, PITCH_CENTER_Z + PITCH_WIDTH / 2 + dist), Vector3.new(length, 0.7, 1.6)
			elseif side == "W" then
				cf, size = CFrame.new(-PITCH_LENGTH / 2 - dist, y, PITCH_CENTER_Z), Vector3.new(1.6, 0.7, length)
			else
				cf, size = CFrame.new(PITCH_LENGTH / 2 + dist, y, PITCH_CENTER_Z), Vector3.new(1.6, 0.7, length)
			end
			part(folder, origin, cf, size, colors[(r % 3) + 1], Enum.Material.Fabric, props)
		end
	end
end

-- ===== Estadio evolutivo: elementos de cada etapa =====

local function stageColor(name)
	local colors = {
		Concrete = Color3.fromRGB(175, 175, 170),
		Cobblestone = Color3.fromRGB(150, 140, 130),
		Slate = Color3.fromRGB(110, 115, 125),
		Marble = Color3.fromRGB(230, 228, 222),
		WoodPlanks = Color3.fromRGB(150, 110, 70),
		Brick = Color3.fromRGB(160, 80, 60),
		Glass = Color3.fromRGB(170, 210, 235),
	}
	return colors[name] or Color3.fromRGB(170, 170, 170)
end

local function buildWalls(folder, origin, visual, info)
	local wall = visual.wall
	local h = wall.height
	local mat = material(wall.material, Enum.Material.Concrete)
	local color = stageColor(wall.material)
	local props = { Transparency = wall.material == "Glass" and 0.4 or 0, Name = "Wall" }
	local hx, hz = Layout.HALF_X, Layout.HALF_Z
	local t = 1.5
	local gateHalf = 10
	local segments = {
		{ CFrame.new(0, h / 2, -hz + t / 2), Vector3.new(hx * 2, h, t) }, -- norte
		{ CFrame.new(-hx + t / 2, h / 2, 0), Vector3.new(t, h, hz * 2) }, -- oeste
		{ CFrame.new(hx - t / 2, h / 2, 0), Vector3.new(t, h, hz * 2) }, -- este
		{ CFrame.new(-(hx + gateHalf) / 2, h / 2, hz - t / 2), Vector3.new(hx - gateHalf, h, t) }, -- sur izq.
		{ CFrame.new((hx + gateHalf) / 2, h / 2, hz - t / 2), Vector3.new(hx - gateHalf, h, t) }, -- sur dcha.
	}
	for _, seg in ipairs(segments) do
		part(folder, origin, seg[1], seg[2], color, mat, props)
		-- Remate superior: franja del club, neón o dorado según la etapa
		if wall.stripe or wall.neon or wall.gold or info.eliteStadium then
			local gold = wall.gold or info.eliteStadium -- Estadio de Élite: remates dorados
			local capColor = gold and GOLD or (wall.neon and info.secondary or info.primary)
			local capMat = (wall.neon or gold) and Enum.Material.Neon or Enum.Material.SmoothPlastic
			part(folder, origin, seg[1] * CFrame.new(0, h / 2 + 0.3, 0), Vector3.new(seg[2].X, 0.6, seg[2].Z), capColor, capMat, { CanCollide = false })
		end
	end
end

local function buildGate(folder, origin, visual, info)
	local h = (visual.wall and visual.wall.height or 4) + 6
	local z = Layout.HALF_Z - 0.75
	local pillarColor = (visual.wall and visual.wall.gold) and GOLD or info.primary
	for _, x in ipairs({ -11, 11 }) do
		part(folder, origin, CFrame.new(x, h / 2, z), Vector3.new(2.5, h, 2.5), pillarColor, Enum.Material.SmoothPlastic)
	end
	local beam = part(folder, origin, CFrame.new(0, h + 1.5, z), Vector3.new(25, 3, 2.5), info.secondary, Enum.Material.SmoothPlastic, { Name = "Gate" })
	if visual.gateText then
		local function content(gui)
			local t = Instance.new("TextLabel")
			t.Size = UDim2.fromScale(1, 1)
			t.BackgroundColor3 = info.primary
			t.TextColor3 = info.secondaryText
			t.Font = Enum.Font.GothamBlack
			t.TextScaled = true
			local naming = info.sponsors and info.sponsors.naming
			t.Text = info.crestSymbol .. " " .. string.upper(info.clubName) .. " · "
				.. (naming and ("ESTADIO " .. string.upper(naming)) or info.stageName)
			t.Parent = gui
		end
		surfaceText(beam, Enum.NormalId.Front, content)
		surfaceText(beam, Enum.NormalId.Back, content)
	end
end

-- Esquinas cerradas: 3 bloques escalonados por esquina, anclados en la esquina exterior.
local function buildCorners(folder, origin, standsLevel, design, info)
	if standsLevel < 3 then
		return -- hacen falta las 4 gradas
	end
	local rows = ROWS_BY_LEVEL[math.clamp(standsLevel, 1, #ROWS_BY_LEVEL)]
	local a, b = 4, 4 + rows * ROW_DEPTH
	local topY = rows * ROW_STEP
	local mat = material(design.material, Enum.Material.Concrete)
	for _, sx in ipairs({ -1, 1 }) do
		for _, sz in ipairs({ -1, 1 }) do
			local zEdge = PITCH_CENTER_Z + sz * PITCH_WIDTH / 2
			for k = 1, 3 do
				local size = (b - a) * k / 3
				local height = topY * (4 - k) / 3
				local cx = sx * (PITCH_LENGTH / 2 + b - size / 2)
				local cz = zEdge + sz * (b - size / 2)
				part(folder, origin, CFrame.new(cx, height / 2, cz), Vector3.new(size, height, size),
					(k % 2 == 0) and info.secondary or info.primary, mat, { Name = "CornerStand" })
			end
		end
	end
end

local function buildScreens(folder, origin, info)
	for _, sx in ipairs({ -1, 1 }) do
		local pos = Vector3.new(sx * 75, 30, -78)
		part(folder, origin, CFrame.new(pos.X, 12, pos.Z), Vector3.new(1.5, 24, 1.5), Color3.fromRGB(60, 60, 70), Enum.Material.Metal)
		local worldPos = (origin * CFrame.new(pos)).Position
		local target = (origin * CFrame.new(0, pos.Y, PITCH_CENTER_Z)).Position
		local screen = Instance.new("Part")
		screen.Name = "BigScreen"
		screen.Anchored = true
		screen.Size = Vector3.new(20, 11, 1)
		screen.CFrame = CFrame.lookAt(worldPos, target)
		screen.Color = Color3.fromRGB(10, 10, 15)
		screen.Parent = folder
		surfaceText(screen, Enum.NormalId.Front, function(gui)
			local t = Instance.new("TextLabel")
			t.Size = UDim2.fromScale(1, 1)
			t.BackgroundColor3 = info.primary
			t.TextColor3 = info.secondaryText
			t.Font = Enum.Font.GothamBlack
			t.TextScaled = true
			t.Text = info.crestSymbol .. "\n" .. info.clubName
			t.Parent = gui
		end)
	end
end

local function buildLightRing(folder, origin, standsLevel, info)
	local rows = ROWS_BY_LEVEL[math.clamp(standsLevel, 1, #ROWS_BY_LEVEL)]
	local b = 4 + rows * ROW_DEPTH
	local y = rows * ROW_STEP + 12
	local color = (info.vip or info.eliteStadium) and GOLD or Color3.fromRGB(170, 220, 255)
	local outerX = PITCH_LENGTH / 2 + b
	local north, south = PITCH_CENTER_Z - PITCH_WIDTH / 2 - b, PITCH_CENTER_Z + PITCH_WIDTH / 2 + b
	local props = { CanCollide = false, CanQuery = false, Name = "LightRing" }
	part(folder, origin, CFrame.new(0, y, north), Vector3.new(outerX * 2, 0.6, 0.6), color, Enum.Material.Neon, props)
	part(folder, origin, CFrame.new(0, y, south), Vector3.new(outerX * 2, 0.6, 0.6), color, Enum.Material.Neon, props)
	part(folder, origin, CFrame.new(-outerX, y, (north + south) / 2), Vector3.new(0.6, 0.6, south - north), color, Enum.Material.Neon, props)
	part(folder, origin, CFrame.new(outerX, y, (north + south) / 2), Vector3.new(0.6, 0.6, south - north), color, Enum.Material.Neon, props)
end

local function buildMonument(folder, origin, info)
	local p = Layout.MONUMENT
	part(folder, origin, CFrame.new(p.X, 2, p.Z), Vector3.new(6, 4, 6), Color3.fromRGB(235, 232, 225), Enum.Material.Marble)
	local ball = part(folder, origin, CFrame.new(p.X, 7, p.Z), Vector3.new(6, 6, 6), GOLD, Enum.Material.Metal, { Reflectance = 0.35 })
	ball.Shape = Enum.PartType.Ball
	local sparkle = Instance.new("Sparkles")
	sparkle.SparkleColor = GOLD
	sparkle.Parent = ball
	label(ball, info.crestSymbol .. " Monumento " .. info.clubName, 5, GOLD).MaxDistance = 100
end

-- Leyendas del Club: estatuas de las leyendas retiradas (las 6 más recientes) y placa de títulos.
local LEGEND_SPOTS = {
	Vector3.new(-112, 0, -40), Vector3.new(112, 0, -40), Vector3.new(-112, 0, 13),
	Vector3.new(112, 0, 13), Vector3.new(-112, 0, 63), Vector3.new(112, 0, 63),
}
local function buildLegendsWalk(folder, origin, info)
	local legends = info.legends or {}
	local spot = 0
	for i = #legends, math.max(1, #legends - #LEGEND_SPOTS + 1), -1 do
		local l = legends[i]
		spot += 1
		local p = LEGEND_SPOTS[spot]
		part(folder, origin, CFrame.new(p.X, 1.5, p.Z), Vector3.new(4, 3, 4), Color3.fromRGB(235, 232, 225), Enum.Material.Marble)
		part(folder, origin, CFrame.new(p.X, 5.5, p.Z), Vector3.new(1.8, 5, 1.2), GOLD, Enum.Material.Metal, { Reflectance = 0.3 })
		local head = part(folder, origin, CFrame.new(p.X, 8.7, p.Z), Vector3.new(1.5, 1.5, 1.5), GOLD, Enum.Material.Metal, { Reflectance = 0.3 })
		head.Shape = Enum.PartType.Ball
		label(head, string.format("🏅 %s · media %d", l.name, l.peak or 0), 2.5, GOLD).MaxDistance = 70
	end
	local plaque = part(folder, origin, CFrame.new(-22, 3.5, 103), Vector3.new(12, 5, 0.4), Color3.fromRGB(30, 25, 15), Enum.Material.Wood)
	local function content(gui)
		local t = Instance.new("TextLabel")
		t.Size = UDim2.fromScale(1, 1)
		t.BackgroundTransparency = 1
		t.TextColor3 = GOLD
		t.Font = Enum.Font.GothamBlack
		t.TextScaled = true
		t.Text = string.format("📜 %s\n%d títulos · %d leyendas", info.clubName, info.trophyCount or 0, #legends)
		t.Parent = gui
	end
	surfaceText(plaque, Enum.NormalId.Front, content)
	surfaceText(plaque, Enum.NormalId.Back, content)
end

local function buildStageExtras(folder, origin, info, standsLevel, standsDesign)
	local visual = info.stageVisual or {}
	if visual.plaza then
		part(folder, origin, CFrame.new(0, 0.05, 87.5), Vector3.new(190, 0.1, 35), stageColor(visual.plaza),
			material(visual.plaza, Enum.Material.Concrete), { Name = "Plaza" })
	end
	if visual.wall then
		buildWalls(folder, origin, visual, info)
	end
	if visual.gate then
		buildGate(folder, origin, visual, info)
	end
	if visual.corners then
		buildCorners(folder, origin, standsLevel, standsDesign, info)
	end
	if visual.screens then
		buildScreens(folder, origin, info)
	end
	if visual.lightRing then
		buildLightRing(folder, origin, standsLevel, info)
	end
	if info.clubLegends then
		buildLegendsWalk(folder, origin, info)
	end
	if visual.monument then
		buildMonument(folder, origin, info)
	end
end

-- ===== API =====

-- info: ver PlotService.BuildRenderInfo
-- ===== CONSTRUCCIÓN LIBRE: piezas sueltas del estadio =====
-- Cada constructor recibe (modelo, marco, info). El marco es el centro de la pieza a ras de
-- suelo, ya girado: X = ancho, Z = fondo. Las gradas suben hacia -Z y miran hacia +Z.

local GREY = Color3.fromRGB(120, 124, 135)
local DARK = Color3.fromRGB(40, 44, 56)
local GRASS = Color3.fromRGB(58, 160, 66)

local function simpleText(target, face, text, textColor, background)
	surfaceText(target, face, function(gui)
		local label = Instance.new("TextLabel")
		label.Size = UDim2.fromScale(1, 1)
		label.BackgroundColor3 = background or Color3.fromRGB(8, 10, 16)
		label.BackgroundTransparency = background and 0 or 1
		label.Font = Enum.Font.GothamBlack
		label.TextScaled = true
		label.TextColor3 = textColor or WHITE
		label.Text = text
		label.Parent = gui
	end)
end

-- Silla en la que los jugadores se pueden sentar (mira hacia +Z).
local function pieceSeat(model, frame, x, y, z, color)
	local seat = Instance.new("Seat")
	seat.Name = "Seat"
	seat.Anchored = true
	seat.Size = Vector3.new(1.8, 0.4, 1.8)
	seat.Color = color
	seat.Material = Enum.Material.SmoothPlastic
	seat.TopSurface = Enum.SurfaceType.Smooth
	seat.BottomSurface = Enum.SurfaceType.Smooth
	-- El frente de un Seat es -Z: se gira 180° para que mire hacia +Z de la pieza
	seat.CFrame = frame * CFrame.new(x, y + 1.4, z) * CFrame.Angles(0, math.pi, 0)
	seat.Parent = model
	part(model, frame, CFrame.new(x, y + 2.3, z - 0.8), Vector3.new(1.8, 1.6, 0.3), color)
	part(model, frame, CFrame.new(x, y + 0.6, z), Vector3.new(0.4, 1.2, 0.4), DARK, Enum.Material.Metal)
end

local function piecePitch(model, frame, w, d, goalWidth)
	part(model, frame, CFrame.new(0, 0.1, 0), Vector3.new(w, 0.2, d), GRASS, Enum.Material.Grass, { Name = "Pitch" })
	local stripe = GRASS:Lerp(Color3.new(0, 0, 0), 0.12)
	local fieldW, fieldD = w - 4, d - 4
	local stripes = 6
	for i = 0, stripes - 1, 2 do
		part(model, frame, CFrame.new(-fieldW / 2 + (i + 0.5) * fieldW / stripes, 0.21, 0), Vector3.new(fieldW / stripes, 0.02, fieldD),
			stripe, Enum.Material.Grass, { CanCollide = false })
	end
	local y, t = 0.23, 0.5
	local props = { CanCollide = false, Name = "Line" }
	part(model, frame, CFrame.new(0, y, -fieldD / 2), Vector3.new(fieldW, 0.02, t), WHITE, nil, props)
	part(model, frame, CFrame.new(0, y, fieldD / 2), Vector3.new(fieldW, 0.02, t), WHITE, nil, props)
	part(model, frame, CFrame.new(-fieldW / 2, y, 0), Vector3.new(t, 0.02, fieldD), WHITE, nil, props)
	part(model, frame, CFrame.new(fieldW / 2, y, 0), Vector3.new(t, 0.02, fieldD), WHITE, nil, props)
	part(model, frame, CFrame.new(0, y, 0), Vector3.new(t, 0.02, fieldD), WHITE, nil, props)
	local radius = math.min(fieldD * 0.14, 9)
	local circle = part(model, frame, CFrame.new(0, y, 0) * CFrame.Angles(0, 0, math.rad(90)), Vector3.new(0.02, radius * 2, radius * 2), WHITE, nil, props)
	circle.Shape = Enum.PartType.Cylinder
	part(model, frame, CFrame.new(0, y + 0.01, 0) * CFrame.Angles(0, 0, math.rad(90)), Vector3.new(0.02, radius * 2 - 1, radius * 2 - 1),
		GRASS, Enum.Material.Grass, props).Shape = Enum.PartType.Cylinder
	for _, side in ipairs({ -1, 1 }) do
		local x = side * fieldW / 2
		for _, dz in ipairs({ -goalWidth / 2, goalWidth / 2 }) do
			part(model, frame, CFrame.new(x, 3, dz), Vector3.new(0.5, 6, 0.5), WHITE)
		end
		part(model, frame, CFrame.new(x, 6, 0), Vector3.new(0.5, 0.5, goalWidth + 0.5), WHITE)
		part(model, frame, CFrame.new(x + side * 1.6, 3, 0), Vector3.new(3, 6, goalWidth), WHITE, Enum.Material.ForceField,
			{ CanCollide = false, Transparency = 0.6 })
	end
end

local function pieceStand(model, frame, w, d, info)
	local rows = math.floor(d / 2)
	for k = 1, rows do
		local h = k * 1.5
		local z = d / 2 - (k - 0.5) * 2
		part(model, frame, CFrame.new(0, h / 2, z), Vector3.new(w, h, 2), k % 2 == 0 and GREY or Color3.fromRGB(150, 154, 165), Enum.Material.Concrete)
		part(model, frame, CFrame.new(0, h + 0.3, z - 0.2), Vector3.new(w - 1, 0.6, 1.2), k % 2 == 0 and info.primary or info.secondary,
			Enum.Material.SmoothPlastic, { CanCollide = false, Name = "Seats" })
	end
	part(model, frame, CFrame.new(0, (rows * 1.5 + 3) / 2, -d / 2 + 0.25), Vector3.new(w, rows * 1.5 + 3, 0.5), DARK, Enum.Material.Metal)
end

local PieceBuilders = {}

PieceBuilders.pitch_full = function(model, frame)
	piecePitch(model, frame, 104, 68, 12)
end

PieceBuilders.pitch_mini = function(model, frame)
	piecePitch(model, frame, 52, 34, 8)
end

PieceBuilders.goal = function(model, frame)
	for _, dz in ipairs({ -6, 6 }) do
		part(model, frame, CFrame.new(-1.5, 3, dz), Vector3.new(0.5, 6, 0.5), WHITE)
	end
	part(model, frame, CFrame.new(-1.5, 6, 0), Vector3.new(0.5, 0.5, 12.5), WHITE)
	part(model, frame, CFrame.new(0.5, 3, 0), Vector3.new(3.5, 6, 12), WHITE, Enum.Material.ForceField, { CanCollide = false, Transparency = 0.6 })
end

PieceBuilders.grass_tile = function(model, frame)
	part(model, frame, CFrame.new(0, 0.1, 0), Vector3.new(8, 0.2, 8), GRASS, Enum.Material.Grass)
end

PieceBuilders.path_tile = function(model, frame)
	part(model, frame, CFrame.new(0, 0.1, 0), Vector3.new(8, 0.2, 8), Color3.fromRGB(190, 190, 195), Enum.Material.Pavement)
end

PieceBuilders.bench = function(model, frame, info)
	part(model, frame, CFrame.new(0, 0.2, 0), Vector3.new(10, 0.4, 3), DARK, Enum.Material.Concrete)
	for i = 0, 3 do
		pieceSeat(model, frame, -3.3 + i * 2.2, 0.4, 0.3, info.primary)
	end
	part(model, frame, CFrame.new(0, 2.2, -1.35), Vector3.new(10, 4, 0.3), Color3.fromRGB(190, 220, 240), Enum.Material.Glass, { Transparency = 0.5 })
	part(model, frame, CFrame.new(0, 4.3, -0.3), Vector3.new(10, 0.3, 2.4), Color3.fromRGB(190, 220, 240), Enum.Material.Glass, { Transparency = 0.5, CanCollide = false })
end

PieceBuilders.seat = function(model, frame, info)
	pieceSeat(model, frame, 0, 0, 0, info.primary)
end

PieceBuilders.seat_row = function(model, frame, info)
	for i = 0, 9 do
		pieceSeat(model, frame, -9 + i * 2, 0, 0, i % 2 == 0 and info.primary or info.secondary)
	end
end

PieceBuilders.stand_small = function(model, frame, info)
	pieceStand(model, frame, 30, 10, info)
end

PieceBuilders.stand_big = function(model, frame, info)
	pieceStand(model, frame, 60, 16, info)
end

-- Grada de esquina: escalones que suben hacia la esquina trasera (-X, -Z)
PieceBuilders.stand_corner = function(model, frame, info)
	for k = 1, 7 do
		local size = 16 - (k - 1) * 2
		local h = k * 1.4
		part(model, frame, CFrame.new(-8 + size / 2, h / 2, -8 + size / 2), Vector3.new(size, h, size),
			k % 2 == 0 and info.primary or GREY, Enum.Material.Concrete)
	end
end

PieceBuilders.vip_box = function(model, frame, info)
	for _, x in ipairs({ -9, 9 }) do
		for _, z in ipairs({ -3, 3 }) do
			part(model, frame, CFrame.new(x, 3, z), Vector3.new(1, 6, 1), DARK, Enum.Material.Metal)
		end
	end
	part(model, frame, CFrame.new(0, 6.25, 0), Vector3.new(20, 0.5, 8), Color3.fromRGB(230, 228, 222), Enum.Material.Marble)
	part(model, frame, CFrame.new(0, 8, 3.8), Vector3.new(20, 3, 0.3), Color3.fromRGB(180, 215, 240), Enum.Material.Glass, { Transparency = 0.55 })
	part(model, frame, CFrame.new(0, 8.25, -3.8), Vector3.new(20, 3.5, 0.4), DARK)
	part(model, frame, CFrame.new(0, 10.2, 0), Vector3.new(21, 0.4, 9), GOLD, Enum.Material.Metal)
	for i = 0, 3 do
		pieceSeat(model, frame, -6 + i * 4, 6.5, 0, GOLD)
	end
	-- Escalera trasera para subir
	for step = 1, 6 do
		part(model, frame, CFrame.new(0, step - 0.5, -4.5 - (6 - step) * 1.2), Vector3.new(4, 1, 1.2), GREY, Enum.Material.Concrete)
	end
end

PieceBuilders.wall = function(model, frame)
	part(model, frame, CFrame.new(0, 3, 0), Vector3.new(16, 6, 1), Color3.fromRGB(175, 175, 170), Enum.Material.Concrete)
end

PieceBuilders.fence = function(model, frame, info)
	for i = 0, 4 do
		part(model, frame, CFrame.new(-8 + i * 4, 1.5, 0), Vector3.new(0.4, 3, 0.4), DARK, Enum.Material.Metal)
	end
	part(model, frame, CFrame.new(0, 2.7, 0), Vector3.new(16, 0.3, 0.3), info.primary, Enum.Material.Metal)
	part(model, frame, CFrame.new(0, 1.4, 0), Vector3.new(16, 0.3, 0.3), info.primary, Enum.Material.Metal)
end

