<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4"><Item class="ReplicatedStorage" referent="RBX0000002A"><Properties><string name="Name">ReplicatedStorage</string></Properties><Item class="Folder" referent="RBX00000029"><Properties><string name="Name">Shared</string></Properties><Item class="Folder" referent="RBX0000001F"><Properties><string name="Name">Config</string></Properties><Item class="ModuleScript" referent="RBX00000001"><Properties><string name="Name">AdminConfig</string><ProtectedString name="Source"><![CDATA[-- AdminConfig (ModuleScript)
-- Ubicación: ReplicatedStorage/Shared/Config/AdminConfig
--
-- EVENTOS «ADMIN ABUSE»: el dueño del juego lanza eventos para todos los servidores.
-- Quién es admin lo decide SOLO el servidor (AdminService):
--   * el creador del juego (game.CreatorId si el juego es de un usuario),
--   * los UserId de ADMIN_USER_IDS,
--   * si el juego es de un grupo, los miembros con rango >= GROUP_MIN_RANK.
--   * En Roblox Studio, quien prueba (para poder ensayar los eventos).

local AdminConfig = {}

AdminConfig.ADMIN_USER_IDS = {
	-- 123456789, -- añade aquí UserIds de otros admins
}
AdminConfig.GROUP_MIN_RANK = 254

AdminConfig.Events = {
	{ id = "double", icon = "💰", name = "Recompensas x2", minutes = 15, cooldown = 60,
		text = "¡ADMIN ABUSE! Recompensas x2 durante 15 minutos" },
	{ id = "speed", icon = "⚡", name = "Supervelocidad", minutes = 5, cooldown = 30,
		text = "¡ADMIN ABUSE! Todos corren x1.5 durante 5 minutos", speedMultiplier = 1.5 },
	{ id = "coinrain", icon = "🪙", name = "Lluvia de monedas", minutes = 1, cooldown = 30,
		text = "¡ADMIN ABUSE! Lluvia de monedas en todos los estadios: ¡corre a recogerlas!", coinValue = 300, coinsPerPlot = 25 },
	{ id = "goldball", icon = "🏆", name = "Balón de oro", minutes = 10, cooldown = 60,
		text = "¡ADMIN ABUSE! Balón dorado en los partidos en grupo: cada gol vale x3", goalMultiplier = 3 },
	{ id = "luck", icon = "🍀", name = "Suerte x2", minutes = 10, cooldown = 60,
		text = "¡ADMIN ABUSE! Suerte x2 en huevos y cajas de balones durante 10 minutos", luckMultiplier = 2 },
}

AdminConfig.ANNOUNCE_MAX_LENGTH = 120
AdminConfig.MESSAGING_TOPIC = "FEU_AdminEvents"

function AdminConfig.Event(id)
	for _, event in ipairs(AdminConfig.Events) do
		if event.id == id then
			return event
		end
	end
	return nil
end

return AdminConfig
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000002"><Properties><string name="Name">ArenaConfig</string><ProtectedString name="Source"><![CDATA[-- ArenaConfig (ModuleScript)
-- Ubicación: ReplicatedStorage/Shared/Config/ArenaConfig
--
-- PARTIDOS EN GRUPO: fútbol jugable en tiempo real (equipos Rojo y Azul).
-- Los huecos de cada equipo se rellenan con bots para poder jugar solo o con pocos amigos.

local ArenaConfig = {}

-- El estadio de partidos está fuera de la zona de terrenos (al sur de la avenida).
ArenaConfig.ORIGIN = CFrame.new(0, 0, 720)

-- Campo: el eje X es el largo (porterías en ±X).
ArenaConfig.FIELD_LENGTH = 150
ArenaConfig.FIELD_WIDTH = 96
ArenaConfig.GOAL_WIDTH = 26
ArenaConfig.GOAL_HEIGHT = 11
ArenaConfig.GOAL_DEPTH = 7
ArenaConfig.WALL_HEIGHT = 40

ArenaConfig.BALL_SIZE = 3
ArenaConfig.BALL_ELASTICITY = 0.55

-- Duración y ritmo
ArenaConfig.MATCH_SECONDS = 180
ArenaConfig.QUEUE_COUNTDOWN = 15 -- cuenta atrás cuando hay alguien en la cola
ArenaConfig.QUEUE_COUNTDOWN_FULL = 5 -- si la cola está llena
ArenaConfig.KICKOFF_FREEZE = 3 -- segundos quietos antes de cada saque
ArenaConfig.GOAL_CELEBRATION = 3
ArenaConfig.RESULT_SECONDS = 6

-- Equipos
ArenaConfig.MAX_PER_TEAM = 5
ArenaConfig.MIN_PER_TEAM = 3 -- se completa con bots hasta este número
ArenaConfig.TEAMS = {
	{ id = "red", name = "Rojo", color = Color3.fromRGB(230, 60, 60), brick = "Bright red" },
	{ id = "blue", name = "Azul", color = Color3.fromRGB(50, 120, 240), brick = "Bright blue" },
}

-- Chut (validado en el servidor)
ArenaConfig.KICK_RANGE = 7.5 -- distancia máxima del jugador al balón
ArenaConfig.KICK_COOLDOWN = 0.3
ArenaConfig.KICK_MIN_SPEED = 45
ArenaConfig.KICK_MAX_SPEED = 115
ArenaConfig.KICK_MIN_LIFT = 6
ArenaConfig.KICK_MAX_LIFT = 32
ArenaConfig.DRIBBLE_SPEED = 20 -- empujón al tocar el balón corriendo
ArenaConfig.PASS_MIN_SPEED = 40 -- pase al compañero (la fuerza depende de la distancia)
ArenaConfig.PASS_MAX_SPEED = 100
ArenaConfig.HEADER_SPEED = 52 -- cabezazo
ArenaConfig.HEADER_LIFT = 9
ArenaConfig.GOLDEN_GOAL_SECONDS = 60 -- prórroga si hay empate: el primer gol gana

-- Bots
ArenaConfig.BOT_SPEED = 17
ArenaConfig.BOT_KEEPER_SPEED = 15
ArenaConfig.BOT_KICK_COOLDOWN = 0.9
ArenaConfig.BOT_PASS_CHANCE = 0.55 -- probabilidad de pasar en vez de chutar cuando está lejos
ArenaConfig.BOT_PASS_MIN_DISTANCE = 45 -- distancia a la portería a partir de la que piensa en pasar
ArenaConfig.BOT_PASS_MIN_GAIN = 12 -- el compañero debe estar al menos así de más cerca de la portería
ArenaConfig.BOT_NAMES = { "Bot Rayo", "Bot Muralla", "Bot Crack", "Bot Tornado", "Bot Pibe", "Bot Toro", "Bot Mago", "Bot Flecha" }

-- Recompensas (dinero del club; no hay ventajas de pago)
ArenaConfig.REWARD_WIN = 3000
ArenaConfig.REWARD_DRAW = 1500
ArenaConfig.REWARD_LOSS = 800
ArenaConfig.REWARD_GOAL = 400
ArenaConfig.REWARD_MVP = 1500 -- extra para el mejor jugador del partido
ArenaConfig.MAX_REWARDED_PER_HOUR = 12 -- evita granjear dinero sin límite

-- ESTADIOS: en cada partido se elige uno (el destacado de la semana sale la mitad de las veces).
-- Solo cambia el aspecto: el balón y las medidas son iguales en todos.
ArenaConfig.FEATURED_THEME_CHANCE = 0.5
ArenaConfig.Themes = {
	{ id = "classic", name = "Estadio clásico", icon = "🏟️", pitchMaterial = "Grass", floorMaterial = "Grass",
		pitchA = Color3.fromRGB(52, 150, 64), pitchB = Color3.fromRGB(62, 168, 74), floor = Color3.fromRGB(70, 110, 60), line = Color3.fromRGB(245, 245, 245) },
	{ id = "beach", name = "Playa", icon = "🏖️", pitchMaterial = "Sand", floorMaterial = "Sand",
		pitchA = Color3.fromRGB(236, 214, 160), pitchB = Color3.fromRGB(226, 200, 140), floor = Color3.fromRGB(245, 228, 185), line = Color3.fromRGB(255, 255, 255) },
	{ id = "street", name = "Cancha urbana", icon = "🏙️", pitchMaterial = "Asphalt", floorMaterial = "Concrete",
		pitchA = Color3.fromRGB(70, 74, 84), pitchB = Color3.fromRGB(80, 84, 96), floor = Color3.fromRGB(52, 54, 62), line = Color3.fromRGB(255, 220, 60) },
	{ id = "snow", name = "Nieve", icon = "🏔️", pitchMaterial = "Snow", floorMaterial = "Ice",
		pitchA = Color3.fromRGB(235, 242, 250), pitchB = Color3.fromRGB(215, 228, 245), floor = Color3.fromRGB(190, 215, 240), line = Color3.fromRGB(60, 120, 220) },
	{ id = "volcano", name = "Volcán", icon = "🌋", pitchMaterial = "Basalt", floorMaterial = "CrackedLava",
		pitchA = Color3.fromRGB(62, 46, 46), pitchB = Color3.fromRGB(76, 54, 50), floor = Color3.fromRGB(170, 50, 20), line = Color3.fromRGB(255, 170, 60) },
	{ id = "neon", name = "Arena neón", icon = "🌃", pitchMaterial = "SmoothPlastic", floorMaterial = "SmoothPlastic", lineMaterial = "Neon",
		pitchA = Color3.fromRGB(20, 22, 34), pitchB = Color3.fromRGB(28, 30, 46), floor = Color3.fromRGB(10, 10, 18), line = Color3.fromRGB(0, 255, 220) },
	{ id = "desert", name = "Desierto", icon = "🏜️", pitchMaterial = "Sandstone", floorMaterial = "Sand",
		pitchA = Color3.fromRGB(214, 170, 110), pitchB = Color3.fromRGB(200, 155, 95), floor = Color3.fromRGB(230, 190, 130), line = Color3.fromRGB(120, 60, 30) },
	{ id = "jungle", name = "Selva", icon = "🌴", pitchMaterial = "LeafyGrass", floorMaterial = "Mud",
		pitchA = Color3.fromRGB(60, 120, 50), pitchB = Color3.fromRGB(72, 136, 58), floor = Color3.fromRGB(80, 60, 40), line = Color3.fromRGB(255, 240, 180) },
	{ id = "moon", name = "Luna", icon = "🌙", pitchMaterial = "Slate", floorMaterial = "Rock",
		pitchA = Color3.fromRGB(150, 152, 160), pitchB = Color3.fromRGB(135, 137, 146), floor = Color3.fromRGB(90, 92, 100), line = Color3.fromRGB(120, 200, 255), lineMaterial = "Neon" },
	{ id = "candy", name = "Mundo dulce", icon = "🍭", pitchMaterial = "Plastic", floorMaterial = "SmoothPlastic",
		pitchA = Color3.fromRGB(255, 170, 210), pitchB = Color3.fromRGB(255, 195, 225), floor = Color3.fromRGB(170, 230, 255), line = Color3.fromRGB(255, 255, 255) },
	{ id = "castle", name = "Castillo", icon = "🏰", pitchMaterial = "Cobblestone", floorMaterial = "Granite",
		pitchA = Color3.fromRGB(120, 115, 105), pitchB = Color3.fromRGB(132, 126, 115), floor = Color3.fromRGB(80, 78, 74), line = Color3.fromRGB(255, 215, 80) },
	{ id = "glacier", name = "Glaciar", icon = "🧊", pitchMaterial = "Glacier", floorMaterial = "Ice",
		pitchA = Color3.fromRGB(170, 220, 245), pitchB = Color3.fromRGB(150, 205, 235), floor = Color3.fromRGB(210, 235, 250), line = Color3.fromRGB(30, 80, 160) },
}

function ArenaConfig.Theme(id)
	for _, theme in ipairs(ArenaConfig.Themes) do
		if theme.id == id then
			return theme
		end
	end
	return ArenaConfig.Themes[1]
end

-- Plataforma de entrada en la avenida (junto al punto de aparición)
ArenaConfig.LOBBY_PAD = CFrame.new(40, 0, 0)

return ArenaConfig
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000003"><Properties><string name="Name">CollectionConfig</string><ProtectedString name="Source"><![CDATA[-- CollectionConfig (ModuleScript)
-- Ubicación: ReplicatedStorage/Shared/Config/CollectionConfig
--
-- MASCOTAS Y BALONES COLECCIONABLES con rarezas.
--   * Los huevos y las cajas se compran con el dinero del club (no con Robux).
--   * Las probabilidades de cada rareza se muestran SIEMPRE en la interfaz.
--   * Mascotas: hasta MAX_EQUIPPED_PETS te siguen y suman un bonus a las recompensas de los
--     partidos en grupo. Balones: solo cambian el aspecto del balón (color, estela, brillo).

local CollectionConfig = {}

CollectionConfig.MAX_EQUIPPED_PETS = 3 -- base; los renacimientos suman huecos (RebirthConfig.PET_SLOT_AT)
CollectionConfig.ABSOLUTE_MAX_PETS = 5
CollectionConfig.DUPLICATE_BALL_REFUND = 0.5 -- balón repetido: se devuelve la mitad de la caja

CollectionConfig.Rarities = {
	{ id = "common", name = "Común", color = Color3.fromRGB(190, 195, 205), hex = "#BEC3CD", sell = 500 },
	{ id = "rare", name = "Raro", color = Color3.fromRGB(70, 150, 255), hex = "#4696FF", sell = 2500 },
	{ id = "epic", name = "Épico", color = Color3.fromRGB(175, 85, 255), hex = "#AF55FF", sell = 10000 },
	{ id = "legendary", name = "Legendario", color = Color3.fromRGB(255, 190, 40), hex = "#FFBE28", sell = 40000 },
	{ id = "mythic", name = "Mítico", color = Color3.fromRGB(255, 70, 130), hex = "#FF4682", sell = 150000 },
}

-- bonus = fracción que suma a las recompensas de los partidos en grupo mientras está equipada.
-- Aspecto: body/accent = colores · ears = floppy|pointy|long|round|none · extra = rasgos opcionales.
CollectionConfig.Pets = {
	{ id = "puppy", name = "Perrito", icon = "🐶", rarity = "common", bonus = 0.02, body = Color3.fromRGB(200, 150, 100), accent = Color3.fromRGB(120, 80, 50), ears = "floppy" },
	{ id = "kitten", name = "Gatito", icon = "🐱", rarity = "common", bonus = 0.02, body = Color3.fromRGB(240, 170, 90), accent = Color3.fromRGB(255, 240, 220), ears = "pointy" },
	{ id = "bunny", name = "Conejito", icon = "🐰", rarity = "common", bonus = 0.02, body = Color3.fromRGB(245, 245, 245), accent = Color3.fromRGB(255, 180, 200), ears = "long" },
	{ id = "chick", name = "Pollito", icon = "🐥", rarity = "common", bonus = 0.02, body = Color3.fromRGB(255, 225, 80), accent = Color3.fromRGB(255, 150, 40), ears = "none", beak = true },
	{ id = "fox", name = "Zorro", icon = "🦊", rarity = "rare", bonus = 0.05, body = Color3.fromRGB(235, 120, 40), accent = Color3.fromRGB(250, 250, 250), ears = "pointy" },
	{ id = "panda", name = "Panda", icon = "🐼", rarity = "rare", bonus = 0.05, body = Color3.fromRGB(245, 245, 245), accent = Color3.fromRGB(30, 30, 35), ears = "round" },
	{ id = "penguin", name = "Pingüino", icon = "🐧", rarity = "rare", bonus = 0.05, body = Color3.fromRGB(40, 45, 60), accent = Color3.fromRGB(250, 250, 250), ears = "none", beak = true, wings = true },
	{ id = "lion", name = "León", icon = "🦁", rarity = "epic", bonus = 0.09, body = Color3.fromRGB(235, 185, 90), accent = Color3.fromRGB(150, 90, 30), ears = "round", mane = true },
	{ id = "eagle", name = "Águila", icon = "🦅", rarity = "epic", bonus = 0.09, body = Color3.fromRGB(110, 75, 45), accent = Color3.fromRGB(250, 250, 250), ears = "none", beak = true, wings = true },
	{ id = "shark", name = "Tiburón", icon = "🦈", rarity = "epic", bonus = 0.09, body = Color3.fromRGB(90, 130, 170), accent = Color3.fromRGB(235, 240, 245), ears = "none", fin = true },
	{ id = "dragon", name = "Dragón", icon = "🐉", rarity = "legendary", bonus = 0.15, body = Color3.fromRGB(60, 170, 90), accent = Color3.fromRGB(255, 200, 60), ears = "pointy", wings = true, horn = true, sparkles = Color3.fromRGB(120, 255, 150) },
	{ id = "unicorn", name = "Unicornio", icon = "🦄", rarity = "legendary", bonus = 0.15, body = Color3.fromRGB(250, 245, 255), accent = Color3.fromRGB(255, 130, 220), ears = "pointy", horn = true, sparkles = Color3.fromRGB(255, 170, 240) },
	{ id = "phoenix", name = "Fénix dorado", icon = "🔥", rarity = "mythic", bonus = 0.25, body = Color3.fromRGB(255, 150, 30), accent = Color3.fromRGB(255, 225, 80), ears = "none", beak = true, wings = true, fire = true, neon = true },
	{ id = "goldenball", name = "Balonín de oro", icon = "🏆", rarity = "mythic", bonus = 0.25, body = Color3.fromRGB(255, 205, 50), accent = Color3.fromRGB(255, 245, 190), ears = "none", neon = true, sparkles = Color3.fromRGB(255, 230, 120) },

	-- pool = "jungle": solo salen del Huevo de la selva
	{ id = "frog", pool = "jungle", name = "Rana", icon = "🐸", rarity = "common", bonus = 0.02, body = Color3.fromRGB(90, 200, 80), accent = Color3.fromRGB(230, 250, 200), ears = "round" },
	{ id = "chameleon", pool = "jungle", name = "Camaleón", icon = "🦎", rarity = "common", bonus = 0.02, body = Color3.fromRGB(60, 190, 160), accent = Color3.fromRGB(255, 210, 80), ears = "none", fin = true },
	{ id = "parrot", pool = "jungle", name = "Loro", icon = "🦜", rarity = "rare", bonus = 0.05, body = Color3.fromRGB(230, 50, 50), accent = Color3.fromRGB(60, 140, 255), ears = "none", beak = true, wings = true },
	{ id = "monkey", pool = "jungle", name = "Mono", icon = "🐵", rarity = "rare", bonus = 0.05, body = Color3.fromRGB(140, 95, 60), accent = Color3.fromRGB(240, 200, 160), ears = "round" },
