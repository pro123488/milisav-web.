<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4"><Item class="ReplicatedStorage" referent="RBX0000001B"><Properties><string name="Name">ReplicatedStorage</string></Properties><Item class="Folder" referent="RBX0000001A"><Properties><string name="Name">Shared</string></Properties><Item class="Folder" referent="RBX00000010"><Properties><string name="Name">Config</string></Properties><Item class="ModuleScript" referent="RBX00000001"><Properties><string name="Name">CommercialConfig</string><ProtectedString name="Source"><![CDATA[-- CommercialConfig (ModuleScript)
-- Ubicación: ReplicatedStorage/Shared/Config/CommercialConfig
--
-- Instalaciones comerciales (FASE 3): políticas de precios de tienda, restauración
-- y abonos, y catálogo de productos que se desbloquean con el nivel de cada instalación.
-- Los ingresos reales salen de EconomyFormulas.Cycle; los productos reparten esos
-- ingresos según su peso para que el jugador vea qué vende.

local CommercialConfig = {}

-- Política de precios de la tienda y de la restauración.
--   spend        multiplicador del gasto por espectador
--   satisfaction efecto sobre la satisfacción de la afición
CommercialConfig.PricePolicies = {
	{ id = "LOW", name = "Económicos", spend = 0.8, satisfaction = 5 },
	{ id = "NORMAL", name = "Normales", spend = 1.0, satisfaction = 0 },
	{ id = "HIGH", name = "Altos", spend = 1.25, satisfaction = -8 },
}
CommercialConfig.DEFAULT_POLICY = "NORMAL"

-- minLevel: nivel de la instalación que lo desbloquea · weight: parte de las ventas
CommercialConfig.ShopProducts = {
	{ id = "scarves", name = "Bufandas", icon = "🧣", minLevel = 1, weight = 3 },
	{ id = "shirts", name = "Camisetas oficiales", icon = "👕", minLevel = 1, weight = 5 },
	{ id = "balls", name = "Balones", icon = "⚽", minLevel = 2, weight = 2 },
	{ id = "caps", name = "Gorras y gorros", icon = "🧢", minLevel = 3, weight = 2 },
	{ id = "collectibles", name = "Coleccionables", icon = "🃏", minLevel = 4, weight = 3 },
	{ id = "premium", name = "Edición premium", icon = "✨", minLevel = 5, weight = 4 },
	{ id = "retro", name = "Camisetas retro", icon = "🎽", minLevel = 6, weight = 3 },
}

CommercialConfig.FoodProducts = {
	{ id = "drinks", name = "Bebidas", icon = "🥤", minLevel = 1, weight = 4 },
	{ id = "hotdogs", name = "Perritos calientes", icon = "🌭", minLevel = 1, weight = 4 },
	{ id = "snacks", name = "Palomitas y snacks", icon = "🍿", minLevel = 2, weight = 2 },
	{ id = "menus", name = "Menús completos", icon = "🍽️", minLevel = 3, weight = 4 },
	{ id = "gourmet", name = "Cocina gourmet", icon = "🥘", minLevel = 5, weight = 4 },
	{ id = "chef", name = "Experiencia de chef", icon = "👨‍🍳", minLevel = 6, weight = 3 },
}

local function find(list, id, default)
	for _, entry in ipairs(list) do
		if entry.id == id then
			return entry
		end
	end
	return default
end

function CommercialConfig.Policy(id)
	return find(CommercialConfig.PricePolicies, id, CommercialConfig.PricePolicies[2])
end

-- Reparte unos ingresos entre los productos desbloqueados con ese nivel.
-- Devuelve { { product, unlocked, revenue } } en el orden del catálogo.
function CommercialConfig.Breakdown(products, level, revenue)
	local totalWeight = 0
	for _, product in ipairs(products) do
		if level >= product.minLevel then
			totalWeight += product.weight
		end
	end
	local result = {}
	for _, product in ipairs(products) do
		local unlocked = level >= product.minLevel
		table.insert(result, {
			product = product,
			unlocked = unlocked,
			revenue = (unlocked and totalWeight > 0) and math.floor(revenue * product.weight / totalWeight) or 0,
		})
	end
	return result
end

return CommercialConfig
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000002"><Properties><string name="Name">CosmeticConfig</string><ProtectedString name="Source"><![CDATA[-- CosmeticConfig (ModuleScript)
-- Ubicación: ReplicatedStorage/Shared/Config/CosmeticConfig
--
-- Catálogo de personalización. Cada elemento puede tener `requiredPass`
-- (clave de GamePassConfig). El SERVIDOR valida la propiedad real antes de
-- permitir seleccionarlo y vuelve a comprobarla al mostrarlo: si la
-- propiedad no está confirmada, se muestra el elemento gratuito por defecto.
--
-- Las ventajas de pago son cosméticas: no dan ventaja económica.

local CosmeticConfig = {}

-- ===== Escudos =====
CosmeticConfig.Crests = {
	{ id = "classic", name = "Clásico", symbol = "⚽" },
	{ id = "star", name = "Estrella", symbol = "⭐" },
	{ id = "lion", name = "León", symbol = "🦁" },
	{ id = "shield", name = "Escudo", symbol = "🛡️" },
	{ id = "castle", name = "Castillo", symbol = "🏰" },
	-- Expansión Cosmética
	{ id = "dragon", name = "Dragón", symbol = "🐉", requiredPass = "COSMETIC_EXPANSION" },
	{ id = "eagle", name = "Águila", symbol = "🦅", requiredPass = "COSMETIC_EXPANSION" },
	{ id = "bolt", name = "Rayo", symbol = "⚡", requiredPass = "COSMETIC_EXPANSION" },
	{ id = "wolf", name = "Lobo", symbol = "🐺", requiredPass = "COSMETIC_EXPANSION" },
	{ id = "phoenix", name = "Fénix", symbol = "🔥", requiredPass = "COSMETIC_EXPANSION" },
	{ id = "trophy", name = "Copa", symbol = "🏆", requiredPass = "COSMETIC_EXPANSION" },
	-- VIP Club
	{ id = "vip_crown", name = "Corona VIP", symbol = "👑", requiredPass = "VIP_CLUB" },
	{ id = "vip_diamond", name = "Diamante VIP", symbol = "💎", requiredPass = "VIP_CLUB" },
	-- Evento «Doces ou Travessuras» (gratis: se canjea con caramelos)
	{ id = "pumpkin", name = "Calabaza", symbol = "🎃", requiredUnlock = "crest_pumpkin" },
}

-- ===== Paletas de colores (primario / secundario) =====
CosmeticConfig.Palettes = {
	{ id = "white_blue", name = "Blanco y azul", primary = Color3.fromRGB(240, 240, 240), secondary = Color3.fromRGB(20, 70, 170) },
	{ id = "red_white", name = "Rojo y blanco", primary = Color3.fromRGB(200, 25, 35), secondary = Color3.fromRGB(245, 245, 245) },
	{ id = "blue_red", name = "Azul y grana", primary = Color3.fromRGB(20, 50, 140), secondary = Color3.fromRGB(150, 20, 50) },
	{ id = "green_white", name = "Verde y blanco", primary = Color3.fromRGB(20, 130, 60), secondary = Color3.fromRGB(245, 245, 245) },
	{ id = "yellow_black", name = "Amarillo y negro", primary = Color3.fromRGB(250, 210, 20), secondary = Color3.fromRGB(25, 25, 25) },
	{ id = "sky_white", name = "Celeste y blanco", primary = Color3.fromRGB(110, 180, 235), secondary = Color3.fromRGB(245, 245, 245) },
	-- Expansión Cosmética
	{ id = "purple_gold", name = "Púrpura real", primary = Color3.fromRGB(90, 30, 140), secondary = Color3.fromRGB(230, 180, 40), requiredPass = "COSMETIC_EXPANSION" },
	{ id = "orange_navy", name = "Naranja y marino", primary = Color3.fromRGB(245, 120, 20), secondary = Color3.fromRGB(15, 30, 70), requiredPass = "COSMETIC_EXPANSION" },
	{ id = "teal_black", name = "Turquesa nocturno", primary = Color3.fromRGB(0, 160, 160), secondary = Color3.fromRGB(20, 20, 30), requiredPass = "COSMETIC_EXPANSION" },
	{ id = "pink_black", name = "Rosa eléctrico", primary = Color3.fromRGB(240, 60, 150), secondary = Color3.fromRGB(25, 25, 25), requiredPass = "COSMETIC_EXPANSION" },
	{ id = "neon_lime", name = "Lima neón", primary = Color3.fromRGB(170, 240, 30), secondary = Color3.fromRGB(30, 30, 40), requiredPass = "COSMETIC_EXPANSION" },
	{ id = "maroon_sky", name = "Burdeos y cielo", primary = Color3.fromRGB(120, 25, 45), secondary = Color3.fromRGB(140, 200, 240), requiredPass = "COSMETIC_EXPANSION" },
	-- VIP Club
	{ id = "vip_gold", name = "Oro VIP", primary = Color3.fromRGB(212, 175, 55), secondary = Color3.fromRGB(20, 20, 20), requiredPass = "VIP_CLUB" },
	{ id = "vip_platinum", name = "Platino VIP", primary = Color3.fromRGB(220, 225, 230), secondary = Color3.fromRGB(212, 175, 55), requiredPass = "VIP_CLUB" },
	-- Evento de Halloween
	{ id = "halloween", name = "Noche de Halloween", primary = Color3.fromRGB(240, 120, 20), secondary = Color3.fromRGB(35, 15, 45), requiredUnlock = "palette_halloween" },
}

-- ===== Plantillas de equipación =====
-- pattern: lo interpretan el renderizador del estadio y la vista previa de la interfaz.
CosmeticConfig.Kits = {
	{ id = "plain", name = "Lisa", pattern = "plain" },
	{ id = "vstripes", name = "Rayas verticales", pattern = "vstripes" },
	{ id = "halves", name = "Mitades", pattern = "halves" },
	-- Expansión Cosmética
	{ id = "hoops", name = "Rayas horizontales", pattern = "hoops", requiredPass = "COSMETIC_EXPANSION" },
	{ id = "sash", name = "Banda diagonal", pattern = "sash", requiredPass = "COSMETIC_EXPANSION" },
	{ id = "chest", name = "Franja central", pattern = "chest", requiredPass = "COSMETIC_EXPANSION" },
	{ id = "quarters", name = "Cuartos", pattern = "quarters", requiredPass = "COSMETIC_EXPANSION" },
}

-- ===== Efectos visuales cosméticos (en el estadio) =====
CosmeticConfig.Effects = {
	{ id = "none", name = "Sin efecto" },
	{ id = "confetti", name = "Confeti", requiredPass = "COSMETIC_EXPANSION" },
	{ id = "sparkles", name = "Destellos", requiredPass = "COSMETIC_EXPANSION" },
	{ id = "smoke", name = "Bengalas de humo (colores del club)", requiredPass = "COSMETIC_EXPANSION" },
	{ id = "vip_gold", name = "Brillo dorado VIP", requiredPass = "VIP_CLUB" },
	{ id = "bats", name = "Murciélagos", requiredUnlock = "effect_bats" }, -- evento de Halloween
}

-- ===== Diseños de construcción (Constructor Pro) =====
-- appliesTo: "stands" para gradas, "building" para edificios (tienda, restaurante, vestuarios...).
CosmeticConfig.BuildDesigns = {
	{ id = "classic", name = "Clásico", appliesTo = "stands", material = "Concrete", roof = false },
	{ id = "modern", name = "Moderno", appliesTo = "stands", material = "SmoothPlastic", roof = true },
	{ id = "cantilever_pro", name = "Voladizo Pro", appliesTo = "stands", material = "Metal", roof = true, canopy = true, requiredPass = "CONSTRUCTOR_PRO" },
	{ id = "arena_pro", name = "Arena Futurista", appliesTo = "stands", material = "Glass", roof = true, neon = true, requiredPass = "CONSTRUCTOR_PRO" },

	{ id = "brick", name = "Ladrillo", appliesTo = "building", material = "Brick" },
	{ id = "glass", name = "Cristal", appliesTo = "building", material = "Glass" },
	{ id = "steel_pro", name = "Acero Pro", appliesTo = "building", material = "DiamondPlate", requiredPass = "CONSTRUCTOR_PRO" },
	{ id = "neon_pro", name = "Neón Pro", appliesTo = "building", material = "Neon", requiredPass = "CONSTRUCTOR_PRO" },
}

-- ===== Decoraciones (se compran con dinero del juego y se colocan libremente en la plaza del terreno) =====
-- w, d = huella en planta (studs) sin rotar; la usa PlacementRules para validar la colocación.
CosmeticConfig.Decorations = {
	{ id = "flags", name = "Banderas del club", cost = 500, w = 10, d = 3 },
	{ id = "planters", name = "Jardineras", cost = 400, w = 6, d = 4 },
	{ id = "bench", name = "Banco de aficionados", cost = 300, w = 8, d = 3 },
	{ id = "ball_statue", name = "Balón monumental", cost = 1500, w = 6, d = 6 },
	-- Constructor Pro
	{ id = "pro_arch", name = "Arco de entrada Pro", cost = 2500, w = 12, d = 3, requiredPass = "CONSTRUCTOR_PRO" },
	{ id = "pro_fountain", name = "Fuente Pro", cost = 2000, w = 10, d = 10, requiredPass = "CONSTRUCTOR_PRO" },
	{ id = "pro_screen", name = "Pantalla gigante Pro", cost = 3000, w = 11, d = 2, requiredPass = "CONSTRUCTOR_PRO" },
	-- Expansión Cosmética
	{ id = "cos_banner", name = "Pancarta gigante", cost = 1200, w = 11, d = 2, requiredPass = "COSMETIC_EXPANSION" },
	{ id = "cos_fireworks", name = "Torre de fuegos artificiales", cost = 1800, w = 3, d = 3, requiredPass = "COSMETIC_EXPANSION" },
	-- VIP Club
	{ id = "vip_carpet", name = "Alfombra roja VIP", cost = 1000, w = 6, d = 12, requiredPass = "VIP_CLUB" },
	{ id = "vip_statue", name = "Estatua dorada VIP", cost = 2500, w = 5, d = 5, requiredPass = "VIP_CLUB" },
	-- Evento de Halloween (se desbloquea con caramelos)
	{ id = "pumpkin_giant", name = "Calabaza gigante", cost = 300, w = 6, d = 6, requiredUnlock = "deco_pumpkin" },
}

-- Reembolso al retirar una decoración.
CosmeticConfig.DECORATION_REFUND = 0.5
-- Bonificación de atractivo por decoración. Solo cuentan tantas decoraciones como permita
-- la etapa del estadio (límite gratuito), de modo que Constructor Pro no da ventaja económica.
CosmeticConfig.DECORATION_ATTRACTIVENESS = 0.01

CosmeticConfig.Defaults = {
	crest = "classic",
	palette = "white_blue",
	kit = "plain",
	effect = "none",
	standsDesign = "classic",
	buildingDesign = "brick",
}

local function index(list)
	local map = {}
	for _, item in ipairs(list) do
		map[item.id] = item
	end
	return map
end

CosmeticConfig.ById = {
	crest = index(CosmeticConfig.Crests),
	palette = index(CosmeticConfig.Palettes),
	kit = index(CosmeticConfig.Kits),
	effect = index(CosmeticConfig.Effects),
	design = index(CosmeticConfig.BuildDesigns),
	decoration = index(CosmeticConfig.Decorations),
}

-- Categorías de apariencia que el jugador puede cambiar y el catálogo que valida cada una.
CosmeticConfig.AppearanceSlots = {
	crest = { catalog = "crest" },
	palette = { catalog = "palette" },
	kit = { catalog = "kit" },
	effect = { catalog = "effect" },
	standsDesign = { catalog = "design", appliesTo = "stands" },
	buildingDesign = { catalog = "design", appliesTo = "building" },
}

return CosmeticConfig
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000003"><Properties><string name="Name">FacilityConfig</string><ProtectedString name="Source"><![CDATA[-- FacilityConfig (ModuleScript)
-- Ubicación: ReplicatedStorage/Shared/Config/FacilityConfig
--
-- Catálogo de instalaciones del estadio. Cada nivel define:
--   cost        coste de construir/mejorar HASTA ese nivel (gasto de construcción)
--   upkeep      mantenimiento por ciclo económico
--   staff       coste de personal por ciclo
--   reputation  reputación que aporta
--   minStage    etapa del estadio evolutivo necesaria (ver StadiumStages)
--   requires    { idInstalación = nivelMínimo } necesarios para ese nivel
-- y efectos concretos: capacity, attractiveness, shopSpend, foodSpend, vipIncome, tourRate.
--
-- Para añadir una instalación nueva basta con añadir una entrada aquí y,
-- opcionalmente, un constructor visual en StadiumRenderer.

local FacilityConfig = {}

FacilityConfig.Facilities = {
	pitch = {
		id = "pitch",
		name = "Césped",
		icon = "🌱",
		category = "Terreno de juego",
		description = "La calidad del césped hace más atractivo tu estadio.",
		startLevel = 1,
		levels = {
			{ cost = 0, upkeep = 15, staff = 0, reputation = 1, attractiveness = 0.00, minStage = 1 },
			{ cost = 3500, upkeep = 25, staff = 5, reputation = 3, attractiveness = 0.05, minStage = 1 },
			{ cost = 9000, upkeep = 40, staff = 10, reputation = 6, attractiveness = 0.10, minStage = 1 },
			{ cost = 22000, upkeep = 60, staff = 15, reputation = 10, attractiveness = 0.16, minStage = 2 },
			{ cost = 55000, upkeep = 90, staff = 20, reputation = 15, attractiveness = 0.22, minStage = 3 },
		},
	},
	stands = {
		id = "stands",
		name = "Gradas",
		icon = "🏟️",
		category = "Aforo",
		description = "Más asientos = más aficionados en cada jornada.",
		startLevel = 1,
		designable = true,
		levels = {
			{ cost = 0, upkeep = 20, staff = 0, reputation = 1, capacity = 400, minStage = 1 },
			{ cost = 6000, upkeep = 45, staff = 10, reputation = 3, capacity = 1200, minStage = 1 },
			{ cost = 15000, upkeep = 80, staff = 20, reputation = 6, capacity = 2500, minStage = 1,
				requires = { pitch = 2, lockers = 2 } },
			{ cost = 40000, upkeep = 140, staff = 35, reputation = 10, capacity = 4500, minStage = 2 },
			{ cost = 90000, upkeep = 240, staff = 50, reputation = 16, capacity = 8000, minStage = 3 },
			{ cost = 200000, upkeep = 400, staff = 70, reputation = 24, capacity = 14000, minStage = 4 },
			{ cost = 450000, upkeep = 650, staff = 100, reputation = 32, capacity = 22000, minStage = 6 },
		},
	},
	lighting = {
		id = "lighting",
		name = "Iluminación",
		icon = "💡",
		category = "Ambiente",
		description = "Focos para jornadas nocturnas: más atractivo y reputación.",
		startLevel = 0,
		levels = {
			{ cost = 4000, upkeep = 15, staff = 5, reputation = 2, attractiveness = 0.06, minStage = 1 },
			{ cost = 11000, upkeep = 30, staff = 10, reputation = 4, attractiveness = 0.10, minStage = 1,
				requires = { pitch = 2 } },
			{ cost = 30000, upkeep = 55, staff = 15, reputation = 7, attractiveness = 0.15, minStage = 2 },
			{ cost = 70000, upkeep = 90, staff = 20, reputation = 11, attractiveness = 0.20, minStage = 3 },
			{ cost = 150000, upkeep = 140, staff = 30, reputation = 15, attractiveness = 0.26, minStage = 5 },
		},
	},
	scoreboard = {
		id = "scoreboard",
		name = "Marcador",
		icon = "📟",
		category = "Ambiente",
		description = "Un marcador muestra el nombre de tu club y mejora la experiencia.",
		startLevel = 0,
		levels = {
			{ cost = 2500, upkeep = 8, staff = 0, reputation = 1, attractiveness = 0.04, minStage = 1 },
			{ cost = 8000, upkeep = 18, staff = 5, reputation = 3, attractiveness = 0.07, minStage = 1,
				requires = { lighting = 1 } },
			{ cost = 25000, upkeep = 35, staff = 10, reputation = 6, attractiveness = 0.11, minStage = 2 },
		},
	},
	lockers = {
		id = "lockers",
		name = "Vestuarios",
		icon = "🚿",
		category = "Club",
		description = "Mejores vestuarios aumentan la reputación del club (y la moral de la plantilla en la FASE 4).",
		startLevel = 1,
		designable = true,
		levels = {
			{ cost = 0, upkeep = 10, staff = 0, reputation = 1, minStage = 1 },
			{ cost = 5000, upkeep = 20, staff = 10, reputation = 3, minStage = 1 },
			{ cost = 14000, upkeep = 35, staff = 15, reputation = 5, minStage = 1 },
			{ cost = 35000, upkeep = 60, staff = 25, reputation = 8, minStage = 2 },
		},
	},
	shop = {
		id = "shop",
		name = "Tienda del club",
		icon = "🛍️",
		category = "Comercial",
		description = "Cada aficionado que asiste gasta en camisetas y bufandas.",
		startLevel = 0,
		designable = true,
		levels = {
			{ cost = 3000, upkeep = 15, staff = 15, reputation = 1, shopSpend = 0.8, minStage = 1 },
			{ cost = 9000, upkeep = 30, staff = 25, reputation = 2, shopSpend = 1.4, minStage = 1 },
			{ cost = 20000, upkeep = 55, staff = 35, reputation = 3, shopSpend = 2.1, minStage = 1,
				requires = { stands = 3 } },
			{ cost = 45000, upkeep = 95, staff = 50, reputation = 5, shopSpend = 2.9, minStage = 2 },
			{ cost = 100000, upkeep = 160, staff = 70, reputation = 7, shopSpend = 3.8, minStage = 3 },
			{ cost = 220000, upkeep = 260, staff = 95, reputation = 10, shopSpend = 5.0, minStage = 5 },
		},
	},
	restaurant = {
		id = "restaurant",
		name = "Restaurante",
		icon = "🍔",
		category = "Comercial",
		description = "Comida y bebida para los aficionados en cada jornada.",
		startLevel = 0,
		designable = true,
		levels = {
			{ cost = 3500, upkeep = 18, staff = 15, reputation = 1, foodSpend = 1.0, minStage = 1 },
			{ cost = 10000, upkeep = 35, staff = 25, reputation = 2, foodSpend = 1.7, minStage = 1 },
			{ cost = 23000, upkeep = 60, staff = 35, reputation = 3, foodSpend = 2.5, minStage = 1,
				requires = { stands = 3 } },
			{ cost = 50000, upkeep = 100, staff = 50, reputation = 5, foodSpend = 3.4, minStage = 2 },
			{ cost = 110000, upkeep = 170, staff = 70, reputation = 7, foodSpend = 4.4, minStage = 3 },
			{ cost = 240000, upkeep = 280, staff = 95, reputation = 10, foodSpend = 5.6, minStage = 5 },
		},
	},

	-- ===== Instalaciones comerciales (FASE 3) =====
	kiosks = {
		id = "kiosks",
		name = "Quioscos",
		icon = "🌭",
		category = "Comercial",
		description = "Puestos de comida junto a las gradas: más gasto en restauración por espectador.",
		startLevel = 0,
		levels = {
			{ cost = 2500, upkeep = 8, staff = 10, reputation = 1, foodSpend = 0.3, minStage = 1 },
			{ cost = 7000, upkeep = 16, staff = 15, reputation = 1, foodSpend = 0.6, minStage = 1 },
			{ cost = 18000, upkeep = 30, staff = 25, reputation = 2, foodSpend = 1.0, minStage = 2 },
		},
	},
	tour = {
		id = "tour",
		name = "Tour del estadio",
		icon = "🗺️",
		category = "Comercial",
		description = "Visitas guiadas: ingresos en cada jornada según la reputación del club.",
		startLevel = 0,
		levels = {
			{ cost = 25000, upkeep = 40, staff = 20, reputation = 2, tourRate = 8, minStage = 2 },
			{ cost = 80000, upkeep = 80, staff = 35, reputation = 4, tourRate = 15, minStage = 3 },
			{ cost = 220000, upkeep = 150, staff = 60, reputation = 7, tourRate = 25, minStage = 5 },
		},
	},

	-- ===== Instalaciones que se desbloquean con el ESTADIO EVOLUTIVO (FASE 2+) =====
	vip = {
		id = "vip",
		name = "Zona VIP",
		icon = "🥂",
		category = "Comercial",
		description = "Palcos para patrocinadores e invitados. Ingresos extra por jornada.",
		startLevel = 0,
		designable = true,
		levels = {
			{ cost = 50000, upkeep = 120, staff = 40, reputation = 6, vipIncome = 900, minStage = 2 },
			{ cost = 120000, upkeep = 220, staff = 60, reputation = 10, vipIncome = 2200, minStage = 3 },
			{ cost = 300000, upkeep = 400, staff = 90, reputation = 16, vipIncome = 5000, minStage = 5 },
		},
	},
	training = {
		id = "training",
		name = "Centro de entrenamiento",
		icon = "🏋️",
		category = "Deportivo",
		description = "Aumenta la reputación del club. Mejorará el desarrollo de la plantilla en la FASE 4.",
		startLevel = 0,
		designable = true,
		levels = {
			{ cost = 40000, upkeep = 100, staff = 40, reputation = 4, minStage = 2 },
			{ cost = 110000, upkeep = 200, staff = 70, reputation = 8, minStage = 3 },
			{ cost = 280000, upkeep = 380, staff = 110, reputation = 13, minStage = 4 },
		},
	},
	academy = {
		id = "academy",
		name = "Academia juvenil",
		icon = "🧒",
		category = "Deportivo",
		description = "Aumenta la reputación del club. Será la base de la CANTERA GENERACIONAL (FASE 4).",
		startLevel = 0,
		designable = true,
		levels = {
			{ cost = 45000, upkeep = 110, staff = 45, reputation = 4, minStage = 2 },
			{ cost = 120000, upkeep = 220, staff = 80, reputation = 8, minStage = 3 },
			{ cost = 300000, upkeep = 400, staff = 120, reputation = 13, minStage = 5 },
		},
	},
	trophyRoom = {
		id = "trophyRoom",
		name = "Sala de trofeos",
		icon = "🏆",
		category = "Club",
		description = "Atractivo para los visitantes. Exhibirá los títulos reales del club (FASES 7-8).",
		startLevel = 0,
		designable = true,
		levels = {
			{ cost = 30000, upkeep = 40, staff = 10, reputation = 5, attractiveness = 0.03, minStage = 2 },
			{ cost = 90000, upkeep = 80, staff = 20, reputation = 9, attractiveness = 0.06, minStage = 4 },
			{ cost = 250000, upkeep = 150, staff = 35, reputation = 14, attractiveness = 0.09, minStage = 6 },
		},
	},
}

-- Orden en la interfaz de construcción.
FacilityConfig.Order = {
	"pitch", "stands", "lighting", "scoreboard", "lockers", "shop", "restaurant",
	"kiosks", "tour", "vip", "training", "academy", "trophyRoom",
}

function FacilityConfig.Get(id)
	return FacilityConfig.Facilities[id]
end

function FacilityConfig.MaxLevel(id)
	local def = FacilityConfig.Facilities[id]
	return def and #def.levels or 0
end

-- Devuelve los datos del nivel `level` (nil si level == 0 o no existe).
function FacilityConfig.LevelData(id, level)
	local def = FacilityConfig.Facilities[id]
	if not def or level < 1 then
		return nil
	end
	return def.levels[level]
end

return FacilityConfig
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000004"><Properties><string name="Name">FootballConfig</string><ProtectedString name="Source"><![CDATA[-- FootballConfig (ModuleScript)
-- Ubicación: ReplicatedStorage/Shared/Config/FootballConfig
--
-- Futbolistas, contratos, temporadas y CANTERA GENERACIONAL (FASE 4).
-- Todos los nombres se generan combinando listas: son jugadores ficticios.

local FootballConfig = {}

-- ===== Temporada =====
-- Una temporada dura SEASON_LENGTH jornadas (ciclos económicos). Al terminar:
-- los jugadores cumplen años, los contratos avanzan, hay retiradas y llega una
-- nueva hornada a la cantera. Las ligas (FASE 7) usarán este mismo reloj.
FootballConfig.SEASON_LENGTH = 30

-- ===== Plantilla =====
FootballConfig.MAX_SQUAD = 25
FootballConfig.MIN_SQUAD = 14 -- no se puede bajar de aquí al rescindir o vender
FootballConfig.CONTRACT_MAX_SEASONS = 5
FootballConfig.RENEW_WINDOW = 2 -- se puede renovar cuando quedan 2 temporadas o menos
FootballConfig.RELEASE_COST_SHARE = 0.25 -- rescindir cuesta el 25 % del salario restante

FootballConfig.Positions = {
	{ id = "GK", name = "Portero", short = "POR", icon = "🧤" },
	{ id = "DEF", name = "Defensa", short = "DEF", icon = "🛡️" },
	{ id = "MID", name = "Centrocampista", short = "MED", icon = "🎯" },
	{ id = "FWD", name = "Delantero", short = "DEL", icon = "⚽" },
}

FootballConfig.Attributes = {
	{ id = "pace", name = "Velocidad", short = "VEL" },
	{ id = "shooting", name = "Tiro", short = "TIR" },
	{ id = "passing", name = "Pase", short = "PAS" },
	{ id = "dribbling", name = "Regate", short = "REG" },
	{ id = "defending", name = "Defensa", short = "DEF" },
	{ id = "stamina", name = "Resistencia", short = "RES" },
}

-- Peso de cada atributo en la media según la posición (cada fila suma 1).
-- Para el portero, "Defensa" representa sus paradas.
FootballConfig.Weights = {
	GK = { pace = 0.15, shooting = 0.00, passing = 0.15, dribbling = 0.05, defending = 0.55, stamina = 0.10 },
	DEF = { pace = 0.15, shooting = 0.05, passing = 0.15, dribbling = 0.05, defending = 0.45, stamina = 0.15 },
	MID = { pace = 0.10, shooting = 0.15, passing = 0.30, dribbling = 0.20, defending = 0.10, stamina = 0.15 },
	FWD = { pace = 0.20, shooting = 0.35, passing = 0.10, dribbling = 0.20, defending = 0.05, stamina = 0.10 },
}

-- Perfil típico de cada posición al generar jugadores (desviación sobre la media objetivo).
FootballConfig.Bias = {
	GK = { pace = -8, shooting = -25, passing = -5, dribbling = -15, defending = 8, stamina = -3 },
	DEF = { pace = -2, shooting = -15, passing = -3, dribbling = -10, defending = 8, stamina = 2 },
	MID = { pace = -2, shooting = -2, passing = 6, dribbling = 3, defending = -8, stamina = 3 },
	FWD = { pace = 4, shooting = 7, passing = -4, dribbling = 3, defending = -25, stamina = -2 },
}

-- Plantilla inicial de un club nuevo
FootballConfig.STARTING_SQUAD = { GK = 2, DEF = 5, MID = 5, FWD = 4 }
FootballConfig.STARTING_OVERALL = { min = 42, max = 54 }

-- ===== Valor y salario (exponenciales con la media) =====
FootballConfig.VALUE_BASE = 1000 -- valor de un jugador de media 45
FootballConfig.VALUE_GROWTH = 1.14
FootballConfig.SALARY_BASE = 8 -- salario por jornada de un jugador de media 45
FootballConfig.SALARY_GROWTH = 1.09
FootballConfig.YOUTH_SALARY_SHARE = 0.6 -- salario del primer contrato de un canterano

-- ===== Entrenamiento y evolución =====
FootballConfig.BASE_GROWTH = 0.17 -- puntos de media por jornada en las mejores condiciones
FootballConfig.GROWTH_GAP = 15 -- con 15 o más puntos de margen hasta el potencial se crece al máximo
FootballConfig.AgeRates = { -- multiplicador de evolución por edad (negativo = declive)
	{ maxAge = 17, rate = 1.2 },
	{ maxAge = 21, rate = 1.0 },
	{ maxAge = 24, rate = 0.7 },
	{ maxAge = 27, rate = 0.35 },
	{ maxAge = 30, rate = 0.1 },
	{ maxAge = 32, rate = -0.2 },
	{ maxAge = 99, rate = -0.5 },
}
FootballConfig.TrainingIntensities = {
	{ id = "LIGHT", name = "Suave", growth = 0.7 },
	{ id = "NORMAL", name = "Normal", growth = 1.0 },
	{ id = "INTENSE", name = "Intensa", growth = 1.3 },
}
FootballConfig.TRAINING_FACILITY_BONUS = 0.2 -- +20 % por nivel del Centro de entrenamiento
FootballConfig.FOCUS_WEIGHT = 0.4 -- peso extra del atributo en el que se centra el entrenamiento

-- ===== Retirada y leyendas =====
FootballConfig.RETIRE_MIN_AGE = 33
FootballConfig.RETIRE_CHANCE_PER_YEAR = 0.25 -- 33 años: 25 %, 34: 50 %, ...
FootballConfig.RETIRE_FORCED_AGE = 37
FootballConfig.LEGEND_MIN_PEAK = 72 -- media máxima para entrar en las leyendas del club
FootballConfig.LEGEND_MIN_ACADEMY_PEAK = 65 -- los canteranos entran antes
FootballConfig.LEGEND_MIN_APPS = 150

-- ===== Cantera =====
FootballConfig.YOUTH_MIN_PROMOTE_AGE = 16
FootballConfig.YOUTH_MAX_AGE = 18 -- con 19 años dejan la academia si no suben al primer equipo
FootballConfig.YOUTH_START_AGE = { min = 15, max = 16 }
FootballConfig.YOUTH_OVERALL = { min = 28, max = 44 }
-- Por nivel de la Academia juvenil (0 = cantera básica sin instalación)
FootballConfig.AcademyLevels = {
	[0] = { capacity = 4, intake = 1, potentialMin = 50, potentialMax = 72, growth = 1.0 },
	[1] = { capacity = 6, intake = 2, potentialMin = 55, potentialMax = 78, growth = 1.25 },
	[2] = { capacity = 8, intake = 3, potentialMin = 60, potentialMax = 84, growth = 1.5 },
	[3] = { capacity = 10, intake = 4, potentialMin = 65, potentialMax = 90, growth = 1.75 },
}
FootballConfig.GEM_CHANCE = 0.05 -- probabilidad de "joya" (+8 de potencial)
FootballConfig.GEM_CHANCE_PER_SCOUT = 0.02
FootballConfig.GEM_BONUS = 8
FootballConfig.STAR_POTENTIAL = 85 -- se marca como ⭐ si el potencial estimado mínimo llega aquí

-- ===== Ojeadores =====
FootballConfig.MAX_SCOUTS = 3
FootballConfig.SCOUT_COSTS = { 150, 400, 800 } -- coste total por jornada con 1, 2 o 3 ojeadores
FootballConfig.SCOUT_POTENTIAL_BONUS = 2 -- +2 al rango de potencial por ojeador
FootballConfig.SCOUT_REPORT_CYCLES = 10 -- cada cuántas jornadas llega un informe
FootballConfig.SCOUT_ERROR = { [0] = 12, [1] = 8, [2] = 4, [3] = 0 } -- margen del potencial estimado
FootballConfig.SCOUT_SIGN_BASE = 500
FootballConfig.SCOUT_SIGN_PER_POTENTIAL2 = 0.8 -- fichaje de un juvenil = base + potencial² × 0,8

-- ===== Nombres ficticios =====
FootballConfig.FirstNames = {
	"Álex", "Bruno", "Carlos", "Dani", "Emilio", "Fabián", "Gonzalo", "Héctor", "Iker", "Javier",
	"Kevin", "Lucas", "Mateo", "Nico", "Óscar", "Pablo", "Rafa", "Santi", "Tomás", "Unai",
	"Víctor", "Yago", "Adrián", "Bastián", "Cristian", "Diego", "Enzo", "Facundo", "Gael", "Hugo",
	"Iván", "Joaquín", "Leo", "Marco", "Nahuel", "Rodrigo", "Samuel", "Thiago", "Valentín", "Martín",
	"André", "João", "Luca", "Mamadou", "Kenji", "Omar", "Erik", "Jonas", "Malik", "Sergi",
}
FootballConfig.LastNames = {
	"García", "Rodríguez", "Fernández", "López", "Martínez", "Sánchez", "Pérez", "Gómez", "Ruiz", "Díaz",
	"Moreno", "Álvarez", "Romero", "Navarro", "Torres", "Domínguez", "Vázquez", "Ramos", "Gil", "Serrano",
	"Molina", "Ortega", "Delgado", "Castro", "Ortiz", "Rubio", "Marín", "Sanz", "Núñez", "Iglesias",
	"Medina", "Garrido", "Cortés", "Castillo", "Santos", "Lozano", "Guerrero", "Cano", "Prieto", "Méndez",
	"Silva", "Costa", "Rossi", "Diallo", "Tanaka", "Haddad", "Larsen", "Weber", "Okafor", "Vidal",
}

function FootballConfig.Position(id)
	for _, p in ipairs(FootballConfig.Positions) do
		if p.id == id then
			return p
		end
	end
	return FootballConfig.Positions[3]
end

function FootballConfig.Intensity(id)
	for _, i in ipairs(FootballConfig.TrainingIntensities) do
		if i.id == id then
			return i
		end
	end
	return FootballConfig.TrainingIntensities[2]
end

function FootballConfig.AgeRate(age)
	for _, entry in ipairs(FootballConfig.AgeRates) do
		if age <= entry.maxAge then
			return entry.rate
		end
	end
	return -0.5
end

function FootballConfig.Academy(level)
	return FootballConfig.AcademyLevels[math.clamp(level or 0, 0, 3)]
end

return FootballConfig
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000005"><Properties><string name="Name">GameConfig</string><ProtectedString name="Source"><![CDATA[-- GameConfig (ModuleScript)
-- Ubicación: ReplicatedStorage/Shared/Config/GameConfig
--
-- Constantes generales del juego y del equilibrio económico.
-- Todo el equilibrio se ajusta desde aquí, sin tocar la lógica.

local GameConfig = {}

GameConfig.GAME_NAME = "FOOTBALL EMPIRE ULTIMATE"
GameConfig.VERSION = "0.8.0-fase8"
GameConfig.CURRENCY = "$"

-- ===== Guardado =====
GameConfig.DATASTORE_NAME = "FEU_Clubs_v1"
GameConfig.DATA_VERSION = 8 -- v8: historia del club y universo
GameConfig.AUTOSAVE_SECONDS = 120
GameConfig.SESSION_LOCK_SECONDS = 600 -- un bloqueo más antiguo se considera abandonado
GameConfig.MAX_TRANSACTIONS = 60

-- ===== Economía =====
GameConfig.STARTING_MONEY = 15000
GameConfig.ECONOMY_CYCLE_SECONDS = 60 -- cada ciclo = una jornada de actividad del estadio
GameConfig.STARTING_FANS = 250

-- Precio de entradas: decisión del jugador con efecto real sobre la asistencia.
GameConfig.TICKET_PRICES = {
	{ id = "LOW", name = "Económico", price = 3, demand = 1.20, satisfaction = 10 },
	{ id = "NORMAL", name = "Normal", price = 5, demand = 1.00, satisfaction = 0 },
	{ id = "HIGH", name = "Premium", price = 8, demand = 0.72, satisfaction = -12 },
}
GameConfig.DEFAULT_TICKET = "NORMAL"

-- Parte de los aficionados que acude en cada jornada (antes de aplicar demanda y atractivo).
GameConfig.TURNOUT_RATE = 0.5
-- Crecimiento de aficionados hacia su techo en cada ciclo.
GameConfig.FAN_GROWTH_RATE = 0.03
GameConfig.FAN_CAP_PER_SEAT = 2
GameConfig.FAN_CAP_PER_REPUTATION = 20

-- Patrocinio local básico (además de los contratos de SponsorConfig).
GameConfig.SPONSOR_BASE = 50
GameConfig.SPONSOR_PER_REPUTATION = 2

-- ===== Aficionados (FASE 3) =====
GameConfig.SATISFACTION_START = 60
GameConfig.SATISFACTION_SPEED = 0.10 -- se acerca un 10 % a su objetivo en cada jornada
GameConfig.SATISFACTION_BASE = 50
GameConfig.SATISFACTION_PER_STAGE = 2
GameConfig.SATISFACTION_ATTRACTIVENESS = 40 -- por cada +100 % de atractivo
GameConfig.SATISFACTION_ATTRACTIVENESS_MAX = 30
GameConfig.OVERCROWD_THRESHOLD = 1.2 -- demanda > 120 % del aforo
GameConfig.OVERCROWD_PENALTY = 8
GameConfig.FAN_DECLINE_SATISFACTION = 25 -- por debajo, los aficionados se van
GameConfig.FAN_DECLINE_RATE = 0.01
-- Socios (abonados): pagan cuota en cada jornada y siempre ocupan su asiento.
GameConfig.MEMBER_RATE_MIN = 0.08 -- proporción de aficionados que se hacen socios con satisfacción 0
GameConfig.MEMBER_RATE_MAX = 0.35 -- ... y con satisfacción 100
GameConfig.MEMBER_SEAT_SHARE = 0.6 -- como máximo el 60 % de los asientos son de socios
GameConfig.MEMBER_SPEED = 0.05
GameConfig.MEMBER_PRICES = {
	{ id = "LOW", name = "Económica", fee = 1, demand = 1.25, satisfaction = 5 },
	{ id = "NORMAL", name = "Normal", fee = 2, demand = 1.00, satisfaction = 0 },
	{ id = "HIGH", name = "Premium", fee = 3.5, demand = 0.70, satisfaction = -10 },
}

-- Personal: coste fijo + coste por instalación construida.
GameConfig.STAFF_BASE = 60

-- Deuda
GameConfig.DEBT_INTEREST_PER_CYCLE = 0.01 -- 1 % por ciclo
GameConfig.DEBT_AUTO_REPAY_SHARE = 0.25 -- parte del beneficio que amortiza deuda automáticamente
GameConfig.DEBT_BUILD_LIMIT = 10000 -- por encima de esta deuda no se permiten construcciones

-- Valor del club
GameConfig.VALUE_INVESTMENT_SHARE = 0.7
GameConfig.VALUE_PER_FAN = 8
GameConfig.VALUE_PER_REPUTATION = 400

-- Presupuestos (se usarán con plantilla y fichajes en las FASES 4 y 6)
GameConfig.WAGE_BUDGET_SHARE_OF_INCOME = 0.4
GameConfig.TRANSFER_BUDGET_SHARE_OF_MONEY = 0.25

-- ===== Club =====
GameConfig.CLUB_NAME_MIN = 3
GameConfig.CLUB_NAME_MAX = 24
GameConfig.SHORT_NAME_LEN = 3

-- ===== Construcción =====
-- Límite de decoraciones: lo marca la etapa del estadio (StadiumStages.effects.freeDecorations).
-- Constructor Pro añade PRO_EXTRA_DECORATIONS, siempre dentro de las zonas del propio terreno.
GameConfig.PRO_EXTRA_DECORATIONS = 6
GameConfig.MAX_DECORATIONS = 18 -- tope absoluto (12 de la etapa 7 + 6 de Constructor Pro)
-- Herramientas de colocación
GameConfig.FREE_GRID = 4 -- studs
GameConfig.PRO_GRID = 1 -- Constructor Pro: rejilla fina
GameConfig.FREE_ROTATION_STEP = 90 -- grados
GameConfig.PRO_ROTATION_STEP = 45 -- Constructor Pro: rotación a 45°
GameConfig.MAX_HISTORY_EVENTS = 100

-- ===== Terrenos =====
GameConfig.PLOT_COUNT = 8
GameConfig.PLOT_SIZE = Vector3.new(300, 1, 210)
GameConfig.PLOT_SPACING = 40

-- ===== Seguridad =====
GameConfig.ACTION_RATE_LIMIT = 12 -- acciones por ventana
GameConfig.ACTION_RATE_WINDOW = 5 -- segundos

-- ===== Game Passes =====
GameConfig.OWNERSHIP_RETRY_ATTEMPTS = 3
GameConfig.OWNERSHIP_RECHECK_SECONDS = 90 -- reintento en segundo plano cuando Roblox no responde
GameConfig.PRICE_CACHE_SECONDS = 600

return GameConfig
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000006"><Properties><string name="Name">GamePassConfig</string><ProtectedString name="Source"><![CDATA[-- GamePassConfig (ModuleScript)
-- Ubicación: ReplicatedStorage/Shared/Config/GamePassConfig
--
-- Configuración CENTRALIZADA de los Game Passes de FOOTBALL EMPIRE ULTIMATE.
--
-- ⚠️ IMPORTANTE
--   * Todos los identificadores están en 0 = "PENDIENTE DE CONFIGURACIÓN".
--   * Ninguno de estos pases existe todavía en Roblox hasta que los crees en el
--     Creator Dashboard (Monetización > Pases) y copies aquí su ID numérico.
--   * Mientras el ID sea 0, la tienda muestra "Pendiente de configuración",
--     el botón de compra está desactivado y NUNCA se conceden ventajas.
--   * El precio NO se escribe aquí: se obtiene de Roblox con GetProductInfo.
--
-- Para añadir un pase nuevo en el futuro basta con añadir una entrada a
-- `Passes` y a `Order`. La tienda y el GamePassService lo recogen solos.

export type PassDefinition = {
	key: string,
	id: number, -- 0 = pendiente de configuración
	active: boolean, -- false = pase futuro: no se muestra a la venta todavía
	name: string,
	icon: string, -- emoji usado como icono (puedes sustituirlo por rbxassetid)
	iconImage: string?, -- opcional: "rbxassetid://..." de la imagen del pase
	accent: Color3,
	description: string,
	benefits: { string },
	priority: number,
	phase: number, -- fase del plan de desarrollo en la que se activan sus ventajas
}

local GamePassConfig = {}

GamePassConfig.PENDING_ID = 0

GamePassConfig.Passes = {
	VIP_CLUB = {
		key = "VIP_CLUB",
		id = 0, -- TODO: pega aquí el ID del pase "VIP Club" del Creator Dashboard
		active = true,
		name = "VIP Club",
		icon = "👑",
		accent = Color3.fromRGB(255, 196, 0),
		description = "Haz que tu club destaque en todo el universo futbolístico con un estatus VIP exclusivo.",
		benefits = {
			"Etiqueta VIP en tu perfil y en el cartel de tu estadio",
			"Decoraciones exclusivas VIP para tu estadio",
			"Elementos visuales especiales (iluminación dorada)",
			"Opciones cosméticas VIP para escudos y colores",
		},
		priority = 1,
		phase = 1,
	},
	CONSTRUCTOR_PRO = {
		key = "CONSTRUCTOR_PRO",
		id = 0, -- TODO: pega aquí el ID del pase "Constructor Pro"
		active = true,
		name = "Constructor Pro",
		icon = "🏗️",
		accent = Color3.fromRGB(0, 170, 255),
		description = "Más diseños y herramientas de construcción, siempre dentro de las reglas de tu terreno.",
		benefits = {
			"Diseños de construcción exclusivos para gradas e instalaciones",
			"Herramientas de colocación: rejilla fina (1 stud) y rotación a 45°",
			"Elementos decorativos especiales",
			"+6 decoraciones, siempre dentro de la zona de tu terreno",
		},
		priority = 2,
		phase = 1,
	},
	COSMETIC_EXPANSION = {
		key = "COSMETIC_EXPANSION",
		id = 0, -- TODO: pega aquí el ID del pase "Expansión Cosmética"
		active = true,
		name = "Expansión Cosmética",
		icon = "🎨",
		accent = Color3.fromRGB(230, 60, 140),
		description = "Personaliza la identidad de tu club con escudos, paletas y equipaciones adicionales.",
		benefits = {
			"Diseños adicionales de escudos",
			"Paletas de colores exclusivas",
			"Plantillas de equipaciones adicionales",
			"Decoraciones especiales y efectos visuales cosméticos",
		},
		priority = 3,
		phase = 1,
	},

	-- ===== Pases preparados para fases posteriores (no se venden aún) =====
	ELITE_STADIUM = {
		key = "ELITE_STADIUM",
		id = 0,
		active = false,
		name = "Estadio de Élite",
		icon = "🏟️",
		accent = Color3.fromRGB(140, 90, 255),
		description = "Acabados y estilos de élite para tu estadio evolutivo.",
		benefits = { "Estilos visuales de élite para las 7 etapas del estadio" },
		priority = 4,
		phase = 11, -- se activa con la Tienda Premium completa (FASE 11)
	},
	ELITE_ACADEMY = {
		key = "ELITE_ACADEMY",
		id = 0,
		active = false,
		name = "Academia de Élite",
		icon = "🧬",
		accent = Color3.fromRGB(40, 200, 120),
		description = "Personalización ampliada de la cantera generacional.",
		benefits = { "Opciones visuales y de gestión ampliadas para la academia" },
		priority = 5,
		phase = 11, -- se activa con la Tienda Premium completa (FASE 11)
	},
	CLUB_LEGENDS = {
		key = "CLUB_LEGENDS",
		id = 0,
		active = false,
		name = "Leyendas del Club",
		icon = "📜",
		accent = Color3.fromRGB(255, 120, 40),
		description = "Galería ampliada de leyendas e historia del club.",
		benefits = { "Vitrinas y presentaciones especiales en la historia del club" },
		priority = 6,
		phase = 11, -- se activa con la Tienda Premium completa (FASE 11)
	},
} :: { [string]: PassDefinition }

-- Orden de aparición en la TIENDA PREMIUM.
GamePassConfig.Order = {
	"VIP_CLUB",
	"CONSTRUCTOR_PRO",
	"COSMETIC_EXPANSION",
	"ELITE_STADIUM",
	"ELITE_ACADEMY",
	"CLUB_LEGENDS",
}

function GamePassConfig.Get(key: string): PassDefinition?
	return GamePassConfig.Passes[key]
end

function GamePassConfig.IsConfigured(key: string): boolean
	local def = GamePassConfig.Passes[key]
	return def ~= nil and typeof(def.id) == "number" and def.id > 0
end

function GamePassConfig.GetKeyById(id: number): string?
	if id <= 0 then
		return nil
	end
	for key, def in pairs(GamePassConfig.Passes) do
		if def.id == id then
			return key
		end
	end
	return nil
end

return GamePassConfig
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000007"><Properties><string name="Name">HalloweenConfig</string><ProtectedString name="Source"><![CDATA[-- HalloweenConfig (ModuleScript)
-- Ubicación: ReplicatedStorage/Shared/Config/HalloweenConfig
--
-- EVENTO «DOCES OU TRAVESSURAS» (truco o trato) en el estadio:
--   * Caramelos repartidos por todos los estadios: se recogen caminando sobre ellos.
--   * Puertas de las instalaciones (de cualquier club): «¿Truco o trato?» con la tecla F.
--   * Los caramelos se canjean por premios (dinero y cosméticos de Halloween gratuitos).
-- El evento se activa solo en las fechas indicadas. FORCE_ACTIVE = true lo activa siempre (pruebas).

local HalloweenConfig = {}

HalloweenConfig.FORCE_ACTIVE = false
-- Ventana del evento (mes, día) en hora UTC, ambos incluidos.
HalloweenConfig.START = { month = 10, day = 15 }
HalloweenConfig.FINISH = { month = 11, day = 7 }

HalloweenConfig.NAME = "Doces ou Travessuras"
HalloweenConfig.ICON = "🎃"

-- Caramelos en el mundo
HalloweenConfig.CANDIES_PER_PLOT = 12
HalloweenConfig.CANDY_RESPAWN_SECONDS = 20
HalloweenConfig.GOLDEN_CHANCE = 0.06 -- caramelo dorado
HalloweenConfig.CANDY_VALUE = 1
HalloweenConfig.GOLDEN_VALUE = 5

-- Puertas: «¿Truco o trato?»
HalloweenConfig.DOOR_COOLDOWN = 45 -- segundos por jugador y puerta
HalloweenConfig.TREAT_CHANCE = 0.7
HalloweenConfig.TREAT_MIN = 3
HalloweenConfig.TREAT_MAX = 8
HalloweenConfig.Tricks = {
	{ id = "scare", text = "👻 ¡BUUH! Te han dado un buen susto." },
	{ id = "speed", text = "🏃 ¡Truco! Pies de fantasma: corres muy rápido unos segundos.", walkSpeed = 34, seconds = 8 },
	{ id = "jump", text = "🦇 ¡Truco! Saltos de murciélago durante unos segundos.", jumpPower = 90, seconds = 8 },
	{ id = "fog", text = "🌫️ ¡Truco! Una niebla espesa cubre el estadio.", seconds = 10 },
}

-- Premios a cambio de caramelos
HalloweenConfig.Rewards = {
	{ id = "money_small", name = "Bolsa de monedas", icon = "💰", cost = 30, money = 2000 },
	{ id = "money_big", name = "Cofre del tesoro", icon = "💎", cost = 120, money = 10000 },
	{ id = "deco_pumpkin", name = "Decoración: Calabaza gigante", icon = "🎃", cost = 60, unlock = "deco_pumpkin" },
	{ id = "crest_pumpkin", name = "Escudo: Calabaza", icon = "🛡️", cost = 100, unlock = "crest_pumpkin" },
	{ id = "palette_halloween", name = "Colores: Noche de Halloween", icon = "🎨", cost = 150, unlock = "palette_halloween" },
	{ id = "effect_bats", name = "Efecto: Murciélagos", icon = "🦇", cost = 200, unlock = "effect_bats" },
}

-- Qué facilidades tienen puerta para pedir caramelos
HalloweenConfig.DOOR_FACILITIES = {
	lockers = true, shop = true, restaurant = true, vip = true, training = true,
	academy = true, trophyRoom = true, kiosks = true, tour = true,
}

local function dayNumber(month, day)
	return month * 100 + day
end

function HalloweenConfig.IsActive(now)
	if HalloweenConfig.FORCE_ACTIVE then
		return true
	end
	local t = os.date("!*t", now or os.time())
	local today = dayNumber(t.month, t.day)
	local startDay = dayNumber(HalloweenConfig.START.month, HalloweenConfig.START.day)
	local finishDay = dayNumber(HalloweenConfig.FINISH.month, HalloweenConfig.FINISH.day)
	return today >= startDay and today <= finishDay
end

function HalloweenConfig.Reward(id)
	for _, reward in ipairs(HalloweenConfig.Rewards) do
		if reward.id == id then
			return reward
		end
	end
	return nil
end

return HalloweenConfig
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000008"><Properties><string name="Name">LeagueConfig</string><ProtectedString name="Source"><![CDATA[-- LeagueConfig (ModuleScript)
-- Ubicación: ReplicatedStorage/Shared/Config/LeagueConfig
--
-- LIGAS, COPA Y MODO CARRERA (FASE 7). Todas las competiciones y clubes son ficticios.
-- Calendario dentro de una temporada de FootballConfig.SEASON_LENGTH (30) jornadas:
--   jornadas 0-17  -> 18 jornadas de liga (ida y vuelta, 10 equipos)
--   jornadas 19, 22, 25, 28 -> rondas de copa (octavos, cuartos, semifinal, final)
--   jornada 29     -> cierre de temporada: clasificación final, premios, ascensos y descensos
-- Para añadir divisiones basta con añadir entradas a Divisions (de menor a mayor nivel).

local LeagueConfig = {}

LeagueConfig.Divisions = {
	{ level = 1, name = "Liga Regional", strength = { 40, 50 }, prize = 1, promote = 2, relegate = 0 },
	{ level = 2, name = "Tercera División", strength = { 48, 58 }, prize = 2, promote = 2, relegate = 2 },
	{ level = 3, name = "Segunda División B", strength = { 56, 66 }, prize = 4, promote = 2, relegate = 2 },
	{ level = 4, name = "Segunda División", strength = { 64, 74 }, prize = 8, promote = 2, relegate = 2 },
	{ level = 5, name = "Primera División", strength = { 72, 85 }, prize = 16, promote = 0, relegate = 3 },
}

LeagueConfig.TEAMS = 10
LeagueConfig.LEAGUE_FIRST_CYCLE = 0
LeagueConfig.LEAGUE_ROUNDS = 18 -- (TEAMS - 1) × 2
LeagueConfig.CUP_CYCLES = { 19, 22, 25, 28 }
LeagueConfig.CUP_ROUND_NAMES = { "Octavos de final", "Cuartos de final", "Semifinal", "Final" }
LeagueConfig.CUP_TEAMS = 16
LeagueConfig.CUP_NAME = "Copa del Imperio"
LeagueConfig.FINALIZE_CYCLE = 29

-- Puntos
LeagueConfig.POINTS_WIN = 3
LeagueConfig.POINTS_DRAW = 1

-- Premios (se multiplican por el "prize" de la división)
LeagueConfig.MATCH_PRIZE_SCALE = 1.2 -- multiplicador sobre el premio base de MatchService
LeagueConfig.POSITION_PRIZE = 5000 -- × (equipos + 1 − posición) / equipos
LeagueConfig.TITLE_BONUS = 20000
LeagueConfig.PROMOTION_BONUS = 15000
LeagueConfig.CUP_ROUND_PRIZE = { 1000, 2500, 6000, 15000 } -- por ganar cada ronda
LeagueConfig.OBJECTIVE_BONUS = 10000

-- Reputación ganada (o perdida)
LeagueConfig.REP_TITLE_BASE = 8
LeagueConfig.REP_TITLE_PER_LEVEL = 4
LeagueConfig.REP_PROMOTION = 6
LeagueConfig.REP_CUP_BASE = 6
LeagueConfig.REP_CUP_PER_LEVEL = 2
LeagueConfig.REP_RELEGATION = -5

-- Junta directiva (modo carrera)
LeagueConfig.BOARD_START = 60
LeagueConfig.BOARD_MET = 15
LeagueConfig.BOARD_FAILED = -20

-- Evolución de los rivales entre temporadas
LeagueConfig.AI_DRIFT = 2

function LeagueConfig.Division(level)
	return LeagueConfig.Divisions[math.clamp(level or 1, 1, #LeagueConfig.Divisions)]
end

return LeagueConfig
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000009"><Properties><string name="Name">MenuConfig</string><ProtectedString name="Source"><![CDATA[-- MenuConfig (ModuleScript)
-- Ubicación: ReplicatedStorage/Shared/Config/MenuConfig
--
-- Entradas del menú principal. `phase` indica en qué fase del plan se
-- implementa la sección. Las secciones de fases futuras se muestran
-- desactivadas con el texto "Disponible en la FASE N": no son botones
-- decorativos que finjan funcionar.

local MenuConfig = {
	{ id = "home", label = "Inicio", icon = "🏠", phase = 1 },
	{ id = "club", label = "Mi club", icon = "🛡️", phase = 1 },
	{ id = "stadium", label = "Mi estadio", icon = "🏟️", phase = 1 },
	{ id = "build", label = "Construcción", icon = "🏗️", phase = 1 },
	{ id = "economy", label = "Economía", icon = "💰", phase = 1 },
	{ id = "shop", label = "Tienda Premium", icon = "💎", phase = 1, highlight = true },
	{ id = "squad", label = "Plantilla", icon = "👕", phase = 4 },
	{ id = "academy", label = "Academia", icon = "🧬", phase = 4 },
	{ id = "matches", label = "Partidos", icon = "⚽", phase = 5 },
	{ id = "transfers", label = "Fichajes", icon = "🔁", phase = 6 },
	{ id = "leagues", label = "Ligas", icon = "🏆", phase = 7 },
	{ id = "history", label = "Historia", icon = "📜", phase = 8 },
	{ id = "universe", label = "Universo", icon = "🌎", phase = 8 },
	{ id = "network", label = "Red de clubes", icon = "🤝", phase = 9 },
	{ id = "missions", label = "Misiones", icon = "🎯", phase = 10 },
	{ id = "achievements", label = "Logros", icon = "🎖️", phase = 10 },
	{ id = "settings", label = "Configuración", icon = "⚙️", phase = 1 },
}

-- Fase actualmente implementada: las entradas con phase <= CURRENT_PHASE están activas.
MenuConfig.CURRENT_PHASE = 8

return MenuConfig
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000A"><Properties><string name="Name">NetworkConfig</string><ProtectedString name="Source"><![CDATA[-- NetworkConfig (ModuleScript)
-- Ubicación: ReplicatedStorage/Shared/Config/NetworkConfig
-- RED DE CLUBES Y MULTIJUGADOR (FASE 9).

local NetworkConfig = {}

-- ===== Invitaciones a partidos (jugadores del mismo servidor) =====
NetworkConfig.INVITE_SECONDS = 60 -- tiempo para aceptar una invitación
-- Los amistosos entre usuarios no dan dinero ni puntos (evita que dos amigos "farmeen").

-- ===== Retos (contra la hoja pública de cualquier club, aunque esté en otro servidor) =====
NetworkConfig.CHALLENGES_PER_DAY = 5
NetworkConfig.CHALLENGE_SAME_TARGET_PER_DAY = 1
NetworkConfig.POINTS_WIN = 3 -- puntos de red
NetworkConfig.POINTS_DRAW = 1
NetworkConfig.INBOX_STORE = "FEU_Network_Inbox_v1" -- avisos para el club retado
NetworkConfig.INBOX_MAX = 20
NetworkConfig.NETWORK_RANK_STORE = "FEU_Rank_Network_v1"

-- ===== Amigos =====
NetworkConfig.MAX_FRIENDS_SHOWN = 20
NetworkConfig.FRIENDS_CACHE_SECONDS = 300

-- ===== Historial de enfrentamientos =====
NetworkConfig.H2H_MAX_OPPONENTS = 50

-- ===== Torneos del servidor =====
NetworkConfig.TOURNAMENT_SIZES = { 4, 8 }
NetworkConfig.TOURNAMENT_JOIN_SECONDS = 45 -- inscripción abierta
NetworkConfig.TOURNAMENT_ROUND_SECONDS = 8 -- pausa entre rondas
NetworkConfig.TOURNAMENT_COOLDOWN = 1800 -- un torneo creado por jugador cada 30 min
NetworkConfig.TOURNAMENT_PRIZE = 5000 -- × premio de la división del campeón; solo con 2+ clubes humanos
NetworkConfig.TOURNAMENT_POINTS = 10
NetworkConfig.TOURNAMENT_NAME = "Torneo de la Red"

-- ===== Eventos comunitarios (objetivo compartido por todos los clubes del servidor) =====
NetworkConfig.COMMUNITY_GOALS = {
	{ id = "goals", metric = "goals", target = 40, text = "Entre todos los clubes del servidor, marcar %d goles", reward = 4000 },
	{ id = "wins", metric = "wins", target = 15, text = "Entre todos, ganar %d partidos", reward = 4000 },
	{ id = "matches", metric = "matches", target = 25, text = "Entre todos, jugar %d partidos", reward = 3000 },
}
NetworkConfig.COMMUNITY_PERIOD = 3600 -- un objetivo nuevo cada hora

return NetworkConfig
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000B"><Properties><string name="Name">SponsorConfig</string><ProtectedString name="Source"><![CDATA[-- SponsorConfig (ModuleScript)
-- Ubicación: ReplicatedStorage/Shared/Config/SponsorConfig
--
-- Contratos de patrocinio (FASE 3). Todas las marcas son FICTICIAS: se generan
-- combinando las listas de abajo y no representan a ninguna empresa real.

local SponsorConfig = {}

-- Huecos de patrocinio. value = peso del hueco en el valor de la oferta.
SponsorConfig.Slots = {
	{ id = "shirt", name = "Patrocinador de camiseta", icon = "👕", minStage = 1, value = 1.0 },
	{ id = "supplier", name = "Proveedor técnico", icon = "👟", minStage = 1, value = 0.7 },
	{ id = "boards", name = "Vallas publicitarias", icon = "📢", minStage = 1, value = 0.5 },
	{ id = "sleeve", name = "Manga de la camiseta", icon = "💪", minStage = 2, value = 0.4 },
	{ id = "naming", name = "Nombre del estadio", icon = "🏟️", minStage = 3, value = 2.0 },
}

SponsorConfig.BrandPrefixes = {
	"Nova", "Atlas", "Cumbre", "Solaris", "Brisa", "Titán", "Orbe", "Vértice", "Aurora", "Delta",
	"Faro", "Cénit", "Lince", "Prisma", "Rumbo", "Halcón", "Zafiro", "Ola", "Volta", "Kronos",
}
SponsorConfig.BrandSuffixes = {
	"Energía", "Seguros", "Telecom", "Bebidas", "Motor", "Banca", "Logística", "Deportes", "Tech", "Viajes",
	"Alimentación", "Hogar", "Digital", "Moda", "Aerolíneas",
}

-- Valor por jornada de una oferta = valor del hueco × (BASE + rep × PER_REP + √aficionados × PER_SQRT_FAN) × aleatorio
SponsorConfig.BASE_VALUE = 60
SponsorConfig.PER_REPUTATION = 6
SponsorConfig.PER_SQRT_FAN = 3
SponsorConfig.RANDOM_MIN = 0.8
SponsorConfig.RANDOM_MAX = 1.25

SponsorConfig.OFFERS_PER_SLOT = 3
SponsorConfig.OFFER_REFRESH_CYCLES = 15 -- jornadas entre renovaciones de ofertas
SponsorConfig.DURATION_MIN = 20 -- jornadas
SponsorConfig.DURATION_MAX = 60
SponsorConfig.SIGNING_BONUS_MIN = 3 -- jornadas de pago como prima de fichaje
SponsorConfig.SIGNING_BONUS_MAX = 8
SponsorConfig.TERMINATION_PENALTY = 5 -- jornadas de pago como penalización por rescindir
SponsorConfig.OBJECTIVE_BONUS = 0.25 -- +25 % del pago en cada jornada con el objetivo cumplido

-- Objetivos posibles (se evalúan en cada jornada con los datos reales).
SponsorConfig.Objectives = {
	{ id = "occupancy", text = "Ocupación del estadio ≥ %d%%" },
	{ id = "satisfaction", text = "Satisfacción de la afición ≥ %d" },
	{ id = "members", text = "Socios ≥ %d" },
}

function SponsorConfig.Slot(id)
	for _, slot in ipairs(SponsorConfig.Slots) do
		if slot.id == id then
			return slot
		end
	end
	return nil
end

function SponsorConfig.ObjectiveText(objective)
	for _, def in ipairs(SponsorConfig.Objectives) do
		if def.id == objective.type then
			local value = objective.type == "occupancy" and math.floor(objective.target * 100 + 0.5) or objective.target
			return string.format(def.text, value)
		end
	end
	return "—"
end

-- ¿Se cumple el objetivo con estos resultados? (función pura, la usan cliente y servidor)
function SponsorConfig.ObjectiveMet(objective, occupancy, satisfaction, members)
	if not objective then
		return false
	end
	if objective.type == "occupancy" then
		return occupancy >= objective.target
	elseif objective.type == "satisfaction" then
		return satisfaction >= objective.target
	elseif objective.type == "members" then
		return members >= objective.target
	end
	return false
end

return SponsorConfig
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000C"><Properties><string name="Name">StadiumStages</string><ProtectedString name="Source"><![CDATA[-- StadiumStages (ModuleScript)
-- Ubicación: ReplicatedStorage/Shared/Config/StadiumStages
--
-- Las siete etapas del ESTADIO EVOLUTIVO (FASE 2).
-- Cada etapa tiene:
--   upgradeCost   coste de ascender A esta etapa (gasto de construcción)
--   requirements  reputación mínima e instalaciones mínimas para ascender
--   effects       efectos funcionales permanentes mientras el estadio esté en esta etapa
--   visual        qué elementos visuales se construyen (lo interpreta StadiumRenderer)
--
-- Las instalaciones de FacilityConfig usan `minStage` para desbloquear niveles.
-- Requisitos calibrados para que cada etapa sea alcanzable maximizando la anterior.

local StadiumStages = {
	{
		stage = 1,
		name = "Campo básico",
		description = "Un campo humilde con unas pocas gradas. Aquí empieza tu imperio.",
		upgradeCost = 0,
		requirements = {},
		effects = { attractiveness = 0, sponsorBonus = 0, upkeep = 0, reputation = 0, freeDecorations = 6 },
		visual = { wall = nil, plaza = nil },
	},
	{
		stage = 2,
		name = "Estadio local",
		description = "El barrio entero viene a verte jugar. Desbloquea Zona VIP, Centro de entrenamiento, Academia y Sala de trofeos.",
		upgradeCost = 60000,
		requirements = { reputation = 25, facilities = { stands = 3, pitch = 2, lighting = 1 } },
		effects = { attractiveness = 0.05, sponsorBonus = 300, upkeep = 150, reputation = 5, freeDecorations = 7 },
		visual = { wall = { height = 4, material = "WoodPlanks" }, plaza = "Concrete", gate = true },
	},
	{
		stage = 3,
		name = "Estadio regional",
		description = "Tu club es conocido en toda la región.",
		upgradeCost = 180000,
		requirements = { reputation = 55, facilities = { stands = 4, shop = 3, restaurant = 3, vip = 1 } },
		effects = { attractiveness = 0.10, sponsorBonus = 800, upkeep = 400, reputation = 10, freeDecorations = 8 },
		visual = { wall = { height = 6, material = "Brick" }, plaza = "Cobblestone", gate = true, gateText = true },
	},
	{
		stage = 4,
		name = "Estadio profesional",
		description = "Instalaciones dignas del fútbol profesional. Las esquinas del estadio se cierran con gradas.",
		upgradeCost = 450000,
		requirements = { reputation = 95, facilities = { stands = 5, training = 2, academy = 1 } },
		effects = { attractiveness = 0.15, sponsorBonus = 2000, upkeep = 900, reputation = 20, freeDecorations = 9 },
		visual = { wall = { height = 8, material = "Concrete" }, plaza = "Slate", gate = true, gateText = true, corners = true },
	},
	{
		stage = 5,
		name = "Estadio de élite",
		description = "Uno de los mejores estadios del país, con pantallas gigantes.",
		upgradeCost = 1100000,
		requirements = { reputation = 125, facilities = { stands = 6, vip = 2, trophyRoom = 2 } },
		effects = { attractiveness = 0.22, sponsorBonus = 4500, upkeep = 1800, reputation = 30, freeDecorations = 10 },
		visual = { wall = { height = 10, material = "Concrete", stripe = true }, plaza = "Marble", gate = true, gateText = true, corners = true, screens = true },
	},
	{
		stage = 6,
		name = "Estadio internacional",
		description = "Sede de grandes noches europeas, con anillo de luz.",
		upgradeCost = 2600000,
		requirements = { reputation = 145, facilities = { lighting = 5, shop = 6, restaurant = 6, academy = 3 } },
		effects = { attractiveness = 0.30, sponsorBonus = 9000, upkeep = 3500, reputation = 45, freeDecorations = 11 },
		visual = { wall = { height = 12, material = "Glass", neon = true }, plaza = "Marble", gate = true, gateText = true, corners = true, screens = true, lightRing = true },
	},
	{
		stage = 7,
		name = "Estadio legendario",
		description = "Un templo del fútbol mundial. Acabados dorados y monumento del club.",
		upgradeCost = 6000000,
		requirements = { reputation = 165, facilities = { stands = 7, trophyRoom = 3, vip = 3 } },
		effects = { attractiveness = 0.40, sponsorBonus = 18000, upkeep = 6000, reputation = 60, freeDecorations = 12 },
		visual = { wall = { height = 14, material = "Marble", gold = true }, plaza = "Marble", gate = true, gateText = true, corners = true, screens = true, lightRing = true, monument = true },
	},
}

-- Etapa máxima disponible en la versión actual.
StadiumStages.MAX_STAGE_THIS_PHASE = 7

function StadiumStages.Get(stage)
	return StadiumStages[math.clamp(stage or 1, 1, #StadiumStages)]
end

return StadiumStages
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000D"><Properties><string name="Name">TacticsConfig</string><ProtectedString name="Source"><![CDATA[-- TacticsConfig (ModuleScript)
-- Ubicación: ReplicatedStorage/Shared/Config/TacticsConfig
--
-- Formaciones, tácticas y constantes del MOTOR DE PARTIDOS SIMULADOS (FASE 5).
-- Los partidos son SIMULACIONES: el resultado lo calcula el servidor y la interfaz
-- lo reproduce como resumen. El modo jugable en tiempo real se añadirá más adelante
-- (MatchConfig.MODES deja preparada esa ampliación).

local TacticsConfig = {}

-- slots: posición de cada uno de los 11 puestos (en orden: portero, defensas, medios, delanteros)
TacticsConfig.Formations = {
	{ id = "442", name = "4-4-2", slots = { "GK", "DEF", "DEF", "DEF", "DEF", "MID", "MID", "MID", "MID", "FWD", "FWD" } },
	{ id = "433", name = "4-3-3", slots = { "GK", "DEF", "DEF", "DEF", "DEF", "MID", "MID", "MID", "FWD", "FWD", "FWD" } },
	{ id = "4231", name = "4-2-3-1", slots = { "GK", "DEF", "DEF", "DEF", "DEF", "MID", "MID", "MID", "MID", "MID", "FWD" } },
	{ id = "352", name = "3-5-2", slots = { "GK", "DEF", "DEF", "DEF", "MID", "MID", "MID", "MID", "MID", "FWD", "FWD" } },
	{ id = "532", name = "5-3-2", slots = { "GK", "DEF", "DEF", "DEF", "DEF", "DEF", "MID", "MID", "MID", "FWD", "FWD" } },
}
TacticsConfig.DEFAULT_FORMATION = "442"

TacticsConfig.Mentalities = {
	{ id = "DEFENSIVE", name = "Defensiva", attack = 0.90, defense = 1.10, description = "Menos ocasiones a favor y en contra." },
	{ id = "BALANCED", name = "Equilibrada", attack = 1.00, defense = 1.00, description = "Sin modificadores." },
	{ id = "OFFENSIVE", name = "Ofensiva", attack = 1.10, defense = 0.92, description = "Más ocasiones a favor, pero más riesgo atrás." },
}

TacticsConfig.Styles = {
	{ id = "POSSESSION", name = "Posesión", possession = 0.06, chances = 1.00, quality = 0.97, description = "Controlar el balón: más posesión." },
	{ id = "COUNTER", name = "Contraataque", possession = -0.06, chances = 0.90, quality = 1.12, description = "Menos ocasiones, pero más claras." },
	{ id = "DIRECT", name = "Juego directo", possession = -0.02, chances = 1.20, quality = 0.95, description = "Muchas ocasiones de menor calidad." },
}

-- Penalización por jugar fuera de posición
TacticsConfig.OUT_OF_POSITION = 0.80
TacticsConfig.GK_OUT_OF_POSITION = 0.40

-- ===== Motor =====
TacticsConfig.CHUNKS = 18 -- tramos de 5 minutos
TacticsConfig.CHANCE_BASE = 0.55 -- probabilidad base de ocasión por tramo con posesión e igualdad al 50 %
TacticsConfig.BALANCE_EXPONENT = 3 -- cuánto pesa la diferencia ataque/defensa (calibrado: ~2,3 goles por partido)
TacticsConfig.ON_TARGET_BASE = 0.45
TacticsConfig.GOAL_BASE = 0.42
TacticsConfig.HOME_ADVANTAGE = 0.02 -- +2 % de base para el local
TacticsConfig.CROWD_ADVANTAGE = 0.03 -- hasta +3 % más con el estadio lleno
TacticsConfig.FATIGUE_MINUTE = 60 -- desde aquí pesa la resistencia
TacticsConfig.ASSIST_CHANCE = 0.75

-- ===== Forma física y lesiones =====
TacticsConfig.FITNESS_COST_MAX = 20 -- un titular con resistencia 0 pierde 20
TacticsConfig.FITNESS_COST_MIN = 10 -- ... y con resistencia 99 pierde 10
TacticsConfig.FITNESS_RECOVERY = 12 -- por jornada
TacticsConfig.INJURY_CHANCE = 0.015 -- por titular y partido
TacticsConfig.INJURY_CHANCE_INTENSE = 0.01 -- extra con entrenamiento intenso
TacticsConfig.INJURY_MIN = 2 -- jornadas de baja
TacticsConfig.INJURY_MAX = 6

-- ===== Amistosos (FASE 5; las ligas llegan en la FASE 7) =====
TacticsConfig.FRIENDLY_OFFERS = 3
TacticsConfig.FRIENDLY_DIFFICULTY = {
	{ id = "EASY", name = "Asequible", delta = -6 },
	{ id = "EVEN", name = "Igualado", delta = 0 },
	{ id = "HARD", name = "Exigente", delta = 6 },
}
TacticsConfig.FRIENDLY_PRIZE_BASE = 500 -- premio por victoria con rival de media 50
TacticsConfig.PRIZE_DRAW = 0.4
TacticsConfig.PRIZE_LOSS = 0.15
TacticsConfig.SATISFACTION_WIN = 2
TacticsConfig.SATISFACTION_LOSS = -2
TacticsConfig.REPUTATION_WIN = 1 -- reputación ganada al vencer a un rival igual o mejor (−3)
TacticsConfig.MAX_MATCH_HISTORY = 20

-- Nombres de clubes rivales (ficticios)
TacticsConfig.ClubPrefixes = { "Atlético", "Deportivo", "Racing", "Unión", "Sporting", "Real", "Club", "Juventud", "Olímpico", "Estrella" }
TacticsConfig.ClubTowns = {
	"Villaverde", "Montesol", "Puerto Azul", "Valdeluz", "Rocanegra", "San Fermín del Río", "Altamira", "Costaflor",
	"Torrebrava", "Lagoverde", "Peñalba", "Bahía Clara", "Campoalto", "Sierramar", "Fuentevieja", "Robledo",
}

function TacticsConfig.Formation(id)
	for _, f in ipairs(TacticsConfig.Formations) do
		if f.id == id then
			return f
		end
	end
	return TacticsConfig.Formations[1]
end

function TacticsConfig.Mentality(id)
	for _, m in ipairs(TacticsConfig.Mentalities) do
		if m.id == id then
			return m
		end
	end
	return TacticsConfig.Mentalities[2]
end

function TacticsConfig.Style(id)
	for _, s in ipairs(TacticsConfig.Styles) do
		if s.id == id then
			return s
		end
	end
	return TacticsConfig.Styles[1]
end

return TacticsConfig
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000E"><Properties><string name="Name">TransferConfig</string><ProtectedString name="Source"><![CDATA[-- TransferConfig (ModuleScript)
-- Ubicación: ReplicatedStorage/Shared/Config/TransferConfig
-- MERCADO DE FICHAJES (FASE 6): compras, ventas, ofertas y cesiones.
-- Todos los clubes y jugadores del mercado son ficticios y los genera el servidor.

local TransferConfig = {}

-- ===== Mercado =====
TransferConfig.MARKET_SIZE = 10 -- jugadores en venta
TransferConfig.LOAN_LISTINGS = 3 -- de ellos, disponibles como cesión
TransferConfig.FREE_AGENTS = 2 -- de ellos, libres (sin traspaso, con prima de fichaje)
TransferConfig.REFRESH_CYCLES = 5 -- jornadas entre renovaciones del mercado
TransferConfig.STRENGTH_MIN = -10 -- media respecto a tu mejor once
TransferConfig.STRENGTH_MAX = 12

-- Precio pedido = valor de mercado × [ASK_MIN, ASK_MAX]
TransferConfig.ASK_MIN = 0.95
TransferConfig.ASK_MAX = 1.35

-- Negociación: proporción del precio pedido que ofreces -> probabilidad de aceptación.
-- Un rechazo bloquea nuevas ofertas por ese jugador hasta la siguiente renovación del mercado.
TransferConfig.OfferLevels = {
	{ id = "FULL", name = "Precio pedido", share = 1.00, chance = 1.00 },
	{ id = "MINUS10", name = "−10 %", share = 0.90, chance = 0.50 },
	{ id = "MINUS20", name = "−20 %", share = 0.80, chance = 0.20 },
}

TransferConfig.SALARY_PREMIUM = 1.1 -- un fichaje pide un 10 % más de salario
TransferConfig.FREE_AGENT_BONUS = 0.2 -- prima de un jugador libre = 20 % de su valor
TransferConfig.DEFAULT_CONTRACT = 3

-- Presupuesto de fichajes: parte del dinero que el club permite gastar en traspasos
TransferConfig.BudgetShares = { 0.25, 0.5, 0.75, 1.0 }
TransferConfig.DEFAULT_BUDGET_SHARE = 0.5

-- ===== Cesiones =====
TransferConfig.LOAN_IN_FEE = 0.01 -- coste por jornada de una cesión recibida = 1 % del valor (más su salario)
TransferConfig.LOAN_OUT_FEE = 0.008 -- ingreso por jornada al ceder a un jugador = 0,8 % de su valor
TransferConfig.LOAN_OUT_CHANCE = 0.5 -- probabilidad por jornada de que un club acepte la cesión ofrecida

-- ===== Ofertas por tus jugadores =====
TransferConfig.LISTED_OFFER_CHANCE = 0.35 -- por jornada y jugador en venta
TransferConfig.UNSOLICITED_CHANCE = 0.05 -- por jornada, oferta espontánea por uno de tus 3 mejores
TransferConfig.OFFER_MIN = 0.8 -- proporción del valor de mercado
TransferConfig.OFFER_MAX = 1.2
TransferConfig.UNSOLICITED_PREMIUM = 1.15 -- las ofertas espontáneas pagan más
TransferConfig.OFFER_EXPIRY = 3 -- jornadas
TransferConfig.MAX_OFFERS = 6

return TransferConfig
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000F"><Properties><string name="Name">UniverseConfig</string><ProtectedString name="Source"><![CDATA[-- UniverseConfig (ModuleScript)
-- Ubicación: ReplicatedStorage/Shared/Config/UniverseConfig
--
-- UNIVERSO FUTBOLÍSTICO (FASE 8): perfiles públicos de clubes, rankings globales,
-- eventos del universo y competición semanal entre usuarios.
-- Solo se publican datos PÚBLICOS del club (nunca dinero, deuda ni datos de la cuenta).

local UniverseConfig = {}

-- ===== Almacenes de Roblox =====
UniverseConfig.PROFILE_STORE = "FEU_Universe_Profiles_v1"
UniverseConfig.RANKINGS = {
	{ id = "reputation", name = "Reputación", icon = "⭐", store = "FEU_Rank_Reputation_v1" },
	{ id = "value", name = "Valor del club", icon = "🏦", store = "FEU_Rank_Value_v1" },
	{ id = "titles", name = "Títulos", icon = "🏆", store = "FEU_Rank_Titles_v1" },
}
UniverseConfig.WEEKLY_STORE_PREFIX = "FEU_Weekly_v1_"

UniverseConfig.PUBLISH_SECONDS = 300 -- cada cuánto se publica el perfil de cada club
UniverseConfig.RANKING_CACHE_SECONDS = 120 -- caché por servidor de los rankings
UniverseConfig.PROFILE_CACHE_SECONDS = 300
UniverseConfig.RANKING_SIZE = 20

-- ===== Eventos del universo (rotan automáticamente; mismo evento en todos los servidores) =====
UniverseConfig.EVENT_HOURS = 24
UniverseConfig.Events = {
	{ id = "youth_week", name = "Semana de la cantera", icon = "🧬", effect = "youthGrowth", multiplier = 1.3,
		description = "Los juveniles de todas las academias evolucionan un 30 % más rápido." },
	{ id = "fan_festival", name = "Festival de aficionados", icon = "🎉", effect = "fanGrowth", multiplier = 1.3,
		description = "La afición crece un 30 % más rápido en todos los clubes." },
	{ id = "sponsor_market", name = "Mercado de patrocinio", icon = "🤝", effect = "contracts", multiplier = 1.15,
		description = "Los contratos de patrocinio pagan un 15 % más." },
	{ id = "derby_days", name = "Días de clásicos", icon = "⚔️", effect = "matchPrize", multiplier = 1.3,
		description = "Los premios de los partidos aumentan un 30 %." },
	{ id = "open_doors", name = "Puertas abiertas", icon = "🗺️", effect = "tour", multiplier = 1.5,
		description = "El tour del estadio genera un 50 % más de ingresos." },
}

-- ===== Competición semanal entre usuarios =====
UniverseConfig.WEEK_SECONDS = 7 * 24 * 3600
UniverseConfig.WeeklyPoints = { win = 3, draw = 1, cupRound = 2, title = 10 }
UniverseConfig.WeeklyRewards = { -- por posición final de la semana (se reclaman al entrar la semana siguiente)
	{ maxRank = 1, money = 50000, reputation = 5, label = "🥇 Campeón semanal" },
	{ maxRank = 3, money = 25000, reputation = 3, label = "🥈 Podio semanal" },
	{ maxRank = 10, money = 10000, reputation = 1, label = "🏅 Top 10 semanal" },
}

function UniverseConfig.CurrentEvent(now)
	now = now or os.time()
	local period = UniverseConfig.EVENT_HOURS * 3600
	local index = math.floor(now / period) % #UniverseConfig.Events + 1
	local secondsLeft = period - (now % period)
	return UniverseConfig.Events[index], secondsLeft
end

-- Multiplicador del evento activo para un efecto (1 si el evento actual no lo afecta).
function UniverseConfig.Multiplier(effect, now)
	local event = UniverseConfig.CurrentEvent(now)
	if event.effect == effect then
		return event.multiplier
	end
	return 1
end

function UniverseConfig.WeekIndex(now)
	return math.floor((now or os.time()) / UniverseConfig.WEEK_SECONDS)
end

function UniverseConfig.WeekSecondsLeft(now)
	now = now or os.time()
	return UniverseConfig.WEEK_SECONDS - (now % UniverseConfig.WEEK_SECONDS)
end

function UniverseConfig.WeeklyReward(rank)
	for _, reward in ipairs(UniverseConfig.WeeklyRewards) do
		if rank <= reward.maxRank then
			return reward
		end
	end
	return nil
end

return UniverseConfig
]]></ProtectedString></Properties></Item></Item><Item class="Folder" referent="RBX00000019"><Properties><string name="Name">Modules</string></Properties><Item class="ModuleScript" referent="RBX00000011"><Properties><string name="Name">EconomyFormulas</string><ProtectedString name="Source"><![CDATA[-- EconomyFormulas (ModuleScript)
-- Ubicación: ReplicatedStorage/Shared/Modules/EconomyFormulas
--
-- Fórmulas económicas PURAS (sin efectos secundarios).
-- El servidor las usa como única fuente de verdad para calcular ingresos y gastos.
-- El cliente las usa solo para mostrar previsiones; nunca decide nada.

local Config = script.Parent.Parent.Config
local GameConfig = require(Config.GameConfig)
local FacilityConfig = require(Config.FacilityConfig)
local CosmeticConfig = require(Config.CosmeticConfig)
local StadiumStages = require(Config.StadiumStages)
local CommercialConfig = require(Config.CommercialConfig)
local SponsorConfig = require(Config.SponsorConfig)
local FootballConfig = require(Config.FootballConfig)
local UniverseConfig = require(Config.UniverseConfig)

local EconomyFormulas = {}

local function ticketOption(id)
	for _, option in ipairs(GameConfig.TICKET_PRICES) do
		if option.id == id then
			return option
		end
	end
	return GameConfig.TICKET_PRICES[2]
end
EconomyFormulas.TicketOption = ticketOption

-- Suma los efectos de todas las instalaciones construidas.
function EconomyFormulas.FacilityTotals(facilities)
	local totals = {
		capacity = 0,
		attractiveness = 1.0,
		shopSpend = 0,
		foodSpend = 0,
		vipIncome = 0,
		tourRate = 0,
		upkeep = 0,
		staff = 0,
		reputation = 0,
		invested = 0,
		builtCount = 0,
	}
	for id, def in pairs(FacilityConfig.Facilities) do
		local level = facilities[id] or 0
		if level > 0 then
			totals.builtCount += 1
			for l = 1, math.min(level, #def.levels) do
				totals.invested += def.levels[l].cost
			end
			local data = def.levels[math.min(level, #def.levels)]
			totals.capacity += data.capacity or 0
			totals.attractiveness += data.attractiveness or 0
			totals.shopSpend += data.shopSpend or 0
			totals.foodSpend += data.foodSpend or 0
			totals.vipIncome += data.vipIncome or 0
			totals.tourRate += data.tourRate or 0
			totals.upkeep += data.upkeep or 0
			totals.staff += data.staff or 0
			totals.reputation += data.reputation or 0
		end
	end
	return totals
end

-- Efectos funcionales de la etapa actual del estadio evolutivo.
function EconomyFormulas.StageEffects(stage)
	return StadiumStages.Get(stage).effects
end

-- Límite gratuito de decoraciones según la etapa.
function EconomyFormulas.FreeDecorationLimit(stage)
	return EconomyFormulas.StageEffects(stage).freeDecorations
end

-- Bonificación por decoraciones: solo cuentan hasta el límite GRATUITO de la etapa
-- (las decoraciones extra de Constructor Pro no dan ventaja económica).
function EconomyFormulas.DecorationBonus(decorations, stage)
	local count = math.min(#(decorations or {}), EconomyFormulas.FreeDecorationLimit(stage))
	return count * CosmeticConfig.DECORATION_ATTRACTIVENESS
end

-- Coste acumulado de todas las etapas alcanzadas (forma parte del valor del club).
function EconomyFormulas.StageInvestment(stage)
	local total = 0
	for s = 2, math.clamp(stage or 1, 1, #StadiumStages) do
		total += StadiumStages[s].upgradeCost
	end
	return total
end

function EconomyFormulas.Reputation(data)
	local totals = EconomyFormulas.FacilityTotals(data.stadium.facilities)
	return totals.reputation + EconomyFormulas.StageEffects(data.stadium.stage).reputation + (data.club.reputationEarned or 0)
end

-- Salarios de la plantilla por jornada (la plantilla llega en la FASE 4).
function EconomyFormulas.Wages(data)
	local total = 0
	for _, playerData in ipairs(data.squad or {}) do
		-- Los jugadores cedidos a otro club cobran de ese club
		if not (playerData.loan and playerData.loan.type == "out") then
			total += tonumber(playerData.salary) or 0
		end
	end
	return math.floor(total)
end

-- Cuotas de cesión por jornada: { ingresos (cedidos), gastos (recibidos) } (FASE 6)
function EconomyFormulas.LoanFees(data)
	local income, expense = 0, 0
	for _, playerData in ipairs(data.squad or {}) do
		local loan = playerData.loan
		if loan then
			if loan.type == "out" then
				income += tonumber(loan.fee) or 0
			elseif loan.type == "in" then
				expense += tonumber(loan.fee) or 0
			end
		end
	end
	return math.floor(income), math.floor(expense)
end

function EconomyFormulas.FanCap(capacity, attractiveness, reputation)
	return math.floor(capacity * GameConfig.FAN_CAP_PER_SEAT * attractiveness
		+ reputation * GameConfig.FAN_CAP_PER_REPUTATION)
end

local function memberOption(id)
	for _, option in ipairs(GameConfig.MEMBER_PRICES) do
		if option.id == id then
			return option
		end
	end
	return GameConfig.MEMBER_PRICES[2]
end
EconomyFormulas.MemberOption = memberOption

-- Ingresos por contratos de patrocinio activos (pago + bonus si se cumple el objetivo).
function EconomyFormulas.ContractIncome(sponsors, occupancy, satisfaction, members)
	local total, details = 0, {}
	for slotId, contract in pairs((sponsors and sponsors.contracts) or {}) do
		local met = SponsorConfig.ObjectiveMet(contract.objective, occupancy, satisfaction, members)
		local amount = contract.payment + (met and math.floor(contract.payment * SponsorConfig.OBJECTIVE_BONUS) or 0)
		total += amount
		details[slotId] = { amount = amount, objectiveMet = met }
	end
	return total, details
end

-- Satisfacción objetivo de la afición y sus factores (para mostrarlos en la interfaz).
function EconomyFormulas.SatisfactionTarget(data, attractiveness, overcrowded)
	local economy = data.economy
	local ticket = ticketOption(economy.ticketPrice)
	local member = memberOption(economy.memberPrice)
	local shopPolicy = CommercialConfig.Policy(economy.shopPrice)
	local foodPolicy = CommercialConfig.Policy(economy.foodPrice)
	local factors = {
		{ label = "Base", value = GameConfig.SATISFACTION_BASE },
		{ label = "Precio de entradas", value = ticket.satisfaction or 0 },
		{ label = "Precio de abonos", value = member.satisfaction or 0 },
		{ label = "Precios de la tienda", value = shopPolicy.satisfaction },
		{ label = "Precios de restauración", value = foodPolicy.satisfaction },
		{ label = "Atractivo del estadio", value = math.floor(math.clamp((attractiveness - 1) * GameConfig.SATISFACTION_ATTRACTIVENESS, 0, GameConfig.SATISFACTION_ATTRACTIVENESS_MAX)) },
		{ label = "Etapa del estadio", value = (data.stadium.stage or 1) * GameConfig.SATISFACTION_PER_STAGE },
	}
	if overcrowded then
		table.insert(factors, { label = "Aficionados sin entrada", value = -GameConfig.OVERCROWD_PENALTY })
	end
	local target = 0
	for _, f in ipairs(factors) do
		target += f.value
	end
	return math.clamp(target, 0, 100), factors
end

-- Calcula un ciclo económico completo a partir de los datos del club.
-- Devuelve un desglose; el servidor es quien lo aplica.
function EconomyFormulas.Cycle(data)
	local facilities = data.stadium.facilities
	local economy = data.economy
	local club = data.club
	local totals = EconomyFormulas.FacilityTotals(facilities)
	local stageEffects = EconomyFormulas.StageEffects(data.stadium.stage)
	local attractiveness = totals.attractiveness + stageEffects.attractiveness
		+ EconomyFormulas.DecorationBonus(data.stadium.decorations, data.stadium.stage)
	local reputation = totals.reputation + stageEffects.reputation + (club.reputationEarned or 0)
	local ticket = ticketOption(economy.ticketPrice)
	local member = memberOption(economy.memberPrice)
	local shopPolicy = CommercialConfig.Policy(economy.shopPrice)
	local foodPolicy = CommercialConfig.Policy(economy.foodPrice)
	local satisfaction = club.satisfaction or GameConfig.SATISFACTION_START

	-- Asistencia: los socios ocupan primero su asiento; el resto compra entrada.
	local fans = club.fans
	local members = math.min(club.members or 0, fans)
	local capacity = totals.capacity
	local membersAttending = math.min(members, capacity)
	local casualDemand = (fans - members) * GameConfig.TURNOUT_RATE * ticket.demand * attractiveness
	local casual = math.floor(math.max(0, math.min(capacity - membersAttending, casualDemand)))
	local attendance = membersAttending + casual
	local occupancy = capacity > 0 and attendance / capacity or 0
	local overcrowded = membersAttending + casualDemand > capacity * GameConfig.OVERCROWD_THRESHOLD

	-- La satisfacción multiplica el gasto en tienda y restauración (0,75 a 1,25).
	local spendMultiplier = 0.75 + satisfaction / 200
	local contractTotal, contractDetails = EconomyFormulas.ContractIncome(data.sponsors, occupancy, satisfaction, members)
	local loanIncome, loanExpense = EconomyFormulas.LoanFees(data)

	local income = {
		tickets = casual * ticket.price,
		members = math.floor(members * member.fee),
		shop = math.floor(attendance * totals.shopSpend * shopPolicy.spend * spendMultiplier),
		restaurant = math.floor(attendance * totals.foodSpend * foodPolicy.spend * spendMultiplier),
		sponsors = GameConfig.SPONSOR_BASE + reputation * GameConfig.SPONSOR_PER_REPUTATION + stageEffects.sponsorBonus,
		contracts = math.floor(contractTotal * UniverseConfig.Multiplier("contracts")), -- evento del universo
		vip = totals.vipIncome,
		tour = math.floor(reputation * totals.tourRate * UniverseConfig.Multiplier("tour")),
		loans = loanIncome, -- cesiones a otros clubes (FASE 6)
	}
	local expenses = {
		maintenance = totals.upkeep,
		staff = GameConfig.STAFF_BASE + totals.staff,
		stadium = stageEffects.upkeep, -- operación del estadio según su etapa
		wages = EconomyFormulas.Wages(data), -- salarios de la plantilla (FASE 4)
		scouts = FootballConfig.SCOUT_COSTS[(data.academy and data.academy.scouts) or 0] or 0, -- ojeadores (FASE 4)
		loans = loanExpense, -- jugadores recibidos en cesión (FASE 6)
		interest = math.floor((economy.debt or 0) * GameConfig.DEBT_INTEREST_PER_CYCLE),
	}

	local totalIncome, totalExpenses = 0, 0
	for _, v in pairs(income) do
		totalIncome += v
	end
	for _, v in pairs(expenses) do
		totalExpenses += v
	end

	-- Afición: satisfacción, socios y crecimiento
	local satisfactionTarget, satisfactionFactors = EconomyFormulas.SatisfactionTarget(data, attractiveness, overcrowded)
	local satisfactionDelta = (satisfactionTarget - satisfaction) * GameConfig.SATISFACTION_SPEED

	local fanCap = EconomyFormulas.FanCap(capacity, attractiveness, reputation)
	local fanDelta
	if satisfaction < GameConfig.FAN_DECLINE_SATISFACTION then
		fanDelta = -math.ceil(fans * GameConfig.FAN_DECLINE_RATE)
	else
		local growth = (0.5 + satisfaction / 100) * UniverseConfig.Multiplier("fanGrowth")
		fanDelta = math.floor((fanCap - fans) * GameConfig.FAN_GROWTH_RATE * growth)
		if fanDelta == 0 and fans < fanCap then
			fanDelta = 1
		end
	end

	local memberRate = GameConfig.MEMBER_RATE_MIN + (GameConfig.MEMBER_RATE_MAX - GameConfig.MEMBER_RATE_MIN) * satisfaction / 100
	local memberTarget = math.floor(math.min(fans * memberRate * member.demand, capacity * GameConfig.MEMBER_SEAT_SHARE))
	local memberDelta = math.floor((memberTarget - members) * GameConfig.MEMBER_SPEED + 0.5)
	if memberDelta == 0 and memberTarget ~= members then
		memberDelta = memberTarget > members and 1 or -1
	end

	return {
		attendance = attendance,
		membersAttending = membersAttending,
		casual = casual,
		capacity = capacity,
		occupancy = occupancy,
		overcrowded = overcrowded,
		attractiveness = attractiveness,
		reputation = reputation,
		ticket = ticket,
		income = income,
		expenses = expenses,
		totalIncome = totalIncome,
		totalExpenses = totalExpenses,
		net = totalIncome - totalExpenses,
		fanCap = fanCap,
		fanDelta = fanDelta,
		satisfaction = satisfaction,
		satisfactionTarget = satisfactionTarget,
		satisfactionDelta = satisfactionDelta,
		satisfactionFactors = satisfactionFactors,
		spendMultiplier = spendMultiplier,
		members = members,
		memberTarget = memberTarget,
		memberDelta = memberDelta,
		contracts = contractDetails,
	}
end

function EconomyFormulas.ClubValue(data)
	local totals = EconomyFormulas.FacilityTotals(data.stadium.facilities)
	local reputation = EconomyFormulas.Reputation(data)
	local value = data.economy.money - data.economy.debt
		+ (totals.invested + EconomyFormulas.StageInvestment(data.stadium.stage)) * GameConfig.VALUE_INVESTMENT_SHARE
		+ data.club.fans * GameConfig.VALUE_PER_FAN
		+ reputation * GameConfig.VALUE_PER_REPUTATION
	return math.max(0, math.floor(value))
end

-- Comprueba si una instalación puede subir al siguiente nivel.
-- Devuelve ok, motivo, datosDelNivel
function EconomyFormulas.CanUpgrade(data, facilityId)
	local def = FacilityConfig.Get(facilityId)
	if not def then
		return false, "Instalación desconocida."
	end
	local current = data.stadium.facilities[facilityId] or 0
	local nextLevel = current + 1
	local levelData = def.levels[nextLevel]
	if not levelData then
		return false, "Ya está al nivel máximo."
	end
	if (data.stadium.stage or 1) < levelData.minStage then
		return false, string.format("Requiere estadio de etapa %d (%s).", levelData.minStage, StadiumStages.Get(levelData.minStage).name), levelData
	end
	for reqId, reqLevel in pairs(levelData.requires or {}) do
		if (data.stadium.facilities[reqId] or 0) < reqLevel then
			local reqDef = FacilityConfig.Get(reqId)
			return false, string.format("Requiere %s nivel %d.", reqDef and reqDef.name or reqId, reqLevel), levelData
		end
	end
	if data.economy.debt > GameConfig.DEBT_BUILD_LIMIT then
		return false, "Tu deuda es demasiado alta para construir. Págala primero.", levelData
	end
	if data.economy.money < levelData.cost then
		return false, "Dinero insuficiente.", levelData
	end
	return true, nil, levelData
end

-- Comprueba el ascenso a la siguiente etapa del estadio evolutivo.
-- Devuelve ok, motivo, siguienteEtapa, listaDeRequisitos { { text, met } }
function EconomyFormulas.CanUpgradeStage(data)
	local current = data.stadium.stage or 1
	local nextStage = StadiumStages[current + 1]
	if not nextStage then
		return false, "Tu estadio ya es legendario: etapa máxima alcanzada.", nil, {}
	end
	if nextStage.stage > StadiumStages.MAX_STAGE_THIS_PHASE then
		return false, "Esta etapa llegará en una fase posterior.", nextStage, {}
	end
	local checks = {}
	local allMet = true
	local reputation = EconomyFormulas.Reputation(data)
	local repNeeded = nextStage.requirements.reputation or 0
	local repMet = reputation >= repNeeded
	table.insert(checks, { text = string.format("Reputación %d / %d", reputation, repNeeded), met = repMet })
	allMet = allMet and repMet
	local facilityIds = {}
	for id in pairs(nextStage.requirements.facilities or {}) do
		table.insert(facilityIds, id)
	end
	table.sort(facilityIds)
	for _, id in ipairs(facilityIds) do
		local needed = nextStage.requirements.facilities[id]
		local have = data.stadium.facilities[id] or 0
		local def = FacilityConfig.Get(id)
		local met = have >= needed
		table.insert(checks, { text = string.format("%s nivel %d (tienes %d)", def and def.name or id, needed, have), met = met })
		allMet = allMet and met
	end
	local moneyMet = data.economy.money >= nextStage.upgradeCost
	table.insert(checks, { text = "Coste " .. tostring(nextStage.upgradeCost) .. " " .. GameConfig.CURRENCY, met = moneyMet })
	local debtMet = data.economy.debt <= GameConfig.DEBT_BUILD_LIMIT
	if not debtMet then
		table.insert(checks, { text = "Deuda por debajo de " .. GameConfig.DEBT_BUILD_LIMIT, met = false })
	end
	if not allMet then
		return false, "No cumples todos los requisitos.", nextStage, checks
	end
	if not debtMet then
		return false, "Tu deuda es demasiado alta para construir. Págala primero.", nextStage, checks
	end
	if not moneyMet then
		return false, "Dinero insuficiente.", nextStage, checks
	end
	return true, nil, nextStage, checks
end

return EconomyFormulas
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000012"><Properties><string name="Name">FootballFormulas</string><ProtectedString name="Source"><![CDATA[-- FootballFormulas (ModuleScript)
-- Ubicación: ReplicatedStorage/Shared/Modules/FootballFormulas
-- Fórmulas puras de futbolistas: media, valor, salario, potencial estimado y evolución.
-- Las usa el servidor (autoridad) y el cliente (solo para mostrar).

local FootballConfig = require(script.Parent.Parent.Config.FootballConfig)

local FootballFormulas = {}

function FootballFormulas.Overall(player)
	local weights = FootballConfig.Weights[player.pos] or FootballConfig.Weights.MID
	local total = 0
	for attr, w in pairs(weights) do
		total += (player.attrs[attr] or 0) * w
	end
	return total
end

function FootballFormulas.OverallInt(player)
	return math.floor(FootballFormulas.Overall(player) + 0.5)
end

local function ageFactor(age)
	if age <= 21 then
		return 1.3
	elseif age <= 26 then
		return 1.15
	elseif age <= 29 then
		return 1.0
	elseif age <= 32 then
		return 0.7
	end
	return 0.4
end

function FootballFormulas.MarketValue(player)
	local ovr = FootballFormulas.Overall(player)
	local margin = math.max(0, (player.potential or ovr) - ovr)
	local value = FootballConfig.VALUE_BASE * FootballConfig.VALUE_GROWTH ^ (ovr - 45)
		* ageFactor(player.age) * (1 + margin / 40)
	return math.max(100, math.floor(value / 100 + 0.5) * 100)
end

function FootballFormulas.SalaryDemand(player)
	local ovr = FootballFormulas.Overall(player)
	return math.max(2, math.floor(FootballConfig.SALARY_BASE * FootballConfig.SALARY_GROWTH ^ (ovr - 45) + 0.5))
end

-- Rango de potencial que se muestra según el número de ojeadores.
-- Es estable para cada jugador (no cambia al recargar) y siempre contiene el valor real.
function FootballFormulas.PotentialRange(player, scouts)
	local err = FootballConfig.SCOUT_ERROR[math.clamp(scouts or 0, 0, 3)]
	if err == 0 then
		return player.potential, player.potential
	end
	local hash = 0
	for i = 1, #player.id do
		hash = (hash * 31 + string.byte(player.id, i)) % 9973
	end
	local shift = hash % (err + 1) -- el valor real queda en una posición fija dentro del rango
	local low = player.potential - shift
	local high = low + err
	return math.max(1, low), math.min(99, high)
end

-- Evolución de un jugador en UNA jornada (devuelve el cambio de media previsto).
function FootballFormulas.GrowthPerCycle(player, multiplier)
	local rate = FootballConfig.AgeRate(player.age)
	if rate <= 0 then
		return FootballConfig.BASE_GROWTH * rate
	end
	local gap = (player.potential or 0) - FootballFormulas.Overall(player)
	if gap <= 0 then
		return 0
	end
	return FootballConfig.BASE_GROWTH * rate * math.clamp(gap / FootballConfig.GROWTH_GAP, 0, 1) * (multiplier or 1)
end

-- Aplica un cambio de media repartiéndolo entre atributos (según posición y foco).
function FootballFormulas.ApplyGrowth(player, delta)
	if delta == 0 then
		return
	end
	local weights = FootballConfig.Weights[player.pos] or FootballConfig.Weights.MID
	local share, denominator = {}, 0
	for attr, w in pairs(weights) do
		local s = w + (player.focus == attr and FootballConfig.FOCUS_WEIGHT or 0) + 0.02
		share[attr] = s
		denominator += w * s
	end
	if denominator <= 0 then
		return
	end
	local k = delta / denominator
	for attr, s in pairs(share) do
		player.attrs[attr] = math.clamp((player.attrs[attr] or 0) + k * s, 1, 99)
	end
end

function FootballFormulas.YouthSignFee(potential)
	return math.floor(FootballConfig.SCOUT_SIGN_BASE + potential * potential * FootballConfig.SCOUT_SIGN_PER_POTENTIAL2)
end

function FootballFormulas.ReleaseCost(player)
	return math.floor((player.salary or 0) * FootballConfig.SEASON_LENGTH * (player.contract or 0) * FootballConfig.RELEASE_COST_SHARE)
end

return FootballFormulas
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000013"><Properties><string name="Name">Format</string><ProtectedString name="Source"><![CDATA[-- Format (ModuleScript)
-- Ubicación: ReplicatedStorage/Shared/Modules/Format
-- Utilidades de formato compartidas por cliente y servidor.

local GameConfig = require(script.Parent.Parent.Config.GameConfig)

local Format = {}

-- 1234567 -> "1.234.567"
function Format.Thousands(n)
	n = math.floor(tonumber(n) or 0)
	local negative = n < 0
	local s = tostring(math.abs(n))
	local out = s:reverse():gsub("(%d%d%d)", "%1."):reverse()
	if out:sub(1, 1) == "." then
		out = out:sub(2)
	end
	return (negative and "-" or "") .. out
end

function Format.Money(n)
	return Format.Thousands(n) .. " " .. GameConfig.CURRENCY
end

function Format.SignedMoney(n)
	n = math.floor(tonumber(n) or 0)
	return (n >= 0 and "+" or "") .. Format.Money(n)
end

-- 1500 -> "1,5K"
function Format.Short(n)
	n = tonumber(n) or 0
	local abs = math.abs(n)
	if abs >= 1e6 then
		return (string.format("%.1fM", n / 1e6):gsub("%.", ","))
	elseif abs >= 1e3 then
		return (string.format("%.1fK", n / 1e3):gsub("%.", ","))
	end
	return tostring(math.floor(n))
end

function Format.Percent(x)
	return string.format("%d%%", math.floor((tonumber(x) or 0) * 100 + 0.5))
end

function Format.Duration(seconds)
	seconds = math.max(0, math.floor(seconds))
	return string.format("%d:%02d", math.floor(seconds / 60), seconds % 60)
end

return Format
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000014"><Properties><string name="Name">KitPattern</string><ProtectedString name="Source"><![CDATA[-- KitPattern (ModuleScript)
-- Ubicación: ReplicatedStorage/Shared/Modules/KitPattern
-- Dibuja una plantilla de equipación con Frames. Lo usan la interfaz (vista previa)
-- y el servidor (expositor de equipación del estadio, en un SurfaceGui).

local KitPattern = {}

local function block(parent, color, pos, size, rotation)
	local f = Instance.new("Frame")
	f.Name = "KitPart"
	f.BorderSizePixel = 0
	f.BackgroundColor3 = color
	f.Position = pos
	f.Size = size
	f.Rotation = rotation or 0
	f.Parent = parent
	return f
end

function KitPattern.Build(parent, pattern, primary, secondary)
	for _, child in ipairs(parent:GetChildren()) do
		if child.Name == "KitPart" then
			child:Destroy()
		end
	end
	parent.BackgroundColor3 = primary
	parent.ClipsDescendants = true

	if pattern == "vstripes" then
		for i = 0, 3 do
			block(parent, secondary, UDim2.fromScale(0.08 + i * 0.25, 0), UDim2.fromScale(0.12, 1))
		end
	elseif pattern == "halves" then
		block(parent, secondary, UDim2.fromScale(0.5, 0), UDim2.fromScale(0.5, 1))
	elseif pattern == "hoops" then
		for i = 0, 3 do
			block(parent, secondary, UDim2.fromScale(0, 0.08 + i * 0.25), UDim2.fromScale(1, 0.12))
		end
	elseif pattern == "sash" then
		block(parent, secondary, UDim2.fromScale(-0.25, 0.42), UDim2.fromScale(1.5, 0.18), -40)
	elseif pattern == "chest" then
		block(parent, secondary, UDim2.fromScale(0, 0.35), UDim2.fromScale(1, 0.25))
	elseif pattern == "quarters" then
		block(parent, secondary, UDim2.fromScale(0.5, 0), UDim2.fromScale(0.5, 0.5))
		block(parent, secondary, UDim2.fromScale(0, 0.5), UDim2.fromScale(0.5, 0.5))
	end
	-- Cuello
	block(parent, secondary, UDim2.fromScale(0.38, 0), UDim2.fromScale(0.24, 0.07))
end

return KitPattern
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000015"><Properties><string name="Name">MatchEngine</string><ProtectedString name="Source"><![CDATA[-- MatchEngine (ModuleScript)
-- Ubicación: ReplicatedStorage/Shared/Modules/MatchEngine
--
-- MOTOR DE PARTIDOS SIMULADOS (FASE 5). Función pura: recibe dos alineaciones y un
-- generador aleatorio y devuelve el resultado completo. El SERVIDOR es el único que
-- la ejecuta para partidos reales (con su propio Random); el cliente solo usa
-- TeamRatings para previsualizar el efecto de la alineación y las tácticas.
--
-- Hoja de equipo (TeamSheet):
--   { name, short, formation, mentality, style,
--     players = { { id, name, pos, slotPos, attrs = {...}, fitness } × 11 } }

local Config = script.Parent.Parent.Config
local TacticsConfig = require(Config.TacticsConfig)

local MatchEngine = {}

-- Factor de un jugador en su puesto: forma física y posición.
function MatchEngine.PlayerFactor(p)
	local factor = 0.7 + 0.3 * math.clamp((p.fitness or 100) / 100, 0, 1)
	if p.slotPos and p.slotPos ~= p.pos then
		if p.slotPos == "GK" or p.pos == "GK" then
			factor *= TacticsConfig.GK_OUT_OF_POSITION
		else
			factor *= TacticsConfig.OUT_OF_POSITION
		end
	end
	return factor
end

local function avg(list)
	if #list == 0 then
		return 30
	end
	local total = 0
	for _, v in ipairs(list) do
		total += v
	end
	return total / #list
end

-- Valoraciones de línea (0-100 aprox.) de una alineación.
function MatchEngine.TeamRatings(sheet, fatigue)
	local att, mid, def, gk = {}, {}, {}, {}
	local counts = { GK = 0, DEF = 0, MID = 0, FWD = 0 }
	for _, p in ipairs(sheet.players) do
		local a = p.attrs
		local f = MatchEngine.PlayerFactor(p)
		if fatigue then
			f *= 0.9 + 0.1 * (a.stamina or 50) / 100
		end
		local slot = p.slotPos or p.pos
		counts[slot] = (counts[slot] or 0) + 1
		if slot == "FWD" then
			table.insert(att, (a.shooting * 0.45 + a.dribbling * 0.25 + a.pace * 0.30) * f)
		elseif slot == "MID" then
			table.insert(mid, (a.passing * 0.45 + a.stamina * 0.25 + a.dribbling * 0.15 + a.defending * 0.15) * f)
			table.insert(att, (a.passing * 0.5 + a.dribbling * 0.3 + a.shooting * 0.2) * f * 0.67) -- llegada desde segunda línea
		elseif slot == "DEF" then
			table.insert(def, (a.defending * 0.6 + a.pace * 0.2 + a.stamina * 0.2) * f)
		else
			table.insert(gk, a.defending * f)
		end
	end
	local mentality = TacticsConfig.Mentality(sheet.mentality)
	local attack = avg(att) * (0.85 + 0.06 * counts.FWD) * mentality.attack
	local midfield = avg(mid) * (0.85 + 0.05 * counts.MID)
	local keeper = avg(gk)
	local defense = (avg(def) * 0.7 + keeper * 0.3) * (0.85 + 0.04 * counts.DEF) * mentality.defense
	return { attack = attack, midfield = midfield, defense = defense, keeper = keeper, counts = counts }
end

local function weightedPick(rng, players, weightFn, exclude)
	local total = 0
	local weights = {}
	for i, p in ipairs(players) do
		local w = (p ~= exclude) and math.max(0, weightFn(p)) or 0
		weights[i] = w
		total += w
	end
	if total <= 0 then
		return nil
	end
	local roll = rng:NextNumber() * total
	for i, p in ipairs(players) do
		roll -= weights[i]
		if roll <= 0 then
			return p
		end
	end
	return players[#players]
end

local SCORER_WEIGHT = { FWD = 5, MID = 2, DEF = 0.5, GK = 0 }

-- opts = { crowd = 0..1 (ocupación del estadio local) }
function MatchEngine.Simulate(home, away, rng, opts)
	opts = opts or {}
	local sides = { home, away }
	local homeBoost = 1 + TacticsConfig.HOME_ADVANTAGE + TacticsConfig.CROWD_ADVANTAGE * math.clamp(opts.crowd or 0, 0, 1)
	local stats = {
		{ goals = 0, shots = 0, onTarget = 0, possessionChunks = 0 },
		{ goals = 0, shots = 0, onTarget = 0, possessionChunks = 0 },
	}
	local events = {}
	local playerStats = {} -- [id] = { goals, assists }
	local function ps(p)
		playerStats[p.id] = playerStats[p.id] or { goals = 0, assists = 0 }
		return playerStats[p.id]
	end

	for chunk = 1, TacticsConfig.CHUNKS do
		local minuteStart = (chunk - 1) * 5
		local fatigue = minuteStart >= TacticsConfig.FATIGUE_MINUTE
		local ratings = { MatchEngine.TeamRatings(home, fatigue), MatchEngine.TeamRatings(away, fatigue) }
		for key in pairs({ attack = true, midfield = true, defense = true, keeper = true }) do
			ratings[1][key] *= homeBoost
		end
		local styles = { TacticsConfig.Style(home.style), TacticsConfig.Style(away.style) }

		local m1, m2 = ratings[1].midfield ^ 2, ratings[2].midfield ^ 2
		local possession = math.clamp(m1 / (m1 + m2) + styles[1].possession - styles[2].possession, 0.25, 0.75)
		stats[1].possessionChunks += possession
		stats[2].possessionChunks += 1 - possession

		for s = 1, 2 do
			local o = 3 - s
			local share = (s == 1) and possession or (1 - possession)
			local style = styles[s]
			-- Contraataque: más peligroso cuanto más balón tiene el rival
			local quality = style.quality
			if style.id == "COUNTER" then
				quality *= 0.9 + (1 - share) * 0.4
			end
			local balance = ratings[s].attack / (ratings[s].attack + ratings[o].defense)
			local chanceProb = TacticsConfig.CHANCE_BASE * share * 2 * (balance * 2) ^ TacticsConfig.BALANCE_EXPONENT * style.chances
			if rng:NextNumber() < chanceProb then
				local minute = minuteStart + rng:NextInteger(1, 5)
				local side = sides[s]
				local shooter = weightedPick(rng, side.players, function(p)
					return (SCORER_WEIGHT[p.slotPos or p.pos] or 1) * (p.attrs.shooting or 1)
				end) or side.players[#side.players]
				stats[s].shots += 1
				local onTarget = rng:NextNumber() < math.clamp(TacticsConfig.ON_TARGET_BASE * quality * (0.7 + shooter.attrs.shooting / 160), 0.1, 0.85)
				if onTarget then
					stats[s].onTarget += 1
					local keeper = ratings[o].keeper
					local goalProb = TacticsConfig.GOAL_BASE * quality * (2 * shooter.attrs.shooting / (shooter.attrs.shooting + keeper)) ^ 1.5
					if rng:NextNumber() < math.clamp(goalProb, 0.05, 0.8) then
						stats[s].goals += 1
						ps(shooter).goals += 1
						local assist
						if rng:NextNumber() < TacticsConfig.ASSIST_CHANCE then
							assist = weightedPick(rng, side.players, function(p)
								return (p.attrs.passing or 1) * ((p.slotPos or p.pos) == "GK" and 0.05 or 1)
							end, shooter)
							if assist then
								ps(assist).assists += 1
							end
						end
						table.insert(events, { minute = minute, type = "goal", side = s, player = shooter.name, playerId = shooter.id,
							assist = assist and assist.name or nil, assistId = assist and assist.id or nil })
					else
						table.insert(events, { minute = minute, type = "save", side = s, player = shooter.name })
					end
				else
					table.insert(events, { minute = minute, type = "miss", side = s, player = shooter.name })
				end
			end
		end
	end
	table.sort(events, function(a, b)
		return a.minute < b.minute
	end)

	local goals = { stats[1].goals, stats[2].goals }
	local possessionHome = math.floor(stats[1].possessionChunks / TacticsConfig.CHUNKS * 100 + 0.5)

	-- Valoraciones individuales (6,0 - 10,0)
	local ratingsByPlayer = {}
	for s = 1, 2 do
		local diff = goals[s] - goals[3 - s]
		local resultBonus = diff > 0 and 0.5 or (diff < 0 and -0.4 or 0)
		for _, p in ipairs(sides[s].players) do
			local st = playerStats[p.id] or { goals = 0, assists = 0 }
			local r = 6.4 + st.goals * 1.0 + st.assists * 0.6 + resultBonus + (rng:NextNumber() - 0.5)
			if (p.slotPos or p.pos) == "GK" or (p.slotPos or p.pos) == "DEF" then
				r += goals[3 - s] == 0 and 0.4 or -0.15 * math.max(0, goals[3 - s] - 1)
			end
			ratingsByPlayer[p.id] = math.clamp(math.floor(r * 10 + 0.5) / 10, 4.0, 10.0)
		end
	end
	local mvp, best = nil, -1
	for s = 1, 2 do
		for _, p in ipairs(sides[s].players) do
			if ratingsByPlayer[p.id] > best then
				best = ratingsByPlayer[p.id]
				mvp = { name = p.name, side = s, rating = best }
			end
		end
	end

	return {
		home = { name = home.name, short = home.short, goals = goals[1], shots = stats[1].shots, onTarget = stats[1].onTarget, possession = possessionHome },
		away = { name = away.name, short = away.short, goals = goals[2], shots = stats[2].shots, onTarget = stats[2].onTarget, possession = 100 - possessionHome },
		events = events,
		playerStats = playerStats,
		ratings = ratingsByPlayer,
		mvp = mvp,
		mode = "simulated",
	}
end

return MatchEngine
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000016"><Properties><string name="Name">PlacementRules</string><ProtectedString name="Source"><![CDATA[-- PlacementRules (ModuleScript)
-- Ubicación: ReplicatedStorage/Shared/Modules/PlacementRules
--
-- Reglas de colocación libre de decoraciones (CONSTRUCCIÓN AVANZADA, FASE 2).
-- El cliente las usa para colorear la vista previa; el SERVIDOR las vuelve a
-- aplicar antes de aceptar cualquier colocación. Constructor Pro solo cambia la
-- rejilla y el paso de rotación: las zonas, las colisiones y los límites son los mismos.

local Shared = script.Parent.Parent
local GameConfig = require(Shared.Config.GameConfig)
local CosmeticConfig = require(Shared.Config.CosmeticConfig)
local StadiumLayout = require(script.Parent.StadiumLayout)

local PlacementRules = {}

local MARGIN = 0.5 -- separación mínima entre decoraciones

function PlacementRules.Tools(isPro)
	return {
		grid = isPro and GameConfig.PRO_GRID or GameConfig.FREE_GRID,
		rotationStep = isPro and GameConfig.PRO_ROTATION_STEP or GameConfig.FREE_ROTATION_STEP,
	}
end

local function isMultiple(value, step)
	local q = value / step
	return math.abs(q - math.floor(q + 0.5)) < 1e-6
end

function PlacementRules.Snap(value, step)
	return math.floor(value / step + 0.5) * step
end

-- Semiejes del rectángulo envolvente (AABB) de una decoración rotada.
function PlacementRules.HalfExtents(decoId, rotation)
	local item = CosmeticConfig.ById.decoration[decoId]
	local w, d = item and item.w or 4, item and item.d or 4
	local r = math.rad(rotation or 0)
	local c, s = math.abs(math.cos(r)), math.abs(math.sin(r))
	return (w * c + d * s) / 2, (w * s + d * c) / 2
end

local function rectOf(decoId, x, z, rotation)
	local hx, hz = PlacementRules.HalfExtents(decoId, rotation)
	return { xMin = x - hx, xMax = x + hx, zMin = z - hz, zMax = z + hz }
end
PlacementRules.RectOf = rectOf

local function overlaps(a, b, margin)
	margin = margin or 0
	return a.xMin < b.xMax + margin and a.xMax > b.xMin - margin
		and a.zMin < b.zMax + margin and a.zMax > b.zMin - margin
end

local function inside(rect, zone)
	return rect.xMin >= zone.xMin and rect.xMax <= zone.xMax and rect.zMin >= zone.zMin and rect.zMax <= zone.zMax
end

local function finite(n)
	return type(n) == "number" and n == n and n ~= math.huge and n ~= -math.huge
end

-- params = { decorations, decoId, x, z, rotation, isPro, ignoreIndex }
-- Devuelve ok, motivo
function PlacementRules.Validate(params)
	local x, z, rotation = params.x, params.z, params.rotation
	if not finite(x) or not finite(z) or not finite(rotation) then
		return false, "Posición no válida."
	end
	if not CosmeticConfig.ById.decoration[params.decoId] then
		return false, "Esa decoración no existe."
	end
	local tools = PlacementRules.Tools(params.isPro)
	if rotation < 0 or rotation >= 360 or not isMultiple(rotation, tools.rotationStep) then
		return false, params.isPro and "Rotación no válida." or "La rotación libre a 45° es una herramienta de Constructor Pro."
	end
	if not isMultiple(x, tools.grid) or not isMultiple(z, tools.grid) then
		return false, params.isPro and "Posición fuera de la rejilla." or "La rejilla fina es una herramienta de Constructor Pro."
	end

	local rect = rectOf(params.decoId, x, z, rotation)
	local inZone = false
	for _, zone in ipairs(StadiumLayout.DecorationZones) do
		if inside(rect, zone) then
			inZone = true
			break
		end
	end
	if not inZone then
		return false, "Fuera de la zona de decoración de tu terreno."
	end
	for _, reserved in ipairs(StadiumLayout.Reserved) do
		if overlaps(rect, reserved) then
			return false, "Esa zona está reservada: " .. reserved.name .. "."
		end
	end
	for index, other in ipairs(params.decorations or {}) do
		if index ~= params.ignoreIndex then
			if overlaps(rect, rectOf(other.id, other.x, other.z, other.r), MARGIN) then
				return false, "Choca con otra decoración."
			end
		end
	end
	return true
end

return PlacementRules
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000017"><Properties><string name="Name">Remotes</string><ProtectedString name="Source"><![CDATA[-- Remotes (ModuleScript)
-- Ubicación: ReplicatedStorage/Shared/Modules/Remotes
--
-- Punto único de acceso a los RemoteEvents/RemoteFunctions.
-- El servidor los crea; el cliente espera a que existan.
--
--   Action (RemoteFunction)  cliente -> servidor: (accion, datos) -> { ok, message, ... }
--   State  (RemoteEvent)     servidor -> cliente: estado completo y saneado del propio club
--   Notify (RemoteEvent)     servidor -> cliente: (tipo, mensaje)
--   Shop   (RemoteEvent)     servidor -> cliente: estado de la Tienda Premium

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local FOLDER_NAME = "FEU_Remotes"
local DEFINITIONS = {
	Action = "RemoteFunction",
	State = "RemoteEvent",
	Notify = "RemoteEvent",
	Shop = "RemoteEvent",
}

local Remotes = {}

local function getFolder()
	if RunService:IsServer() then
		local folder = ReplicatedStorage:FindFirstChild(FOLDER_NAME)
		if not folder then
			folder = Instance.new("Folder")
			folder.Name = FOLDER_NAME
			folder.Parent = ReplicatedStorage
		end
		for name, className in pairs(DEFINITIONS) do
			if not folder:FindFirstChild(name) then
				local remote = Instance.new(className)
				remote.Name = name
				remote.Parent = folder
			end
		end
		return folder
	end
	return ReplicatedStorage:WaitForChild(FOLDER_NAME)
end

function Remotes.Get(name)
	assert(DEFINITIONS[name], "Remote desconocido: " .. tostring(name))
	return getFolder():WaitForChild(name)
end

return Remotes
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000018"><Properties><string name="Name">StadiumLayout</string><ProtectedString name="Source"><![CDATA[-- StadiumLayout (ModuleScript)
-- Ubicación: ReplicatedStorage/Shared/Modules/StadiumLayout
--
-- Plano del terreno en coordenadas LOCALES (iguales para todos los terrenos):
--   X: -150..150 · Z: -105..105 · Z+ = plaza y entrada principal.
-- Lo usan StadiumRenderer (servidor), PlacementRules (servidor y cliente) y el
-- modo de colocación del cliente. Cambiar el plano aquí lo cambia en todo el juego.
--
--            N (marcador)
--   ┌──────────────────────────────┐
--   │ carril O │  gradas + campo │ carril E │
--   │ vestuar. │                 │ entrenam.│
--   │ trofeos  │     CAMPO       │ zona VIP │
--   │ tienda   │                 │ restaur. │
--   │ academia │     PLAZA (decoraciones)   │
--   └────────────────── puerta ────┘

local StadiumLayout = {}

StadiumLayout.HALF_X = 150
StadiumLayout.HALF_Z = 105

StadiumLayout.PITCH_CENTER_Z = -10
StadiumLayout.PITCH_LENGTH = 100
StadiumLayout.PITCH_WIDTH = 64
StadiumLayout.ROW_DEPTH = 3
StadiumLayout.ROW_STEP = 1.5
StadiumLayout.ROWS_BY_LEVEL = { 4, 5, 6, 8, 10, 12, 14 }

-- Punto de aparición (mirando al campo)
StadiumLayout.SPAWN = Vector3.new(0, 4, 72)

-- Instalaciones en los carriles laterales
StadiumLayout.Facilities = {
	lockers = Vector3.new(-122, 0, -65),
	trophyRoom = Vector3.new(-122, 0, -12),
	shop = Vector3.new(-122, 0, 38),
	academy = Vector3.new(-122, 0, 86),
	training = Vector3.new(122, 0, -65),
	vip = Vector3.new(122, 0, -12),
	restaurant = Vector3.new(122, 0, 38),
}

-- Elementos fijos de la plaza
StadiumLayout.SIGN = Vector3.new(0, 0, 82)
StadiumLayout.KIT_DISPLAY = Vector3.new(-22, 0, 84)
StadiumLayout.MONUMENT = Vector3.new(0, 0, 96)

-- Zona donde se pueden colocar decoraciones (rectángulo local: xMin, xMax, zMin, zMax).
-- Está dentro del terreno y fuera de gradas, instalaciones y carriles.
StadiumLayout.DecorationZones = {
	{ xMin = -92, xMax = 92, zMin = 76, zMax = 102 },
}

-- Áreas reservadas dentro de la zona (no se puede colocar encima).
StadiumLayout.Reserved = {
	{ name = "Camino de entrada", xMin = -7, xMax = 7, zMin = 70, zMax = 105 },
	{ name = "Cartel del club", xMin = -15, xMax = 15, zMin = 79, zMax = 85 },
	{ name = "Expositor de equipación", xMin = -26, xMax = -18, zMin = 82, zMax = 86 },
}

return StadiumLayout
]]></ProtectedString></Properties></Item></Item></Item></Item><Item class="ServerScriptService" referent="RBX00000035"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Folder" referent="RBX00000034"><Properties><string name="Name">Server</string></Properties><Item class="Script" referent="RBX0000001C"><Properties><string name="Name">Main</string><ProtectedString name="Source"><![CDATA[-- Main (Script de servidor)
-- Ubicación: ServerScriptService/Server/Main
--
-- Arranque del servidor y enrutado de acciones del cliente.
-- Toda acción pasa por: límite de frecuencia -> datos cargados -> validación del
-- servicio correspondiente -> envío del estado actualizado al jugador.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.Config.GameConfig)
local StadiumStages = require(Shared.Config.StadiumStages)
local MenuConfig = require(Shared.Config.MenuConfig)
local Remotes = require(Shared.Modules.Remotes)

local Services = script.Parent.Services
local DataService = require(Services.DataService)
local GamePassService = require(Services.GamePassService)
local ClubService = require(Services.ClubService)
local EconomyService = require(Services.EconomyService)
local BuildService = require(Services.BuildService)
local StadiumService = require(Services.StadiumService)
local SponsorService = require(Services.SponsorService)
local SquadService = require(Services.SquadService)
local MatchService = require(Services.MatchService)
local TransferService = require(Services.TransferService)
local LeagueService = require(Services.LeagueService)
local UniverseService = require(Services.UniverseService)
local HistoryService = require(Services.HistoryService)
local InteractionService = require(Services.InteractionService)
local HalloweenService = require(Services.HalloweenService)
local PlotService = require(Services.PlotService)
local RateLimiter = require(script.Parent.Util.RateLimiter)

local actionRemote = Remotes.Get("Action")
local stateRemote = Remotes.Get("State")
local notifyRemote = Remotes.Get("Notify")

local limiter = RateLimiter.new(GameConfig.ACTION_RATE_LIMIT, GameConfig.ACTION_RATE_WINDOW)

-- ===== Estado que se envía al cliente (solo los datos del propio jugador) =====

local function buildState(player)
	local data = DataService.Get(player)
	if not data then
		return nil
	end
	local stage = StadiumStages.Get(data.stadium.stage)
	local plot = PlotService.GetPlot(player)
	return {
		version = GameConfig.VERSION,
		phase = MenuConfig.CURRENT_PHASE,
		saveEnabled = DataService.IsSaveEnabled(player),
		club = {
			name = ClubService.DisplayName(data),
			shortName = ClubService.ShortName(data),
			named = data.club.named,
			ownerName = player.DisplayName,
			founded = data.club.founded,
			fans = data.club.fans,
			members = data.club.members,
			satisfaction = data.club.satisfaction,
			appearance = data.club.appearance, -- selección guardada
			effectiveAppearance = ClubService.EffectiveAppearance(player, data), -- lo que se muestra
		},
		stadium = {
			stage = data.stadium.stage,
			stageName = stage.name,
			stageDescription = stage.description,
			maxStageThisPhase = StadiumStages.MAX_STAGE_THIS_PHASE,
			facilities = data.stadium.facilities,
			decorations = data.stadium.decorations, -- lista { id, x, z, r }
			decorationVisible = BuildService.DecorationVisibility(player, data), -- lista de booleanos
			maxDecorations = BuildService.MaxDecorations(player, data),
			tools = BuildService.Tools(player), -- rejilla y paso de rotación permitidos
			plotIndex = plot and plot.index or nil,
		},
		history = data.history,
		sponsors = data.sponsors,
		football = SquadService.BuildState(data), -- plantilla, cantera, temporada, leyendas (FASE 4)
		matchday = MatchService.BuildState(data), -- tácticas, amistosos, historial, récords (FASE 5)
		league = LeagueService.BuildState(data, ClubService.DisplayName(data), ClubService.ShortName(data)), -- ligas, copa y carrera (FASE 7)
		universe = UniverseService.BuildState(player, data), -- universo futbolístico (FASE 8)
		clubHistory = HistoryService.BuildState(data), -- historia del club (FASE 8)
		halloween = HalloweenService.BuildState(data), -- evento «Doces ou Travessuras»
		unlocks = data.unlocks,
		transfers = TransferService.BuildState(data, function(p) -- mercado, ofertas y presupuesto (FASE 6)
			return SquadService.PublicPlayer(p, data.academy.scouts)
		end),
		economy = EconomyService.Summary(player, data),
		premium = {
			owned = GamePassService.OwnedList(player),
		},
		stats = data.stats,
		settings = data.settings,
	}
end

local function pushState(player)
	if player.Parent then
		local state = buildState(player)
		if state then
			stateRemote:FireClient(player, state)
		end
	end
end

-- ===== Acciones =====
-- Cada manejador devuelve ok, mensaje, necesitaReconstruirEstadio

local Actions = {}

Actions.GetState = function(player)
	return true, nil, false
end

Actions.SetClubName = function(player, payload)
	if type(payload) ~= "table" then
		return false, "Solicitud no válida."
	end
	local ok, msg = ClubService.SetName(player, payload.name, payload.shortName)
	return ok, msg, ok
end

Actions.SetAppearance = function(player, payload)
	if type(payload) ~= "table" then
		return false, "Solicitud no válida."
	end
	local ok, msg = ClubService.SetAppearance(player, payload.slot, payload.id)
	return ok, msg, ok
end

Actions.UpgradeFacility = function(player, payload)
	if type(payload) ~= "table" then
		return false, "Solicitud no válida."
	end
	local ok, msg = BuildService.Upgrade(player, payload.facility)
	return ok, msg, ok
end

Actions.PlaceDecoration = function(player, payload)
	if type(payload) ~= "table" then
		return false, "Solicitud no válida."
	end
	local ok, msg = BuildService.PlaceDecoration(player, payload)
	return ok, msg, ok
end

Actions.MoveDecoration = function(player, payload)
	local ok, msg = BuildService.MoveDecoration(player, payload)
	return ok, msg, ok
end

Actions.RemoveDecoration = function(player, payload)
	local ok, msg = BuildService.RemoveDecoration(player, payload)
	return ok, msg, ok
end

Actions.UpgradeStage = function(player)
	local ok, msg = StadiumService.UpgradeStage(player)
	if ok then
		SponsorService.RefreshOffers(DataService.Get(player), false) -- nuevos huecos desbloqueados
	end
	return ok, msg, ok
end

-- ===== Plantilla y cantera (FASE 4) =====
Actions.SetTrainingIntensity = function(player, payload)
	return SquadService.SetIntensity(player, payload)
end

Actions.SetTrainingFocus = function(player, payload)
	return SquadService.SetFocus(player, payload)
end

Actions.RenewContract = function(player, payload)
	return SquadService.Renew(player, payload)
end

Actions.ReleasePlayer = function(player, payload)
	return SquadService.Release(player, payload)
end

Actions.PromoteYouth = function(player, payload)
	return SquadService.PromoteYouth(player, payload)
end

Actions.ReleaseYouth = function(player, payload)
	return SquadService.ReleaseYouth(player, payload)
end

Actions.SetScouts = function(player, payload)
	return SquadService.SetScouts(player, payload)
end

Actions.SignYouthReport = function(player, payload)
	return SquadService.SignReport(player, payload)
end

-- ===== Partidos y tácticas (FASE 5) =====
Actions.SetFormation = function(player, payload)
	return MatchService.SetFormation(player, payload)
end

Actions.SetTactic = function(player, payload)
	return MatchService.SetTactic(player, payload)
end

Actions.SetLineupSlot = function(player, payload)
	return MatchService.SetLineupSlot(player, payload)
end

Actions.AutoLineup = function(player)
	return MatchService.AutoLineupAction(player)
end

Actions.PlayFriendly = function(player, payload)
	local data = DataService.Get(player)
	local ok, msg, result = MatchService.PlayFriendly(player, payload, ClubService.DisplayName(data), ClubService.ShortName(data))
	if ok then
		for _, message in ipairs(result.messages) do
			notifyRemote:FireClient(player, "warning", message)
		end
	end
	return ok, msg, ok, result -- el 4.º valor viaja al cliente como "data" (resumen del partido)
end

-- ===== Mercado de fichajes (FASE 6) =====
Actions.BuyPlayer = function(player, payload)
	return TransferService.Buy(player, payload)
end

Actions.SetTransferListing = function(player, payload)
	return TransferService.SetListing(player, payload)
end

Actions.AcceptTransferOffer = function(player, payload)
	return TransferService.AcceptOffer(player, payload)
end

Actions.RejectTransferOffer = function(player, payload)
	return TransferService.RejectOffer(player, payload)
end

Actions.SetTransferBudget = function(player, payload)
	return TransferService.SetBudgetShare(player, payload)
end

-- ===== Evento de Halloween =====
Actions.HalloweenExchange = function(player, payload)
	local ok, msg = HalloweenService.Exchange(player, payload)
	return ok, msg, ok
end

-- ===== Universo (FASE 8) =====
Actions.VisitClub = function(player, payload)
	return UniverseService.Visit(player, payload, PlotService)
end

Actions.SetPricePolicy = function(player, payload)
	if type(payload) ~= "table" then
		return false, "Solicitud no válida."
	end
	return EconomyService.SetPricePolicy(player, payload.kind, payload.option)
end

Actions.AcceptSponsor = function(player, payload)
	local ok, msg = SponsorService.Accept(player, payload)
	return ok, msg, ok
end

Actions.TerminateSponsor = function(player, payload)
	local ok, msg = SponsorService.Terminate(player, payload)
	return ok, msg, ok
end

Actions.SetTicketPrice = function(player, payload)
	if type(payload) ~= "table" then
		return false, "Solicitud no válida."
	end
	return EconomyService.SetTicketPrice(player, payload.option)
end

Actions.RepayDebt = function(player, payload)
	local amount = type(payload) == "table" and payload.amount or 0
	return EconomyService.RepayDebt(player, amount)
end

Actions.TeleportHome = function(player)
	return PlotService.TeleportHome(player)
end

Actions.SaveSettings = function(player, payload)
	if type(payload) ~= "table" then
		return false, "Solicitud no válida."
	end
	local settings = DataService.Get(player).settings
	if type(payload.notifications) == "boolean" then
		settings.notifications = payload.notifications
	end
	if type(payload.compactMenu) == "boolean" then
		settings.compactMenu = payload.compactMenu
	end
	if type(payload.uiScale) == "number" and payload.uiScale == payload.uiScale then
		settings.uiScale = math.clamp(payload.uiScale, 0.8, 1.3)
	end
	return true, "Configuración guardada."
end

Actions.SaveNow = function(player)
	if not DataService.IsSaveEnabled(player) then
		return false, "El guardado no está disponible en esta sesión."
	end
	local ok = DataService.Save(player, false)
	return ok, ok and "Partida guardada." or "No se pudo guardar. Se reintentará automáticamente."
end

Actions.PurchasePass = function(player, payload)
	if type(payload) ~= "table" then
		return false, "Solicitud no válida."
	end
	return GamePassService.RequestPurchase(player, payload.pass)
end

Actions.RefreshShop = function(player)
	task.spawn(GamePassService.PushShop, player)
	return true
end

local busy = {} -- evita que un jugador ejecute dos acciones a la vez

actionRemote.OnServerInvoke = function(player, actionName, payload)
	if type(actionName) ~= "string" or not Actions[actionName] then
		return { ok = false, message = "Acción desconocida." }
	end
	if not limiter:Allow(player) then
		return { ok = false, message = "Vas demasiado rápido. Espera un momento." }
	end
	if not DataService.Get(player) then
		return { ok = false, message = "Tu club todavía se está cargando." }
	end
	if busy[player] then
		return { ok = false, message = "Procesando la acción anterior…" }
	end
	busy[player] = true
	local success, ok, message, rerender, extra = pcall(Actions[actionName], player, payload)
	busy[player] = nil
	if not success then
		warn("[Main] Error en la acción ", actionName, " de ", player.Name, ": ", ok)
		return { ok = false, message = "Error del servidor. Inténtalo de nuevo." }
	end
	if rerender then
		PlotService.RequestRender(player)
	end
	pushState(player)
	return { ok = ok == true, message = message, data = extra }
end

-- ===== Ciclo de vida de los jugadores =====

local function onPlayerAdded(player)
	PlotService.Assign(player)
	GamePassService.PlayerAdded(player)
	player.CharacterAdded:Connect(function()
		PlotService.CharacterAdded(player)
	end)

	local data = DataService.Load(player)
	if not data or not player.Parent then
		return
	end
	if not PlotService.GetPlot(player) then
		notifyRemote:FireClient(player, "error", "El servidor está lleno de estadios. Tu club funciona, pero tu estadio no se mostrará en este servidor.")
	end
	SquadService.EnsureSquad(data)
	MatchService.PlayerReady(player)
	TransferService.PlayerReady(player)
	LeagueService.PlayerReady(player)
	UniverseService.PlayerReady(player)
	task.spawn(function()
		local rewardMessage = UniverseService.ClaimWeekly(player)
		if rewardMessage then
			notifyRemote:FireClient(player, "success", rewardMessage)
			pushState(player)
		end
	end)
	EconomyService.PlayerReady(player)
	SponsorService.PlayerReady(player)
	PlotService.Render(player)
	if player.Character then
		PlotService.TeleportHome(player)
	end
	pushState(player)
	if not DataService.IsSaveEnabled(player) then
		notifyRemote:FireClient(player, "warning", "Guardado desactivado en esta sesión (DataStore no disponible). Tu progreso no se guardará.")
	end
	if DataService.IsNew(player) then
		notifyRemote:FireClient(player, "info", "¡Bienvenido, presidente! Ponle nombre a tu club en «Mi club».")
	end
end

local function onPlayerRemoving(player)
	EconomyService.PlayerRemoving(player)
	GamePassService.PlayerRemoving(player)
	limiter:Remove(player)
	busy[player] = nil
	UniverseService.PlayerRemoving(player) -- último perfil público antes de liberar los datos
	HalloweenService.PlayerRemoving(player)
	DataService.Release(player)
	PlotService.Release(player)
end

-- Cuando cambia la propiedad de un pase: se reconstruye el estadio y se actualiza la interfaz.
GamePassService.OnOwnershipChanged(function(player)
	if DataService.Get(player) then
		PlotService.RequestRender(player)
		pushState(player)
	end
end)

GamePassService.OnPurchaseConfirmed(function(player, passKey)
	local data = DataService.Get(player)
	if data then
		-- Registro informativo; NUNCA se usa como prueba de propiedad.
		table.insert(data.premium.purchaseLog, { pass = passKey, t = os.time() })
		while #data.premium.purchaseLog > 20 do
			table.remove(data.premium.purchaseLog, 1)
		end
	end
end)

EconomyService.OnCycle(function(player, cycle)
	local sponsorMessages = SponsorService.AfterCycle(player)
	for _, message in ipairs(sponsorMessages) do
		notifyRemote:FireClient(player, "info", message)
	end
	if #sponsorMessages > 0 then
		PlotService.RequestRender(player) -- quita vallas o nombre del estadio caducados
	end
	-- Liga y copa ANTES de que SquadService avance el reloj de la temporada
	local clubData = DataService.Get(player)
	if clubData then
		local leagueOut = LeagueService.AfterCycle(player, ClubService.DisplayName(clubData), ClubService.ShortName(clubData))
		for _, message in ipairs(leagueOut.messages) do
			notifyRemote:FireClient(player, "info", message)
		end
		UniverseService.AddWeeklyPoints(player, leagueOut.points)
		if leagueOut.result then
			notifyRemote:FireClient(player, "match", leagueOut.result) -- resumen para el visor de partidos
			PlotService.RequestRender(player) -- marcador y sala de trofeos
		end
	end
	for _, message in ipairs(SquadService.AfterCycle(player)) do
		notifyRemote:FireClient(player, "info", message)
	end
	for _, message in ipairs(TransferService.AfterCycle(player)) do -- después de SquadService (fin de cesiones)
		notifyRemote:FireClient(player, "info", message)
	end
	for _, message in ipairs(MatchService.AfterCycle(player)) do
		notifyRemote:FireClient(player, "info", message)
	end
	HistoryService.AfterCycle(player)
	PlotService.UpdateCrowd(player, cycle.occupancy)
	pushState(player)
	local data = DataService.Get(player)
	if data and data.settings.notifications then
		notifyRemote:FireClient(player, cycle.net >= 0 and "success" or "warning",
			string.format("Jornada: %d espectadores · balance %s%d %s", cycle.attendance,
				cycle.net >= 0 and "+" or "", cycle.net, GameConfig.CURRENCY))
	end
end)

-- ===== Arranque =====
PlotService.CreateWorld()
DataService.Start()
GamePassService.Start()
EconomyService.Start()
UniverseService.Start()
InteractionService.OnFacility(HalloweenService.AttachDoor)
InteractionService.Start()
HalloweenService.Start()

Players.PlayerAdded:Connect(onPlayerAdded)
Players.PlayerRemoving:Connect(onPlayerRemoving)
for _, player in ipairs(Players:GetPlayers()) do
	task.spawn(onPlayerAdded, player)
end

-- Envío periódico ligero del estado (cuenta atrás del ciclo, etc.)
task.spawn(function()
	while true do
		task.wait(15)
		for _, player in ipairs(Players:GetPlayers()) do
			pushState(player)
		end
	end
end)

print(string.format("[%s] Servidor iniciado · versión %s", GameConfig.GAME_NAME, GameConfig.VERSION))
]]></ProtectedString></Properties></Item><Item class="Folder" referent="RBX0000002E"><Properties><string name="Name">Services</string></Properties><Item class="ModuleScript" referent="RBX0000001D"><Properties><string name="Name">BuildService</string><ProtectedString name="Source"><![CDATA[-- BuildService (ModuleScript)
-- Ubicación: ServerScriptService/Server/Services/BuildService
--
-- Construcción validada en el servidor:
--   * Mejorar instalaciones (coste, nivel máximo, etapa del estadio, requisitos, deuda).
--   * CONSTRUCCIÓN AVANZADA (FASE 2): colocar, mover y retirar decoraciones en
--     posición libre dentro de la zona de decoración del propio terreno.
--     PlacementRules valida zona, áreas reservadas, colisiones, rejilla y rotación.
--   * Constructor Pro: rejilla fina (1 stud), rotación a 45° y +6 decoraciones,
--     con exactamente las mismas zonas, colisiones y costes que el resto.
-- Solo se puede modificar el estadio propio: ninguna acción recibe el ID de otro jugador.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local GameConfig = require(Shared.Config.GameConfig)
local FacilityConfig = require(Shared.Config.FacilityConfig)
local CosmeticConfig = require(Shared.Config.CosmeticConfig)
local GamePassConfig = require(Shared.Config.GamePassConfig)
local EconomyFormulas = require(Shared.Modules.EconomyFormulas)
local PlacementRules = require(Shared.Modules.PlacementRules)

local DataService = require(script.Parent.DataService)
local EconomyService = require(script.Parent.EconomyService)
local GamePassService = require(script.Parent.GamePassService)

local BuildService = {}

function BuildService.IsPro(player)
	return GamePassService.Owns(player, "CONSTRUCTOR_PRO")
end

-- Límite de decoraciones: el de la etapa del estadio + extra de Constructor Pro.
function BuildService.MaxDecorations(player, data)
	local limit = EconomyFormulas.FreeDecorationLimit(data.stadium.stage)
	if BuildService.IsPro(player) then
		limit += GameConfig.PRO_EXTRA_DECORATIONS
	end
	return math.min(limit, GameConfig.MAX_DECORATIONS)
end

function BuildService.Tools(player)
	return PlacementRules.Tools(BuildService.IsPro(player))
end

function BuildService.Upgrade(player, facilityId)
	local data = DataService.Get(player)
	if type(facilityId) ~= "string" then
		return false, "Solicitud no válida."
	end
	local ok, reason, levelData = EconomyFormulas.CanUpgrade(data, facilityId)
	if not ok then
		return false, reason
	end
	local def = FacilityConfig.Get(facilityId)
	local newLevel = (data.stadium.facilities[facilityId] or 0) + 1
	local paid, payError = EconomyService.Spend(player, levelData.cost, EconomyService.Category.CONSTRUCTION,
		string.format("%s nivel %d", def.name, newLevel))
	if not paid then
		return false, payError
	end
	data.stadium.facilities[facilityId] = newLevel
	data.stats.buildings += 1
	local verb = newLevel == 1 and "construida" or "mejorada a nivel " .. newLevel
	return true, string.format("%s %s %s.", def.icon, def.name, verb)
end

local function readPlacement(payload)
	if type(payload) ~= "table" then
		return nil
	end
	local x, z, r = tonumber(payload.x), tonumber(payload.z), tonumber(payload.rotation)
	if not x or not z or not r then
		return nil
	end
	return x, z, r
end

local function passCheck(player, item)
	if item.requiredUnlock and not DataService.Get(player).unlocks[item.requiredUnlock] then
		return false, string.format("«%s» se consigue canjeando caramelos en el evento de Halloween.", item.name)
	end
	if item.requiredPass and not GamePassService.Owns(player, item.requiredPass) then
		local pass = GamePassConfig.Get(item.requiredPass)
		return false, string.format("«%s» requiere el pase %s.", item.name, pass and pass.name or "?")
	end
	return true
end

function BuildService.PlaceDecoration(player, payload)
	local data = DataService.Get(player)
	local decoId = type(payload) == "table" and payload.decoration
	local item = type(decoId) == "string" and CosmeticConfig.ById.decoration[decoId]
	if not item then
		return false, "Esa decoración no existe."
	end
	local x, z, rotation = readPlacement(payload)
	if not x then
		return false, "Posición no válida."
	end
	local allowed, passError = passCheck(player, item)
	if not allowed then
		return false, passError
	end
	local list = data.stadium.decorations
	local max = BuildService.MaxDecorations(player, data)
	if #list >= max then
		if not BuildService.IsPro(player) then
			return false, string.format("Has alcanzado el límite de %d decoraciones de tu etapa. Asciende el estadio o usa Constructor Pro.", max)
		end
		return false, string.format("Has alcanzado el límite de %d decoraciones.", max)
	end
	local ok, reason = PlacementRules.Validate({
		decorations = list, decoId = decoId, x = x, z = z, rotation = rotation, isPro = BuildService.IsPro(player),
	})
	if not ok then
		return false, reason
	end
	if data.economy.debt > GameConfig.DEBT_BUILD_LIMIT then
		return false, "Tu deuda es demasiado alta para construir. Págala primero."
	end
	local paid, payError = EconomyService.Spend(player, item.cost, EconomyService.Category.DECORATION, item.name)
	if not paid then
		return false, payError
	end
	table.insert(list, { id = decoId, x = x, z = z, r = rotation })
	return true, string.format("«%s» colocada.", item.name)
end

-- Comprueba que el índice enviado corresponde a la decoración esperada (evita estados obsoletos).
local function findDecoration(data, payload)
	if type(payload) ~= "table" then
		return nil
	end
	local index = tonumber(payload.index)
	if not index or index ~= math.floor(index) then
		return nil
	end
	local entry = data.stadium.decorations[index]
	if not entry or entry.id ~= payload.decoration then
		return nil
	end
	return index, entry
end

function BuildService.MoveDecoration(player, payload)
	local data = DataService.Get(player)
	local index, entry = findDecoration(data, payload)
	if not index then
		return false, "Esa decoración ya no está ahí. Vuelve a intentarlo."
	end
	local x, z, rotation = readPlacement(payload)
	if not x then
		return false, "Posición no válida."
	end
	local ok, reason = PlacementRules.Validate({
		decorations = data.stadium.decorations, decoId = entry.id, x = x, z = z, rotation = rotation,
		isPro = BuildService.IsPro(player), ignoreIndex = index,
	})
	if not ok then
		return false, reason
	end
	entry.x, entry.z, entry.r = x, z, rotation
	return true, "Decoración movida."
end

function BuildService.RemoveDecoration(player, payload)
	local data = DataService.Get(player)
	local index, entry = findDecoration(data, payload)
	if not index then
		return false, "Esa decoración ya no está ahí. Vuelve a intentarlo."
	end
	local item = CosmeticConfig.ById.decoration[entry.id]
	table.remove(data.stadium.decorations, index)
	local refund = math.floor((item and item.cost or 0) * CosmeticConfig.DECORATION_REFUND)
	EconomyService.Earn(player, refund, EconomyService.Category.REFUND, "Retirada: " .. (item and item.name or entry.id))
	return true, string.format("Decoración retirada (+%d %s).", refund, GameConfig.CURRENCY)
end

-- Qué decoraciones se muestran: dentro del límite actual y con su pase confirmado.
-- Devuelve una lista de booleanos alineada con data.stadium.decorations.
-- Las que no se muestran se conservan y reaparecen al recuperar el límite o la propiedad.
function BuildService.DecorationVisibility(player, data)
	local visible = {}
	local max = BuildService.MaxDecorations(player, data)
	local shown = 0
	for index, entry in ipairs(data.stadium.decorations) do
		local item = CosmeticConfig.ById.decoration[entry.id]
		local ok = item ~= nil and shown < max
			and (item.requiredPass == nil or GamePassService.Owns(player, item.requiredPass))
			and (item.requiredUnlock == nil or data.unlocks[item.requiredUnlock] == true)
		if ok then
			shown += 1
		end
		visible[index] = ok
	end
	return visible
end

return BuildService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000001E"><Properties><string name="Name">ClubService</string><ProtectedString name="Source"><![CDATA[-- ClubService (ModuleScript)
-- Ubicación: ServerScriptService/Server/Services/ClubService
--
-- Identidad del club: nombre (filtrado por Roblox), abreviatura y apariencia
-- (escudo, colores, equipación, efectos y diseños de construcción).
-- Las opciones de pago se validan con GamePassService.Owns en el SERVIDOR.

local TextService = game:GetService("TextService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local GameConfig = require(Shared.Config.GameConfig)
local CosmeticConfig = require(Shared.Config.CosmeticConfig)
local GamePassConfig = require(Shared.Config.GamePassConfig)

local GamePassService = require(script.Parent.GamePassService)
local DataService = require(script.Parent.DataService)

local ClubService = {}

local function filterText(player, text)
	local ok, result = pcall(function()
		local filterResult = TextService:FilterStringAsync(text, player.UserId, Enum.TextFilterContext.PublicChat)
		return filterResult:GetNonChatStringForBroadcastAsync()
	end)
	if not ok then
		return nil
	end
	return result
end

local function cleanInput(text, maxLen)
	if type(text) ~= "string" then
		return nil
	end
	text = text:gsub("[%c]", ""):gsub("^%s+", ""):gsub("%s+$", ""):gsub("%s+", " ")
	if utf8.len(text) == nil then
		return nil
	end
	if utf8.len(text) > maxLen then
		return nil
	end
	return text
end

-- Devuelve ok, mensaje
function ClubService.SetName(player, name, shortName)
	local data = DataService.Get(player)
	name = cleanInput(name, GameConfig.CLUB_NAME_MAX)
	shortName = cleanInput(shortName, GameConfig.SHORT_NAME_LEN)
	if not name or utf8.len(name) < GameConfig.CLUB_NAME_MIN then
		return false, string.format("El nombre debe tener entre %d y %d caracteres.", GameConfig.CLUB_NAME_MIN, GameConfig.CLUB_NAME_MAX)
	end
	if not shortName or not shortName:match("^%w%w%w$") then
		return false, "La abreviatura debe tener exactamente 3 letras o números."
	end
	shortName = shortName:upper()

	local filteredName = filterText(player, name)
	local filteredShort = filterText(player, shortName)
	if not filteredName or not filteredShort then
		return false, "No se pudo verificar el nombre con el filtro de Roblox. Inténtalo de nuevo."
	end
	if filteredName ~= name or filteredShort ~= shortName then
		return false, "Ese nombre no está permitido. Prueba con otro."
	end
	data.club.name = filteredName
	data.club.shortName = filteredShort
	data.club.named = true
	return true, "Nombre del club actualizado."
end

local function catalogItem(slot, itemId)
	local rule = CosmeticConfig.AppearanceSlots[slot]
	if not rule then
		return nil
	end
	local item = CosmeticConfig.ById[rule.catalog][itemId]
	if not item then
		return nil
	end
	if rule.appliesTo and item.appliesTo ~= rule.appliesTo then
		return nil
	end
	return item
end

function ClubService.CanUse(player, item)
	if item.requiredUnlock then
		-- Desbloqueos gratuitos de eventos (guardados en los datos del club)
		local data = DataService.Get(player)
		if not (data and data.unlocks[item.requiredUnlock]) then
			return false
		end
	end
	return item.requiredPass == nil or GamePassService.Owns(player, item.requiredPass)
end

function ClubService.SetAppearance(player, slot, itemId)
	local data = DataService.Get(player)
	if type(slot) ~= "string" or type(itemId) ~= "string" then
		return false, "Solicitud no válida."
	end
	local item = catalogItem(slot, itemId)
	if not item then
		return false, "Esa opción no existe."
	end
	if not ClubService.CanUse(player, item) then
		if item.requiredUnlock then
			return false, string.format("«%s» se consigue canjeando caramelos en el evento de Halloween.", item.name)
		end
		local pass = GamePassConfig.Get(item.requiredPass)
		return false, string.format("Necesitas el pase %s para usar «%s».", pass and pass.name or "?", item.name)
	end
	data.club.appearance[slot] = itemId
	return true, string.format("«%s» aplicado.", item.name)
end

-- Apariencia que REALMENTE se muestra: si una opción guardada requiere un pase
-- cuya propiedad no está confirmada ahora mismo, se usa la opción gratuita por defecto.
-- La selección guardada no se borra: vuelve a mostrarse cuando Roblox confirme la propiedad.
function ClubService.EffectiveAppearance(player, data)
	local effective = {}
	for slot in pairs(CosmeticConfig.AppearanceSlots) do
		local item = catalogItem(slot, data.club.appearance[slot])
		if item and ClubService.CanUse(player, item) then
			effective[slot] = item.id
		else
			effective[slot] = CosmeticConfig.Defaults[slot]
		end
	end
	return effective
end

function ClubService.IsVip(player)
	return GamePassService.Owns(player, "VIP_CLUB")
end

function ClubService.DisplayName(data)
	if data.club.named and data.club.name ~= "" then
		return data.club.name
	end
	return "Club de " .. tostring(data.club.ownerName)
end

function ClubService.ShortName(data)
	if data.club.named and data.club.shortName ~= "" then
		return data.club.shortName
	end
	return "FEU"
end

return ClubService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000001F"><Properties><string name="Name">DataService</string><ProtectedString name="Source"><![CDATA[-- DataService (ModuleScript)
-- Ubicación: ServerScriptService/Server/Services/DataService
--
-- Guardado persistente con DataStoreService:
--   * UpdateAsync con BLOQUEO DE SESIÓN (evita que dos servidores pisen los datos).
--   * Reintentos controlados con espera exponencial.
--   * Validación/reparación de datos al cargar (DefaultData.Reconcile).
--   * Guardado periódico, al salir y al cerrar el servidor (BindToClose).
--   * Si DataStore no está disponible (p. ej. Studio sin "API Services"), el juego
--     sigue funcionando en MODO SIN GUARDADO y se avisa al jugador.

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameConfig = require(ReplicatedStorage.Shared.Config.GameConfig)
local Util = script.Parent.Parent.Util
local DefaultData = require(Util.DefaultData)
local Retry = require(Util.Retry)

local DataService = {}

local profiles = {} -- [player] = { data = table, saveEnabled = bool, lastSave = number }
local loadedCallbacks = {}
local store = nil
local storeAvailable = true

local LOCK_WAIT_SECONDS = 5
local LOCK_WAIT_ATTEMPTS = 6

local function jobId()
	-- En Studio el JobId está vacío: usamos un identificador fijo por sesión.
	if game.JobId == "" then
		return "studio-session"
	end
	return game.JobId
end

local function key(userId)
	return "club_" .. tostring(userId)
end

local function isAccessError(err)
	local msg = tostring(err)
	return msg:find("403") ~= nil
		or msg:find("API Services") ~= nil
		or msg:find("API access") ~= nil
		or msg:find("Studio") ~= nil
		or msg:find("publish") ~= nil
end

do
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(GameConfig.DATASTORE_NAME)
	end)
	if ok then
		store = result
	else
		storeAvailable = false
		warn("[DataService] DataStore no disponible: ", result)
	end
end

-- Intenta cargar y bloquear los datos. Devuelve: estado ("ok" | "locked" | "error" | "noaccess"), datos
local function tryLoad(player)
	local status, loaded = "ok", nil
	local ok, err = Retry.Call(3, 1, function()
		store:UpdateAsync(key(player.UserId), function(stored)
			local now = os.time()
			if type(stored) == "table" and type(stored.lock) == "table"
				and stored.lock.jobId ~= jobId()
				and now - (tonumber(stored.lock.time) or 0) < GameConfig.SESSION_LOCK_SECONDS then
				status = "locked"
				return nil -- cancela la escritura
			end
			status = "ok"
			local data = (type(stored) == "table" and stored.data) or nil
			loaded = data
			return {
				data = data,
				lock = { jobId = jobId(), time = now },
			}
		end)
	end)
	if not ok then
		if isAccessError(err) then
			return "noaccess", nil
		end
		warn("[DataService] Error cargando datos de ", player.Name, ": ", err)
		return "error", nil
	end
	return status, loaded
end

function DataService.Load(player)
	local saveEnabled = storeAvailable
	local rawData = nil

	if storeAvailable then
		local status
		for _ = 1, LOCK_WAIT_ATTEMPTS do
			status, rawData = tryLoad(player)
			if status ~= "locked" then
				break
			end
			if not player.Parent then
				return nil
			end
			task.wait(LOCK_WAIT_SECONDS)
		end
		if status == "locked" then
			player:Kick("Tus datos siguen abiertos en otro servidor. Vuelve a entrar en un minuto.")
			return nil
		elseif status == "noaccess" then
			warn("[DataService] Sin acceso a DataStore (activa 'Enable Studio Access to API Services'). MODO SIN GUARDADO.")
			saveEnabled = false
		elseif status == "error" then
			-- No sobrescribimos datos que no hemos podido leer: sesión sin guardado.
			saveEnabled = false
		end
	end

	local data = DefaultData.Reconcile(rawData, player)
	profiles[player] = { data = data, saveEnabled = saveEnabled, lastSave = os.clock(), isNew = rawData == nil }

	if not player.Parent then
		-- Se fue mientras cargaba: liberamos el bloqueo que acabamos de tomar.
		DataService.Release(player)
		return nil
	end
	for _, callback in ipairs(loadedCallbacks) do
		task.spawn(callback, player, data)
	end
	return data
end

function DataService.Save(player, release)
	local profile = profiles[player]
	if not profile or not profile.saveEnabled then
		return false
	end
	profile.data.lastSave = os.time()
	local lostLock = false
	local ok, err = Retry.Call(3, 1, function()
		store:UpdateAsync(key(player.UserId), function(stored)
			if type(stored) == "table" and type(stored.lock) == "table" and stored.lock.jobId ~= jobId() then
				lostLock = true
				return nil -- otro servidor tiene la sesión: no sobrescribimos
			end
			return {
				data = profile.data,
				lock = (not release) and { jobId = jobId(), time = os.time() } or nil,
			}
		end)
	end)
	if not ok then
		warn("[DataService] Error guardando datos de ", player.Name, ": ", err)
		return false
	end
	if lostLock then
		warn("[DataService] Bloqueo de sesión perdido para ", player.Name, "; no se guardó.")
		profile.saveEnabled = false
		return false
	end
	profile.lastSave = os.clock()
	return true
end

function DataService.Get(player)
	local profile = profiles[player]
	return profile and profile.data or nil
end

function DataService.IsSaveEnabled(player)
	local profile = profiles[player]
	return profile ~= nil and profile.saveEnabled
end

function DataService.IsNew(player)
	local profile = profiles[player]
	return profile ~= nil and profile.isNew
end

function DataService.OnLoaded(callback)
	table.insert(loadedCallbacks, callback)
end

function DataService.Release(player)
	if profiles[player] then
		DataService.Save(player, true)
		profiles[player] = nil
	end
end

function DataService.Start()
	-- Guardado periódico
	task.spawn(function()
		while true do
			task.wait(GameConfig.AUTOSAVE_SECONDS)
			for player in pairs(profiles) do
				if player.Parent then
					task.spawn(DataService.Save, player, false)
				end
			end
		end
	end)

	game:BindToClose(function()
		local pending = 0
		for player in pairs(profiles) do
			pending += 1
			task.spawn(function()
				DataService.Save(player, true)
				pending -= 1
			end)
		end
		local start = os.clock()
		while pending > 0 and os.clock() - start < 25 do
			task.wait(0.2)
		end
		if RunService:IsStudio() then
			task.wait(1)
		end
	end)
end

return DataService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000020"><Properties><string name="Name">EconomyService</string><ProtectedString name="Source"><![CDATA[-- EconomyService (ModuleScript)
-- Ubicación: ServerScriptService/Server/Services/EconomyService
--
-- Economía AUTORITATIVA del servidor:
--   * Ciclo económico periódico (jornada) con ingresos y gastos reales.
--   * Gastos puntuales (construcción) validados.
--   * Deuda con intereses y amortización.
--   * Historial de transacciones.
-- El cliente nunca envía cantidades de dinero: solo intenciones (p. ej. "mejorar gradas").

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local GameConfig = require(Shared.Config.GameConfig)
local EconomyFormulas = require(Shared.Modules.EconomyFormulas)
local CommercialConfig = require(Shared.Config.CommercialConfig)

local DataService = require(script.Parent.DataService)

local EconomyService = {}

local nextCycleAt = {} -- [player] = os.clock() del próximo ciclo
local cycleCallbacks = {}

EconomyService.Category = {
	TICKETS = "Entradas",
	SHOP = "Tienda",
	RESTAURANT = "Restaurante",
	SPONSORS = "Patrocinadores",
	VIP = "Zona VIP",
	MAINTENANCE = "Mantenimiento",
	STAFF = "Personal",
	WAGES = "Salarios",
	INTEREST = "Intereses",
	CONSTRUCTION = "Construcción",
	DECORATION = "Decoración",
	DEBT = "Deuda",
	REFUND = "Reembolso",
	SPONSOR = "Patrocinio",
	ACADEMY = "Academia",
	TRANSFER = "Fichajes",
	PRIZE = "Premios",
}
local C = EconomyService.Category

function EconomyService.AddTransaction(data, amount, category, note)
	local list = data.economy.transactions
	table.insert(list, {
		t = os.time(),
		amount = math.floor(amount),
		category = category,
		note = note,
	})
	while #list > GameConfig.MAX_TRANSACTIONS do
		table.remove(list, 1)
	end
end

-- Gasto puntual validado. Devuelve ok, mensaje.
function EconomyService.Spend(player, amount, category, note)
	local data = DataService.Get(player)
	amount = math.floor(tonumber(amount) or -1)
	if amount < 0 then
		return false, "Cantidad no válida."
	end
	if data.economy.money < amount then
		return false, "Dinero insuficiente."
	end
	data.economy.money -= amount
	data.economy.totalSpent += amount
	EconomyService.AddTransaction(data, -amount, category, note)
	return true
end

function EconomyService.Earn(player, amount, category, note)
	local data = DataService.Get(player)
	amount = math.floor(tonumber(amount) or 0)
	if amount <= 0 then
		return
	end
	data.economy.money += amount
	data.economy.totalEarned += amount
	EconomyService.AddTransaction(data, amount, category, note)
end

function EconomyService.RunCycle(player)
	local data = DataService.Get(player)
	if not data then
		return
	end
	local result = EconomyFormulas.Cycle(data)
	local economy = data.economy

	economy.money += result.totalIncome
	economy.totalEarned += result.totalIncome
	economy.money -= result.totalExpenses
	economy.totalSpent += result.totalExpenses

	-- Déficit -> deuda
	local newDebt = 0
	if economy.money < 0 then
		newDebt = -economy.money
		economy.debt += newDebt
		economy.money = 0
	end

	-- Amortización automática con parte del beneficio
	local repaid = 0
	if result.net > 0 and economy.debt > 0 then
		repaid = math.min(economy.debt, math.floor(result.net * GameConfig.DEBT_AUTO_REPAY_SHARE), economy.money)
		economy.debt -= repaid
		economy.money -= repaid
	end

	data.club.fans = math.max(0, data.club.fans + result.fanDelta)
	data.club.members = math.clamp((data.club.members or 0) + result.memberDelta, 0, data.club.fans)
	data.club.satisfaction = math.clamp((data.club.satisfaction or GameConfig.SATISFACTION_START) + result.satisfactionDelta, 0, 100)
	data.stats.cycles += 1

	economy.lastCycle = {
		t = os.time(),
		attendance = result.attendance,
		capacity = result.capacity,
		income = result.income,
		expenses = result.expenses,
		totalIncome = result.totalIncome,
		totalExpenses = result.totalExpenses,
		net = result.net,
		fanDelta = result.fanDelta,
		memberDelta = result.memberDelta,
		satisfaction = data.club.satisfaction,
		occupancy = result.occupancy,
		contracts = result.contracts,
		newDebt = newDebt,
		repaid = repaid,
	}

	local summary = string.format("%d espectadores", result.attendance)
	EconomyService.AddTransaction(data, result.totalIncome, "Jornada", "Ingresos · " .. summary)
	EconomyService.AddTransaction(data, -result.totalExpenses, "Jornada", "Gastos (mantenimiento, personal, estadio, intereses)")
	if newDebt > 0 then
		EconomyService.AddTransaction(data, 0, C.DEBT, string.format("Déficit de %d convertido en deuda", newDebt))
	end
	if repaid > 0 then
		EconomyService.AddTransaction(data, -repaid, C.DEBT, "Amortización automática de deuda")
	end

	for _, callback in ipairs(cycleCallbacks) do
		task.spawn(callback, player, economy.lastCycle)
	end
end

function EconomyService.RepayDebt(player, amount)
	local data = DataService.Get(player)
	local economy = data.economy
	if economy.debt <= 0 then
		return false, "No tienes deuda."
	end
	amount = math.floor(tonumber(amount) or 0)
	if amount <= 0 then
		amount = economy.debt -- 0 o vacío = pagar todo lo posible
	end
	amount = math.min(amount, economy.debt, economy.money)
	if amount <= 0 then
		return false, "No tienes dinero para pagar la deuda."
	end
	economy.money -= amount
	economy.debt -= amount
	economy.totalSpent += amount
	EconomyService.AddTransaction(data, -amount, C.DEBT, "Pago de deuda")
	return true, "Has pagado " .. amount .. " " .. GameConfig.CURRENCY .. " de deuda."
end

function EconomyService.SetTicketPrice(player, optionId)
	local data = DataService.Get(player)
	for _, option in ipairs(GameConfig.TICKET_PRICES) do
		if option.id == optionId then
			data.economy.ticketPrice = option.id
			return true, "Precio de entradas: " .. option.name
		end
	end
	return false, "Precio no válido."
end

-- kind: "shop" | "food" | "member"
function EconomyService.SetPricePolicy(player, kind, optionId)
	local data = DataService.Get(player)
	local field, list, label
	if kind == "shop" then
		field, list, label = "shopPrice", CommercialConfig.PricePolicies, "Precios de la tienda"
	elseif kind == "food" then
		field, list, label = "foodPrice", CommercialConfig.PricePolicies, "Precios de restauración"
	elseif kind == "member" then
		field, list, label = "memberPrice", GameConfig.MEMBER_PRICES, "Precio de los abonos"
	else
		return false, "Solicitud no válida."
	end
	for _, option in ipairs(list) do
		if option.id == optionId then
			data.economy[field] = option.id
			return true, label .. ": " .. option.name
		end
	end
	return false, "Opción no válida."
end

function EconomyService.SecondsToNextCycle(player)
	local at = nextCycleAt[player]
	if not at then
		return GameConfig.ECONOMY_CYCLE_SECONDS
	end
	return math.max(0, at - os.clock())
end

-- Resumen económico para la interfaz.
function EconomyService.Summary(player, data)
	local forecast = EconomyFormulas.Cycle(data)
	local averageIncome = forecast.totalIncome
	return {
		money = data.economy.money,
		debt = data.economy.debt,
		debtLimit = GameConfig.DEBT_BUILD_LIMIT,
		ticketPrice = data.economy.ticketPrice,
		totalEarned = data.economy.totalEarned,
		totalSpent = data.economy.totalSpent,
		clubValue = EconomyFormulas.ClubValue(data),
		wageBudget = math.floor(averageIncome * GameConfig.WAGE_BUDGET_SHARE_OF_INCOME),
		transferBudget = math.floor(data.economy.money * GameConfig.TRANSFER_BUDGET_SHARE_OF_MONEY),
		lastCycle = data.economy.lastCycle,
		forecast = {
			attendance = forecast.attendance,
			capacity = forecast.capacity,
			attractiveness = forecast.attractiveness,
			income = forecast.income,
			expenses = forecast.expenses,
			totalIncome = forecast.totalIncome,
			totalExpenses = forecast.totalExpenses,
			net = forecast.net,
			fanCap = forecast.fanCap,
			occupancy = forecast.occupancy,
			overcrowded = forecast.overcrowded,
			membersAttending = forecast.membersAttending,
			casual = forecast.casual,
			satisfactionTarget = forecast.satisfactionTarget,
			satisfactionFactors = forecast.satisfactionFactors,
			spendMultiplier = forecast.spendMultiplier,
			memberTarget = forecast.memberTarget,
			contracts = forecast.contracts,
		},
		memberPrice = data.economy.memberPrice,
		shopPrice = data.economy.shopPrice,
		foodPrice = data.economy.foodPrice,
		reputation = forecast.reputation,
		cycleSeconds = GameConfig.ECONOMY_CYCLE_SECONDS,
		nextCycleIn = EconomyService.SecondsToNextCycle(player),
		transactions = data.economy.transactions,
	}
end

function EconomyService.OnCycle(callback)
	table.insert(cycleCallbacks, callback)
end

function EconomyService.PlayerReady(player)
	nextCycleAt[player] = os.clock() + GameConfig.ECONOMY_CYCLE_SECONDS
end

function EconomyService.PlayerRemoving(player)
	nextCycleAt[player] = nil
end

function EconomyService.Start()
	task.spawn(function()
		while true do
			task.wait(1)
			local now = os.clock()
			for player, at in pairs(nextCycleAt) do
				if now >= at then
					nextCycleAt[player] = at + GameConfig.ECONOMY_CYCLE_SECONDS
					if player.Parent and DataService.Get(player) then
						local ok, err = pcall(EconomyService.RunCycle, player)
						if not ok then
							warn("[EconomyService] Error en el ciclo de ", player.Name, ": ", err)
						end
					end
				end
			end
		end
	end)
end

return EconomyService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000021"><Properties><string name="Name">GamePassService</string><ProtectedString name="Source"><![CDATA[-- GamePassService (ModuleScript)
-- Ubicación: ServerScriptService/Server/Services/GamePassService
--
-- Integración REAL con MarketplaceService:
--   * UserOwnsGamePassAsync   -> comprobación de propiedad (con reintentos y caché en memoria)
--   * GetProductInfo          -> nombre/precio reales del pase cuando exista
--   * PromptGamePassPurchase  -> lo lanza el SERVIDOR con el ID del módulo de configuración
--   * PromptGamePassPurchaseFinished -> confirmación de compra emitida por Roblox en el servidor
--
-- Reglas de seguridad:
--   * La propiedad NUNCA se lee de los datos guardados ni del cliente.
--   * Solo el estado "owned" concede ventajas. "error", "checking" o "pending_config" no.
--   * Si Roblox no responde, el juego sigue funcionando y se reintenta en segundo plano.
--   * No existe ninguna ruta de código que marque un pase como comprado sin confirmación de Roblox.

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local GameConfig = require(Shared.Config.GameConfig)
local GamePassConfig = require(Shared.Config.GamePassConfig)
local Remotes = require(Shared.Modules.Remotes)
local Retry = require(script.Parent.Parent.Util.Retry)

local GamePassService = {}

-- Estados posibles de un pase para un jugador:
GamePassService.Status = {
	PENDING_CONFIG = "pending_config", -- ID = 0: aún no creado en el Creator Dashboard
	INACTIVE = "inactive", -- pase de una fase futura
	CHECKING = "checking", -- consultando a Roblox
	OWNED = "owned", -- propiedad confirmada por Roblox
	NOT_OWNED = "not_owned", -- Roblox confirma que no lo tiene
	ERROR = "error", -- Roblox no respondió; se reintenta
}
local S = GamePassService.Status

local ownership = {} -- [player] = { [passKey] = status }
local priceCache = {} -- [passKey] = { time, ok, price, forSale, name }
local changedCallbacks = {}
local promptOpen = {} -- [player] = passKey

local shopRemote = Remotes.Get("Shop")
local notifyRemote = Remotes.Get("Notify")

local function fireChanged(player, passKey)
	for _, callback in ipairs(changedCallbacks) do
		task.spawn(callback, player, passKey)
	end
end

local function getPrice(passKey)
	local def = GamePassConfig.Get(passKey)
	if not def or not GamePassConfig.IsConfigured(passKey) then
		return nil
	end
	local cached = priceCache[passKey]
	if cached and os.clock() - cached.time < GameConfig.PRICE_CACHE_SECONDS then
		return cached
	end
	local ok, info = Retry.Call(2, 1, function()
		return MarketplaceService:GetProductInfo(def.id, Enum.InfoType.GamePass)
	end)
	local entry = { time = os.clock(), ok = ok }
	if ok and type(info) == "table" then
		entry.price = info.PriceInRobux
		entry.forSale = info.IsForSale == true and info.PriceInRobux ~= nil
		entry.name = info.Name
	else
		warn("[GamePassService] No se pudo obtener el precio de ", passKey, ": ", info)
		-- caché corta para reintentar pronto
		entry.time = os.clock() - GameConfig.PRICE_CACHE_SECONDS + 30
	end
	priceCache[passKey] = entry
	return entry
end

-- Construye el estado de la Tienda Premium para un jugador (solo datos públicos de su propia sesión).
function GamePassService.BuildShopState(player)
	local list = {}
	local states = ownership[player] or {}
	for _, passKey in ipairs(GamePassConfig.Order) do
		local def = GamePassConfig.Get(passKey)
		if def then
			local price = def.active and getPrice(passKey) or nil
			table.insert(list, {
				key = passKey,
				name = def.name,
				icon = def.icon,
				iconImage = def.iconImage,
				accent = def.accent,
				description = def.description,
				benefits = def.benefits,
				active = def.active,
				phase = def.phase,
				configured = GamePassConfig.IsConfigured(passKey),
				status = states[passKey] or (def.active and S.PENDING_CONFIG or S.INACTIVE),
				priceKnown = price ~= nil and price.ok == true,
				price = price and price.price or nil,
				forSale = price ~= nil and price.forSale == true,
			})
		end
	end
	return list
end

function GamePassService.PushShop(player)
	if player.Parent then
		shopRemote:FireClient(player, GamePassService.BuildShopState(player))
	end
end

local function setStatus(player, passKey, status)
	local states = ownership[player]
	if not states then
		return
	end
	local previous = states[passKey]
	states[passKey] = status
	if previous ~= status then
		GamePassService.PushShop(player)
		fireChanged(player, passKey)
	end
end

local function checkOwnership(player, passKey)
	local def = GamePassConfig.Get(passKey)
	if not def.active then
		setStatus(player, passKey, S.INACTIVE)
		return
	end
	if not GamePassConfig.IsConfigured(passKey) then
		setStatus(player, passKey, S.PENDING_CONFIG)
		return
	end
	-- Si ya está confirmado, no se vuelve a consultar.
	if ownership[player] and ownership[player][passKey] == S.OWNED then
		return
	end
	setStatus(player, passKey, S.CHECKING)
	local ok, owns = Retry.Call(GameConfig.OWNERSHIP_RETRY_ATTEMPTS, 1, function()
		return MarketplaceService:UserOwnsGamePassAsync(player.UserId, def.id)
	end)
	if not player.Parent or not ownership[player] then
		return
	end
	if ok then
		setStatus(player, passKey, owns and S.OWNED or S.NOT_OWNED)
	else
		warn("[GamePassService] Roblox no respondió al comprobar ", passKey, " de ", player.Name, ": ", owns)
		setStatus(player, passKey, S.ERROR)
		-- Reintento en segundo plano sin bloquear el juego.
		task.delay(GameConfig.OWNERSHIP_RECHECK_SECONDS, function()
			if player.Parent and ownership[player] and ownership[player][passKey] == S.ERROR then
				checkOwnership(player, passKey)
			end
		end)
	end
end

-- ===== API pública =====

-- La ÚNICA función que debe usarse para decidir si se concede una ventaja de pago.
function GamePassService.Owns(player, passKey)
	local states = ownership[player]
	return states ~= nil and states[passKey] == S.OWNED
end

function GamePassService.GetStatus(player, passKey)
	local states = ownership[player]
	return states and states[passKey] or S.PENDING_CONFIG
end

-- Lista de claves de pases confirmados (para el estado que se envía al cliente).
function GamePassService.OwnedList(player)
	local result = {}
	for passKey, status in pairs(ownership[player] or {}) do
		if status == S.OWNED then
			result[passKey] = true
		end
	end
	return result
end

function GamePassService.OnOwnershipChanged(callback)
	table.insert(changedCallbacks, callback)
end

function GamePassService.PlayerAdded(player)
	ownership[player] = {}
	for _, passKey in ipairs(GamePassConfig.Order) do
		task.spawn(checkOwnership, player, passKey)
	end
	task.spawn(GamePassService.PushShop, player)
end

function GamePassService.PlayerRemoving(player)
	ownership[player] = nil
	promptOpen[player] = nil
end

-- Solicitud de compra enviada por el cliente. Devuelve ok, mensaje.
function GamePassService.RequestPurchase(player, passKey)
	if type(passKey) ~= "string" then
		return false, "Solicitud no válida."
	end
	local def = GamePassConfig.Get(passKey)
	if not def then
		return false, "Ese pase no existe."
	end
	if not def.active then
		return false, string.format("%s llegará en una fase posterior.", def.name)
	end
	if not GamePassConfig.IsConfigured(passKey) then
		return false, string.format("%s está pendiente de configuración: todavía no tiene un ID de Game Pass.", def.name)
	end
	local status = GamePassService.GetStatus(player, passKey)
	if status == S.OWNED then
		return false, "Ya tienes este pase."
	end
	if status == S.CHECKING then
		return false, "Estamos comprobando tus pases con Roblox. Inténtalo en unos segundos."
	end
	local price = getPrice(passKey)
	if price and price.ok and not price.forSale then
		return false, "Este pase no está a la venta en este momento."
	end
	if promptOpen[player] then
		return false, "Ya tienes una ventana de compra abierta."
	end
	local ok, err = pcall(function()
		MarketplaceService:PromptGamePassPurchase(player, def.id)
	end)
	if not ok then
		warn("[GamePassService] PromptGamePassPurchase falló: ", err)
		return false, "Roblox no pudo abrir la ventana de compra. Inténtalo más tarde."
	end
	promptOpen[player] = passKey
	-- Salvaguarda por si Roblox nunca llega a emitir el evento de cierre.
	task.delay(120, function()
		if promptOpen[player] == passKey then
			promptOpen[player] = nil
		end
	end)
	return true, "Abriendo la compra de Roblox…"
end

function GamePassService.Start()
	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, gamePassId, wasPurchased)
		promptOpen[player] = nil
		local passKey = GamePassConfig.GetKeyById(gamePassId)
		if not passKey or not ownership[player] then
			return
		end
		local def = GamePassConfig.Get(passKey)
		if wasPurchased then
			-- Confirmación emitida por Roblox en el servidor: el cliente no puede falsificarla.
			setStatus(player, passKey, S.OWNED)
			notifyRemote:FireClient(player, "success", string.format("¡Compra confirmada! %s %s activado.", def.icon, def.name))
			for _, callback in ipairs(GamePassService._purchaseCallbacks) do
				task.spawn(callback, player, passKey)
			end
		else
			notifyRemote:FireClient(player, "info", "Compra cancelada. No se ha realizado ningún cargo.")
			-- Por si el jugador ya lo tenía, volvemos a comprobar.
			task.spawn(checkOwnership, player, passKey)
		end
	end)
end

GamePassService._purchaseCallbacks = {}
function GamePassService.OnPurchaseConfirmed(callback)
	table.insert(GamePassService._purchaseCallbacks, callback)
end

return GamePassService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000022"><Properties><string name="Name">HalloweenService</string><ProtectedString name="Source"><![CDATA[-- HalloweenService (ModuleScript)
-- Ubicación: ServerScriptService/Server/Services/HalloweenService
--
-- EVENTO «DOCES OU TRAVESSURAS» (truco o trato):
--   * Caramelos por el campo, la plaza y los carriles de cada estadio. Se recogen tocándolos
--     (también en estadios ajenos: ¡a visitar a los vecinos!).
--   * En las puertas de las instalaciones (tecla F): trato = caramelos, truco = efecto divertido.
--   * Canje de caramelos por dinero o cosméticos de Halloween (gratuitos, sin Game Pass).
-- Todo se valida en el servidor: el cliente nunca decide cuántos caramelos tiene.

local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local HalloweenConfig = require(Shared.Config.HalloweenConfig)
local Remotes = require(Shared.Modules.Remotes)
local Layout = require(Shared.Modules.StadiumLayout)

local DataService = require(script.Parent.DataService)
local EconomyService = require(script.Parent.EconomyService)
local StadiumService = require(script.Parent.StadiumService)

local HalloweenService = {}

local notifyRemote = Remotes.Get("Notify")
local rng = Random.new()
local doorCooldowns = {} -- [player] = { [clave de puerta] = os.clock() }
local plotFolders = {} -- [plot] = Folder

function HalloweenService.IsActive()
	return HalloweenConfig.IsActive()
end

-- ===== Caramelos =====

-- Punto aleatorio por donde se puede caminar: césped, plaza o huecos de los carriles.
local function randomSpot()
	local roll = rng:NextNumber()
	if roll < 0.4 then
		return Vector3.new(rng:NextInteger(-45, 45), 1.6, Layout.PITCH_CENTER_Z + rng:NextInteger(-28, 28))
	elseif roll < 0.8 then
		local x = rng:NextInteger(-90, 90)
		if math.abs(x) < 16 then
			x = 16 * (x < 0 and -1 or 1) + x -- deja libre el cartel
		end
		return Vector3.new(x, 1.6, rng:NextInteger(74, 100))
	end
	local gaps = { -40, 13, 63 }
	local side = rng:NextNumber() < 0.5 and -1 or 1
	return Vector3.new(side * rng:NextInteger(100, 140), 1.6, gaps[rng:NextInteger(1, #gaps)] + rng:NextInteger(-6, 6))
end

local spawnCandy -- declarada más abajo

local function collect(player, candy, plot)
	local data = DataService.Get(player)
	if not data or not candy.Parent then
		return
	end
	local value = candy:GetAttribute("Value") or HalloweenConfig.CANDY_VALUE
	candy:Destroy()
	data.halloween.candy += value
	data.halloween.total += value
	notifyRemote:FireClient(player, "candy", { candy = data.halloween.candy, gained = value })
	task.delay(HalloweenConfig.CANDY_RESPAWN_SECONDS, function()
		if plotFolders[plot] and plotFolders[plot].Parent then
			spawnCandy(plot)
		end
	end)
end

spawnCandy = function(plot)
	local folder = plotFolders[plot]
	if not folder then
		return
	end
	local golden = rng:NextNumber() < HalloweenConfig.GOLDEN_CHANCE
	local candy = Instance.new("Part")
	candy.Name = "Candy"
	candy.Shape = Enum.PartType.Ball
	candy.Size = golden and Vector3.new(2.2, 2.2, 2.2) or Vector3.new(1.6, 1.6, 1.6)
	candy.Anchored = true
	candy.CanCollide = false
	candy.Material = Enum.Material.Neon
	candy.Color = golden and Color3.fromRGB(255, 215, 60) or (rng:NextNumber() < 0.5 and Color3.fromRGB(255, 120, 20) or Color3.fromRGB(170, 70, 220))
	candy.CFrame = plot.origin * CFrame.new(randomSpot())
	candy:SetAttribute("Value", golden and HalloweenConfig.GOLDEN_VALUE or HalloweenConfig.CANDY_VALUE)
	local light = Instance.new("PointLight")
	light.Color = candy.Color
	light.Range = 6
	light.Brightness = 1.5
	light.Parent = candy
	local sparkle = Instance.new("Sparkles")
	sparkle.SparkleColor = candy.Color
	sparkle.Enabled = golden
	sparkle.Parent = candy
	candy.Touched:Connect(function(hit)
		local character = hit:FindFirstAncestorOfClass("Model")
		local player = character and Players:GetPlayerFromCharacter(character)
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if player and humanoid and humanoid.Health > 0 then
			collect(player, candy, plot)
		end
	end)
	candy.Parent = folder
end

-- Ambientación: calabazas en la puerta y en las esquinas de la plaza.
local function decoratePlot(plot, folder)
	local spots = { Vector3.new(-14, 0, 103), Vector3.new(14, 0, 103), Vector3.new(-95, 0, 75), Vector3.new(95, 0, 75) }
	for _, pos in ipairs(spots) do
		local pumpkin = Instance.new("Part")
		pumpkin.Shape = Enum.PartType.Ball
		pumpkin.Size = Vector3.new(4, 3.4, 4)
		pumpkin.Anchored = true
		pumpkin.Color = Color3.fromRGB(240, 120, 20)
		pumpkin.Material = Enum.Material.SmoothPlastic
		pumpkin.CFrame = plot.origin * CFrame.new(pos + Vector3.new(0, 1.7, 0))
		pumpkin.Parent = folder
		local glow = Instance.new("PointLight")
		glow.Color = Color3.fromRGB(255, 150, 50)
		glow.Range = 12
		glow.Brightness = 2
		glow.Parent = pumpkin
	end
end

function HalloweenService.SetupPlot(plot)
	if not HalloweenService.IsActive() or plotFolders[plot] then
		return
	end
	local folder = Instance.new("Folder")
	folder.Name = "Halloween"
	folder.Parent = plot.model
	plotFolders[plot] = folder
	decoratePlot(plot, folder)
	for _ = 1, HalloweenConfig.CANDIES_PER_PLOT do
		spawnCandy(plot)
	end
end

function HalloweenService.ClearPlot(plot)
	local folder = plotFolders[plot]
	if folder then
		folder:Destroy()
		plotFolders[plot] = nil
	end
end

-- ===== Puertas: ¿truco o trato? =====

local function applyTrick(player, trick)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid and trick.walkSpeed then
		local previous = humanoid.WalkSpeed
		humanoid.WalkSpeed = trick.walkSpeed
		task.delay(trick.seconds, function()
			if humanoid.Parent then
				humanoid.WalkSpeed = previous
			end
		end)
	elseif humanoid and trick.jumpPower then
		local usedPower, power, height = humanoid.UseJumpPower, humanoid.JumpPower, humanoid.JumpHeight
		humanoid.UseJumpPower = true
		humanoid.JumpPower = trick.jumpPower
		task.delay(trick.seconds, function()
			if humanoid.Parent then
				humanoid.UseJumpPower = usedPower
				humanoid.JumpPower = power
				humanoid.JumpHeight = height
			end
		end)
	end
	notifyRemote:FireClient(player, "trick", { id = trick.id, seconds = trick.seconds or 2, text = trick.text })
end

local function knock(player, plot, facilityId)
	local data = DataService.Get(player)
	if not data or not HalloweenService.IsActive() then
		return
	end
	local key = tostring(plot.index) .. ":" .. facilityId
	doorCooldowns[player] = doorCooldowns[player] or {}
	local last = doorCooldowns[player][key]
	if last and os.clock() - last < HalloweenConfig.DOOR_COOLDOWN then
		notifyRemote:FireClient(player, "info", string.format("🚪 Ya llamaste a esta puerta. Vuelve en %d s.",
			math.ceil(HalloweenConfig.DOOR_COOLDOWN - (os.clock() - last))))
		return
	end
	doorCooldowns[player][key] = os.clock()
	if rng:NextNumber() < HalloweenConfig.TREAT_CHANCE then
		local amount = rng:NextInteger(HalloweenConfig.TREAT_MIN, HalloweenConfig.TREAT_MAX)
		data.halloween.candy += amount
		data.halloween.total += amount
		notifyRemote:FireClient(player, "candy", { candy = data.halloween.candy, gained = amount, treat = true })
	else
		applyTrick(player, HalloweenConfig.Tricks[rng:NextInteger(1, #HalloweenConfig.Tricks)])
	end
end

function HalloweenService.AttachDoor(part, plot, _, facilityId)
	if not HalloweenService.IsActive() or not HalloweenConfig.DOOR_FACILITIES[facilityId] then
		return
	end
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "TrickOrTreat"
	prompt.ActionText = "🎃 ¿Truco o trato?"
	prompt.ObjectText = HalloweenConfig.NAME
	prompt.KeyboardKeyCode = Enum.KeyCode.F
	prompt.UIOffset = Vector2.new(0, 70)
	prompt.HoldDuration = 0.3
	prompt.MaxActivationDistance = 16
	prompt.RequiresLineOfSight = false
	prompt.Parent = part
	prompt.Triggered:Connect(function(player)
		knock(player, plot, facilityId)
	end)
end

-- ===== Canje =====

function HalloweenService.Exchange(player, payload)
	local data = DataService.Get(player)
	local reward = HalloweenConfig.Reward(type(payload) == "table" and payload.reward)
	if not reward then
		return false, "Premio no válido."
	end
	if reward.unlock and data.unlocks[reward.unlock] then
		return false, "Ya tienes este premio."
	end
	if data.halloween.candy < reward.cost then
		return false, string.format("Necesitas %d caramelos (tienes %d).", reward.cost, data.halloween.candy)
	end
	data.halloween.candy -= reward.cost
	if reward.money then
		EconomyService.Earn(player, reward.money, EconomyService.Category.PRIZE, HalloweenConfig.NAME .. ": " .. reward.name)
	end
	if reward.unlock then
		data.unlocks[reward.unlock] = true
	end
	StadiumService.LogEvent(data, "halloween_reward", { name = reward.name })
	return true, string.format("%s ¡%s conseguido! (−%d 🍬)", reward.icon, reward.name, reward.cost)
end

function HalloweenService.BuildState(data)
	local rewards = {}
	for _, reward in ipairs(HalloweenConfig.Rewards) do
		table.insert(rewards, {
			id = reward.id, name = reward.name, icon = reward.icon, cost = reward.cost, money = reward.money,
			owned = reward.unlock ~= nil and data.unlocks[reward.unlock] == true,
		})
	end
	return {
		active = HalloweenService.IsActive(),
		name = HalloweenConfig.NAME,
		candy = data.halloween.candy,
		total = data.halloween.total,
		rewards = rewards,
	}
end

function HalloweenService.PlayerRemoving(player)
	doorCooldowns[player] = nil
end

function HalloweenService.Start()
	if HalloweenService.IsActive() then
		-- Atardecer de Halloween para que luzcan las calabazas y los focos
		Lighting.ClockTime = 18.6
		Lighting.Ambient = Color3.fromRGB(70, 50, 90)
		Lighting.OutdoorAmbient = Color3.fromRGB(90, 70, 110)
	end
end

return HalloweenService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000023"><Properties><string name="Name">HistoryService</string><ProtectedString name="Source"><![CDATA[-- HistoryService (ModuleScript)
-- Ubicación: ServerScriptService/Server/Services/HistoryService
--
-- HISTORIA DEL CLUB (FASE 8). Todo sale de acontecimientos reales ya registrados:
--   temporadas (LeagueService), títulos (trophies), ascensos/descensos y resultados
--   importantes (history), récords (records), estadísticas de todos los tiempos
--   (allTimeStats, MatchService), leyendas (SquadService), fichajes destacados
--   (TransferService) y evolución de la reputación (aquí).

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local GameConfig = require(Shared.Config.GameConfig)
local FootballConfig = require(Shared.Config.FootballConfig)
local EconomyFormulas = require(Shared.Modules.EconomyFormulas)

local DataService = require(script.Parent.DataService)

local HistoryService = {}

local SNAPSHOT_EVERY = 5 -- jornadas entre puntos de la gráfica de reputación

-- Texto legible de cada tipo de evento de la cronología
local function describe(e)
	local k = e.kind
	if k == "stadium_stage" then
		return "🏟️", string.format("El estadio asciende a %s (etapa %s)", tostring(e.name), tostring(e.stage))
	elseif k == "trophy" then
		return "🏆", string.format("¡Título! %s (temporada %s)", tostring(e.name), tostring(e.season))
	elseif k == "promotion" then
		return "⬆️", string.format("Ascenso de %s a %s", tostring(e.from), tostring(e.to))
	elseif k == "relegation" then
		return "⬇️", string.format("Descenso de %s a %s", tostring(e.from), tostring(e.to))
	elseif k == "big_result" then
		return "⚽", string.format("Resultado histórico: %s-%s contra %s (%s)", tostring(e.gf), tostring(e.ga), tostring(e.opponent), tostring(e.competition))
	elseif k == "transfer_in" then
		return "✍️", string.format("Fichaje de %s (media %s) por %s %s", tostring(e.name), tostring(e.ovr), tostring(e.fee), GameConfig.CURRENCY)
	elseif k == "transfer_out" then
		return "💰", string.format("Venta de %s a %s por %s %s", tostring(e.name), tostring(e.club), tostring(e.fee), GameConfig.CURRENCY)
	elseif k == "loan_in" then
		return "🔁", string.format("%s llega cedido de %s", tostring(e.name), tostring(e.club))
	elseif k == "loan_out" then
		return "🔁", string.format("%s se va cedido a %s", tostring(e.name), tostring(e.club))
	elseif k == "youth_promoted" then
		return "🧬", string.format("%s debuta desde la cantera con %s años", tostring(e.name), tostring(e.age))
	elseif k == "player_retired" then
		return "👋", string.format("Se retira %s (media máxima %s)%s", tostring(e.name), tostring(e.peak), e.legend and " · leyenda del club" or "")
	elseif k == "player_left" then
		return "🚪", string.format("%s se va al terminar su contrato", tostring(e.name))
	elseif k == "player_released" then
		return "🚪", string.format("Rescisión del contrato de %s", tostring(e.name))
	elseif k == "sponsor_signed" then
		return "🤝", string.format("Contrato de patrocinio con %s", tostring(e.brand))
	elseif k == "sponsor_expired" or k == "sponsor_terminated" then
		return "🤝", string.format("Termina el patrocinio de %s", tostring(e.brand))
	elseif k == "season_end" then
		return "📅", string.format("Fin de la temporada %s", tostring(e.season))
	elseif k == "halloween_reward" then
		return "🎃", string.format("Premio del evento de Halloween: %s", tostring(e.name))
	elseif k == "weekly_reward" then
		return "🌎", string.format("Puesto %s en la competición semanal del universo", tostring(e.rank))
	end
	return "•", k
end

function HistoryService.AfterCycle(player)
	local data = DataService.Get(player)
	if not data then
		return
	end
	local reputation = EconomyFormulas.Reputation(data)
	if data.records.highestReputation == nil or reputation > data.records.highestReputation.value then
		data.records.highestReputation = { value = reputation, season = data.season.number }
	end
	if data.stats.cycles % SNAPSHOT_EVERY == 0 then
		table.insert(data.reputationHistory, { season = data.season.number, cycle = data.season.cycle, value = reputation })
		while #data.reputationHistory > 60 do
			table.remove(data.reputationHistory, 1)
		end
	end
end

local function topBy(stats, field, n)
	local list = {}
	for _, s in pairs(stats) do
		if s[field] > 0 then
			table.insert(list, s)
		end
	end
	table.sort(list, function(a, b)
		if a[field] ~= b[field] then
			return a[field] > b[field]
		end
		return a.name < b.name
	end)
	local out = {}
	for i = 1, math.min(n, #list) do
		local s = list[i]
		table.insert(out, { name = s.name, pos = FootballConfig.Position(s.pos).short, value = s[field], origin = s.origin })
	end
	return out
end

function HistoryService.BuildState(data)
	local timeline = {}
	for i = #data.history, math.max(1, #data.history - 59), -1 do
		local e = data.history[i]
		if e.kind ~= "season_end" or i == #data.history then
			local icon, text = describe(e)
			table.insert(timeline, { t = e.t, icon = icon, text = text, kind = e.kind })
		end
	end
	local league = data.league or {}
	local s = data.stats
	return {
		founded = data.club.founded,
		seasons = league.history or {},
		trophies = data.trophies,
		records = data.records,
		topScorers = topBy(data.allTimeStats, "goals", 10),
		topAssists = topBy(data.allTimeStats, "assists", 10),
		topApps = topBy(data.allTimeStats, "apps", 10),
		legends = data.legends,
		reputationHistory = data.reputationHistory,
		reputationNow = EconomyFormulas.Reputation(data),
		timeline = timeline,
		totals = {
			matches = s.matchesPlayed or 0, wins = s.wins or 0, draws = s.draws or 0, losses = s.losses or 0,
			goalsFor = s.goalsFor or 0, goalsAgainst = s.goalsAgainst or 0,
			graduates = s.academyGraduates or 0, buildings = s.buildings or 0,
		},
	}
end

return HistoryService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000024"><Properties><string name="Name">InteractionService</string><ProtectedString name="Source"><![CDATA[-- InteractionService (ModuleScript)
-- Ubicación: ServerScriptService/Server/Services/InteractionService
--
-- ESTADIO INTERACTIVO: el estadio se juega caminando, como cualquier juego de Roblox.
--   * Cada instalación tiene una indicación (ProximityPrompt, tecla E): el dueño abre
--     su menú directamente; un visitante ve de quién es el estadio (sin datos privados).
--   * Un balón físico en cada campo: se chuta al tocarlo y los goles se celebran.
-- Otros servicios (p. ej. el evento de Halloween) pueden añadir más indicaciones con OnFacility.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Remotes = require(Shared.Modules.Remotes)
local Layout = require(Shared.Modules.StadiumLayout)

local InteractionService = {}

local notifyRemote = Remotes.Get("Notify")

-- Qué abre cada instalación: { texto, pantalla, parámetros }
local ACTIONS = {
	lockers = { "Vestuario: ver la plantilla", "squad" },
	training = { "Entrenamiento: plantilla", "squad" },
	academy = { "Academia: ver la cantera", "academy" },
	trophyRoom = { "Sala de trofeos: historia", "history" },
	shop = { "Tienda: gestión comercial", "economy", { tab = "commercial" } },
	restaurant = { "Restaurante: gestión comercial", "economy", { tab = "commercial" } },
	kiosks = { "Quioscos: gestión comercial", "economy", { tab = "commercial" } },
	tour = { "Tour del estadio", "economy", { tab = "commercial" } },
	vip = { "Zona VIP: patrocinadores", "economy", { tab = "sponsors" } },
	sign = { "Mi club", "club" },
}

local facilityHooks = {}
local balls = {} -- [plot] = { ball, origin, lastKicker, cooldown }

function InteractionService.OnFacility(fn)
	table.insert(facilityHooks, fn)
end

-- Añade las indicaciones a las instalaciones recién construidas de un terreno.
function InteractionService.Attach(plot, owner, clubName)
	for _, part in ipairs(plot.stadium:GetDescendants()) do
		local facilityId = part:IsA("BasePart") and part:GetAttribute("Facility")
		local action = facilityId and ACTIONS[facilityId]
		if action then
			local prompt = Instance.new("ProximityPrompt")
			prompt.Name = "OpenPrompt"
			prompt.ActionText = action[1]
			prompt.ObjectText = clubName
			prompt.KeyboardKeyCode = Enum.KeyCode.E
			prompt.HoldDuration = 0
			prompt.MaxActivationDistance = 16
			prompt.RequiresLineOfSight = false
			prompt.Parent = part
			prompt.Triggered:Connect(function(player)
				if player == owner then
					notifyRemote:FireClient(player, "open", { screen = action[2], params = action[3] })
				else
					notifyRemote:FireClient(player, "info", string.format("🏟️ Estás visitando el estadio de %s (%s). Solo su dueño puede gestionarlo.",
						clubName, owner.DisplayName))
				end
			end)
			for _, hook in ipairs(facilityHooks) do
				hook(part, plot, owner, facilityId, clubName)
			end
		end
	end
end

-- ===== Balón =====

local KICK_SPEED = 55
local KICK_LIFT = 16
local BALL_SIZE = 2.6

local function centerCFrame(origin)
	return origin * CFrame.new(0, 3, Layout.PITCH_CENTER_Z)
end

local function resetBall(entry)
	entry.ball.AssemblyLinearVelocity = Vector3.zero
	entry.ball.AssemblyAngularVelocity = Vector3.zero
	entry.ball.CFrame = centerCFrame(entry.origin)
end

function InteractionService.EnsureBall(plot, owner)
	if balls[plot] and balls[plot].ball.Parent then
		balls[plot].owner = owner
		return
	end
	local ball = Instance.new("Part")
	ball.Name = "Ball"
	ball.Shape = Enum.PartType.Ball
	ball.Size = Vector3.new(BALL_SIZE, BALL_SIZE, BALL_SIZE)
	ball.Color = Color3.fromRGB(250, 250, 250)
	ball.Material = Enum.Material.SmoothPlastic
	ball.CustomPhysicalProperties = PhysicalProperties.new(0.25, 0.4, 0.5, 1, 1)
	ball.CFrame = centerCFrame(plot.origin)
	ball.Parent = plot.model
	ball:SetNetworkOwner(nil) -- el servidor controla el balón (goles fiables)
	local entry = { ball = ball, origin = plot.origin, owner = owner, kickCooldown = {}, celebrating = false }
	balls[plot] = entry
	ball.Touched:Connect(function(hit)
		local character = hit:FindFirstAncestorOfClass("Model")
		local player = character and Players:GetPlayerFromCharacter(character)
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if not player or not root or entry.celebrating then
			return
		end
		local now = os.clock()
		if entry.kickCooldown[player] and now - entry.kickCooldown[player] < 0.25 then
			return
		end
		entry.kickCooldown[player] = now
		entry.lastKicker = player
		local direction = (ball.Position - root.Position) * Vector3.new(1, 0, 1)
		if direction.Magnitude < 0.1 then
			direction = root.CFrame.LookVector
		end
		ball.AssemblyLinearVelocity = direction.Unit * KICK_SPEED + Vector3.new(0, KICK_LIFT, 0)
	end)
end

function InteractionService.RemoveBall(plot)
	local entry = balls[plot]
	if entry then
		entry.ball:Destroy()
		balls[plot] = nil
	end
end

local function celebrate(entry, side)
	entry.celebrating = true
	local kicker = entry.lastKicker
	local goalPos = entry.origin * CFrame.new(side * Layout.PITCH_LENGTH / 2, 4, Layout.PITCH_CENTER_Z)
	local burst = Instance.new("Part")
	burst.Anchored = true
	burst.CanCollide = false
	burst.Transparency = 1
	burst.CFrame = goalPos
	burst.Parent = entry.ball.Parent
	local confetti = Instance.new("ParticleEmitter")
	confetti.Color = ColorSequence.new(Color3.fromRGB(255, 200, 40), Color3.fromRGB(40, 200, 120))
	confetti.Size = NumberSequence.new(0.5)
	confetti.Speed = NumberRange.new(15, 25)
	confetti.SpreadAngle = Vector2.new(60, 60)
	confetti.Lifetime = NumberRange.new(2, 3)
	confetti.Acceleration = Vector3.new(0, -20, 0)
	confetti.Rate = 0
	confetti.Parent = burst
	confetti:Emit(120)
	local text = string.format("⚽ ¡GOOOL%s en el estadio de %s!", kicker and (" de " .. kicker.DisplayName) or "",
		entry.owner and entry.owner.DisplayName or "?")
	local notified = {}
	for _, p in ipairs({ kicker or false, entry.owner or false }) do
		if p and p.Parent and not notified[p] then
			notified[p] = true
			notifyRemote:FireClient(p, "success", text)
		end
	end
	task.delay(3, function()
		burst:Destroy()
		if entry.ball.Parent then
			resetBall(entry)
		end
		entry.celebrating = false
	end)
end

function InteractionService.Start()
	RunService.Heartbeat:Connect(function()
		for _, entry in pairs(balls) do
			local ball = entry.ball
			if ball.Parent and not entry.celebrating then
				local p = entry.origin:PointToObjectSpace(ball.Position)
				local dz = math.abs(p.Z - Layout.PITCH_CENTER_Z)
				if math.abs(p.X) > Layout.PITCH_LENGTH / 2 + 0.5 and dz < 6 and p.Y < 6.5 then
					celebrate(entry, p.X > 0 and 1 or -1)
				elseif math.abs(p.X) > Layout.PITCH_LENGTH / 2 + 10 or dz > Layout.PITCH_WIDTH / 2 + 6 or p.Y < -10 or p.Y > 120 then
					resetBall(entry) -- fuera del campo: vuelve al centro
				end
			end
		end
	end)
end

return InteractionService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000025"><Properties><string name="Name">LeagueService</string><ProtectedString name="Source"><![CDATA[-- LeagueService (ModuleScript)
-- Ubicación: ServerScriptService/Server/Services/LeagueService
--
-- FASE 7: LIGAS (10 equipos, ida y vuelta), COPA (eliminatorias), CALENDARIO,
-- CLASIFICACIÓN, ASCENSOS/DESCENSOS y MODO CARRERA (objetivos de la junta directiva,
-- historial de temporadas y palmarés). Todo se simula en el servidor con MatchEngine.
-- Los partidos del usuario se juegan automáticamente en cada jornada con su alineación
-- y su táctica (MatchService.Play), y se presentan como partidos SIMULADOS.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local GameConfig = require(Shared.Config.GameConfig)
local LeagueConfig = require(Shared.Config.LeagueConfig)
local TacticsConfig = require(Shared.Config.TacticsConfig)
local MatchEngine = require(Shared.Modules.MatchEngine)

local DataService = require(script.Parent.DataService)
local EconomyService = require(script.Parent.EconomyService)
local StadiumService = require(script.Parent.StadiumService)
local MatchService = require(script.Parent.MatchService)

local LeagueService = {}

local rng = Random.new()
local USER = "user"

-- ===== Equipos y calendario =====

local function newTeamId(league)
	league.nextTeamId = (league.nextTeamId or 0) + 1
	return "t" .. league.nextTeamId
end

local function makeAITeam(league, strength)
	local name, short = MatchService.RandomClubName()
	return {
		id = newTeamId(league),
		name = name,
		short = short,
		strength = math.clamp(math.floor(strength + 0.5), 30, 95),
		formation = TacticsConfig.Formations[rng:NextInteger(1, #TacticsConfig.Formations)].id,
		mentality = TacticsConfig.Mentalities[rng:NextInteger(1, #TacticsConfig.Mentalities)].id,
		style = TacticsConfig.Styles[rng:NextInteger(1, #TacticsConfig.Styles)].id,
		seed = rng:NextInteger(1, 2 ^ 30),
	}
end

local function randomStrength(division)
	return rng:NextInteger(division.strength[1], division.strength[2])
end

-- Liga de ida y vuelta por el método del círculo.
local function roundRobin(ids)
	local list = table.clone(ids)
	if #list % 2 == 1 then
		table.insert(list, "bye")
	end
	local n = #list
	local rounds = {}
	for r = 1, n - 1 do
		local pairs_ = {}
		for i = 1, n / 2 do
			local a, b = list[i], list[n - i + 1]
			if a ~= "bye" and b ~= "bye" then
				if (r + i) % 2 == 0 then
					table.insert(pairs_, { h = a, a = b })
				else
					table.insert(pairs_, { h = b, a = a })
				end
			end
		end
		table.insert(rounds, pairs_)
		-- rotar todos menos el primero
		table.insert(list, 2, table.remove(list, n))
	end
	local second = {}
	for _, round in ipairs(rounds) do
		local mirrored = {}
		for _, p in ipairs(round) do
			table.insert(mirrored, { h = p.a, a = p.h })
		end
		table.insert(second, mirrored)
	end
	for _, round in ipairs(second) do
		table.insert(rounds, round)
	end
	return rounds
end

local function teamMap(league)
	local map = {}
	for _, t in ipairs(league.teams) do
		map[t.id] = t
	end
	return map
end

-- ===== Copa =====

local function newCup(data, league)
	local strength = MatchService.TeamStrength(data)
	local teams = { USER }
	league.cupTeams = {}
	for _ = 1, LeagueConfig.CUP_TEAMS - 1 do
		local t = makeAITeam(league, strength + rng:NextInteger(-10, 8))
		table.insert(league.cupTeams, t)
		table.insert(teams, t.id)
	end
	-- sorteo
	for i = #teams, 2, -1 do
		local j = rng:NextInteger(1, i)
		teams[i], teams[j] = teams[j], teams[i]
	end
	league.cup = { participants = teams, rounds = {}, alive = true, champion = nil }
end

-- ===== Objetivo de la junta =====

local function boardObjective(data, league)
	local division = LeagueConfig.Division(league.division)
	local userStrength = MatchService.TeamStrength(data)
	local rank = 1
	for _, t in ipairs(league.teams) do
		if t.strength > userStrength then
			rank += 1
		end
	end
	local objective
	if division.promote == 0 and rank <= 2 then
		objective = { type = "title", target = 1, text = "Ganar la liga" }
	elseif division.promote > 0 and rank <= division.promote + 1 then
		objective = { type = "position", target = division.promote, text = string.format("Ascender (quedar entre los %d primeros)", division.promote) }
	elseif rank <= 6 then
		objective = { type = "position", target = 5, text = "Quedar entre los 5 primeros" }
	else
		local safe = LeagueConfig.TEAMS - math.max(2, division.relegate)
		objective = { type = "position", target = safe, text = division.relegate > 0 and "Evitar el descenso" or string.format("Quedar entre los %d primeros", safe) }
	end
	objective.expectedRank = rank
	return objective
end

-- Crea (o renueva) la liga de una temporada.
function LeagueService.NewLeague(data, seasonNumber, level, keepTeams)
	local old = data.league or {}
	local league = {
		season = seasonNumber,
		division = level,
		teams = {},
		fixtures = {},
		results = {},
		nextTeamId = old.nextTeamId or 0,
		boardConfidence = old.boardConfidence or LeagueConfig.BOARD_START,
		history = old.history or {},
	}
	local division = LeagueConfig.Division(level)
	for _, t in ipairs(keepTeams or {}) do
		t.strength = math.clamp(t.strength + rng:NextInteger(-LeagueConfig.AI_DRIFT, LeagueConfig.AI_DRIFT), 30, 95)
		table.insert(league.teams, t)
	end
	while #league.teams < LeagueConfig.TEAMS - 1 do
		table.insert(league.teams, makeAITeam(league, randomStrength(division)))
	end
	local ids = { USER }
	for _, t in ipairs(league.teams) do
		table.insert(ids, t.id)
	end
	league.fixtures = roundRobin(ids)
	data.league = league
	newCup(data, league)
	league.objective = boardObjective(data, league)
	return league
end

-- ===== Clasificación =====

function LeagueService.Standings(data)
	local league = data.league
	local rows, byId = {}, {}
	local function row(id, name, short)
		local r = { id = id, name = name, short = short, p = 0, w = 0, d = 0, l = 0, gf = 0, ga = 0, pts = 0, form = {} }
		byId[id] = r
		table.insert(rows, r)
	end
	row(USER, data.__clubName or "Tu club", data.__clubShort or "TÚ")
	for _, t in ipairs(league.teams) do
		row(t.id, t.name, t.short)
	end
	for round = 1, LeagueConfig.LEAGUE_ROUNDS do
		for _, m in ipairs(league.results[tostring(round)] or {}) do
			local h, a = byId[m.h], byId[m.a]
			if h and a then
				h.p += 1
				a.p += 1
				h.gf += m.hg
				h.ga += m.ag
				a.gf += m.ag
				a.ga += m.hg
				if m.hg > m.ag then
					h.w += 1
					a.l += 1
					h.pts += LeagueConfig.POINTS_WIN
					table.insert(h.form, "V")
					table.insert(a.form, "D")
				elseif m.hg < m.ag then
					a.w += 1
					h.l += 1
					a.pts += LeagueConfig.POINTS_WIN
					table.insert(h.form, "D")
					table.insert(a.form, "V")
				else
					h.d += 1
					a.d += 1
					h.pts += LeagueConfig.POINTS_DRAW
					a.pts += LeagueConfig.POINTS_DRAW
					table.insert(h.form, "E")
					table.insert(a.form, "E")
				end
			end
		end
	end
	table.sort(rows, function(x, y)
		if x.pts ~= y.pts then
			return x.pts > y.pts
		end
		local dx, dy = x.gf - x.ga, y.gf - y.ga
		if dx ~= dy then
			return dx > dy
		end
		if x.gf ~= y.gf then
			return x.gf > y.gf
		end
		return x.name < y.name
	end)
	for i, r in ipairs(rows) do
		r.position = i
		while #r.form > 5 do
			table.remove(r.form, 1)
		end
	end
	return rows
end

-- ===== Jugar =====

local function aiVsAi(home, away)
	local result = MatchEngine.Simulate(MatchService.BuildAISheet(home), MatchService.BuildAISheet(away), rng, { crowd = 0.5 })
	return result.home.goals, result.away.goals
end

local function countAvailable(data)
	local n = 0
	for _, p in ipairs(data.squad) do
		if (p.injury or 0) <= 0 and not (p.loan and p.loan.type == "out") then
			n += 1
		end
	end
	return n
end

-- Partido del usuario (o incomparecencia si no tiene 11 jugadores disponibles).
local function playUserMatch(player, data, opponent, home, competition, prizeScale)
	if countAvailable(data) < 11 then
		return nil, home and 0 or 3, home and 3 or 0, "⚠️ Sin 11 jugadores disponibles: partido perdido 0-3 por incomparecencia."
	end
	local result = MatchService.Play(player, opponent, {
		clubName = data.__clubName, clubShort = data.__clubShort, home = home,
		competition = competition, prizeScale = prizeScale,
	})
	return result, result.home.goals, result.away.goals, nil
end

local function playLeagueRound(player, data, round, out)
	local league = data.league
	local map = teamMap(league)
	local division = LeagueConfig.Division(league.division)
	local results = {}
	for _, pair in ipairs(league.fixtures[round] or {}) do
		local hg, ag
		if pair.h == USER or pair.a == USER then
			local home = pair.h == USER
			local opponent = map[home and pair.a or pair.h]
			local result, g1, g2, warning = playUserMatch(player, data, opponent, home, "Liga", division.prize * LeagueConfig.MATCH_PRIZE_SCALE)
			hg, ag = g1, g2
			if warning then
				table.insert(out.messages, warning)
			end
			if result then
				out.result = result
				out.points = (out.points or 0) + (result.outcome == "W" and 3 or (result.outcome == "D" and 1 or 0))
				local us = home and hg or ag
				local them = home and ag or hg
				table.insert(out.messages, string.format("⚽ Liga, jornada %d: %s %d - %d %s", round,
					home and data.__clubShort or opponent.short, hg, ag, home and opponent.short or data.__clubShort)
					.. (us > them and " · ¡Victoria!" or (us == them and " · Empate" or " · Derrota")))
			end
		else
			hg, ag = aiVsAi(map[pair.h], map[pair.a])
		end
		table.insert(results, { h = pair.h, a = pair.a, hg = hg, ag = ag })
	end
	league.results[tostring(round)] = results
end

local function strengthOf(data, league, id)
	if id == USER then
		return MatchService.TeamStrength(data)
	end
	for _, t in ipairs(league.cupTeams) do
		if t.id == id then
			return t.strength
		end
	end
	return 50
end

local function cupTeam(league, id)
	for _, t in ipairs(league.cupTeams) do
		if t.id == id then
			return t
		end
	end
	return nil
end

local function playCupRound(player, data, roundIndex, out)
	local league = data.league
	local cup = league.cup
	local entrants = roundIndex == 1 and cup.participants or (cup.rounds[roundIndex - 1] and cup.rounds[roundIndex - 1].winners) or {}
	local division = LeagueConfig.Division(league.division)
	local matches, winners = {}, {}
	for i = 1, #entrants, 2 do
		local a, b = entrants[i], entrants[i + 1]
		if not b then
			table.insert(winners, a)
			break
		end
		local hg, ag, winner, penalties
		if a == USER or b == USER then
			local home = a == USER
			local opponent = cupTeam(league, home and b or a)
			local result, g1, g2, warning = playUserMatch(player, data, opponent, home, "Copa", division.prize)
			hg, ag = g1, g2
			if warning then
				table.insert(out.messages, warning)
			end
			if result then
				out.result = result
			end
		else
			local sa, sb = strengthOf(data, league, a), strengthOf(data, league, b)
			local pa = 1 / (1 + math.exp(-(sa - sb) / 6))
			hg = rng:NextNumber() < pa and rng:NextInteger(1, 3) or rng:NextInteger(0, 1)
			ag = hg > 0 and rng:NextInteger(0, hg) or rng:NextInteger(0, 1)
		end
		if hg > ag then
			winner = a
		elseif ag > hg then
			winner = b
		else
			-- Penaltis: favorece ligeramente al mejor equipo
			local sa, sb = strengthOf(data, league, a), strengthOf(data, league, b)
			winner = rng:NextNumber() < math.clamp(0.5 + (sa - sb) / 100, 0.2, 0.8) and a or b
			penalties = true
		end
		table.insert(matches, { h = a, a = b, hg = hg, ag = ag, winner = winner, penalties = penalties })
		table.insert(winners, winner)
		if a == USER or b == USER then
			local name = LeagueConfig.CUP_ROUND_NAMES[roundIndex]
			if winner == USER then
				out.points = (out.points or 0) + 2
				local prize = LeagueConfig.CUP_ROUND_PRIZE[roundIndex] * division.prize
				EconomyService.Earn(player, prize, EconomyService.Category.PRIZE, LeagueConfig.CUP_NAME .. ": " .. name)
				table.insert(out.messages, string.format("🏆 %s · %s: ¡pasas de ronda%s! Premio %d %s.", LeagueConfig.CUP_NAME, name,
					penalties and " en los penaltis" or "", prize, GameConfig.CURRENCY))
			else
				cup.alive = false
				cup.eliminatedIn = name
				table.insert(out.messages, string.format("❌ %s · %s: eliminado%s.", LeagueConfig.CUP_NAME, name, penalties and " en los penaltis" or ""))
			end
		end
	end
	cup.rounds[roundIndex] = { matches = matches, winners = winners }
	if roundIndex == #LeagueConfig.CUP_CYCLES then
		cup.champion = winners[1]
		if cup.champion == USER then
			out.points = (out.points or 0) + 10
			local rep = LeagueConfig.REP_CUP_BASE + LeagueConfig.REP_CUP_PER_LEVEL * league.division
			data.club.reputationEarned += rep
			table.insert(data.trophies, { kind = "cup", name = LeagueConfig.CUP_NAME, season = data.season.number })
			StadiumService.LogEvent(data, "trophy", { kind = "cup", name = LeagueConfig.CUP_NAME, season = data.season.number })
			table.insert(out.messages, string.format("🏆🏆 ¡CAMPEONES DE LA %s! Reputación +%d.", string.upper(LeagueConfig.CUP_NAME), rep))
		end
	end
end

-- ===== Cierre de temporada =====

local function finalize(player, data, out)
	local league = data.league
	local division = LeagueConfig.Division(league.division)
	local standings = LeagueService.Standings(data)
	local position = 1
	for _, r in ipairs(standings) do
		if r.id == USER then
			position = r.position
		end
	end
	local teams = LeagueConfig.TEAMS
	local promoted = division.promote > 0 and position <= division.promote
	local relegated = division.relegate > 0 and position > teams - division.relegate
	local champion = position == 1

	-- Premios
	local positionPrize = math.floor(LeagueConfig.POSITION_PRIZE * division.prize * (teams + 1 - position) / teams)
	EconomyService.Earn(player, positionPrize, EconomyService.Category.PRIZE, string.format("%s: %dº puesto", division.name, position))
	if champion then
		out.points = (out.points or 0) + 10
		EconomyService.Earn(player, LeagueConfig.TITLE_BONUS * division.prize, EconomyService.Category.PRIZE, "Título de " .. division.name)
		local rep = LeagueConfig.REP_TITLE_BASE + LeagueConfig.REP_TITLE_PER_LEVEL * league.division
		data.club.reputationEarned += rep
		table.insert(data.trophies, { kind = "league", name = division.name, season = league.season })
		StadiumService.LogEvent(data, "trophy", { kind = "league", name = division.name, season = league.season })
		table.insert(out.messages, string.format("🏆 ¡CAMPEONES DE %s! Reputación +%d.", string.upper(division.name), rep))
	end
	if promoted then
		EconomyService.Earn(player, LeagueConfig.PROMOTION_BONUS * division.prize, EconomyService.Category.PRIZE, "Ascenso")
		data.club.reputationEarned += LeagueConfig.REP_PROMOTION
		StadiumService.LogEvent(data, "promotion", { from = division.name, to = LeagueConfig.Division(league.division + 1).name, season = league.season })
		table.insert(out.messages, string.format("⬆️ ¡ASCENSO a %s!", LeagueConfig.Division(league.division + 1).name))
	elseif relegated then
		data.club.reputationEarned = math.max(0, data.club.reputationEarned + LeagueConfig.REP_RELEGATION)
		StadiumService.LogEvent(data, "relegation", { from = division.name, to = LeagueConfig.Division(league.division - 1).name, season = league.season })
		table.insert(out.messages, string.format("⬇️ Descenso a %s.", LeagueConfig.Division(league.division - 1).name))
	end

	-- Objetivo de la junta
	local objective = league.objective
	local met = objective and position <= objective.target
	if met then
		EconomyService.Earn(player, LeagueConfig.OBJECTIVE_BONUS * division.prize, EconomyService.Category.PRIZE, "Objetivo de la junta cumplido")
		league.boardConfidence = math.clamp(league.boardConfidence + LeagueConfig.BOARD_MET, 0, 100)
		table.insert(out.messages, "✅ Objetivo de la junta cumplido: " .. objective.text)
	elseif objective then
		league.boardConfidence = math.clamp(league.boardConfidence + LeagueConfig.BOARD_FAILED, 0, 100)
		table.insert(out.messages, "❌ Objetivo de la junta no cumplido: " .. objective.text)
	end

	-- Historial de temporadas (base de la HISTORIA DEL CLUB)
	local userRow
	for _, r in ipairs(standings) do
		if r.id == USER then
			userRow = r
		end
	end
	local cup = league.cup
	-- Máximo goleador y mejor asistente de la temporada (eventos reales de los partidos)
	local topScorer, topAssist
	for _, p in ipairs(data.squad) do
		local s = p.seasonStats
		if s and s.goals > 0 and (not topScorer or s.goals > topScorer.goals) then
			topScorer = { name = p.name, goals = s.goals }
		end
		if s and s.assists > 0 and (not topAssist or s.assists > topAssist.assists) then
			topAssist = { name = p.name, assists = s.assists }
		end
	end
	if topScorer and (data.records.mostGoalsSeason == nil or topScorer.goals > data.records.mostGoalsSeason.goals) then
		data.records.mostGoalsSeason = { name = topScorer.name, goals = topScorer.goals, season = league.season }
	end
	if userRow and (data.records.bestSeasonPoints == nil or userRow.pts > data.records.bestSeasonPoints.points) then
		data.records.bestSeasonPoints = { points = userRow.pts, season = league.season, division = division.name }
	end
	table.insert(league.history, {
		topScorer = topScorer,
		topAssist = topAssist,
		season = league.season,
		division = league.division,
		divisionName = division.name,
		position = position,
		points = userRow and userRow.pts or 0,
		w = userRow and userRow.w or 0, d = userRow and userRow.d or 0, l = userRow and userRow.l or 0,
		gf = userRow and userRow.gf or 0, ga = userRow and userRow.ga or 0,
		champion = champion,
		promoted = promoted,
		relegated = relegated,
		cup = cup.champion == USER and "Campeón" or (cup.eliminatedIn or "—"),
		objectiveMet = met == true,
	})
	while #league.history > 30 do
		table.remove(league.history, 1)
	end
	table.insert(out.messages, string.format("📊 %s, temporada %d: terminas %dº con %d puntos.", division.name, league.season, position, userRow and userRow.pts or 0))

	-- Siguiente temporada
	local newLevel = league.division + (promoted and 1 or 0) - (relegated and 1 or 0)
	local keep = {}
	if newLevel == league.division then
		for _, r in ipairs(standings) do
			local isPromoted = division.promote > 0 and r.position <= division.promote
			local isRelegated = division.relegate > 0 and r.position > teams - division.relegate
			if r.id ~= USER and not isPromoted and not isRelegated then
				for _, t in ipairs(league.teams) do
					if t.id == r.id then
						table.insert(keep, t)
					end
				end
			end
		end
	end
	LeagueService.NewLeague(data, league.season + 1, newLevel, keep)
end

-- ===== Jornada =====

function LeagueService.Ensure(data)
	if type(data.league) ~= "table" or not data.league.season then
		-- Liga nueva: empieza ya si estamos al principio de la temporada; si no, la próxima
		local startSeason = (data.season.cycle <= 0) and data.season.number or data.season.number + 1
		local level = type(data.league) == "table" and data.league.division or 1
		LeagueService.NewLeague(data, startSeason, level, nil)
	elseif data.league.season < data.season.number then
		LeagueService.NewLeague(data, data.season.number, data.league.division, data.league.teams)
	end
end

-- Se llama en cada jornada ANTES de que SquadService avance el reloj de la temporada.
function LeagueService.AfterCycle(player, clubName, clubShort)
	local data = DataService.Get(player)
	local out = { messages = {}, result = nil }
	if not data then
		return out
	end
	data.__clubName, data.__clubShort = clubName, clubShort
	LeagueService.Ensure(data)
	local league = data.league
	local cycle = data.season.cycle
	if league.season == data.season.number then
		-- Liga (con recuperación de jornadas pendientes)
		local round = cycle - LeagueConfig.LEAGUE_FIRST_CYCLE + 1
		for r = 1, math.min(round, LeagueConfig.LEAGUE_ROUNDS) do
			if not league.results[tostring(r)] then
				playLeagueRound(player, data, r, out)
			end
		end
		-- Copa
		for index, cupCycle in ipairs(LeagueConfig.CUP_CYCLES) do
			if cycle >= cupCycle and not league.cup.rounds[index] then
				playCupRound(player, data, index, out)
			end
		end
		if cycle >= LeagueConfig.FINALIZE_CYCLE then
			finalize(player, data, out)
		end
	end
	data.__clubName, data.__clubShort = nil, nil
	return out
end

-- ===== Estado para el cliente =====

function LeagueService.BuildState(data, clubName, clubShort)
	LeagueService.Ensure(data)
	data.__clubName, data.__clubShort = clubName, clubShort
	local league = data.league
	local division = LeagueConfig.Division(league.division)
	local map = teamMap(league)
	local function label(id)
		if id == USER then
			return clubShort, clubName
		end
		local t = map[id] or cupTeam(league, id)
		return t and t.short or "?", t and t.name or "?"
	end
	local fixtures = {}
	for round, pairs_ in ipairs(league.fixtures) do
		for _, pair in ipairs(pairs_) do
			if pair.h == USER or pair.a == USER then
				local result
				for _, m in ipairs(league.results[tostring(round)] or {}) do
					if m.h == pair.h and m.a == pair.a then
						result = m
					end
				end
				local hs, hn = label(pair.h)
				local as, an = label(pair.a)
				table.insert(fixtures, {
					round = round, cycle = LeagueConfig.LEAGUE_FIRST_CYCLE + round - 1, home = pair.h == USER,
					homeShort = hs, homeName = hn, awayShort = as, awayName = an,
					hg = result and result.hg or nil, ag = result and result.ag or nil,
				})
			end
		end
	end
	local cupRounds = {}
	for index, round in ipairs(league.cup.rounds) do
		local matches = {}
		for _, m in ipairs(round.matches) do
			local hs = label(m.h)
			local as = label(m.a)
			table.insert(matches, { home = hs, away = as, hg = m.hg, ag = m.ag, penalties = m.penalties, user = m.h == USER or m.a == USER,
				userWon = m.winner == USER })
		end
		cupRounds[index] = { name = LeagueConfig.CUP_ROUND_NAMES[index], matches = matches }
	end
	local strengths = {}
	for _, t in ipairs(league.teams) do
		strengths[t.id] = t.strength
	end
	local standings = LeagueService.Standings(data)
	for _, r in ipairs(standings) do
		r.strength = r.id == USER and math.floor(MatchService.TeamStrength(data) + 0.5) or strengths[r.id]
		r.isUser = r.id == USER
	end
	data.__clubName, data.__clubShort = nil, nil
	return {
		season = league.season,
		started = league.season == data.season.number,
		division = league.division,
		divisionName = division.name,
		divisions = #LeagueConfig.Divisions,
		promote = division.promote,
		relegate = division.relegate,
		standings = standings,
		fixtures = fixtures,
		cup = { name = LeagueConfig.CUP_NAME, rounds = cupRounds, alive = league.cup.alive, champion = league.cup.champion == USER,
			eliminatedIn = league.cup.eliminatedIn, cycles = LeagueConfig.CUP_CYCLES, roundNames = LeagueConfig.CUP_ROUND_NAMES },
		objective = league.objective,
		boardConfidence = league.boardConfidence,
		history = league.history,
		trophies = data.trophies,
		cycle = data.season.cycle,
	}
end

function LeagueService.PlayerReady(player)
	local data = DataService.Get(player)
	if data then
		LeagueService.Ensure(data)
	end
end

return LeagueService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000026"><Properties><string name="Name">MatchService</string><ProtectedString name="Source"><![CDATA[-- MatchService (ModuleScript)
-- Ubicación: ServerScriptService/Server/Services/MatchService
--
-- FASE 5: alineaciones, formaciones, tácticas y PARTIDOS SIMULADOS.
--   * Solo el servidor simula (MatchEngine + Random del servidor).
--   * Efectos reales: premios, reputación, satisfacción, estadísticas de jugadores,
--     forma física, lesiones, historial y récords.
--   * Los rivales de los amistosos son clubes ficticios generados en el servidor.
--     Las ligas (FASE 7) y los partidos entre usuarios (FASE 9) reutilizan
--     BuildUserSheet / BuildAISheet / Play.
-- Los partidos se presentan siempre como SIMULACIONES, no como partidos controlables.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local FootballConfig = require(Shared.Config.FootballConfig)
local TacticsConfig = require(Shared.Config.TacticsConfig)
local FootballFormulas = require(Shared.Modules.FootballFormulas)
local MatchEngine = require(Shared.Modules.MatchEngine)
local UniverseConfig = require(Shared.Config.UniverseConfig)

local DataService = require(script.Parent.DataService)
local EconomyService = require(script.Parent.EconomyService)
local StadiumService = require(script.Parent.StadiumService)

local MatchService = {}

local rng = Random.new()

-- ===== Alineación =====

local function available(p)
	return (p.injury or 0) <= 0 and not (p.loan and p.loan.type == "out")
end

local function slotScore(p, slotPos)
	local factor = MatchEngine.PlayerFactor({ pos = p.pos, slotPos = slotPos, fitness = p.fitness })
	return FootballFormulas.Overall(p) * factor
end

-- Mejor once posible para la formación actual (respeta lesiones y forma física).
function MatchService.AutoLineup(data)
	local formation = TacticsConfig.Formation(data.tactics.formation)
	local used, lineup = {}, {}
	for index, slotPos in ipairs(formation.slots) do
		local best, bestScore = nil, -1
		for _, p in ipairs(data.squad) do
			if not used[p.id] and available(p) then
				local score = slotScore(p, slotPos)
				if score > bestScore then
					best, bestScore = p, score
				end
			end
		end
		if best then
			used[best.id] = true
			lineup[index] = best.id
		else
			lineup[index] = ""
		end
	end
	data.tactics.lineup = lineup
	return lineup
end

-- Repara la alineación guardada: quita lesionados, duplicados o jugadores que ya no están.
function MatchService.ValidateLineup(data)
	local formation = TacticsConfig.Formation(data.tactics.formation)
	local byId = {}
	for _, p in ipairs(data.squad) do
		byId[p.id] = p
	end
	local lineup, used, missing = {}, {}, false
	for index = 1, #formation.slots do
		local id = data.tactics.lineup[index]
		local p = byId[id]
		if p and available(p) and not used[id] then
			lineup[index] = id
			used[id] = true
		else
			lineup[index] = ""
			missing = true
		end
	end
	if missing then
		-- Rellena los huecos con el mejor disponible para cada puesto
		for index, slotPos in ipairs(formation.slots) do
			if lineup[index] == "" then
				local best, bestScore = nil, -1
				for _, p in ipairs(data.squad) do
					if not used[p.id] and available(p) then
						local score = slotScore(p, slotPos)
						if score > bestScore then
							best, bestScore = p, score
						end
					end
				end
				if best then
					lineup[index] = best.id
					used[best.id] = true
				end
			end
		end
	end
	data.tactics.lineup = lineup
	return lineup
end

function MatchService.TeamStrength(data)
	local values = {}
	for _, p in ipairs(data.squad) do
		table.insert(values, FootballFormulas.Overall(p))
	end
	table.sort(values, function(a, b)
		return a > b
	end)
	local total, n = 0, math.min(11, #values)
	for i = 1, n do
		total += values[i]
	end
	return n > 0 and total / n or 40
end

function MatchService.BuildUserSheet(data, name, short)
	local formation = TacticsConfig.Formation(data.tactics.formation)
	local lineup = MatchService.ValidateLineup(data)
	local byId = {}
	for _, p in ipairs(data.squad) do
		byId[p.id] = p
	end
	local players = {}
	for index, slotPos in ipairs(formation.slots) do
		local p = byId[lineup[index]]
		if p then
			table.insert(players, {
				id = p.id, name = p.name, pos = p.pos, slotPos = slotPos, attrs = p.attrs, fitness = p.fitness or 100,
			})
		end
	end
	return {
		name = name, short = short,
		formation = formation.id, mentality = data.tactics.mentality, style = data.tactics.style,
		players = players,
	}
end

-- Rival generado de forma determinista a partir de su descripción (mismo rival = misma plantilla).
function MatchService.BuildAISheet(opponent)
	local seeded = Random.new(opponent.seed or 1)
	local formation = TacticsConfig.Formation(opponent.formation)
	local players = {}
	for index, slotPos in ipairs(formation.slots) do
		local attrs = {}
		local bias = FootballConfig.Bias[slotPos]
		for _, attr in ipairs(FootballConfig.Attributes) do
			attrs[attr.id] = math.clamp(opponent.strength + bias[attr.id] + seeded:NextInteger(-6, 6), 5, 97)
		end
		local probe = { pos = slotPos, attrs = attrs }
		local diff = opponent.strength - FootballFormulas.Overall(probe)
		for id, v in pairs(attrs) do
			attrs[id] = math.clamp(v + diff, 5, 97)
		end
		local first = FootballConfig.FirstNames[seeded:NextInteger(1, #FootballConfig.FirstNames)]
		local last = FootballConfig.LastNames[seeded:NextInteger(1, #FootballConfig.LastNames)]
		table.insert(players, {
			id = "ai" .. index, name = first .. " " .. last, pos = slotPos, slotPos = slotPos, attrs = attrs, fitness = 100,
		})
	end
	return {
		name = opponent.name, short = opponent.short,
		formation = formation.id, mentality = opponent.mentality, style = opponent.style,
		players = players,
	}
end

function MatchService.RandomClubName(random)
	random = random or rng
	local prefix = TacticsConfig.ClubPrefixes[random:NextInteger(1, #TacticsConfig.ClubPrefixes)]
	local town = TacticsConfig.ClubTowns[random:NextInteger(1, #TacticsConfig.ClubTowns)]
	local name = prefix .. " " .. town
	local short = string.upper(string.sub(town:gsub("[^%a]", ""), 1, 3))
	return name, short
end

-- ===== Amistosos =====

local function generateFriendlies(data)
	local strength = MatchService.TeamStrength(data)
	local offers = {}
	for i, difficulty in ipairs(TacticsConfig.FRIENDLY_DIFFICULTY) do
		local name, short = MatchService.RandomClubName()
		local formations = TacticsConfig.Formations
		table.insert(offers, {
			id = string.format("f%d-%d", data.stats.cycles, i),
			name = name,
			short = short,
			difficulty = difficulty.id,
			strength = math.clamp(math.floor(strength + difficulty.delta + rng:NextInteger(-2, 2) + 0.5), 35, 92),
			formation = formations[rng:NextInteger(1, #formations)].id,
			mentality = TacticsConfig.Mentalities[rng:NextInteger(1, #TacticsConfig.Mentalities)].id,
			style = TacticsConfig.Styles[rng:NextInteger(1, #TacticsConfig.Styles)].id,
			seed = rng:NextInteger(1, 2 ^ 30),
		})
	end
	data.friendlies.offers = offers
end

function MatchService.RefreshFriendlies(data, force)
	if force or #data.friendlies.offers == 0 then
		generateFriendlies(data)
	end
end

-- ===== Aplicar resultado =====

local function countAvailable(data)
	local n = 0
	for _, p in ipairs(data.squad) do
		if available(p) then
			n += 1
		end
	end
	return n
end

-- Aplica a los jugadores del usuario las consecuencias de un partido.
local function applyPlayerEffects(data, sheet, result, messages)
	local byId = {}
	for _, p in ipairs(data.squad) do
		byId[p.id] = p
	end
	local intense = data.training.intensity == "INTENSE"
	for _, entry in ipairs(sheet.players) do
		local p = byId[entry.id]
		if p then
			p.stats.apps += 1
			p.seasonStats = p.seasonStats or { apps = 0, goals = 0, assists = 0 }
			p.seasonStats.apps += 1
			local ps = result.playerStats[p.id]
			local goals, assists = ps and ps.goals or 0, ps and ps.assists or 0
			p.stats.goals += goals
			p.stats.assists += assists
			p.seasonStats.goals += goals
			p.seasonStats.assists += assists
			-- Estadísticas de todos los tiempos del club (sobreviven a ventas y retiradas)
			local all = data.allTimeStats[p.id]
			if not all then
				all = { name = p.name, pos = p.pos, origin = p.origin, apps = 0, goals = 0, assists = 0 }
				data.allTimeStats[p.id] = all
			end
			all.apps += 1
			all.goals += goals
			all.assists += assists
			local stamina = p.attrs.stamina or 50
			local cost = TacticsConfig.FITNESS_COST_MAX - (TacticsConfig.FITNESS_COST_MAX - TacticsConfig.FITNESS_COST_MIN) * stamina / 99
			p.fitness = math.clamp((p.fitness or 100) - cost, 0, 100)
			local injuryChance = TacticsConfig.INJURY_CHANCE + (intense and TacticsConfig.INJURY_CHANCE_INTENSE or 0)
			if rng:NextNumber() < injuryChance then
				p.injury = rng:NextInteger(TacticsConfig.INJURY_MIN, TacticsConfig.INJURY_MAX)
				table.insert(messages, string.format("🚑 %s se lesiona: %d jornadas de baja.", p.name, p.injury))
			end
		end
	end
end

local function updateRecords(data, entry)
	local records = data.records
	local diff = entry.gf - entry.ga
	local function better(current, value)
		return current == nil or value > current
	end
	if diff > 0 and better(records.biggestWin and (records.biggestWin.gf - records.biggestWin.ga), diff) then
		records.biggestWin = { gf = entry.gf, ga = entry.ga, opponent = entry.opponent, season = entry.season }
	end
	if diff < 0 and better(records.worstDefeat and (records.worstDefeat.ga - records.worstDefeat.gf), -diff) then
		records.worstDefeat = { gf = entry.gf, ga = entry.ga, opponent = entry.opponent, season = entry.season }
	end
	if diff >= 0 then
		records.unbeatenCurrent = (records.unbeatenCurrent or 0) + 1
	else
		records.unbeatenCurrent = 0
	end
	if (records.unbeatenCurrent or 0) > (records.unbeatenBest or 0) then
		records.unbeatenBest = records.unbeatenCurrent
	end
end

local matchCallbacks = {}

-- Avisa a otros servicios de cada partido de un usuario (eventos comunitarios, etc.).
function MatchService.OnUserMatch(callback)
	table.insert(matchCallbacks, callback)
end

local function fireMatch(player, result, us, them)
	for _, callback in ipairs(matchCallbacks) do
		task.spawn(callback, player, result, us, them)
	end
end

MatchService.ApplyPlayerEffects = applyPlayerEffects

function MatchService.SimulateSheets(homeSheet, awaySheet, crowd)
	return MatchEngine.Simulate(homeSheet, awaySheet, rng, { crowd = crowd or 0.5 })
end

-- Registra un partido en el historial, los totales y los récords del club.
-- entry = { competition, opponent, short, home, gf, ga, scorers, mvp, prize }
function MatchService.RecordMatch(data, entry)
	entry.t = os.time()
	entry.season = data.season.number
	entry.outcome = entry.gf > entry.ga and "W" or (entry.gf == entry.ga and "D" or "L")
	table.insert(data.matches, entry)
	while #data.matches > TacticsConfig.MAX_MATCH_HISTORY do
		table.remove(data.matches, 1)
	end
	local s = data.stats
	s.matchesPlayed = (s.matchesPlayed or 0) + 1
	s.wins = (s.wins or 0) + (entry.outcome == "W" and 1 or 0)
	s.draws = (s.draws or 0) + (entry.outcome == "D" and 1 or 0)
	s.losses = (s.losses or 0) + (entry.outcome == "L" and 1 or 0)
	s.goalsFor = (s.goalsFor or 0) + entry.gf
	s.goalsAgainst = (s.goalsAgainst or 0) + entry.ga
	updateRecords(data, entry)
	if math.abs(entry.gf - entry.ga) >= 4 then
		StadiumService.LogEvent(data, "big_result", { opponent = entry.opponent, gf = entry.gf, ga = entry.ga, competition = entry.competition })
	end
	return entry.outcome
end

function MatchService.Scorers(result, side)
	local scorers = {}
	for _, event in ipairs(result.events) do
		if event.type == "goal" and event.side == side then
			table.insert(scorers, string.format("%s %d'", event.player, event.minute))
		end
	end
	return scorers
end

-- Juega un partido del usuario y aplica todo.
-- opponent: rival ficticio { name, short, strength, ... } o, con opts.opponentSheet, un club real (hoja pública).
-- opts: competition ("Amistoso", "Liga", "Copa", "Reto", "Torneo"...), home, prizeScale,
--       noEconomy = true -> sin premio, reputación ni satisfacción (partidos entre usuarios y torneos)
function MatchService.Play(player, opponent, opts)
	local data = DataService.Get(player)
	local userSheet = MatchService.BuildUserSheet(data, opts.clubName, opts.clubShort)
	local opponentSheet = opts.opponentSheet or MatchService.BuildAISheet(opponent)
	local home = opts.home ~= false
	local crowd = (data.economy.lastCycle and data.economy.lastCycle.occupancy) or 0
	local result
	if home then
		result = MatchEngine.Simulate(userSheet, opponentSheet, rng, { crowd = crowd })
	else
		result = MatchEngine.Simulate(opponentSheet, userSheet, rng, { crowd = 0.7 })
	end
	local us = home and result.home or result.away
	local them = home and result.away or result.home
	local messages = {}
	applyPlayerEffects(data, userSheet, result, messages)

	-- Premios, reputación y satisfacción
	local outcome = us.goals > them.goals and "W" or (us.goals == them.goals and "D" or "L")
	local prize, repGain, satisfaction = 0, 0, 0
	if not opts.noEconomy then
		prize = TacticsConfig.FRIENDLY_PRIZE_BASE * (opponent.strength / 50) ^ 2 * (opts.prizeScale or 1)
			* UniverseConfig.Multiplier("matchPrize") -- evento del universo
		if outcome == "D" then
			prize *= TacticsConfig.PRIZE_DRAW
		elseif outcome == "L" then
			prize *= TacticsConfig.PRIZE_LOSS
		end
		prize = math.floor(prize)
		EconomyService.Earn(player, prize, EconomyService.Category.PRIZE, string.format("%s vs %s (%d-%d)", opts.competition, opponent.name, us.goals, them.goals))
		if outcome == "W" and opponent.strength >= MatchService.TeamStrength(data) - 3 then
			repGain = TacticsConfig.REPUTATION_WIN * (opts.reputationScale or 1)
			data.club.reputationEarned += repGain
		end
		satisfaction = outcome == "W" and TacticsConfig.SATISFACTION_WIN or (outcome == "L" and TacticsConfig.SATISFACTION_LOSS or 0)
		data.club.satisfaction = math.clamp(data.club.satisfaction + satisfaction, 0, 100)
	end

	MatchService.RecordMatch(data, {
		competition = opts.competition,
		opponent = opponent.name,
		short = opponent.short,
		home = home,
		gf = us.goals,
		ga = them.goals,
		scorers = MatchService.Scorers(result, home and 1 or 2),
		mvp = result.mvp and result.mvp.name or nil,
		prize = prize,
	})

	result.userSide = home and 1 or 2
	result.prize = prize
	result.reputation = repGain
	result.satisfaction = satisfaction
	result.outcome = outcome
	result.competition = opts.competition
	result.messages = messages
	fireMatch(player, result, us.goals, them.goals)
	result.playerStats = nil -- no hace falta en el cliente (ya se resume en los eventos)
	result.ratings = nil
	return result, messages
end

-- Partido entre dos usuarios conectados (FASE 9). Aplica efectos y registros a ambos.
-- Devuelve el resultado (sin datos internos) o nil y un motivo.
function MatchService.PlayUsers(homePlayer, awayPlayer, competition, homeInfo, awayInfo)
	local homeData, awayData = DataService.Get(homePlayer), DataService.Get(awayPlayer)
	if not homeData or not awayData then
		return nil, "Uno de los clubes no está disponible."
	end
	local homeSheet = MatchService.BuildUserSheet(homeData, homeInfo.name, homeInfo.short)
	local awaySheet = MatchService.BuildUserSheet(awayData, awayInfo.name, awayInfo.short)
	if #homeSheet.players < 11 or #awaySheet.players < 11 then
		return nil, "Uno de los clubes no tiene 11 jugadores disponibles."
	end
	local crowd = (homeData.economy.lastCycle and homeData.economy.lastCycle.occupancy) or 0
	local result = MatchEngine.Simulate(homeSheet, awaySheet, rng, { crowd = crowd })
	local sides = { { player = homePlayer, data = homeData, sheet = homeSheet, side = 1, other = awayInfo },
		{ player = awayPlayer, data = awayData, sheet = awaySheet, side = 2, other = homeInfo } }
	for _, entry in ipairs(sides) do
		applyPlayerEffects(entry.data, entry.sheet, result, {})
		local us = entry.side == 1 and result.home or result.away
		local them = entry.side == 1 and result.away or result.home
		MatchService.RecordMatch(entry.data, {
			competition = competition, opponent = entry.other.name, short = entry.other.short, home = entry.side == 1,
			gf = us.goals, ga = them.goals, scorers = MatchService.Scorers(result, entry.side),
			mvp = result.mvp and result.mvp.name or nil, prize = 0,
		})
		fireMatch(entry.player, result, us.goals, them.goals)
	end
	result.playerStats = nil
	result.ratings = nil
	result.competition = competition
	result.prize, result.reputation, result.satisfaction = 0, 0, 0
	return result
end

function MatchService.PlayFriendly(player, payload, clubName, clubShort)
	local data = DataService.Get(player)
	local offerId = type(payload) == "table" and payload.offer
	local opponent
	for _, offer in ipairs(data.friendlies.offers) do
		if offer.id == offerId then
			opponent = offer
		end
	end
	if not opponent then
		return false, "Ese amistoso ya no está disponible."
	end
	if data.friendlies.lastCycle == data.stats.cycles then
		return false, "Ya has jugado un amistoso en esta jornada. Espera a la próxima."
	end
	if countAvailable(data) < 11 then
		return false, "No tienes 11 jugadores disponibles (lesiones)."
	end
	local result = MatchService.Play(player, opponent, {
		clubName = clubName, clubShort = clubShort, home = true, competition = "Amistoso",
	})
	data.friendlies.lastCycle = data.stats.cycles
	data.friendlies.offers = {}
	return true, string.format("Amistoso simulado: %s %d - %d %s.", clubShort, result.home.goals, result.away.goals, opponent.short), result
end

-- ===== Acciones tácticas =====

function MatchService.SetFormation(player, payload)
	local data = DataService.Get(player)
	local id = type(payload) == "table" and payload.formation
	for _, f in ipairs(TacticsConfig.Formations) do
		if f.id == id then
			data.tactics.formation = f.id
			MatchService.ValidateLineup(data)
			return true, "Formación " .. f.name
		end
	end
	return false, "Formación no válida."
end

function MatchService.SetTactic(player, payload)
	local data = DataService.Get(player)
	if type(payload) ~= "table" then
		return false, "Solicitud no válida."
	end
	if payload.kind == "mentality" then
		for _, m in ipairs(TacticsConfig.Mentalities) do
			if m.id == payload.value then
				data.tactics.mentality = m.id
				return true, "Mentalidad " .. m.name
			end
		end
	elseif payload.kind == "style" then
		for _, st in ipairs(TacticsConfig.Styles) do
			if st.id == payload.value then
				data.tactics.style = st.id
				return true, "Estilo: " .. st.name
			end
		end
	end
	return false, "Táctica no válida."
end

function MatchService.SetLineupSlot(player, payload)
	local data = DataService.Get(player)
	if type(payload) ~= "table" then
		return false, "Solicitud no válida."
	end
	local formation = TacticsConfig.Formation(data.tactics.formation)
	local slot = tonumber(payload.slot)
	if not slot or slot ~= math.floor(slot) or slot < 1 or slot > #formation.slots then
		return false, "Puesto no válido."
	end
	local target
	for _, p in ipairs(data.squad) do
		if p.id == payload.id then
			target = p
		end
	end
	if not target then
		return false, "Ese jugador no es de tu plantilla."
	end
	if not available(target) then
		return false, target.name .. " está lesionado."
	end
	MatchService.ValidateLineup(data)
	local lineup = data.tactics.lineup
	-- Si ya estaba en el once, intercambia los puestos
	for index, id in ipairs(lineup) do
		if id == target.id then
			lineup[index] = lineup[slot]
		end
	end
	lineup[slot] = target.id
	return true, string.format("%s al puesto %d (%s).", target.name, slot, FootballConfig.Position(formation.slots[slot]).short)
end

function MatchService.AutoLineupAction(player)
	local data = DataService.Get(player)
	MatchService.AutoLineup(data)
	return true, "Alineación automática: mejor once disponible."
end

-- ===== Jornada =====

function MatchService.AfterCycle(player)
	local data = DataService.Get(player)
	if not data then
		return {}
	end
	local messages = {}
	for _, p in ipairs(data.squad) do
		p.fitness = math.clamp((p.fitness or 100) + TacticsConfig.FITNESS_RECOVERY, 0, 100)
		if (p.injury or 0) > 0 then
			p.injury -= 1
			if p.injury <= 0 then
				p.injury = 0
				table.insert(messages, "✅ " .. p.name .. " se ha recuperado de su lesión.")
			end
		end
	end
	MatchService.RefreshFriendlies(data, false)
	MatchService.ValidateLineup(data)
	return messages
end

function MatchService.PlayerReady(player)
	local data = DataService.Get(player)
	if data then
		if #data.tactics.lineup == 0 then
			MatchService.AutoLineup(data)
		end
		MatchService.RefreshFriendlies(data, false)
	end
end

function MatchService.BuildState(data)
	local formation = TacticsConfig.Formation(data.tactics.formation)
	local lineupInfo = {}
	local byId = {}
	for _, p in ipairs(data.squad) do
		byId[p.id] = p
	end
	for index, slotPos in ipairs(formation.slots) do
		local p = byId[data.tactics.lineup[index]]
		lineupInfo[index] = { slotPos = slotPos, id = p and p.id or "" }
	end
	return {
		tactics = {
			formation = formation.id,
			mentality = data.tactics.mentality,
			style = data.tactics.style,
			lineup = lineupInfo,
		},
		friendlies = data.friendlies.offers,
		friendlyPlayed = data.friendlies.lastCycle == data.stats.cycles,
		matches = data.matches,
		records = data.records,
		strength = math.floor(MatchService.TeamStrength(data) * 10 + 0.5) / 10,
		totals = {
			played = data.stats.matchesPlayed or 0, wins = data.stats.wins or 0, draws = data.stats.draws or 0,
			losses = data.stats.losses or 0, goalsFor = data.stats.goalsFor or 0, goalsAgainst = data.stats.goalsAgainst or 0,
		},
	}
end

return MatchService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000027"><Properties><string name="Name">PlotService</string><ProtectedString name="Source"><![CDATA[-- PlotService (ModuleScript)
-- Ubicación: ServerScriptService/Server/Services/PlotService
--
-- Terrenos del servidor:
--   * Crea el mundo base (avenida central + terrenos) por código.
--   * Asigna un terreno a cada jugador y construye su estadio desde sus datos.
--   * Teletransporta al jugador a su estadio y muestra su etiqueta (club / VIP).
-- Cualquier jugador puede caminar por los estadios ajenos (visita), pero solo
-- el servidor modifica un estadio y únicamente con los datos de su dueño.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage.Shared
local GameConfig = require(Shared.Config.GameConfig)
local CosmeticConfig = require(Shared.Config.CosmeticConfig)
local StadiumStages = require(Shared.Config.StadiumStages)

local DataService = require(script.Parent.DataService)
local ClubService = require(script.Parent.ClubService)
local BuildService = require(script.Parent.BuildService)
local StadiumRenderer = require(script.Parent.StadiumRenderer)
local InteractionService = require(script.Parent.InteractionService)
local HalloweenService = require(script.Parent.HalloweenService)

local PlotService = {}

local plots = {} -- array de { index, origin, model, stadium, owner }
local playerPlot = {} -- [player] = plot
local pendingRender = {}

local AVENUE_WIDTH = 60

local function makePart(parent, cf, size, color, mat, name)
	local p = Instance.new("Part")
	p.Anchored = true
	p.CFrame = cf
	p.Size = size
	p.Color = color
	p.Material = mat
	p.Name = name or "Part"
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end

local function setFreeSign(plot)
	local old = plot.model:FindFirstChild("FreeSign")
	if old then
		old:Destroy()
	end
	if plot.owner then
		return
	end
	local sign = makePart(plot.model, plot.origin * CFrame.new(0, 6, 82), Vector3.new(20, 6, 1),
		Color3.fromRGB(30, 40, 60), Enum.Material.SmoothPlastic, "FreeSign")
	for _, face in ipairs({ Enum.NormalId.Front, Enum.NormalId.Back }) do
		local gui = Instance.new("SurfaceGui")
		gui.Face = face
		gui.Parent = sign
		local t = Instance.new("TextLabel")
		t.Size = UDim2.fromScale(1, 1)
		t.BackgroundTransparency = 1
		t.TextColor3 = Color3.fromRGB(220, 230, 255)
		t.Font = Enum.Font.GothamBold
		t.TextScaled = true
		t.Text = "Terreno " .. plot.index .. " · libre"
		t.Parent = gui
	end
end

function PlotService.CreateWorld()
	local root = Workspace:FindFirstChild("FEU_World")
	if root then
		root:Destroy()
	end
	root = Instance.new("Folder")
	root.Name = "FEU_World"
	root.Parent = Workspace

	local perRow = math.ceil(GameConfig.PLOT_COUNT / 2)
	local stepX = GameConfig.PLOT_SIZE.X + GameConfig.PLOT_SPACING
	local rowOffset = AVENUE_WIDTH / 2 + GameConfig.PLOT_SIZE.Z / 2
	local totalX = perRow * stepX + 120
	local totalZ = (rowOffset + GameConfig.PLOT_SIZE.Z / 2) * 2 + 80

	makePart(root, CFrame.new(0, -0.6, 0), Vector3.new(totalX, 1, totalZ), Color3.fromRGB(70, 110, 60), Enum.Material.Grass, "Ground")
	makePart(root, CFrame.new(0, -0.48, 0), Vector3.new(totalX, 1, AVENUE_WIDTH - 10), Color3.fromRGB(150, 150, 155), Enum.Material.Concrete, "Avenue")

	local spawn = Instance.new("SpawnLocation")
	spawn.Anchored = true
	spawn.Size = Vector3.new(12, 1, 12)
	spawn.CFrame = CFrame.new(0, 0.05, 0)
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.Color = Color3.fromRGB(255, 196, 0)
	spawn.Material = Enum.Material.Neon
	spawn.Parent = root

	local plotsFolder = Instance.new("Folder")
	plotsFolder.Name = "Plots"
	plotsFolder.Parent = root

	for i = 1, GameConfig.PLOT_COUNT do
		local row = (i <= perRow) and 0 or 1
		local col = (i - 1) % perRow
		local x = (col - (perRow - 1) / 2) * stepX
		local origin
		if row == 0 then
			origin = CFrame.new(x, 0, -rowOffset) -- plaza (Z+ local) mirando a la avenida
		else
			origin = CFrame.new(x, 0, rowOffset) * CFrame.Angles(0, math.pi, 0)
		end
		local model = Instance.new("Model")
		model.Name = "Plot_" .. i
		model:SetAttribute("PlotIndex", i)
		model.Parent = plotsFolder
		local base = makePart(model, origin * CFrame.new(0, -0.5, 0), GameConfig.PLOT_SIZE,
			Color3.fromRGB(86, 125, 70), Enum.Material.Grass, "Base")
		model.PrimaryPart = base
		local stadium = Instance.new("Folder")
		stadium.Name = "Stadium"
		stadium.Parent = model
		local crowd = Instance.new("Folder")
		crowd.Name = "Crowd"
		crowd.Parent = model
		local plot = { index = i, origin = origin, model = model, stadium = stadium, crowd = crowd, owner = nil }
		plots[i] = plot
		setFreeSign(plot)
	end
end

function PlotService.Assign(player)
	if playerPlot[player] then
		return playerPlot[player]
	end
	for _, plot in ipairs(plots) do
		if not plot.owner then
			plot.owner = player
			plot.model:SetAttribute("OwnerUserId", player.UserId)
			plot.model:SetAttribute("OwnerName", player.DisplayName)
			playerPlot[player] = plot
			setFreeSign(plot)
			InteractionService.EnsureBall(plot, player) -- balón jugable en el campo
			HalloweenService.SetupPlot(plot) -- caramelos y calabazas (solo durante el evento)
			return plot
		end
	end
	return nil
end

function PlotService.Release(player)
	local plot = playerPlot[player]
	if not plot then
		return
	end
	playerPlot[player] = nil
	pendingRender[player] = nil
	plot.owner = nil
	plot.model:SetAttribute("OwnerUserId", nil)
	plot.model:SetAttribute("OwnerName", nil)
	plot.stadium:ClearAllChildren()
	plot.crowd:ClearAllChildren()
	plot.crowdKey = nil
	InteractionService.RemoveBall(plot)
	HalloweenService.ClearPlot(plot)
	setFreeSign(plot)
end

function PlotService.GetPlot(player)
	return playerPlot[player]
end

local function readableText(color)
	local luminance = 0.299 * color.R + 0.587 * color.G + 0.114 * color.B
	return luminance > 0.6 and Color3.fromRGB(20, 20, 25) or Color3.fromRGB(250, 250, 250)
end

function PlotService.BuildRenderInfo(player, data)
	local appearance = ClubService.EffectiveAppearance(player, data)
	local palette = CosmeticConfig.ById.palette[appearance.palette]
	local crest = CosmeticConfig.ById.crest[appearance.crest]
	local kit = CosmeticConfig.ById.kit[appearance.kit]
	local stage = StadiumStages.Get(data.stadium.stage)
	return {
		facilities = data.stadium.facilities,
		appearance = appearance,
		primary = palette.primary,
		secondary = palette.secondary,
		secondaryText = readableText(palette.primary),
		crestSymbol = crest.symbol,
		kitPattern = kit.pattern,
		clubName = ClubService.DisplayName(data),
		shortName = ClubService.ShortName(data),
		ownerName = player.DisplayName,
		stage = stage.stage,
		stageName = stage.name,
		stageVisual = stage.visual,
		trophyCount = #data.trophies,
		trophies = data.trophies,
		lastMatch = data.matches[#data.matches],
		vip = ClubService.IsVip(player),
		decorations = data.stadium.decorations,
		sponsors = {
			shirt = data.sponsors.contracts.shirt and data.sponsors.contracts.shirt.brand or nil,
			boards = data.sponsors.contracts.boards and data.sponsors.contracts.boards.brand or nil,
			naming = data.sponsors.contracts.naming and data.sponsors.contracts.naming.brand or nil,
		},
		decorationVisible = BuildService.DecorationVisibility(player, data),
	}
end

local function updateNameTag(player, data)
	local character = player.Character
	local head = character and character:FindFirstChild("Head")
	if not head or not data then
		return
	end
	local tag = head:FindFirstChild("FEU_Tag")
	if not tag then
		tag = Instance.new("BillboardGui")
		tag.Name = "FEU_Tag"
		tag.Size = UDim2.fromOffset(200, 50)
		tag.StudsOffset = Vector3.new(0, 2.6, 0)
		tag.MaxDistance = 80
		tag.Parent = head
		local layout = Instance.new("UIListLayout")
		layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
		layout.Parent = tag
	end
	tag:ClearAllChildren()
	local layout = Instance.new("UIListLayout")
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	layout.Parent = tag
	local info = PlotService.BuildRenderInfo(player, data)
	if info.vip then
		local vip = Instance.new("TextLabel")
		vip.Size = UDim2.new(0, 70, 0.45, 0)
		vip.BackgroundColor3 = Color3.fromRGB(255, 200, 70)
		vip.TextColor3 = Color3.fromRGB(40, 25, 0)
		vip.Font = Enum.Font.GothamBlack
		vip.TextScaled = true
		vip.Text = "👑 VIP"
		vip.Parent = tag
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0.4, 0)
		corner.Parent = vip
	end
	local club = Instance.new("TextLabel")
	club.Size = UDim2.new(1, 0, 0.5, 0)
	club.BackgroundTransparency = 1
	club.TextColor3 = Color3.fromRGB(255, 255, 255)
	club.TextStrokeTransparency = 0.4
	club.Font = Enum.Font.GothamBold
	club.TextScaled = true
	club.Text = info.crestSymbol .. " " .. info.clubName
	club.Parent = tag
end

-- Afición en las gradas: solo se reconstruye cuando cambia la ocupación (en tramos del 10 %)
-- o el tamaño/colores de las gradas, para no recrear piezas en cada jornada.
function PlotService.UpdateCrowd(player, occupancy)
	local plot = playerPlot[player]
	local data = DataService.Get(player)
	if not plot or not data then
		return
	end
	occupancy = math.clamp(tonumber(occupancy) or 0, 0, 1)
	local info = PlotService.BuildRenderInfo(player, data)
	local standsLevel = data.stadium.facilities.stands or 1
	local key = string.format("%d|%d|%s|%s", math.floor(occupancy * 10 + 0.5), standsLevel, info.appearance.palette, tostring(info.stageVisual and info.stageVisual.corners))
	if plot.crowdKey == key then
		return
	end
	plot.crowdKey = key
	local ok, err = pcall(StadiumRenderer.RenderCrowd, plot.crowd, plot.origin, standsLevel, math.floor(occupancy * 10 + 0.5) / 10, info)
	if not ok then
		warn("[PlotService] Error dibujando la afición de ", player.Name, ": ", err)
	end
end

function PlotService.Render(player)
	local plot = playerPlot[player]
	local data = DataService.Get(player)
	if not plot or not data then
		return
	end
	local ok, err = pcall(function()
		local info = PlotService.BuildRenderInfo(player, data)
		StadiumRenderer.Render(plot.stadium, plot.origin, info)
		InteractionService.Attach(plot, player, info.clubName) -- indicaciones E/F en las instalaciones
	end)
	if not ok then
		warn("[PlotService] Error construyendo el estadio de ", player.Name, ": ", err)
	end
	updateNameTag(player, data)
	plot.crowdKey = nil
	local last = data.economy.lastCycle
	PlotService.UpdateCrowd(player, last and last.occupancy or 0)
end

-- Agrupa varios cambios seguidos en una sola reconstrucción.
function PlotService.RequestRender(player)
	if pendingRender[player] then
		return
	end
	pendingRender[player] = true
	task.delay(0.25, function()
		if pendingRender[player] then
			pendingRender[player] = nil
			if player.Parent then
				PlotService.Render(player)
			end
		end
	end)
end

function PlotService.TeleportHome(player)
	local plot = playerPlot[player]
	local character = player.Character
	if not plot or not character or not character:FindFirstChild("HumanoidRootPart") then
		return false, "No se pudo teletransportar ahora."
	end
	character:PivotTo(plot.origin * StadiumRenderer.SpawnOffset)
	return true, "Bienvenido a tu estadio."
end

function PlotService.CharacterAdded(player)
	task.wait(0.2)
	if DataService.Get(player) then
		PlotService.TeleportHome(player)
		updateNameTag(player, DataService.Get(player))
	end
end

return PlotService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000028"><Properties><string name="Name">SponsorService</string><ProtectedString name="Source"><![CDATA[-- SponsorService (ModuleScript)
-- Ubicación: ServerScriptService/Server/Services/SponsorService
--
-- Contratos de patrocinio (FASE 3):
--   * Ofertas generadas en el SERVIDOR según reputación y aficionados, guardadas en los
--     datos (no se pueden "volver a tirar" saliendo y entrando).
--   * Aceptar: cobra la prima de fichaje y empieza a pagar en cada jornada (EconomyFormulas).
--   * Objetivo del contrato evaluado con datos reales en cada jornada (+25 % si se cumple).
--   * Rescindir: penalización. Al terminar la duración, el contrato expira.
-- Todas las marcas son ficticias (SponsorConfig).

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local GameConfig = require(Shared.Config.GameConfig)
local SponsorConfig = require(Shared.Config.SponsorConfig)
local EconomyFormulas = require(Shared.Modules.EconomyFormulas)

local DataService = require(script.Parent.DataService)
local EconomyService = require(script.Parent.EconomyService)
local StadiumService = require(script.Parent.StadiumService)

local SponsorService = {}

local rng = Random.new()

local function brandName()
	local prefix = SponsorConfig.BrandPrefixes[rng:NextInteger(1, #SponsorConfig.BrandPrefixes)]
	local suffix = SponsorConfig.BrandSuffixes[rng:NextInteger(1, #SponsorConfig.BrandSuffixes)]
	return prefix .. " " .. suffix
end

local function makeObjective(data)
	local def = SponsorConfig.Objectives[rng:NextInteger(1, #SponsorConfig.Objectives)]
	if def.id == "occupancy" then
		return { type = "occupancy", target = rng:NextInteger(60, 95) / 100 }
	elseif def.id == "satisfaction" then
		return { type = "satisfaction", target = rng:NextInteger(50, 80) }
	end
	local members = math.max(20, data.club.members or 0)
	return { type = "members", target = math.floor(members * (1 + rng:NextInteger(5, 30) / 100)) }
end

function SponsorService.OfferValue(data, slot)
	local reputation = EconomyFormulas.Reputation(data)
	local base = SponsorConfig.BASE_VALUE + reputation * SponsorConfig.PER_REPUTATION
		+ math.sqrt(math.max(0, data.club.fans)) * SponsorConfig.PER_SQRT_FAN
	return base * slot.value
end

local function generateOffers(data, slot)
	local offers = {}
	local value = SponsorService.OfferValue(data, slot)
	for i = 1, SponsorConfig.OFFERS_PER_SLOT do
		local payment = math.floor(value * (SponsorConfig.RANDOM_MIN + rng:NextNumber() * (SponsorConfig.RANDOM_MAX - SponsorConfig.RANDOM_MIN)))
		local duration = rng:NextInteger(SponsorConfig.DURATION_MIN, SponsorConfig.DURATION_MAX)
		table.insert(offers, {
			id = string.format("%s-%d-%d", slot.id, data.stats.cycles, i),
			brand = brandName(),
			payment = payment,
			bonus = payment * rng:NextInteger(SponsorConfig.SIGNING_BONUS_MIN, SponsorConfig.SIGNING_BONUS_MAX),
			duration = duration,
			objective = makeObjective(data),
		})
	end
	return offers
end

function SponsorService.SlotUnlocked(data, slot)
	return (data.stadium.stage or 1) >= slot.minStage
end

-- Renueva las ofertas de los huecos libres cuando toca (o si no hay ninguna).
function SponsorService.RefreshOffers(data, force)
	local sponsors = data.sponsors
	local due = force or data.stats.cycles >= sponsors.nextRefresh
	for _, slot in ipairs(SponsorConfig.Slots) do
		local empty = sponsors.offers[slot.id] == nil or #sponsors.offers[slot.id] == 0
		if SponsorService.SlotUnlocked(data, slot) and not sponsors.contracts[slot.id] and (due or empty) then
			sponsors.offers[slot.id] = generateOffers(data, slot)
		end
	end
	if due then
		sponsors.nextRefresh = data.stats.cycles + SponsorConfig.OFFER_REFRESH_CYCLES
	end
end

function SponsorService.Accept(player, payload)
	local data = DataService.Get(player)
	if type(payload) ~= "table" or type(payload.slot) ~= "string" or type(payload.offer) ~= "string" then
		return false, "Solicitud no válida."
	end
	local slot = SponsorConfig.Slot(payload.slot)
	if not slot then
		return false, "Ese hueco de patrocinio no existe."
	end
	if not SponsorService.SlotUnlocked(data, slot) then
		return false, string.format("Este hueco se desbloquea en la etapa %d del estadio.", slot.minStage)
	end
	if data.sponsors.contracts[slot.id] then
		return false, "Ya tienes un contrato en este hueco."
	end
	local chosen
	for _, offer in ipairs(data.sponsors.offers[slot.id] or {}) do
		if offer.id == payload.offer then
			chosen = offer
		end
	end
	if not chosen then
		return false, "Esa oferta ya no está disponible."
	end
	data.sponsors.contracts[slot.id] = {
		brand = chosen.brand,
		payment = chosen.payment,
		objective = chosen.objective,
		cyclesLeft = chosen.duration,
		duration = chosen.duration,
		signedAt = os.time(),
	}
	data.sponsors.offers[slot.id] = {}
	EconomyService.Earn(player, chosen.bonus, EconomyService.Category.SPONSOR, "Prima de fichaje: " .. chosen.brand)
	StadiumService.LogEvent(data, "sponsor_signed", { slot = slot.id, brand = chosen.brand, payment = chosen.payment })
	return true, string.format("🤝 Contrato firmado con %s (%s). Prima: %d %s.", chosen.brand, slot.name, chosen.bonus, GameConfig.CURRENCY)
end

function SponsorService.TerminationPenalty(contract)
	return contract.payment * SponsorConfig.TERMINATION_PENALTY
end

function SponsorService.Terminate(player, payload)
	local data = DataService.Get(player)
	local slotId = type(payload) == "table" and payload.slot
	local contract = type(slotId) == "string" and data.sponsors.contracts[slotId]
	if not contract then
		return false, "No hay contrato en ese hueco."
	end
	local penalty = SponsorService.TerminationPenalty(contract)
	local paid, err = EconomyService.Spend(player, penalty, EconomyService.Category.SPONSOR, "Rescisión: " .. contract.brand)
	if not paid then
		return false, "No puedes pagar la penalización (" .. penalty .. " " .. GameConfig.CURRENCY .. "): " .. tostring(err)
	end
	data.sponsors.contracts[slotId] = nil
	StadiumService.LogEvent(data, "sponsor_terminated", { slot = slotId, brand = contract.brand })
	SponsorService.RefreshOffers(data, false)
	return true, "Contrato con " .. contract.brand .. " rescindido."
end

-- Se llama después de cada jornada: descuenta duración y expira contratos.
-- Devuelve una lista de mensajes para el jugador.
function SponsorService.AfterCycle(player)
	local data = DataService.Get(player)
	if not data then
		return {}
	end
	local messages = {}
	for slotId, contract in pairs(data.sponsors.contracts) do
		contract.cyclesLeft -= 1
		if contract.cyclesLeft <= 0 then
			data.sponsors.contracts[slotId] = nil
			StadiumService.LogEvent(data, "sponsor_expired", { slot = slotId, brand = contract.brand })
			table.insert(messages, "El contrato con " .. contract.brand .. " ha terminado. Tienes nuevas ofertas en Economía › Patrocinios.")
		end
	end
	SponsorService.RefreshOffers(data, false)
	return messages
end

function SponsorService.PlayerReady(player)
	local data = DataService.Get(player)
	if data then
		SponsorService.RefreshOffers(data, false)
	end
end

return SponsorService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000029"><Properties><string name="Name">SquadService</string><ProtectedString name="Source"><![CDATA[-- SquadService (ModuleScript)
-- Ubicación: ServerScriptService/Server/Services/SquadService
--
-- FASE 4: plantilla, contratos, entrenamiento y CANTERA GENERACIONAL.
--   * Evolución por jornada según potencial, edad, entrenamiento e instalaciones.
--   * Temporadas: edad, contratos, retiradas, leyendas y nueva hornada de juveniles.
--   * Ojeadores: mejoran el potencial de la cantera, la precisión del potencial
--     estimado y traen informes con juveniles que se pueden fichar.
-- Todo se valida aquí; el cliente solo envía intenciones con IDs de SUS jugadores.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local GameConfig = require(Shared.Config.GameConfig)
local FootballConfig = require(Shared.Config.FootballConfig)
local FootballFormulas = require(Shared.Modules.FootballFormulas)
local UniverseConfig = require(Shared.Config.UniverseConfig)

local DataService = require(script.Parent.DataService)
local EconomyService = require(script.Parent.EconomyService)
local StadiumService = require(script.Parent.StadiumService)
local PlayerFactory = require(script.Parent.Parent.Util.PlayerFactory)

local SquadService = {}

local rng = Random.new()

local function findIn(list, id)
	if type(id) ~= "string" then
		return nil
	end
	for index, p in ipairs(list) do
		if p.id == id then
			return p, index
		end
	end
	return nil
end
SquadService.FindIn = findIn

local function activeCount(data)
	local n = 0
	for _, p in ipairs(data.squad) do
		if not (p.loan and p.loan.type == "out") then
			n += 1
		end
	end
	return n
end

local function academyLevel(data)
	return data.stadium.facilities.academy or 0
end

function SquadService.EnsureSquad(data)
	if #data.squad == 0 then
		data.squad = PlayerFactory.StartingSquad(data)
	end
	if #data.academy.youths == 0 and data.academy.seededIntake ~= true then
		local level = academyLevel(data)
		for _ = 1, FootballConfig.Academy(level).intake + 1 do
			table.insert(data.academy.youths, PlayerFactory.Youth(data, level, data.academy.scouts))
		end
		data.academy.seededIntake = true
	end
end

-- ===== Acciones =====

function SquadService.SetIntensity(player, payload)
	local data = DataService.Get(player)
	local id = type(payload) == "table" and payload.intensity
	for _, option in ipairs(FootballConfig.TrainingIntensities) do
		if option.id == id then
			data.training.intensity = option.id
			return true, "Entrenamiento: " .. option.name
		end
	end
	return false, "Intensidad no válida."
end

function SquadService.SetFocus(player, payload)
	local data = DataService.Get(player)
	if type(payload) ~= "table" then
		return false, "Solicitud no válida."
	end
	local target = findIn(data.squad, payload.id) or findIn(data.academy.youths, payload.id)
	if not target then
		return false, "Ese jugador no es de tu club."
	end
	if payload.focus == nil or payload.focus == "" then
		target.focus = nil
		return true, target.name .. ": entrenamiento equilibrado."
	end
	for _, attr in ipairs(FootballConfig.Attributes) do
		if attr.id == payload.focus then
			target.focus = attr.id
			return true, string.format("%s: entrenamiento centrado en %s.", target.name, attr.name)
		end
	end
	return false, "Atributo no válido."
end

function SquadService.Renew(player, payload)
	local data = DataService.Get(player)
	local target = type(payload) == "table" and findIn(data.squad, payload.id)
	if not target then
		return false, "Ese jugador no es de tu plantilla."
	end
	local years = tonumber(type(payload) == "table" and payload.years)
	if not years or years ~= math.floor(years) or years < 1 or years > FootballConfig.CONTRACT_MAX_SEASONS then
		return false, "Duración no válida."
	end
	if target.loan then
		return false, "No se puede renovar a un jugador cedido."
	end
	if target.contract > FootballConfig.RENEW_WINDOW then
		return false, string.format("Solo se puede renovar cuando quedan %d temporadas o menos.", FootballConfig.RENEW_WINDOW)
	end
	if target.age >= FootballConfig.RETIRE_FORCED_AGE - 1 and years > 1 then
		return false, "Por su edad, solo acepta renovar 1 temporada."
	end
	local demand = FootballFormulas.SalaryDemand(target)
	target.salary = demand
	target.contract = years
	return true, string.format("%s renueva %d temporada(s) por %d %s/jornada.", target.name, years, demand, GameConfig.CURRENCY)
end

function SquadService.Release(player, payload)
	local data = DataService.Get(player)
	local target, index = findIn(data.squad, type(payload) == "table" and payload.id)
	if not target then
		return false, "Ese jugador no es de tu plantilla."
	end
	if target.loan then
		return false, "No se puede rescindir a un jugador cedido."
	end
	if activeCount(data) <= FootballConfig.MIN_SQUAD then
		return false, string.format("Necesitas al menos %d jugadores en la plantilla.", FootballConfig.MIN_SQUAD)
	end
	local cost = FootballFormulas.ReleaseCost(target)
	local paid, err = EconomyService.Spend(player, cost, EconomyService.Category.WAGES, "Rescisión: " .. target.name)
	if not paid then
		return false, "No puedes pagar la rescisión (" .. cost .. " " .. GameConfig.CURRENCY .. "): " .. tostring(err)
	end
	table.remove(data.squad, index)
	StadiumService.LogEvent(data, "player_released", { name = target.name, ovr = FootballFormulas.OverallInt(target) })
	return true, target.name .. " deja el club."
end

function SquadService.PromoteYouth(player, payload)
	local data = DataService.Get(player)
	local youth, index = findIn(data.academy.youths, type(payload) == "table" and payload.id)
	if not youth then
		return false, "Ese juvenil no está en tu academia."
	end
	if youth.age < FootballConfig.YOUTH_MIN_PROMOTE_AGE then
		return false, string.format("Debe tener al menos %d años.", FootballConfig.YOUTH_MIN_PROMOTE_AGE)
	end
	if activeCount(data) >= FootballConfig.MAX_SQUAD then
		return false, string.format("La plantilla está llena (%d). Haz sitio primero.", FootballConfig.MAX_SQUAD)
	end
	table.remove(data.academy.youths, index)
	youth.salary = math.max(2, math.floor(FootballFormulas.SalaryDemand(youth) * FootballConfig.YOUTH_SALARY_SHARE))
	youth.contract = 3
	youth.joinedSeason = data.season.number
	table.insert(data.squad, youth)
	data.stats.academyGraduates = (data.stats.academyGraduates or 0) + 1
	StadiumService.LogEvent(data, "youth_promoted", { name = youth.name, ovr = FootballFormulas.OverallInt(youth), age = youth.age })
	return true, string.format("🧬 %s sube al primer equipo.", youth.name)
end

function SquadService.ReleaseYouth(player, payload)
	local data = DataService.Get(player)
	local youth, index = findIn(data.academy.youths, type(payload) == "table" and payload.id)
	if not youth then
		return false, "Ese juvenil no está en tu academia."
	end
	table.remove(data.academy.youths, index)
	return true, youth.name .. " deja la academia."
end

function SquadService.SetScouts(player, payload)
	local data = DataService.Get(player)
	local count = tonumber(type(payload) == "table" and payload.count)
	if not count or count ~= math.floor(count) or count < 0 or count > FootballConfig.MAX_SCOUTS then
		return false, "Número de ojeadores no válido."
	end
	data.academy.scouts = count
	if count > 0 and #data.academy.reports == 0 then
		data.academy.nextReport = data.stats.cycles + 1 -- primer informe en la próxima jornada
	end
	if count == 0 then
		data.academy.reports = {}
	end
	return true, count == 0 and "Has despedido a los ojeadores." or string.format("Ahora tienes %d ojeador(es).", count)
end

function SquadService.SignReport(player, payload)
	local data = DataService.Get(player)
	local candidate, index = findIn(data.academy.reports, type(payload) == "table" and payload.id)
	if not candidate then
		return false, "Ese informe ya no está disponible."
	end
	local level = academyLevel(data)
	if #data.academy.youths >= FootballConfig.Academy(level).capacity then
		return false, "La academia está llena. Mejora la Academia juvenil o haz sitio."
	end
	local fee = FootballFormulas.YouthSignFee(candidate.potential)
	local paid, err = EconomyService.Spend(player, fee, EconomyService.Category.ACADEMY, "Fichaje juvenil: " .. candidate.name)
	if not paid then
		return false, err
	end
	table.remove(data.academy.reports, index)
	table.insert(data.academy.youths, candidate)
	return true, string.format("🔎 %s se incorpora a la academia.", candidate.name)
end

-- ===== Evolución y temporadas =====

local function trainingMultiplier(data)
	local intensity = FootballConfig.Intensity(data.training.intensity)
	local trainingLevel = data.stadium.facilities.training or 0
	return intensity.growth * (1 + FootballConfig.TRAINING_FACILITY_BONUS * trainingLevel)
end

local function grow(player, multiplier)
	local delta = FootballFormulas.GrowthPerCycle(player, multiplier)
	FootballFormulas.ApplyGrowth(player, delta)
	local ovr = FootballFormulas.Overall(player)
	if ovr > (player.peak or 0) then
		player.peak = ovr
	end
end

local function legendCheck(data, p)
	local peak = math.floor((p.peak or 0) + 0.5)
	local apps = p.stats and p.stats.apps or 0
	local isLegend = peak >= FootballConfig.LEGEND_MIN_PEAK
		or (p.origin == "academy" and peak >= FootballConfig.LEGEND_MIN_ACADEMY_PEAK)
		or apps >= FootballConfig.LEGEND_MIN_APPS
	if isLegend then
		table.insert(data.legends, {
			name = p.name,
			pos = p.pos,
			peak = peak,
			origin = p.origin,
			seasons = math.max(1, data.season.number - (p.joinedSeason or data.season.number)),
			apps = apps,
			goals = p.stats and p.stats.goals or 0,
			assists = p.stats and p.stats.assists or 0,
			retiredSeason = data.season.number,
		})
		while #data.legends > 50 do
			table.remove(data.legends, 1)
		end
	end
	return isLegend
end

local function seasonEnd(data, messages)
	local finished = data.season.number
	data.season.number += 1
	data.season.cycle = 0

	-- Primer equipo: edad, contratos y retiradas
	local keep = {}
	for _, p in ipairs(data.squad) do
		p.seasonStats = { apps = 0, goals = 0, assists = 0 } -- nueva temporada
		p.age += 1
		p.contract -= 1
		local retireChance = (p.age - FootballConfig.RETIRE_MIN_AGE + 1) * FootballConfig.RETIRE_CHANCE_PER_YEAR
		if p.age >= FootballConfig.RETIRE_FORCED_AGE or (p.age >= FootballConfig.RETIRE_MIN_AGE and rng:NextNumber() < retireChance) then
			local legend = legendCheck(data, p)
			StadiumService.LogEvent(data, "player_retired", { name = p.name, age = p.age, peak = math.floor(p.peak + 0.5), legend = legend })
			table.insert(messages, string.format("👋 %s se retira con %d años%s.", p.name, p.age, legend and " y entra en las leyendas del club" or ""))
		elseif p.contract <= 0 and not p.loan then
			StadiumService.LogEvent(data, "player_left", { name = p.name, reason = "contract" })
			table.insert(messages, p.name .. " termina su contrato y deja el club.")
		else
			table.insert(keep, p)
		end
	end
	data.squad = keep

	-- Academia: edad y salidas
	local youths = {}
	for _, y in ipairs(data.academy.youths) do
		y.age += 1
		if y.age > FootballConfig.YOUTH_MAX_AGE then
			table.insert(messages, y.name .. " cumple " .. y.age .. " años y deja la academia sin debutar.")
		else
			table.insert(youths, y)
		end
	end
	data.academy.youths = youths

	-- Nueva hornada
	local level = academyLevel(data)
	local academy = FootballConfig.Academy(level)
	local free = academy.capacity - #data.academy.youths
	local intake = math.min(academy.intake, free)
	for _ = 1, intake do
		table.insert(data.academy.youths, PlayerFactory.Youth(data, level, data.academy.scouts))
	end
	if intake > 0 then
		table.insert(messages, string.format("🧬 Llega una nueva hornada a la cantera: %d juvenil(es).", intake))
	end
	if #data.squad < FootballConfig.MIN_SQUAD then
		-- Garantía de jugabilidad: se completan plazas con jugadores libres modestos.
		while #data.squad < FootballConfig.MIN_SQUAD do
			local positions = FootballConfig.Positions
			table.insert(data.squad, PlayerFactory.Create(data, {
				pos = positions[rng:NextInteger(1, #positions)].id,
				overall = rng:NextInteger(FootballConfig.STARTING_OVERALL.min, FootballConfig.STARTING_OVERALL.max),
				age = rng:NextInteger(20, 30),
				origin = "free",
			}))
		end
		table.insert(messages, "Se han incorporado jugadores libres para completar la plantilla mínima.")
	end
	StadiumService.LogEvent(data, "season_end", { season = finished })
	table.insert(messages, string.format("📅 Termina la temporada %d. ¡Empieza la temporada %d!", finished, data.season.number))
end

local function refreshReports(data)
	local academy = data.academy
	if academy.scouts <= 0 then
		academy.reports = {}
		return
	end
	if data.stats.cycles >= (academy.nextReport or 0) then
		academy.reports = {}
		for _ = 1, academy.scouts do
			local candidate = PlayerFactory.Youth(data, academyLevel(data), academy.scouts)
			table.insert(academy.reports, candidate)
		end
		academy.nextReport = data.stats.cycles + FootballConfig.SCOUT_REPORT_CYCLES
	end
end

-- Se llama después de cada jornada. Devuelve mensajes para el jugador.
function SquadService.AfterCycle(player)
	local data = DataService.Get(player)
	if not data then
		return {}
	end
	local messages = {}
	local multiplier = trainingMultiplier(data)
	for _, p in ipairs(data.squad) do
		grow(p, multiplier)
	end
	local youthMultiplier = FootballConfig.Academy(academyLevel(data)).growth * FootballConfig.Intensity(data.training.intensity).growth
		* UniverseConfig.Multiplier("youthGrowth") -- evento del universo
	for _, y in ipairs(data.academy.youths) do
		grow(y, youthMultiplier)
	end
	refreshReports(data)
	data.season.cycle += 1
	if data.season.cycle >= FootballConfig.SEASON_LENGTH then
		seasonEnd(data, messages)
	end
	return messages
end

-- ===== Estado para el cliente (sin el potencial exacto) =====

local function publicPlayer(p, scouts, multiplier)
	local low, high = FootballFormulas.PotentialRange(p, scouts)
	local attrs = {}
	for id, v in pairs(p.attrs) do
		attrs[id] = math.floor(v + 0.5)
	end
	return {
		id = p.id,
		name = p.name,
		age = p.age,
		pos = p.pos,
		attrs = attrs,
		ovr = FootballFormulas.OverallInt(p),
		potentialLow = low,
		potentialHigh = high,
		star = low >= FootballConfig.STAR_POTENTIAL,
		value = FootballFormulas.MarketValue(p),
		salary = p.salary,
		salaryDemand = FootballFormulas.SalaryDemand(p),
		contract = p.contract,
		releaseCost = FootballFormulas.ReleaseCost(p),
		focus = p.focus,
		origin = p.origin,
		fitness = math.floor((p.fitness or 100) + 0.5),
		loan = p.loan,
		listed = p.listed,
		injury = p.injury or 0,
		stats = p.stats,
		growth = math.floor(FootballFormulas.GrowthPerCycle(p, multiplier or 1) * FootballConfig.SEASON_LENGTH * 10 + 0.5) / 10, -- media prevista por temporada
		signFee = p.origin == "academy" and FootballFormulas.YouthSignFee(p.potential) or nil,
	}
end

function SquadService.PublicPlayer(p, scouts)
	return publicPlayer(p, scouts, 1)
end

function SquadService.BuildState(data)
	local scouts = data.academy.scouts
	local squad, youths, reports = {}, {}, {}
	local squadMultiplier = trainingMultiplier(data)
	local youthMultiplier = FootballConfig.Academy(academyLevel(data)).growth * FootballConfig.Intensity(data.training.intensity).growth
	for _, p in ipairs(data.squad) do
		table.insert(squad, publicPlayer(p, scouts, squadMultiplier))
	end
	for _, y in ipairs(data.academy.youths) do
		table.insert(youths, publicPlayer(y, scouts, youthMultiplier))
	end
	for _, r in ipairs(data.academy.reports) do
		table.insert(reports, publicPlayer(r, scouts, youthMultiplier))
	end
	local level = academyLevel(data)
	return {
		squad = squad,
		academy = {
			youths = youths,
			reports = reports,
			scouts = scouts,
			level = level,
			capacity = FootballConfig.Academy(level).capacity,
			intake = FootballConfig.Academy(level).intake,
			nextReportIn = math.max(0, (data.academy.nextReport or 0) - data.stats.cycles),
		},
		training = {
			intensity = data.training.intensity,
			multiplier = trainingMultiplier(data),
		},
		season = { number = data.season.number, cycle = data.season.cycle, length = FootballConfig.SEASON_LENGTH },
		legends = data.legends,
		graduates = data.stats.academyGraduates or 0,
	}
end

return SquadService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000002A"><Properties><string name="Name">StadiumRenderer</string><ProtectedString name="Source"><![CDATA[-- StadiumRenderer (ModuleScript)
-- Ubicación: ServerScriptService/Server/Services/StadiumRenderer
--
-- Construye el estadio físico a partir de los datos del club.
-- Optimización: cada grada es un bloque por fila (no un asiento por pieza),
-- las esquinas son 3 bloques escalonados, las instalaciones son volúmenes simples
-- y todo es Anchored. Un estadio legendario completo ronda las 300 piezas.
--
-- El plano (posiciones de todo) está en ReplicatedStorage/Shared/Modules/StadiumLayout.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local FacilityConfig = require(Shared.Config.FacilityConfig)
local CosmeticConfig = require(Shared.Config.CosmeticConfig)
local KitPattern = require(Shared.Modules.KitPattern)
local Layout = require(Shared.Modules.StadiumLayout)

local StadiumRenderer = {}

local PITCH_CENTER_Z = Layout.PITCH_CENTER_Z
local PITCH_LENGTH = Layout.PITCH_LENGTH
local PITCH_WIDTH = Layout.PITCH_WIDTH
local ROW_DEPTH = Layout.ROW_DEPTH
local ROW_STEP = Layout.ROW_STEP
local ROWS_BY_LEVEL = Layout.ROWS_BY_LEVEL

local GOLD = Color3.fromRGB(255, 200, 70)
local WHITE = Color3.fromRGB(245, 245, 245)

StadiumRenderer.SpawnOffset = CFrame.new(Layout.SPAWN)

-- ===== Utilidades de construcción =====

local function part(parent, origin, offset, size, color, material, props)
	local p = Instance.new("Part")
	p.Anchored = true
	p.Size = size
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.CFrame = origin * offset
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if props then
		for k, v in pairs(props) do
			p[k] = v
		end
	end
	p.Parent = parent
	return p
end

local function label(adornee, text, offsetY, color)
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(220, 46)
	gui.StudsOffset = Vector3.new(0, offsetY or 4, 0)
	gui.MaxDistance = 140
	gui.AlwaysOnTop = false
	gui.Adornee = adornee
	local t = Instance.new("TextLabel")
	t.Size = UDim2.fromScale(1, 1)
	t.BackgroundTransparency = 0.35
	t.BackgroundColor3 = Color3.fromRGB(15, 20, 30)
	t.TextColor3 = color or WHITE
	t.Font = Enum.Font.GothamBold
	t.TextScaled = true
	t.Text = text
	t.Parent = gui
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 8)
	corner.Parent = t
	gui.Parent = adornee
	return gui
end

local function surfaceText(partInstance, face, build)
	local gui = Instance.new("SurfaceGui")
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 20
	gui.LightInfluence = 0.2
	gui.Parent = partInstance
	build(gui)
	return gui
end

local function material(name, fallback)
	local ok, value = pcall(function()
		return Enum.Material[name]
	end)
	return ok and value or fallback
end

-- ===== Elementos del estadio =====

local function buildPitch(folder, origin, level)
	local greens = {
		Color3.fromRGB(96, 140, 64),
		Color3.fromRGB(78, 150, 62),
		Color3.fromRGB(62, 160, 62),
		Color3.fromRGB(52, 168, 64),
		Color3.fromRGB(44, 176, 70),
	}
	local base = greens[math.clamp(level, 1, #greens)]
	local c = CFrame.new(0, 0.1, PITCH_CENTER_Z)
	part(folder, origin, c, Vector3.new(PITCH_LENGTH + 8, 0.2, PITCH_WIDTH + 8), base, Enum.Material.Grass, { Name = "Pitch" })
	-- Franjas de corte a partir del nivel 3
	if level >= 3 then
		local stripe = base:Lerp(Color3.new(0, 0, 0), 0.12)
		for i = 0, 4 do
			local x = -PITCH_LENGTH / 2 + 10 + i * 20
			part(folder, origin, CFrame.new(x, 0.21, PITCH_CENTER_Z), Vector3.new(10, 0.02, PITCH_WIDTH), stripe, Enum.Material.Grass, { CanCollide = false })
		end
	end
	-- Líneas
	local y, w = 0.23, 0.5
	local lineProps = { CanCollide = false, Name = "Line" }
	local hl, hw = PITCH_LENGTH / 2, PITCH_WIDTH / 2
	part(folder, origin, CFrame.new(0, y, PITCH_CENTER_Z - hw), Vector3.new(PITCH_LENGTH, 0.02, w), WHITE, nil, lineProps)
	part(folder, origin, CFrame.new(0, y, PITCH_CENTER_Z + hw), Vector3.new(PITCH_LENGTH, 0.02, w), WHITE, nil, lineProps)
	part(folder, origin, CFrame.new(-hl, y, PITCH_CENTER_Z), Vector3.new(w, 0.02, PITCH_WIDTH), WHITE, nil, lineProps)
	part(folder, origin, CFrame.new(hl, y, PITCH_CENTER_Z), Vector3.new(w, 0.02, PITCH_WIDTH), WHITE, nil, lineProps)
	part(folder, origin, CFrame.new(0, y, PITCH_CENTER_Z), Vector3.new(w, 0.02, PITCH_WIDTH), WHITE, nil, lineProps)
	local circle = part(folder, origin, CFrame.new(0, y, PITCH_CENTER_Z) * CFrame.Angles(0, 0, math.rad(90)),
		Vector3.new(0.02, 18, 18), WHITE, nil, lineProps)
	circle.Shape = Enum.PartType.Cylinder
	part(folder, origin, CFrame.new(0, y + 0.01, PITCH_CENTER_Z) * CFrame.Angles(0, 0, math.rad(90)),
		Vector3.new(0.02, 17, 17), base, Enum.Material.Grass, lineProps).Shape = Enum.PartType.Cylinder
	-- Porterías
	for _, side in ipairs({ -1, 1 }) do
		local x = side * hl
		for _, dz in ipairs({ -6, 6 }) do
			part(folder, origin, CFrame.new(x, 3, PITCH_CENTER_Z + dz), Vector3.new(0.5, 6, 0.5), WHITE)
		end
		part(folder, origin, CFrame.new(x, 6, PITCH_CENTER_Z), Vector3.new(0.5, 0.5, 12.5), WHITE)
		part(folder, origin, CFrame.new(x + side * 2, 3, PITCH_CENTER_Z), Vector3.new(4, 6, 12), WHITE,
			Enum.Material.ForceField, { CanCollide = false, Transparency = 0.6 })
	end
end

-- side: "N", "S", "W", "E"
local function buildStandSide(folder, origin, side, rows, design, primary, secondary)
	local length = (side == "N" or side == "S") and PITCH_LENGTH or PITCH_WIDTH
	local mat = material(design.material, Enum.Material.Concrete)
	for r = 1, rows do
		local height = r * ROW_STEP
		local dist = 4 + (r - 0.5) * ROW_DEPTH
		local cf, size
		if side == "N" then
			cf = CFrame.new(0, height / 2, PITCH_CENTER_Z - PITCH_WIDTH / 2 - dist)
			size = Vector3.new(length, height, ROW_DEPTH)
		elseif side == "S" then
			cf = CFrame.new(0, height / 2, PITCH_CENTER_Z + PITCH_WIDTH / 2 + dist)
			size = Vector3.new(length, height, ROW_DEPTH)
		elseif side == "W" then
			cf = CFrame.new(-PITCH_LENGTH / 2 - dist, height / 2, PITCH_CENTER_Z)
			size = Vector3.new(ROW_DEPTH, height, length)
		else
			cf = CFrame.new(PITCH_LENGTH / 2 + dist, height / 2, PITCH_CENTER_Z)
			size = Vector3.new(ROW_DEPTH, height, length)
		end
		part(folder, origin, cf, size, (r % 2 == 0) and secondary or primary, mat, { Name = "StandRow" })
	end

	local backDist = 4 + rows * ROW_DEPTH
	local topY = rows * ROW_STEP
	-- Barandilla de neón (diseño Arena Futurista)
	if design.neon then
		local cf = (side == "N" and CFrame.new(0, 1, PITCH_CENTER_Z - PITCH_WIDTH / 2 - 3.6))
			or (side == "S" and CFrame.new(0, 1, PITCH_CENTER_Z + PITCH_WIDTH / 2 + 3.6))
			or (side == "W" and CFrame.new(-PITCH_LENGTH / 2 - 3.6, 1, PITCH_CENTER_Z))
			or CFrame.new(PITCH_LENGTH / 2 + 3.6, 1, PITCH_CENTER_Z)
		local size = (side == "N" or side == "S") and Vector3.new(length, 0.4, 0.4) or Vector3.new(0.4, 0.4, length)
		part(folder, origin, cf, size, secondary, Enum.Material.Neon, { CanCollide = false })
	end
	-- Cubierta
	if design.roof then
		local depth = rows * ROW_DEPTH + 2
		local mid = 4 + depth / 2
		local roofY = topY + 9
		local tilt = design.canopy and math.rad(8) or 0
		local cf, size
		if side == "N" then
			cf = CFrame.new(0, roofY, PITCH_CENTER_Z - PITCH_WIDTH / 2 - mid) * CFrame.Angles(-tilt, 0, 0)
			size = Vector3.new(length + 2, 0.6, depth)
		elseif side == "S" then
			cf = CFrame.new(0, roofY, PITCH_CENTER_Z + PITCH_WIDTH / 2 + mid) * CFrame.Angles(tilt, 0, 0)
			size = Vector3.new(length + 2, 0.6, depth)
		elseif side == "W" then
			cf = CFrame.new(-PITCH_LENGTH / 2 - mid, roofY, PITCH_CENTER_Z) * CFrame.Angles(0, 0, tilt)
			size = Vector3.new(depth, 0.6, length + 2)
		else
			cf = CFrame.new(PITCH_LENGTH / 2 + mid, roofY, PITCH_CENTER_Z) * CFrame.Angles(0, 0, -tilt)
			size = Vector3.new(depth, 0.6, length + 2)
		end
		local roofMat = design.canopy and Enum.Material.Metal or Enum.Material.SmoothPlastic
		part(folder, origin, cf, size, Color3.fromRGB(230, 232, 236), roofMat,
			{ Name = "StandRoof", Transparency = design.material == "Glass" and 0.35 or 0 })
		-- Pilares en la parte trasera
		for _, t in ipairs({ -0.45, 0.45 }) do
			local px, pz
			if side == "N" or side == "S" then
				px = t * length
				pz = PITCH_CENTER_Z + (side == "N" and -1 or 1) * (PITCH_WIDTH / 2 + backDist + 0.5)
			else
				pz = PITCH_CENTER_Z + t * length
				px = (side == "W" and -1 or 1) * (PITCH_LENGTH / 2 + backDist + 0.5)
			end
			part(folder, origin, CFrame.new(px, roofY / 2, pz), Vector3.new(1, roofY, 1), Color3.fromRGB(70, 75, 85), Enum.Material.Metal)
		end
	end
end

local function buildStands(folder, origin, level, design, primary, secondary)
	if level < 1 then
		return
	end
	local rows = ROWS_BY_LEVEL[math.clamp(level, 1, #ROWS_BY_LEVEL)]
	local sides = { "N" }
	if level >= 2 then
		sides = { "N", "S" }
	end
	if level >= 3 then
		sides = { "N", "S", "W", "E" }
	end
	for _, side in ipairs(sides) do
		buildStandSide(folder, origin, side, rows, design, primary, secondary)
	end
end

local function buildLighting(folder, origin, level, vip)
	if level < 1 then
		return
	end
	-- Torres en las esquinas exteriores del estadio (fuera de gradas y esquinas)
	local positions = { Vector3.new(-100, 0, -97), Vector3.new(100, 0, -97) }
	if level >= 2 then
		table.insert(positions, Vector3.new(-100, 0, 72))
		table.insert(positions, Vector3.new(100, 0, 72))
	end
	local height = 26 + level * 5
	-- VIP Club: iluminación dorada (ventaja visual, sin efecto económico)
	local lightColor = vip and Color3.fromRGB(255, 214, 130) or Color3.fromRGB(255, 252, 240)
	for _, pos in ipairs(positions) do
		part(folder, origin, CFrame.new(pos.X, height / 2, pos.Z), Vector3.new(1.4, height, 1.4), Color3.fromRGB(90, 95, 105), Enum.Material.Metal)
		local worldHead = (origin * CFrame.new(pos.X, height + 1.5, pos.Z)).Position
		local target = (origin * CFrame.new(0, 0, PITCH_CENTER_Z)).Position
		local head = Instance.new("Part")
		head.Anchored = true
		head.Size = Vector3.new(6, 3, 1)
		head.CFrame = CFrame.lookAt(worldHead, target)
		head.Material = Enum.Material.Neon
		head.Color = lightColor
		head.Parent = folder
		local spot = Instance.new("SpotLight")
		spot.Face = Enum.NormalId.Front
		spot.Angle = 90
		spot.Brightness = 1.5 + level
		spot.Range = 60
		spot.Color = lightColor
		spot.Parent = head
	end
end

local function buildScoreboard(folder, origin, level, info)
	if level < 1 then
		return
	end
	local width, height = 14 + level * 4, 7 + level * 2
	-- Detrás de la grada norte, por encima de su cubierta
	local baseY = 32
	local z = -100
	local pos = Vector3.new(0, baseY + height / 2, z)
	for _, dx in ipairs({ -width / 3, width / 3 }) do
		part(folder, origin, CFrame.new(dx, baseY / 2, z), Vector3.new(1, baseY, 1), Color3.fromRGB(60, 60, 70), Enum.Material.Metal)
	end
	local worldPos = (origin * CFrame.new(pos)).Position
	local target = (origin * CFrame.new(0, pos.Y, PITCH_CENTER_Z)).Position
	local board = Instance.new("Part")
	board.Name = "Scoreboard"
	board.Anchored = true
	board.Size = Vector3.new(width, height, 1)
	board.CFrame = CFrame.lookAt(worldPos, target)
	board.Color = Color3.fromRGB(15, 15, 20)
	board.Parent = folder
	surfaceText(board, Enum.NormalId.Front, function(gui)
		local bg = Instance.new("Frame")
		bg.Size = UDim2.fromScale(1, 1)
		bg.BackgroundColor3 = Color3.fromRGB(8, 10, 16)
		bg.Parent = gui
		local top = Instance.new("TextLabel")
		top.Size = UDim2.fromScale(1, 0.3)
		top.BackgroundTransparency = 1
		top.Font = Enum.Font.GothamBlack
		top.TextScaled = true
		top.TextColor3 = info.secondaryText
		top.Text = info.crestSymbol .. "  " .. info.clubName
		top.Parent = bg
		local score = Instance.new("TextLabel")
		score.Position = UDim2.fromScale(0, 0.3)
		score.Size = UDim2.fromScale(1, 0.5)
		score.BackgroundTransparency = 1
		score.Font = Enum.Font.Code
		score.TextScaled = true
		score.TextColor3 = Color3.fromRGB(255, 190, 40)
		local last = info.lastMatch
		if last then
			score.Text = last.home and string.format("%s  %d - %d  %s", info.shortName, last.gf, last.ga, last.short)
				or string.format("%s  %d - %d  %s", last.short, last.ga, last.gf, info.shortName)
		else
			score.Text = info.shortName .. "  0 - 0  ---"
		end
		score.Parent = bg
		local bottom = Instance.new("TextLabel")
		bottom.Position = UDim2.fromScale(0, 0.8)
		bottom.Size = UDim2.fromScale(1, 0.2)
		bottom.BackgroundTransparency = 1
		bottom.Font = Enum.Font.Gotham
		bottom.TextScaled = true
		bottom.TextColor3 = Color3.fromRGB(180, 190, 200)
		bottom.Text = last and string.format("Último partido · %s · Temporada %d", last.competition or "", last.season or 1) or "Sin partidos todavía"
		bottom.Parent = bg
	end)
end

-- facilityId: se guarda como atributo "Facility" para que InteractionService le añada interacción.
local function buildBuilding(folder, origin, pos, level, design, primary, secondary, title, facilityId)
	if level < 1 then
		return
	end
	local size = Vector3.new(12 + level * 3, 7 + level * 1.5, 10 + level * 2)
	local isNeon = design.material == "Neon"
	local bodyMat = isNeon and Enum.Material.SmoothPlastic or material(design.material, Enum.Material.Brick)
	local bodyColor = (design.material == "Glass") and Color3.fromRGB(170, 210, 230)
		or (design.material == "DiamondPlate" and Color3.fromRGB(150, 155, 165))
		or (isNeon and Color3.fromRGB(30, 30, 40))
		or Color3.fromRGB(170, 95, 70)
	local body = part(folder, origin, CFrame.new(pos.X, size.Y / 2, pos.Z), size, bodyColor, bodyMat,
		{ Transparency = design.material == "Glass" and 0.25 or 0 })
	part(folder, origin, CFrame.new(pos.X, size.Y + 0.5, pos.Z), Vector3.new(size.X + 1, 1, size.Z + 1),
		isNeon and secondary or primary, isNeon and Enum.Material.Neon or Enum.Material.SmoothPlastic)
	label(body, string.format("%s · Nv %d", title, level), size.Y / 2 + 3)
	if facilityId then
		body:SetAttribute("Facility", facilityId)
	end
	return body, size
end

-- Campo de entrenamiento pequeño (centro de entrenamiento y academia)
local function miniPitch(folder, origin, pos, length, width, withGoals)
	part(folder, origin, CFrame.new(pos.X, 0.1, pos.Z), Vector3.new(length, 0.2, width), Color3.fromRGB(60, 160, 65), Enum.Material.Grass)
	part(folder, origin, CFrame.new(pos.X, 0.22, pos.Z), Vector3.new(0.4, 0.02, width), WHITE, nil, { CanCollide = false })
	if withGoals then
		for _, side in ipairs({ -1, 1 }) do
			local x = pos.X + side * length / 2
			for _, dz in ipairs({ -3, 3 }) do
				part(folder, origin, CFrame.new(x, 1.5, pos.Z + dz), Vector3.new(0.3, 3, 0.3), WHITE)
			end
			part(folder, origin, CFrame.new(x, 3, pos.Z), Vector3.new(0.3, 0.3, 6.3), WHITE)
		end
	end
end

local GLASS_DESIGN = { material = "Glass" }

local function buildLaneFacilities(folder, origin, facilities, design, info)
	local F = Layout.Facilities
	local function title(id)
		local def = FacilityConfig.Get(id)
		return def.icon .. " " .. def.name
	end
	buildBuilding(folder, origin, F.lockers, facilities.lockers or 0, design, info.primary, info.secondary, title("lockers"), "lockers")
	buildBuilding(folder, origin, F.shop, facilities.shop or 0, design, info.primary, info.secondary, title("shop"), "shop")
	buildBuilding(folder, origin, F.restaurant, facilities.restaurant or 0, design, info.primary, info.secondary, title("restaurant"), "restaurant")

	-- Zona VIP: pabellón de cristal con remate dorado
	local vipLevel = facilities.vip or 0
	if vipLevel > 0 then
		local body, size = buildBuilding(folder, origin, F.vip, vipLevel, GLASS_DESIGN, info.primary, info.secondary, title("vip"), "vip")
		part(folder, origin, CFrame.new(F.vip.X, size.Y + 1.2, F.vip.Z), Vector3.new(size.X + 1.4, 0.4, size.Z + 1.4), GOLD, Enum.Material.Neon, { CanCollide = false })
		body.Color = Color3.fromRGB(190, 220, 240)
	end

	-- Centro de entrenamiento: edificio + campo de entrenamiento
	local trainingLevel = facilities.training or 0
	if trainingLevel > 0 then
		buildBuilding(folder, origin, F.training + Vector3.new(0, 0, 12), trainingLevel, design, info.primary, info.secondary, title("training"), "training")
		miniPitch(folder, origin, F.training + Vector3.new(0, 0, -18), 20 + trainingLevel * 3, 14, trainingLevel >= 2)
	end

	-- Academia juvenil: edificio + campo pequeño
	local academyLevel = facilities.academy or 0
	if academyLevel > 0 then
		buildBuilding(folder, origin, F.academy + Vector3.new(0, 0, -6), academyLevel, design, info.primary, info.secondary, title("academy"), "academy")
		miniPitch(folder, origin, F.academy + Vector3.new(0, 0, 12), 18 + academyLevel * 2, 8, academyLevel >= 2)
	end

	-- Sala de trofeos: edificio con copa y contador REAL de títulos
	local trophyLevel = facilities.trophyRoom or 0
	if trophyLevel > 0 then
		local _, size = buildBuilding(folder, origin, F.trophyRoom, trophyLevel, design, info.primary, info.secondary, title("trophyRoom"), "trophyRoom")
		local cup = part(folder, origin, CFrame.new(F.trophyRoom.X, size.Y + 3, F.trophyRoom.Z) * CFrame.Angles(0, 0, math.rad(90)),
			Vector3.new(4, 3, 3), GOLD, Enum.Material.Metal, { Reflectance = 0.3 })
		cup.Shape = Enum.PartType.Cylinder
		label(cup, string.format("🏆 Títulos: %d", info.trophyCount or 0), 4, GOLD).MaxDistance = 90
		-- Vitrina física: una copa por título real (las 12 más recientes) y una placa con la lista
		local trophies = info.trophies or {}
		local shelfX = F.trophyRoom.X + size.X / 2 + 4
		part(folder, origin, CFrame.new(shelfX, 1, F.trophyRoom.Z), Vector3.new(3, 2, 26), Color3.fromRGB(60, 40, 25), Enum.Material.Wood)
		local shown = 0
		for i = #trophies, math.max(1, #trophies - 11), -1 do
			local t = trophies[i]
			shown += 1
			local z = F.trophyRoom.Z - 12 + (shown - 1) * 2.2
			local trophyCup = part(folder, origin, CFrame.new(shelfX, 3, z) * CFrame.Angles(0, 0, math.rad(90)),
				Vector3.new(2, 1.2, 1.2), t.kind == "cup" and Color3.fromRGB(220, 220, 230) or GOLD, Enum.Material.Metal, { Reflectance = 0.3 })
			trophyCup.Shape = Enum.PartType.Cylinder
		end
		local plaque = part(folder, origin, CFrame.new(shelfX + 1.6, 5, F.trophyRoom.Z) * CFrame.Angles(0, math.rad(90), 0),
			Vector3.new(26, 4, 0.3), Color3.fromRGB(30, 25, 15), Enum.Material.Wood)
		local lines = {}
		for i = #trophies, math.max(1, #trophies - 5), -1 do
			table.insert(lines, string.format("%s %s (T%d)", trophies[i].kind == "cup" and "🥇" or "🏆", trophies[i].name, trophies[i].season))
		end
		local function plaqueText(gui)
			local t = Instance.new("TextLabel")
			t.Size = UDim2.fromScale(1, 1)
			t.BackgroundTransparency = 1
			t.TextColor3 = GOLD
			t.Font = Enum.Font.GothamBold
			t.TextScaled = true
			t.Text = #lines > 0 and table.concat(lines, "   ·   ") or "La vitrina espera su primer título"
			t.Parent = gui
		end
		surfaceText(plaque, Enum.NormalId.Front, plaqueText)
		surfaceText(plaque, Enum.NormalId.Back, plaqueText)
	end
end

local function buildSign(folder, origin, info)
	for _, x in ipairs({ -12, 12 }) do
		part(folder, origin, CFrame.new(x, 4, Layout.SIGN.Z), Vector3.new(1, 8, 1), info.vip and GOLD or Color3.fromRGB(60, 60, 70), Enum.Material.Metal)
	end
	local board = part(folder, origin, CFrame.new(0, 11, Layout.SIGN.Z), Vector3.new(26, 10, 1), info.primary, Enum.Material.SmoothPlastic, { Name = "ClubSign" })
	board:SetAttribute("Facility", "sign")
	local function content(gui)
		local frame = Instance.new("Frame")
		frame.Size = UDim2.fromScale(1, 1)
		frame.BackgroundColor3 = Color3.fromRGB(12, 18, 32)
		frame.Parent = gui
		local stroke = Instance.new("UIStroke")
		stroke.Thickness = 10
		stroke.Color = info.vip and GOLD or info.primary
		stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		stroke.Parent = frame
		local crest = Instance.new("TextLabel")
		crest.Size = UDim2.fromScale(0.25, 0.7)
		crest.Position = UDim2.fromScale(0.02, 0.15)
		crest.BackgroundTransparency = 1
		crest.TextScaled = true
		crest.Text = info.crestSymbol
		crest.Parent = frame
		local name = Instance.new("TextLabel")
		name.Size = UDim2.fromScale(0.7, 0.38)
		name.Position = UDim2.fromScale(0.28, 0.1)
		name.BackgroundTransparency = 1
		name.Font = Enum.Font.GothamBlack
		name.TextScaled = true
		name.TextXAlignment = Enum.TextXAlignment.Left
		name.TextColor3 = WHITE
		name.Text = info.clubName
		name.Parent = frame
		local sub = Instance.new("TextLabel")
		sub.Size = UDim2.fromScale(0.7, 0.2)
		sub.Position = UDim2.fromScale(0.28, 0.5)
		sub.BackgroundTransparency = 1
		sub.Font = Enum.Font.Gotham
		sub.TextScaled = true
		sub.TextXAlignment = Enum.TextXAlignment.Left
		sub.TextColor3 = Color3.fromRGB(190, 200, 215)
		local naming = info.sponsors and info.sponsors.naming
		sub.Text = (naming and ("🏟️ Estadio " .. naming .. " · ") or "") .. "Presidente: " .. info.ownerName .. " · " .. info.stageName
		sub.Parent = frame
		if info.vip then
			local tag = Instance.new("TextLabel")
			tag.Size = UDim2.fromScale(0.3, 0.2)
			tag.Position = UDim2.fromScale(0.28, 0.74)
			tag.BackgroundColor3 = GOLD
			tag.Font = Enum.Font.GothamBlack
			tag.TextScaled = true
			tag.TextColor3 = Color3.fromRGB(30, 20, 0)
			tag.Text = "👑 VIP CLUB"
			tag.Parent = frame
			local corner = Instance.new("UICorner")
			corner.CornerRadius = UDim.new(0.3, 0)
			corner.Parent = tag
		end
	end
	surfaceText(board, Enum.NormalId.Front, content)
	surfaceText(board, Enum.NormalId.Back, content)

	-- Expositor de equipación
	part(folder, origin, CFrame.new(Layout.KIT_DISPLAY.X, 3, Layout.KIT_DISPLAY.Z), Vector3.new(0.6, 6, 0.6), Color3.fromRGB(60, 60, 70), Enum.Material.Metal)
	local kitBoard = part(folder, origin, CFrame.new(Layout.KIT_DISPLAY.X, 8, Layout.KIT_DISPLAY.Z), Vector3.new(5, 5, 0.4), info.primary)
	local function kit(gui)
		local holder = Instance.new("Frame")
		holder.Size = UDim2.fromScale(1, 1)
		holder.BorderSizePixel = 0
		holder.Parent = gui
		KitPattern.Build(holder, info.kitPattern, info.primary, info.secondary)
		local shirtSponsor = info.sponsors and info.sponsors.shirt
		if shirtSponsor then
			local t = Instance.new("TextLabel")
			t.Name = "KitPart"
			t.BackgroundTransparency = 1
			t.Position = UDim2.fromScale(0.1, 0.35)
			t.Size = UDim2.fromScale(0.8, 0.25)
			t.Font = Enum.Font.GothamBlack
			t.TextScaled = true
			t.TextColor3 = info.secondaryText
			t.TextStrokeTransparency = 0.5
			t.Text = string.upper(shirtSponsor)
			t.ZIndex = 5
			t.Parent = holder
		end
	end
	surfaceText(kitBoard, Enum.NormalId.Front, kit)
	surfaceText(kitBoard, Enum.NormalId.Back, kit)
end

local function buildEffect(folder, origin, effectId, primary, secondary)
	if effectId == "none" then
		return
	end
	local emitterPart = part(folder, origin, CFrame.new(0, 28, PITCH_CENTER_Z), Vector3.new(PITCH_LENGTH, 1, PITCH_WIDTH),
		WHITE, nil, { Transparency = 1, CanCollide = false, CanQuery = false, CanTouch = false, Name = "EffectEmitter" })
	local e = Instance.new("ParticleEmitter")
	e.Shape = Enum.ParticleEmitterShape.Box
	e.EmissionDirection = Enum.NormalId.Bottom
	if effectId == "confetti" then
		e.Color = ColorSequence.new(primary, secondary)
		e.Size = NumberSequence.new(0.4)
		e.Rate = 25
		e.Lifetime = NumberRange.new(6, 8)
		e.Speed = NumberRange.new(2, 4)
		e.RotSpeed = NumberRange.new(-180, 180)
		e.Acceleration = Vector3.new(0, -2, 0)
	elseif effectId == "sparkles" then
		e.Color = ColorSequence.new(WHITE, secondary)
		e.LightEmission = 1
		e.Size = NumberSequence.new(0.6, 0)
		e.Rate = 30
		e.Lifetime = NumberRange.new(2, 3)
		e.Speed = NumberRange.new(1, 3)
	elseif effectId == "smoke" then
		emitterPart.CFrame = origin * CFrame.new(0, 2, PITCH_CENTER_Z)
		e.EmissionDirection = Enum.NormalId.Top
		e.Color = ColorSequence.new(primary, secondary)
		e.Size = NumberSequence.new(3, 8)
		e.Transparency = NumberSequence.new(0.5, 1)
		e.Rate = 6
		e.Lifetime = NumberRange.new(4, 6)
		e.Speed = NumberRange.new(2, 4)
	elseif effectId == "bats" then
		e.Color = ColorSequence.new(Color3.fromRGB(40, 20, 50), Color3.fromRGB(10, 10, 10))
		e.Size = NumberSequence.new(1.2, 0.6)
		e.Rate = 12
		e.Lifetime = NumberRange.new(4, 6)
		e.Speed = NumberRange.new(6, 10)
		e.SpreadAngle = Vector2.new(60, 60)
		e.RotSpeed = NumberRange.new(-90, 90)
	elseif effectId == "vip_gold" then
		e.Color = ColorSequence.new(GOLD)
		e.LightEmission = 1
		e.Size = NumberSequence.new(0.5, 0)
		e.Rate = 35
		e.Lifetime = NumberRange.new(3, 4)
		e.Speed = NumberRange.new(1, 2)
	end
	e.Parent = emitterPart
end

-- ===== Decoraciones =====

local DecorationBuilders = {}

DecorationBuilders.flags = function(f, o, p, info)
	for i, dx in ipairs({ -3, 3 }) do
		part(f, o, CFrame.new(p.X + dx, 6, p.Z), Vector3.new(0.4, 12, 0.4), Color3.fromRGB(200, 200, 205), Enum.Material.Metal)
		part(f, o, CFrame.new(p.X + dx + 1.6, 10.5, p.Z), Vector3.new(3, 2, 0.1), i == 1 and info.primary or info.secondary, Enum.Material.Fabric)
	end
end
DecorationBuilders.planters = function(f, o, p)
	part(f, o, CFrame.new(p.X, 1, p.Z), Vector3.new(6, 2, 3), Color3.fromRGB(120, 80, 60), Enum.Material.Wood)
	local bush = part(f, o, CFrame.new(p.X, 3, p.Z), Vector3.new(5, 3, 3), Color3.fromRGB(50, 130, 50), Enum.Material.Grass)
	bush.Shape = Enum.PartType.Ball
end
DecorationBuilders.bench = function(f, o, p, info)
	part(f, o, CFrame.new(p.X, 1.4, p.Z), Vector3.new(7, 0.4, 2), info.primary, Enum.Material.Wood)
	part(f, o, CFrame.new(p.X, 2.6, p.Z + 0.9), Vector3.new(7, 2, 0.3), info.secondary, Enum.Material.Wood)
	part(f, o, CFrame.new(p.X, 0.6, p.Z), Vector3.new(6, 1.2, 1), Color3.fromRGB(70, 70, 75), Enum.Material.Metal)
end
DecorationBuilders.ball_statue = function(f, o, p)
	part(f, o, CFrame.new(p.X, 1.5, p.Z), Vector3.new(5, 3, 5), Color3.fromRGB(150, 150, 155), Enum.Material.Marble)
	local ball = part(f, o, CFrame.new(p.X, 5.5, p.Z), Vector3.new(5, 5, 5), WHITE, Enum.Material.SmoothPlastic)
	ball.Shape = Enum.PartType.Ball
end
DecorationBuilders.pro_arch = function(f, o, p, info)
	for _, dx in ipairs({ -4.5, 4.5 }) do
		part(f, o, CFrame.new(p.X + dx, 6, p.Z), Vector3.new(1.5, 12, 1.5), info.primary, Enum.Material.Metal)
	end
	part(f, o, CFrame.new(p.X, 12.5, p.Z), Vector3.new(11, 1.5, 1.5), info.secondary, Enum.Material.Metal)
	part(f, o, CFrame.new(p.X, 11.5, p.Z), Vector3.new(9, 0.3, 0.3), info.secondary, Enum.Material.Neon, { CanCollide = false })
end
DecorationBuilders.pro_fountain = function(f, o, p)
	local basin = part(f, o, CFrame.new(p.X, 0.8, p.Z) * CFrame.Angles(0, 0, math.rad(90)), Vector3.new(1.6, 9, 9), Color3.fromRGB(200, 200, 205), Enum.Material.Marble)
	basin.Shape = Enum.PartType.Cylinder
	local water = part(f, o, CFrame.new(p.X, 1.4, p.Z) * CFrame.Angles(0, 0, math.rad(90)), Vector3.new(0.4, 8, 8), Color3.fromRGB(80, 160, 230), Enum.Material.Glass, { Transparency = 0.3, CanCollide = false })
	water.Shape = Enum.PartType.Cylinder
	part(f, o, CFrame.new(p.X, 3, p.Z), Vector3.new(1.2, 4, 1.2), Color3.fromRGB(200, 200, 205), Enum.Material.Marble)
	local spray = Instance.new("ParticleEmitter")
	spray.Color = ColorSequence.new(Color3.fromRGB(170, 220, 255))
	spray.Size = NumberSequence.new(0.4, 0.1)
	spray.Rate = 20
	spray.Speed = NumberRange.new(5, 7)
	spray.Acceleration = Vector3.new(0, -12, 0)
	spray.SpreadAngle = Vector2.new(15, 15)
	spray.Lifetime = NumberRange.new(1, 1.2)
	spray.Parent = water
end
DecorationBuilders.pro_screen = function(f, o, p, info)
	part(f, o, CFrame.new(p.X, 4, p.Z), Vector3.new(1, 8, 1), Color3.fromRGB(60, 60, 70), Enum.Material.Metal)
	local screen = part(f, o, CFrame.new(p.X, 10, p.Z), Vector3.new(10, 5.5, 0.6), Color3.fromRGB(10, 10, 15))
	local function content(gui)
		local t = Instance.new("TextLabel")
		t.Size = UDim2.fromScale(1, 1)
		t.BackgroundColor3 = info.primary
		t.TextColor3 = info.secondaryText
		t.Font = Enum.Font.GothamBlack
		t.TextScaled = true
		t.Text = info.crestSymbol .. " " .. info.shortName
		t.Parent = gui
	end
	surfaceText(screen, Enum.NormalId.Front, content)
	surfaceText(screen, Enum.NormalId.Back, content)
end
DecorationBuilders.cos_banner = function(f, o, p, info)
	for _, dx in ipairs({ -4.5, 4.5 }) do
		part(f, o, CFrame.new(p.X + dx, 5, p.Z), Vector3.new(0.5, 10, 0.5), Color3.fromRGB(200, 200, 205), Enum.Material.Metal)
	end
	local banner = part(f, o, CFrame.new(p.X, 7, p.Z), Vector3.new(9, 4, 0.1), info.primary, Enum.Material.Fabric)
	local function content(gui)
		local t = Instance.new("TextLabel")
		t.Size = UDim2.fromScale(1, 1)
		t.BackgroundColor3 = info.primary
		t.TextColor3 = info.secondaryText
		t.Font = Enum.Font.GothamBlack
		t.TextScaled = true
		t.Text = "¡VAMOS " .. string.upper(info.shortName) .. "!"
		t.Parent = gui
	end
	surfaceText(banner, Enum.NormalId.Front, content)
	surfaceText(banner, Enum.NormalId.Back, content)
end
DecorationBuilders.cos_fireworks = function(f, o, p, info)
	local tower = part(f, o, CFrame.new(p.X, 3, p.Z), Vector3.new(2, 6, 2), Color3.fromRGB(40, 40, 50), Enum.Material.Metal)
	local fx = Instance.new("ParticleEmitter")
	fx.EmissionDirection = Enum.NormalId.Top
	fx.Color = ColorSequence.new(info.primary, info.secondary)
	fx.LightEmission = 1
	fx.Size = NumberSequence.new(0.6, 0)
	fx.Rate = 15
	fx.Speed = NumberRange.new(20, 28)
	fx.SpreadAngle = Vector2.new(10, 10)
	fx.Acceleration = Vector3.new(0, -10, 0)
	fx.Lifetime = NumberRange.new(2, 2.5)
	fx.Parent = tower
end
DecorationBuilders.vip_carpet = function(f, o, p)
	part(f, o, CFrame.new(p.X, 0.1, p.Z), Vector3.new(4, 0.2, 12), Color3.fromRGB(170, 15, 30), Enum.Material.Fabric, { CanCollide = false })
	for _, dz in ipairs({ -5, 0, 5 }) do
		for _, dx in ipairs({ -2.6, 2.6 }) do
			part(f, o, CFrame.new(p.X + dx, 1.2, p.Z + dz), Vector3.new(0.4, 2.4, 0.4), GOLD, Enum.Material.Metal)
		end
	end
end
DecorationBuilders.vip_statue = function(f, o, p)
	part(f, o, CFrame.new(p.X, 1.5, p.Z), Vector3.new(4, 3, 4), Color3.fromRGB(30, 30, 35), Enum.Material.Marble)
	part(f, o, CFrame.new(p.X, 6, p.Z), Vector3.new(2, 6, 1.2), GOLD, Enum.Material.Metal, { Reflectance = 0.3 })
	local head = part(f, o, CFrame.new(p.X, 9.8, p.Z), Vector3.new(1.6, 1.6, 1.6), GOLD, Enum.Material.Metal, { Reflectance = 0.3 })
	head.Shape = Enum.PartType.Ball
	local sparkle = Instance.new("Sparkles")
	sparkle.SparkleColor = GOLD
	sparkle.Parent = head
end

-- Decoraciones en posición libre: cada una se construye en su propio marco local
-- (posición + rotación), así los constructores no necesitan saber de rotaciones.
DecorationBuilders.pumpkin_giant = function(f, o, p)
	local body = part(f, o, CFrame.new(p.X, 2.6, p.Z), Vector3.new(6, 5, 6), Color3.fromRGB(240, 120, 20), Enum.Material.SmoothPlastic)
	body.Shape = Enum.PartType.Ball
	part(f, o, CFrame.new(p.X, 5.6, p.Z), Vector3.new(0.8, 1.4, 0.8), Color3.fromRGB(60, 120, 40), Enum.Material.Wood)
	local glow = Instance.new("PointLight")
	glow.Color = Color3.fromRGB(255, 150, 50)
	glow.Brightness = 2
	glow.Range = 14
	glow.Parent = body
	-- Cara iluminada
	for _, dx in ipairs({ -1.2, 1.2 }) do
		part(f, o, CFrame.new(p.X + dx, 3.4, p.Z - 2.7), Vector3.new(0.9, 0.9, 0.3), Color3.fromRGB(255, 220, 90), Enum.Material.Neon, { CanCollide = false })
	end
	part(f, o, CFrame.new(p.X, 2, p.Z - 2.7), Vector3.new(2.6, 0.6, 0.3), Color3.fromRGB(255, 220, 90), Enum.Material.Neon, { CanCollide = false })
end

local function buildDecorations(folder, origin, decorations, visibleFlags, info)
	for index, entry in ipairs(decorations) do
		local builder = DecorationBuilders[entry.id]
		if builder and visibleFlags[index] then
			local sub = Instance.new("Folder")
			sub.Name = "Decoration_" .. index
			sub.Parent = folder
			local frame = origin * CFrame.new(entry.x, 0, entry.z) * CFrame.Angles(0, math.rad(entry.r or 0), 0)
			builder(sub, frame, Vector3.zero, info)
		end
	end
end

-- ===== Comercial y patrocinio (FASE 3) =====

-- Vallas publicitarias alrededor del campo: muestran el patrocinador de vallas real.
local function buildAdBoards(folder, origin, info)
	local brand = info.sponsors and info.sponsors.boards
	local text = brand and string.upper(brand) or "¡ANÚNCIATE AQUÍ!"
	for _, sz in ipairs({ -1, 1 }) do
		for _, x in ipairs({ -25, 25 }) do
			local z = PITCH_CENTER_Z + sz * (PITCH_WIDTH / 2 + 2.5)
			local board = part(folder, origin, CFrame.new(x, 0.8, z), Vector3.new(40, 1.6, 0.4), Color3.fromRGB(15, 15, 20),
				Enum.Material.SmoothPlastic, { Name = "AdBoard" })
			local function content(gui)
				local t = Instance.new("TextLabel")
				t.Size = UDim2.fromScale(1, 1)
				t.BackgroundColor3 = brand and info.primary or Color3.fromRGB(30, 30, 40)
				t.TextColor3 = brand and info.secondaryText or Color3.fromRGB(200, 200, 210)
				t.Font = Enum.Font.GothamBlack
				t.TextScaled = true
				t.Text = text
				t.Parent = gui
			end
			surfaceText(board, Enum.NormalId.Front, content)
			surfaceText(board, Enum.NormalId.Back, content)
		end
	end
end

local function buildKiosks(folder, origin, level, info)
	if level < 1 then
		return
	end
	local xs = { -60, 60 }
	if level >= 2 then
		table.insert(xs, -80)
		table.insert(xs, 80)
	end
	if level >= 3 then
		table.insert(xs, -40)
		table.insert(xs, 40)
	end
	for i, x in ipairs(xs) do
		local counter = part(folder, origin, CFrame.new(x, 1.5, 72), Vector3.new(5, 3, 3), Color3.fromRGB(200, 170, 120), Enum.Material.WoodPlanks)
		part(folder, origin, CFrame.new(x, 4.2, 72), Vector3.new(6, 0.4, 4), info.primary, Enum.Material.Fabric)
		if i == 1 then
			label(counter, string.format("🌭 Quioscos · Nv %d", level), 4).MaxDistance = 80
		end
		counter:SetAttribute("Facility", "kiosks")
	end
end

local function buildTourBooth(folder, origin, level, info)
	if level < 1 then
		return
	end
	local booth = part(folder, origin, CFrame.new(20, 2.5, 72), Vector3.new(6, 5, 3), Color3.fromRGB(240, 240, 235), Enum.Material.SmoothPlastic)
	part(folder, origin, CFrame.new(20, 5.3, 72), Vector3.new(7, 0.6, 4), info.secondary, Enum.Material.SmoothPlastic)
	label(booth, string.format("🗺️ Tour del estadio · Nv %d", level), 4).MaxDistance = 80
	booth:SetAttribute("Facility", "tour")
end

-- Afición en las gradas (se dibuja en una carpeta aparte y solo cuando cambia la ocupación).
function StadiumRenderer.RenderCrowd(folder, origin, standsLevel, occupancy, info)
	folder:ClearAllChildren()
	if standsLevel < 1 or occupancy <= 0 then
		return
	end
	local rows = ROWS_BY_LEVEL[math.clamp(standsLevel, 1, #ROWS_BY_LEVEL)]
	local filled = math.clamp(math.floor(rows * occupancy + 0.5), 1, rows)
	local sides = { "N" }
	if standsLevel >= 2 then
		sides = { "N", "S" }
	end
	if standsLevel >= 3 then
		sides = { "N", "S", "W", "E" }
	end
	local colors = { info.primary, info.secondary, Color3.fromRGB(235, 235, 235) }
	local props = { CanCollide = false, CanQuery = false, CastShadow = false, Name = "Crowd" }
	for _, side in ipairs(sides) do
		local length = (side == "N" or side == "S") and PITCH_LENGTH - 2 or PITCH_WIDTH - 2
		for r = 1, filled do
			local y = r * ROW_STEP + 0.35
			local dist = 4 + (r - 0.5) * ROW_DEPTH
			local cf, size
			if side == "N" then
				cf, size = CFrame.new(0, y, PITCH_CENTER_Z - PITCH_WIDTH / 2 - dist), Vector3.new(length, 0.7, 1.6)
			elseif side == "S" then
				cf, size = CFrame.new(0, y, PITCH_CENTER_Z + PITCH_WIDTH / 2 + dist), Vector3.new(length, 0.7, 1.6)
			elseif side == "W" then
				cf, size = CFrame.new(-PITCH_LENGTH / 2 - dist, y, PITCH_CENTER_Z), Vector3.new(1.6, 0.7, length)
			else
				cf, size = CFrame.new(PITCH_LENGTH / 2 + dist, y, PITCH_CENTER_Z), Vector3.new(1.6, 0.7, length)
			end
			part(folder, origin, cf, size, colors[(r % 3) + 1], Enum.Material.Fabric, props)
		end
	end
end

-- ===== Estadio evolutivo: elementos de cada etapa =====

local function stageColor(name)
	local colors = {
		Concrete = Color3.fromRGB(175, 175, 170),
		Cobblestone = Color3.fromRGB(150, 140, 130),
		Slate = Color3.fromRGB(110, 115, 125),
		Marble = Color3.fromRGB(230, 228, 222),
		WoodPlanks = Color3.fromRGB(150, 110, 70),
		Brick = Color3.fromRGB(160, 80, 60),
		Glass = Color3.fromRGB(170, 210, 235),
	}
	return colors[name] or Color3.fromRGB(170, 170, 170)
end

local function buildWalls(folder, origin, visual, info)
	local wall = visual.wall
	local h = wall.height
	local mat = material(wall.material, Enum.Material.Concrete)
	local color = stageColor(wall.material)
	local props = { Transparency = wall.material == "Glass" and 0.4 or 0, Name = "Wall" }
	local hx, hz = Layout.HALF_X, Layout.HALF_Z
	local t = 1.5
	local gateHalf = 10
	local segments = {
		{ CFrame.new(0, h / 2, -hz + t / 2), Vector3.new(hx * 2, h, t) }, -- norte
		{ CFrame.new(-hx + t / 2, h / 2, 0), Vector3.new(t, h, hz * 2) }, -- oeste
		{ CFrame.new(hx - t / 2, h / 2, 0), Vector3.new(t, h, hz * 2) }, -- este
		{ CFrame.new(-(hx + gateHalf) / 2, h / 2, hz - t / 2), Vector3.new(hx - gateHalf, h, t) }, -- sur izq.
		{ CFrame.new((hx + gateHalf) / 2, h / 2, hz - t / 2), Vector3.new(hx - gateHalf, h, t) }, -- sur dcha.
	}
	for _, seg in ipairs(segments) do
		part(folder, origin, seg[1], seg[2], color, mat, props)
		-- Remate superior: franja del club, neón o dorado según la etapa
		if wall.stripe or wall.neon or wall.gold then
			local capColor = wall.gold and GOLD or (wall.neon and info.secondary or info.primary)
			local capMat = (wall.neon or wall.gold) and Enum.Material.Neon or Enum.Material.SmoothPlastic
			part(folder, origin, seg[1] * CFrame.new(0, h / 2 + 0.3, 0), Vector3.new(seg[2].X, 0.6, seg[2].Z), capColor, capMat, { CanCollide = false })
		end
	end
end

local function buildGate(folder, origin, visual, info)
	local h = (visual.wall and visual.wall.height or 4) + 6
	local z = Layout.HALF_Z - 0.75
	local pillarColor = (visual.wall and visual.wall.gold) and GOLD or info.primary
	for _, x in ipairs({ -11, 11 }) do
		part(folder, origin, CFrame.new(x, h / 2, z), Vector3.new(2.5, h, 2.5), pillarColor, Enum.Material.SmoothPlastic)
	end
	local beam = part(folder, origin, CFrame.new(0, h + 1.5, z), Vector3.new(25, 3, 2.5), info.secondary, Enum.Material.SmoothPlastic, { Name = "Gate" })
	if visual.gateText then
		local function content(gui)
			local t = Instance.new("TextLabel")
			t.Size = UDim2.fromScale(1, 1)
			t.BackgroundColor3 = info.primary
			t.TextColor3 = info.secondaryText
			t.Font = Enum.Font.GothamBlack
			t.TextScaled = true
			local naming = info.sponsors and info.sponsors.naming
			t.Text = info.crestSymbol .. " " .. string.upper(info.clubName) .. " · "
				.. (naming and ("ESTADIO " .. string.upper(naming)) or info.stageName)
			t.Parent = gui
		end
		surfaceText(beam, Enum.NormalId.Front, content)
		surfaceText(beam, Enum.NormalId.Back, content)
	end
end

-- Esquinas cerradas: 3 bloques escalonados por esquina, anclados en la esquina exterior.
local function buildCorners(folder, origin, standsLevel, design, info)
	if standsLevel < 3 then
		return -- hacen falta las 4 gradas
	end
	local rows = ROWS_BY_LEVEL[math.clamp(standsLevel, 1, #ROWS_BY_LEVEL)]
	local a, b = 4, 4 + rows * ROW_DEPTH
	local topY = rows * ROW_STEP
	local mat = material(design.material, Enum.Material.Concrete)
	for _, sx in ipairs({ -1, 1 }) do
		for _, sz in ipairs({ -1, 1 }) do
			local zEdge = PITCH_CENTER_Z + sz * PITCH_WIDTH / 2
			for k = 1, 3 do
				local size = (b - a) * k / 3
				local height = topY * (4 - k) / 3
				local cx = sx * (PITCH_LENGTH / 2 + b - size / 2)
				local cz = zEdge + sz * (b - size / 2)
				part(folder, origin, CFrame.new(cx, height / 2, cz), Vector3.new(size, height, size),
					(k % 2 == 0) and info.secondary or info.primary, mat, { Name = "CornerStand" })
			end
		end
	end
end

local function buildScreens(folder, origin, info)
	for _, sx in ipairs({ -1, 1 }) do
		local pos = Vector3.new(sx * 75, 30, -78)
		part(folder, origin, CFrame.new(pos.X, 12, pos.Z), Vector3.new(1.5, 24, 1.5), Color3.fromRGB(60, 60, 70), Enum.Material.Metal)
		local worldPos = (origin * CFrame.new(pos)).Position
		local target = (origin * CFrame.new(0, pos.Y, PITCH_CENTER_Z)).Position
		local screen = Instance.new("Part")
		screen.Name = "BigScreen"
		screen.Anchored = true
		screen.Size = Vector3.new(20, 11, 1)
		screen.CFrame = CFrame.lookAt(worldPos, target)
		screen.Color = Color3.fromRGB(10, 10, 15)
		screen.Parent = folder
		surfaceText(screen, Enum.NormalId.Front, function(gui)
			local t = Instance.new("TextLabel")
			t.Size = UDim2.fromScale(1, 1)
			t.BackgroundColor3 = info.primary
			t.TextColor3 = info.secondaryText
			t.Font = Enum.Font.GothamBlack
			t.TextScaled = true
			t.Text = info.crestSymbol .. "\n" .. info.clubName
			t.Parent = gui
		end)
	end
end

local function buildLightRing(folder, origin, standsLevel, info)
	local rows = ROWS_BY_LEVEL[math.clamp(standsLevel, 1, #ROWS_BY_LEVEL)]
	local b = 4 + rows * ROW_DEPTH
	local y = rows * ROW_STEP + 12
	local color = info.vip and GOLD or Color3.fromRGB(170, 220, 255)
	local outerX = PITCH_LENGTH / 2 + b
	local north, south = PITCH_CENTER_Z - PITCH_WIDTH / 2 - b, PITCH_CENTER_Z + PITCH_WIDTH / 2 + b
	local props = { CanCollide = false, CanQuery = false, Name = "LightRing" }
	part(folder, origin, CFrame.new(0, y, north), Vector3.new(outerX * 2, 0.6, 0.6), color, Enum.Material.Neon, props)
	part(folder, origin, CFrame.new(0, y, south), Vector3.new(outerX * 2, 0.6, 0.6), color, Enum.Material.Neon, props)
	part(folder, origin, CFrame.new(-outerX, y, (north + south) / 2), Vector3.new(0.6, 0.6, south - north), color, Enum.Material.Neon, props)
	part(folder, origin, CFrame.new(outerX, y, (north + south) / 2), Vector3.new(0.6, 0.6, south - north), color, Enum.Material.Neon, props)
end

local function buildMonument(folder, origin, info)
	local p = Layout.MONUMENT
	part(folder, origin, CFrame.new(p.X, 2, p.Z), Vector3.new(6, 4, 6), Color3.fromRGB(235, 232, 225), Enum.Material.Marble)
	local ball = part(folder, origin, CFrame.new(p.X, 7, p.Z), Vector3.new(6, 6, 6), GOLD, Enum.Material.Metal, { Reflectance = 0.35 })
	ball.Shape = Enum.PartType.Ball
	local sparkle = Instance.new("Sparkles")
	sparkle.SparkleColor = GOLD
	sparkle.Parent = ball
	label(ball, info.crestSymbol .. " Monumento " .. info.clubName, 5, GOLD).MaxDistance = 100
end

local function buildStageExtras(folder, origin, info, standsLevel, standsDesign)
	local visual = info.stageVisual or {}
	if visual.plaza then
		part(folder, origin, CFrame.new(0, 0.05, 87.5), Vector3.new(190, 0.1, 35), stageColor(visual.plaza),
			material(visual.plaza, Enum.Material.Concrete), { Name = "Plaza" })
	end
	if visual.wall then
		buildWalls(folder, origin, visual, info)
	end
	if visual.gate then
		buildGate(folder, origin, visual, info)
	end
	if visual.corners then
		buildCorners(folder, origin, standsLevel, standsDesign, info)
	end
	if visual.screens then
		buildScreens(folder, origin, info)
	end
	if visual.lightRing then
		buildLightRing(folder, origin, standsLevel, info)
	end
	if visual.monument then
		buildMonument(folder, origin, info)
	end
end

-- ===== API =====

-- info: ver PlotService.BuildRenderInfo
function StadiumRenderer.Render(folder, origin, info)
	folder:ClearAllChildren()
	local facilities = info.facilities
	local standsDesign = CosmeticConfig.ById.design[info.appearance.standsDesign] or CosmeticConfig.ById.design.classic
	local buildingDesign = CosmeticConfig.ById.design[info.appearance.buildingDesign] or CosmeticConfig.ById.design.brick
	local standsLevel = facilities.stands or 1

	buildStageExtras(folder, origin, info, standsLevel, standsDesign)
	buildPitch(folder, origin, facilities.pitch or 1)
	buildStands(folder, origin, standsLevel, standsDesign, info.primary, info.secondary)
	buildLighting(folder, origin, facilities.lighting or 0, info.vip)
	buildScoreboard(folder, origin, facilities.scoreboard or 0, info)
	buildLaneFacilities(folder, origin, facilities, buildingDesign, info)
	buildKiosks(folder, origin, facilities.kiosks or 0, info)
	buildTourBooth(folder, origin, facilities.tour or 0, info)
	buildAdBoards(folder, origin, info)
	buildSign(folder, origin, info)
	buildEffect(folder, origin, info.appearance.effect, info.primary, info.secondary)
	buildDecorations(folder, origin, info.decorations, info.decorationVisible, info)
end

return StadiumRenderer
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000002B"><Properties><string name="Name">StadiumService</string><ProtectedString name="Source"><![CDATA[-- StadiumService (ModuleScript)
-- Ubicación: ServerScriptService/Server/Services/StadiumService
--
-- ESTADIO EVOLUTIVO (FASE 2): ascenso entre las 7 etapas.
-- El servidor comprueba reputación, instalaciones, deuda y dinero con
-- EconomyFormulas.CanUpgradeStage antes de cobrar y ascender.
-- Cada ascenso queda registrado como evento real del club (base de la HISTORIA DEL CLUB).

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local GameConfig = require(Shared.Config.GameConfig)
local EconomyFormulas = require(Shared.Modules.EconomyFormulas)

local DataService = require(script.Parent.DataService)
local EconomyService = require(script.Parent.EconomyService)

local StadiumService = {}

-- Registra un evento real en el historial del club.
function StadiumService.LogEvent(data, kind, fields)
	local event = { t = os.time(), kind = kind }
	for k, v in pairs(fields or {}) do
		event[k] = v
	end
	table.insert(data.history, event)
	while #data.history > GameConfig.MAX_HISTORY_EVENTS do
		table.remove(data.history, 1)
	end
end

function StadiumService.UpgradeStage(player)
	local data = DataService.Get(player)
	local ok, reason, nextStage = EconomyFormulas.CanUpgradeStage(data)
	if not ok then
		return false, reason
	end
	local paid, payError = EconomyService.Spend(player, nextStage.upgradeCost, EconomyService.Category.CONSTRUCTION,
		"Ascenso del estadio: " .. nextStage.name)
	if not paid then
		return false, payError
	end
	data.stadium.stage = nextStage.stage
	data.stats.buildings += 1
	StadiumService.LogEvent(data, "stadium_stage", {
		stage = nextStage.stage,
		name = nextStage.name,
		reputation = EconomyFormulas.Reputation(data),
	})
	return true, string.format("🏟️ ¡Tu estadio asciende a %s (etapa %d)!", nextStage.name, nextStage.stage)
end

return StadiumService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000002C"><Properties><string name="Name">TransferService</string><ProtectedString name="Source"><![CDATA[-- TransferService (ModuleScript)
-- Ubicación: ServerScriptService/Server/Services/TransferService
--
-- MERCADO DE FICHAJES (FASE 6). Todo se valida en el servidor:
--   * Comprar: el anuncio debe existir, la oferta respeta el presupuesto de fichajes,
--     hay plaza en la plantilla y la negociación se resuelve con el Random del servidor.
--   * Vender: solo jugadores propios, solo ofertas existentes y sin bajar del mínimo.
--   * Cesiones: recibidas (pagas cuota + salario) y cedidas (cobras cuota; su club paga
--     el salario). Terminan al acabar la temporada.
--   * Fichajes y ventas destacados quedan en el historial y en los récords del club.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local GameConfig = require(Shared.Config.GameConfig)
local FootballConfig = require(Shared.Config.FootballConfig)
local TransferConfig = require(Shared.Config.TransferConfig)
local FootballFormulas = require(Shared.Modules.FootballFormulas)

local DataService = require(script.Parent.DataService)
local EconomyService = require(script.Parent.EconomyService)
local StadiumService = require(script.Parent.StadiumService)
local MatchService = require(script.Parent.MatchService)
local PlayerFactory = require(script.Parent.Parent.Util.PlayerFactory)

local TransferService = {}

local rng = Random.new()

local function isAway(p)
	return p.loan ~= nil and p.loan.type == "out"
end

-- Jugadores que ocupan plaza en la plantilla (los cedidos a otros clubes no cuentan).
function TransferService.ActiveCount(data)
	local n = 0
	for _, p in ipairs(data.squad) do
		if not isAway(p) then
			n += 1
		end
	end
	return n
end

function TransferService.Budget(data)
	return math.floor(data.economy.money * (data.economy.transferShare or TransferConfig.DEFAULT_BUDGET_SHARE))
end

local function findSquad(data, id)
	if type(id) ~= "string" then
		return nil
	end
	for index, p in ipairs(data.squad) do
		if p.id == id then
			return p, index
		end
	end
	return nil
end

-- ===== Generación del mercado =====

local function generateMarket(data)
	local strength = MatchService.TeamStrength(data)
	local listings = {}
	for i = 1, TransferConfig.MARKET_SIZE do
		local kind = "buy"
		if i <= TransferConfig.FREE_AGENTS then
			kind = "free"
		elseif i <= TransferConfig.FREE_AGENTS + TransferConfig.LOAN_LISTINGS then
			kind = "loan"
		end
		local positions = FootballConfig.Positions
		local age = rng:NextInteger(18, 32)
		local overall = math.clamp(strength + rng:NextInteger(TransferConfig.STRENGTH_MIN, TransferConfig.STRENGTH_MAX), 35, 92)
		if kind == "free" then
			age = rng:NextInteger(27, 34) -- los libres suelen ser veteranos
			overall = math.clamp(overall - 3, 35, 90)
		end
		local p = PlayerFactory.Create(data, {
			pos = positions[rng:NextInteger(1, #positions)].id,
			overall = overall,
			age = age,
			origin = "transfer",
			contract = TransferConfig.DEFAULT_CONTRACT,
		})
		local value = FootballFormulas.MarketValue(p)
		local club = kind == "free" and "Sin club" or (MatchService.RandomClubName())
		table.insert(listings, {
			id = string.format("m%d-%d", data.stats.cycles, i),
			kind = kind,
			club = club,
			asking = kind == "buy" and math.floor(value * (TransferConfig.ASK_MIN + rng:NextNumber() * (TransferConfig.ASK_MAX - TransferConfig.ASK_MIN)) / 100 + 0.5) * 100 or 0,
			loanFee = kind == "loan" and math.max(10, math.floor(value * TransferConfig.LOAN_IN_FEE)) or 0,
			bonus = kind == "free" and math.floor(value * TransferConfig.FREE_AGENT_BONUS) or 0,
			player = p,
		})
	end
	data.market.listings = listings
	data.market.rejected = {}
	data.market.nextRefresh = data.stats.cycles + TransferConfig.REFRESH_CYCLES
end

function TransferService.RefreshMarket(data, force)
	if force or #data.market.listings == 0 or data.stats.cycles >= (data.market.nextRefresh or 0) then
		generateMarket(data)
	end
end

local function findListing(data, id)
	if type(id) ~= "string" then
		return nil
	end
	for index, l in ipairs(data.market.listings) do
		if l.id == id then
			return l, index
		end
	end
	return nil
end

local function recordSigning(data, p, fee, club, kind)
	StadiumService.LogEvent(data, kind == "loan" and "loan_in" or "transfer_in",
		{ name = p.name, fee = fee, club = club, ovr = FootballFormulas.OverallInt(p) })
	if kind ~= "loan" and (data.records.biggestSigning == nil or fee > data.records.biggestSigning.fee) then
		data.records.biggestSigning = { name = p.name, fee = fee, club = club, season = data.season.number }
	end
end

-- ===== Comprar / fichar libre / cesión recibida =====

function TransferService.Buy(player, payload)
	local data = DataService.Get(player)
	if type(payload) ~= "table" then
		return false, "Solicitud no válida."
	end
	local listing, index = findListing(data, payload.listing)
	if not listing then
		return false, "Ese jugador ya no está en el mercado."
	end
	if TransferService.ActiveCount(data) >= FootballConfig.MAX_SQUAD then
		return false, string.format("Tu plantilla está llena (%d).", FootballConfig.MAX_SQUAD)
	end
	if data.economy.debt > GameConfig.DEBT_BUILD_LIMIT then
		return false, "Tu deuda es demasiado alta para fichar."
	end
	local years = tonumber(payload.years) or TransferConfig.DEFAULT_CONTRACT
	if years ~= math.floor(years) or years < 1 or years > FootballConfig.CONTRACT_MAX_SEASONS then
		return false, "Duración de contrato no válida."
	end
	local p = listing.player
	local message

	if listing.kind == "buy" then
		if data.market.rejected[listing.id] then
			return false, listing.club .. " ya rechazó tu oferta. Espera a la próxima renovación del mercado."
		end
		local level
		for _, l in ipairs(TransferConfig.OfferLevels) do
			if l.id == payload.offer then
				level = l
			end
		end
		if not level then
			return false, "Oferta no válida."
		end
		local fee = math.floor(listing.asking * level.share)
		if fee > TransferService.Budget(data) then
			return false, string.format("La oferta (%d %s) supera tu presupuesto de fichajes.", fee, GameConfig.CURRENCY)
		end
		if rng:NextNumber() >= level.chance then
			data.market.rejected[listing.id] = true
			return false, string.format("❌ %s rechaza tu oferta de %d %s por %s.", listing.club, fee, GameConfig.CURRENCY, p.name)
		end
		local paid, err = EconomyService.Spend(player, fee, EconomyService.Category.TRANSFER, "Fichaje: " .. p.name)
		if not paid then
			return false, err
		end
		recordSigning(data, p, fee, listing.club, "buy")
		message = string.format("✍️ ¡%s ficha por tu club! Traspaso: %d %s.", p.name, fee, GameConfig.CURRENCY)
	elseif listing.kind == "free" then
		if listing.bonus > data.economy.money then
			return false, "No puedes pagar la prima de fichaje."
		end
		EconomyService.Spend(player, listing.bonus, EconomyService.Category.TRANSFER, "Prima de fichaje: " .. p.name)
		recordSigning(data, p, 0, "libre", "free")
		message = string.format("✍️ %s llega libre (prima %d %s).", p.name, listing.bonus, GameConfig.CURRENCY)
	else
		-- Cesión recibida: hasta final de temporada
		p.loan = { type = "in", club = listing.club, fee = listing.loanFee, endSeason = data.season.number }
		years = 2 -- el contrato no vence antes de que termine la cesión
		recordSigning(data, p, 0, listing.club, "loan")
		message = string.format("🔁 %s llega cedido por %s hasta final de temporada (%d %s/jornada + salario).",
			p.name, listing.club, listing.loanFee, GameConfig.CURRENCY)
	end

	p.salary = math.max(2, math.floor(FootballFormulas.SalaryDemand(p) * TransferConfig.SALARY_PREMIUM))
	p.contract = years
	p.joinedSeason = data.season.number
	p.listed = nil
	table.remove(data.market.listings, index)
	table.insert(data.squad, p)
	return true, message
end

-- ===== Vender / ceder =====

function TransferService.SetListing(player, payload)
	local data = DataService.Get(player)
	local p = findSquad(data, type(payload) == "table" and payload.id)
	if not p then
		return false, "Ese jugador no es de tu plantilla."
	end
	if p.loan then
		return false, "No puedes poner en el mercado a un jugador cedido."
	end
	local mode = payload.mode
	if mode == "none" then
		p.listed = nil
		return true, p.name .. " ya no está en el mercado."
	elseif mode == "sale" then
		p.listed = "sale"
		return true, p.name .. " está en venta. Los clubes interesados enviarán ofertas."
	elseif mode == "loan" then
		if p.age > 25 then
			return false, "Solo se ceden jugadores de 25 años o menos."
		end
		p.listed = "loan"
		return true, p.name .. " está disponible para cesión."
	end
	return false, "Opción no válida."
end

function TransferService.AcceptOffer(player, payload)
	local data = DataService.Get(player)
	local offerId = type(payload) == "table" and payload.offer
	local offer, offerIndex
	for i, o in ipairs(data.transferOffers) do
		if o.id == offerId then
			offer, offerIndex = o, i
		end
	end
	if not offer then
		return false, "Esa oferta ya no existe."
	end
	local p, index = findSquad(data, offer.playerId)
	if not p or p.loan then
		table.remove(data.transferOffers, offerIndex)
		return false, "El jugador ya no está disponible."
	end
	if TransferService.ActiveCount(data) <= FootballConfig.MIN_SQUAD then
		return false, string.format("Necesitas al menos %d jugadores. Ficha o sube a un canterano antes de vender.", FootballConfig.MIN_SQUAD)
	end
	table.remove(data.squad, index)
	table.remove(data.transferOffers, offerIndex)
	-- Las demás ofertas por ese jugador caducan
	for i = #data.transferOffers, 1, -1 do
		if data.transferOffers[i].playerId == p.id then
			table.remove(data.transferOffers, i)
		end
	end
	EconomyService.Earn(player, offer.fee, EconomyService.Category.TRANSFER, "Venta: " .. p.name .. " a " .. offer.club)
	StadiumService.LogEvent(data, "transfer_out", { name = p.name, fee = offer.fee, club = offer.club, ovr = FootballFormulas.OverallInt(p) })
	if data.records.biggestSale == nil or offer.fee > data.records.biggestSale.fee then
		data.records.biggestSale = { name = p.name, fee = offer.fee, club = offer.club, season = data.season.number }
	end
	return true, string.format("💰 %s vendido a %s por %d %s.", p.name, offer.club, offer.fee, GameConfig.CURRENCY)
end

function TransferService.RejectOffer(player, payload)
	local data = DataService.Get(player)
	local offerId = type(payload) == "table" and payload.offer
	for i, o in ipairs(data.transferOffers) do
		if o.id == offerId then
			table.remove(data.transferOffers, i)
			return true, "Oferta rechazada."
		end
	end
	return false, "Esa oferta ya no existe."
end

function TransferService.SetBudgetShare(player, payload)
	local data = DataService.Get(player)
	local share = tonumber(type(payload) == "table" and payload.share)
	for _, allowed in ipairs(TransferConfig.BudgetShares) do
		if share == allowed then
			data.economy.transferShare = allowed
			return true, string.format("Presupuesto de fichajes: %d%% del dinero.", math.floor(allowed * 100))
		end
	end
	return false, "Valor no válido."
end

-- ===== Jornada =====

local function addOffer(data, p, fee, unsolicited)
	if #data.transferOffers >= TransferConfig.MAX_OFFERS then
		return nil
	end
	local club = MatchService.RandomClubName()
	local offer = {
		id = string.format("o%d-%s-%d", data.stats.cycles, p.id, rng:NextInteger(1, 9999)),
		playerId = p.id,
		playerName = p.name,
		club = club,
		fee = math.floor(fee / 100 + 0.5) * 100,
		expires = data.stats.cycles + TransferConfig.OFFER_EXPIRY,
		unsolicited = unsolicited == true,
	}
	table.insert(data.transferOffers, offer)
	return offer
end

function TransferService.AfterCycle(player)
	local data = DataService.Get(player)
	if not data then
		return {}
	end
	local messages = {}
	local cycles = data.stats.cycles

	-- Ofertas caducadas
	for i = #data.transferOffers, 1, -1 do
		if data.transferOffers[i].expires <= cycles then
			table.remove(data.transferOffers, i)
		end
	end

	-- Ofertas por jugadores en venta y cesiones aceptadas
	for _, p in ipairs(data.squad) do
		if p.listed == "sale" and rng:NextNumber() < TransferConfig.LISTED_OFFER_CHANCE then
			local value = FootballFormulas.MarketValue(p)
			local offer = addOffer(data, p, value * (TransferConfig.OFFER_MIN + rng:NextNumber() * (TransferConfig.OFFER_MAX - TransferConfig.OFFER_MIN)), false)
			if offer then
				table.insert(messages, string.format("📨 %s ofrece %d %s por %s.", offer.club, offer.fee, GameConfig.CURRENCY, p.name))
			end
		elseif p.listed == "loan" and not p.loan and rng:NextNumber() < TransferConfig.LOAN_OUT_CHANCE then
			local club = MatchService.RandomClubName()
			p.loan = { type = "out", club = club, fee = math.max(5, math.floor(FootballFormulas.MarketValue(p) * TransferConfig.LOAN_OUT_FEE)), endSeason = data.season.number }
			p.listed = nil
			StadiumService.LogEvent(data, "loan_out", { name = p.name, club = club })
			table.insert(messages, string.format("🔁 %s se va cedido a %s hasta final de temporada.", p.name, club))
		end
	end

	-- Oferta espontánea por uno de los mejores
	if rng:NextNumber() < TransferConfig.UNSOLICITED_CHANCE then
		local candidates = {}
		for _, p in ipairs(data.squad) do
			if not p.loan then
				table.insert(candidates, p)
			end
		end
		table.sort(candidates, function(a, b)
			return FootballFormulas.Overall(a) > FootballFormulas.Overall(b)
		end)
		local target = candidates[rng:NextInteger(1, math.min(3, math.max(1, #candidates)))]
		if target then
			local offer = addOffer(data, target, FootballFormulas.MarketValue(target) * TransferConfig.UNSOLICITED_PREMIUM, true)
			if offer then
				table.insert(messages, string.format("📨 ¡Oferta inesperada! %s ofrece %d %s por %s.", offer.club, offer.fee, GameConfig.CURRENCY, target.name))
			end
		end
	end

	-- Fin de las cesiones al cambiar de temporada
	for i = #data.squad, 1, -1 do
		local p = data.squad[i]
		if p.loan and data.season.number > (p.loan.endSeason or 0) then
			if p.loan.type == "in" then
				table.remove(data.squad, i)
				table.insert(messages, string.format("🔁 Termina la cesión de %s, que vuelve a %s.", p.name, p.loan.club))
			else
				table.insert(messages, string.format("🔁 %s vuelve de su cesión en %s.", p.name, p.loan.club))
				p.loan = nil
			end
		end
	end

	TransferService.RefreshMarket(data, false)
	return messages
end

function TransferService.PlayerReady(player)
	local data = DataService.Get(player)
	if data then
		TransferService.RefreshMarket(data, false)
	end
end

-- ===== Estado para el cliente =====

function TransferService.BuildState(data, publicPlayer)
	local listings = {}
	for _, l in ipairs(data.market.listings) do
		table.insert(listings, {
			id = l.id, kind = l.kind, club = l.club, asking = l.asking, loanFee = l.loanFee, bonus = l.bonus,
			rejected = data.market.rejected[l.id] == true,
			salary = math.max(2, math.floor(FootballFormulas.SalaryDemand(l.player) * TransferConfig.SALARY_PREMIUM)),
			player = publicPlayer(l.player),
		})
	end
	return {
		listings = listings,
		offers = data.transferOffers,
		nextRefresh = math.max(0, (data.market.nextRefresh or 0) - data.stats.cycles),
		budget = TransferService.Budget(data),
		budgetShare = data.economy.transferShare or TransferConfig.DEFAULT_BUDGET_SHARE,
		activeCount = TransferService.ActiveCount(data),
	}
end

return TransferService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000002D"><Properties><string name="Name">UniverseService</string><ProtectedString name="Source"><![CDATA[-- UniverseService (ModuleScript)
-- Ubicación: ServerScriptService/Server/Services/UniverseService
--
-- UNIVERSO FUTBOLÍSTICO (FASE 8), compartido entre todos los servidores:
--   * Perfil PÚBLICO de cada club (DataStore) — sin dinero, deuda ni datos privados.
--   * Rankings globales de reputación, valor y títulos (OrderedDataStore).
--   * Competición semanal entre usuarios (puntos por resultados) con recompensas.
--   * Directorio: clubes de este servidor (visitables) y clubes destacados del universo.
-- Nada de esto bloquea el juego: si Roblox no responde, se muestra "universo sin conexión"
-- y se reintenta más tarde. Las lecturas se cachean para respetar los límites de DataStore.

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local GameConfig = require(Shared.Config.GameConfig)
local UniverseConfig = require(Shared.Config.UniverseConfig)
local CosmeticConfig = require(Shared.Config.CosmeticConfig)
local StadiumStages = require(Shared.Config.StadiumStages)
local EconomyFormulas = require(Shared.Modules.EconomyFormulas)

local DataService = require(script.Parent.DataService)
local ClubService = require(script.Parent.ClubService)
local EconomyService = require(script.Parent.EconomyService)
local StadiumService = require(script.Parent.StadiumService)
local Retry = require(script.Parent.Parent.Util.Retry)

local UniverseService = {}

local online = true -- se pone a false si DataStore no está disponible (p. ej. Studio sin API)
local lastOfflineAt = 0
local profileStore
local rankStores = {}
local rankingCache = {} -- [rankingId] = { time, entries }
local profileCache = {} -- [userId] = { time, profile }
local weeklyCache = { time = -math.huge, week = -1, entries = {} }
local lastPublish = {} -- [player] = os.clock()
local pendingWeekly = {} -- [player] = puntos sin enviar
local extraProfileFields = {} -- ampliaciones (FASE 9 añade la hoja del equipo)

local function markOffline(err)
	if online then
		warn("[UniverseService] Universo sin conexión: ", err)
	end
	online = false
	lastOfflineAt = os.clock()
end

local function canTry()
	if online then
		return true
	end
	if os.clock() - lastOfflineAt > UniverseConfig.PUBLISH_SECONDS then
		online = true -- reintento periódico
		return true
	end
	return false
end

do
	local ok, err = pcall(function()
		profileStore = DataStoreService:GetDataStore(UniverseConfig.PROFILE_STORE)
		for _, ranking in ipairs(UniverseConfig.RANKINGS) do
			rankStores[ranking.id] = DataStoreService:GetOrderedDataStore(ranking.store)
		end
	end)
	if not ok then
		markOffline(err)
	end
end

local function weeklyStore(week)
	return DataStoreService:GetOrderedDataStore(UniverseConfig.WEEKLY_STORE_PREFIX .. tostring(week))
end

local function colorHex(color)
	return string.format("#%02X%02X%02X", math.floor(color.R * 255 + 0.5), math.floor(color.G * 255 + 0.5), math.floor(color.B * 255 + 0.5))
end

-- Perfil público: lo que cualquier otro jugador puede ver del club.
function UniverseService.PublicProfile(player, data)
	local appearance = ClubService.EffectiveAppearance(player, data)
	local palette = CosmeticConfig.ById.palette[appearance.palette]
	local crest = CosmeticConfig.ById.crest[appearance.crest]
	local league = data.league or {}
	local profile = {
		userId = player.UserId,
		ownerName = player.DisplayName,
		clubName = ClubService.DisplayName(data),
		short = ClubService.ShortName(data),
		crest = crest and crest.symbol or "⚽",
		primary = colorHex(palette.primary),
		secondary = colorHex(palette.secondary),
		vip = ClubService.IsVip(player),
		reputation = EconomyFormulas.Reputation(data),
		value = EconomyFormulas.ClubValue(data),
		titles = #data.trophies,
		fans = data.club.fans,
		stage = data.stadium.stage,
		stageName = StadiumStages.Get(data.stadium.stage).name,
		division = league.division or 1,
		season = data.season.number,
		updated = os.time(),
	}
	for _, extend in ipairs(extraProfileFields) do
		extend(player, data, profile)
	end
	return profile
end

-- Permite a otros servicios añadir campos públicos al perfil (p. ej. la hoja de equipo en la FASE 9).
function UniverseService.ExtendProfile(fn)
	table.insert(extraProfileFields, fn)
end

function UniverseService.Publish(player, force)
	local data = DataService.Get(player)
	if not data or not canTry() then
		return false
	end
	if not force and lastPublish[player] and os.clock() - lastPublish[player] < UniverseConfig.PUBLISH_SECONDS then
		return false
	end
	lastPublish[player] = os.clock()
	local profile = UniverseService.PublicProfile(player, data)
	local key = tostring(player.UserId)
	local ok, err = Retry.Call(2, 1, function()
		profileStore:SetAsync(key, profile)
		rankStores.reputation:SetAsync(key, math.floor(profile.reputation))
		rankStores.value:SetAsync(key, math.floor(profile.value))
		rankStores.titles:SetAsync(key, profile.titles)
	end)
	if not ok then
		markOffline(err)
		return false
	end
	profileCache[player.UserId] = { time = os.clock(), profile = profile }
	return true
end

-- Puntos de la competición semanal (se agrupan y se envían cada minuto).
function UniverseService.AddWeeklyPoints(player, points)
	if points and points > 0 then
		pendingWeekly[player] = (pendingWeekly[player] or 0) + points
		local data = DataService.Get(player)
		if data then
			local week = UniverseConfig.WeekIndex()
			if data.universe.week ~= week then
				data.universe.week = week
				data.universe.weekPoints = 0
			end
			data.universe.weekPoints += points
		end
	end
end

local function flushWeekly()
	if not canTry() then
		return
	end
	local week = UniverseConfig.WeekIndex()
	for player, points in pairs(pendingWeekly) do
		pendingWeekly[player] = nil
		local ok, err = pcall(function()
			weeklyStore(week):IncrementAsync(tostring(player.UserId), points)
		end)
		if not ok then
			markOffline(err)
			pendingWeekly[player] = (pendingWeekly[player] or 0) + points
			return
		end
	end
end

local function fetchProfile(userId)
	local cached = profileCache[userId]
	if cached and os.clock() - cached.time < UniverseConfig.PROFILE_CACHE_SECONDS then
		return cached.profile
	end
	local ok, profile = pcall(function()
		return profileStore:GetAsync(tostring(userId))
	end)
	if not ok then
		markOffline(profile)
		return cached and cached.profile or nil
	end
	if type(profile) == "table" then
		profileCache[userId] = { time = os.clock(), profile = profile }
	end
	return type(profile) == "table" and profile or nil
end
UniverseService.FetchProfile = fetchProfile

local function readTop(store, size)
	local ok, pages = pcall(function()
		return store:GetSortedAsync(false, size)
	end)
	if not ok then
		markOffline(pages)
		return nil
	end
	local entries = {}
	for rank, item in ipairs(pages:GetCurrentPage()) do
		table.insert(entries, { rank = rank, userId = tonumber(item.key), value = item.value })
	end
	return entries
end

local function refreshCaches()
	if not canTry() then
		return
	end
	for _, ranking in ipairs(UniverseConfig.RANKINGS) do
		local entries = readTop(rankStores[ranking.id], UniverseConfig.RANKING_SIZE)
		if entries then
			for _, e in ipairs(entries) do
				local profile = e.userId and fetchProfile(e.userId)
				e.clubName = profile and profile.clubName or ("Club " .. tostring(e.userId))
				e.short = profile and profile.short or "???"
				e.crest = profile and profile.crest or "⚽"
				e.ownerName = profile and profile.ownerName or "?"
				e.division = profile and profile.division or nil
			end
			rankingCache[ranking.id] = { time = os.clock(), entries = entries }
		end
	end
	local week = UniverseConfig.WeekIndex()
	local weekly = readTop(weeklyStore(week), 10)
	if weekly then
		for _, e in ipairs(weekly) do
			local profile = e.userId and fetchProfile(e.userId)
			e.clubName = profile and profile.clubName or ("Club " .. tostring(e.userId))
			e.crest = profile and profile.crest or "⚽"
		end
		weeklyCache = { time = os.clock(), week = week, entries = weekly }
	end
end

-- Recompensa de la semana anterior (se comprueba al entrar).
function UniverseService.ClaimWeekly(player)
	local data = DataService.Get(player)
	if not data or not canTry() then
		return nil
	end
	local lastWeek = UniverseConfig.WeekIndex() - 1
	if (data.universe.claimedWeek or -1) >= lastWeek then
		return nil
	end
	local top = readTop(weeklyStore(lastWeek), 10)
	if not top then
		return nil -- se reintentará en la próxima sesión
	end
	data.universe.claimedWeek = lastWeek
	for _, e in ipairs(top) do
		if e.userId == player.UserId then
			local reward = UniverseConfig.WeeklyReward(e.rank)
			if reward then
				EconomyService.Earn(player, reward.money, EconomyService.Category.PRIZE, reward.label)
				data.club.reputationEarned += reward.reputation
				StadiumService.LogEvent(data, "weekly_reward", { rank = e.rank, week = lastWeek })
				return string.format("%s · puesto %d la semana pasada: +%d %s y +%d de reputación.", reward.label, e.rank,
					reward.money, GameConfig.CURRENCY, reward.reputation)
			end
		end
	end
	return nil
end

-- Visitar el estadio de otro club que esté en este servidor.
function UniverseService.Visit(player, payload, PlotService)
	local userId = tonumber(type(payload) == "table" and payload.userId)
	local target = userId and Players:GetPlayerByUserId(userId)
	if not target or target == player then
		return false, "Ese club no está en este servidor."
	end
	local plot = PlotService.GetPlot(target)
	local character = player.Character
	if not plot or not character then
		return false, "No se puede visitar ahora."
	end
	character:PivotTo(plot.origin * CFrame.new(0, 4, 92) * CFrame.Angles(0, math.pi, 0))
	return true, string.format("🏟️ Visitando el estadio de %s. Como visitante no puedes modificar nada.", target.DisplayName)
end

function UniverseService.BuildState(player, data)
	local event, eventLeft = UniverseConfig.CurrentEvent()
	local directory = {}
	for _, other in ipairs(Players:GetPlayers()) do
		local otherData = DataService.Get(other)
		if otherData then
			local profile = UniverseService.PublicProfile(other, otherData)
			profile.inServer = true
			profile.isMe = other == player
			table.insert(directory, profile)
		end
	end
	table.sort(directory, function(a, b)
		return a.reputation > b.reputation
	end)
	local rankings = {}
	for _, ranking in ipairs(UniverseConfig.RANKINGS) do
		rankings[ranking.id] = rankingCache[ranking.id] and rankingCache[ranking.id].entries or {}
	end
	local week = UniverseConfig.WeekIndex()
	return {
		online = online,
		event = { id = event.id, name = event.name, icon = event.icon, description = event.description, secondsLeft = eventLeft },
		rankings = rankings,
		weekly = {
			week = week,
			secondsLeft = UniverseConfig.WeekSecondsLeft(),
			top = weeklyCache.week == week and weeklyCache.entries or {},
			myPoints = data.universe.week == week and data.universe.weekPoints or 0,
		},
		directory = directory,
	}
end

function UniverseService.PlayerReady(player)
	task.spawn(function()
		UniverseService.Publish(player, true)
	end)
end

function UniverseService.PlayerRemoving(player)
	-- Último envío de puntos y perfil
	local points = pendingWeekly[player]
	pendingWeekly[player] = nil
	if points and canTry() then
		pcall(function()
			weeklyStore(UniverseConfig.WeekIndex()):IncrementAsync(tostring(player.UserId), points)
		end)
	end
	if DataService.Get(player) then
		UniverseService.Publish(player, true)
	end
	lastPublish[player] = nil
end

function UniverseService.Start()
	task.spawn(function()
		task.wait(5)
		refreshCaches()
		while true do
			task.wait(60)
			flushWeekly()
			for _, player in ipairs(Players:GetPlayers()) do
				task.spawn(UniverseService.Publish, player, false)
			end
			if os.clock() - (weeklyCache.time or 0) > UniverseConfig.RANKING_CACHE_SECONDS then
				refreshCaches()
			end
		end
	end)
end

return UniverseService
]]></ProtectedString></Properties></Item></Item><Item class="Folder" referent="RBX00000033"><Properties><string name="Name">Util</string></Properties><Item class="ModuleScript" referent="RBX0000002F"><Properties><string name="Name">DefaultData</string><ProtectedString name="Source"><![CDATA[-- DefaultData (ModuleScript)
-- Ubicación: ServerScriptService/Server/Util/DefaultData
--
-- Plantilla de datos de un club y validación/reparación de datos cargados.
-- Los campos de fases futuras (plantilla, temporada, trofeos...) ya existen
-- para que la Versión B amplíe estos datos sin migraciones destructivas.
--
-- NOTA: aquí NO se guarda la propiedad de Game Passes. `premium.purchaseLog`
-- es solo un registro informativo y nunca se usa para conceder ventajas.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.Config.GameConfig)
local FacilityConfig = require(Shared.Config.FacilityConfig)
local CosmeticConfig = require(Shared.Config.CosmeticConfig)
local StadiumStages = require(Shared.Config.StadiumStages)
local CommercialConfig = require(Shared.Config.CommercialConfig)
local SponsorConfig = require(Shared.Config.SponsorConfig)
local FootballConfig = require(Shared.Config.FootballConfig)
local TacticsConfig = require(Shared.Config.TacticsConfig)
local TransferConfig = require(Shared.Config.TransferConfig)
local HalloweenConfig = require(Shared.Config.HalloweenConfig)

local DefaultData = {}

function DefaultData.Create(player)
	local facilities = {}
	for id, def in pairs(FacilityConfig.Facilities) do
		if def.startLevel > 0 then
			facilities[id] = def.startLevel
		end
	end
	local displayName = player and player.DisplayName or "Jugador"
	return {
		version = GameConfig.DATA_VERSION,
		createdAt = os.time(),
		club = {
			name = "",
			shortName = "",
			named = false,
			founded = os.time(),
			fans = GameConfig.STARTING_FANS,
			members = 0, -- socios (FASE 3)
			satisfaction = GameConfig.SATISFACTION_START, -- 0-100 (FASE 3)
			reputationEarned = 0,
			ownerName = displayName,
			appearance = table.clone(CosmeticConfig.Defaults),
		},
		stadium = {
			stage = 1,
			facilities = facilities,
			decorations = {}, -- lista de { id = "flags", x = 40, z = 88, r = 0 } (coordenadas locales)
		},
		economy = {
			money = GameConfig.STARTING_MONEY,
			debt = 0,
			ticketPrice = GameConfig.DEFAULT_TICKET,
			memberPrice = "NORMAL",
			shopPrice = CommercialConfig.DEFAULT_POLICY,
			foodPrice = CommercialConfig.DEFAULT_POLICY,
			totalEarned = 0,
			totalSpent = 0,
			lastCycle = nil,
			transactions = {},
		},
		stats = {
			cycles = 0,
			playSeconds = 0,
			buildings = 0,
		},
		settings = {
			notifications = true,
			compactMenu = false,
			uiScale = 1,
		},
		premium = {
			purchaseLog = {}, -- solo informativo
		},
		sponsors = {
			contracts = {}, -- [huecoId] = { brand, payment, objective, cyclesLeft, duration, signedAt }
			offers = {}, -- [huecoId] = { { id, brand, payment, bonus, duration, objective } }
			nextRefresh = 0, -- nº de jornada en la que se renuevan las ofertas
		},
		-- ===== Reservado para fases posteriores =====
		squad = {}, -- primer equipo (FASE 4): lista de jugadores
		academy = { youths = {}, reports = {}, scouts = 0, nextReport = 0 }, -- cantera (FASE 4)
		training = { intensity = "NORMAL" },
		season = { number = 1, cycle = 0 },
		legends = {}, -- jugadores legendarios retirados
		tactics = { formation = TacticsConfig.DEFAULT_FORMATION, mentality = "BALANCED", style = "POSSESSION", lineup = {} }, -- FASE 5
		friendlies = { offers = {}, lastCycle = -1 },
		matches = {}, -- últimos partidos
		market = { listings = {}, rejected = {}, nextRefresh = 0 }, -- mercado de fichajes (FASE 6)
		transferOffers = {}, -- ofertas recibidas por tus jugadores
		league = nil, -- liga, copa y modo carrera (FASE 7): la crea LeagueService
		allTimeStats = {}, -- [idJugador] = { name, pos, origin, apps, goals, assists } (FASE 8)
		halloween = { candy = 0, total = 0 }, -- evento «Doces ou Travessuras»
		unlocks = {}, -- cosméticos gratuitos desbloqueados en eventos
		reputationHistory = {}, -- { season, cycle, value } (FASE 8)
		universe = { claimedWeek = -1, week = -1, weekPoints = 0 }, -- competición semanal (FASE 8)
		nextPlayerId = 0,
		trophies = {},
		records = {},
		missions = {},
		history = {}, -- eventos reales del club: { t, kind, ... } (base de la HISTORIA DEL CLUB)
	}
end

-- Posiciones a las que se migran las decoraciones de la v1 (espacios fijos 1-8).
local V1_SLOT_POSITIONS = {
	{ -36, 86 }, { 36, 86 }, { -60, 86 }, { 60, 86 },
	{ -84, 86 }, { 84, 86 }, { -48, 97 }, { 48, 97 },
}

local function finiteNumber(n)
	return type(n) == "number" and n == n and n ~= math.huge and n ~= -math.huge
end

local function validObjective(objective)
	if type(objective) ~= "table" or not finiteNumber(objective.target) then
		return false
	end
	for _, def in ipairs(SponsorConfig.Objectives) do
		if def.id == objective.type then
			return true
		end
	end
	return false
end

local function validOffer(offer)
	return type(offer) == "table" and type(offer.id) == "string" and type(offer.brand) == "string"
		and #offer.brand <= 40 and finiteNumber(offer.payment) and offer.payment >= 0
		and finiteNumber(offer.bonus) and offer.bonus >= 0
		and finiteNumber(offer.duration) and offer.duration >= 1 and validObjective(offer.objective)
end

local function cleanSponsors(raw)
	local clean = { contracts = {}, offers = {}, nextRefresh = 0 }
	if type(raw) ~= "table" then
		return clean
	end
	clean.nextRefresh = math.max(0, math.floor(tonumber(raw.nextRefresh) or 0))
	for _, slot in ipairs(SponsorConfig.Slots) do
		local contract = type(raw.contracts) == "table" and raw.contracts[slot.id]
		if type(contract) == "table" and type(contract.brand) == "string" and #contract.brand <= 40
			and finiteNumber(contract.payment) and contract.payment >= 0
			and finiteNumber(contract.cyclesLeft) and contract.cyclesLeft >= 1
			and validObjective(contract.objective) then
			clean.contracts[slot.id] = {
				brand = contract.brand,
				payment = math.floor(contract.payment),
				objective = { type = contract.objective.type, target = contract.objective.target },
				cyclesLeft = math.floor(contract.cyclesLeft),
				duration = math.floor(tonumber(contract.duration) or contract.cyclesLeft),
				signedAt = tonumber(contract.signedAt) or os.time(),
			}
		end
		local offers = type(raw.offers) == "table" and raw.offers[slot.id]
		if type(offers) == "table" then
			local list = {}
			for _, offer in ipairs(offers) do
				if validOffer(offer) and #list < SponsorConfig.OFFERS_PER_SLOT then
					table.insert(list, offer)
				end
			end
			clean.offers[slot.id] = list
		end
	end
	return clean
end

local function validLoan(loan)
	if type(loan) ~= "table" or (loan.type ~= "in" and loan.type ~= "out") or type(loan.club) ~= "string" then
		return nil
	end
	return {
		type = loan.type,
		club = loan.club:sub(1, 40),
		fee = math.max(0, math.floor(tonumber(loan.fee) or 0)),
		endSeason = math.max(1, math.floor(tonumber(loan.endSeason) or 1)),
	}
end

local function validPlayer(p)
	if type(p) ~= "table" or type(p.id) ~= "string" or #p.id > 20 or type(p.name) ~= "string" or #p.name > 40 then
		return nil
	end
	if not finiteNumber(p.age) or p.age < 14 or p.age > 45 then
		return nil
	end
	local posOk = false
	for _, pos in ipairs(FootballConfig.Positions) do
		if pos.id == p.pos then
			posOk = true
		end
	end
	if not posOk or type(p.attrs) ~= "table" then
		return nil
	end
	local attrs = {}
	for _, attr in ipairs(FootballConfig.Attributes) do
		local v = p.attrs[attr.id]
		if not finiteNumber(v) then
			return nil
		end
		attrs[attr.id] = math.clamp(v, 1, 99)
	end
	local focus = nil
	for _, attr in ipairs(FootballConfig.Attributes) do
		if attr.id == p.focus then
			focus = attr.id
		end
	end
	local stats = type(p.stats) == "table" and p.stats or {}
	return {
		id = p.id,
		name = p.name,
		age = math.floor(p.age),
		pos = p.pos,
		attrs = attrs,
		focus = focus,
		potential = math.clamp(math.floor(tonumber(p.potential) or 50), 1, 99),
		peak = math.clamp(tonumber(p.peak) or 0, 0, 99),
		salary = math.max(0, math.floor(tonumber(p.salary) or 0)),
		contract = math.clamp(math.floor(tonumber(p.contract) or 0), 0, FootballConfig.CONTRACT_MAX_SEASONS),
		origin = type(p.origin) == "string" and p.origin:sub(1, 12) or "start",
		joinedSeason = math.max(1, math.floor(tonumber(p.joinedSeason) or 1)),
		stats = {
			apps = math.max(0, math.floor(tonumber(stats.apps) or 0)),
			goals = math.max(0, math.floor(tonumber(stats.goals) or 0)),
			assists = math.max(0, math.floor(tonumber(stats.assists) or 0)),
		},
		loan = validLoan(p.loan), -- cesiones (FASE 6)
		listed = (p.listed == "sale" or p.listed == "loan") and p.listed or nil,
		fitness = math.clamp(tonumber(p.fitness) or 100, 0, 100),
		seasonStats = {
			apps = math.max(0, math.floor(tonumber(type(p.seasonStats) == "table" and p.seasonStats.apps) or 0)),
			goals = math.max(0, math.floor(tonumber(type(p.seasonStats) == "table" and p.seasonStats.goals) or 0)),
			assists = math.max(0, math.floor(tonumber(type(p.seasonStats) == "table" and p.seasonStats.assists) or 0)),
		},
		injury = math.clamp(math.floor(tonumber(p.injury) or 0), 0, 30),
	}
end

local function cleanPlayers(list, max)
	local clean, seen = {}, {}
	for _, p in ipairs(type(list) == "table" and list or {}) do
		local valid = validPlayer(p)
		if valid and not seen[valid.id] and #clean < max then
			seen[valid.id] = true
			table.insert(clean, valid)
		end
	end
	return clean
end

local function cleanDecorations(raw)
	local list = {}
	if type(raw) ~= "table" then
		return list
	end
	-- v1: { ["1"] = "flags", ... }  ->  v2: { { id, x, z, r }, ... }
	local v1 = {}
	for key, value in pairs(raw) do
		if type(value) == "string" and tonumber(key) then
			table.insert(v1, { slot = tonumber(key), id = value })
		end
	end
	if #v1 > 0 then
		table.sort(v1, function(a, b)
			return a.slot < b.slot
		end)
		for _, entry in ipairs(v1) do
			local pos = V1_SLOT_POSITIONS[entry.slot]
			if pos and CosmeticConfig.ById.decoration[entry.id] then
				table.insert(list, { id = entry.id, x = pos[1], z = pos[2], r = 0 })
			end
		end
		return list
	end
	for _, entry in ipairs(raw) do
		if type(entry) == "table" and CosmeticConfig.ById.decoration[entry.id]
			and finiteNumber(entry.x) and finiteNumber(entry.z) and finiteNumber(entry.r)
			and math.abs(entry.x) <= 150 and math.abs(entry.z) <= 105 then
			table.insert(list, { id = entry.id, x = entry.x, z = entry.z, r = entry.r % 360 })
		end
		if #list >= GameConfig.MAX_DECORATIONS then
			break
		end
	end
	return list
end

local function fillMissing(target, template)
	for key, value in pairs(template) do
		if target[key] == nil then
			target[key] = (type(value) == "table") and table.clone(value) or value
		elseif type(value) == "table" and type(target[key]) == "table" and next(value) ~= nil then
			-- solo se rellenan subtablas de tipo diccionario de la plantilla
			if #value == 0 then
				fillMissing(target[key], value)
			end
		end
	end
end

local function clampNumber(value, min, max, default)
	value = tonumber(value)
	if value == nil or value ~= value then -- NaN
		return default
	end
	return math.clamp(value, min, max)
end

local function validItem(catalog, id, appliesTo)
	local item = CosmeticConfig.ById[catalog][id]
	if not item then
		return false
	end
	if appliesTo and item.appliesTo ~= appliesTo then
		return false
	end
	return true
end

-- Repara y valida datos cargados (nunca confía en que estén bien formados).
function DefaultData.Reconcile(data, player)
	if type(data) ~= "table" then
		return DefaultData.Create(player)
	end
	local template = DefaultData.Create(player)
	fillMissing(data, template)

	-- Club
	local club = data.club
	club.fans = math.floor(clampNumber(club.fans, 0, 1e9, GameConfig.STARTING_FANS))
	club.reputationEarned = math.floor(clampNumber(club.reputationEarned, 0, 1e6, 0))
	club.members = math.floor(clampNumber(club.members, 0, club.fans, 0))
	club.satisfaction = clampNumber(club.satisfaction, 0, 100, GameConfig.SATISFACTION_START)
	if type(club.name) ~= "string" then
		club.name = ""
	end
	if type(club.shortName) ~= "string" then
		club.shortName = ""
	end
	if player then
		club.ownerName = player.DisplayName
	end
	for slot, rule in pairs(CosmeticConfig.AppearanceSlots) do
		if not validItem(rule.catalog, club.appearance[slot], rule.appliesTo) then
			club.appearance[slot] = CosmeticConfig.Defaults[slot]
		end
	end

	-- Estadio
	local stadium = data.stadium
	stadium.stage = math.floor(clampNumber(stadium.stage, 1, #StadiumStages, 1))
	local cleanFacilities = {}
	for id, def in pairs(FacilityConfig.Facilities) do
		local level = math.floor(clampNumber(stadium.facilities[id], 0, #def.levels, def.startLevel))
		level = math.max(level, def.startLevel)
		if level > 0 then
			cleanFacilities[id] = level
		end
	end
	stadium.facilities = cleanFacilities
	stadium.decorations = cleanDecorations(stadium.decorations)

	-- Historial de eventos
	if type(data.history) ~= "table" then
		data.history = {}
	end
	while #data.history > GameConfig.MAX_HISTORY_EVENTS do
		table.remove(data.history, 1)
	end

	-- Economía
	local economy = data.economy
	economy.money = math.floor(clampNumber(economy.money, 0, 1e12, GameConfig.STARTING_MONEY))
	economy.debt = math.floor(clampNumber(economy.debt, 0, 1e12, 0))
	local validTicket = false
	for _, option in ipairs(GameConfig.TICKET_PRICES) do
		if option.id == economy.ticketPrice then
			validTicket = true
		end
	end
	if not validTicket then
		economy.ticketPrice = GameConfig.DEFAULT_TICKET
	end
	local function validId(list, id)
		for _, option in ipairs(list) do
			if option.id == id then
				return true
			end
		end
		return false
	end
	if not validId(GameConfig.MEMBER_PRICES, economy.memberPrice) then
		economy.memberPrice = "NORMAL"
	end
	if not validId(CommercialConfig.PricePolicies, economy.shopPrice) then
		economy.shopPrice = CommercialConfig.DEFAULT_POLICY
	end
	if not validId(CommercialConfig.PricePolicies, economy.foodPrice) then
		economy.foodPrice = CommercialConfig.DEFAULT_POLICY
	end

	-- Patrocinadores
	data.sponsors = cleanSponsors(data.sponsors)

	-- Plantilla y cantera (FASE 4)
	data.squad = cleanPlayers(data.squad, FootballConfig.MAX_SQUAD + 5)
	if type(data.academy) ~= "table" then
		data.academy = {}
	end
	data.academy.youths = cleanPlayers(data.academy.youths, 12)
	data.academy.reports = cleanPlayers(data.academy.reports, FootballConfig.MAX_SCOUTS)
	data.academy.scouts = math.clamp(math.floor(tonumber(data.academy.scouts) or 0), 0, FootballConfig.MAX_SCOUTS)
	data.academy.nextReport = math.max(0, math.floor(tonumber(data.academy.nextReport) or 0))
	data.academy.seededIntake = data.academy.seededIntake == true
	if type(data.training) ~= "table" or not FootballConfig.Intensity(data.training.intensity) or FootballConfig.Intensity(data.training.intensity).id ~= data.training.intensity then
		data.training = { intensity = "NORMAL" }
	end
	if type(data.season) ~= "table" then
		data.season = {}
	end
	data.season.number = math.max(1, math.floor(tonumber(data.season.number) or 1))
	data.season.cycle = math.clamp(math.floor(tonumber(data.season.cycle) or 0), 0, FootballConfig.SEASON_LENGTH - 1)
	if type(data.legends) ~= "table" then
		data.legends = {}
	end
	-- El contador de IDs nunca puede quedar por debajo de un ID existente
	local maxId = math.max(0, math.floor(tonumber(data.nextPlayerId) or 0))
	local function bump(list)
		for _, p in ipairs(list) do
			local n = tonumber(p.id:match("^p(%d+)$"))
			if n and n > maxId then
				maxId = n
			end
		end
	end
	bump(data.squad)
	bump(data.academy.youths)
	bump(data.academy.reports)
	data.nextPlayerId = maxId

	-- Tácticas y partidos (FASE 5)
	if type(data.tactics) ~= "table" then
		data.tactics = {}
	end
	data.tactics.formation = TacticsConfig.Formation(data.tactics.formation).id
	data.tactics.mentality = TacticsConfig.Mentality(data.tactics.mentality).id
	data.tactics.style = TacticsConfig.Style(data.tactics.style).id
	local lineup = {}
	for i = 1, 11 do
		local id = type(data.tactics.lineup) == "table" and data.tactics.lineup[i]
		lineup[i] = type(id) == "string" and id or ""
	end
	data.tactics.lineup = lineup
	if type(data.friendlies) ~= "table" then
		data.friendlies = {}
	end
	data.friendlies.offers = type(data.friendlies.offers) == "table" and data.friendlies.offers or {}
	for _, offer in ipairs(data.friendlies.offers) do
		if type(offer) ~= "table" or not finiteNumber(offer.strength) or type(offer.name) ~= "string" then
			data.friendlies.offers = {}
			break
		end
	end
	data.friendlies.lastCycle = math.floor(tonumber(data.friendlies.lastCycle) or -1)
	if type(data.matches) ~= "table" then
		data.matches = {}
	end
	while #data.matches > TacticsConfig.MAX_MATCH_HISTORY do
		table.remove(data.matches, 1)
	end
	if type(data.records) ~= "table" then
		data.records = {}
	end

	-- Liga y palmarés (FASE 7). Si la estructura no es válida se descarta y
	-- LeagueService crea una liga nueva (el historial de temporadas se conserva si es válido).
	local league = data.league
	if league ~= nil then
		local valid = type(league) == "table" and finiteNumber(league.season) and finiteNumber(league.division)
			and type(league.teams) == "table" and type(league.fixtures) == "table" and type(league.results) == "table"
			and type(league.cup) == "table" and type(league.cupTeams) == "table"
		if valid then
			for _, t in ipairs(league.teams) do
				if type(t) ~= "table" or type(t.id) ~= "string" or type(t.name) ~= "string" or not finiteNumber(t.strength) then
					valid = false
				end
			end
		end
		if not valid then
			local history = type(league) == "table" and type(league.history) == "table" and league.history or nil
			data.league = history and { history = history } or nil
			if data.league then
				data.league.season = nil
			end
		end
	end
	local trophies = {}
	for _, t in ipairs(type(data.trophies) == "table" and data.trophies or {}) do
		if type(t) == "table" and type(t.kind) == "string" and type(t.name) == "string" and finiteNumber(t.season) then
			table.insert(trophies, t)
		end
	end
	data.trophies = trophies

	-- Historia y universo (FASE 8)
	local allTime, count = {}, 0
	for id, s in pairs(type(data.allTimeStats) == "table" and data.allTimeStats or {}) do
		if type(id) == "string" and type(s) == "table" and type(s.name) == "string" and count < 200 then
			count += 1
			allTime[id] = {
				name = s.name:sub(1, 40), pos = type(s.pos) == "string" and s.pos or "MID", origin = type(s.origin) == "string" and s.origin or "start",
				apps = math.max(0, math.floor(tonumber(s.apps) or 0)),
				goals = math.max(0, math.floor(tonumber(s.goals) or 0)),
				assists = math.max(0, math.floor(tonumber(s.assists) or 0)),
			}
		end
	end
	data.allTimeStats = allTime
	if type(data.reputationHistory) ~= "table" then
		data.reputationHistory = {}
	end
	while #data.reputationHistory > 60 do
		table.remove(data.reputationHistory, 1)
	end
	if type(data.universe) ~= "table" then
		data.universe = {}
	end
	data.universe.claimedWeek = math.floor(tonumber(data.universe.claimedWeek) or -1)
	data.universe.week = math.floor(tonumber(data.universe.week) or -1)
	data.universe.weekPoints = math.max(0, math.floor(tonumber(data.universe.weekPoints) or 0))

	-- Evento de Halloween y desbloqueos
	if type(data.halloween) ~= "table" then
		data.halloween = {}
	end
	data.halloween.candy = math.max(0, math.floor(tonumber(data.halloween.candy) or 0))
	data.halloween.total = math.max(data.halloween.candy, math.floor(tonumber(data.halloween.total) or 0))
	local unlocks = {}
	for _, reward in ipairs(HalloweenConfig.Rewards) do
		if reward.unlock and type(data.unlocks) == "table" and data.unlocks[reward.unlock] == true then
			unlocks[reward.unlock] = true
		end
	end
	data.unlocks = unlocks

	-- Mercado (FASE 6)
	if type(data.market) ~= "table" then
		data.market = {}
	end
	local listings = {}
	for _, l in ipairs(type(data.market.listings) == "table" and data.market.listings or {}) do
		local p = type(l) == "table" and validPlayer(l.player)
		if p and type(l.id) == "string" and (l.kind == "buy" or l.kind == "free" or l.kind == "loan")
			and finiteNumber(l.asking) and finiteNumber(l.loanFee) and finiteNumber(l.bonus) and type(l.club) == "string" then
			table.insert(listings, { id = l.id, kind = l.kind, club = l.club, asking = l.asking, loanFee = l.loanFee, bonus = l.bonus, player = p })
		end
	end
	data.market.listings = listings
	data.market.rejected = type(data.market.rejected) == "table" and data.market.rejected or {}
	data.market.nextRefresh = math.max(0, math.floor(tonumber(data.market.nextRefresh) or 0))
	local offers = {}
	for _, o in ipairs(type(data.transferOffers) == "table" and data.transferOffers or {}) do
		if type(o) == "table" and type(o.id) == "string" and type(o.playerId) == "string" and finiteNumber(o.fee)
			and o.fee >= 0 and finiteNumber(o.expires) and type(o.club) == "string" then
			table.insert(offers, o)
		end
	end
	data.transferOffers = offers
	local share = tonumber(economy.transferShare)
	local shareOk = false
	for _, allowed in ipairs(TransferConfig.BudgetShares) do
		if share == allowed then
			shareOk = true
		end
	end
	economy.transferShare = shareOk and share or TransferConfig.DEFAULT_BUDGET_SHARE
	for _, l in ipairs(listings) do
		local n = tonumber(l.player.id:match("^p(%d+)$"))
		if n and n > data.nextPlayerId then
			data.nextPlayerId = n
		end
	end
	if type(economy.transactions) ~= "table" then
		economy.transactions = {}
	end
	while #economy.transactions > GameConfig.MAX_TRANSACTIONS do
		table.remove(economy.transactions, 1)
	end

	-- Ajustes
	data.settings.uiScale = clampNumber(data.settings.uiScale, 0.8, 1.3, 1)
	data.settings.notifications = data.settings.notifications ~= false
	data.settings.compactMenu = data.settings.compactMenu == true

	data.version = GameConfig.DATA_VERSION
	return data
end

return DefaultData
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000030"><Properties><string name="Name">PlayerFactory</string><ProtectedString name="Source"><![CDATA[-- PlayerFactory (ModuleScript)
-- Ubicación: ServerScriptService/Server/Util/PlayerFactory
-- Genera futbolistas ficticios en el SERVIDOR (el cliente nunca crea jugadores).

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage.Shared
local FootballConfig = require(Shared.Config.FootballConfig)
local FootballFormulas = require(Shared.Modules.FootballFormulas)

local PlayerFactory = {}

local rng = Random.new()

function PlayerFactory.RandomName()
	local first = FootballConfig.FirstNames[rng:NextInteger(1, #FootballConfig.FirstNames)]
	local last = FootballConfig.LastNames[rng:NextInteger(1, #FootballConfig.LastNames)]
	return first .. " " .. last
end

function PlayerFactory.NextId(data)
	data.nextPlayerId = (data.nextPlayerId or 0) + 1
	return "p" .. data.nextPlayerId
end

-- Atributos alrededor de una media objetivo con el perfil de la posición.
local function makeAttrs(pos, target)
	local attrs = {}
	local bias = FootballConfig.Bias[pos] or FootballConfig.Bias.MID
	for _, attr in ipairs(FootballConfig.Attributes) do
		attrs[attr.id] = math.clamp(target + bias[attr.id] + rng:NextInteger(-6, 6), 5, 95)
	end
	-- Ajuste fino para que la media quede en el objetivo
	local probe = { pos = pos, attrs = attrs }
	local diff = target - FootballFormulas.Overall(probe)
	for id, value in pairs(attrs) do
		attrs[id] = math.clamp(value + diff, 5, 95)
	end
	return attrs
end

local function potentialFor(age, ovr)
	local gap
	if age <= 21 then
		gap = rng:NextInteger(5, 25)
	elseif age <= 25 then
		gap = rng:NextInteger(2, 12)
	elseif age <= 28 then
		gap = rng:NextInteger(0, 5)
	else
		gap = 0
	end
	return math.clamp(math.floor(ovr + gap + 0.5), 1, 97)
end

-- opts: { pos, overall, age, potential?, origin, contract? }
function PlayerFactory.Create(data, opts)
	local attrs = makeAttrs(opts.pos, opts.overall)
	local player = {
		id = PlayerFactory.NextId(data),
		name = PlayerFactory.RandomName(),
		age = opts.age,
		pos = opts.pos,
		attrs = attrs,
		focus = nil,
		origin = opts.origin or "start",
		joinedSeason = data.season.number,
		stats = { apps = 0, goals = 0, assists = 0 },
		fitness = 100, -- forma física 0-100 (FASE 5)
		injury = 0, -- jornadas de baja (FASE 5)
	}
	local ovr = FootballFormulas.Overall(player)
	player.potential = opts.potential or potentialFor(opts.age, ovr)
	player.peak = ovr
	player.salary = FootballFormulas.SalaryDemand(player)
	player.contract = opts.contract or rng:NextInteger(1, 3)
	return player
end

function PlayerFactory.StartingSquad(data)
	local squad = {}
	local range = FootballConfig.STARTING_OVERALL
	for _, position in ipairs(FootballConfig.Positions) do
		for _ = 1, FootballConfig.STARTING_SQUAD[position.id] or 0 do
			table.insert(squad, PlayerFactory.Create(data, {
				pos = position.id,
				overall = rng:NextInteger(range.min, range.max),
				age = rng:NextInteger(18, 33),
				origin = "start",
			}))
		end
	end
	return squad
end

-- Juvenil para la cantera. academyLevel y scouts condicionan el potencial.
function PlayerFactory.Youth(data, academyLevel, scouts)
	local academy = FootballConfig.Academy(academyLevel)
	local bonus = (scouts or 0) * FootballConfig.SCOUT_POTENTIAL_BONUS
	local potential = rng:NextInteger(academy.potentialMin + bonus, academy.potentialMax + bonus)
	local gem = rng:NextNumber() < FootballConfig.GEM_CHANCE + (scouts or 0) * FootballConfig.GEM_CHANCE_PER_SCOUT
	if gem then
		potential += FootballConfig.GEM_BONUS
	end
	local positions = FootballConfig.Positions
	local youth = PlayerFactory.Create(data, {
		pos = positions[rng:NextInteger(1, #positions)].id,
		overall = rng:NextInteger(FootballConfig.YOUTH_OVERALL.min, FootballConfig.YOUTH_OVERALL.max),
		age = rng:NextInteger(FootballConfig.YOUTH_START_AGE.min, FootballConfig.YOUTH_START_AGE.max),
		potential = math.clamp(potential, 40, 97),
		origin = "academy",
		contract = 0,
	})
	youth.salary = 0 -- los juveniles no cobran salario de primer equipo
	return youth
end

return PlayerFactory
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000031"><Properties><string name="Name">RateLimiter</string><ProtectedString name="Source"><![CDATA[-- RateLimiter (ModuleScript)
-- Ubicación: ServerScriptService/Server/Util/RateLimiter
-- Limita cuántas acciones puede enviar cada jugador por ventana de tiempo.

local RateLimiter = {}
RateLimiter.__index = RateLimiter

function RateLimiter.new(maxActions, windowSeconds)
	return setmetatable({
		max = maxActions,
		window = windowSeconds,
		buckets = {},
	}, RateLimiter)
end

function RateLimiter:Allow(player)
	local now = os.clock()
	local bucket = self.buckets[player]
	if not bucket or now - bucket.start >= self.window then
		bucket = { start = now, count = 0 }
		self.buckets[player] = bucket
	end
	bucket.count += 1
	return bucket.count <= self.max
end

function RateLimiter:Remove(player)
	self.buckets[player] = nil
end

return RateLimiter
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000032"><Properties><string name="Name">Retry</string><ProtectedString name="Source"><![CDATA[-- Retry (ModuleScript)
-- Ubicación: ServerScriptService/Server/Util/Retry
-- Ejecuta una función con pcall y reintentos controlados con espera exponencial.

local Retry = {}

-- Devuelve: ok, resultado (o mensaje de error del último intento)
function Retry.Call(attempts, baseDelay, fn, ...)
	local lastError
	for attempt = 1, attempts do
		local ok, result = pcall(fn, ...)
		if ok then
			return true, result
		end
		lastError = result
		if attempt < attempts then
			task.wait(baseDelay * (2 ^ (attempt - 1)))
		end
	end
	return false, lastError
end

return Retry
]]></ProtectedString></Properties></Item></Item></Item></Item><Item class="StarterPlayer" referent="RBX00000051"><Properties><string name="Name">StarterPlayer</string></Properties><Item class="StarterPlayerScripts" referent="RBX00000050"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="Folder" referent="RBX0000004F"><Properties><string name="Name">Client</string></Properties><Item class="Folder" referent="RBX00000037"><Properties><string name="Name">Controllers</string></Properties><Item class="ModuleScript" referent="RBX00000036"><Properties><string name="Name">PlacementController</string><ProtectedString name="Source"><![CDATA[-- PlacementController (ModuleScript)
-- Ubicación: StarterPlayer/StarterPlayerScripts/Client/Controllers/PlacementController
--
-- CONSTRUCCIÓN AVANZADA (FASE 2): modo de colocación libre de decoraciones.
--   * Vista previa (fantasma) que sigue al ratón o al dedo sobre tu terreno.
--   * Verde = colocación válida, rojo = no válida (con el motivo).
--   * PC: clic para colocar, R para rotar, Q o Esc para cancelar.
--   * Móvil/tableta: toca para mover la vista previa y usa los botones.
-- La validación del cliente (PlacementRules) es solo orientativa: el servidor
-- repite exactamente las mismas comprobaciones antes de aceptar nada.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local CosmeticConfig = require(Shared.Config.CosmeticConfig)
local PlacementRules = require(Shared.Modules.PlacementRules)
local StadiumLayout = require(Shared.Modules.StadiumLayout)

local UI = script.Parent.Parent:WaitForChild("UI")
local Theme = require(UI.Theme)
local C = require(UI.Components)

local player = Players.LocalPlayer

local PlacementController = {}
PlacementController.Active = false

local session -- estado de la colocación en curso

local function findPlotOrigin()
	local world = Workspace:FindFirstChild("FEU_World")
	local plots = world and world:FindFirstChild("Plots")
	if not plots then
		return nil
	end
	for _, model in ipairs(plots:GetChildren()) do
		if model:GetAttribute("OwnerUserId") == player.UserId then
			local base = model:FindFirstChild("Base")
			if base then
				-- La cara superior de la base es el plano local y = 0
				return base.CFrame * CFrame.new(0, base.Size.Y / 2, 0)
			end
		end
	end
	return nil
end

local function makeZoneMarker(parent, origin, rect, color, transparency)
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Material = Enum.Material.Neon
	p.Color = color
	p.Transparency = transparency
	p.Size = Vector3.new(rect.xMax - rect.xMin, 0.15, rect.zMax - rect.zMin)
	p.CFrame = origin * CFrame.new((rect.xMin + rect.xMax) / 2, 0.2, (rect.zMin + rect.zMax) / 2)
	p.Parent = parent
	return p
end

local function cleanup()
	if not session then
		return
	end
	for _, connection in ipairs(session.connections) do
		connection:Disconnect()
	end
	if session.folder then
		session.folder:Destroy()
	end
	if session.hud then
		session.hud:Destroy()
	end
	session = nil
	PlacementController.Active = false
end

local function validate()
	local s = session
	return PlacementRules.Validate({
		decorations = s.ctx.state.stadium.decorations,
		decoId = s.decoId,
		x = s.x,
		z = s.z,
		rotation = s.rotation,
		isPro = s.isPro,
		ignoreIndex = s.moveIndex,
	})
end

local function refreshGhost()
	local s = session
	if not s then
		return
	end
	s.ghost.CFrame = s.origin * CFrame.new(s.x, 1.5, s.z) * CFrame.Angles(0, math.rad(s.rotation), 0)
	local ok, reason = validate()
	s.valid = ok
	s.ghost.Color = ok and Theme.Accent or Theme.Danger
	s.statusLabel.Text = string.format("%s  ·  %s  ·  x %d, z %d, %d°",
		s.item.name, ok and "✅ Colocación válida" or ("⛔ " .. (reason or "No válida")),
		s.x, s.z, s.rotation)
	s.statusLabel.TextColor3 = ok and Theme.Text or Theme.Warning
end

-- Convierte una posición de pantalla en coordenadas locales del terreno (plano y = 0).
-- fromTouch = true: posición sin el margen de la barra superior (ScreenPointToRay).
local function screenToLocal(screenPos, fromTouch)
	local s = session
	local camera = Workspace.CurrentCamera
	local ray = fromTouch and camera:ScreenPointToRay(screenPos.X, screenPos.Y)
		or camera:ViewportPointToRay(screenPos.X, screenPos.Y)
	local planeY = s.origin.Position.Y
	if math.abs(ray.Direction.Y) < 1e-4 then
		return nil
	end
	local t = (planeY - ray.Origin.Y) / ray.Direction.Y
	if t < 0 or t > 2000 then
		return nil
	end
	local worldPoint = ray.Origin + ray.Direction * t
	return s.origin:PointToObjectSpace(worldPoint)
end

local function moveTo(screenPos, fromTouch)
	local s = session
	local localPoint = screenToLocal(screenPos, fromTouch)
	if not localPoint then
		return
	end
	local grid = s.tools.grid
	local x = PlacementRules.Snap(localPoint.X, grid)
	local z = PlacementRules.Snap(localPoint.Z, grid)
	-- Mantener la vista previa cerca de la plaza para que sea fácil de encontrar
	x = math.clamp(x, -StadiumLayout.HALF_X, StadiumLayout.HALF_X)
	z = math.clamp(z, -StadiumLayout.HALF_Z, StadiumLayout.HALF_Z)
	if x ~= s.x or z ~= s.z then
		s.x, s.z = x, z
		refreshGhost()
	end
end

local function rotate()
	local s = session
	s.rotation = (s.rotation + s.tools.rotationStep) % 360
	refreshGhost()
end

local function confirm()
	local s = session
	if not s or s.busy then
		return
	end
	if not s.valid then
		local _, reason = validate()
		s.ctx.notify("error", reason or "Colocación no válida.")
		return
	end
	s.busy = true
	local action = s.moveIndex and "MoveDecoration" or "PlaceDecoration"
	local result = s.ctx.act(action, {
		decoration = s.decoId,
		index = s.moveIndex,
		x = s.x,
		z = s.z,
		rotation = s.rotation,
	})
	if not session then
		return
	end
	s.busy = false
	if result.ok then
		local onFinish = s.onFinish
		cleanup()
		if onFinish then
			onFinish(true)
		end
	end
end

function PlacementController.Cancel()
	if not session then
		return
	end
	local onFinish = session.onFinish
	cleanup()
	if onFinish then
		onFinish(false)
	end
end

local function buildHud(s)
	local hud = C.New("ScreenGui", {
		Name = "FEU_Placement",
		ResetOnSpawn = false,
		DisplayOrder = 5,
	}, player:WaitForChild("PlayerGui"))
	local top = C.New("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 70),
		Size = UDim2.new(0.9, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = Theme.Panel,
		Children = {
			C.Corner(), C.Stroke(Theme.Accent, 2), C.Padding(10, 14), C.List(nil, 4),
			C.New("UISizeConstraint", { MaxSize = Vector2.new(720, math.huge) }),
		},
	}, hud)
	C.Label("🏗️ <b>MODO CONSTRUCCIÓN</b>", { TextSize = 16, LayoutOrder = 1 }).Parent = top
	s.statusLabel = C.Label("", { TextSize = 14, LayoutOrder = 2 })
	s.statusLabel.Parent = top
	local hint = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
		and "Toca tu plaza para mover la vista previa. Zona azul = permitida, zonas rojas = reservadas."
		or "Mueve el ratón · Clic: colocar · R: rotar · Q/Esc: cancelar. Zona azul = permitida, zonas rojas = reservadas."
	C.Label(string.format("%s  Rejilla %d stud(s), rotación %d°%s.", hint, s.tools.grid, s.tools.rotationStep,
		s.isPro and " (Constructor Pro)" or ""), { TextSize = 12, TextColor3 = Theme.TextDim, LayoutOrder = 3 }).Parent = top

	local bar = C.Row({
		C.Button("⟳ Rotar", "secondary", rotate, { Size = UDim2.new(0, 120, 0, 50), AutomaticSize = Enum.AutomaticSize.None }),
		C.Button("✔ Confirmar", "primary", confirm, { Size = UDim2.new(0, 150, 0, 50), AutomaticSize = Enum.AutomaticSize.None }),
		C.Button("✕ Cancelar", "danger", PlacementController.Cancel, { Size = UDim2.new(0, 130, 0, 50), AutomaticSize = Enum.AutomaticSize.None }),
	}, 10, {
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -24),
		Size = UDim2.new(0, 430, 0, 50),
		AutomaticSize = Enum.AutomaticSize.None,
	})
	bar.Parent = hud
	return hud
end

-- opts = { decoId, moveIndex?, onFinish(placed:boolean)? }
function PlacementController.Start(ctx, opts)
	if session then
		PlacementController.Cancel()
	end
	local item = CosmeticConfig.ById.decoration[opts.decoId]
	local origin = findPlotOrigin()
	if not item or not origin then
		ctx.notify("error", "No se encontró tu terreno. Espera a que se cargue tu estadio.")
		return false
	end
	local existing = opts.moveIndex and ctx.state.stadium.decorations[opts.moveIndex]
	local tools = ctx.state.stadium.tools
	session = {
		ctx = ctx,
		item = item,
		decoId = opts.decoId,
		moveIndex = opts.moveIndex,
		onFinish = opts.onFinish,
		origin = origin,
		tools = tools,
		isPro = ctx.state.premium.owned.CONSTRUCTOR_PRO == true,
		rotation = existing and existing.r or 0,
		x = existing and existing.x or 40,
		z = existing and existing.z or 88,
		connections = {},
	}
	local s = session
	PlacementController.Active = true

	s.folder = Instance.new("Folder")
	s.folder.Name = "FEU_PlacementPreview"
	s.folder.Parent = Workspace.CurrentCamera
	for _, zone in ipairs(StadiumLayout.DecorationZones) do
		makeZoneMarker(s.folder, origin, zone, Theme.Info, 0.8)
	end
	for _, reserved in ipairs(StadiumLayout.Reserved) do
		makeZoneMarker(s.folder, origin, reserved, Theme.Danger, 0.75)
	end
	s.ghost = Instance.new("Part")
	s.ghost.Anchored = true
	s.ghost.CanCollide = false
	s.ghost.CanQuery = false
	s.ghost.CanTouch = false
	s.ghost.CastShadow = false
	s.ghost.Material = Enum.Material.ForceField
	s.ghost.Transparency = 0.2
	s.ghost.Size = Vector3.new(item.w, 3, item.d)
	s.ghost.Parent = s.folder

	s.hud = buildHud(s)
	refreshGhost()

	local usingMouse = UserInputService.MouseEnabled
	table.insert(s.connections, RunService.RenderStepped:Connect(function()
		if session and usingMouse and not s.busy then
			moveTo(UserInputService:GetMouseLocation())
		end
	end))
	table.insert(s.connections, UserInputService.InputBegan:Connect(function(input, processed)
		if not session then
			return
		end
		if input.UserInputType == Enum.UserInputType.Touch then
			usingMouse = false
		end
		if processed then
			return
		end
		if input.KeyCode == Enum.KeyCode.R then
			rotate()
		elseif input.KeyCode == Enum.KeyCode.Q or input.KeyCode == Enum.KeyCode.Escape then
			PlacementController.Cancel()
		elseif input.UserInputType == Enum.UserInputType.MouseButton1 then
			usingMouse = true
			confirm()
		end
	end))
	table.insert(s.connections, UserInputService.TouchTap:Connect(function(positions, processed)
		if session and not processed and positions[1] then
			-- TouchTap da posiciones de pantalla sin el margen de la barra superior
			moveTo(Vector2.new(positions[1].X, positions[1].Y), true)
		end
	end))
	return true
end

return PlacementController
]]></ProtectedString></Properties></Item></Item><Item class="LocalScript" referent="RBX00000038"><Properties><string name="Name">Main</string><ProtectedString name="Source"><![CDATA[-- Main (LocalScript)
-- Ubicación: StarterPlayer/StarterPlayerScripts/Client/Main
--
-- Interfaz principal: barra superior, menú principal adaptable (PC / móvil / tableta),
-- pantallas y notificaciones. El cliente SOLO muestra datos y envía intenciones;
-- el servidor valida todo y responde con el estado real.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local player = Players.LocalPlayer
local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.Config.GameConfig)
local MenuConfig = require(Shared.Config.MenuConfig)
local Format = require(Shared.Modules.Format)
local Remotes = require(Shared.Modules.Remotes)
local CosmeticConfig = require(Shared.Config.CosmeticConfig)

local UI = script.Parent:WaitForChild("UI")
local Theme = require(UI.Theme)
local C = require(UI.Components)
local Notifier = require(UI.Notifier)

local ScreensFolder = script.Parent:WaitForChild("Screens")
local Screens = {
	home = require(ScreensFolder.Home),
	club = require(ScreensFolder.Club),
	stadium = require(ScreensFolder.Stadium),
	build = require(ScreensFolder.Build),
	economy = require(ScreensFolder.Economy),
	shop = require(ScreensFolder.Shop),
	settings = require(ScreensFolder.Settings),
	squad = require(ScreensFolder.Squad),
	academy = require(ScreensFolder.Academy),
	matches = require(ScreensFolder.Matches),
	transfers = require(ScreensFolder.Transfers),
	leagues = require(ScreensFolder.Leagues),
	universe = require(ScreensFolder.Universe),
	history = require(ScreensFolder.History),
}
local ComingSoon = require(ScreensFolder.ComingSoon)
local PlacementController = require(script.Parent:WaitForChild("Controllers"):WaitForChild("PlacementController"))

local actionRemote = Remotes.Get("Action")
local stateRemote = Remotes.Get("State")
local notifyRemote = Remotes.Get("Notify")
local shopRemote = Remotes.Get("Shop")

-- ===== Estado del cliente =====
local ctx = {
	state = nil,
	shop = nil,
	stateReceivedAt = os.clock(),
	drafts = {},
	params = {},
	current = "home",
	compact = false,
	C = C,
	Theme = Theme,
	Format = Format,
}

local gui, panel, content, navFrame, topBar, uiScale, countdownLabel
local panelOpen = false -- se empieza jugando en el estadio; el menú se abre con M o el botón MENÚ

local function notify(kind, message)
	if ctx.state and ctx.state.settings and ctx.state.settings.notifications == false and kind == "success" then
		return
	end
	Notifier.Show(kind, message)
end
ctx.notify = notify

function ctx.act(actionName, payload)
	local ok, result = pcall(function()
		return actionRemote:InvokeServer(actionName, payload)
	end)
	if not ok or type(result) ~= "table" then
		Notifier.Show("error", "No hay conexión con el servidor. Inténtalo de nuevo.")
		return { ok = false }
	end
	if result.message then
		Notifier.Show(result.ok and "success" or "error", result.message)
	end
	return result
end

local renderCurrent -- declarada más abajo
local buildTopBar -- declarada más abajo

function ctx.navigate(screenId, params)
	ctx.current = screenId
	ctx.params = params or {}
	if not panelOpen then
		panelOpen = true
		panel.Visible = true
	end
	renderCurrent(false)
end

function ctx.close()
	panelOpen = false
	panel.Visible = false
end

-- Modo construcción: cierra el menú, coloca en el mundo y vuelve a Construcción › Decoración.
function ctx.startPlacement(opts)
	ctx.close()
	buildTopBar()
	local started = PlacementController.Start(ctx, {
		decoId = opts.decoId,
		moveIndex = opts.moveIndex,
		onFinish = function()
			ctx.navigate("build", { tab = "decor" })
			buildTopBar()
		end,
	})
	if not started then
		ctx.navigate("build", { tab = "decor" })
	end
end

function ctx.secondsToNextCycle()
	if not ctx.state then
		return 0
	end
	local elapsed = os.clock() - ctx.stateReceivedAt
	local remaining = ctx.state.economy.nextCycleIn - elapsed
	local cycle = ctx.state.economy.cycleSeconds
	while remaining < 0 do
		remaining += cycle
	end
	return remaining
end

-- ===== Barra superior =====
buildTopBar = function()
	if topBar then
		topBar:Destroy()
	end
	local state = ctx.state
	topBar = C.New("Frame", {
		Name = "TopBar",
		BackgroundColor3 = Theme.Background,
		BackgroundTransparency = 0.1,
		Size = UDim2.new(1, 0, 0, 56),
		BorderSizePixel = 0,
		Children = { C.Padding(8, 12), C.Stroke(Theme.Stroke, 1, 0.5) },
	}, gui)
	local row = C.New("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -110, 1, 0),
		Children = {
			C.New("UIListLayout", {
				FillDirection = Enum.FillDirection.Horizontal,
				Padding = UDim.new(0, 14),
				VerticalAlignment = Enum.VerticalAlignment.Center,
				SortOrder = Enum.SortOrder.LayoutOrder,
			}),
		},
	}, topBar)
	local add = C.Stack(row)

	if state then
		local crest = CosmeticConfig.ById.crest[state.club.effectiveAppearance.crest]
		add(C.Label((crest and crest.symbol or "⚽") .. "  " .. state.club.name, {
			Font = Theme.FontBlack, TextSize = 18, Size = UDim2.new(0, 0, 1, 0),
			AutomaticSize = Enum.AutomaticSize.X, TextWrapped = false, Visible = not ctx.compact,
		}))
		if state.premium.owned.VIP_CLUB then
			add(C.Badge("👑 VIP", Theme.Gold, Color3.fromRGB(35, 25, 0)))
		end
		local function stat(text, color)
			return C.Label(text, {
				Font = Theme.FontBold, TextSize = 16, TextColor3 = color or Theme.Text,
				Size = UDim2.new(0, 0, 1, 0), AutomaticSize = Enum.AutomaticSize.X, TextWrapped = false,
			})
		end
		add(stat("💰 " .. Format.Money(state.economy.money), Theme.Gold))
		if state.economy.debt > 0 then
			add(stat("📉 " .. Format.Money(state.economy.debt), Theme.Danger))
		end
		if not ctx.compact then
			add(stat("👥 " .. Format.Short(state.club.fans)))
			add(stat("⭐ " .. tostring(state.economy.reputation)))
			add(stat("😊 " .. tostring(math.floor((state.club.satisfaction or 0) + 0.5))))
		end
		countdownLabel = add(stat("⏱️ --:--", Theme.TextDim))
		if state.halloween and state.halloween.active then
			add(stat("🍬 " .. tostring(state.halloween.candy), Color3.fromRGB(255, 150, 40)))
		end
		if not state.saveEnabled then
			add(C.Badge("⚠️ Sin guardado", Theme.Warning, Color3.fromRGB(40, 20, 0)))
		end
	else
		add(C.Label("⚽ " .. GameConfig.GAME_NAME .. " · Cargando tu club…", {
			Font = Theme.FontBlack, TextSize = 18, Size = UDim2.new(0, 0, 1, 0),
			AutomaticSize = Enum.AutomaticSize.X, TextWrapped = false,
		}))
	end

	C.Button(panelOpen and "✕ MENÚ" or "☰ MENÚ", "primary", function()
		panelOpen = not panelOpen
		panel.Visible = panelOpen
		buildTopBar()
		if panelOpen then
			renderCurrent(false)
		end
	end, {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, 0, 0.5, 0),
		Size = UDim2.new(0, 100, 0, 40),
		AutomaticSize = Enum.AutomaticSize.None,
	}).Parent = topBar
end

-- ===== Menú principal =====
local function buildNav()
	navFrame:ClearAllChildren()
	local horizontal = ctx.compact
	local iconsOnly = (not horizontal) and ctx.state and ctx.state.settings.compactMenu
	C.New("UIListLayout", {
		FillDirection = horizontal and Enum.FillDirection.Horizontal or Enum.FillDirection.Vertical,
		Padding = UDim.new(0, 4),
		SortOrder = Enum.SortOrder.LayoutOrder,
	}, navFrame)
	C.Padding(6).Parent = navFrame
	for i, entry in ipairs(MenuConfig) do
		local available = entry.phase <= MenuConfig.CURRENT_PHASE
		local selected = ctx.current == entry.id
		local text
		if horizontal then
			text = entry.icon .. "\n" .. entry.label
		elseif iconsOnly then
			text = entry.icon
		else
			text = entry.icon .. "  " .. entry.label .. (available and "" or ("  · F" .. entry.phase))
		end
		local button = C.New("TextButton", {
			LayoutOrder = i,
			Text = text,
			Font = selected and Theme.FontBold or Theme.Font,
			TextSize = horizontal and 12 or 15,
			TextColor3 = available and Theme.Text or Theme.TextMuted,
			TextXAlignment = (horizontal or iconsOnly) and Enum.TextXAlignment.Center or Enum.TextXAlignment.Left,
			BackgroundColor3 = selected and Theme.AccentDark or (entry.highlight and Color3.fromRGB(60, 45, 10) or Theme.Panel),
			BackgroundTransparency = selected and 0 or (available and 0.2 or 0.6),
			Size = horizontal and UDim2.new(0, 84, 1, -12) or UDim2.new(1, 0, 0, 38),
			BorderSizePixel = 0,
			Children = { C.Corner(Theme.RadiusSmall), C.Padding(4, 10) },
		}, navFrame)
		if entry.highlight then
			C.Stroke(Theme.Gold, 1, 0.3).Parent = button
		end
		button.Activated:Connect(function()
			ctx.navigate(entry.id)
		end)
	end
end

-- ===== Panel principal =====
local function buildShell()
	if panel then
		panel:Destroy()
	end
	local viewport = Workspace.CurrentCamera.ViewportSize
	ctx.compact = viewport.X < 900
	local userScale = (ctx.state and ctx.state.settings.uiScale) or 1
	uiScale.Scale = math.clamp(math.min(viewport.X / 1280, viewport.Y / 720) * 1.15, 0.6, 1.1) * userScale
	-- En pantallas pequeñas trabajamos con el espacio "sin escalar"
	local navWidth = (ctx.state and ctx.state.settings.compactMenu) and 64 or 200

	panel = C.New("Frame", {
		Name = "Panel",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 64),
		Size = UDim2.new(1, -16, 1, -72),
		BackgroundColor3 = Theme.Background,
		BackgroundTransparency = 0.04,
		Visible = panelOpen,
		BorderSizePixel = 0,
		Children = {
			C.Corner(UDim.new(0, 14)),
			C.Stroke(Theme.Stroke, 1),
			C.New("UISizeConstraint", { MaxSize = Vector2.new(1180, 760) }),
		},
	}, gui)

	if ctx.compact then
		navFrame = C.New("ScrollingFrame", {
			Name = "Nav",
			BackgroundColor3 = Theme.Panel,
			BorderSizePixel = 0,
			AnchorPoint = Vector2.new(0, 1),
			Position = UDim2.new(0, 0, 1, 0),
			Size = UDim2.new(1, 0, 0, 70),
			CanvasSize = UDim2.new(),
			AutomaticCanvasSize = Enum.AutomaticSize.X,
			ScrollingDirection = Enum.ScrollingDirection.X,
			ScrollBarThickness = 3,
			Children = { C.Corner(UDim.new(0, 14)) },
		}, panel)
		content = C.New("Frame", {
			Name = "Content",
			BackgroundTransparency = 1,
			Position = UDim2.new(0, 10, 0, 10),
			Size = UDim2.new(1, -20, 1, -90),
			ClipsDescendants = true,
		}, panel)
	else
		navFrame = C.New("ScrollingFrame", {
			Name = "Nav",
			BackgroundColor3 = Theme.Panel,
			BorderSizePixel = 0,
			Size = UDim2.new(0, navWidth, 1, 0),
			CanvasSize = UDim2.new(),
			AutomaticCanvasSize = Enum.AutomaticSize.Y,
			ScrollBarThickness = 3,
			Children = { C.Corner(UDim.new(0, 14)) },
		}, panel)
		content = C.New("Frame", {
			Name = "Content",
			BackgroundTransparency = 1,
			Position = UDim2.new(0, navWidth + 14, 0, 12),
			Size = UDim2.new(1, -(navWidth + 26), 1, -24),
			ClipsDescendants = true,
		}, panel)
	end
	buildNav()
end

local lastRendered
renderCurrent = function(keepScroll)
	if not content or not panelOpen then
		return
	end
	local previousScroll
	local oldScroll = content:FindFirstChild("Scroll", true)
	if keepScroll and lastRendered == ctx.current and oldScroll then
		previousScroll = oldScroll.CanvasPosition
	end
	content:ClearAllChildren()
	buildNav()

	if not ctx.state then
		C.Label("Cargando tu club…", { Font = Theme.FontBold, TextSize = 20 }).Parent = content
		return
	end

	local screen = Screens[ctx.current]
	local ok, err = pcall(function()
		if screen then
			screen.Render(content, ctx)
		else
			ComingSoon.Render(content, ctx)
		end
	end)
	if not ok then
		warn("[UI] Error mostrando la pantalla ", ctx.current, ": ", err)
		C.Label("⚠️ No se pudo mostrar esta pantalla.", { TextColor3 = Theme.Danger }).Parent = content
	end
	lastRendered = ctx.current
	if previousScroll then
		local newScroll = content:FindFirstChild("Scroll", true)
		if newScroll then
			task.defer(function()
				newScroll.CanvasPosition = previousScroll
			end)
		end
	end
end

-- ===== Inicialización =====
gui = C.New("ScreenGui", {
	Name = "FEU_UI",
	ResetOnSpawn = false,
	ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	IgnoreGuiInset = false,
}, player:WaitForChild("PlayerGui"))
uiScale = C.New("UIScale", {}, gui)
Notifier.Init(gui)
buildShell()
buildTopBar()
renderCurrent(false)

stateRemote.OnClientEvent:Connect(function(state)
	local firstState = ctx.state == nil
	if firstState then
		task.delay(2, function()
			Notifier.Show("info", "🏟️ ¡Bienvenido a tu estadio! Camina, chuta el balón y acércate a los edificios (tecla E). Pulsa M o MENÚ para gestionar tu club.", 8)
		end)
	end
	local layoutChanged = ctx.state == nil
		or ctx.state.settings.compactMenu ~= state.settings.compactMenu
		or ctx.state.settings.uiScale ~= state.settings.uiScale
	ctx.state = state
	ctx.stateReceivedAt = os.clock()
	if layoutChanged then
		buildShell()
	end
	buildTopBar()
	-- No se reconstruye la pantalla mientras el jugador escribe en un cuadro de texto.
	if not UserInputService:GetFocusedTextBox() then
		renderCurrent(not firstState)
	end
end)

shopRemote.OnClientEvent:Connect(function(shop)
	ctx.shop = shop
	ctx.pendingPurchase = nil -- cualquier cambio de estado cierra la espera de compra
	if ctx.current == "shop" and not UserInputService:GetFocusedTextBox() then
		renderCurrent(true)
	end
end)

-- Efectos visuales de los «trucos» del evento de Halloween (solo en este cliente)
local function playTrick(info)
	if info.id == "scare" then
		local scare = C.New("TextLabel", {
			Size = UDim2.fromScale(1, 1),
			BackgroundColor3 = Color3.new(0, 0, 0),
			BackgroundTransparency = 0.2,
			Text = "👻",
			TextScaled = true,
			ZIndex = 100,
		}, gui)
		task.delay(1.2, function()
			scare:Destroy()
		end)
	elseif info.id == "fog" then
		local Lighting = game:GetService("Lighting")
		local fogEnd, fogColor = Lighting.FogEnd, Lighting.FogColor
		Lighting.FogColor = Color3.fromRGB(60, 50, 80)
		Lighting.FogEnd = 45
		task.delay(info.seconds or 10, function()
			Lighting.FogEnd = fogEnd
			Lighting.FogColor = fogColor
		end)
	end
end

notifyRemote.OnClientEvent:Connect(function(kind, message)
	if kind == "open" and type(message) == "table" then
		-- Indicación (tecla E) en una instalación del propio estadio
		ctx.navigate(message.screen, message.params)
		buildTopBar()
		return
	elseif kind == "candy" and type(message) == "table" then
		if ctx.state and ctx.state.halloween then
			ctx.state.halloween.candy = message.candy
			buildTopBar()
		end
		Notifier.Show("success", string.format("%s +%d 🍬 (tienes %d)", message.treat and "🎃 ¡Trato!" or "🍬", message.gained, message.candy), 2)
		return
	elseif kind == "trick" and type(message) == "table" then
		Notifier.Show("warning", message.text or "¡Truco!")
		playTrick(message)
		return
	end
	if kind == "match" and type(message) == "table" then
		-- Resumen de un partido de liga o copa: se guarda para verlo en Partidos
		ctx.lastMatch = message
		Notifier.Show("info", "Partido simulado disponible en Partidos › Ver último partido.")
		return
	end
	notify(kind, message)
end)

Workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
	local wasCompact = ctx.compact
	local viewport = Workspace.CurrentCamera.ViewportSize
	if (viewport.X < 900) ~= wasCompact then
		buildShell()
		buildTopBar()
		renderCurrent(false)
	else
		local userScale = (ctx.state and ctx.state.settings.uiScale) or 1
		uiScale.Scale = math.clamp(math.min(viewport.X / 1280, viewport.Y / 720) * 1.15, 0.6, 1.1) * userScale
	end
end)

UserInputService.InputBegan:Connect(function(input, processed)
	if processed then
		return
	end
	if input.KeyCode == Enum.KeyCode.M and not PlacementController.Active then
		panelOpen = not panelOpen
		panel.Visible = panelOpen
		buildTopBar()
		if panelOpen then
			renderCurrent(false)
		end
	end
end)

-- Cuenta atrás de la próxima jornada
task.spawn(function()
	while true do
		task.wait(1)
		if ctx.state and countdownLabel and countdownLabel.Parent then
			countdownLabel.Text = "⏱️ " .. Format.Duration(ctx.secondsToNextCycle())
		end
	end
end)

-- Pedimos el estado por si el servidor lo envió antes de conectar los eventos.
task.spawn(function()
	while not ctx.state do
		local ok, result = pcall(function()
			return actionRemote:InvokeServer("GetState")
		end)
		if ok and type(result) == "table" and result.ok then
			break
		end
		task.wait(2)
	end
	pcall(function()
		actionRemote:InvokeServer("RefreshShop")
	end)
end)
]]></ProtectedString></Properties></Item><Item class="Folder" referent="RBX00000048"><Properties><string name="Name">Screens</string></Properties><Item class="ModuleScript" referent="RBX00000039"><Properties><string name="Name">Academy</string><ProtectedString name="Source"><![CDATA[-- Academy (ModuleScript) · Pantalla "Academia" · CANTERA GENERACIONAL (FASE 4)
-- Ubicación: StarterPlayer/StarterPlayerScripts/Client/Screens/Academy

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local FootballConfig = require(Shared.Config.FootballConfig)

local Squad = require(script.Parent.Squad)

local Academy = {}

function Academy.Render(container, ctx)
	local C, Theme, Format, state = ctx.C, ctx.Theme, ctx.Format, ctx.state
	local football = state.football
	local academy = football.academy
	local levelData = FootballConfig.Academy(academy.level)
	local scroll = C.Scroll()
	scroll.Parent = container
	local add = C.Stack(scroll)

	add(C.Title("🧬 Cantera generacional", 26))

	local remaining = football.season.length - football.season.cycle
	add(C.Card({ BackgroundColor3 = Theme.Panel }, {
		C.Label(string.format("<b>Academia juvenil nivel %d</b>%s", academy.level, academy.level == 0 and " (cantera básica)" or ""), { TextSize = 16 }),
		C.Label(string.format("Plazas %d/%d · %d juvenil(es) por hornada · evolución ×%.2f · potencial base %d-%d",
			#academy.youths, academy.capacity, academy.intake, levelData.growth, levelData.potentialMin, levelData.potentialMax), { TextSize = 14 }),
		C.Label(string.format("Próxima hornada al final de la temporada: dentro de %d jornada(s). Con %d años los juveniles dejan la academia si no suben al primer equipo.",
			remaining, FootballConfig.YOUTH_MAX_AGE + 1), { TextColor3 = Theme.TextDim, TextSize = 13 }),
		C.Button("Mejorar la Academia juvenil", "secondary", function()
			ctx.navigate("build")
		end),
	}))

	-- Ojeadores
	local err = FootballConfig.SCOUT_ERROR[academy.scouts]
	local scoutCard = C.Card({}, {
		C.Title(string.format("🔎 Ojeadores: %d / %d", academy.scouts, FootballConfig.MAX_SCOUTS), 18),
		C.Label(string.format("Coste: %s por jornada. Potencial estimado con margen de ±%d. +%d al potencial de la cantera y más probabilidad de joyas. "
			.. "Cada %d jornadas traen un informe con juveniles que puedes fichar%s.",
			Format.Money(FootballConfig.SCOUT_COSTS[academy.scouts] or 0), err, academy.scouts * FootballConfig.SCOUT_POTENTIAL_BONUS,
			FootballConfig.SCOUT_REPORT_CYCLES, academy.scouts > 0 and string.format(" (próximo en %d)", academy.nextReportIn) or ""),
			{ TextColor3 = Theme.TextDim, TextSize = 13 }),
	})
	local minus = C.Button("− Despedir", "secondary", function()
		ctx.act("SetScouts", { count = academy.scouts - 1 })
	end)
	local plus = C.Button(string.format("+ Contratar (%s/jornada)", Format.Money(FootballConfig.SCOUT_COSTS[math.min(FootballConfig.MAX_SCOUTS, academy.scouts + 1)] or 0)), "primary", function()
		ctx.act("SetScouts", { count = academy.scouts + 1 })
	end)
	C.SetEnabled(minus, academy.scouts > 0)
	C.SetEnabled(plus, academy.scouts < FootballConfig.MAX_SCOUTS)
	C.Row({ minus, plus }, 8).Parent = scoutCard
	add(scoutCard)

	-- Juveniles
	add(C.Title(string.format("👦 Juveniles (%d)", #academy.youths), 20))
	if #academy.youths == 0 then
		add(C.Label("La academia está vacía. Llegarán juveniles al final de la temporada.", { TextColor3 = Theme.TextMuted }))
	end
	for _, y in ipairs(academy.youths) do
		local expanded = ctx.params.selected == y.id
		add(Squad.PlayerCard(ctx, y, {
			expanded = expanded,
			onToggle = function()
				ctx.navigate("academy", { selected = (not expanded) and y.id or nil })
			end,
			actions = function(card)
				local promote = C.Button("⬆️ Subir al primer equipo", "primary", function()
					ctx.act("PromoteYouth", { id = y.id })
				end)
				C.SetEnabled(promote, y.age >= FootballConfig.YOUTH_MIN_PROMOTE_AGE and #football.squad < FootballConfig.MAX_SQUAD)
				local release = C.Button("Liberar", "danger", function()
					ctx.act("ReleaseYouth", { id = y.id })
				end)
				C.Row({ promote, release }, 8).Parent = card
				if y.age < FootballConfig.YOUTH_MIN_PROMOTE_AGE then
					C.Label(string.format("Podrá subir al primer equipo con %d años.", FootballConfig.YOUTH_MIN_PROMOTE_AGE), { TextSize = 13, TextColor3 = Theme.TextDim }).Parent = card
				end
			end,
		}))
	end

	-- Informes de ojeadores
	if academy.scouts > 0 then
		local reports = C.Card({}, { C.Title("📋 Informe de los ojeadores", 18) })
		if #academy.reports == 0 then
			C.Label("Sin candidatos todavía. El informe llega en la próxima jornada.", { TextColor3 = Theme.TextMuted }).Parent = reports
		end
		for _, r in ipairs(academy.reports) do
			local pos = FootballConfig.Position(r.pos)
			local sign = C.Button("Fichar · " .. Format.Money(r.signFee or 0), "primary", function()
				ctx.act("SignYouthReport", { id = r.id })
			end, { Size = UDim2.new(0, 160, 0, 34), AutomaticSize = Enum.AutomaticSize.None })
			C.SetEnabled(sign, #academy.youths < academy.capacity and state.economy.money >= (r.signFee or 0))
			C.Row({
				C.Label(string.format("<b>%s</b>%s · %s %s · %d años · media %d · potencial %d-%d",
					r.name, r.star and " ⭐" or "", pos.icon, pos.short, r.age, r.ovr, r.potentialLow, r.potentialHigh),
					{ Size = UDim2.new(1, -180, 0, 0), TextSize = 14 }),
				sign,
			}).Parent = reports
		end
		add(reports)
	end

	-- Leyendas
	local legends = C.Card({}, {
		C.Title("🏛️ Jugadores legendarios", 18),
		C.Label(string.format("Canteranos que han subido al primer equipo: %d", football.graduates), { TextSize = 14 }),
	})
	if #football.legends == 0 then
		C.Label("Todavía no hay leyendas. Los jugadores que se retiren tras una gran carrera aparecerán aquí.", { TextColor3 = Theme.TextMuted, TextSize = 13 }).Parent = legends
	end
	for i = #football.legends, 1, -1 do
		local l = football.legends[i]
		local pos = FootballConfig.Position(l.pos)
		C.Label(string.format("🏅 <b>%s</b> · %s · media máx. %d · %d temporadas · %s · retirado en la temporada %d",
			l.name, pos.short, l.peak, l.seasons, l.origin == "academy" and "canterano" or "fichaje", l.retiredSeason), { TextSize = 14 }).Parent = legends
	end
	add(legends)
end

return Academy
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000003A"><Properties><string name="Name">Build</string><ProtectedString name="Source"><![CDATA[-- Build (ModuleScript) · Pantalla "Construcción"
-- Ubicación: StarterPlayer/StarterPlayerScripts/Client/Screens/Build
-- Pestañas: Instalaciones · Decoración (comprar y colocar) · Diseños (Constructor Pro).
-- La interfaz calcula requisitos solo para informar; el servidor valida cada compra.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.Config.GameConfig)
local FacilityConfig = require(Shared.Config.FacilityConfig)
local CosmeticConfig = require(Shared.Config.CosmeticConfig)
local EconomyFormulas = require(Shared.Modules.EconomyFormulas)

local UI = script.Parent.Parent:WaitForChild("UI")
local Premium = require(UI.Premium)

local Build = {}

local EFFECT_TEXT = {
	capacity = function(v, F) return "Aforo " .. F.Thousands(v) end,
	attractiveness = function(v, F) return "Atractivo +" .. F.Percent(v) end,
	shopSpend = function(v) return string.format("Gasto en tienda %.1f/aficionado", v) end,
	foodSpend = function(v) return string.format("Gasto en comida %.1f/aficionado", v) end,
	vipIncome = function(v, F) return "Ingresos VIP " .. F.Money(v) end,
	reputation = function(v) return "Reputación " .. v end,
}
local EFFECT_ORDER = { "capacity", "attractiveness", "shopSpend", "foodSpend", "vipIncome", "reputation" }

local function effectsText(levelData, Format)
	local parts = {}
	for _, key in ipairs(EFFECT_ORDER) do
		if levelData[key] and levelData[key] ~= 0 then
			table.insert(parts, EFFECT_TEXT[key](levelData[key], Format))
		end
	end
	table.insert(parts, "Mantenimiento " .. Format.Money(levelData.upkeep + levelData.staff) .. "/jornada")
	return table.concat(parts, " · ")
end

local function pseudoData(state)
	return {
		stadium = state.stadium,
		economy = { money = state.economy.money, debt = state.economy.debt },
		club = { reputationEarned = 0 },
	}
end

local function renderFacilities(add, ctx)
	local C, Theme, Format, state = ctx.C, ctx.Theme, ctx.Format, ctx.state
	local data = pseudoData(state)
	for _, id in ipairs(FacilityConfig.Order) do
		local def = FacilityConfig.Get(id)
		local level = state.stadium.facilities[id] or 0
		local max = #def.levels
		local ok, reason, nextData = EconomyFormulas.CanUpgrade(data, id)
		local stageLocked = nextData and nextData.minStage > state.stadium.stage

		local card = C.Card({ BackgroundColor3 = stageLocked and Theme.Panel or Theme.Card }, {
			C.Row({
				C.Label(def.icon .. "  <b>" .. def.name .. "</b>", { TextSize = 18, Size = UDim2.new(0, 0, 0, 24), AutomaticSize = Enum.AutomaticSize.X, TextWrapped = false }),
				C.Badge(level > 0 and string.format("Nivel %d/%d", level, max) or "Sin construir", level > 0 and Theme.AccentDark or Theme.Locked),
				C.Badge(def.category, Theme.CardAlt, Theme.TextDim),
			}),
			C.Label(def.description, { TextColor3 = Theme.TextDim, TextSize = 14 }),
		})
		if level > 0 then
			C.Label("Ahora: " .. effectsText(def.levels[level], Format), { TextSize = 13, TextColor3 = Theme.Text }).Parent = card
		end
		if nextData then
			C.Label(string.format("Siguiente (Nv %d): %s", level + 1, effectsText(nextData, Format)), { TextSize = 13, TextColor3 = Theme.Accent }).Parent = card
			local label = string.format("%s · %s", level == 0 and "Construir" or "Mejorar", Format.Money(nextData.cost))
			local button = C.Button(label, "primary", function()
				ctx.act("UpgradeFacility", { facility = id })
			end)
			C.SetEnabled(button, ok)
			local row = C.Row({ button }, 10)
			if not ok and reason then
				C.Label("🔒 " .. reason, { TextColor3 = stageLocked and Theme.TextMuted or Theme.Warning, TextSize = 13,
					Size = UDim2.new(0, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.XY, TextWrapped = false }).Parent = row
			end
			row.Parent = card
		else
			C.Label("✅ Nivel máximo alcanzado.", { TextColor3 = Theme.Accent, TextSize = 13 }).Parent = card
		end
		add(card)
	end
end

local function renderDecorations(add, ctx)
	local C, Theme, Format, state = ctx.C, ctx.Theme, ctx.Format, ctx.state
	local stadium = state.stadium
	local list = stadium.decorations
	local max = stadium.maxDecorations
	local isPro = state.premium.owned.CONSTRUCTOR_PRO == true
	local freeLimit = EconomyFormulas.FreeDecorationLimit(stadium.stage)

	-- Resumen y herramientas
	local info = C.Card({ BackgroundColor3 = Theme.Panel }, {
		C.Row({
			C.Title(string.format("🌳 Decoraciones %d / %d", #list, max), 18),
			C.Badge(string.format("Rejilla %d · Rotación %d°", stadium.tools.grid, stadium.tools.rotationStep),
				isPro and Theme.Info or Theme.CardAlt),
		}, 10),
		C.Label(string.format("Coloca decoraciones libremente en la plaza de tu terreno (zona azul en el modo construcción). "
			.. "Tu etapa de estadio permite %d; cada ascenso de etapa añade más. Retirar devuelve el %d%% del precio. "
			.. "Cada decoración (hasta %d) suma +%s de atractivo.",
			freeLimit, math.floor(CosmeticConfig.DECORATION_REFUND * 100), freeLimit,
			Format.Percent(CosmeticConfig.DECORATION_ATTRACTIVENESS)), { TextColor3 = Theme.TextDim, TextSize = 13 }),
	})
	if not isPro then
		local upsell = C.Row({
			C.Label(string.format("🏗️ Constructor Pro: rejilla fina de %d stud, rotación a %d° y +%d decoraciones (sin ventaja económica).",
				GameConfig.PRO_GRID, GameConfig.PRO_ROTATION_STEP, GameConfig.PRO_EXTRA_DECORATIONS),
				{ TextColor3 = Theme.Gold, TextSize = 13, Size = UDim2.new(1, -130, 0, 0) }),
			C.Button("Ver pase", "gold", function()
				ctx.navigate("shop", { focus = "CONSTRUCTOR_PRO" })
			end, { Size = UDim2.new(0, 110, 0, 32), AutomaticSize = Enum.AutomaticSize.None }),
		}, 8)
		upsell.Parent = info
	end
	add(info)

	-- Catálogo
	local full = #list >= max
	local catalog = C.Card({}, { C.Title("🛒 Colocar una decoración nueva", 18) })
	if full then
		C.Label("Has alcanzado tu límite. Asciende tu estadio para colocar más, o retira alguna.", { TextColor3 = Theme.Warning, TextSize = 13 }).Parent = catalog
	end
	for _, item in ipairs(CosmeticConfig.Decorations) do
		local locked = Premium.IsLocked(state, item)
		local button = C.Button(locked and "🔒 Ver pase" or ("Colocar · " .. Format.Money(item.cost)), locked and "gold" or "primary", function()
			if locked then
				Premium.OnLockedClick(ctx, item)
			else
				ctx.startPlacement({ decoId = item.id })
			end
		end, { Size = UDim2.new(0, 170, 0, 34), AutomaticSize = Enum.AutomaticSize.None })
		if not locked then
			if state.economy.money < item.cost then
				C.SetEnabled(button, false, "Sin dinero · " .. Format.Money(item.cost))
			elseif full then
				C.SetEnabled(button, false, "Límite alcanzado")
			end
		end
		C.Row({
			C.Label(string.format("%s  <font color='#8C9BB4'>(%dx%d)</font>%s", item.name, item.w, item.d,
				item.requiredPass and ("  <font color='#FFC400'>" .. Premium.PassName(item.requiredPass) .. "</font>") or ""),
				{ Size = UDim2.new(1, -190, 0, 0) }),
			button,
		}).Parent = catalog
	end
	add(catalog)

	-- Decoraciones colocadas
	local placed = C.Card({}, { C.Title("📍 Tus decoraciones", 18) })
	if #list == 0 then
		C.Label("Todavía no has colocado ninguna.", { TextColor3 = Theme.TextMuted }).Parent = placed
	end
	for index, entry in ipairs(list) do
		local item = CosmeticConfig.ById.decoration[entry.id]
		local hidden = stadium.decorationVisible[index] ~= true
		local name = item and item.name or entry.id
		local moveButton = C.Button("Mover", "secondary", function()
			ctx.startPlacement({ decoId = entry.id, moveIndex = index })
		end, { Size = UDim2.new(0, 80, 0, 32), AutomaticSize = Enum.AutomaticSize.None })
		if hidden then
			C.SetEnabled(moveButton, false)
		end
		C.Row({
			C.Label(string.format("%d. %s  <font color='#8C9BB4'>x %d · z %d · %d°</font>%s", index, name, entry.x, entry.z, entry.r,
				hidden and "  <font color='#FFA028'>(oculta: requiere pase o supera tu límite)</font>" or ""),
				{ Size = UDim2.new(1, -200, 0, 0), TextSize = 14 }),
			moveButton,
			C.Button("Retirar", "danger", function()
				ctx.act("RemoveDecoration", { index = index, decoration = entry.id })
			end, { Size = UDim2.new(0, 90, 0, 32), AutomaticSize = Enum.AutomaticSize.None }),
		}).Parent = placed
	end
	add(placed)
end

local function renderDesigns(add, ctx)
	local C, Theme, state = ctx.C, ctx.Theme, ctx.state
	add(C.Label("Los diseños cambian el aspecto de gradas y edificios. No modifican la economía ni permiten construir fuera de tu terreno.",
		{ TextColor3 = Theme.TextDim, TextSize = 14 }))
	for _, group in ipairs({
		{ slot = "standsDesign", appliesTo = "stands", title = "🏟️ Diseño de gradas" },
		{ slot = "buildingDesign", appliesTo = "building", title = "🏢 Diseño de edificios" },
	}) do
		local card = C.Card({}, { C.Title(group.title, 18) })
		local grid = C.Grid(150, 100, 8)
		grid.Parent = card
		local i = 0
		for _, item in ipairs(CosmeticConfig.BuildDesigns) do
			if item.appliesTo == group.appliesTo then
				i += 1
				local locked = Premium.IsLocked(state, item)
				local selected = state.club.appearance[group.slot] == item.id
				local tile = C.OptionTile(item.name, item.requiredPass and "Constructor Pro" or "Gratis", {
					selected = selected,
					locked = locked,
					lockText = Premium.LockText(item),
					onClick = function()
						if locked then
							Premium.OnLockedClick(ctx, item)
						elseif not selected then
							ctx.act("SetAppearance", { slot = group.slot, id = item.id })
						end
					end,
				}, C.Label(item.material, {
					Position = UDim2.fromOffset(6, 14), Size = UDim2.new(1, -12, 0, 30),
					AutomaticSize = Enum.AutomaticSize.None, TextXAlignment = Enum.TextXAlignment.Center,
					TextColor3 = Theme.TextDim, TextSize = 13,
				}))
				tile.LayoutOrder = i
				tile.Parent = grid
			end
		end
		add(card)
	end
end

function Build.Render(container, ctx)
	local C, Theme, Format = ctx.C, ctx.Theme, ctx.Format
	local tab = ctx.params.tab or "facilities"
	local scroll = C.Scroll()
	scroll.Parent = container
	local add = C.Stack(scroll)

	add(C.Row({
		C.Title("🏗️ Construcción", 26),
		C.Badge("💰 " .. Format.Money(ctx.state.economy.money), Theme.Panel, Theme.Gold),
	}, 14))
	local tabs = {
		{ id = "facilities", label = "Instalaciones" },
		{ id = "decor", label = "Decoración" },
		{ id = "designs", label = "Diseños" },
	}
	local tabButtons = {}
	for _, t in ipairs(tabs) do
		table.insert(tabButtons, C.Button(t.label, tab == t.id and "primary" or "secondary", function()
			ctx.navigate("build", { tab = t.id })
		end))
	end
	add(C.Row(tabButtons, 8))

	if tab == "decor" then
		renderDecorations(add, ctx)
	elseif tab == "designs" then
		renderDesigns(add, ctx)
	else
		renderFacilities(add, ctx)
	end
end

return Build
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000003B"><Properties><string name="Name">Club</string><ProtectedString name="Source"><![CDATA[-- Club (ModuleScript) · Pantalla "Mi club"
-- Ubicación: StarterPlayer/StarterPlayerScripts/Client/Screens/Club
-- Nombre, abreviatura y apariencia del club (escudo, colores, equipación, efectos).

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.Config.GameConfig)
local CosmeticConfig = require(Shared.Config.CosmeticConfig)
local KitPattern = require(Shared.Modules.KitPattern)

local UI = script.Parent.Parent:WaitForChild("UI")
local Premium = require(UI.Premium)

local Club = {}

local function appearanceSection(ctx, title, slot, items, makeVisual)
	local C, Theme, state = ctx.C, ctx.Theme, ctx.state
	local card = C.Card({}, { C.Title(title, 18) })
	local grid = C.Grid(120, 120, 8)
	grid.Parent = card
	for i, item in ipairs(items) do
		local locked = Premium.IsLocked(state, item)
		local selected = state.club.appearance[slot] == item.id
		local tile = C.OptionTile(item.name, item.requiredPass and Premium.PassName(item.requiredPass) or (item.requiredUnlock and "🎃 Evento" or "Gratis"), {
			selected = selected,
			locked = locked,
			lockText = Premium.LockText(item),
			onClick = function()
				if locked then
					Premium.OnLockedClick(ctx, item)
				elseif not selected then
					ctx.act("SetAppearance", { slot = slot, id = item.id })
				end
			end,
		}, makeVisual(item))
		tile.LayoutOrder = i
		tile.Parent = grid
	end
	-- Aviso si la selección guardada no puede mostrarse (pase no confirmado ahora mismo)
	if state.club.appearance[slot] ~= state.club.effectiveAppearance[slot] then
		C.Label("⚠️ Tu selección guardada requiere un pase cuya propiedad no está confirmada ahora mismo. Se muestra la opción gratuita hasta que Roblox lo confirme.",
			{ TextColor3 = Theme.Warning, TextSize = 13 }).Parent = card
	end
	return card
end

function Club.Render(container, ctx)
	local C, Theme, state = ctx.C, ctx.Theme, ctx.state
	local scroll = C.Scroll()
	scroll.Parent = container
	local add = C.Stack(scroll)

	add(C.Title("🛡️ Mi club", 26))

	-- Tarjeta de perfil
	local eff = state.club.effectiveAppearance
	local palette = CosmeticConfig.ById.palette[eff.palette]
	local crest = CosmeticConfig.ById.crest[eff.crest]
	local kit = CosmeticConfig.ById.kit[eff.kit]
	local profile = C.New("Frame", {
		BackgroundColor3 = Theme.Panel,
		Size = UDim2.new(1, 0, 0, 130),
		Children = { C.Corner(), C.Stroke(state.premium.owned.VIP_CLUB and Theme.Gold or palette.primary, 2) },
	})
	C.New("TextLabel", {
		BackgroundColor3 = palette.primary,
		Position = UDim2.fromOffset(15, 15),
		Size = UDim2.fromOffset(100, 100),
		Text = crest.symbol,
		TextScaled = true,
		Children = { C.Corner(UDim.new(0.5, 0)), C.Stroke(palette.secondary, 4) },
	}, profile)
	local kitFrame = C.New("Frame", {
		Position = UDim2.new(1, -95, 0, 20),
		Size = UDim2.fromOffset(80, 90),
		BorderSizePixel = 0,
		Children = { C.Corner(UDim.new(0, 8)) },
	}, profile)
	KitPattern.Build(kitFrame, kit.pattern, palette.primary, palette.secondary)
	local info = C.New("Frame", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(130, 15),
		Size = UDim2.new(1, -240, 1, -30),
		Children = { C.List(nil, 4) },
	}, profile)
	local addInfo = C.Stack(info)
	addInfo(C.Label(state.club.name, { Font = Theme.FontBlack, TextSize = 24 }))
	addInfo(C.Label(string.format("%s · Presidente: %s", state.club.shortName, state.club.ownerName), { TextColor3 = Theme.TextDim }))
	if state.premium.owned.VIP_CLUB then
		addInfo(C.Badge("👑 VIP CLUB", Theme.Gold, Color3.fromRGB(35, 25, 0)))
	end
	add(profile)

	-- Nombre del club
	ctx.drafts.clubName = ctx.drafts.clubName or (state.club.named and state.club.name or "")
	ctx.drafts.shortName = ctx.drafts.shortName or (state.club.named and state.club.shortName or "")
	local function textBox(placeholder, key, maxLen, width)
		local box = C.New("TextBox", {
			PlaceholderText = placeholder,
			Text = ctx.drafts[key],
			ClearTextOnFocus = false,
			Font = Theme.Font,
			TextSize = 16,
			TextColor3 = Theme.Text,
			PlaceholderColor3 = Theme.TextMuted,
			BackgroundColor3 = Theme.Panel,
			Size = UDim2.new(0, width, 0, 40),
			TextXAlignment = Enum.TextXAlignment.Left,
			Children = { C.Corner(Theme.RadiusSmall), C.Stroke(), C.Padding(4, 10) },
		})
		box:GetPropertyChangedSignal("Text"):Connect(function()
			if utf8.len(box.Text) and utf8.len(box.Text) > maxLen then
				box.Text = string.sub(box.Text, 1, utf8.offset(box.Text, maxLen + 1) - 1)
			end
			ctx.drafts[key] = box.Text
		end)
		return box
	end
	add(C.Card({}, {
		C.Title("✏️ Nombre del club", 18),
		C.Label(string.format("Entre %d y %d caracteres. Abreviatura de %d letras o números. Se aplica el filtro de texto de Roblox.",
			GameConfig.CLUB_NAME_MIN, GameConfig.CLUB_NAME_MAX, GameConfig.SHORT_NAME_LEN), { TextColor3 = Theme.TextDim, TextSize = 13 }),
		C.Row({
			textBox("Nombre del club", "clubName", GameConfig.CLUB_NAME_MAX, 260),
			textBox("ABC", "shortName", GameConfig.SHORT_NAME_LEN, 80),
			C.Button("Guardar nombre", "primary", function()
				local result = ctx.act("SetClubName", { name = ctx.drafts.clubName, shortName = ctx.drafts.shortName })
				if result.ok then
					ctx.drafts.clubName, ctx.drafts.shortName = nil, nil
				end
			end),
		}, 10),
	}))

	-- Apariencia
	add(appearanceSection(ctx, "🛡️ Escudo", "crest", CosmeticConfig.Crests, function(item)
		return C.New("TextLabel", {
			BackgroundTransparency = 1,
			Position = UDim2.fromOffset(0, 6),
			Size = UDim2.new(1, 0, 1, -50),
			Text = item.symbol,
			TextScaled = true,
		})
	end))
	add(appearanceSection(ctx, "🎨 Colores", "palette", CosmeticConfig.Palettes, function(item)
		return C.New("Frame", {
			BackgroundTransparency = 1,
			Position = UDim2.new(0.15, 0, 0, 12),
			Size = UDim2.new(0.7, 0, 1, -60),
			Children = {
				C.New("Frame", { BackgroundColor3 = item.primary, Size = UDim2.fromScale(0.5, 1), BorderSizePixel = 0 }),
				C.New("Frame", { BackgroundColor3 = item.secondary, Position = UDim2.fromScale(0.5, 0), Size = UDim2.fromScale(0.5, 1), BorderSizePixel = 0 }),
			},
		})
	end))
	add(appearanceSection(ctx, "👕 Equipación", "kit", CosmeticConfig.Kits, function(item)
		local frame = C.New("Frame", {
			Position = UDim2.new(0.25, 0, 0, 10),
			Size = UDim2.new(0.5, 0, 1, -56),
			BorderSizePixel = 0,
		})
		KitPattern.Build(frame, item.pattern, palette.primary, palette.secondary)
		return frame
	end))
	add(appearanceSection(ctx, "✨ Efectos visuales del estadio", "effect", CosmeticConfig.Effects, function(item)
		local icons = { none = "➖", confetti = "🎊", sparkles = "✨", smoke = "🌫️", vip_gold = "🌟" }
		return C.New("TextLabel", {
			BackgroundTransparency = 1,
			Position = UDim2.fromOffset(0, 8),
			Size = UDim2.new(1, 0, 1, -54),
			Text = icons[item.id] or "✨",
			TextScaled = true,
		})
	end))
end

return Club
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000003C"><Properties><string name="Name">ComingSoon</string><ProtectedString name="Source"><![CDATA[-- ComingSoon (ModuleScript)
-- Ubicación: StarterPlayer/StarterPlayerScripts/Client/Screens/ComingSoon
-- Pantalla honesta para secciones de fases futuras: explica qué incluirán y cuándo.
-- No contiene botones que finjan funcionar.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local MenuConfig = require(ReplicatedStorage:WaitForChild("Shared").Config.MenuConfig)

local ComingSoon = {}

local PLANS = {
	squad = "Futbolistas con estadísticas (velocidad, tiro, pase, regate, defensa, resistencia, potencial), salarios, contratos y alineaciones.",
	academy = "CANTERA GENERACIONAL: jóvenes generados dinámicamente, potencial, entrenamientos, ojeadores, ascenso al primer equipo y retiradas.",
	matches = "Motor de partidos SIMULADOS con formaciones, tácticas, goles, asistencias, posesión y estadísticas. Los partidos se presentarán como simulaciones, no como partidos controlables.",
	transfers = "Mercado de fichajes con compras, ventas y cesiones validadas por el servidor.",
	leagues = "Ligas, copas, calendarios, clasificaciones, ascensos, descensos y modo carrera.",
	history = "HISTORIA DEL CLUB: temporadas, títulos, goleadores, récords y sala de trofeos física generada con eventos reales.",
	universe = "UNIVERSO FUTBOLÍSTICO: directorio de clubes, rankings globales de reputación y valor, eventos y competiciones.",
	network = "RED DE CLUBES: visitas a estadios, invitaciones, torneos, retos y clasificaciones entre amigos.",
	missions = "Misiones diarias y de progreso con recompensas validadas por el servidor.",
	achievements = "Logros permanentes del club.",
}

function ComingSoon.Render(container, ctx)
	local C, Theme = ctx.C, ctx.Theme
	local entry
	for _, e in ipairs(MenuConfig) do
		if e.id == ctx.current then
			entry = e
		end
	end
	local scroll = C.Scroll()
	scroll.Parent = container
	local add = C.Stack(scroll)
	add(C.Title((entry and entry.icon or "🔜") .. "  " .. (entry and entry.label or "Próximamente"), 26))
	add(C.Card({ BackgroundColor3 = Theme.Panel }, {
		C.Badge("🚧 EN DESARROLLO · FASE " .. tostring(entry and entry.phase or "?"), Theme.Warning, Color3.fromRGB(40, 20, 0)),
		C.Label("Esta sección todavía no está disponible en la versión actual (FASE " .. MenuConfig.CURRENT_PHASE .. ").",
			{ TextColor3 = Theme.TextDim }),
		C.Label("<b>Qué incluirá:</b> " .. (PLANS[ctx.current] or "Contenido planificado."), { TextSize = 15 }),
	}))
end

return ComingSoon
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000003D"><Properties><string name="Name">Economy</string><ProtectedString name="Source"><![CDATA[-- Economy (ModuleScript) · Pantalla "Economía"
-- Ubicación: StarterPlayer/StarterPlayerScripts/Client/Screens/Economy
-- Pestañas: Resumen (dinero, deuda, entradas, previsión, historial) · Aficionados (FASE 3)
-- · Comercial (FASE 3) · Patrocinios (FASE 3).

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.Config.GameConfig)
local CommercialConfig = require(Shared.Config.CommercialConfig)
local SponsorConfig = require(Shared.Config.SponsorConfig)
local FacilityConfig = require(Shared.Config.FacilityConfig)

local Economy = {}

local INCOME_LABELS = {
	{ "tickets", "🎟️ Entradas" },
	{ "members", "🎫 Cuotas de socios" },
	{ "shop", "🛍️ Tienda" },
	{ "restaurant", "🍔 Restauración" },
	{ "sponsors", "🏢 Patrocinio local" },
	{ "contracts", "🤝 Contratos de patrocinio" },
	{ "vip", "🥂 Zona VIP" },
	{ "tour", "🗺️ Tour del estadio" },
	{ "loans", "🔁 Cesiones a otros clubes" },
}
local EXPENSE_LABELS = {
	{ "maintenance", "🔧 Mantenimiento" },
	{ "staff", "👷 Personal" },
	{ "stadium", "🏟️ Operación del estadio" },
	{ "wages", "👕 Salarios de la plantilla" },
	{ "scouts", "🔎 Ojeadores" },
	{ "loans", "🔁 Cuotas de cesiones recibidas" },
	{ "interest", "📉 Intereses de deuda" },
}

local function breakdown(ctx, title, cycle)
	local C, Theme, Format = ctx.C, ctx.Theme, ctx.Format
	local card = C.Card({}, { C.Title(title, 18) })
	local function line(text, amount, color)
		local row = C.New("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 22) })
		C.Label(text, { Size = UDim2.new(0.6, 0, 1, 0), AutomaticSize = Enum.AutomaticSize.None, TextSize = 14 }).Parent = row
		C.Label(Format.SignedMoney(amount), {
			Position = UDim2.fromScale(0.6, 0), Size = UDim2.new(0.4, 0, 1, 0), AutomaticSize = Enum.AutomaticSize.None,
			TextXAlignment = Enum.TextXAlignment.Right, TextSize = 14, TextColor3 = color, Font = Theme.FontBold,
		}).Parent = row
		row.Parent = card
	end
	for _, entry in ipairs(INCOME_LABELS) do
		line(entry[2], cycle.income[entry[1]] or 0, Theme.Accent)
	end
	for _, entry in ipairs(EXPENSE_LABELS) do
		line(entry[2], -(cycle.expenses[entry[1]] or 0), Theme.Danger)
	end
	line("<b>Balance</b>", cycle.net, cycle.net >= 0 and Theme.Accent or Theme.Danger)
	C.Label(string.format("Asistencia: %s / %s espectadores", Format.Thousands(cycle.attendance), Format.Thousands(cycle.capacity)),
		{ TextColor3 = Theme.TextDim, TextSize = 13 }).Parent = card
	return card
end

local function renderSummary(add, ctx)
	local C, Theme, Format, state = ctx.C, ctx.Theme, ctx.Format, ctx.state
	local eco = state.economy

	local grid = C.Grid(200, 78, 10)
	add(grid)
	local stats = {
		{ "💰", "Dinero", Format.Money(eco.money), Theme.Gold },
		{ "📉", "Deuda", Format.Money(eco.debt), eco.debt > 0 and Theme.Danger or nil },
		{ "🏦", "Valor del club", Format.Money(eco.clubValue) },
		{ "👕", "Presupuesto salarial", Format.Money(eco.wageBudget) },
		{ "🔁", "Presupuesto de fichajes", Format.Money(eco.transferBudget) },
		{ "📊", "Ingresado / gastado", Format.Short(eco.totalEarned) .. " / " .. Format.Short(eco.totalSpent) },
	}
	for i, s in ipairs(stats) do
		local stat = C.Stat(s[1], s[2], s[3], s[4])
		stat.LayoutOrder = i
		stat.Parent = grid
	end
	add(C.Label("El presupuesto salarial orienta cuánto gastar en salarios. El de fichajes (25 %) es orientativo: el límite real se elige en Fichajes.",
		{ TextColor3 = Theme.TextMuted, TextSize = 13 }))

	-- Precio de entradas
	local ticketCard = C.Card({}, {
		C.Title("🎟️ Precio de las entradas", 18),
		C.Label("Precios más altos dan más ingresos por espectador pero reducen la asistencia.", { TextColor3 = Theme.TextDim, TextSize = 14 }),
	})
	local buttons = {}
	for _, option in ipairs(GameConfig.TICKET_PRICES) do
		local selected = eco.ticketPrice == option.id
		table.insert(buttons, C.Button(string.format("%s · %s · demanda %s", option.name, Format.Money(option.price), Format.Percent(option.demand)),
			selected and "primary" or "secondary", function()
				if not selected then
					ctx.act("SetTicketPrice", { option = option.id })
				end
			end))
	end
	C.Row(buttons, 8).Parent = ticketCard
	add(ticketCard)

	-- Deuda
	local debtCard = C.Card({}, {
		C.Title("📉 Deuda", 18),
		C.Label(string.format("Si una jornada acaba en negativo, el déficit pasa a deuda con un interés del %s por jornada. "
			.. "El %s del beneficio de cada jornada amortiza deuda automáticamente. Con más de %s de deuda no puedes construir.",
			Format.Percent(GameConfig.DEBT_INTEREST_PER_CYCLE), Format.Percent(GameConfig.DEBT_AUTO_REPAY_SHARE), Format.Money(eco.debtLimit)),
			{ TextColor3 = Theme.TextDim, TextSize = 14 }),
	})
	if eco.debt > 0 then
		local payAll = C.Button("Pagar todo lo posible", "danger", function()
			ctx.act("RepayDebt", { amount = 0 })
		end)
		local pay1k = C.Button("Pagar " .. Format.Money(1000), "secondary", function()
			ctx.act("RepayDebt", { amount = 1000 })
		end)
		C.SetEnabled(payAll, eco.money > 0)
		C.SetEnabled(pay1k, eco.money > 0)
		C.Row({ payAll, pay1k }, 8).Parent = debtCard
	else
		C.Label("✅ Tu club no tiene deuda.", { TextColor3 = Theme.Accent }).Parent = debtCard
	end
	add(debtCard)

	add(breakdown(ctx, string.format("📈 Previsión de la próxima jornada (en %s)", Format.Duration(ctx.secondsToNextCycle())), eco.forecast))
	if eco.lastCycle then
		add(breakdown(ctx, "🧾 Última jornada " .. os.date("(%H:%M)", eco.lastCycle.t), eco.lastCycle))
	end

	-- Historial
	local history = C.Card({}, { C.Title("📜 Historial de transacciones", 18) })
	local list = eco.transactions or {}
	if #list == 0 then
		C.Label("Todavía no hay movimientos.", { TextColor3 = Theme.TextMuted }).Parent = history
	end
	for i = #list, math.max(1, #list - 29), -1 do
		local t = list[i]
		local row = C.New("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 22) })
		C.Label(string.format("<font color='#8C9BB4'>%s</font>  %s · %s", os.date("%H:%M", t.t), t.category, t.note or ""), {
			Size = UDim2.new(0.72, 0, 1, 0), AutomaticSize = Enum.AutomaticSize.None, TextSize = 13,
			TextTruncate = Enum.TextTruncate.AtEnd, TextWrapped = false,
		}).Parent = row
		C.Label(Format.SignedMoney(t.amount), {
			Position = UDim2.fromScale(0.72, 0), Size = UDim2.new(0.28, 0, 1, 0), AutomaticSize = Enum.AutomaticSize.None,
			TextXAlignment = Enum.TextXAlignment.Right, TextSize = 13, Font = Theme.FontBold,
			TextColor3 = t.amount >= 0 and Theme.Accent or Theme.Danger,
		}).Parent = row
		row.Parent = history
	end
	add(history)
end

local function optionRow(ctx, list, current, kind, describe)
	local buttons = {}
	for _, option in ipairs(list) do
		local selected = current == option.id
		table.insert(buttons, ctx.C.Button(describe(option), selected and "primary" or "secondary", function()
			if not selected then
				ctx.act("SetPricePolicy", { kind = kind, option = option.id })
			end
		end))
	end
	return ctx.C.Row(buttons, 8)
end

local function signed(n)
	return (n >= 0 and "+" or "") .. tostring(n)
end

local function renderFans(add, ctx)
	local C, Theme, Format, state = ctx.C, ctx.Theme, ctx.Format, ctx.state
	local eco, club = state.economy, state.club
	local f = eco.forecast

	local grid = C.Grid(200, 78, 10)
	add(grid)
	local stats = {
		{ "👥", "Aficionados", Format.Thousands(club.fans) .. " / " .. Format.Thousands(f.fanCap) },
		{ "🎫", "Socios", Format.Thousands(club.members) .. " → " .. Format.Thousands(f.memberTarget) },
		{ "😊", "Satisfacción", string.format("%d → %d", math.floor(club.satisfaction + 0.5), f.satisfactionTarget) },
		{ "🏟️", "Ocupación prevista", Format.Percent(f.occupancy) },
		{ "🛒", "Gasto por satisfacción", "×" .. string.format("%.2f", f.spendMultiplier) },
	}
	for i, st in ipairs(stats) do
		local stat = C.Stat(st[1], st[2], st[3])
		stat.LayoutOrder = i
		stat.Parent = grid
	end

	local satCard = C.Card({}, {
		C.Title("😊 Satisfacción de la afición", 18),
		C.ProgressBar(club.satisfaction / 100, club.satisfaction >= 50 and Theme.Accent or Theme.Warning, 12),
		C.Label("La satisfacción se acerca un 10 % a su objetivo en cada jornada. Hace crecer a la afición, aumenta los socios "
			.. "y multiplica el gasto en tienda y restauración. Por debajo de 25, los aficionados empiezan a irse.",
			{ TextColor3 = Theme.TextDim, TextSize = 13 }),
	})
	for _, factor in ipairs(f.satisfactionFactors or {}) do
		local color = factor.value > 0 and Theme.Accent or (factor.value < 0 and Theme.Danger or Theme.TextDim)
		C.Label(string.format("%s: <b>%s</b>", factor.label, signed(factor.value)), { TextSize = 14, TextColor3 = color }).Parent = satCard
	end
	C.Label(string.format("Objetivo: <b>%d</b> / 100", f.satisfactionTarget), { TextSize = 14 }).Parent = satCard
	add(satCard)

	local memberCard = C.Card({}, {
		C.Title("🎫 Abonos de socios", 18),
		C.Label(string.format("Los socios pagan su cuota en cada jornada y siempre tienen asiento (como máximo el %s del aforo). "
			.. "Asisten %s socios y %s aficionados con entrada.",
			Format.Percent(GameConfig.MEMBER_SEAT_SHARE), Format.Thousands(f.membersAttending), Format.Thousands(f.casual)),
			{ TextColor3 = Theme.TextDim, TextSize = 13 }),
	})
	optionRow(ctx, GameConfig.MEMBER_PRICES, eco.memberPrice, "member", function(option)
		return string.format("%s · %s/jornada · demanda %s · %s😊", option.name, Format.Money(option.fee),
			Format.Percent(option.demand), signed(option.satisfaction))
	end).Parent = memberCard
	add(memberCard)
end

local function productCard(ctx, title, products, level, revenue, facilityId)
	local C, Theme, Format = ctx.C, ctx.Theme, ctx.Format
	local def = FacilityConfig.Get(facilityId)
	local card = C.Card({}, {
		C.Title(title, 18),
		C.Label(level > 0 and string.format("%s nivel %d · ventas previstas %s por jornada", def.name, level, Format.Money(revenue))
			or (def.name .. " sin construir. Constrúyela en Construcción."), { TextColor3 = Theme.TextDim, TextSize = 13 }),
	})
	for _, entry in ipairs(CommercialConfig.Breakdown(products, level, revenue)) do
		local p = entry.product
		local text = entry.unlocked
			and string.format("%s %s · <b>%s</b>", p.icon, p.name, Format.Money(entry.revenue))
			or string.format("🔒 %s %s · se desbloquea en el nivel %d", p.icon, p.name, p.minLevel)
		C.Label(text, { TextSize = 14, TextColor3 = entry.unlocked and Theme.Text or Theme.TextMuted }).Parent = card
	end
	return card
end

local function renderCommercial(add, ctx)
	local C, Theme, Format, state = ctx.C, ctx.Theme, ctx.Format, ctx.state
	local eco = state.economy
	local f = eco.forecast
	local facilities = state.stadium.facilities

	local policies = C.Card({}, {
		C.Title("🏷️ Política de precios", 18),
		C.Label("Precios altos aumentan el gasto por espectador pero reducen la satisfacción de la afición.",
			{ TextColor3 = Theme.TextDim, TextSize = 13 }),
		C.Label("<b>Tienda</b>", { TextSize = 14 }),
	})
	local function describe(option)
		return string.format("%s · gasto ×%.2f · %s😊", option.name, option.spend, signed(option.satisfaction))
	end
	optionRow(ctx, CommercialConfig.PricePolicies, eco.shopPrice, "shop", describe).Parent = policies
	C.Label("<b>Restauración</b> (restaurante y quioscos)", { TextSize = 14 }).Parent = policies
	optionRow(ctx, CommercialConfig.PricePolicies, eco.foodPrice, "food", describe).Parent = policies
	add(policies)

	add(productCard(ctx, "🛍️ Productos de la tienda", CommercialConfig.ShopProducts, facilities.shop or 0, f.income.shop or 0, "shop"))
	add(productCard(ctx, "🍔 Oferta de restauración", CommercialConfig.FoodProducts, facilities.restaurant or 0, f.income.restaurant or 0, "restaurant"))

	local other = C.Card({}, {
		C.Title("🏪 Otras instalaciones comerciales", 18),
		C.Label(string.format("🌭 Quioscos: nivel %d (suman gasto en restauración)", facilities.kiosks or 0), { TextSize = 14 }),
		C.Label(string.format("🗺️ Tour del estadio: nivel %d · %s por jornada", facilities.tour or 0, Format.Money(f.income.tour or 0)), { TextSize = 14 }),
		C.Label(string.format("🥂 Zona VIP: nivel %d · %s por jornada", facilities.vip or 0, Format.Money(f.income.vip or 0)), { TextSize = 14 }),
		C.Button("Ir a Construcción", "secondary", function()
			ctx.navigate("build")
		end),
	})
	add(other)
end

local function renderSponsors(add, ctx)
	local C, Theme, Format, state = ctx.C, ctx.Theme, ctx.Format, ctx.state
	local sponsors = state.sponsors
	local f = state.economy.forecast
	local cyclesToRefresh = math.max(0, sponsors.nextRefresh - state.stats.cycles)

	add(C.Label(string.format("Las marcas son ficticias. Las ofertas dependen de tu reputación y tus aficionados y se renuevan cada %d jornadas "
		.. "(próxima renovación en %d). Si cumples el objetivo de un contrato, cobras un %s extra en esa jornada.",
		SponsorConfig.OFFER_REFRESH_CYCLES, cyclesToRefresh, Format.Percent(SponsorConfig.OBJECTIVE_BONUS)),
		{ TextColor3 = Theme.TextDim, TextSize = 13 }))

	for _, slot in ipairs(SponsorConfig.Slots) do
		local card = C.Card({}, { C.Title(slot.icon .. " " .. slot.name, 18) })
		local contract = sponsors.contracts[slot.id]
		if state.stadium.stage < slot.minStage then
			C.Label(string.format("🔒 Se desbloquea con el estadio en etapa %d.", slot.minStage), { TextColor3 = Theme.TextMuted }).Parent = card
		elseif contract then
			local detail = f.contracts and f.contracts[slot.id]
			local met = detail and detail.objectiveMet
			C.Label(string.format("<b>%s</b> · %s por jornada · quedan %d de %d jornadas",
				contract.brand, Format.Money(contract.payment), contract.cyclesLeft, contract.duration), { TextSize = 15 }).Parent = card
			C.Label((met and "✅ " or "⏳ ") .. "Objetivo: " .. SponsorConfig.ObjectiveText(contract.objective)
				.. (met and " (cumplido: +" .. Format.Percent(SponsorConfig.OBJECTIVE_BONUS) .. ")" or " (no cumplido ahora)"),
				{ TextSize = 14, TextColor3 = met and Theme.Accent or Theme.Warning }).Parent = card
			local penalty = contract.payment * SponsorConfig.TERMINATION_PENALTY
			local button = C.Button("Rescindir · penalización " .. Format.Money(penalty), "danger", function()
				ctx.act("TerminateSponsor", { slot = slot.id })
			end)
			C.SetEnabled(button, state.economy.money >= penalty)
			button.Parent = card
		else
			local offers = sponsors.offers[slot.id] or {}
			if #offers == 0 then
				C.Label("Sin ofertas ahora mismo. Llegarán en la próxima jornada.", { TextColor3 = Theme.TextMuted }).Parent = card
			end
			for _, offer in ipairs(offers) do
				C.Row({
					C.Label(string.format("<b>%s</b> · %s/jornada · %d jornadas · prima %s<br/><font color='#A0AFC8'>Objetivo: %s</font>",
						offer.brand, Format.Money(offer.payment), offer.duration, Format.Money(offer.bonus),
						SponsorConfig.ObjectiveText(offer.objective)), { Size = UDim2.new(1, -130, 0, 0), TextSize = 14 }),
					C.Button("Firmar", "primary", function()
						ctx.act("AcceptSponsor", { slot = slot.id, offer = offer.id })
					end, { Size = UDim2.new(0, 110, 0, 36), AutomaticSize = Enum.AutomaticSize.None }),
				}).Parent = card
			end
		end
		add(card)
	end
end

function Economy.Render(container, ctx)
	local C = ctx.C
	local tab = ctx.params.tab or "summary"
	local scroll = C.Scroll()
	scroll.Parent = container
	local add = C.Stack(scroll)

	add(C.Title("💰 Economía", 26))
	local tabs = {
		{ id = "summary", label = "Resumen" },
		{ id = "fans", label = "Aficionados" },
		{ id = "commercial", label = "Comercial" },
		{ id = "sponsors", label = "Patrocinios" },
	}
	local buttons = {}
	for _, t in ipairs(tabs) do
		table.insert(buttons, C.Button(t.label, tab == t.id and "primary" or "secondary", function()
			ctx.navigate("economy", { tab = t.id })
		end))
	end
	add(C.Row(buttons, 8))

	if tab == "fans" then
		renderFans(add, ctx)
	elseif tab == "commercial" then
		renderCommercial(add, ctx)
	elseif tab == "sponsors" then
		renderSponsors(add, ctx)
	else
		renderSummary(add, ctx)
	end
end

return Economy
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000003E"><Properties><string name="Name">History</string><ProtectedString name="Source"><![CDATA[-- History (ModuleScript) · Pantalla "Historia del club" (FASE 8)
-- Ubicación: StarterPlayer/StarterPlayerScripts/Client/Screens/History
-- Pestañas: Resumen · Temporadas · Jugadores · Récords · Cronología.
-- Todo procede de acontecimientos reales del juego registrados por el servidor.

local History = {}

local function reputationChart(ctx, points)
	local C, Theme = ctx.C, ctx.Theme
	local frame = C.New("Frame", {
		BackgroundColor3 = Theme.Panel,
		Size = UDim2.new(1, 0, 0, 120),
		Children = { C.Corner(), C.Padding(8) },
	})
	if #points == 0 then
		C.Label("La gráfica aparecerá tras unas jornadas.", { TextColor3 = Theme.TextMuted, TextSize = 13 }).Parent = frame
		return frame
	end
	local max = 1
	for _, p in ipairs(points) do
		max = math.max(max, p.value)
	end
	local width = 1 / #points
	for i, p in ipairs(points) do
		local h = p.value / max
		C.New("Frame", {
			BackgroundColor3 = Theme.Accent,
			BorderSizePixel = 0,
			AnchorPoint = Vector2.new(0, 1),
			Position = UDim2.new((i - 1) * width, 1, 1, 0),
			Size = UDim2.new(width, -2, h, 0),
		}, frame)
	end
	return frame
end

local function renderSummary(add, ctx)
	local C, Theme, state = ctx.C, ctx.Theme, ctx.state
	local h = state.clubHistory
	local t = h.totals
	add(C.Card({ BackgroundColor3 = Theme.Panel }, {
		C.Title("📜 " .. state.club.name, 22),
		C.Label(string.format("Fundado el %s · %d temporadas completadas · %d títulos", os.date("%d/%m/%Y", h.founded), #h.seasons, #h.trophies), { TextSize = 14 }),
		C.Label(string.format("%d partidos (%d V · %d E · %d D) · %d goles a favor y %d en contra · %d canteranos debutados · %d construcciones",
			t.matches, t.wins, t.draws, t.losses, t.goalsFor, t.goalsAgainst, t.graduates, t.buildings), { TextSize = 13, TextColor3 = Theme.TextDim }),
	}))
	add(C.Card({}, {
		C.Title(string.format("⭐ Evolución de la reputación (actual: %d)", h.reputationNow), 18),
		reputationChart(ctx, h.reputationHistory),
		C.Label("Un punto cada 5 jornadas (últimos 60).", { TextSize = 12, TextColor3 = Theme.TextMuted }),
	}))
	local trophies = C.Card({}, { C.Title("🏆 Sala de trofeos", 18) })
	if #h.trophies == 0 then
		C.Label("Sin títulos todavía. Cada título aparece también en la vitrina física de tu Sala de trofeos.", { TextSize = 13, TextColor3 = Theme.TextMuted }).Parent = trophies
	end
	for i = #h.trophies, 1, -1 do
		local tr = h.trophies[i]
		C.Label(string.format("%s %s · temporada %d", tr.kind == "cup" and "🥇" or "🏆", tr.name, tr.season), { TextSize = 14 }).Parent = trophies
	end
	add(trophies)
end

local function renderSeasons(add, ctx)
	local C, Theme, state = ctx.C, ctx.Theme, ctx.state
	local seasons = state.clubHistory.seasons
	if #seasons == 0 then
		add(C.Label("Aún no ha terminado ninguna temporada de liga.", { TextColor3 = Theme.TextMuted }))
	end
	for i = #seasons, 1, -1 do
		local s = seasons[i]
		local tags = {}
		if s.champion then
			table.insert(tags, "🏆 Campeón")
		end
		if s.promoted then
			table.insert(tags, "⬆️ Ascenso")
		end
		if s.relegated then
			table.insert(tags, "⬇️ Descenso")
		end
		add(C.Card({}, {
			C.Title(string.format("Temporada %d · %s", s.season, s.divisionName), 16),
			C.Label(string.format("<b>%dº</b> · %d pts · %d-%d-%d · %d:%d · Copa: %s %s", s.position, s.points, s.w, s.d, s.l, s.gf, s.ga, tostring(s.cup),
				table.concat(tags, " · ")), { TextSize = 14 }),
			C.Label(string.format("⚽ Máximo goleador: %s · 🎯 Mejor asistente: %s",
				s.topScorer and (s.topScorer.name .. " (" .. s.topScorer.goals .. ")") or "—",
				s.topAssist and (s.topAssist.name .. " (" .. s.topAssist.assists .. ")") or "—"), { TextSize = 13, TextColor3 = Theme.TextDim }),
		}))
	end
end

local function leaderboard(ctx, title, list, unit)
	local C, Theme = ctx.C, ctx.Theme
	local card = C.Card({}, { C.Title(title, 18) })
	if #list == 0 then
		C.Label("Sin datos todavía.", { TextColor3 = Theme.TextMuted, TextSize = 13 }).Parent = card
	end
	for i, e in ipairs(list) do
		C.Label(string.format("%d. <b>%s</b> (%s%s) · %d %s", i, e.name, e.pos, e.origin == "academy" and ", canterano" or "", e.value, unit), { TextSize = 14 }).Parent = card
	end
	return card
end

local function renderPlayers(add, ctx)
	local C, Theme, state = ctx.C, ctx.Theme, ctx.state
	local h = state.clubHistory
	add(leaderboard(ctx, "⚽ Máximos goleadores de la historia", h.topScorers, "goles"))
	add(leaderboard(ctx, "🎯 Máximos asistentes", h.topAssists, "asistencias"))
	add(leaderboard(ctx, "👕 Más partidos", h.topApps, "partidos"))
	local legends = C.Card({}, { C.Title("🏛️ Jugadores legendarios", 18) })
	if #h.legends == 0 then
		C.Label("Todavía no hay leyendas retiradas.", { TextColor3 = Theme.TextMuted, TextSize = 13 }).Parent = legends
	end
	for i = #h.legends, 1, -1 do
		local l = h.legends[i]
		C.Label(string.format("🏅 <b>%s</b> · media máx. %d · %d partidos · %d goles · %s · retirado en la T%d", l.name, l.peak, l.apps or 0, l.goals or 0,
			l.origin == "academy" and "canterano" or "fichaje", l.retiredSeason), { TextSize = 13 }).Parent = legends
	end
	add(legends)
end

local function renderRecords(add, ctx)
	local C, Format, state = ctx.C, ctx.Format, ctx.state
	local r = state.clubHistory.records
	local function line(label, value)
		return C.Label(string.format("%s: <b>%s</b>", label, value), { TextSize = 14 })
	end
	add(C.Card({}, {
		C.Title("🏅 Récords del club", 18),
		line("Mayor victoria", r.biggestWin and string.format("%d-%d contra %s (T%d)", r.biggestWin.gf, r.biggestWin.ga, r.biggestWin.opponent, r.biggestWin.season) or "—"),
		line("Peor derrota", r.worstDefeat and string.format("%d-%d contra %s (T%d)", r.worstDefeat.gf, r.worstDefeat.ga, r.worstDefeat.opponent, r.worstDefeat.season) or "—"),
		line("Mejor racha invicta", tostring(r.unbeatenBest or 0) .. " partidos"),
		line("Más puntos en una temporada", r.bestSeasonPoints and string.format("%d (T%d, %s)", r.bestSeasonPoints.points, r.bestSeasonPoints.season, r.bestSeasonPoints.division) or "—"),
		line("Más goles de un jugador en una temporada", r.mostGoalsSeason and string.format("%s, %d (T%d)", r.mostGoalsSeason.name, r.mostGoalsSeason.goals, r.mostGoalsSeason.season) or "—"),
		line("Fichaje más caro", r.biggestSigning and string.format("%s por %s (T%d)", r.biggestSigning.name, Format.Money(r.biggestSigning.fee), r.biggestSigning.season) or "—"),
		line("Venta más cara", r.biggestSale and string.format("%s a %s por %s (T%d)", r.biggestSale.name, r.biggestSale.club, Format.Money(r.biggestSale.fee), r.biggestSale.season) or "—"),
		line("Reputación máxima", r.highestReputation and string.format("%d (T%d)", r.highestReputation.value, r.highestReputation.season) or "—"),
	}))
end

local function renderTimeline(add, ctx)
	local C, Theme, state = ctx.C, ctx.Theme, ctx.state
	local timeline = state.clubHistory.timeline
	local card = C.Card({}, { C.Title("🕰️ Cronología", 18) })
	if #timeline == 0 then
		C.Label("Los acontecimientos importantes del club aparecerán aquí.", { TextColor3 = Theme.TextMuted, TextSize = 13 }).Parent = card
	end
	for _, e in ipairs(timeline) do
		C.Label(string.format("<font color='#8C9BB4'>%s</font>  %s %s", os.date("%d/%m %H:%M", e.t or 0), e.icon, e.text), { TextSize = 13 }).Parent = card
	end
	add(card)
end

function History.Render(container, ctx)
	local C = ctx.C
	local tab = ctx.params.tab or "summary"
	local scroll = C.Scroll()
	scroll.Parent = container
	local add = C.Stack(scroll)
	add(C.Title("📜 Historia del club", 26))
	local tabs = {
		{ id = "summary", label = "Resumen" },
		{ id = "seasons", label = "Temporadas" },
		{ id = "players", label = "Jugadores" },
		{ id = "records", label = "Récords" },
		{ id = "timeline", label = "Cronología" },
	}
	local buttons = {}
	for _, t in ipairs(tabs) do
		table.insert(buttons, C.Button(t.label, tab == t.id and "primary" or "secondary", function()
			ctx.navigate("history", { tab = t.id })
		end))
	end
	add(C.Row(buttons, 8))
	if tab == "seasons" then
		renderSeasons(add, ctx)
	elseif tab == "players" then
		renderPlayers(add, ctx)
	elseif tab == "records" then
		renderRecords(add, ctx)
	elseif tab == "timeline" then
		renderTimeline(add, ctx)
	else
		renderSummary(add, ctx)
	end
end

return History
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000003F"><Properties><string name="Name">Home</string><ProtectedString name="Source"><![CDATA[-- Home (ModuleScript) · Pantalla "Inicio"
-- Ubicación: StarterPlayer/StarterPlayerScripts/Client/Screens/Home

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local FacilityConfig = require(Shared.Config.FacilityConfig)
local CosmeticConfig = require(Shared.Config.CosmeticConfig)
local EconomyFormulas = require(Shared.Modules.EconomyFormulas)
local SponsorConfig = require(Shared.Config.SponsorConfig)

local Home = {}

-- Sugiere los siguientes pasos a partir del estado real del club.
local function nextSteps(state, Format)
	local steps = {}
	if not state.club.named then
		table.insert(steps, { text = "Ponle nombre y abreviatura a tu club.", screen = "club" })
	end
	local pseudo = {
		stadium = state.stadium,
		economy = { money = state.economy.money, debt = state.economy.debt },
		club = { reputationEarned = 0 },
	}
	local cheapest, cheapestCost
	for _, id in ipairs(FacilityConfig.Order) do
		local ok, _, levelData = EconomyFormulas.CanUpgrade(pseudo, id)
		if levelData and (ok or (levelData.minStage <= state.stadium.stage)) then
			if not cheapestCost or levelData.cost < cheapestCost then
				cheapest, cheapestCost = id, levelData.cost
			end
		end
	end
	if cheapest then
		local def = FacilityConfig.Get(cheapest)
		table.insert(steps, {
			text = string.format("Mejora %s %s (%s).", def.icon, def.name, Format.Money(cheapestCost)),
			screen = "build",
		})
	end
	local stageOk, _, nextStage = EconomyFormulas.CanUpgradeStage(pseudo)
	if stageOk and nextStage then
		table.insert(steps, 1, {
			text = string.format("¡Puedes ascender tu estadio a %s! (%s)", nextStage.name, Format.Money(nextStage.upgradeCost)),
			screen = "stadium",
		})
	end
	local freeSlots = 0
	for _, slot in ipairs(SponsorConfig.Slots) do
		if state.stadium.stage >= slot.minStage and not state.sponsors.contracts[slot.id] then
			freeSlots += 1
		end
	end
	if freeSlots > 0 then
		table.insert(steps, { text = string.format("Tienes %d hueco(s) de patrocinio libres: firma un contrato.", freeSlots), screen = "economy", params = { tab = "sponsors" } })
	end
	if (state.club.satisfaction or 50) < 40 then
		table.insert(steps, { text = "La afición está descontenta: revisa precios en Economía › Aficionados.", screen = "economy", params = { tab = "fans" } })
	end
	if state.economy.debt > 0 then
		table.insert(steps, { text = "Tienes deuda: págala en Economía para evitar intereses.", screen = "economy" })
	end
	if state.economy.forecast.attendance >= state.economy.forecast.capacity then
		table.insert(steps, { text = "¡Estadio lleno! Amplía las gradas o sube el precio de las entradas.", screen = "build" })
	end
	table.insert(steps, { text = "Personaliza escudo, colores y equipación.", screen = "club" })
	return steps
end

function Home.Render(container, ctx)
	local C, Theme, Format, state = ctx.C, ctx.Theme, ctx.Format, ctx.state
	local scroll = C.Scroll({}, nil)
	scroll.Parent = container
	local add = C.Stack(scroll)

	local crest = CosmeticConfig.ById.crest[state.club.effectiveAppearance.crest]
	local header = C.Card({ BackgroundColor3 = Theme.Panel }, {
		C.Label("BIENVENIDO, PRESIDENTE", { TextColor3 = Theme.Accent, Font = Theme.FontBold, TextSize = 13 }),
		C.Title((crest and crest.symbol or "⚽") .. "  " .. state.club.name, 28),
		C.Label(string.format("🏟️ %s · Terreno %s · Fundado en %s",
			state.stadium.stageName,
			tostring(state.stadium.plotIndex or "—"),
			os.date("%d/%m/%Y", state.club.founded)), { TextColor3 = Theme.TextDim }),
	})
	add(header)
	if state.premium.owned.VIP_CLUB then
		C.Badge("👑 MIEMBRO VIP CLUB", Theme.Gold, Color3.fromRGB(35, 25, 0)).Parent = header
	end

	if not state.saveEnabled then
		add(C.Card({ BackgroundColor3 = Color3.fromRGB(70, 45, 10) }, {
			C.Label("⚠️ <b>Guardado desactivado en esta sesión.</b> DataStore no está disponible "
				.. "(en Studio: Game Settings › Security › Enable Studio Access to API Services). "
				.. "Puedes jugar, pero el progreso no se guardará.", { TextSize = 14 }),
		}))
	end

	-- Evento «Doces ou Travessuras»
	local hw = state.halloween
	if hw and hw.active then
		local card = C.Card({ BackgroundColor3 = Color3.fromRGB(45, 20, 55) }, {
			C.Title("🎃 Evento: " .. hw.name, 22),
			C.Label("Camina por tu estadio (y por los de otros clubes) y toca los <b>caramelos</b> brillantes del césped, la plaza y los carriles. "
				.. "En las puertas de las instalaciones pulsa <b>F</b>: ¿truco o trato? A veces caen caramelos… y a veces un buen susto. "
				.. "Además, en el campo hay un <b>balón</b>: ¡chuta y marca gol!", { TextSize = 14 }),
			C.Label(string.format("🍬 Caramelos: <b>%d</b> · recogidos en total: %d", hw.candy, hw.total), { TextSize = 16 }),
		})
		for _, reward in ipairs(hw.rewards) do
			local button = C.Button(reward.owned and "✔ Conseguido" or string.format("Canjear · %d 🍬", reward.cost), "primary", function()
				ctx.act("HalloweenExchange", { reward = reward.id })
			end, { Size = UDim2.new(0, 150, 0, 32), AutomaticSize = Enum.AutomaticSize.None, TextSize = 13 })
			C.SetEnabled(button, not reward.owned and hw.candy >= reward.cost)
			C.Row({
				C.Label(string.format("%s %s%s", reward.icon, reward.name, reward.money and (" (" .. Format.Money(reward.money) .. ")") or ""),
					{ Size = UDim2.new(1, -170, 0, 0), TextSize = 14 }),
				button,
			}).Parent = card
		end
		add(card)
	end

	-- KPIs
	local grid = C.Grid(200, 78, 10)
	add(grid)
	local eco = state.economy
	local stats = {
		{ "💰", "Dinero", Format.Money(eco.money), Theme.Gold },
		{ "📈", "Balance por jornada", Format.SignedMoney(eco.forecast.net), eco.forecast.net >= 0 and Theme.Accent or Theme.Danger },
		{ "🏦", "Valor del club", Format.Money(eco.clubValue) },
		{ "👥", "Aficionados / socios", Format.Short(state.club.fans) .. " / " .. Format.Short(state.club.members or 0) },
		{ "😊", "Satisfacción", tostring(math.floor((state.club.satisfaction or 0) + 0.5)) .. " / 100" },
		{ "⭐", "Reputación", tostring(eco.reputation) },
		{ "🎟️", "Asistencia prevista", string.format("%s / %s", Format.Thousands(eco.forecast.attendance), Format.Thousands(eco.forecast.capacity)) },
	}
	for i, s in ipairs(stats) do
		local stat = C.Stat(s[1], s[2], s[3], s[4])
		stat.LayoutOrder = i
		stat.Parent = grid
	end

	-- Próximos pasos
	local steps = C.Card({}, { C.Title("🎯 Próximos pasos", 18) })
	for _, step in ipairs(nextSteps(state, Format)) do
		local row = C.Row({
			C.Label("• " .. step.text, { Size = UDim2.new(1, -110, 0, 0) }),
			C.Button("Ir", "secondary", function()
				ctx.navigate(step.screen, step.params)
			end, { Size = UDim2.new(0, 90, 0, 32), AutomaticSize = Enum.AutomaticSize.None }),
		})
		row.Parent = steps
	end
	add(steps)

	-- Accesos rápidos
	add(C.Row({
		C.Button("🏟️ Ir a mi estadio", "primary", function()
			ctx.act("TeleportHome")
			ctx.close()
		end),
		C.Button("🏗️ Construir", "secondary", function()
			ctx.navigate("build")
		end),
		C.Button("💎 Tienda Premium", "gold", function()
			ctx.navigate("shop")
		end),
	}, 10))

	add(C.Label(string.format("Próxima jornada en %s · Las jornadas generan ingresos de entradas, tienda, restaurante y patrocinio, y cobran mantenimiento y personal.",
		Format.Duration(ctx.secondsToNextCycle())), { TextColor3 = Theme.TextMuted, TextSize = 13 }))
end

return Home
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000040"><Properties><string name="Name">Leagues</string><ProtectedString name="Source"><![CDATA[-- Leagues (ModuleScript) · Pantalla "Ligas" (FASE 7)
-- Ubicación: StarterPlayer/StarterPlayerScripts/Client/Screens/Leagues
-- Pestañas: Clasificación · Calendario · Copa · Carrera (objetivos, temporadas y palmarés).

local Leagues = {}

local function renderTable(add, ctx)
	local C, Theme, state = ctx.C, ctx.Theme, ctx.state
	local lg = state.league
	if not lg.started then
		add(C.Card({ BackgroundColor3 = Theme.Panel }, {
			C.Label(string.format("📅 Tu club debuta en <b>%s</b> la temporada %d. La liga empieza con la próxima temporada; mientras tanto puedes jugar amistosos.",
				lg.divisionName, lg.season), { TextSize = 14 }),
		}))
	end
	local card = C.Card({}, {
		C.Row({
			C.Title(string.format("🏆 %s · Temporada %d", lg.divisionName, lg.season), 18),
			C.Badge(string.format("División %d de %d", lg.division, lg.divisions), Theme.Panel, Theme.TextDim),
		}, 10),
		C.Label(string.format("Ascienden los %d primeros · descienden los %d últimos · 3 puntos por victoria.",
			lg.promote, lg.relegate), { TextSize = 13, TextColor3 = Theme.TextDim }),
	})
	local header = C.Label("<b>#  Equipo</b>", { TextSize = 13, TextColor3 = Theme.TextDim })
	header.Parent = card
	for _, r in ipairs(lg.standings) do
		local zone = ""
		if lg.promote > 0 and r.position <= lg.promote then
			zone = "⬆️"
		elseif lg.relegate > 0 and r.position > #lg.standings - lg.relegate then
			zone = "⬇️"
		end
		local row = C.New("Frame", {
			BackgroundColor3 = r.isUser and Theme.AccentDark or Theme.Panel,
			BackgroundTransparency = r.isUser and 0.2 or 0.6,
			Size = UDim2.new(1, 0, 0, 26),
			Children = { C.Corner(Theme.RadiusSmall) },
		})
		C.Label(string.format(" %d %s <b>%s</b> <font color='#8C9BB4'>(media %s)</font>", r.position, zone, r.name, tostring(r.strength or "?")), {
			Size = UDim2.new(0.58, 0, 1, 0), AutomaticSize = Enum.AutomaticSize.None, TextSize = 13, TextTruncate = Enum.TextTruncate.AtEnd, TextWrapped = false,
		}).Parent = row
		C.Label(string.format("%d PJ · %d-%d-%d · %d:%d · <b>%d pts</b> · %s", r.p, r.w, r.d, r.l, r.gf, r.ga, r.pts, table.concat(r.form, "")), {
			Position = UDim2.fromScale(0.58, 0), Size = UDim2.new(0.42, -6, 1, 0), AutomaticSize = Enum.AutomaticSize.None,
			TextXAlignment = Enum.TextXAlignment.Right, TextSize = 12, TextWrapped = false,
		}).Parent = row
		row.Parent = card
	end
	add(card)
end

local function renderCalendar(add, ctx)
	local C, Theme, Format, state = ctx.C, ctx.Theme, ctx.Format, ctx.state
	local lg = state.league
	add(C.Label(string.format("Los partidos de liga se simulan automáticamente en cada jornada (cada %s) con tu alineación y tu táctica.",
		Format.Duration(state.economy.cycleSeconds)), { TextColor3 = Theme.TextDim, TextSize = 13 }))
	local card = C.Card({}, { C.Title("📅 Tus partidos de liga", 18) })
	for _, f in ipairs(lg.fixtures) do
		local played = f.hg ~= nil
		local text
		if played then
			local us = f.home and f.hg or f.ag
			local them = f.home and f.ag or f.hg
			local icon = us > them and "✅" or (us == them and "➖" or "❌")
			text = string.format("%s J%d · %s <b>%d - %d</b> %s", icon, f.round, f.homeShort, f.hg, f.ag, f.awayShort)
		else
			local inCycles = f.cycle - lg.cycle
			text = string.format("🕒 J%d · %s vs %s · %s · %s", f.round, f.homeName, f.awayName, f.home and "en casa" or "fuera",
				(lg.started and inCycles >= 0) and (inCycles == 0 and "esta jornada" or ("en " .. inCycles .. " jornada(s)")) or "próxima temporada")
		end
		C.Label(text, { TextSize = 14, TextColor3 = played and Theme.Text or Theme.TextDim }).Parent = card
	end
	add(card)
end

local function renderCup(add, ctx)
	local C, Theme, state = ctx.C, ctx.Theme, ctx.state
	local cup = state.league.cup
	local status = cup.champion and "🏆 ¡Campeón!" or (cup.alive and "✅ Sigues en competición" or ("❌ Eliminado en " .. tostring(cup.eliminatedIn)))
	add(C.Card({ BackgroundColor3 = Theme.Panel }, {
		C.Title("🏆 " .. cup.name, 20),
		C.Label(string.format("16 equipos · eliminatoria a partido único (penaltis si hay empate) · rondas en las jornadas %s de la temporada.",
			table.concat(cup.cycles, ", ")), { TextSize = 13, TextColor3 = Theme.TextDim }),
		C.Label(status, { TextSize = 15 }),
	}))
	for index, name in ipairs(cup.roundNames) do
		local round = cup.rounds[index]
		local card = C.Card({}, { C.Title(name, 16) })
		if not round then
			C.Label("Por disputar.", { TextColor3 = Theme.TextMuted, TextSize = 13 }).Parent = card
		else
			for _, m in ipairs(round.matches) do
				C.Label(string.format("%s%s %d - %d %s%s", m.user and (m.userWon and "✅ " or "❌ ") or "", m.home, m.hg, m.ag, m.away,
					m.penalties and " (penaltis)" or ""), { TextSize = 13, TextColor3 = m.user and Theme.Text or Theme.TextDim }).Parent = card
			end
		end
		add(card)
	end
end

local function renderCareer(add, ctx)
	local C, Theme, state = ctx.C, ctx.Theme, ctx.state
	local lg = state.league
	local confidenceColor = lg.boardConfidence >= 60 and Theme.Accent or (lg.boardConfidence >= 30 and Theme.Warning or Theme.Danger)
	add(C.Card({}, {
		C.Title("🎯 Objetivo de la junta directiva", 18),
		C.Label(string.format("<b>%s</b> (vuestra plantilla es la %dª más fuerte de la liga).", lg.objective and lg.objective.text or "—",
			lg.objective and lg.objective.expectedRank or 0), { TextSize = 15 }),
		C.Label(string.format("Confianza de la junta: %d / 100", lg.boardConfidence), { TextSize = 14 }),
		C.ProgressBar(lg.boardConfidence / 100, confidenceColor, 10),
		C.Label("Cumplir el objetivo da un premio y más confianza; fallarlo, la reduce.", { TextSize = 13, TextColor3 = Theme.TextDim }),
	}))

	local trophies = C.Card({}, { C.Title(string.format("🏆 Palmarés (%d)", #lg.trophies), 18) })
	if #lg.trophies == 0 then
		C.Label("Todavía no hay títulos. ¡Gana la liga o la copa!", { TextColor3 = Theme.TextMuted, TextSize = 13 }).Parent = trophies
	end
	for i = #lg.trophies, 1, -1 do
		local t = lg.trophies[i]
		C.Label(string.format("%s %s · temporada %d", t.kind == "cup" and "🥇" or "🏆", t.name, t.season), { TextSize = 14 }).Parent = trophies
	end
	add(trophies)

	local seasons = C.Card({}, { C.Title("📈 Temporadas", 18) })
	if #lg.history == 0 then
		C.Label("Aún no ha terminado ninguna temporada.", { TextColor3 = Theme.TextMuted, TextSize = 13 }).Parent = seasons
	end
	for i = #lg.history, 1, -1 do
		local h = lg.history[i]
		local tags = {}
		if h.champion then
			table.insert(tags, "🏆 campeón")
		end
		if h.promoted then
			table.insert(tags, "⬆️ ascenso")
		end
		if h.relegated then
			table.insert(tags, "⬇️ descenso")
		end
		table.insert(tags, "copa: " .. tostring(h.cup))
		table.insert(tags, h.objectiveMet and "objetivo ✅" or "objetivo ❌")
		C.Label(string.format("T%d · %s · <b>%dº</b> · %d pts (%d-%d-%d, %d:%d) · %s", h.season, h.divisionName, h.position, h.points,
			h.w, h.d, h.l, h.gf, h.ga, table.concat(tags, " · ")), { TextSize = 13 }).Parent = seasons
	end
	add(seasons)
end

function Leagues.Render(container, ctx)
	local C = ctx.C
	local tab = ctx.params.tab or "table"
	local scroll = C.Scroll()
	scroll.Parent = container
	local add = C.Stack(scroll)
	add(C.Title("🏆 Ligas y modo carrera", 26))
	local tabs = {
		{ id = "table", label = "Clasificación" },
		{ id = "calendar", label = "Calendario" },
		{ id = "cup", label = "Copa" },
		{ id = "career", label = "Carrera" },
	}
	local buttons = {}
	for _, t in ipairs(tabs) do
		table.insert(buttons, C.Button(t.label, tab == t.id and "primary" or "secondary", function()
			ctx.navigate("leagues", { tab = t.id })
		end))
	end
	add(C.Row(buttons, 8))
	if tab == "calendar" then
		renderCalendar(add, ctx)
	elseif tab == "cup" then
		renderCup(add, ctx)
	elseif tab == "career" then
		renderCareer(add, ctx)
	else
		renderTable(add, ctx)
	end
end

return Leagues
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000041"><Properties><string name="Name">Matches</string><ProtectedString name="Source"><![CDATA[-- Matches (ModuleScript) · Pantalla "Partidos" (FASE 5)
-- Ubicación: StarterPlayer/StarterPlayerScripts/Client/Screens/Matches
-- Pestañas: Alineación · Tácticas · Amistosos · Historial.
-- Todos los partidos son SIMULADOS por el servidor.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local FootballConfig = require(Shared.Config.FootballConfig)
local TacticsConfig = require(Shared.Config.TacticsConfig)
local MatchEngine = require(Shared.Modules.MatchEngine)

local UI = script.Parent.Parent:WaitForChild("UI")
local MatchViewer = require(UI.MatchViewer)

local Matches = {}

local function playersById(state)
	local map = {}
	for _, p in ipairs(state.football.squad) do
		map[p.id] = p
	end
	return map
end

local function playerLine(p)
	if not p then
		return "— vacío —"
	end
	local pos = FootballConfig.Position(p.pos)
	return string.format("<b>%s</b> · %s · media %d · 💪 %d%s", p.name, pos.short, p.ovr, p.fitness or 100,
		(p.injury or 0) > 0 and string.format(" · 🚑 %d j.", p.injury) or "")
end

local function renderLineup(add, ctx)
	local C, Theme, state = ctx.C, ctx.Theme, ctx.state
	local md = state.matchday
	local byId = playersById(state)

	local formationButtons = {}
	for _, f in ipairs(TacticsConfig.Formations) do
		table.insert(formationButtons, C.Button(f.name, md.tactics.formation == f.id and "primary" or "secondary", function()
			if md.tactics.formation ~= f.id then
				ctx.act("SetFormation", { formation = f.id })
			end
		end))
	end
	add(C.Row(formationButtons, 6))
	add(C.Button("⚡ Alineación automática (mejor once disponible)", "secondary", function()
		ctx.act("AutoLineup")
	end))

	local selectedSlot = ctx.params.slot
	local card = C.Card({}, { C.Title("📋 Once titular", 18) })
	local inLineup = {}
	for index, slot in ipairs(md.tactics.lineup) do
		inLineup[slot.id] = index
		local p = byId[slot.id]
		local pos = FootballConfig.Position(slot.slotPos)
		local outOfPosition = p and p.pos ~= slot.slotPos
		C.Row({
			C.Label(string.format("%d. %s %s · %s%s", index, pos.icon, pos.short, playerLine(p),
				outOfPosition and "  <font color='#FFA028'>(fuera de posición)</font>" or ""), { Size = UDim2.new(1, -110, 0, 0), TextSize = 14 }),
			C.Button(selectedSlot == index and "Cancelar" or "Cambiar", selectedSlot == index and "danger" or "secondary", function()
				ctx.navigate("matches", { tab = "lineup", slot = selectedSlot ~= index and index or nil })
			end, { Size = UDim2.new(0, 96, 0, 30), AutomaticSize = Enum.AutomaticSize.None, TextSize = 13 }),
		}).Parent = card
	end
	add(card)

	if selectedSlot then
		local slotPos = md.tactics.lineup[selectedSlot].slotPos
		local picker = C.Card({ BackgroundColor3 = Theme.CardAlt }, {
			C.Title(string.format("Elegir jugador para el puesto %d (%s)", selectedSlot, FootballConfig.Position(slotPos).short), 16),
		})
		local candidates = {}
		for _, p in ipairs(state.football.squad) do
			local score = p.ovr * MatchEngine.PlayerFactor({ pos = p.pos, slotPos = slotPos, fitness = p.fitness })
			table.insert(candidates, { p = p, score = score })
		end
		table.sort(candidates, function(a, b)
			return a.score > b.score
		end)
		for _, entry in ipairs(candidates) do
			local p = entry.p
			local injured = (p.injury or 0) > 0
			local choose = C.Button(inLineup[p.id] and "Intercambiar" or "Elegir", "primary", function()
				ctx.act("SetLineupSlot", { slot = selectedSlot, id = p.id })
				ctx.navigate("matches", { tab = "lineup" })
			end, { Size = UDim2.new(0, 110, 0, 30), AutomaticSize = Enum.AutomaticSize.None, TextSize = 13 })
			C.SetEnabled(choose, not injured and inLineup[p.id] ~= selectedSlot)
			C.Row({
				C.Label(string.format("%s · rendimiento en el puesto %d", playerLine(p), math.floor(entry.score + 0.5)),
					{ Size = UDim2.new(1, -125, 0, 0), TextSize = 13 }),
				choose,
			}).Parent = picker
		end
		add(picker)
	end

	local bench = C.Card({}, { C.Title("🪑 Suplentes", 16) })
	for _, p in ipairs(state.football.squad) do
		if not inLineup[p.id] then
			C.Label(playerLine(p), { TextSize = 13, TextColor3 = Theme.TextDim }).Parent = bench
		end
	end
	add(bench)
	add(C.Label("💪 = forma física (baja al jugar y se recupera cada jornada). Jugar fuera de posición reduce el rendimiento un 20 % (60 % si es un portero).",
		{ TextColor3 = Theme.TextMuted, TextSize = 13 }))
end

local function ratingBar(ctx, label, value)
	local C, Theme = ctx.C, ctx.Theme
	local row = C.New("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 22) })
	C.Label(label, { Size = UDim2.new(0, 110, 1, 0), AutomaticSize = Enum.AutomaticSize.None, TextSize = 14 }).Parent = row
	local bar = C.ProgressBar(value / 100, Theme.Accent, 10)
	bar.Position = UDim2.new(0, 115, 0.5, -5)
	bar.Size = UDim2.new(1, -165, 0, 10)
	bar.Parent = row
	C.Label(tostring(math.floor(value + 0.5)), { Position = UDim2.new(1, -44, 0, 0), Size = UDim2.new(0, 44, 1, 0),
		AutomaticSize = Enum.AutomaticSize.None, TextXAlignment = Enum.TextXAlignment.Right, Font = Theme.FontBold, TextSize = 14 }).Parent = row
	return row
end

local function renderTactics(add, ctx)
	local C, Theme, state = ctx.C, ctx.Theme, ctx.state
	local md = state.matchday
	local byId = playersById(state)

	-- Previsualización con la misma fórmula que el motor del servidor
	local sheet = { mentality = md.tactics.mentality, style = md.tactics.style, players = {} }
	for _, slot in ipairs(md.tactics.lineup) do
		local p = byId[slot.id]
		if p then
			table.insert(sheet.players, { id = p.id, name = p.name, pos = p.pos, slotPos = slot.slotPos, attrs = p.attrs, fitness = p.fitness })
		end
	end
	local ratings = MatchEngine.TeamRatings(sheet, false)
	add(C.Card({}, {
		C.Title("📊 Valoración del once", 18),
		ratingBar(ctx, "⚔️ Ataque", ratings.attack),
		ratingBar(ctx, "🎯 Medio campo", ratings.midfield),
		ratingBar(ctx, "🛡️ Defensa", ratings.defense),
		ratingBar(ctx, "🧤 Portería", ratings.keeper),
		C.Label("El medio campo decide la posesión; el ataque contra la defensa rival, las ocasiones; el tiro contra el portero, los goles. La resistencia pesa a partir del minuto 60.",
			{ TextColor3 = Theme.TextDim, TextSize = 13 }),
	}))

	local mentalityCard = C.Card({}, { C.Title("🧠 Mentalidad", 18) })
	for _, m in ipairs(TacticsConfig.Mentalities) do
		local selected = md.tactics.mentality == m.id
		C.Row({
			C.Button(m.name, selected and "primary" or "secondary", function()
				if not selected then
					ctx.act("SetTactic", { kind = "mentality", value = m.id })
				end
			end, { Size = UDim2.new(0, 130, 0, 34), AutomaticSize = Enum.AutomaticSize.None }),
			C.Label(string.format("%s (ataque ×%.2f, defensa ×%.2f)", m.description, m.attack, m.defense), { Size = UDim2.new(1, -150, 0, 0), TextSize = 13 }),
		}).Parent = mentalityCard
	end
	add(mentalityCard)

	local styleCard = C.Card({}, { C.Title("🎨 Estilo de juego", 18) })
	for _, st in ipairs(TacticsConfig.Styles) do
		local selected = md.tactics.style == st.id
		C.Row({
			C.Button(st.name, selected and "primary" or "secondary", function()
				if not selected then
					ctx.act("SetTactic", { kind = "style", value = st.id })
				end
			end, { Size = UDim2.new(0, 130, 0, 34), AutomaticSize = Enum.AutomaticSize.None }),
			C.Label(st.description, { Size = UDim2.new(1, -150, 0, 0), TextSize = 13 }),
		}).Parent = styleCard
	end
	add(styleCard)
end

local function renderFriendlies(add, ctx)
	local C, Theme, Format, state = ctx.C, ctx.Theme, ctx.Format, ctx.state
	local md = state.matchday
	add(C.Card({ BackgroundColor3 = Theme.Panel }, {
		C.Label("ℹ️ Los partidos son <b>simulaciones</b>: el servidor calcula el resultado a partir de la calidad de tus jugadores, su forma física, la alineación, la táctica y el factor campo, y después lo ves como resumen. El modo jugable en tiempo real llegará en una fase posterior.",
			{ TextSize = 13 }),
		C.Label(string.format("Media de tu mejor once: <b>%.1f</b> · Un amistoso por jornada, además de los partidos de liga y copa (se juegan solos en cada jornada).", md.strength), { TextSize = 13, TextColor3 = Theme.TextDim }),
	}))
	if md.friendlyPlayed then
		add(C.Label(string.format("Ya has jugado el amistoso de esta jornada. Nuevos rivales en %s.", Format.Duration(ctx.secondsToNextCycle())),
			{ TextColor3 = Theme.Warning }))
	end
	for _, offer in ipairs(md.friendlies or {}) do
		local difficulty
		for _, d in ipairs(TacticsConfig.FRIENDLY_DIFFICULTY) do
			if d.id == offer.difficulty then
				difficulty = d
			end
		end
		local prize = math.floor(TacticsConfig.FRIENDLY_PRIZE_BASE * (offer.strength / 50) ^ 2)
		local play = C.Button("▶ Simular partido", "primary", function()
			local result = ctx.act("PlayFriendly", { offer = offer.id })
			if result.ok and result.data then
				MatchViewer.Show(result.data)
			end
		end)
		C.SetEnabled(play, not md.friendlyPlayed)
		add(C.Card({}, {
			C.Row({
				C.Title(offer.name, 18),
				C.Badge(difficulty and difficulty.name or "", difficulty and difficulty.id == "HARD" and Theme.Danger or (difficulty and difficulty.id == "EASY" and Theme.AccentDark or Theme.Info)),
			}, 10),
			C.Label(string.format("Media %d · %s · %s · %s · premio por victoria %s",
				offer.strength, TacticsConfig.Formation(offer.formation).name, TacticsConfig.Mentality(offer.mentality).name,
				TacticsConfig.Style(offer.style).name, Format.Money(prize)), { TextSize = 13, TextColor3 = Theme.TextDim }),
			play,
		}))
	end
end

local function renderHistory(add, ctx)
	local C, Theme, Format, state = ctx.C, ctx.Theme, ctx.Format, ctx.state
	local md = state.matchday
	local t = md.totals
	local grid = C.Grid(160, 78, 10)
	add(grid)
	local stats = {
		{ "⚽", "Partidos", tostring(t.played) },
		{ "✅", "V / E / D", string.format("%d / %d / %d", t.wins, t.draws, t.losses) },
		{ "🥅", "Goles", string.format("%d - %d", t.goalsFor, t.goalsAgainst) },
		{ "🔥", "Mejor racha invicta", tostring(md.records.unbeatenBest or 0) },
	}
	for i, st in ipairs(stats) do
		local stat = C.Stat(st[1], st[2], st[3])
		stat.LayoutOrder = i
		stat.Parent = grid
	end
	local r = md.records
	add(C.Card({}, {
		C.Title("🏅 Récords", 18),
		C.Label(r.biggestWin and string.format("Mayor victoria: %d-%d contra %s (temporada %d)", r.biggestWin.gf, r.biggestWin.ga, r.biggestWin.opponent, r.biggestWin.season) or "Mayor victoria: —", { TextSize = 14 }),
		C.Label(r.worstDefeat and string.format("Peor derrota: %d-%d contra %s (temporada %d)", r.worstDefeat.gf, r.worstDefeat.ga, r.worstDefeat.opponent, r.worstDefeat.season) or "Peor derrota: —", { TextSize = 14 }),
	}))
	local list = C.Card({}, { C.Title("📜 Últimos partidos", 18) })
	if #md.matches == 0 then
		C.Label("Todavía no has jugado ningún partido.", { TextColor3 = Theme.TextMuted }).Parent = list
	end
	for i = #md.matches, 1, -1 do
		local m = md.matches[i]
		local icon = m.outcome == "W" and "✅" or (m.outcome == "D" and "➖" or "❌")
		C.Label(string.format("%s <b>%d-%d</b> vs %s · %s · temporada %d%s%s · %s",
			icon, m.gf, m.ga, m.opponent, m.competition or "", m.season or 1,
			#m.scorers > 0 and ("<br/><font color='#A0AFC8'>⚽ " .. table.concat(m.scorers, ", ") .. "</font>") or "",
			m.mvp and ("<br/><font color='#FFC400'>⭐ " .. m.mvp .. "</font>") or "",
			Format.Money(m.prize or 0)), { TextSize = 14 }).Parent = list
	end
	add(list)
end

function Matches.Render(container, ctx)
	local C = ctx.C
	local tab = ctx.params.tab or "friendlies"
	local scroll = C.Scroll()
	scroll.Parent = container
	local add = C.Stack(scroll)
	add(C.Title("⚽ Partidos", 26))
	if ctx.lastMatch then
		local m = ctx.lastMatch
		add(C.Button(string.format("▶ Ver último partido simulado (%s: %s %d - %d %s)", m.competition or "", m.home.short, m.home.goals, m.away.goals, m.away.short),
			"gold", function()
				MatchViewer.Show(ctx.lastMatch)
			end))
	end
	local tabs = {
		{ id = "friendlies", label = "Amistosos" },
		{ id = "lineup", label = "Alineación" },
		{ id = "tactics", label = "Tácticas" },
		{ id = "history", label = "Historial" },
	}
	local buttons = {}
	for _, t in ipairs(tabs) do
		table.insert(buttons, C.Button(t.label, tab == t.id and "primary" or "secondary", function()
			ctx.navigate("matches", { tab = t.id })
		end))
	end
	add(C.Row(buttons, 8))
	if tab == "lineup" then
		renderLineup(add, ctx)
	elseif tab == "tactics" then
		renderTactics(add, ctx)
	elseif tab == "history" then
		renderHistory(add, ctx)
	else
		renderFriendlies(add, ctx)
	end
end

return Matches
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000042"><Properties><string name="Name">Settings</string><ProtectedString name="Source"><![CDATA[-- Settings (ModuleScript) · Pantalla "Configuración"
-- Ubicación: StarterPlayer/StarterPlayerScripts/Client/Screens/Settings

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.Config.GameConfig)

local Settings = {}

function Settings.Render(container, ctx)
	local C, Theme, state = ctx.C, ctx.Theme, ctx.state
	local settings = state.settings
	local scroll = C.Scroll()
	scroll.Parent = container
	local add = C.Stack(scroll)

	add(C.Title("⚙️ Configuración", 26))

	local function toggle(title, description, key)
		local on = settings[key] == true
		return C.Card({}, {
			C.Row({
				C.Label("<b>" .. title .. "</b>", { Size = UDim2.new(1, -140, 0, 0) }),
				C.Button(on and "Activado" or "Desactivado", on and "primary" or "secondary", function()
					ctx.act("SaveSettings", { [key] = not on })
				end, { Size = UDim2.new(0, 120, 0, 36), AutomaticSize = Enum.AutomaticSize.None }),
			}),
			C.Label(description, { TextColor3 = Theme.TextDim, TextSize = 13 }),
		})
	end
	add(toggle("Notificaciones de jornada", "Muestra el resultado económico de cada jornada.", "notifications"))
	add(toggle("Menú compacto", "En PC, muestra solo los iconos del menú lateral.", "compactMenu"))

	add(C.Card({}, {
		C.Label(string.format("<b>Tamaño de la interfaz</b> · %d%%", math.floor(settings.uiScale * 100 + 0.5))),
		C.Row({
			C.Button("−", "secondary", function()
				ctx.act("SaveSettings", { uiScale = math.max(0.8, settings.uiScale - 0.1) })
			end, { Size = UDim2.new(0, 50, 0, 36), AutomaticSize = Enum.AutomaticSize.None }),
			C.Button("Restablecer", "secondary", function()
				ctx.act("SaveSettings", { uiScale = 1 })
			end),
			C.Button("+", "secondary", function()
				ctx.act("SaveSettings", { uiScale = math.min(1.3, settings.uiScale + 0.1) })
			end, { Size = UDim2.new(0, 50, 0, 36), AutomaticSize = Enum.AutomaticSize.None }),
		}, 8),
	}))

	add(C.Card({}, {
		C.Title("💾 Guardado", 18),
		C.Label(state.saveEnabled
			and string.format("Tu club se guarda automáticamente cada %d s, al salir y al cerrar el servidor.", GameConfig.AUTOSAVE_SECONDS)
			or "⚠️ El guardado no está disponible en esta sesión (DataStore inaccesible). El progreso no se guardará.",
			{ TextColor3 = state.saveEnabled and Theme.TextDim or Theme.Warning, TextSize = 14 }),
		C.Button("Guardar ahora", "primary", function()
			ctx.act("SaveNow")
		end),
	}))

	add(C.Card({}, {
		C.Title("ℹ️ Acerca de", 18),
		C.Label(string.format("%s · versión %s · FASE %d de 12", GameConfig.GAME_NAME, GameConfig.VERSION, state.phase), { TextColor3 = Theme.TextDim, TextSize = 14 }),
		C.Label("Atajo: tecla M para abrir o cerrar el menú.", { TextColor3 = Theme.TextMuted, TextSize = 13 }),
	}))
end

return Settings
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000043"><Properties><string name="Name">Shop</string><ProtectedString name="Source"><![CDATA[-- Shop (ModuleScript) · TIENDA PREMIUM
-- Ubicación: StarterPlayer/StarterPlayerScripts/Client/Screens/Shop
--
-- Muestra los Game Passes con su estado REAL enviado por el servidor:
--   pendiente de configuración · comprobando · disponible · adquirido · error · próximamente.
-- El botón de compra solo pide al servidor que abra la ventana oficial de Roblox.
-- La interfaz nunca marca un pase como comprado por sí misma.

local Shop = {}

local STATUS = {
	pending_config = { text = "⚙️ Pendiente de configuración", color = "Warning" },
	checking = { text = "⏳ Comprobando con Roblox…", color = "Info" },
	owned = { text = "✅ ADQUIRIDO", color = "Accent" },
	not_owned = { text = "Disponible", color = "CardAlt" },
	error = { text = "⚠️ No verificado · reintentando", color = "Danger" },
	inactive = { text = "Próximamente", color = "Locked" },
}

local function priceText(pass, Format)
	if pass.status == "pending_config" then
		return "Precio: se mostrará cuando el pase esté configurado"
	elseif pass.status == "inactive" then
		return "Llegará en la FASE " .. pass.phase
	elseif pass.priceKnown and pass.forSale and pass.price then
		return "R$ " .. Format.Thousands(pass.price)
	elseif pass.priceKnown and not pass.forSale then
		return "No está a la venta en este momento"
	end
	return "Precio no disponible ahora mismo"
end

local function passCard(ctx, pass, focused)
	local C, Theme, Format = ctx.C, ctx.Theme, ctx.Format
	local status = STATUS[pass.status] or STATUS.pending_config
	local owned = pass.status == "owned"
	local active = pass.active

	local card = C.New("Frame", {
		BackgroundColor3 = active and Theme.Card or Theme.Panel,
		BorderSizePixel = 0,
		Children = {
			C.Corner(UDim.new(0, 14)),
			C.Stroke(focused and Theme.Gold or (owned and Theme.Accent or Theme.Stroke), (focused or owned) and 3 or 1),
		},
	})
	-- Franja superior con el color del pase
	C.New("Frame", {
		BackgroundColor3 = pass.accent,
		BackgroundTransparency = active and 0 or 0.6,
		Size = UDim2.new(1, 0, 0, 78),
		BorderSizePixel = 0,
		Children = {
			C.Corner(UDim.new(0, 14)),
			C.New("UIGradient", {
				Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(120, 120, 120)),
				Rotation = 90,
			}),
		},
	}, card)
	if pass.iconImage then
		C.New("ImageLabel", {
			BackgroundTransparency = 1, Image = pass.iconImage,
			Position = UDim2.fromOffset(14, 10), Size = UDim2.fromOffset(58, 58),
		}, card)
	else
		C.New("TextLabel", {
			BackgroundTransparency = 1, Text = pass.icon, TextScaled = true,
			Position = UDim2.fromOffset(14, 10), Size = UDim2.fromOffset(58, 58),
		}, card)
	end
	C.Label(pass.name, {
		Font = Theme.FontBlack, TextSize = 22, Position = UDim2.fromOffset(84, 14),
		Size = UDim2.new(1, -96, 0, 26), AutomaticSize = Enum.AutomaticSize.None, TextWrapped = false,
		TextColor3 = Color3.new(1, 1, 1), TextStrokeTransparency = 0.6,
	}).Parent = card
	local badge = C.Badge(status.text, Theme[status.color] or Theme.CardAlt,
		status.color == "Accent" and Color3.fromRGB(0, 40, 20) or Theme.Text)
	badge.Position = UDim2.fromOffset(84, 44)
	badge.Parent = card

	local body = C.New("Frame", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(14, 88),
		Size = UDim2.new(1, -28, 1, -150),
		Children = { C.List(nil, 6) },
	}, card)
	local add = C.Stack(body)
	add(C.Label(pass.description, { TextColor3 = Theme.TextDim, TextSize = 14 }))
	for _, benefit in ipairs(pass.benefits) do
		add(C.Label("✔  " .. benefit, { TextSize = 14, TextColor3 = active and Theme.Text or Theme.TextMuted }))
	end

	-- Pie: precio + botón
	C.Label(priceText(pass, Format), {
		Font = Theme.FontBold, TextSize = 15, TextColor3 = Theme.Gold,
		Position = UDim2.new(0, 14, 1, -96), Size = UDim2.new(1, -28, 0, 20),
		AutomaticSize = Enum.AutomaticSize.None, TextWrapped = false, TextTruncate = Enum.TextTruncate.AtEnd,
	}).Parent = card

	local waiting = ctx.pendingPurchase == pass.key
	local button = C.Button(waiting and "Esperando a Roblox…" or "Comprar", "gold", function()
		local result = ctx.act("PurchasePass", { pass = pass.key })
		if result.ok then
			ctx.pendingPurchase = pass.key
			task.delay(60, function()
				if ctx.pendingPurchase == pass.key then
					ctx.pendingPurchase = nil
				end
			end)
		end
	end, {
		Position = UDim2.new(0, 14, 1, -60),
		Size = UDim2.new(1, -28, 0, 44),
		AutomaticSize = Enum.AutomaticSize.None,
		TextSize = 18,
	})
	button.Parent = card

	if owned then
		C.SetEnabled(button, false, "✔ Pase adquirido · ventajas activas")
		button.BackgroundColor3 = Theme.AccentDark
	elseif not active then
		C.SetEnabled(button, false, "Próximamente")
	elseif pass.status == "pending_config" then
		C.SetEnabled(button, false, "Compra desactivada · falta el ID")
	elseif pass.status == "checking" then
		C.SetEnabled(button, false, "Comprobando…")
	elseif pass.status == "error" then
		C.SetEnabled(button, false, "Roblox no responde · reintentando")
	elseif pass.priceKnown and not pass.forSale then
		C.SetEnabled(button, false, "No disponible")
	elseif waiting then
		C.SetEnabled(button, false, "Esperando a Roblox…")
	end
	return card
end

function Shop.Render(container, ctx)
	local C, Theme = ctx.C, ctx.Theme
	local scroll = C.Scroll()
	scroll.Parent = container
	local add = C.Stack(scroll)

	-- Cabecera
	local header = C.New("Frame", {
		BackgroundColor3 = Color3.fromRGB(40, 30, 8),
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Children = {
			C.Corner(UDim.new(0, 14)), C.Stroke(Theme.Gold, 2), C.Padding(14), C.List(nil, 6),
			C.New("UIGradient", {
				Color = ColorSequence.new(Color3.fromRGB(255, 220, 120), Color3.fromRGB(140, 100, 20)),
				Rotation = 0,
				Transparency = NumberSequence.new(0.75),
			}),
		},
	})
	local addH = C.Stack(header)
	addH(C.Row({
		C.Title("💎 TIENDA PREMIUM", 30),
		C.Button("✕ Cerrar tienda", "secondary", function()
			ctx.close()
		end),
	}, 16))
	addH(C.Label("Ventajas cosméticas y de personalización para tu club. Ningún pase es necesario para jugar ni para progresar: "
		.. "la economía, la construcción y la competición son iguales para todos.", { TextColor3 = Theme.Text, TextSize = 14 }))
	add(header)

	local shop = ctx.shop
	if not shop then
		add(C.Label("Cargando la tienda…", { TextColor3 = Theme.TextDim }))
		task.spawn(ctx.act, "RefreshShop")
		return
	end

	local anyPending = false
	for _, pass in ipairs(shop) do
		if pass.active and pass.status == "pending_config" then
			anyPending = true
		end
	end
	if anyPending then
		add(C.Card({ BackgroundColor3 = Color3.fromRGB(70, 45, 10) }, {
			C.Label("⚙️ <b>Pases pendientes de configuración.</b> Estos Game Passes todavía no tienen un identificador de Roblox. "
				.. "La compra está desactivada hasta que el desarrollador cree los pases en el Creator Dashboard y añada sus IDs en "
				.. "<i>ReplicatedStorage › Shared › Config › GamePassConfig</i>.", { TextSize = 14 }),
		}))
	end

	add(C.Title("⭐ Pases disponibles", 20))
	local grid = C.Grid(300, 470, 12)
	add(grid)
	local i = 0
	for _, pass in ipairs(shop) do
		if pass.active then
			i += 1
			local card = passCard(ctx, pass, ctx.params.focus == pass.key)
			card.LayoutOrder = i
			card.Parent = grid
		end
	end

	add(C.Title("🔜 Próximamente", 20))
	add(C.Label("La tienda ya está preparada para estos pases; se activarán en las fases correspondientes.",
		{ TextColor3 = Theme.TextMuted, TextSize = 13 }))
	local future = C.Grid(300, 330, 12)
	add(future)
	i = 0
	for _, pass in ipairs(shop) do
		if not pass.active then
			i += 1
			local card = passCard(ctx, pass, false)
			card.LayoutOrder = i
			card.Parent = future
		end
	end
end

return Shop
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000044"><Properties><string name="Name">Squad</string><ProtectedString name="Source"><![CDATA[-- Squad (ModuleScript) · Pantalla "Plantilla" (FASE 4)
-- Ubicación: StarterPlayer/StarterPlayerScripts/Client/Screens/Squad
-- Jugadores con estadísticas, contratos, entrenamiento, renovaciones y rescisiones.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local FootballConfig = require(Shared.Config.FootballConfig)

local Squad = {}

local function ovrColor(Theme, ovr)
	if ovr >= 80 then
		return Theme.Gold
	elseif ovr >= 65 then
		return Theme.Accent
	elseif ovr >= 50 then
		return Theme.Info
	end
	return Theme.TextDim
end
Squad.OvrColor = ovrColor

-- Fila de atributo con barra
local function attrBar(ctx, attr, value)
	local C, Theme = ctx.C, ctx.Theme
	local row = C.New("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 20) })
	C.Label(attr.name, { Size = UDim2.new(0, 95, 1, 0), AutomaticSize = Enum.AutomaticSize.None, TextSize = 13, TextColor3 = Theme.TextDim }).Parent = row
	local bar = C.ProgressBar(value / 99, ovrColor(Theme, value), 8)
	bar.Position = UDim2.new(0, 100, 0.5, -4)
	bar.Size = UDim2.new(1, -140, 0, 8)
	bar.Parent = row
	C.Label(tostring(value), { Position = UDim2.new(1, -34, 0, 0), Size = UDim2.new(0, 34, 1, 0), AutomaticSize = Enum.AutomaticSize.None,
		TextXAlignment = Enum.TextXAlignment.Right, Font = Theme.FontBold, TextSize = 13 }).Parent = row
	return row
end
Squad.AttrBar = attrBar

-- Tarjeta de jugador reutilizable (también la usa la Academia).
-- opts = { expanded, onToggle, actions = function(card) }
function Squad.PlayerCard(ctx, p, opts)
	local C, Theme, Format = ctx.C, ctx.Theme, ctx.Format
	local pos = FootballConfig.Position(p.pos)
	local card = C.Card({ BackgroundColor3 = opts.expanded and Theme.CardAlt or Theme.Card })
	local header = C.New("TextButton", {
		Text = "",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 44),
		AutoButtonColor = false,
	})
	C.Label(tostring(p.ovr), {
		Font = Theme.FontBlack, TextSize = 26, TextColor3 = ovrColor(Theme, p.ovr),
		Size = UDim2.new(0, 46, 1, 0), AutomaticSize = Enum.AutomaticSize.None, TextXAlignment = Enum.TextXAlignment.Center,
	}).Parent = header
	local potential = p.potentialLow == p.potentialHigh and tostring(p.potentialLow) or (p.potentialLow .. "-" .. p.potentialHigh)
	local condition = ""
	if p.loan then
		condition = p.loan.type == "out" and (" · ➡️ cedido a " .. p.loan.club) or (" · ⬅️ cedido por " .. p.loan.club)
	elseif p.listed == "sale" then
		condition = " · 🏷️ en venta"
	elseif (p.injury or 0) > 0 then
		condition = string.format(" · 🚑 %d j.", p.injury)
	elseif p.fitness and p.fitness < 100 then
		condition = string.format(" · 💪 %d", p.fitness)
	end
	C.Label(string.format("<b>%s</b>%s\n<font color='#A0AFC8'>%s %s · %d años · potencial %s%s</font>",
		p.name, p.star and "  ⭐" or "", pos.icon, pos.short, p.age, potential, condition), {
		Position = UDim2.fromOffset(54, 0), Size = UDim2.new(1, -170, 1, 0), AutomaticSize = Enum.AutomaticSize.None, TextSize = 14,
	}).Parent = header
	local right = p.contract and p.contract > 0
		and string.format("%s/jornada\n%d temp.%s", Format.Money(p.salary), p.contract, p.contract <= 1 and " ⚠️" or "")
		or string.format("+%s/temp.", tostring(p.growth))
	C.Label(right, { Position = UDim2.new(1, -112, 0, 0), Size = UDim2.new(0, 112, 1, 0), AutomaticSize = Enum.AutomaticSize.None,
		TextXAlignment = Enum.TextXAlignment.Right, TextSize = 12, TextColor3 = Theme.TextDim }).Parent = header
	header.Activated:Connect(opts.onToggle)
	header.Parent = card

	if opts.expanded then
		for _, attr in ipairs(FootballConfig.Attributes) do
			attrBar(ctx, attr, p.attrs[attr.id] or 0).Parent = card
		end
		C.Label(string.format("Valor de mercado: <b>%s</b> · Evolución prevista: <b>%+.1f</b> de media por temporada · Partidos %d · Goles %d · Asistencias %d",
			Format.Money(p.value), p.growth, p.stats.apps, p.stats.goals, p.stats.assists), { TextSize = 13 }).Parent = card
		-- Foco de entrenamiento
		local focusButtons = { C.Button("Equilibrado", p.focus == nil and "primary" or "secondary", function()
			if p.focus ~= nil then
				ctx.act("SetTrainingFocus", { id = p.id, focus = "" })
			end
		end, { Size = UDim2.new(0, 0, 0, 30), TextSize = 13 }) }
		for _, attr in ipairs(FootballConfig.Attributes) do
			table.insert(focusButtons, C.Button(attr.short, p.focus == attr.id and "primary" or "secondary", function()
				if p.focus ~= attr.id then
					ctx.act("SetTrainingFocus", { id = p.id, focus = attr.id })
				end
			end, { Size = UDim2.new(0, 0, 0, 30), TextSize = 13 }))
		end
		C.Label("🎯 Foco de entrenamiento:", { TextSize = 13, TextColor3 = Theme.TextDim }).Parent = card
		C.Row(focusButtons, 6).Parent = card
		if opts.actions then
			opts.actions(card)
		end
	end
	return card
end

function Squad.Render(container, ctx)
	local C, Theme, Format, state = ctx.C, ctx.Theme, ctx.Format, ctx.state
	local football = state.football
	local scroll = C.Scroll()
	scroll.Parent = container
	local add = C.Stack(scroll)

	add(C.Row({
		C.Title("👕 Plantilla", 26),
		C.Badge(string.format("Temporada %d · jornada %d/%d", football.season.number, football.season.cycle + 1, football.season.length), Theme.Panel, Theme.TextDim),
	}, 12))

	-- Resumen
	local squad = football.squad
	local wages, value, best = 0, 0, {}
	for _, p in ipairs(squad) do
		wages += p.salary
		value += p.value
		table.insert(best, p.ovr)
	end
	table.sort(best, function(a, b)
		return a > b
	end)
	local top = 0
	for i = 1, math.min(11, #best) do
		top += best[i]
	end
	local grid = C.Grid(200, 78, 10)
	add(grid)
	local stats = {
		{ "👥", "Jugadores", string.format("%d / %d", #squad, FootballConfig.MAX_SQUAD) },
		{ "⭐", "Media del mejor 11", tostring(math.floor(top / math.max(1, math.min(11, #best)) + 0.5)) },
		{ "💸", "Salarios por jornada", Format.Money(wages) },
		{ "💎", "Valor de la plantilla", Format.Money(value) },
	}
	for i, st in ipairs(stats) do
		local stat = C.Stat(st[1], st[2], st[3])
		stat.LayoutOrder = i
		stat.Parent = grid
	end

	-- Entrenamiento
	local training = C.Card({}, {
		C.Title("🏋️ Entrenamiento", 18),
		C.Label(string.format("La evolución depende del potencial, la edad, la intensidad y el Centro de entrenamiento (multiplicador actual ×%.2f). "
			.. "Los jugadores mayores de 30 empiezan a declinar.", football.training.multiplier), { TextColor3 = Theme.TextDim, TextSize = 13 }),
	})
	local intensityButtons = {}
	for _, option in ipairs(FootballConfig.TrainingIntensities) do
		local selected = football.training.intensity == option.id
		table.insert(intensityButtons, C.Button(string.format("%s · ×%.1f", option.name, option.growth), selected and "primary" or "secondary", function()
			if not selected then
				ctx.act("SetTrainingIntensity", { intensity = option.id })
			end
		end))
	end
	C.Row(intensityButtons, 8).Parent = training
	add(training)

	-- Filtros
	local filter = ctx.params.filter or "ALL"
	local filterButtons = { C.Button("Todos", filter == "ALL" and "primary" or "secondary", function()
		ctx.navigate("squad", { filter = "ALL" })
	end) }
	for _, position in ipairs(FootballConfig.Positions) do
		table.insert(filterButtons, C.Button(position.icon .. " " .. position.short, filter == position.id and "primary" or "secondary", function()
			ctx.navigate("squad", { filter = position.id })
		end))
	end
	add(C.Row(filterButtons, 6))

	local sorted = table.clone(squad)
	table.sort(sorted, function(a, b)
		if a.pos ~= b.pos then
			local order = { GK = 1, DEF = 2, MID = 3, FWD = 4 }
			return order[a.pos] < order[b.pos]
		end
		return a.ovr > b.ovr
	end)
	for _, p in ipairs(sorted) do
		if filter == "ALL" or p.pos == filter then
			local expanded = ctx.params.selected == p.id
			add(Squad.PlayerCard(ctx, p, {
				expanded = expanded,
				onToggle = function()
					ctx.navigate("squad", { filter = filter, selected = (not expanded) and p.id or nil })
				end,
				actions = function(card)
					if p.contract <= FootballConfig.RENEW_WINDOW then
						C.Label(string.format("📝 Renovación: pide %s/jornada (ahora cobra %s).", Format.Money(p.salaryDemand), Format.Money(p.salary)),
							{ TextSize = 13 }).Parent = card
						local renewButtons = {}
						for years = 1, FootballConfig.CONTRACT_MAX_SEASONS do
							table.insert(renewButtons, C.Button(years .. " temp.", "secondary", function()
								ctx.act("RenewContract", { id = p.id, years = years })
							end, { Size = UDim2.new(0, 0, 0, 30), TextSize = 13 }))
						end
						C.Row(renewButtons, 6).Parent = card
					else
						C.Label(string.format("📝 Contrato: %d temporadas. Podrás renovar cuando queden %d o menos.", p.contract, FootballConfig.RENEW_WINDOW),
							{ TextSize = 13, TextColor3 = Theme.TextDim }).Parent = card
					end
					local release = C.Button("Rescindir · " .. Format.Money(p.releaseCost), "danger", function()
						ctx.act("ReleasePlayer", { id = p.id })
					end)
					C.SetEnabled(release, not p.loan and #squad > FootballConfig.MIN_SQUAD and state.economy.money >= p.releaseCost)
					release.Parent = card
				end,
			}))
		end
	end
	add(C.Label("Toca un jugador para ver sus atributos, su foco de entrenamiento y su contrato. Compra, vende y cede en «Fichajes».",
		{ TextColor3 = Theme.TextMuted, TextSize = 13 }))
end

return Squad
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000045"><Properties><string name="Name">Stadium</string><ProtectedString name="Source"><![CDATA[-- Stadium (ModuleScript) · Pantalla "Mi estadio"
-- Ubicación: StarterPlayer/StarterPlayerScripts/Client/Screens/Stadium
-- Resumen del estadio: etapa evolutiva, aforo, atractivo e instalaciones.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local FacilityConfig = require(Shared.Config.FacilityConfig)
local StadiumStages = require(Shared.Config.StadiumStages)
local EconomyFormulas = require(Shared.Modules.EconomyFormulas)

local Stadium = {}

function Stadium.Render(container, ctx)
	local C, Theme, Format, state = ctx.C, ctx.Theme, ctx.Format, ctx.state
	local scroll = C.Scroll()
	scroll.Parent = container
	local add = C.Stack(scroll)

	add(C.Row({
		C.Title("🏟️ Mi estadio", 26),
		C.Button("📍 Ir a mi estadio", "primary", function()
			ctx.act("TeleportHome")
			ctx.close()
		end),
	}, 16))

	-- Etapa evolutiva actual
	local current = StadiumStages.Get(state.stadium.stage)
	local stageCard = C.Card({ BackgroundColor3 = Theme.Panel }, {
		C.Label("ESTADIO EVOLUTIVO · ETAPA " .. state.stadium.stage .. " DE " .. #StadiumStages, { TextColor3 = Theme.Accent, Font = Theme.FontBold, TextSize = 13 }),
		C.Title(current.name, 24),
		C.Label(current.description, { TextColor3 = Theme.TextDim }),
		C.Label(string.format("Efectos de la etapa: atractivo +%s · patrocinio +%s · reputación +%d · %d decoraciones · operación %s/jornada",
			Format.Percent(current.effects.attractiveness), Format.Money(current.effects.sponsorBonus),
			current.effects.reputation, current.effects.freeDecorations, Format.Money(current.effects.upkeep)),
			{ TextSize = 13 }),
	})
	local track = C.Row({}, 6)
	for i, stage in ipairs(StadiumStages) do
		local reached = i <= state.stadium.stage
		local badge = C.Badge(string.format("%d · %s", i, stage.name), reached and Theme.AccentDark or Theme.Locked,
			reached and Theme.Text or Theme.TextMuted)
		badge.LayoutOrder = i
		badge.Parent = track
	end
	track.Parent = stageCard
	add(stageCard)

	-- Siguiente etapa: requisitos reales calculados con las mismas fórmulas que el servidor
	local pseudo = {
		stadium = state.stadium,
		economy = { money = state.economy.money, debt = state.economy.debt },
		club = { reputationEarned = 0 },
	}
	local ok, reason, nextStage, checks = EconomyFormulas.CanUpgradeStage(pseudo)
	if nextStage then
		local nextCard = C.Card({}, {
			C.Title("⬆️ Siguiente etapa: " .. nextStage.name, 20),
			C.Label(nextStage.description, { TextColor3 = Theme.TextDim, TextSize = 14 }),
			C.Label(string.format("Al ascender: atractivo +%s · patrocinio +%s/jornada · reputación +%d · %d decoraciones · operación %s/jornada",
				Format.Percent(nextStage.effects.attractiveness), Format.Money(nextStage.effects.sponsorBonus),
				nextStage.effects.reputation, nextStage.effects.freeDecorations, Format.Money(nextStage.effects.upkeep)),
				{ TextSize = 13, TextColor3 = Theme.Accent }),
		})
		local unlocks = {}
		for _, id in ipairs(FacilityConfig.Order) do
			local def = FacilityConfig.Get(id)
			for level, data in ipairs(def.levels) do
				if data.minStage == nextStage.stage then
					table.insert(unlocks, string.format("%s %s Nv %d", def.icon, def.name, level))
				end
			end
		end
		if #unlocks > 0 then
			C.Label("<b>Desbloquea:</b> " .. table.concat(unlocks, " · "), { TextSize = 13 }).Parent = nextCard
		end
		for _, check in ipairs(checks) do
			C.Label((check.met and "✅ " or "❌ ") .. check.text, {
				TextSize = 14, TextColor3 = check.met and Theme.Text or Theme.Warning,
			}).Parent = nextCard
		end
		local button = C.Button(string.format("Ascender a %s · %s", nextStage.name, Format.Money(nextStage.upgradeCost)), "gold", function()
			ctx.act("UpgradeStage")
		end)
		C.SetEnabled(button, ok)
		button.Parent = nextCard
		if not ok and reason then
			C.Label("🔒 " .. reason, { TextColor3 = Theme.Warning, TextSize = 13 }).Parent = nextCard
		end
		add(nextCard)
	else
		add(C.Card({ BackgroundColor3 = Color3.fromRGB(60, 45, 10) }, {
			C.Title("🏆 ¡Estadio legendario!", 20),
			C.Label("Has alcanzado la etapa máxima del estadio evolutivo.", { TextColor3 = Theme.TextDim }),
		}))
	end

	-- Métricas
	local eco = state.economy
	local f = eco.forecast
	local grid = C.Grid(200, 78, 10)
	add(grid)
	local stats = {
		{ "🪑", "Aforo", Format.Thousands(f.capacity) },
		{ "🎟️", "Asistencia prevista", Format.Thousands(f.attendance) },
		{ "✨", "Atractivo", Format.Percent(f.attractiveness) },
		{ "👥", "Aficionados / techo", Format.Short(state.club.fans) .. " / " .. Format.Short(f.fanCap) },
		{ "⭐", "Reputación", tostring(eco.reputation) },
		{ "🧱", "Construcciones", tostring(state.stats.buildings) },
	}
	for i, s in ipairs(stats) do
		local stat = C.Stat(s[1], s[2], s[3])
		stat.LayoutOrder = i
		stat.Parent = grid
	end
	local occupancy = f.capacity > 0 and f.attendance / f.capacity or 0
	add(C.Card({}, {
		C.Label("Ocupación prevista: " .. Format.Percent(occupancy), { Font = Theme.FontBold }),
		C.ProgressBar(occupancy, occupancy >= 1 and Theme.Gold or Theme.Accent, 12),
		C.Label(occupancy >= 1 and "Lleno: más gradas = más ingresos." or "Más atractivo y aficionados llenarán el estadio.",
			{ TextColor3 = Theme.TextDim, TextSize = 13 }),
	}))

	-- Instalaciones
	local list = C.Card({}, { C.Title("🏗️ Instalaciones", 18) })
	for _, id in ipairs(FacilityConfig.Order) do
		local def = FacilityConfig.Get(id)
		local level = state.stadium.facilities[id] or 0
		local max = #def.levels
		local row = C.New("Frame", {
			BackgroundTransparency = 1,
			Size = UDim2.new(1, 0, 0, 34),
		})
		C.Label(def.icon .. "  " .. def.name, { Size = UDim2.new(0.45, 0, 1, 0), AutomaticSize = Enum.AutomaticSize.None,
			TextColor3 = level > 0 and Theme.Text or Theme.TextMuted }).Parent = row
		local bar = C.ProgressBar(level / max, level > 0 and Theme.Accent or Theme.Locked, 10)
		bar.Position = UDim2.new(0.45, 0, 0.5, -5)
		bar.Size = UDim2.new(0.35, 0, 0, 10)
		bar.Parent = row
		C.Label(level > 0 and string.format("Nv %d/%d", level, max) or "Sin construir", {
			Position = UDim2.new(0.82, 0, 0, 0), Size = UDim2.new(0.18, 0, 1, 0),
			AutomaticSize = Enum.AutomaticSize.None, TextXAlignment = Enum.TextXAlignment.Right,
			TextColor3 = Theme.TextDim, TextSize = 13,
		}).Parent = row
		row.Parent = list
	end
	C.Button("Ir a Construcción", "secondary", function()
		ctx.navigate("build")
	end).Parent = list
	add(list)
end

return Stadium
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000046"><Properties><string name="Name">Transfers</string><ProtectedString name="Source"><![CDATA[-- Transfers (ModuleScript) · Pantalla "Fichajes" (FASE 6)
-- Ubicación: StarterPlayer/StarterPlayerScripts/Client/Screens/Transfers
-- Pestañas: Mercado · Ofertas recibidas · Vender y ceder.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local FootballConfig = require(Shared.Config.FootballConfig)
local TransferConfig = require(Shared.Config.TransferConfig)

local Squad = require(script.Parent.Squad)

local Transfers = {}

local function renderMarket(add, ctx)
	local C, Theme, Format, state = ctx.C, ctx.Theme, ctx.Format, ctx.state
	local tr = state.transfers
	local years = ctx.params.years or TransferConfig.DEFAULT_CONTRACT

	local budget = C.Card({ BackgroundColor3 = Theme.Panel }, {
		C.Label(string.format("💼 Presupuesto de fichajes: <b>%s</b> (%d%% de tu dinero) · Plantilla %d/%d · El mercado se renueva en %d jornada(s).",
			Format.Money(tr.budget), math.floor(tr.budgetShare * 100), tr.activeCount, FootballConfig.MAX_SQUAD, tr.nextRefresh), { TextSize = 14 }),
	})
	local shareButtons = {}
	for _, share in ipairs(TransferConfig.BudgetShares) do
		table.insert(shareButtons, C.Button(math.floor(share * 100) .. " %", tr.budgetShare == share and "primary" or "secondary", function()
			if tr.budgetShare ~= share then
				ctx.act("SetTransferBudget", { share = share })
			end
		end, { Size = UDim2.new(0, 0, 0, 30), TextSize = 13 }))
	end
	C.Row(shareButtons, 6).Parent = budget
	local yearButtons = { C.Label("Contrato para los fichajes:", { Size = UDim2.new(0, 0, 0, 30), AutomaticSize = Enum.AutomaticSize.X, TextWrapped = false, TextSize = 13 }) }
	for y = 1, FootballConfig.CONTRACT_MAX_SEASONS do
		table.insert(yearButtons, C.Button(y .. " temp.", years == y and "primary" or "secondary", function()
			ctx.navigate("transfers", { tab = "market", years = y, selected = ctx.params.selected })
		end, { Size = UDim2.new(0, 0, 0, 30), TextSize = 13 }))
	end
	C.Row(yearButtons, 6).Parent = budget
	add(budget)

	local full = tr.activeCount >= FootballConfig.MAX_SQUAD
	for _, l in ipairs(tr.listings) do
		local p = l.player
		local expanded = ctx.params.selected == l.id
		local kindText = l.kind == "free" and "🆓 Libre" or (l.kind == "loan" and ("🔁 Cesión · " .. l.club) or ("🏟️ " .. l.club))
		add(C.Label(string.format("<font color='#A0AFC8'>%s · pide salario %s/jornada</font>", kindText, Format.Money(l.salary)), { TextSize = 12 }))
		add(Squad.PlayerCard(ctx, p, {
			expanded = expanded,
			onToggle = function()
				ctx.navigate("transfers", { tab = "market", years = years, selected = (not expanded) and l.id or nil })
			end,
			actions = function(card)
				if l.kind == "buy" then
					if l.rejected then
						C.Label("❌ Su club rechazó tu oferta. Podrás volver a intentarlo cuando se renueve el mercado.", { TextSize = 13, TextColor3 = Theme.Warning }).Parent = card
					end
					local buttons = {}
					for _, level in ipairs(TransferConfig.OfferLevels) do
						local fee = math.floor(l.asking * level.share)
						local b = C.Button(string.format("%s · %s (%d%%)", level.name, Format.Money(fee), math.floor(level.chance * 100)), "primary", function()
							ctx.act("BuyPlayer", { listing = l.id, offer = level.id, years = years })
						end, { Size = UDim2.new(0, 0, 0, 32), TextSize = 13 })
						C.SetEnabled(b, not l.rejected and not full and fee <= tr.budget)
						table.insert(buttons, b)
					end
					C.Label("Oferta (probabilidad de que acepten):", { TextSize = 13, TextColor3 = Theme.TextDim }).Parent = card
					C.Row(buttons, 6).Parent = card
				elseif l.kind == "free" then
					local b = C.Button("Fichar libre · prima " .. Format.Money(l.bonus), "primary", function()
						ctx.act("BuyPlayer", { listing = l.id, years = years })
					end)
					C.SetEnabled(b, not full and state.economy.money >= l.bonus)
					b.Parent = card
				else
					local b = C.Button(string.format("Cesión hasta final de temporada · %s/jornada", Format.Money(l.loanFee)), "primary", function()
						ctx.act("BuyPlayer", { listing = l.id })
					end)
					C.SetEnabled(b, not full)
					b.Parent = card
				end
			end,
		}))
	end
	add(C.Label("Toca un jugador para ver sus atributos y hacer una oferta. El potencial se muestra como rango según tus ojeadores.",
		{ TextColor3 = Theme.TextMuted, TextSize = 13 }))
end

local function renderOffers(add, ctx)
	local C, Theme, Format, state = ctx.C, ctx.Theme, ctx.Format, ctx.state
	local offers = state.transfers.offers
	if #offers == 0 then
		add(C.Label("No tienes ofertas. Pon jugadores en venta en «Vender y ceder». A veces llegan ofertas inesperadas por tus mejores jugadores.",
			{ TextColor3 = Theme.TextMuted }))
	end
	for _, o in ipairs(offers) do
		local value = 0
		for _, p in ipairs(state.football.squad) do
			if p.id == o.playerId then
				value = p.value
			end
		end
		add(C.Card({}, {
			C.Label(string.format("%s<b>%s</b> ofrece <b>%s</b> por <b>%s</b> (valor %s) · caduca en %d jornada(s)",
				o.unsolicited and "⚡ " or "", o.club, Format.Money(o.fee), o.playerName, Format.Money(value),
				math.max(0, o.expires - state.stats.cycles)), { TextSize = 14 }),
			C.Row({
				C.Button("Aceptar venta", "primary", function()
					ctx.act("AcceptTransferOffer", { offer = o.id })
				end),
				C.Button("Rechazar", "danger", function()
					ctx.act("RejectTransferOffer", { offer = o.id })
				end),
			}, 8),
		}))
	end
end

local function renderSell(add, ctx)
	local C, Theme, Format, state = ctx.C, ctx.Theme, ctx.Format, ctx.state
	local loans = C.Card({}, { C.Title("🔁 Cesiones activas", 18) })
	local any = false
	for _, p in ipairs(state.football.squad) do
		if p.loan then
			any = true
			C.Label(p.loan.type == "in"
				and string.format("⬅️ %s, cedido por %s · %s/jornada · vuelve a su club al final de la temporada %d", p.name, p.loan.club, Format.Money(p.loan.fee), p.loan.endSeason)
				or string.format("➡️ %s, cedido a %s · ingresas %s/jornada · vuelve al final de la temporada %d", p.name, p.loan.club, Format.Money(p.loan.fee), p.loan.endSeason),
				{ TextSize = 14 }).Parent = loans
		end
	end
	if not any then
		C.Label("No hay cesiones activas.", { TextColor3 = Theme.TextMuted }).Parent = loans
	end
	add(loans)

	add(C.Label("Pon jugadores en venta para recibir ofertas, u ofrece en cesión a jóvenes (≤25 años): su nuevo club paga el salario y te paga una cuota por jornada.",
		{ TextColor3 = Theme.TextDim, TextSize = 13 }))
	for _, p in ipairs(state.football.squad) do
		if not p.loan then
			local pos = FootballConfig.Position(p.pos)
			local status = p.listed == "sale" and "🏷️ En venta" or (p.listed == "loan" and "🔁 Disponible para cesión" or "")
			local buttons = {}
			if p.listed then
				table.insert(buttons, C.Button("Quitar del mercado", "secondary", function()
					ctx.act("SetTransferListing", { id = p.id, mode = "none" })
				end, { Size = UDim2.new(0, 0, 0, 30), TextSize = 13 }))
			else
				table.insert(buttons, C.Button("Poner en venta", "secondary", function()
					ctx.act("SetTransferListing", { id = p.id, mode = "sale" })
				end, { Size = UDim2.new(0, 0, 0, 30), TextSize = 13 }))
				if p.age <= 25 then
					table.insert(buttons, C.Button("Ofrecer cesión", "secondary", function()
						ctx.act("SetTransferListing", { id = p.id, mode = "loan" })
					end, { Size = UDim2.new(0, 0, 0, 30), TextSize = 13 }))
				end
			end
			local row = C.Card({}, {
				C.Label(string.format("<b>%s</b> · %s · %d años · media %d · valor %s %s", p.name, pos.short, p.age, p.ovr, Format.Money(p.value), status),
					{ TextSize = 14 }),
				C.Row(buttons, 6),
			})
			add(row)
		end
	end
end

function Transfers.Render(container, ctx)
	local C = ctx.C
	local tab = ctx.params.tab or "market"
	local scroll = C.Scroll()
	scroll.Parent = container
	local add = C.Stack(scroll)
	add(C.Title("🔁 Fichajes", 26))
	local offers = #ctx.state.transfers.offers
	local tabs = {
		{ id = "market", label = "Mercado" },
		{ id = "offers", label = offers > 0 and string.format("Ofertas (%d)", offers) or "Ofertas" },
		{ id = "sell", label = "Vender y ceder" },
	}
	local buttons = {}
	for _, t in ipairs(tabs) do
		table.insert(buttons, C.Button(t.label, tab == t.id and "primary" or "secondary", function()
			ctx.navigate("transfers", { tab = t.id })
		end))
	end
	add(C.Row(buttons, 8))
	if tab == "offers" then
		renderOffers(add, ctx)
	elseif tab == "sell" then
		renderSell(add, ctx)
	else
		renderMarket(add, ctx)
	end
end

return Transfers
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000047"><Properties><string name="Name">Universe</string><ProtectedString name="Source"><![CDATA[-- Universe (ModuleScript) · Pantalla "Universo" (FASE 8)
-- Ubicación: StarterPlayer/StarterPlayerScripts/Client/Screens/Universe
-- Pestañas: Evento · Rankings · Semanal · Directorio.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UniverseConfig = require(ReplicatedStorage:WaitForChild("Shared").Config.UniverseConfig)

local Universe = {}

local function duration(seconds)
	seconds = math.max(0, math.floor(seconds))
	local d = math.floor(seconds / 86400)
	local h = math.floor((seconds % 86400) / 3600)
	local m = math.floor((seconds % 3600) / 60)
	if d > 0 then
		return string.format("%dd %dh", d, h)
	end
	return string.format("%dh %02dm", h, m)
end

local function offlineNotice(add, ctx)
	local C = ctx.C
	if not ctx.state.universe.online then
		add(C.Card({ BackgroundColor3 = Color3.fromRGB(70, 45, 10) }, {
			C.Label("🌐 <b>Universo sin conexión.</b> No se puede acceder a DataStore (en Studio: publica el juego y activa API Services). Se ven los clubes de este servidor; los rankings globales se reintentan automáticamente.",
				{ TextSize = 13 }),
		}))
	end
end

local function renderEvent(add, ctx)
	local C, Theme = ctx.C, ctx.Theme
	local ev = ctx.state.universe.event
	add(C.Card({ BackgroundColor3 = Theme.Panel }, {
		C.Label("EVENTO ACTIVO EN TODO EL UNIVERSO", { TextColor3 = Theme.Accent, Font = Theme.FontBold, TextSize = 13 }),
		C.Title(ev.icon .. " " .. ev.name, 24),
		C.Label(ev.description, { TextSize = 15 }),
		C.Label("Termina en " .. duration(ev.secondsLeft - (os.clock() - ctx.stateReceivedAt)), { TextColor3 = Theme.TextDim, TextSize = 13 }),
	}))
	local list = C.Card({}, { C.Title("📅 Eventos que rotan", 18), C.Label(string.format("Cada evento dura %d horas y es el mismo en todos los servidores.", UniverseConfig.EVENT_HOURS), { TextSize = 13, TextColor3 = Theme.TextDim }) })
	for _, e in ipairs(UniverseConfig.Events) do
		C.Label(string.format("%s <b>%s</b> · %s", e.icon, e.name, e.description), { TextSize = 13, TextColor3 = e.id == ev.id and Theme.Gold or Theme.Text }).Parent = list
	end
	add(list)
end

local function renderRankings(add, ctx)
	local C, Theme, Format = ctx.C, ctx.Theme, ctx.Format
	local which = ctx.params.ranking or "reputation"
	local buttons = {}
	for _, r in ipairs(UniverseConfig.RANKINGS) do
		table.insert(buttons, C.Button(r.icon .. " " .. r.name, which == r.id and "primary" or "secondary", function()
			ctx.navigate("universe", { tab = "rankings", ranking = r.id })
		end))
	end
	add(C.Row(buttons, 6))
	local entries = ctx.state.universe.rankings[which] or {}
	local card = C.Card({}, { C.Title("🌍 Clasificación global", 18) })
	if #entries == 0 then
		C.Label("Sin datos todavía. Los clubes publican su perfil cada 5 minutos.", { TextColor3 = Theme.TextMuted, TextSize = 13 }).Parent = card
	end
	for _, e in ipairs(entries) do
		local value = which == "value" and Format.Money(e.value) or Format.Thousands(e.value)
		C.Label(string.format("%s%d. %s <b>%s</b> · %s · %s", e.userId == game:GetService("Players").LocalPlayer.UserId and "👉 " or "",
			e.rank, e.crest, e.clubName, e.ownerName, value), { TextSize = 14 }).Parent = card
	end
	add(card)
end

local function renderWeekly(add, ctx)
	local C, Theme, Format = ctx.C, ctx.Theme, ctx.Format
	local weekly = ctx.state.universe.weekly
	local pts = UniverseConfig.WeeklyPoints
	local info = C.Card({ BackgroundColor3 = Theme.Panel }, {
		C.Title("⚔️ Competición semanal del universo", 20),
		C.Label(string.format("Todos los clubes compiten a la vez. Puntos: victoria de liga %d, empate %d, ronda de copa %d, título %d.",
			pts.win, pts.draw, pts.cupRound, pts.title), { TextSize = 13, TextColor3 = Theme.TextDim }),
		C.Label(string.format("Tus puntos esta semana: <b>%d</b> · Termina en %s", weekly.myPoints, duration(weekly.secondsLeft)), { TextSize = 15 }),
	})
	for _, reward in ipairs(UniverseConfig.WeeklyRewards) do
		C.Label(string.format("%s (hasta el puesto %d): %s y +%d de reputación", reward.label, reward.maxRank, Format.Money(reward.money), reward.reputation),
			{ TextSize = 13 }).Parent = info
	end
	C.Label("Las recompensas se entregan automáticamente al entrar durante la semana siguiente.", { TextSize = 12, TextColor3 = Theme.TextMuted }).Parent = info
	add(info)
	local top = C.Card({}, { C.Title("🏅 Top 10 de la semana", 18) })
	if #weekly.top == 0 then
		C.Label("Todavía no hay puntuaciones esta semana.", { TextColor3 = Theme.TextMuted, TextSize = 13 }).Parent = top
	end
	for _, e in ipairs(weekly.top) do
		C.Label(string.format("%d. %s <b>%s</b> · %d pts", e.rank, e.crest, e.clubName, e.value), { TextSize = 14 }).Parent = top
	end
	add(top)
end

local function renderDirectory(add, ctx)
	local C, Theme, Format = ctx.C, ctx.Theme, ctx.Format
	local directory = ctx.state.universe.directory
	add(C.Label("Clubes conectados en este servidor. Puedes visitar sus estadios: como visitante no puedes modificar nada ni ver sus datos privados.",
		{ TextColor3 = Theme.TextDim, TextSize = 13 }))
	for _, club in ipairs(directory) do
		local visit = C.Button(club.isMe and "Tu club" or "🏟️ Visitar estadio", "secondary", function()
			ctx.act("VisitClub", { userId = club.userId })
			ctx.close()
		end, { Size = UDim2.new(0, 160, 0, 34), AutomaticSize = Enum.AutomaticSize.None })
		C.SetEnabled(visit, not club.isMe)
		add(C.Card({}, {
			C.Row({
				C.Label(string.format("%s <b>%s</b>%s · %s", club.crest, club.clubName, club.vip and " 👑" or "", club.ownerName), { Size = UDim2.new(1, -180, 0, 0), TextSize = 15 }),
				visit,
			}),
			C.Label(string.format("⭐ %d · 🏦 %s · 🏆 %d · 👥 %s · 🏟️ %s · División %d", club.reputation, Format.Money(club.value), club.titles,
				Format.Short(club.fans), club.stageName, club.division), { TextSize = 13, TextColor3 = Theme.TextDim }),
		}))
	end
end

function Universe.Render(container, ctx)
	local C = ctx.C
	local tab = ctx.params.tab or "event"
	local scroll = C.Scroll()
	scroll.Parent = container
	local add = C.Stack(scroll)
	add(C.Title("🌎 Universo futbolístico", 26))
	local tabs = {
		{ id = "event", label = "Evento" },
		{ id = "rankings", label = "Rankings" },
		{ id = "weekly", label = "Semanal" },
		{ id = "directory", label = "Directorio" },
	}
	local buttons = {}
	for _, t in ipairs(tabs) do
		table.insert(buttons, C.Button(t.label, tab == t.id and "primary" or "secondary", function()
			ctx.navigate("universe", { tab = t.id })
		end))
	end
	add(C.Row(buttons, 8))
	offlineNotice(add, ctx)
	if tab == "rankings" then
		renderRankings(add, ctx)
	elseif tab == "weekly" then
		renderWeekly(add, ctx)
	elseif tab == "directory" then
		renderDirectory(add, ctx)
	else
		renderEvent(add, ctx)
	end
end

return Universe
]]></ProtectedString></Properties></Item></Item><Item class="Folder" referent="RBX0000004E"><Properties><string name="Name">UI</string></Properties><Item class="ModuleScript" referent="RBX00000049"><Properties><string name="Name">Components</string><ProtectedString name="Source"><![CDATA[-- Components (ModuleScript)
-- Ubicación: StarterPlayer/StarterPlayerScripts/Client/UI/Components
-- Fábrica de elementos de interfaz reutilizables (todo por código, sin assets externos).

local Theme = require(script.Parent.Theme)

local C = {}

-- Crea una instancia con propiedades. props.Children = { instancias hijas }
function C.New(className, props, parent)
	local inst = Instance.new(className)
	local children
	for key, value in pairs(props or {}) do
		if key == "Children" then
			children = value
		else
			inst[key] = value
		end
	end
	if children then
		for _, child in ipairs(children) do
			child.Parent = inst
		end
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

function C.Corner(radius)
	return C.New("UICorner", { CornerRadius = radius or Theme.Radius })
end

function C.Stroke(color, thickness, transparency)
	return C.New("UIStroke", {
		Color = color or Theme.Stroke,
		Thickness = thickness or 1,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
end

function C.Padding(all, horizontal)
	local v = UDim.new(0, all or 8)
	local h = UDim.new(0, horizontal or all or 8)
	return C.New("UIPadding", { PaddingTop = v, PaddingBottom = v, PaddingLeft = h, PaddingRight = h })
end

function C.List(direction, padding, align)
	return C.New("UIListLayout", {
		FillDirection = direction or Enum.FillDirection.Vertical,
		Padding = UDim.new(0, padding or 8),
		SortOrder = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = align or Enum.HorizontalAlignment.Left,
	})
end

function C.Label(text, props)
	local base = {
		BackgroundTransparency = 1,
		Font = Theme.Font,
		Text = text or "",
		TextColor3 = Theme.Text,
		TextSize = 16,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		RichText = true,
	}
	for k, v in pairs(props or {}) do
		base[k] = v
	end
	return C.New("TextLabel", base)
end

function C.Title(text, size)
	return C.Label(text, { Font = Theme.FontBlack, TextSize = size or 24 })
end

-- Asigna LayoutOrder según el orden de inserción a los hijos que no lo tengan,
-- para que los UIListLayout respeten el orden en que se añaden los elementos.
function C.AutoOrder(frame)
	local counter = 0
	for _, child in ipairs(frame:GetChildren()) do
		if child:IsA("GuiObject") then
			counter = math.max(counter, child.LayoutOrder)
		end
	end
	frame.ChildAdded:Connect(function(child)
		if child:IsA("GuiObject") then
			if child.LayoutOrder == 0 then
				counter += 1
				child.LayoutOrder = counter
			else
				counter = math.max(counter, child.LayoutOrder)
			end
		end
	end)
	return frame
end

-- Tarjeta con disposición vertical automática.
function C.Card(props, children)
	local base = {
		BackgroundColor3 = Theme.Card,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BorderSizePixel = 0,
		Children = { C.Corner(), C.Stroke(), C.Padding(12), C.List(nil, 8) },
	}
	for k, v in pairs(props or {}) do
		base[k] = v
	end
	local card = C.AutoOrder(C.New("Frame", base))
	for _, child in ipairs(children or {}) do
		child.Parent = card
	end
	return card
end

-- Devuelve una función que añade hijos a `parent` respetando el orden de llamada.
function C.Stack(parent)
	local order = 0
	return function(child)
		order += 1
		child.LayoutOrder = order
		child.Parent = parent
		return child
	end
end

-- style: "primary" | "secondary" | "danger" | "gold" | "ghost"
function C.Button(text, style, onClick, props)
	local colors = {
		primary = Theme.Accent,
		secondary = Theme.CardAlt,
		danger = Theme.Danger,
		gold = Theme.Gold,
		ghost = Theme.Panel,
		info = Theme.Info,
	}
	local base = {
		Text = text,
		Font = Theme.FontBold,
		TextSize = 16,
		TextColor3 = (style == "gold") and Color3.fromRGB(35, 25, 0) or Theme.Text,
		BackgroundColor3 = colors[style or "primary"] or Theme.Accent,
		AutoButtonColor = true,
		Size = UDim2.new(0, 0, 0, 40),
		AutomaticSize = Enum.AutomaticSize.X,
		BorderSizePixel = 0,
		Children = { C.Corner(Theme.RadiusSmall), C.Padding(6, 14) },
	}
	for k, v in pairs(props or {}) do
		base[k] = v
	end
	local button = C.New("TextButton", base)
	if onClick then
		button.Activated:Connect(function()
			if button.Active then
				onClick(button)
			end
		end)
	end
	return button
end

-- Desactiva un botón mostrando un texto alternativo.
function C.SetEnabled(button, enabled, disabledText)
	enabled = enabled == true
	button.Active = enabled
	button.AutoButtonColor = enabled
	button.BackgroundTransparency = enabled and 0 or 0.55
	button.TextTransparency = enabled and 0 or 0.35
	if not enabled and disabledText then
		button.Text = disabledText
	end
end

function C.Badge(text, color, textColor)
	return C.New("TextLabel", {
		Text = text,
		Font = Theme.FontBold,
		TextSize = 13,
		TextColor3 = textColor or Theme.Text,
		BackgroundColor3 = color or Theme.CardAlt,
		Size = UDim2.new(0, 0, 0, 24),
		AutomaticSize = Enum.AutomaticSize.X,
		Children = { C.Corner(UDim.new(0, 12)), C.Padding(2, 10) },
	})
end

function C.Row(children, padding, props)
	local base = {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Children = {
			C.New("UIListLayout", {
				FillDirection = Enum.FillDirection.Horizontal,
				Padding = UDim.new(0, padding or 8),
				SortOrder = Enum.SortOrder.LayoutOrder,
				VerticalAlignment = Enum.VerticalAlignment.Center,
				Wraps = true,
			}),
		},
	}
	for k, v in pairs(props or {}) do
		base[k] = v
	end
	local row = C.New("Frame", base)
	for i, child in ipairs(children or {}) do
		child.LayoutOrder = i
		child.Parent = row
	end
	return row
end

-- Rejilla adaptable: celdas de ancho mínimo `cellWidth`.
function C.Grid(cellWidth, cellHeight, padding)
	local frame = C.New("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
	})
	local grid = C.New("UIGridLayout", {
		CellSize = UDim2.fromOffset(cellWidth, cellHeight),
		CellPadding = UDim2.fromOffset(padding or 8, padding or 8),
		SortOrder = Enum.SortOrder.LayoutOrder,
	}, frame)
	return frame, grid
end

function C.ProgressBar(fraction, color, height)
	fraction = math.clamp(fraction or 0, 0, 1)
	return C.New("Frame", {
		BackgroundColor3 = Theme.Panel,
		Size = UDim2.new(1, 0, 0, height or 8),
		BorderSizePixel = 0,
		Children = {
			C.Corner(UDim.new(1, 0)),
			C.New("Frame", {
				BackgroundColor3 = color or Theme.Accent,
				Size = UDim2.fromScale(fraction, 1),
				BorderSizePixel = 0,
				Children = { C.Corner(UDim.new(1, 0)) },
			}),
		},
	})
end

-- Tarjeta de estadística (KPI).
function C.Stat(icon, label, value, accent)
	return C.New("Frame", {
		BackgroundColor3 = Theme.Card,
		BorderSizePixel = 0,
		Children = {
			C.Corner(),
			C.Stroke(accent or Theme.Stroke, 1, 0.3),
			C.Padding(10),
			C.List(nil, 2),
			C.Label(icon .. "  " .. label, { TextColor3 = Theme.TextDim, TextSize = 13, LayoutOrder = 1 }),
			C.Label(value, { Font = Theme.FontBlack, TextSize = 22, LayoutOrder = 2, Name = "Value" }),
		},
	})
end

-- ScrollingFrame que ajusta su lienzo al contenido.
function C.Scroll(props)
	local base = {
		Name = "Scroll",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 6,
		ScrollBarImageColor3 = Theme.Stroke,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		Children = { C.List(nil, 12), C.Padding(4, 4) },
	}
	for k, v in pairs(props or {}) do
		base[k] = v
	end
	return C.AutoOrder(C.New("ScrollingFrame", base))
end

-- Selector de opción (para escudos, paletas, diseños...).
-- opts: { selected, locked, lockText, onClick, height }
function C.OptionTile(title, subtitle, opts, extra)
	local stroke = C.Stroke(opts.selected and Theme.Accent or Theme.Stroke, opts.selected and 3 or 1)
	local tile = C.New("TextButton", {
		Text = "",
		AutoButtonColor = true,
		BackgroundColor3 = opts.locked and Theme.Panel or Theme.CardAlt,
		BorderSizePixel = 0,
		Children = { C.Corner(), stroke },
	})
	if extra then
		extra.Parent = tile
	end
	C.Label(title, {
		Font = Theme.FontBold,
		TextSize = 14,
		TextXAlignment = Enum.TextXAlignment.Center,
		Position = UDim2.new(0, 4, 1, -40),
		Size = UDim2.new(1, -8, 0, 18),
		AutomaticSize = Enum.AutomaticSize.None,
		TextTruncate = Enum.TextTruncate.AtEnd,
		TextWrapped = false,
	}, nil).Parent = tile
	C.Label(opts.locked and ("🔒 " .. (opts.lockText or "")) or (subtitle or ""), {
		TextSize = 11,
		TextColor3 = opts.locked and Theme.Gold or Theme.TextDim,
		TextXAlignment = Enum.TextXAlignment.Center,
		Position = UDim2.new(0, 4, 1, -20),
		Size = UDim2.new(1, -8, 0, 16),
		AutomaticSize = Enum.AutomaticSize.None,
		TextTruncate = Enum.TextTruncate.AtEnd,
		TextWrapped = false,
	}).Parent = tile
	if opts.selected then
		C.Badge("✔", Theme.Accent).Parent = tile
	end
	if opts.onClick then
		tile.Activated:Connect(opts.onClick)
	end
	return tile
end

return C
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000004A"><Properties><string name="Name">MatchViewer</string><ProtectedString name="Source"><![CDATA[-- MatchViewer (ModuleScript)
-- Ubicación: StarterPlayer/StarterPlayerScripts/Client/UI/MatchViewer
--
-- Reproduce el RESUMEN de un partido simulado que ya ha calculado el servidor.
-- Se identifica siempre como "SIMULACIÓN": no es un partido controlable.

local Players = game:GetService("Players")

local Theme = require(script.Parent.Theme)
local C = require(script.Parent.Components)
local Format = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared").Modules.Format)

local MatchViewer = {}

local PLAYBACK_SECONDS = 15
local current

function MatchViewer.Close()
	if current then
		current.closed = true
		current.gui:Destroy()
		current = nil
	end
end

function MatchViewer.Show(result)
	MatchViewer.Close()
	local session = { closed = false }
	current = session
	local gui = C.New("ScreenGui", {
		Name = "FEU_MatchViewer",
		ResetOnSpawn = false,
		DisplayOrder = 10,
	}, Players.LocalPlayer:WaitForChild("PlayerGui"))
	session.gui = gui
	C.New("Frame", { BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.45, Size = UDim2.fromScale(1, 1) }, gui)
	local panel = C.New("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(0.92, 0, 0.86, 0),
		BackgroundColor3 = Theme.Background,
		Children = {
			C.Corner(UDim.new(0, 16)), C.Stroke(Theme.Accent, 2), C.Padding(16),
			C.New("UISizeConstraint", { MaxSize = Vector2.new(640, 720) }),
		},
	}, gui)

	C.Badge("⚽ PARTIDO SIMULADO · " .. tostring(result.competition or "Amistoso"), Theme.Info).Parent = panel
	local scoreLabel = C.Label("", {
		Font = Theme.FontBlack, TextSize = 30, TextXAlignment = Enum.TextXAlignment.Center,
		Position = UDim2.fromOffset(0, 34), Size = UDim2.new(1, 0, 0, 40), AutomaticSize = Enum.AutomaticSize.None,
	})
	scoreLabel.Parent = panel
	local namesLabel = C.Label(string.format("%s  vs  %s", result.home.name, result.away.name), {
		TextSize = 14, TextColor3 = Theme.TextDim, TextXAlignment = Enum.TextXAlignment.Center,
		Position = UDim2.fromOffset(0, 74), Size = UDim2.new(1, 0, 0, 20), AutomaticSize = Enum.AutomaticSize.None,
	})
	namesLabel.Parent = panel
	local minuteLabel = C.Label("0'", {
		Font = Theme.FontBold, TextSize = 16, TextColor3 = Theme.Gold, TextXAlignment = Enum.TextXAlignment.Center,
		Position = UDim2.fromOffset(0, 96), Size = UDim2.new(1, 0, 0, 20), AutomaticSize = Enum.AutomaticSize.None,
	})
	minuteLabel.Parent = panel

	local log = C.Scroll({
		Position = UDim2.fromOffset(0, 124),
		Size = UDim2.new(1, 0, 1, -190),
	})
	log.Parent = panel
	local addLog = C.Stack(log)

	local footer = C.Row({}, 10, {
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 0, 1, 0),
		Size = UDim2.new(1, 0, 0, 50),
		AutomaticSize = Enum.AutomaticSize.None,
	})
	footer.Parent = panel
	local finished = false
	local skipButton
	local function finish()
		if finished or session.closed then
			return
		end
		finished = true
		minuteLabel.Text = "Final del partido"
		scoreLabel.Text = string.format("%s  %d - %d  %s", result.home.short, result.home.goals, result.away.goals, result.away.short)
		local us = result.userSide == 1 and result.home or result.away
		local them = result.userSide == 1 and result.away or result.home
		local outcomeText = result.outcome == "W" and "🏆 ¡Victoria!" or (result.outcome == "D" and "🤝 Empate" or "😞 Derrota")
		addLog(C.Card({ BackgroundColor3 = Theme.Panel }, {
			C.Title(outcomeText, 20),
			C.Label(string.format("Posesión %d%% - %d%% · Tiros %d - %d · A puerta %d - %d",
				result.home.possession, result.away.possession, result.home.shots, result.away.shots,
				result.home.onTarget, result.away.onTarget), { TextSize = 14 }),
			C.Label(result.mvp and string.format("⭐ Mejor jugador: %s (%.1f)", result.mvp.name, result.mvp.rating) or "", { TextSize = 14 }),
			C.Label(string.format("Premio: %s · Reputación %+d · Satisfacción %+d · Tu equipo: %d tiros, rival: %d",
				Format.Money(result.prize or 0), result.reputation or 0, result.satisfaction or 0, us.shots, them.shots), { TextSize = 13, TextColor3 = Theme.TextDim }),
		}))
		if skipButton then
			skipButton:Destroy()
		end
	end

	local shown = 0
	local function showUntil(minute)
		local home, away = 0, 0
		for i, event in ipairs(result.events) do
			if event.minute <= minute then
				if event.type == "goal" then
					if event.side == 1 then
						home += 1
					else
						away += 1
					end
				end
				if i > shown then
					shown = i
					local team = event.side == 1 and result.home.short or result.away.short
					local text
					if event.type == "goal" then
						text = string.format("<b>%d'  ⚽ ¡GOL de %s! (%s)</b>%s", event.minute, event.player, team,
							event.assist and ("  · asistencia de " .. event.assist) or "")
					elseif event.type == "save" then
						text = string.format("%d'  🧤 Parada al disparo de %s (%s)", event.minute, event.player, team)
					else
						text = string.format("%d'  ❌ %s (%s) dispara fuera", event.minute, event.player, team)
					end
					addLog(C.Label(text, { TextSize = 14, TextColor3 = event.type == "goal" and Theme.Gold or Theme.Text }))
					task.defer(function()
						if log.Parent then
							log.CanvasPosition = Vector2.new(0, math.huge)
						end
					end)
				end
			end
		end
		scoreLabel.Text = string.format("%s  %d - %d  %s", result.home.short, home, away, result.away.short)
		minuteLabel.Text = string.format("%d'", math.floor(minute))
	end

	skipButton = C.Button("⏭ Ver resultado final", "secondary", function()
		showUntil(90)
		finish()
	end)
	skipButton.Parent = footer
	C.Button("Cerrar", "primary", MatchViewer.Close).Parent = footer

	task.spawn(function()
		local start = os.clock()
		while not session.closed and not finished do
			local minute = math.min(90, (os.clock() - start) / PLAYBACK_SECONDS * 90)
			showUntil(minute)
			if minute >= 90 then
				finish()
				break
			end
			task.wait(0.2)
		end
	end)
end

return MatchViewer
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000004B"><Properties><string name="Name">Notifier</string><ProtectedString name="Source"><![CDATA[-- Notifier (ModuleScript)
-- Ubicación: StarterPlayer/StarterPlayerScripts/Client/UI/Notifier
-- Notificaciones emergentes (toasts) apiladas en la esquina superior.

local TweenService = game:GetService("TweenService")

local Theme = require(script.Parent.Theme)
local C = require(script.Parent.Components)

local Notifier = {}

local holder

function Notifier.Init(screenGui)
	holder = C.New("Frame", {
		Name = "Toasts",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 70),
		Size = UDim2.new(0, 420, 1, -80),
		ZIndex = 50,
		Children = {
			C.New("UIListLayout", {
				Padding = UDim.new(0, 6),
				SortOrder = Enum.SortOrder.LayoutOrder,
				HorizontalAlignment = Enum.HorizontalAlignment.Center,
			}),
			C.New("UISizeConstraint", { MaxSize = Vector2.new(420, math.huge) }),
		},
	}, screenGui)
end

local counter = 0
function Notifier.Show(kind, message, duration)
	if not holder or not message or message == "" then
		return
	end
	counter += 1
	local color = Theme.NotifyColors[kind] or Theme.Info
	local icons = { success = "✅", error = "⛔", warning = "⚠️", info = "ℹ️" }
	local toast = C.New("Frame", {
		LayoutOrder = counter,
		BackgroundColor3 = Theme.Panel,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		ZIndex = 50,
		Children = {
			C.Corner(),
			C.Stroke(color, 2),
			C.Padding(10, 12),
			C.Label((icons[kind] or "ℹ️") .. "  " .. message, { TextSize = 15, ZIndex = 51 }),
		},
	}, holder)
	task.delay(duration or 4.5, function()
		if toast.Parent then
			local tween = TweenService:Create(toast, TweenInfo.new(0.3), { BackgroundTransparency = 1 })
			tween:Play()
			tween.Completed:Wait()
			toast:Destroy()
		end
	end)
	-- Máximo 4 a la vez
	local toasts = {}
	for _, child in ipairs(holder:GetChildren()) do
		if child:IsA("Frame") then
			table.insert(toasts, child)
		end
	end
	table.sort(toasts, function(a, b)
		return a.LayoutOrder < b.LayoutOrder
	end)
	while #toasts > 4 do
		table.remove(toasts, 1):Destroy()
	end
end

return Notifier
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000004C"><Properties><string name="Name">Premium</string><ProtectedString name="Source"><![CDATA[-- Premium (ModuleScript)
-- Ubicación: StarterPlayer/StarterPlayerScripts/Client/UI/Premium
-- Ayudas de INTERFAZ para mostrar opciones bloqueadas por Game Pass.
-- Solo deciden qué se muestra: el servidor vuelve a validar cada acción.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local GamePassConfig = require(ReplicatedStorage:WaitForChild("Shared").Config.GamePassConfig)

local Premium = {}

function Premium.IsLocked(state, item)
	if item.requiredUnlock and not (state.unlocks and state.unlocks[item.requiredUnlock]) then
		return true
	end
	return item.requiredPass ~= nil and not state.premium.owned[item.requiredPass]
end

function Premium.PassName(passKey)
	local def = GamePassConfig.Get(passKey)
	return def and (def.icon .. " " .. def.name) or passKey
end

function Premium.LockText(item)
	if item.requiredUnlock then
		return "🎃 Evento"
	end
	return item.requiredPass and Premium.PassName(item.requiredPass) or ""
end

-- Al pulsar una opción bloqueada: se explica y se lleva a la Tienda Premium.
function Premium.OnLockedClick(ctx, item)
	if item.requiredUnlock then
		ctx.notify("info", string.format("«%s» se consigue gratis canjeando caramelos en el evento «Doces ou Travessuras» (Inicio).", item.name))
		ctx.navigate("home")
		return
	end
	ctx.notify("info", string.format("«%s» forma parte del pase %s.", item.name, Premium.PassName(item.requiredPass)))
	ctx.navigate("shop", { focus = item.requiredPass })
end

return Premium
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000004D"><Properties><string name="Name">Theme</string><ProtectedString name="Source"><![CDATA[-- Theme (ModuleScript)
-- Ubicación: StarterPlayer/StarterPlayerScripts/Client/UI/Theme
-- Paleta y tipografía de la interfaz: estilo futbolístico moderno (noche de estadio).

local Theme = {
	Background = Color3.fromRGB(10, 16, 28),
	Panel = Color3.fromRGB(16, 25, 42),
	Card = Color3.fromRGB(24, 36, 58),
	CardAlt = Color3.fromRGB(31, 46, 72),
	Stroke = Color3.fromRGB(52, 72, 105),
	Text = Color3.fromRGB(240, 244, 250),
	TextDim = Color3.fromRGB(160, 175, 200),
	TextMuted = Color3.fromRGB(110, 125, 150),
	Accent = Color3.fromRGB(0, 200, 120), -- verde césped
	AccentDark = Color3.fromRGB(0, 140, 85),
	Gold = Color3.fromRGB(255, 196, 0),
	Danger = Color3.fromRGB(235, 70, 70),
	Warning = Color3.fromRGB(255, 160, 40),
	Info = Color3.fromRGB(60, 150, 255),
	Locked = Color3.fromRGB(70, 80, 100),

	Font = Enum.Font.Gotham,
	FontBold = Enum.Font.GothamBold,
	FontBlack = Enum.Font.GothamBlack,

	Radius = UDim.new(0, 10),
	RadiusSmall = UDim.new(0, 6),
}

Theme.NotifyColors = {
	success = Theme.Accent,
	error = Theme.Danger,
	warning = Theme.Warning,
	info = Theme.Info,
}

return Theme
]]></ProtectedString></Properties></Item></Item></Item></Item></Item></roblox>