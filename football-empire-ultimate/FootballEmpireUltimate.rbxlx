function MissionConfig.Daily(id)
	for _, m in ipairs(MissionConfig.DailyPool) do
		if m.id == id then
			return m
		end
	end
	return nil
end

function MissionConfig.Chain(id)
	for _, c in ipairs(MissionConfig.Chains) do
		if c.id == id then
			return c
		end
	end
	return nil
end

function MissionConfig.Achievement(id)
	for _, a in ipairs(MissionConfig.Achievements) do
		if a.id == id then
			return a
		end
	end
	return nil
end

return MissionConfig
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000E"><Properties><string name="Name">MovementConfig</string><ProtectedString name="Source"><![CDATA[-- MovementConfig (ModuleScript)
