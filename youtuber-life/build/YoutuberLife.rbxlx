return {
	photoMode = function() end,
	record = function() end,
	openStyle = function() end,
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000052"><Properties><string name="Name">AppRegistry</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- AppRegistry: todas las aplicaciones del juego. Cada módulo de la carpeta Apps devuelve una app
-- o una lista de apps con: Id, Name, Icon, Surfaces {pc, phone, panel}, Width, Height, Order, build(container, ctx).

local Registry = {}
local apps = {}
local order = {}

local function add(app)
	assert(app.Id and app.build, "App sin Id o build")
	apps[app.Id] = app
	order[#order + 1] = app
end

for _, mod in ipairs(script.Parent:WaitForChild("Apps"):GetChildren()) do
	if mod:IsA("ModuleScript") then
		local ok, result = pcall(require, mod)
		if ok then
			if result.Id then
				add(result)
			else
				for _, app in ipairs(result) do
					add(app)
				end
			end
		else
			warn("[YTLife] No se pudo cargar la app " .. mod.Name .. ": " .. tostring(result))
		end
	end
end
table.sort(order, function(a, b)
	return (a.Order or 50) < (b.Order or 50)
end)

function Registry.get(id)
	return apps[id]
end

function Registry.allowed(app, surface)
	return app.Surfaces and app.Surfaces[surface] == true
end

function Registry.list(surface)
	local out = {}
	for _, app in ipairs(order) do
		if Registry.allowed(app, surface) and not app.Hidden then
			out[#out + 1] = app
		end
	end
	return out
end

return Registry
]]></ProtectedString></Properties></Item><Item class="Folder" referent="RBX000053"><Properties><string name="Name">Apps</string></Properties><Item class="ModuleScript" referent="RBX000054"><Properties><string name="Name">BusinessApps</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Apps de negocio y comunidad: Patrocinios, Eventos y Directos.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Client = script.Parent.Parent
local UI = require(Client.UIKit)
local Net = require(Client.Net)
local State = require(Client.State)
local Notify = require(Client.Notify)
local SponsorData = require(Shared.SponsorData)
local EventData = require(Shared.EventData)
local VideoData = require(Shared.VideoData)
local WorldData = require(Shared.WorldData)
local Catalog = require(Shared.ItemCatalog)
local Util = require(Shared.Util)
local T = UI.Theme

local apps = {}

local function catName(id)
	local c = VideoData.CategoryById[id]
	return c and c.Name or id
end
local function brandName(id)
	local b = SponsorData.BrandById[id]
	return b and b.Name or id
end
local kindNames = { gift = "🎁 Producto de regalo", loan = "📦 Equipo prestado", campaign = "📣 Campaña" }

---------------------------------------------------------------------------
-- PATROCINIOS
---------------------------------------------------------------------------
local Sponsors = { Id = "sponsors", Name = "Patrocinios", Icon = "🤝", Order = 5, Surfaces = { pc = true, phone = true, panel = true }, Width = 860, Height = 560 }
function Sponsors.build(container, ctx)
	task.spawn(Net.call, "Sponsor.Refresh", {}, { silent = true })
	local function render()
		UI.clear(container)
		local data = State.Data
		if not data then
			return
		end
		local sp = data.Sponsors or {}
		local s = UI.scroll(container, { Pad = 6 })
		UI.label(s, "Reputación comercial: " .. data.BizRep .. "/100 · Reputación del canal: " .. data.Reputation .. "/100", { Font = Enum.Font.GothamBold, Color = T.Gold })
		UI.progress(s, data.BizRep / 100, T.Gold, { Height = 8 })
		UI.label(s, "Las marcas te ofrecen contratos según tu reputación y tus suscriptores. Cumplirlos sube tu reputación comercial; incumplirlos la baja.", { TextSize = 12, Color = T.Sub, Height = 30 })
		UI.title(s, "📋 Contratos activos")
		local any = false
		for id, c in pairs(sp.Active or {}) do
			any = true
			local left = c.DueDay - data.Home.PlayDays
			local card = UI.card(s, { Height = 0, Auto = Enum.AutomaticSize.Y, Color = left <= 0 and Color3.fromRGB(90, 50, 30) or T.Panel2 })
			UI.label(card, brandName(c.Brand) .. " · " .. (kindNames[c.Kind] or c.Kind), { Font = Enum.Font.GothamBold })
			UI.label(card, "Publica un vídeo de " .. catName(c.Category) .. " con calidad " .. c.MinQ .. "+" .. (c.Product and (" mostrando " .. Catalog.get(c.Product).Name .. " (plano de producto, llévalo en la mochila)") or "") .. ".", { TextSize = 12, Height = 0, Auto = Enum.AutomaticSize.Y })
			UI.label(card, "Pago $" .. Util.formatInt(c.Pay) .. " (+$" .. c.Bonus .. " si la calidad supera " .. (c.MinQ + 15) .. ") · " .. (left >= 0 and ("quedan " .. left .. " días de juego") or "¡fuera de plazo!"), { TextSize = 12, Color = T.Ok })
			UI.label(card, "Al publicar en ViewTube Studio elige este contrato en «Patrocinio».", { TextSize = 11, Color = T.Sub })
			local row = UI.row(card, 30)
			UI.button(row, "🎬 Crear proyecto", function()
				local r = Net.call("Video.CreateProject", { category = c.Category, name = brandName(c.Brand) .. " · patrocinado" })
				if r.ok and c.Product then
					Net.call("Video.UpdatePlan", { pid = r.data.pid, plan = { Featured = { c.Product } } }, { silent = true })
				end
			end, { Width = 150, Height = 26, TextSize = 12, Color = T.Accent2 })
			UI.button(row, "Cancelar contrato", function()
				Notify.confirm("¿Cancelar el contrato con " .. brandName(c.Brand) .. "? Perderás 4 puntos de reputación comercial (incumplirlo cuesta 10).", function()
					Net.call("Sponsor.Cancel", { id = id })
				end)
			end, { Width = 150, Height = 26, TextSize = 12, Color = Color3.fromRGB(110, 40, 40) })
		end
		if not any then
			UI.label(s, "Ninguno.", { Color = T.Sub })
		end
		UI.title(s, "📨 Ofertas de hoy")
		if #(sp.Offers or {}) == 0 then
			UI.label(s, "No hay ofertas ahora. Llegan nuevas cada día de juego; sube tu reputación publicando vídeos de calidad.", { Color = T.Sub, Height = 30 })
		end
		for _, o in ipairs(sp.Offers or {}) do
			local b = SponsorData.BrandById[o.Brand]
			local card = UI.card(s, { Height = 0, Auto = Enum.AutomaticSize.Y })
			UI.label(card, b.Name .. " (" .. b.Field .. ") · " .. (kindNames[o.Kind] or o.Kind), { Font = Enum.Font.GothamBold })
			UI.label(card, "Requisitos: vídeo de " .. catName(o.Category) .. ", calidad " .. o.MinQ .. "+" .. (o.Product and (", mostrando " .. Catalog.get(o.Product).Name) or ""), { TextSize = 12, Height = 0, Auto = Enum.AutomaticSize.Y })
			UI.label(card, "Duración: " .. o.Days .. " días de juego · Pago $" .. Util.formatInt(o.Pay) .. " + bonus $" .. o.Bonus .. (o.Product and (o.Kind == "gift" and " · el producto es tuyo" or " · el equipo se devuelve al final") or ""), { TextSize = 12, Color = T.Ok })
			UI.label(card, "Condiciones: si no entregas a tiempo, −10 de reputación comercial y −2 de reputación del canal.", { TextSize = 11, Color = T.Sub })
			local row = UI.row(card, 30)
			UI.button(row, "✅ Aceptar", function()
				Net.call("Sponsor.Accept", { id = o.Id })
			end, { Width = 110, Height = 26, Color = T.Ok })
			UI.button(row, "Rechazar", function()
				Net.call("Sponsor.Decline", { id = o.Id })
			end, { Width = 100, Height = 26 })
		end
		UI.title(s, "🗂 Historial")
		for _, h in ipairs(sp.History or {}) do
			UI.label(s, os.date("%d/%m", h.T) .. " · " .. brandName(h.Brand) .. " · " .. h.Result .. (h.Pay > 0 and (" · $" .. Util.formatInt(h.Pay)) or ""), { TextSize = 12, Color = h.Result == "Cumplido" and T.Ok or T.Warn })
		end
	end
	render()
	ctx.onState(render)
end
table.insert(apps, Sponsors)

---------------------------------------------------------------------------
-- EVENTOS
---------------------------------------------------------------------------
local Events = { Id = "events", Name = "Eventos", Icon = "🎪", Order = 6, Surfaces = { pc = true, phone = true, panel = true }, Width = 760, Height = 560 }
function Events.build(container, ctx)
	local function render()
		UI.clear(container)
		local data = State.Data
		if not data then
			return
		end
		local day = workspace:GetAttribute("GameDay") or 1
		local ev = EventData.forDay(day)
		local spot = WorldData.SpotById[ev.Spot]
		local s = UI.scroll(container, { Pad = 6 })
		local card = UI.card(s, { Height = 0, Auto = Enum.AutomaticSize.Y, Color = Color3.fromRGB(70, 25, 70) })
		UI.label(card, "🎪 HOY: " .. ev.Name, { Font = Enum.Font.GothamBlack, TextSize = 18, Height = 24 })
		UI.label(card, ev.Desc, { TextSize = 13, Height = 0, Auto = Enum.AutomaticSize.Y })
		local active = data.Derived.EventActive
		UI.label(card, "📍 " .. (spot and spot.Name or "?") .. " (" .. WorldData.DistrictById[ev.District].Name .. ") · 🕒 " .. ev.Hours[1] .. ":00–" .. ev.Hours[2] .. ":00 · " .. (active and "✅ en curso" or "⏳ fuera de horario"), { TextSize = 12, Color = active and T.Ok or T.Warn })
		local row = UI.row(card, 32)
		UI.button(row, "🚕 Ir al evento", function()
			Net.call("Travel.TaxiSpot", { spot = ev.Spot })
		end, { Width = 150, Height = 28, Color = T.Gold, TextColor = Color3.new(0, 0, 0) })
		UI.label(s, "🎯 Objetivos (cada uno se cobra una vez):", { Font = Enum.Font.GothamBold })
		local prog = data.EventProg or {}
		local done = (prog.Day == day) and prog.Done or {}
		for i, g in ipairs(ev.Goals) do
			local ok = done[tostring(i)]
			UI.label(s, (ok and "✔ " or "○ ") .. EventData.goalText(g) .. " — $" .. g.Reward, { TextSize = 13, Color = ok and T.Ok or T.Text })
		end
		if prog.Day == day and (prog.Scenes or 0) > 0 then
			UI.label(s, "Escenas grabadas en el evento: " .. prog.Scenes, { TextSize = 12, Color = T.Sub })
		end
		UI.title(s, "📅 Próximos eventos")
		for i = 1, 6 do
			local e = EventData.forDay(day + i)
			UI.label(s, "Día " .. (day + i) .. " · " .. e.Name .. " · " .. WorldData.DistrictById[e.District].Name, { TextSize = 12, Color = T.Sub })
		end
	end
	render()
	ctx.onState(render)
end
table.insert(apps, Events)

---------------------------------------------------------------------------
-- DIRECTOS
---------------------------------------------------------------------------
local Live = { Id = "live", Name = "Directo", Icon = "🔴", Order = 7, Surfaces = { pc = true }, Width = 720, Height = 520 }
local topics = {
	{ Id = "gaming", Name = "Partida en directo" }, { Id = "qa", Name = "Preguntas y respuestas" }, { Id = "tech", Name = "Charla de tecnología" },
	{ Id = "cooking", Name = "Cocinando en directo" }, { Id = "edit", Name = "Editando en directo" },
}
function Live.build(container, ctx)
	local topicIdx = 1
	local function render()
		UI.clear(container)
		local data = State.Data
		if not data then
			return
		end
		local s = UI.scroll(container, { Pad = 6 })
		local live = State.Live
		if live and live.kind ~= "end" then
			UI.label(s, "🔴 EN DIRECTO · " .. live.topic, { Font = Enum.Font.GothamBlack, TextSize = 18, Color = T.Accent })
			UI.label(s, "👀 " .. live.viewers .. " espectadores (pico " .. live.peak .. ") · 💸 $" .. live.donations .. " en donaciones · +" .. live.subs .. " subs · ⏱ " .. live.left .. " s", { TextSize = 14 })
			UI.label(s, "Ánimo del chat: " .. live.engagement .. "%", { TextSize = 12, Color = T.Sub })
			UI.progress(s, live.engagement / 100, T.Ok)
			UI.label(s, "Las preguntas del chat aparecen en pantalla: responde bien para mantener a la audiencia.", { TextSize = 12, Color = T.Sub, Height = 30 })
			UI.button(s, "⏹ Terminar directo", function()
				Net.call("Live.Stop", {})
			end, { Width = 180, Color = T.Panel3 })
			return
		end
		UI.title(s, "🔴 Emitir en directo")
		UI.label(s, "Necesitas una cámara web en casa o una cámara. La audiencia depende de tus suscriptores, tu equipo (cámara, micrófono, PC), la decoración de la sala y tus respuestas. Duración: 75 s.", { TextSize = 12, Color = T.Sub, Height = 46 })
		local names = {}
		for i, t in ipairs(topics) do
			names[i] = t.Name
		end
		UI.cycle(s, "Tema", names, topicIdx, function(i)
			topicIdx = i
		end, { ValueWidth = 220 })
		UI.button(s, "🔴 Empezar directo", function()
			Net.call("Live.Start", { topic = topics[topicIdx].Id })
		end, { Width = 200, Color = T.Accent })
		if live and live.kind == "end" then
			local card = UI.card(s, { Height = 0, Auto = Enum.AutomaticSize.Y, Color = T.Panel3 })
			UI.label(card, "Resumen del último directo", { Font = Enum.Font.GothamBold })
			UI.label(card, "Pico " .. live.peak .. " · media " .. (live.avg or 0) .. " · anuncios $" .. (live.ads or 0) .. " · donaciones $" .. live.donations .. " · +" .. live.subs .. " suscriptores", { TextSize = 12 })
		end
		UI.title(s, "📼 Directos anteriores")
		for _, l in ipairs(data.Lives or {}) do
			UI.label(s, os.date("%d/%m %H:%M", l.T) .. " · " .. l.Topic .. " · pico " .. l.Peak .. " · $" .. (l.Donations + l.Ads) .. " · +" .. l.Subs .. " subs · ánimo " .. l.Engagement .. "%", { TextSize = 12, Color = T.Sub })
		end
	end
	render()
	ctx.cleanup = State.onLive(render)
	ctx.onState(function() end)
end
table.insert(apps, Live)

return apps
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000055"><Properties><string name="Name">CommerceApps</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Apps de compras y gestión: Tienda (física y online), Ficha de producto, Comparador, Inventario,
-- Montador de PC y Banco.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Client = script.Parent.Parent
local UI = require(Client.UIKit)
local Net = require(Client.Net)
local State = require(Client.State)
local Notify = require(Client.Notify)
local Catalog = require(Shared.ItemCatalog)
local PCBuild = require(Shared.PCBuild)
local Util = require(Shared.Util)
local T = UI.Theme

local apps = {}
local cart = {} -- carrito online compartido entre aperturas: { [itemId] = qty }
local compareList = {} -- productos elegidos en el comparador

local statNames = {
	Score = "Rendimiento", Tdp = "Calor (W)", IGpu = "Gráficos integrados", Cores = "Núcleos", Gb = "Capacidad (GB)", Watts = "Consumo/Potencia (W)",
	ProColor = "Color profesional", Capacity = "Disipación (W)", Noise = "Ruido", Airflow = "Flujo de aire", FanSlots = "Huecos ventilador",
	Speed = "Velocidad", CpuScore = "CPU", GpuScore = "GPU", Ram = "RAM (GB)", ColorAcc = "Precisión de color", Screens = "Pantallas",
	EditSpeed = "Velocidad de edición %", AudioMix = "Mezcla de audio", Video = "Vídeo", Gaming = "Juego", Comfort = "Comodidad",
	Photo = "Foto", LowLight = "Poca luz", Stab = "Estabilización", Battery = "Batería (escenas)", GbPerMin = "GB por minuto",
	Weather = "Resistente a lluvia", Audio = "Audio", Stability = "Estabilidad", Light = "Luz", Presentation = "Presentación",
	Decor = "Decoración", Charges = "Cargas", Slots = "Espacios de mochila", PhotoStorage = "Fotos que caben", Night = "Modo noche",
	Thumbnails = "Diseña miniaturas", EditLite = "Edición ligera (clips)", Performance = "Rendimiento", Durability = "Durabilidad", Aerial = "Tomas aéreas",
}

local function statText(k, v)
	if type(v) == "boolean" then
		return (statNames[k] or k) .. ": " .. (v and "Sí" or "No")
	end
	return (statNames[k] or k) .. ": " .. tostring(v)
end

local function ownedCount(itemId)
	local n = 0
	for _, rec in pairs(State.Data and State.Data.Inventory or {}) do
		if rec.Id == itemId then
			n = n + 1
		end
	end
	return n
end

local function compatText(def)
	local c = def.Compat or {}
	local parts = {}
	if c.Socket then
		parts[#parts + 1] = "Zócalo " .. c.Socket
	end
	if c.RamType then
		parts[#parts + 1] = c.RamType
	end
	if c.Form then
		parts[#parts + 1] = "Formato " .. c.Form
	end
	if c.Forms then
		parts[#parts + 1] = "Admite " .. table.concat(c.Forms, "/")
	end
	if c.MaxGpu then
		parts[#parts + 1] = "Gráfica máx. " .. c.MaxGpu .. " cm"
	end
	if c.Length then
		parts[#parts + 1] = "Largo " .. c.Length .. " cm"
	end
	if c.StorageSlots then
		parts[#parts + 1] = c.StorageSlots .. " ranuras de disco"
	end
	if def.Portable then
		parts[#parts + 1] = "Portátil"
	end
	return #parts > 0 and table.concat(parts, " · ") or "Compatible con todo"
end

local function buyHere(def, storeId)
	local r = Net.call("Shop.BuyInStore", { itemId = def.Id, qty = 1, nonce = Net.nonce() })
	return r.ok
end

-- Tarjeta de detalle de un producto (la usan la Tienda y la Ficha)
local function productDetail(parent, def, storeId, ctx)
	local card = UI.card(parent, { Height = 0, Auto = Enum.AutomaticSize.Y })
	UI.label(card, def.Name, { Font = Enum.Font.GothamBlack, TextSize = 18 })
	UI.label(card, Catalog.categoryName(def.Cat) .. " · " .. tostring(def.Sub) .. (def.Brand ~= "" and (" · " .. def.Brand) or ""), { TextSize = 12, Color = T.Sub })
	UI.label(card, "$" .. Util.formatInt(def.Price) .. "   ·   Calidad " .. def.Quality .. "/100" .. ((def.Req.Level or 1) > 1 and ("   ·   Requiere nivel " .. def.Req.Level) or ""), { Font = Enum.Font.GothamBold, Color = T.Gold })
	UI.label(card, def.Desc, { Height = 36, TextSize = 13 })
	for k, v in pairs(def.Stats) do
		UI.label(card, "• " .. statText(k, v), { TextSize = 12 })
	end
	if def.Parts then
		local names = {}
		for _, v in pairs(def.Parts) do
			if type(v) == "table" then
				for _, id in ipairs(v) do
					names[#names + 1] = Catalog.get(id).Name
				end
			else
				names[#names + 1] = Catalog.get(v).Name
			end
		end
		local stats = PCBuild.stats(def.Parts)
		UI.label(card, "Piezas: " .. table.concat(names, ", "), { TextSize = 12, Color = T.Sub, Height = 46 })
		UI.label(card, "Rendimiento " .. stats.Score .. " (" .. stats.TierName .. ") · hasta " .. stats.MaxScenes .. " clips · " .. stats.Temp .. " °C · ruido " .. stats.Noise .. "/10", { TextSize = 12 })
	end
	UI.label(card, "Compatibilidad: " .. compatText(def), { TextSize = 12, Color = T.Sub })
	local pros, cons = Catalog.prosCons(def)
	if #pros > 0 then
		UI.label(card, "👍 " .. table.concat(pros, " · "), { TextSize = 12, Color = T.Ok })
	end
	if #cons > 0 then
		UI.label(card, "👎 " .. table.concat(cons, " · "), { TextSize = 12, Color = T.Err })
	end
	local owned = ownedCount(def.Id)
	if owned > 0 then
		UI.label(card, "Tienes " .. owned, { TextSize = 12, Color = T.Accent2 })
	end
	local row = UI.row(card, 36)
	if storeId and Util.indexOf(def.Stores, storeId) then
		UI.button(row, "🛍 Comprar aquí", function()
			buyHere(def, storeId)
		end, { Width = 140, Color = T.Ok })
	end
	UI.button(row, "🛒 Al carrito online", function()
		cart[def.Id] = math.min(10, (cart[def.Id] or 0) + 1)
		Notify.toast(def.Name .. " añadido al carrito online.", "info")
	end, { Width = 160 })
	UI.button(row, "⚖ Comparar", function()
		if not Util.indexOf(compareList, def.Id) then
			if #compareList >= 4 then
				table.remove(compareList, 1)
			end
			table.insert(compareList, def.Id)
		end
		ctx.open("compare")
	end, { Width = 110 })
	return card
end

---------------------------------------------------------------------------
-- TIENDA (online + física)
---------------------------------------------------------------------------
local Shop = { Id = "shop", Name = "Tienda", Icon = "🛒", Order = 5, Surfaces = { pc = true, phone = true, panel = true }, Width = 940, Height = 580 }

function Shop.build(container, ctx)
	local storeId = ctx.params.store
	local tab = "catalog"
	local cat = nil
	local sortMode = 1
	local maxPrice = 0
	local selected = nil
	if storeId then
		Net.call("Shop.VisitStore", {}, { silent = true })
		cat = Catalog.Stores[storeId].Cats[1]
	end
	local cats = {}
	for _, c in ipairs(Catalog.Categories) do
		if not storeId or Util.indexOf(Catalog.Stores[storeId].Cats, c.Key) then
			cats[#cats + 1] = c
		end
	end
	local render
	render = function()
		UI.clear(container)
		local data = State.Data
		if not data then
			return
		end
		local tabs = UI.row(container, 34)
		UI.label(tabs, storeId and ("🏬 " .. Catalog.Stores[storeId].Name .. " (tienda física: entrega inmediata)") or "🛒 Tienda online (entrega a domicilio)", { Size = UDim2.new(0, 330, 1, 0), Font = Enum.Font.GothamBold, TextSize = 13 })
		UI.button(tabs, "Catálogo", function()
			tab = "catalog"
			render()
		end, { Width = 90, Height = 28, Color = tab == "catalog" and T.Accent or T.Panel3 })
		local n = 0
		for _, q in pairs(cart) do
			n = n + q
		end
		UI.button(tabs, "Carrito (" .. n .. ")", function()
			tab = "cart"
			render()
		end, { Width = 100, Height = 28, Color = tab == "cart" and T.Accent or T.Panel3 })
		UI.button(tabs, "Pedidos", function()
			tab = "orders"
			render()
		end, { Width = 90, Height = 28, Color = tab == "orders" and T.Accent or T.Panel3 })
		UI.label(tabs, "💰 $" .. Util.formatInt(data.Money), { Size = UDim2.new(0, 120, 1, 0), Font = Enum.Font.GothamBold, Color = T.Ok })
		local body = UI.frame(container, { Size = UDim2.new(1, 0, 1, -40), Position = UDim2.fromOffset(0, 40), Transparency = 1, Radius = false })
		if tab == "cart" then
			local s = UI.scroll(body, { Pad = 6 })
			local total = 0
			for id, qty in pairs(cart) do
				local def = Catalog.get(id)
				total = total + def.Price * qty
				local row = UI.row(s, 32)
				UI.label(row, def.Name, { Size = UDim2.new(0.45, 0, 1, 0) })
				UI.button(row, "−", function()
					cart[id] = qty > 1 and qty - 1 or nil
					render()
				end, { Width = 30, Height = 26 })
				UI.label(row, "x" .. qty, { Size = UDim2.fromOffset(40, 26), Align = Enum.TextXAlignment.Center })
				UI.button(row, "+", function()
					cart[id] = math.min(10, qty + 1)
					render()
				end, { Width = 30, Height = 26 })
				UI.label(row, "$" .. Util.formatInt(def.Price * qty), { Size = UDim2.fromOffset(100, 26), Align = Enum.TextXAlignment.Right })
			end
			if next(cart) == nil then
				UI.label(s, "El carrito está vacío.", { Color = T.Sub })
				return
			end
			local shipping = total >= 500 and 0 or 15
			UI.label(s, "Subtotal $" .. Util.formatInt(total) .. " · Envío " .. (shipping == 0 and "gratis" or ("$" .. shipping)) .. " · TOTAL $" .. Util.formatInt(total + shipping), { Font = Enum.Font.GothamBold, Color = T.Gold })
			UI.label(s, "Presupuesto disponible: $" .. Util.formatInt(data.Money) .. (data.Money < total + shipping and "  ⚠ no alcanza" or ""), { Color = data.Money < total + shipping and T.Err or T.Sub, TextSize = 13 })
			UI.button(s, "✅ Confirmar pedido", function()
				Notify.confirm("¿Confirmar el pedido por $" .. Util.formatInt(total + shipping) .. "? Llegará a tu casa en unos minutos.", function()
					local items = {}
					for id, qty in pairs(cart) do
						items[#items + 1] = { id = id, qty = qty }
					end
					local r = Net.call("Shop.Checkout", { items = items, nonce = Net.nonce() })
					if r.ok then
						cart = {}
						tab = "orders"
						render()
					end
				end)
			end, { Width = 200, Color = T.Ok })
			return
		elseif tab == "orders" then
			local s = UI.scroll(body, { Pad = 6 })
			if #data.Orders == 0 then
				UI.label(s, "Aún no has hecho pedidos online.", { Color = T.Sub })
			end
			for _, o in ipairs(data.Orders) do
				local card = UI.card(s, { Height = 0, Auto = Enum.AutomaticSize.Y })
				local names = {}
				for _, line in ipairs(o.Items) do
					names[#names + 1] = Catalog.get(line.Id).Name .. " x" .. line.Qty
				end
				local status = o.Status
				if status == "En camino" then
					status = status .. " (llega en " .. math.max(0, math.ceil(o.Eta - workspace:GetServerTimeNow())) .. " s)"
				end
				UI.label(card, "Pedido #" .. o.Num .. " · $" .. Util.formatInt(o.Total) .. " · " .. status, { Font = Enum.Font.GothamBold })
				UI.label(card, table.concat(names, ", "), { TextSize = 12, Color = T.Sub, Height = 32 })
				if o.Status == "En camino" then
					UI.button(card, "Cancelar pedido", function()
						Net.call("Shop.CancelOrder", { num = o.Num })
					end, { Width = 150, Height = 28, Color = Color3.fromRGB(110, 40, 40) })
				end
			end
			return
		end
		-- Catálogo con filtros
		local narrow = ctx.kind == "phone"
		local side = UI.scroll(body, { Size = narrow and UDim2.new(1, 0, 0, 44) or UDim2.new(0, 170, 1, 0), Horizontal = narrow, Pad = 4 })
		for _, c in ipairs(cats) do
			UI.button(side, c.Name, function()
				cat = c.Key
				selected = nil
				render()
			end, { Size = narrow and UDim2.fromOffset(110, 32) or UDim2.new(1, -8, 0, 30), TextSize = 12, Color = cat == c.Key and T.Accent or T.Panel3 })
		end
		local main = UI.frame(body, { Size = narrow and UDim2.new(1, 0, 1, -50) or UDim2.new(1, -180, 1, 0), Position = narrow and UDim2.fromOffset(0, 50) or UDim2.fromOffset(180, 0), Transparency = 1, Radius = false })
		local filters = UI.row(main, 32)
		local sorts = { "Precio ↑", "Precio ↓", "Calidad ↓", "Nombre" }
		UI.cycle(filters, "Orden", sorts, sortMode, function(i)
			sortMode = i
			render()
		end, { LabelWidth = 46, ValueWidth = 90 })
		local prices = { "Cualquier precio", "Hasta $100", "Hasta $500", "Hasta $1.000", "Hasta $3.000" }
		local priceVals = { 0, 100, 500, 1000, 3000 }
		UI.cycle(filters, "", prices, Util.indexOf(priceVals, maxPrice) or 1, function(i)
			maxPrice = priceVals[i]
			render()
		end, { LabelWidth = 0, ValueWidth = 130 })
		local list = UI.scroll(main, { Size = selected and UDim2.new(0.5, -4, 1, -38) or UDim2.new(1, 0, 1, -38), Position = UDim2.fromOffset(0, 38), Pad = 4 })
		local items = Catalog.list({ Cat = cat or (cats[1] and cats[1].Key), Store = storeId })
		local filtered = {}
		for _, def in ipairs(items) do
			if maxPrice == 0 or def.Price <= maxPrice then
				filtered[#filtered + 1] = def
			end
		end
		table.sort(filtered, function(a, b)
			if sortMode == 1 then
				return a.Price < b.Price
			elseif sortMode == 2 then
				return a.Price > b.Price
			elseif sortMode == 3 then
				return a.Quality > b.Quality
			end
			return a.Name < b.Name
		end)
		for _, def in ipairs(filtered) do
			local locked = data.Level < (def.Req.Level or 1)
			local b = UI.button(list, def.Name .. "   $" .. Util.formatInt(def.Price) .. "   ★" .. def.Quality .. (locked and ("   🔒 nivel " .. def.Req.Level) or "") .. (ownedCount(def.Id) > 0 and "   ✔" or ""), function()
				selected = def.Id
				render()
			end, { Size = UDim2.new(1, -8, 0, 32), TextSize = 12, Color = selected == def.Id and T.Accent2 or T.Panel2 })
			b.TextXAlignment = Enum.TextXAlignment.Left
		end
		if selected then
			local detail = UI.scroll(main, { Size = UDim2.new(0.5, -4, 1, -38), Position = UDim2.new(0.5, 4, 0, 38) })
			productDetail(detail, Catalog.get(selected), storeId, ctx)
		end
	end
	render()
	ctx.onState(function()
		if tab ~= "catalog" then
			render()
		end
	end)
end
table.insert(apps, Shop)

---------------------------------------------------------------------------
-- FICHA DE PRODUCTO (al inspeccionar en una tienda física)
---------------------------------------------------------------------------
local Product = { Id = "product", Name = "Producto", Icon = "🏷", Hidden = true, Surfaces = { panel = true }, Width = 520, Height = 520 }
function Product.build(container, ctx)
	local def = Catalog.get(ctx.params.item or "")
	if not def then
		return
	end
	local s = UI.scroll(container)
	productDetail(s, def, ctx.params.store, ctx)
	UI.button(s, "Ver todo el catálogo de la tienda", function()
		ctx.open("shop", { store = ctx.params.store })
	end, { Width = 280 })
end
table.insert(apps, Product)

---------------------------------------------------------------------------
-- COMPARADOR
---------------------------------------------------------------------------
local Compare = { Id = "compare", Name = "Comparador", Icon = "⚖", Order = 6, Surfaces = { pc = true, phone = true, panel = true }, Width = 960, Height = 560 }
function Compare.build(container, ctx)
	local cat = "camera"
	local render
	render = function()
		UI.clear(container)
		local data = State.Data
		local top = UI.row(container, 34)
		local names, keys = {}, {}
		for i, c in ipairs(Catalog.Categories) do
			names[i] = c.Name
			keys[i] = c.Key
		end
		UI.cycle(top, "Categoría", names, Util.indexOf(keys, cat) or 1, function(i)
			cat = keys[i]
			render()
		end, { LabelWidth = 80, ValueWidth = 180 })
		UI.button(top, "Vaciar", function()
			compareList = {}
			render()
		end, { Width = 80, Height = 28 })
		UI.label(top, "Elige hasta 4 productos (" .. #compareList .. "/4)", { Size = UDim2.fromOffset(240, 28), Color = T.Sub, TextSize = 12 })
		local picker = UI.scroll(container, { Size = UDim2.new(1, 0, 0, 44), Position = UDim2.fromOffset(0, 40), Horizontal = true, Pad = 4 })
		for _, def in ipairs(Catalog.list({ Cat = cat })) do
			local on = Util.indexOf(compareList, def.Id) ~= nil
			UI.button(picker, def.Name, function()
				local i = Util.indexOf(compareList, def.Id)
				if i then
					table.remove(compareList, i)
				elseif #compareList < 4 then
					table.insert(compareList, def.Id)
				end
				render()
			end, { Size = UDim2.fromOffset(170, 34), TextSize = 11, Color = on and T.Ok or T.Panel3 })
		end
		local tableFrame = UI.scroll(container, { Size = UDim2.new(1, 0, 1, -140), Position = UDim2.fromOffset(0, 90), Pad = 2, Color = T.Bg, Transparency = 0 })
		if #compareList == 0 then
			UI.label(tableFrame, "Selecciona productos arriba para compararlos.", { Color = T.Sub })
			return
		end
		local defs = {}
		for _, id in ipairs(compareList) do
			defs[#defs + 1] = Catalog.get(id)
		end
		local colW = 1 / (#defs + 1)
		local function row(label, fn, best)
			local r = UI.frame(tableFrame, { Height = 0, Auto = Enum.AutomaticSize.Y, Transparency = 1, Radius = false })
			UI.label(r, label, { Size = UDim2.new(colW, 0, 0, 0), Auto = Enum.AutomaticSize.Y, Color = T.Sub, TextSize = 12 })
			local vals = {}
			for i, def in ipairs(defs) do
				vals[i] = fn(def)
			end
			local bestIdx = nil
			if best then
				local bv = nil
				for i, v in ipairs(vals) do
					local n = tonumber(v)
					if n and (bv == nil or (best == "max" and n > bv) or (best == "min" and n < bv)) then
						bv, bestIdx = n, i
					end
				end
			end
			for i, v in ipairs(vals) do
				UI.label(r, tostring(v), { Size = UDim2.new(colW, -4, 0, 0), Position = UDim2.new(colW * i, 0, 0, 0), Auto = Enum.AutomaticSize.Y, TextSize = 12, Color = (i == bestIdx and #defs > 1) and T.Ok or T.Text })
			end
		end
		row("Producto", function(d)
			return d.Name
		end)
		row("Precio $", function(d)
			return d.Price
		end, "min")
		row("Calidad", function(d)
			return d.Quality
		end, "max")
		local keysSeen, statKeys = {}, {}
		for _, d in ipairs(defs) do
			for k in pairs(d.Stats) do
				if not keysSeen[k] then
					keysSeen[k] = true
					statKeys[#statKeys + 1] = k
				end
			end
		end
		table.sort(statKeys)
		for _, k in ipairs(statKeys) do
			local lowerBetter = (k == "Noise" or k == "Tdp" or k == "GbPerMin")
			row(statNames[k] or k, function(d)
				local v = d.Stats[k]
				if type(v) == "boolean" then
					return v and "Sí" or "No"
				end
				return v == nil and "—" or v
			end, lowerBetter and "min" or "max")
		end
		if cat == "pc" then
			row("Rendimiento real", function(d)
				return PCBuild.stats(d.Parts).Score
			end, "max")
		elseif cat == "laptop" then
			row("Rendimiento real", function(d)
				return PCBuild.laptopStats(d).Score
			end, "max")
		end
		row("Durabilidad (simulada)", function(d)
			return d.Stats.Durability or math.floor(40 + d.Quality * 0.5)
		end, "max")
		row("Mantenimiento/año $", function(d)
			return math.floor(d.Price * 0.15 * (1.2 - d.Quality / 100))
		end, "min")
		row("Compatibilidad", compatText)
		row("Ventajas", function(d)
			local p = Catalog.prosCons(d)
			return #p > 0 and table.concat(p, ", ") or "—"
		end)
		row("Desventajas", function(d)
			local _, c = Catalog.prosCons(d)
			return #c > 0 and table.concat(c, ", ") or "—"
		end)
		row("Requisitos", function(d)
			return "Nivel " .. (d.Req.Level or 1)
		end)
		row("¿Lo tienes?", function(d)
			return ownedCount(d.Id) > 0 and "✔ Sí (puedes probarlo de verdad)" or "No (solo especificaciones)"
		end)
		local bottom = UI.row(container, 40)
		bottom.Position = UDim2.new(0, 0, 1, -42)
		UI.button(bottom, "🎬 Crear proyecto de comparativa", function()
			local r = Net.call("Video.CreateProject", { category = "compare", name = "Comparativa: " .. (defs[1] and defs[1].Name or "") })
			if r.ok then
				Net.call("Video.UpdatePlan", { pid = r.data.pid, plan = { Featured = compareList } }, { silent = true })
				Notify.toast("Para una «Prueba real» necesitas tener los productos en la mochila. Si no, se publicará como «Comparación de especificaciones».", "info")
			end
		end, { Width = 280, Color = T.Accent })
	end
	render()
end
table.insert(apps, Compare)

---------------------------------------------------------------------------
-- INVENTARIO Y MOCHILA
---------------------------------------------------------------------------
local Inventory = { Id = "inventory", Name = "Inventario", Icon = "🎒", Order = 7, Surfaces = { pc = true, phone = true, panel = true }, Width = 820, Height = 560 }
function Inventory.build(container, ctx)
	local filter = "all"
	local render
	render = function()
		UI.clear(container)
		local data = State.Data
		if not data then
			return
		end
		local d = data.Derived
		local top = UI.row(container, 34)
		for _, f in ipairs({ { "all", "Todo" }, { "backpack", "🎒 Mochila" }, { "home", "🏠 Casa" }, { "rig", "💻 Instalado" } }) do
			UI.button(top, f[2], function()
				filter = f[1]
				render()
			end, { Width = 110, Height = 28, Color = filter == f[1] and T.Accent or T.Panel3 })
		end
		UI.label(top, "Mochila " .. d.BackpackUsed .. "/" .. d.BackpackCap .. (d.AtHome and "  · estás en casa" or "  · sal de casa preparado"), { Size = UDim2.fromOffset(280, 28), TextSize = 12, Color = d.AtHome and T.Ok or T.Sub })
		local s = UI.scroll(container, { Size = UDim2.new(1, 0, 1, -40), Position = UDim2.fromOffset(0, 40), Pad = 4 })
		local items = State.items(function(rec)
			if filter == "all" then
				return true
			elseif filter == "rig" then
				return rec.Loc:sub(1, 4) == "rig:"
			end
			return rec.Loc == filter
		end)
		if #items == 0 then
			UI.label(s, "No hay objetos aquí.", { Color = T.Sub })
		end
		for _, it in ipairs(items) do
			local rec, def, uid = it.Rec, it.Def, it.Uid
			local card = UI.card(s, { Height = 0, Auto = Enum.AutomaticSize.Y })
			local loc = rec.Loc == "backpack" and "🎒 Mochila" or (rec.Loc == "home" and "🏠 Casa" or "💻 Instalado en PC")
			local extra = ""
			if def.Cat == "camera" or def.Cat == "phone" then
				extra = " · 🔋 " .. math.floor(rec.Charge or 100) .. "%"
			end
			if data.Equipped.Phone == uid then
				extra = extra .. " · 📱 en uso"
			end
			UI.label(card, def.Name .. "  ·  " .. loc .. extra, { Font = Enum.Font.GothamBold, TextSize = 13 })
			UI.label(card, Catalog.categoryName(def.Cat) .. " · condición " .. math.floor(rec.Cond) .. "% · pagado $" .. Util.formatInt(rec.Paid or 0) .. (def.Portable and " · portátil (" .. def.Size .. " esp.)" or ""), { TextSize = 12, Color = T.Sub })
			local row = UI.row(card, 30, nil, 4)
			if rec.Loc == "home" and def.Portable then
				UI.button(row, "→ Mochila", function()
					Net.call("Inv.Move", { uid = uid, to = "backpack" })
				end, { Width = 96, Height = 26, TextSize = 12, Color = T.Accent2 })
			elseif rec.Loc == "backpack" then
				UI.button(row, "→ Casa", function()
					Net.call("Inv.Move", { uid = uid, to = "home" })
				end, { Width = 80, Height = 26, TextSize = 12 })
			end
			if def.Cat == "food" then
				UI.button(row, "🍽 Comer", function()
					Net.call("Food.Eat", { uid = uid })
				end, { Width = 90, Height = 26, TextSize = 12, Color = T.Ok })
			end
			if def.Slot == "phone" and data.Equipped.Phone ~= uid then
				UI.button(row, "Usar teléfono", function()
					Net.call("Inv.EquipPhone", { uid = uid })
				end, { Width = 110, Height = 26, TextSize = 12 })
			end
			if rec.Loc:sub(1, 4) ~= "rig:" then
				local ret = d.Returnable[uid]
				if ret then
					UI.button(row, "↩ Devolver (+$" .. ret .. ")", function()
						Notify.confirm("¿Devolver " .. def.Name .. " por $" .. ret .. "?", function()
							Net.call("Inv.Return", { uid = uid })
						end)
					end, { Width = 150, Height = 26, TextSize = 12 })
				end
				local sv = d.SellValues[uid] or 0
				UI.button(row, "Vender $" .. sv, function()
					Notify.confirm("¿Vender " .. def.Name .. " por $" .. sv .. "?", function()
						Net.call("Inv.Sell", { uid = uid })
					end, "Vender")
				end, { Width = 110, Height = 26, TextSize = 12, Color = Color3.fromRGB(110, 40, 40) })
			end
			if rec.Cond < 90 then
				UI.button(row, "🧽 Limpiar", function()
					Net.call("Inv.Clean", { uid = uid })
				end, { Width = 90, Height = 26, TextSize = 12 })
			end
			if rec.Cond < 100 then
				UI.button(row, "🔧 Reparar", function()
					Net.call("Inv.Repair", { uid = uid })
				end, { Width = 90, Height = 26, TextSize = 12 })
			end
		end
	end
	render()
	ctx.onState(render)
end
table.insert(apps, Inventory)

---------------------------------------------------------------------------
-- MONTADOR DE PC
---------------------------------------------------------------------------
local Builder = { Id = "builder", Name = "Montador de PC", Icon = "🔧", Order = 8, Surfaces = { pc = true, panel = true }, Width = 980, Height = 580 }
function Builder.build(container, ctx)
	local editingRig = nil -- nil = lista; "new" = nuevo
	local draft = {}
	local name = ""
	local benchResult = {}
	local render
	local function partsIds()
		local ids = {}
		for k, v in pairs(draft) do
			if type(v) == "table" then
				ids[k] = {}
				for _, uid in ipairs(v) do
					local rec = State.Data.Inventory[uid]
					if rec then
						table.insert(ids[k], rec.Id)
					end
				end
			else
				local rec = State.Data.Inventory[v]
				ids[k] = rec and rec.Id or nil
			end
		end
		return ids
	end
	render = function()
		UI.clear(container)
		local data = State.Data
		if not data then
			return
		end
		if not editingRig then
			local s = UI.scroll(container, { Pad = 8 })
			UI.title(s, "💻 Tus computadores")
			UI.label(s, "Monta, mejora o desmonta tus PC en casa. Solo las piezas instaladas y reconocidas mejoran el rendimiento.", { Color = T.Sub, TextSize = 12, Height = 30 })
			for rigId, rig in pairs(data.Rigs) do
				local st = data.Derived.RigStats[rigId]
				local card = UI.card(s, { Height = 0, Auto = Enum.AutomaticSize.Y })
				UI.label(card, (data.ActiveRig == rigId and "⭐ " or "") .. rig.Name, { Font = Enum.Font.GothamBold })
				if st then
					UI.label(card, "Rendimiento " .. st.Score .. " (" .. st.TierName .. ") · " .. st.MaxScenes .. " clips · " .. st.Ram .. " GB RAM · " .. Util.formatInt(st.StorageGb) .. " GB · " .. st.Watts .. " W · " .. st.Temp .. " °C · ruido " .. st.Noise .. "/10 · valor piezas $" .. Util.formatInt(st.PartsValue), { TextSize = 12, Color = T.Sub, Height = 32 })
				end
				if benchResult[rigId] then
					UI.label(card, "🏁 Benchmark: " .. Util.formatInt(benchResult[rigId]) .. " puntos", { TextSize = 12, Color = T.Gold })
				end
				local row = UI.row(card, 30, nil, 4)
				if data.ActiveRig ~= rigId then
					UI.button(row, "Usar en escritorio", function()
						Net.call("PC.SetActive", { rigId = rigId })
					end, { Width = 140, Height = 26, TextSize = 12 })
				end
				UI.button(row, "🔧 Mejorar piezas", function()
					editingRig = rigId
					draft = Util.deepCopy(rig.Parts)
					name = rig.Name
					render()
				end, { Width = 130, Height = 26, TextSize = 12 })
				UI.button(row, "🏁 Benchmark", function()
					local r = Net.call("PC.Benchmark", { rigId = rigId })
					if r.ok then
						benchResult[rigId] = r.data.points
						render()
					end
				end, { Width = 110, Height = 26, TextSize = 12 })
				UI.button(row, "Desmontar", function()
					Notify.confirm("¿Desmontar " .. rig.Name .. "? Las piezas quedarán en casa.", function()
						Net.call("PC.Disassemble", { rigId = rigId })
					end)
				end, { Width = 100, Height = 26, TextSize = 12, Color = Color3.fromRGB(110, 40, 40) })
			end
			UI.button(s, "＋ Montar un PC nuevo con piezas sueltas", function()
				editingRig = "new"
				draft = { storage = {}, fans = {} }
				name = "Mi PC"
				render()
			end, { Width = 340, Color = T.Accent })
			UI.button(s, "🛒 Comprar componentes", function()
				ctx.open("shop")
			end, { Width = 220 })
			return
		end
		-- Edición del montaje
		local left = UI.scroll(container, { Size = UDim2.new(0.58, -6, 1, -44), Pad = 6 })
		local right = UI.scroll(container, { Size = UDim2.new(0.42, 0, 1, -44), Position = UDim2.fromScale(0.58, 0), Color = T.Panel2, Transparency = 0 })
		local nb = UI.input(left, "Nombre del PC", name)
		nb.FocusLost:Connect(function()
			name = nb.Text
		end)
		local loc = editingRig ~= "new" and ("rig:" .. editingRig) or nil
		for _, slot in ipairs(PCBuild.Slots) do
			local available = State.items(function(rec, def)
				local sl = PCBuild.slotFor(def)
				return sl and sl.Key == slot.Key and (rec.Loc == "home" or rec.Loc == loc)
			end)
			local card = UI.card(left, { Height = 0, Auto = Enum.AutomaticSize.Y })
			UI.label(card, slot.Name .. (slot.Required and " *" or ""), { Font = Enum.Font.GothamBold, TextSize = 13 })
			if #available == 0 then
				UI.label(card, "No tienes piezas de este tipo en casa.", { TextSize = 12, Color = T.Sub })
			end
			local grid = UI.frame(card, { Height = 0, Auto = Enum.AutomaticSize.Y, Transparency = 1, Radius = false })
			UI.grid(grid, 250, 28, 4)
			for _, it in ipairs(available) do
				local sel
				if slot.Multi then
					sel = Util.indexOf(draft[slot.Key] or {}, it.Uid) ~= nil
				else
					sel = draft[slot.Key] == it.Uid
				end
				UI.button(grid, (sel and "✔ " or "") .. it.Def.Name, function()
					if slot.Multi then
						draft[slot.Key] = draft[slot.Key] or {}
						local i = Util.indexOf(draft[slot.Key], it.Uid)
						if i then
							table.remove(draft[slot.Key], i)
						else
							table.insert(draft[slot.Key], it.Uid)
						end
					else
						draft[slot.Key] = sel and nil or it.Uid
					end
					render()
				end, { Size = UDim2.fromOffset(250, 28), TextSize = 11, Color = sel and T.Ok or T.Panel3 })
			end
		end
		-- Vista previa y validación (el servidor vuelve a validar al guardar)
		local ids = partsIds()
		local ok, errors, warnings = PCBuild.validate(ids)
		local st = PCBuild.stats(ids)
		UI.title(right, ok and "✅ Compatible" or "❌ No compatible")
		for _, e in ipairs(errors) do
			UI.label(right, "• " .. e, { TextSize = 12, Color = T.Err, Height = 30 })
		end
		for _, w in ipairs(warnings) do
			UI.label(right, "• " .. w, { TextSize = 12, Color = T.Warn, Height = 30 })
		end
		UI.label(right, "Rendimiento estimado: " .. st.Score .. " (" .. st.TierName .. ")", { Font = Enum.Font.GothamBold })
		UI.label(right, "Clips por proyecto: " .. st.MaxScenes, { TextSize = 13 })
		UI.label(right, "Consumo: " .. st.Watts .. " W", { TextSize = 13 })
		UI.label(right, "Temperatura: " .. st.Temp .. " °C" .. (st.Throttled and " (limitado)" or ""), { TextSize = 13 })
		UI.label(right, "Ruido: " .. st.Noise .. "/10", { TextSize = 13 })
		UI.label(right, "Almacenamiento: " .. Util.formatInt(st.StorageGb) .. " GB", { TextSize = 13 })
		UI.label(right, "Valor de reventa aprox.: $" .. Util.formatInt(math.floor(st.PartsValue * 0.55)), { TextSize = 13 })
		local current = data.Derived.Session
		if current and current.Score then
			local diff = st.Score - current.Score
			UI.label(right, "Comparado con el equipo actual: " .. (diff >= 0 and "+" or "") .. math.floor(diff * 10) / 10, { TextSize = 13, Color = diff >= 0 and T.Ok or T.Err })
		end
		local bottom = UI.row(container, 40)
		bottom.Position = UDim2.new(0, 0, 1, -40)
		UI.button(bottom, editingRig == "new" and "🔧 Montar PC" or "💾 Guardar cambios", function()
			local r = Net.call("PC.SaveRig", { rigId = editingRig ~= "new" and editingRig or nil, name = name, parts = draft })
			if r.ok then
				editingRig = nil
				render()
			end
		end, { Width = 180, Color = ok and T.Ok or T.Panel3 })
		UI.button(bottom, "◀ Volver", function()
			editingRig = nil
			render()
		end, { Width = 100 })
	end
	render()
	ctx.onState(function()
		if not editingRig then
			render()
		end
	end)
end
table.insert(apps, Builder)

---------------------------------------------------------------------------
-- BANCO
---------------------------------------------------------------------------
local Bank = { Id = "bank", Name = "Banco", Icon = "🏦", Order = 9, Surfaces = { pc = true, phone = true, panel = true }, Width = 820, Height = 560 }
function Bank.build(container, ctx)
	local tab = "account"
	local render
	render = function()
		UI.clear(container)
		local data = State.Data
		if not data then
			return
		end
		local bank = data.Bank
		local top = UI.row(container, 34)
		for _, t in ipairs({ { "account", "Cuenta" }, { "history", "Movimientos" }, { "report", "Informe mensual" }, { "loans", "Ahorro y préstamos" } }) do
			UI.button(top, t[2], function()
				tab = t[1]
				render()
			end, { Width = 150, Height = 28, Color = tab == t[1] and T.Accent or T.Panel3 })
		end
		local s = UI.scroll(container, { Size = UDim2.new(1, 0, 1, -40), Position = UDim2.fromOffset(0, 40), Pad = 6 })
		UI.label(s, "Banco Central Virtual · el dinero del juego no tiene relación con Robux.", { TextSize = 11, Color = T.Sub })
		if tab == "account" then
			UI.label(s, "Saldo disponible: $" .. Util.formatInt(data.Money), { Font = Enum.Font.GothamBlack, TextSize = 22, Color = T.Ok, Height = 30 })
			UI.label(s, "Ahorros: $" .. Util.formatInt(bank.Savings) .. " · Deuda de préstamo: $" .. Util.formatInt(bank.Loan), { TextSize = 14 })
			UI.label(s, "Este mes: ingresos $" .. Util.formatInt(data.Derived.MonthIncome) .. " · gastos $" .. Util.formatInt(data.Derived.MonthExpense), { TextSize = 14 })
			local h = data.Home
			UI.label(s, "🏠 Alquiler: $" .. h.Rent .. " cada 7 días jugados · próximo pago en " .. math.max(0, h.NextDue - h.PlayDays) .. " días · deuda $" .. h.Debt, { TextSize = 13, Color = h.Debt > 0 and T.Err or T.Sub })
			if h.Debt > 0 then
				UI.button(s, "Pagar deuda de alquiler ($" .. h.Debt .. ")", function()
					Net.call("Home.PayDebt", {})
				end, { Width = 260, Color = T.Accent })
			end
			UI.title(s, "🎯 Metas de ahorro")
			for i, g in ipairs(bank.Goals) do
				local card = UI.card(s, { Height = 0, Auto = Enum.AutomaticSize.Y })
				local have = data.Money + bank.Savings
				UI.label(card, g.Name .. " · $" .. Util.formatInt(math.min(have, g.Target)) .. " / $" .. Util.formatInt(g.Target), { TextSize = 13 })
				UI.progress(card, have / g.Target, T.Ok)
				UI.button(card, "Quitar", function()
					Net.call("Bank.SetGoal", { remove = i })
				end, { Width = 80, Height = 24, TextSize = 11 })
			end
			local row = UI.row(s, 36)
			local gn = UI.input(row, "Nueva meta (ej. Cámara pro)", "", { Size = UDim2.fromOffset(220, 30) })
			local gt = UI.input(row, "Cantidad", "", { Size = UDim2.fromOffset(100, 30) })
			UI.button(row, "Crear", function()
				Net.call("Bank.SetGoal", { name = gn.Text, target = tonumber(gt.Text) })
			end, { Width = 80, Height = 30 })
		elseif tab == "history" then
			for _, t in ipairs(data.Transactions) do
				local row = UI.row(s, 24)
				UI.label(row, os.date("%d/%m %H:%M", t.T), { Size = UDim2.fromOffset(90, 22), TextSize = 11, Color = T.Sub })
				UI.label(row, t.C .. " · " .. t.D, { Size = UDim2.new(1, -220, 1, 0), TextSize = 12 })
				UI.label(row, (t.A >= 0 and "+" or "") .. Util.formatInt(t.A), { Size = UDim2.fromOffset(110, 22), TextSize = 12, Color = t.A >= 0 and T.Ok or T.Err, Align = Enum.TextXAlignment.Right })
			end
		elseif tab == "report" then
			local keys = {}
			for k in pairs(data.Monthly) do
				keys[#keys + 1] = k
			end
			table.sort(keys, function(a, b)
				return tonumber(a:sub(2)) > tonumber(b:sub(2))
			end)
			for _, k in ipairs(keys) do
				local m = data.Monthly[k]
				local card = UI.card(s, { Height = 0, Auto = Enum.AutomaticSize.Y })
				local inc, exp = 0, 0
				for _, v in pairs(m.Inc) do
					inc = inc + v
				end
				for _, v in pairs(m.Exp) do
					exp = exp + v
				end
				UI.label(card, "Mes " .. k:sub(2) .. " · ingresos $" .. Util.formatInt(inc) .. " · gastos $" .. Util.formatInt(exp) .. " · balance " .. (inc - exp >= 0 and "+" or "") .. Util.formatInt(inc - exp), { Font = Enum.Font.GothamBold })
				local vals, labels = {}, {}
				for c, v in pairs(m.Exp) do
					vals[#vals + 1] = v
					labels[#labels + 1] = c:sub(1, 10)
				end
				if #vals > 0 then
					UI.label(card, "Gastos por categoría:", { TextSize = 12, Color = T.Sub })
					UI.bars(card, vals, labels, T.Err, { Height = 110 })
				end
				vals, labels = {}, {}
				for c, v in pairs(m.Inc) do
					vals[#vals + 1] = v
					labels[#labels + 1] = c:sub(1, 10)
				end
				if #vals > 0 then
					UI.label(card, "Ingresos por categoría:", { TextSize = 12, Color = T.Sub })
					UI.bars(card, vals, labels, T.Ok, { Height = 110 })
				end
			end
		elseif tab == "loans" then
			local row = UI.row(s, 36)
			local amt = UI.input(row, "Cantidad", "", { Size = UDim2.fromOffset(120, 30) })
			UI.button(row, "Depositar en ahorro", function()
				Net.call("Bank.Deposit", { amount = tonumber(amt.Text) })
			end, { Width = 160, Height = 30 })
			UI.button(row, "Retirar", function()
				Net.call("Bank.Withdraw", { amount = tonumber(amt.Text) })
			end, { Width = 90, Height = 30 })
			UI.label(s, "Los ahorros generan un 1% cada 7 días de juego (máx. $500 por semana).", { TextSize = 12, Color = T.Sub })
			UI.title(s, "💳 Préstamos (opcionales)")
			UI.label(s, "• Interés fijo del 10%: si pides $1.000 devuelves $1.100.\n• Se descuenta automáticamente el 10% de tus ingresos de vídeos y empleos hasta saldarlo.\n• Puedes pagar antes cuando quieras, sin penalización.\n• Límite actual: $" .. Util.formatInt(data.Derived.LoanLimit) .. " (sube con tu nivel).", { TextSize = 12, Height = 80, VAlign = Enum.TextYAlignment.Top })
			UI.label(s, "Deuda actual: $" .. Util.formatInt(bank.Loan), { Font = Enum.Font.GothamBold, Color = bank.Loan > 0 and T.Err or T.Ok })
			local row2 = UI.row(s, 36)
			local la = UI.input(row2, "Cantidad", "", { Size = UDim2.fromOffset(120, 30) })
			UI.button(row2, "Pedir préstamo", function()
				Notify.confirm("¿Pedir un préstamo de $" .. tostring(la.Text) .. "? Devolverás un 10% más.", function()
					Net.call("Bank.TakeLoan", { amount = tonumber(la.Text) })
				end)
			end, { Width = 140, Height = 30 })
			UI.button(row2, "Pagar", function()
				Net.call("Bank.RepayLoan", { amount = tonumber(la.Text) })
			end, { Width = 90, Height = 30 })
		end
	end
	render()
	ctx.onState(function()
		if tab == "history" or tab == "report" then
			render()
		end
	end)
end
table.insert(apps, Bank)

return apps
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000056"><Properties><string name="Name">ContentApps</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Apps de creación: Ideas y proyectos, Editor de vídeo, Miniaturas, ViewTube Studio y Estadísticas.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Client = script.Parent.Parent
local UI = require(Client.UIKit)
local Net = require(Client.Net)
local State = require(Client.State)
local Notify = require(Client.Notify)
local PhotoView = require(Client.PhotoView)
local VideoData = require(Shared.VideoData)
local WorldData = require(Shared.WorldData)
local Catalog = require(Shared.ItemCatalog)
local Util = require(Shared.Util)
local F = require(Shared.VideoFormulas)
local T = UI.Theme

local apps = {}

local function projectsList()
	local out = {}
	for pid, p in pairs(State.Data and State.Data.Projects or {}) do
		out[#out + 1] = p
	end
	table.sort(out, function(a, b)
		return a.Created > b.Created
	end)
	return out
end

local statusNames = { planning = "Planificando", recording = "Grabando", editing = "Editando", exported = "Exportado" }

local function catName(id)
	local c = VideoData.CategoryById[id]
	return c and c.Name or id
end

local function photoById(id)
	for _, ph in ipairs(State.Data and State.Data.Photos or {}) do
		if ph.Id == id then
			return ph
		end
	end
	return nil
end

---------------------------------------------------------------------------
-- Miniatura: dibujo del diseño (lo usan Miniaturas, Studio y Estadísticas)
---------------------------------------------------------------------------
local function drawThumb(parent, design, size)
	local box = UI.frame(parent, { Size = size or UDim2.fromOffset(320, 180), Color = UI.rgb(VideoData.Palette[design.bg or 2] or { 20, 20, 24 }), Clip = true, Radius = 6 })
	local photo = design.photoId and photoById(design.photoId) or (design.photoCam and { Cam = design.photoCam, Filter = design.photoFilter, SpotName = design.photoSpot, Hour = 12 }) or nil
	local tpl = design.template or "center"
	local photoSize, photoPos = UDim2.fromScale(1, 1), UDim2.new()
	if tpl == "left" then
		photoSize, photoPos = UDim2.fromScale(0.6, 1), UDim2.fromScale(0.4, 0)
	elseif tpl == "split" then
		photoSize = UDim2.fromScale(0.5, 1)
	end
	if photo then
		PhotoView.render(box, photo, photoSize).Position = photoPos
		if tpl == "split" then
			local second = PhotoView.render(box, photo, UDim2.fromScale(0.5, 1))
			second.Position = UDim2.fromScale(0.5, 0)
			local tint = UI.frame(second, { Size = UDim2.fromScale(1, 1), Color = Color3.fromRGB(255, 200, 0), Transparency = 0.75, Radius = false })
			tint.ZIndex = 5
		end
	end
	-- {x, y, ancho, alto} en escala
	local box4, align = { 0.05, 0.3, 0.9, 0.4 }, Enum.TextXAlignment.Center
	if tpl == "left" then
		box4, align = { 0.03, 0.1, 0.4, 0.8 }, Enum.TextXAlignment.Left
	elseif tpl == "top" then
		box4 = { 0.03, 0.03, 0.94, 0.3 }
	elseif tpl == "split" then
		box4 = { 0.03, 0.68, 0.94, 0.28 }
	elseif tpl == "corner" then
		box4, align = { 0.03, 0.62, 0.6, 0.34 }, Enum.TextXAlignment.Left
	end
	local s = design.textSize or 1
	local lbl = UI.label(box, design.text or "", { Size = UDim2.fromScale(box4[3], math.min(0.95, box4[4] * s)), Position = UDim2.fromScale(box4[1], box4[2]), Scaled = true, Align = align, Font = Enum.Font[design.font or "GothamBlack"] or Enum.Font.GothamBlack, Color = UI.rgb(VideoData.Palette[design.textColor or 1] or { 255, 255, 255 }) })
	lbl.ZIndex = 8
	if design.outline then
		lbl.TextStrokeTransparency = 0
		lbl.TextStrokeColor3 = Color3.new(0, 0, 0)
	end
	for i, st in ipairs(design.stickers or {}) do
		for _, def in ipairs(VideoData.Stickers) do
			if def.Id == st then
				local sl = UI.label(box, def.Glyph, { Size = UDim2.fromScale(0.16, 0.22), Position = UDim2.fromScale(0.82 - (i - 1) * 0.15, 0.04), Scaled = true, Font = Enum.Font.GothamBlack, Color = T.Gold, Align = Enum.TextXAlignment.Center })
				sl.ZIndex = 9
				sl.TextStrokeTransparency = 0
			end
		end
	end
	if design.frame and design.frame ~= "none" then
		local col = design.frame == "neon" and Color3.fromRGB(0, 255, 220) or Color3.new(1, 1, 1)
		UI.stroke(box, col, design.frame == "double" and 6 or 3)
	end
	return box
end
apps.drawThumb = drawThumb

---------------------------------------------------------------------------
-- IDEAS Y PROYECTOS
---------------------------------------------------------------------------
local Ideas = { Id = "ideas", Name = "Ideas", Icon = "💡", Order = 1, Surfaces = { pc = true, phone = true, panel = true }, Width = 820, Height = 540 }

function Ideas.build(container, ctx)
	local editing = nil
	local draft = nil
	local nameBox
	local function render()
		UI.clear(container)
		local data = State.Data
		if not data then
			return
		end
		local s = UI.scroll(container, { Pad = 8 })
		local hot = data.Derived.Trends.Hot or {}
		local hotNames = {}
		for _, id in ipairs(hot) do
			hotNames[#hotNames + 1] = catName(id)
		end
		UI.label(s, "🔥 Tendencias de hoy: " .. table.concat(hotNames, ", ") .. "   (vídeos de estas categorías llegan a más gente)", { Color = T.Gold, TextSize = 13, Height = 34 })
		if editing and data.Projects[editing] then
			local proj = data.Projects[editing]
			UI.title(s, "📝 Plan de «" .. proj.Name .. "» (" .. catName(proj.Category) .. ")")
			local plan = draft
			UI.cycle(s, "Estilo", VideoData.Styles, plan.Style, function(i)
				plan.Style = i
			end)
			local durNames, durIdx = {}, 1
			for i, d in ipairs(VideoData.Durations) do
				durNames[i] = d.Name
				if d.Id == plan.Duration then
					durIdx = i
				end
			end
			UI.cycle(s, "Duración objetivo", durNames, durIdx, function(i)
				plan.Duration = VideoData.Durations[i].Id
			end)
			UI.cycle(s, "Objetivo", VideoData.Goals, plan.Goal, function(i)
				plan.Goal = i
			end)
			UI.cycle(s, "Transporte", VideoData.Transport, plan.Transport, function(i)
				plan.Transport = i
			end)
			local times = { "Cualquiera", "Mañana", "Mediodía", "Hora dorada", "Noche" }
			UI.cycle(s, "Hora de grabación", times, math.max(1, Util.indexOf(times, plan.Time) or 1), function(i)
				plan.Time = times[i]
			end)
			UI.stepper(s, "Presupuesto", plan.Budget or 0, 0, 100000, 50, function(v)
				plan.Budget = v
			end, { Format = function(v)
				return "$" .. v
			end })
			-- Lugar: recomendados primero
			local cat = VideoData.CategoryById[proj.Category]
			local spots = { { Id = "", Name = "Sin definir" }, { Id = "home", Name = "Tu habitación" } }
			for _, sp in ipairs(WorldData.Spots) do
				if not sp.Secret and F.overlap(sp.Tags, cat.Tags) > 0 then
					spots[#spots + 1] = { Id = sp.Id, Name = "⭐ " .. sp.Name }
				end
			end
			for _, sp in ipairs(WorldData.Spots) do
				if not sp.Secret and F.overlap(sp.Tags, cat.Tags) == 0 then
					spots[#spots + 1] = { Id = sp.Id, Name = sp.Name }
				end
			end
			local names, idx = {}, 1
			for i, sp in ipairs(spots) do
				names[i] = sp.Name
				if sp.Id == plan.Location then
					idx = i
				end
			end
			UI.cycle(s, "Lugar (⭐ = encaja)", names, idx, function(i)
				plan.Location = spots[i].Id
			end, { ValueWidth = 260 })
			-- Productos a mostrar (de tu inventario)
			UI.label(s, "Productos del vídeo (para reseñas/comparativas, llévalos en la mochila):", { Color = T.Sub, TextSize = 13 })
			local prodRow = UI.frame(s, { Height = 0, Auto = Enum.AutomaticSize.Y, Transparency = 1, Radius = false })
			UI.grid(prodRow, 200, 30, 4)
			local seen = {}
			for _, it in ipairs(State.items(function(rec, def)
				return def.Cat ~= "component" and def.Cat ~= "storage" and def.Slot ~= "battery"
			end)) do
				if not seen[it.Def.Id] then
					seen[it.Def.Id] = true
					local on = Util.indexOf(plan.Featured, it.Def.Id) ~= nil
					local b
					b = UI.button(prodRow, (on and "✔ " or "") .. it.Def.Name, function()
						local i = Util.indexOf(plan.Featured, it.Def.Id)
						if i then
							table.remove(plan.Featured, i)
						elseif #plan.Featured < 4 then
							table.insert(plan.Featured, it.Def.Id)
						end
						render()
					end, { Size = UDim2.fromOffset(200, 30), TextSize = 11, Color = on and T.Ok or T.Panel3 })
				end
			end
			local row = UI.row(s, 38)
			UI.button(row, "💾 Guardar plan", function()
				Net.call("Video.UpdatePlan", { pid = editing, plan = draft })
			end, { Color = T.Ok, Width = 150 })
			if plan.Location ~= "" and plan.Location ~= "home" then
				UI.button(row, "🚕 Taxi al lugar", function()
					Net.call("Travel.TaxiSpot", { spot = plan.Location })
				end, { Width = 150 })
			end
			UI.button(row, "◀ Volver", function()
				editing = nil
				render()
			end, { Width = 110 })
			-- Lista de comprobación de la mochila
			local bag = {}
			for _, it in ipairs(State.items(function(rec)
				return rec.Loc == "backpack"
			end)) do
				bag[#bag + 1] = it.Def.Name
			end
			UI.label(s, "🎒 En tu mochila: " .. (#bag > 0 and table.concat(bag, ", ") or "nada (prepárala en casa con el Inventario)"), { Color = T.Sub, TextSize = 13, Height = 40 })
			return
		end
		UI.title(s, "💡 Nueva idea")
		nameBox = UI.input(s, "Nombre del proyecto (opcional)", "")
		local grid = UI.frame(s, { Height = 0, Auto = Enum.AutomaticSize.Y, Transparency = 1, Radius = false })
		UI.grid(grid, ctx.kind == "phone" and 128 or 150, 34, 6)
		for _, c in ipairs(VideoData.Categories) do
			local isHot = Util.indexOf(hot, c.Id) ~= nil
			UI.button(grid, (isHot and "🔥 " or "") .. c.Name, function()
				local r = Net.call("Video.CreateProject", { category = c.Id, name = nameBox.Text })
				if r.ok then
					nameBox.Text = ""
				end
			end, { Size = UDim2.fromOffset(150, 34), TextSize = 12, Color = isHot and Color3.fromRGB(120, 40, 50) or T.Panel3 })
		end
		local projects = projectsList()
		UI.title(s, "📁 Tus proyectos (" .. #projects .. ")")
		if #projects == 0 then
			UI.label(s, "Aún no tienes proyectos. Elige una idea arriba.", { Color = T.Sub })
		end
		for _, p in ipairs(projects) do
			local card = UI.card(s, { Height = 0, Auto = Enum.AutomaticSize.Y })
			UI.label(card, p.Name .. "  ·  " .. catName(p.Category), { Font = Enum.Font.GothamBold })
			local imported = 0
			for _, sc in ipairs(p.Scenes) do
				if sc.Imp then
					imported = imported + 1
				end
			end
			local loc = p.Plan.Location ~= "" and (p.Plan.Location == "home" and "Tu habitación" or (WorldData.SpotById[p.Plan.Location] and WorldData.SpotById[p.Plan.Location].Name or "?")) or "sin lugar"
			UI.label(card, (statusNames[p.Status] or p.Status) .. " · " .. #p.Scenes .. " escenas (" .. imported .. " importadas) · " .. loc, { Color = T.Sub, TextSize = 12 })
			local row = UI.row(card, 32)
			UI.button(row, "📝 Planificar", function()
				editing = p.Id
				draft = Util.deepCopy(p.Plan)
				render()
			end, { Width = 120, Height = 28, TextSize = 12 })
			UI.button(row, "⧉ Duplicar", function()
				Net.call("Video.DuplicateProject", { pid = p.Id })
			end, { Width = 100, Height = 28, TextSize = 12 })
			UI.button(row, "🗑 Eliminar", function()
				Notify.confirm("¿Eliminar «" .. p.Name .. "» y todas sus escenas? No se puede deshacer.", function()
					Net.call("Video.DeleteProject", { pid = p.Id })
				end, "Eliminar")
			end, { Width = 100, Height = 28, TextSize = 12, Color = Color3.fromRGB(110, 40, 40) })
		end
	end
	render()
	ctx.onState(function()
		if not editing then
			render()
		end
	end)
end
table.insert(apps, Ideas)

---------------------------------------------------------------------------
-- EDITOR DE VÍDEO
---------------------------------------------------------------------------
local Editor = { Id = "editor", Name = "Editor", Icon = "🎞", Order = 2, Surfaces = { pc = true, phone = true, panel = false }, Width = 960, Height = 580 }

local function entryInfo(proj, e)
	if e.k == "s" then
		for _, sc in ipairs(proj.Scenes) do
			if sc.Id == e.id then
				local shot = VideoData.ShotById[sc.Shot]
				return (shot and shot.Name or sc.Shot), sc.SpotName, sc.Q, sc.Sec, sc
			end
		end
	else
		local ph = photoById(e.id)
		if ph then
			return "Foto", ph.SpotName, ph.Q, 4, ph
		end
	end
	return "?", "", 0, 0
end

function Editor.build(container, ctx)
	local pid, draft, dirty, lastEval = nil, nil, false, nil
	local transIds = {}
	for _, t in ipairs(VideoData.Transitions) do
		transIds[#transIds + 1] = t.Id
	end

	local function loadProject(id)
		pid = id
		local proj = State.Data.Projects[id]
		draft = proj and Util.deepCopy(proj.Edit) or nil
		dirty = false
		lastEval = nil
	end

	local render
	local function preview(proj)
		local overlay = UI.frame(container, { Size = UDim2.fromScale(1, 1), Color = Color3.new(0, 0, 0), Radius = false })
		overlay.ZIndex = 20
		local screen = UI.frame(overlay, { Size = UDim2.new(0.8, 0, 0.75, 0), Position = UDim2.fromScale(0.5, 0.45), Anchor = Vector2.new(0.5, 0.5), Color = T.Bg, Clip = true })
		local info = UI.label(overlay, "", { Size = UDim2.new(1, -20, 0, 24), Position = UDim2.new(0, 10, 1, -64), Align = Enum.TextXAlignment.Center })
		local bar, fill = UI.progress(overlay, 0, T.Accent, { Size = UDim2.new(0.8, 0, 0, 8) })
		bar.Position = UDim2.new(0.1, 0, 1, -30)
		UI.button(overlay, "✕ Cerrar vista previa", function()
			overlay:Destroy()
		end, { Position = UDim2.new(1, -10, 0, 10), Anchor = Vector2.new(1, 0), Width = 180, Color = T.Accent })
		local music = VideoData.MusicById[draft.Music]
		task.spawn(function()
			local total = #draft.Timeline
			for i, e in ipairs(draft.Timeline) do
				if not overlay.Parent then
					return
				end
				UI.clear(screen)
				local name, spot, q, sec, obj = entryInfo(proj, e)
				if e.k == "p" then
					PhotoView.render(screen, obj)
				else
					local hue = (Util.hashString(spot or "") % 360) / 360
					local bg = UI.frame(screen, { Size = UDim2.fromScale(1, 1), Color = Color3.fromHSV(hue, 0.5, 0.45), Radius = false })
					UI.label(bg, "🎬 " .. name .. "\n📍 " .. tostring(spot), { Size = UDim2.fromScale(1, 1), Align = Enum.TextXAlignment.Center, Font = Enum.Font.GothamBlack, TextSize = 26 })
				end
				local c = draft.Color
				if c.b ~= 0 or c.s ~= 0 then
					local ov = UI.frame(screen, { Size = UDim2.fromScale(1, 1), Color = c.b > 0 and Color3.new(1, 1, 1) or Color3.new(0, 0, 0), Transparency = 1 - math.min(0.4, math.abs(c.b) / 200), Radius = false })
					ov.ZIndex = 5
				end
				if i == 1 and draft.Titles and draft.TitleText ~= "" then
					local tl = UI.label(screen, draft.TitleText, { Size = UDim2.new(1, 0, 0.2, 0), Position = UDim2.fromScale(0, 0.05), Scaled = true, Font = Enum.Font.GothamBlack, Align = Enum.TextXAlignment.Center })
					tl.ZIndex = 6
					tl.TextStrokeTransparency = 0
				end
				if draft.Subtitles then
					local sub = UI.label(screen, "[Subtítulos] " .. name .. " en " .. tostring(spot), { Size = UDim2.new(1, 0, 0.1, 0), Position = UDim2.fromScale(0, 0.86), Align = Enum.TextXAlignment.Center, TextSize = 16 })
					sub.ZIndex = 6
					sub.BackgroundTransparency = 0.4
					sub.BackgroundColor3 = Color3.new(0, 0, 0)
				end
				info.Text = string.format("%d/%d · %s · transición: %s · música: %s", i, total, name, e.tr, music and music.Name or "ninguna")
				fill.Size = UDim2.new(i / total, 0, 1, 0)
				if e.tr ~= "cut" then
					screen.BackgroundTransparency = 1
					UI.tween(screen, { BackgroundTransparency = 0 }, 0.3)
				end
				task.wait(math.clamp((sec or 4) * (e.trim or 1) / 12, 0.8, 3))
			end
			info.Text = "Fin de la vista previa"
		end)
	end

	render = function()
		UI.clear(container)
		local data = State.Data
		if not data then
			return
		end
		local session = ctx.session()
		local projects = projectsList()
		if #projects == 0 then
			UI.label(container, "No tienes proyectos. Crea uno en la app Ideas y graba escenas.", { Color = T.Sub, Height = 40 })
			return
		end
		if not pid or not data.Projects[pid] then
			loadProject(projects[1].Id)
		end
		local proj = data.Projects[pid]
		local maxClips = session and session.MaxScenes or 8
		-- Barra superior
		local top = UI.row(container, 36)
		local names, idx = {}, 1
		for i, p in ipairs(projects) do
			names[i] = p.Name
			if p.Id == pid then
				idx = i
			end
		end
		UI.cycle(top, "Proyecto", names, idx, function(i)
			if dirty then
				Notify.toast("Cambios sin guardar descartados.", "warn")
			end
			loadProject(projects[i].Id)
			render()
		end, { LabelWidth = 70, ValueWidth = 170 })
		local notImported = 0
		for _, sc in ipairs(proj.Scenes) do
			if not sc.Imp then
				notImported = notImported + 1
			end
		end
		UI.button(top, "⤓ Importar (" .. notImported .. ")", function()
			Net.call("Video.Import", { pid = pid })
		end, { Width = 120, Height = 30, TextSize = 12, Color = notImported > 0 and T.Accent2 or T.Panel3 })
		UI.button(top, "💾 Guardar" .. (dirty and " *" or ""), function()
			local r = Net.call("Video.SaveEdit", { pid = pid, edit = draft })
			if r.ok then
				dirty = false
				lastEval = r.data.eval
				render()
			end
		end, { Width = 100, Height = 30, TextSize = 12, Color = T.Ok })
		UI.button(top, "▶ Vista previa", function()
			if #draft.Timeline > 0 then
				preview(proj)
			end
		end, { Width = 110, Height = 30, TextSize = 12 })
		UI.button(top, "⧉ Versión", function()
			Net.call("Video.SaveVersion", { pid = pid })
		end, { Width = 90, Height = 30, TextSize = 12 })
		local exportBtn = UI.button(top, "⬆ Exportar", function()
			if dirty then
				Notify.toast("Guarda los cambios antes de exportar.", "warn")
				return
			end
			Net.call("Video.Export", { pid = pid })
		end, { Width = 100, Height = 30, TextSize = 12, Color = T.Accent })
		-- Progreso de exportación
		if proj.Export and proj.Export.ReadyAt then
			local prow = UI.row(container, 22)
			local bar, fill = UI.progress(prow, 0, T.Accent, { Size = UDim2.new(0.6, 0, 0, 10) })
			local lbl = UI.label(prow, "", { Size = UDim2.new(0.38, 0, 1, 0), TextSize = 12 })
			task.spawn(function()
				while lbl.Parent do
					local now = workspace:GetServerTimeNow()
					local total = math.max(1, proj.Export.Secs or 1)
					local remaining = proj.Export.ReadyAt - now
					fill.Size = UDim2.new(math.clamp(1 - remaining / total, 0, 1), 0, 1, 0)
					if remaining <= 0 then
						lbl.Text = "✅ Exportado (calidad " .. math.floor(proj.Export.Res.Final) .. "). Publícalo en ViewTube Studio."
						break
					end
					lbl.Text = "Exportando... " .. math.ceil(remaining) .. " s"
					task.wait(0.25)
				end
			end)
		end
		-- Cuerpo: biblioteca | línea de tiempo | ajustes
		local body = UI.frame(container, { Size = UDim2.new(1, 0, 1, -(proj.Export and 90 or 66)), Position = UDim2.fromOffset(0, proj.Export and 64 or 42), Transparency = 1, Radius = false })
		local narrow = ctx.kind == "phone"
		local lib = UI.scroll(body, { Size = narrow and UDim2.new(1, 0, 0.3, 0) or UDim2.new(0.26, -6, 1, 0), Color = T.Panel2, Transparency = 0 })
		UI.label(lib, "📚 Biblioteca de clips", { Font = Enum.Font.GothamBold })
		for _, sc in ipairs(proj.Scenes) do
			local shot = VideoData.ShotById[sc.Shot]
			local card = UI.card(lib, { Height = 0, Auto = Enum.AutomaticSize.Y, Color = T.Panel3 })
			UI.label(card, (shot and shot.Name or sc.Shot) .. " · Q" .. math.floor(sc.Q), { Font = Enum.Font.GothamBold, TextSize = 12 })
			UI.label(card, "📍 " .. sc.SpotName .. " · " .. sc.Dev .. (sc.Feat and (" · 📦 " .. (Catalog.get(sc.Feat) and Catalog.get(sc.Feat).Name or "")) or ""), { TextSize = 11, Color = T.Sub, Height = 28 })
			if #sc.Probs > 0 then
				UI.label(card, "⚠ " .. table.concat(sc.Probs, ", "), { TextSize = 11, Color = T.Warn })
			end
			local row = UI.row(card, 26)
			if sc.Imp then
				UI.button(row, "+ Añadir", function()
					if #draft.Timeline >= maxClips then
						Notify.toast("Tu equipo admite " .. maxClips .. " clips. Mejora el computador.", "warn")
						return
					end
					table.insert(draft.Timeline, { k = "s", id = sc.Id, trim = 1, tr = "cut" })
					dirty = true
					render()
				end, { Width = 80, Height = 24, TextSize = 11, Color = T.Accent2 })
			else
				UI.label(row, "Sin importar", { Size = UDim2.fromOffset(80, 24), TextSize = 11, Color = T.Warn })
			end
			UI.button(row, "🗑", function()
				Notify.confirm("¿Borrar esta escena del proyecto?", function()
					Net.call("Video.DeleteScene", { pid = pid, sceneId = sc.Id })
				end)
			end, { Width = 30, Height = 24, TextSize = 11 })
		end
		UI.label(lib, "🖼 Fotos del álbum", { Font = Enum.Font.GothamBold })
		for i, ph in ipairs(data.Photos) do
			if i <= 20 then
				local row = UI.row(lib, 26)
				UI.label(row, ph.SpotName .. " Q" .. math.floor(ph.Q), { Size = UDim2.new(1, -60, 1, 0), TextSize = 11 })
				UI.button(row, "+", function()
					if #draft.Timeline >= maxClips then
						return
					end
					table.insert(draft.Timeline, { k = "p", id = ph.Id, trim = 1, tr = "cut" })
					dirty = true
					render()
				end, { Width = 40, Height = 24, TextSize = 12 })
			end
		end
		-- Línea de tiempo
		local tlFrame = UI.frame(body, { Size = narrow and UDim2.new(1, 0, 0.3, 0) or UDim2.new(0.44, -6, 1, 0), Position = narrow and UDim2.fromScale(0, 0.32) or UDim2.new(0.26, 0, 0, 0), Color = T.Bg })
		UI.padding(tlFrame, 6)
		UI.label(tlFrame, "🎬 Línea de tiempo · " .. #draft.Timeline .. "/" .. maxClips .. " clips · pista de vídeo + pista de audio (" .. ((VideoData.MusicById[draft.Music] or {}).Name or "-") .. ")", { TextSize = 12, Font = Enum.Font.GothamBold, Height = 20 })
		local tl = UI.scroll(tlFrame, { Size = UDim2.new(1, 0, 1, -24), Position = UDim2.fromOffset(0, 24), Pad = 4 })
		local totalSec = 0
		for i, e in ipairs(draft.Timeline) do
			local name, spot, q, sec = entryInfo(proj, e)
			totalSec = totalSec + (sec or 0) * e.trim
			local card = UI.card(tl, { Height = 0, Auto = Enum.AutomaticSize.Y, Color = e.k == "p" and Color3.fromRGB(50, 45, 80) or T.Panel2 })
			UI.label(card, i .. ". " .. name .. " · " .. tostring(spot) .. " · Q" .. math.floor(q or 0), { TextSize = 12, Font = Enum.Font.GothamBold })
			local row = UI.row(card, 26, nil, 3)
			UI.button(row, "▲", function()
				if i > 1 then
					draft.Timeline[i], draft.Timeline[i - 1] = draft.Timeline[i - 1], draft.Timeline[i]
					dirty = true
					render()
				end
			end, { Width = 26, Height = 24, TextSize = 11 })
			UI.button(row, "▼", function()
				if i < #draft.Timeline then
					draft.Timeline[i], draft.Timeline[i + 1] = draft.Timeline[i + 1], draft.Timeline[i]
					dirty = true
					render()
				end
			end, { Width = 26, Height = 24, TextSize = 11 })
			UI.button(row, "✂−", function()
				e.trim = math.max(0.3, math.floor((e.trim - 0.1) * 10 + 0.5) / 10)
				dirty = true
				render()
			end, { Width = 32, Height = 24, TextSize = 11 })
			UI.label(row, math.floor(e.trim * 100) .. "%", { Size = UDim2.fromOffset(38, 24), TextSize = 11, Align = Enum.TextXAlignment.Center })
			UI.button(row, "✂+", function()
				e.trim = math.min(1, math.floor((e.trim + 0.1) * 10 + 0.5) / 10)
				dirty = true
				render()
			end, { Width = 32, Height = 24, TextSize = 11 })
			if i > 1 then
				UI.button(row, "⇄ " .. e.tr, function()
					local j = (Util.indexOf(transIds, e.tr) or 1) % #transIds + 1
					e.tr = transIds[j]
					dirty = true
					render()
				end, { Width = 80, Height = 24, TextSize = 11 })
			end
			UI.button(row, "✕", function()
				table.remove(draft.Timeline, i)
				dirty = true
				render()
			end, { Width = 26, Height = 24, TextSize = 11, Color = Color3.fromRGB(110, 40, 40) })
		end
		local durTarget = 120
		for _, d in ipairs(VideoData.Durations) do
			if d.Id == proj.Plan.Duration then
				durTarget = d.Seconds
			end
		end
		UI.label(tl, "Duración: " .. math.floor(totalSec) .. " s (objetivo " .. durTarget .. " s)", { TextSize = 12, Color = T.Sub })
		-- Ajustes
		local set = UI.scroll(body, { Size = narrow and UDim2.new(1, 0, 0.36, 0) or UDim2.new(0.3, 0, 1, 0), Position = narrow and UDim2.fromScale(0, 0.64) or UDim2.new(0.7, 0, 0, 0), Color = T.Panel2, Transparency = 0 })
		local function mark()
			dirty = true
		end
		UI.toggle(set, "Títulos", draft.Titles, function(v)
			draft.Titles = v
			mark()
		end)
		local tbox = UI.input(set, "Texto del título", draft.TitleText)
		tbox.FocusLost:Connect(function()
			draft.TitleText = tbox.Text
			mark()
		end)
		UI.toggle(set, "Subtítulos", draft.Subtitles, function(v)
			draft.Subtitles = v
			mark()
		end)
		local musicNames, mIdx = {}, 1
		for i, m in ipairs(VideoData.Music) do
			musicNames[i] = m.Name .. (m.Mood ~= "Neutral" and (" (" .. m.Mood .. ")") or "")
			if m.Id == draft.Music then
				mIdx = i
			end
		end
		UI.cycle(set, "Música", musicNames, mIdx, function(i)
			draft.Music = VideoData.Music[i].Id
			mark()
		end, { LabelWidth = 60, ValueWidth = 150 })
		UI.stepper(set, "Vol. música", draft.MusicVol, 0, 1, 0.05, function(v)
			draft.MusicVol = v
			mark()
		end, { LabelWidth = 90 })
		UI.stepper(set, "Vol. voz", draft.VoiceVol, 0, 1, 0.05, function(v)
			draft.VoiceVol = v
			mark()
		end, { LabelWidth = 90 })
		UI.label(set, "Efectos:", { Color = T.Sub, TextSize = 12 })
		for _, fx in ipairs(VideoData.Effects) do
			UI.toggle(set, fx.Name, Util.indexOf(draft.Effects, fx.Id) ~= nil, function(v)
				local i = Util.indexOf(draft.Effects, fx.Id)
				if v and not i then
					table.insert(draft.Effects, fx.Id)
				elseif not v and i then
					table.remove(draft.Effects, i)
				end
				mark()
			end, { Width = 200 })
		end
		UI.stepper(set, "Brillo", draft.Color.b, -100, 100, 5, function(v)
			draft.Color.b = v
			mark()
		end, { LabelWidth = 90 })
		UI.stepper(set, "Contraste", draft.Color.c, -100, 100, 5, function(v)
			draft.Color.c = v
			mark()
		end, { LabelWidth = 90 })
		UI.stepper(set, "Saturación", draft.Color.s, -100, 100, 5, function(v)
			draft.Color.s = v
			mark()
		end, { LabelWidth = 90 })
		local function idsNames(list)
			local n, ids = {}, {}
			for i, it in ipairs(list) do
				n[i] = it.Name
				ids[i] = it.Id
			end
			return n, ids
		end
		local iN, iIds = idsNames(VideoData.Intros)
		UI.cycle(set, "Intro", iN, Util.indexOf(iIds, draft.Intro) or 1, function(i)
			draft.Intro = iIds[i]
			mark()
		end, { LabelWidth = 50, ValueWidth = 160 })
		local oN, oIds = idsNames(VideoData.Outros)
		UI.cycle(set, "Cierre", oN, Util.indexOf(oIds, draft.Outro) or 1, function(i)
			draft.Outro = oIds[i]
			mark()
		end, { LabelWidth = 50, ValueWidth = 160 })
		if lastEval then
			local card = UI.card(set, { Height = 0, Auto = Enum.AutomaticSize.Y, Color = T.Panel3 })
			UI.label(card, "📊 Calidad estimada: " .. math.floor(lastEval.Final) .. "/100", { Font = Enum.Font.GothamBold })
			UI.label(card, "Material " .. math.floor(lastEval.Footage) .. " · Edición " .. math.floor(lastEval.EditQuality), { TextSize = 12, Color = T.Sub })
			for _, d in ipairs(lastEval.Details or {}) do
				UI.label(card, "• " .. d, { TextSize = 11, Color = T.Sub })
			end
		end
		if #proj.Versions > 0 then
			UI.label(set, "Versiones guardadas:", { Color = T.Sub, TextSize = 12 })
			for i, v in ipairs(proj.Versions) do
				UI.button(set, "↺ " .. v.Label, function()
					Net.call("Video.RestoreVersion", { pid = pid, index = i })
				end, { Size = UDim2.new(1, -8, 0, 26), TextSize = 11 })
			end
		end
	end
	render()
	ctx.onState(function()
		local data = State.Data
		if pid and data and data.Projects[pid] then
			local srv = data.Projects[pid]
			if not dirty then
				draft = Util.deepCopy(srv.Edit)
			end
		end
		render()
	end)
end
table.insert(apps, Editor)

---------------------------------------------------------------------------
-- MINIATURAS
---------------------------------------------------------------------------
local Thumbs = { Id = "thumbs", Name = "Miniaturas", Icon = "🖼", Order = 3, Surfaces = { pc = true, phone = true, panel = false }, Width = 900, Height = 560 }

function Thumbs.build(container, ctx)
	local design = { text = "", font = "GothamBlack", textColor = 1, bg = 2, outline = true, frame = "none", template = "left", stickers = {}, photoId = nil, textSize = 1 }
	if ctx.params.photoId then
		design.photoId = ctx.params.photoId
	end
	local linkPid = nil
	local lastScore = nil
	local render
	render = function()
		UI.clear(container)
		local data = State.Data
		if not data then
			return
		end
		local narrow = ctx.kind == "phone"
		local left = UI.frame(container, { Size = narrow and UDim2.new(1, 0, 0, 200) or UDim2.new(0.5, -6, 1, 0), Transparency = 1, Radius = false })
		drawThumb(left, design, narrow and UDim2.fromOffset(290, 163) or UDim2.fromOffset(420, 236))
		if lastScore then
			local sc = UI.card(left, { Height = 0, Auto = Enum.AutomaticSize.Y })
			sc.Position = UDim2.fromOffset(0, 246)
			sc.Size = UDim2.new(1, 0, 0, 0)
			UI.label(sc, "⭐ Puntuación " .. math.floor(lastScore.Score) .. "/100", { Font = Enum.Font.GothamBold })
			UI.label(sc, "Legibilidad " .. math.floor(lastScore.Readability) .. " · Composición " .. math.floor(lastScore.Composition) .. " · Relevancia " .. math.floor(lastScore.Relevance), { TextSize = 12, Color = T.Sub })
			for _, d in ipairs(lastScore.Details or {}) do
				UI.label(sc, "• " .. d, { TextSize = 12, Color = T.Warn })
			end
			UI.label(sc, "Una buena miniatura mejora la tasa de clics, pero no garantiza visitas.", { TextSize = 11, Color = T.Sub })
		end
		local right = UI.scroll(container, { Size = narrow and UDim2.new(1, 0, 1, -210) or UDim2.new(0.5, 0, 1, 0), Position = narrow and UDim2.fromOffset(0, 210) or UDim2.fromScale(0.5, 0), Color = T.Panel2, Transparency = 0 })
		local tbox = UI.input(right, "Texto (corto y legible)", design.text)
		tbox.FocusLost:Connect(function()
			design.text = tbox.Text
			render()
		end)
		local fonts = {}
		for i, f in ipairs(VideoData.Fonts) do
			fonts[i] = f.Id
		end
		UI.cycle(right, "Tipografía", fonts, Util.indexOf(fonts, design.font) or 1, function(i)
			design.font = fonts[i]
			render()
		end)
		local tplNames, tplIds = {}, {}
		for i, t in ipairs(VideoData.ThumbTemplates) do
			tplNames[i] = t.Name
			tplIds[i] = t.Id
		end
		UI.cycle(right, "Plantilla", tplNames, Util.indexOf(tplIds, design.template) or 1, function(i)
			design.template = tplIds[i]
			render()
		end)
		UI.stepper(right, "Tamaño texto", design.textSize, 0.5, 1.5, 0.1, function(v)
			design.textSize = v
			render()
		end)
		local function palette(label, key)
			UI.label(right, label, { Color = T.Sub, TextSize = 12 })
			local row = UI.frame(right, { Height = 30, Transparency = 1, Radius = false })
			UI.list(row, Enum.FillDirection.Horizontal, 4)
			for i, c in ipairs(VideoData.Palette) do
				local b = UI.button(row, design[key] == i and "●" or "", function()
					design[key] = i
					render()
				end, { Width = 26, Height = 26, Color = UI.rgb(c), TextColor = Color3.new(0.5, 0.5, 0.5) })
			end
		end
		palette("Color del texto", "textColor")
		palette("Color de fondo", "bg")
		UI.toggle(right, "Contorno del texto", design.outline, function(v)
			design.outline = v
			render()
		end)
		local frameNames, frameIds = {}, {}
		for i, f in ipairs(VideoData.Frames) do
			frameNames[i] = f.Name
			frameIds[i] = f.Id
		end
		UI.cycle(right, "Marco", frameNames, Util.indexOf(frameIds, design.frame) or 1, function(i)
			design.frame = frameIds[i]
			render()
		end)
		UI.label(right, "Elementos decorativos (1-2 es lo ideal):", { Color = T.Sub, TextSize = 12 })
		local st = UI.frame(right, { Height = 0, Auto = Enum.AutomaticSize.Y, Transparency = 1, Radius = false })
		UI.grid(st, 96, 28, 4)
		for _, sdef in ipairs(VideoData.Stickers) do
			local on = Util.indexOf(design.stickers, sdef.Id) ~= nil
			UI.button(st, sdef.Glyph .. " " .. sdef.Name, function()
				local i = Util.indexOf(design.stickers, sdef.Id)
				if i then
					table.remove(design.stickers, i)
				else
					table.insert(design.stickers, sdef.Id)
				end
				render()
			end, { Size = UDim2.fromOffset(96, 28), TextSize = 11, Color = on and T.Ok or T.Panel3 })
		end
		UI.label(right, "Fotografía:", { Color = T.Sub, TextSize = 12 })
		UI.button(right, (design.photoId == nil and "● " or "") .. "Sin foto", function()
			design.photoId = nil
			render()
		end, { Size = UDim2.new(1, -8, 0, 26), TextSize = 12 })
		for i, ph in ipairs(data.Photos) do
			if i <= 25 then
				local mode = VideoData.PhotoModeById[ph.Mode]
				UI.button(right, (design.photoId == ph.Id and "● " or "") .. ph.SpotName .. " · " .. (mode and mode.Name or "") .. " · Q" .. math.floor(ph.Q), function()
					design.photoId = ph.Id
					render()
				end, { Size = UDim2.new(1, -8, 0, 26), TextSize = 11, Color = design.photoId == ph.Id and T.Accent2 or T.Panel3 })
			end
		end
		local projects = projectsList()
		local pNames, pIds = { "Sin proyecto" }, { false }
		for _, p in ipairs(projects) do
			pNames[#pNames + 1] = p.Name
			pIds[#pIds + 1] = p.Id
		end
		UI.cycle(right, "Para el proyecto", pNames, Util.indexOf(pIds, linkPid or false) or 1, function(i)
			linkPid = pIds[i] or nil
		end, { ValueWidth = 200 })
		UI.button(right, "💾 Guardar miniatura", function()
			local r = Net.call("Thumb.Save", { design = design, pid = linkPid })
			if r.ok then
				lastScore = r.data.score
				render()
			end
		end, { Size = UDim2.new(1, -8, 0, 36), Color = T.Ok })
		UI.label(right, "Diseños guardados:", { Font = Enum.Font.GothamBold })
		local saved = {}
		for _, t in pairs(data.Thumbnails) do
			saved[#saved + 1] = t
		end
		table.sort(saved, function(a, b)
			return a.T > b.T
		end)
		for _, t in ipairs(saved) do
			local row = UI.row(right, 28)
			UI.label(row, "«" .. (t.Design.text ~= "" and t.Design.text or "(sin texto)") .. "» ⭐" .. math.floor(t.Score), { Size = UDim2.new(1, -130, 1, 0), TextSize = 12 })
			UI.button(row, "Editar", function()
				design = Util.deepCopy(t.Design)
				render()
			end, { Width = 60, Height = 24, TextSize = 11 })
			UI.button(row, "🗑", function()
				Net.call("Thumb.Delete", { id = t.Id })
			end, { Width = 30, Height = 24, TextSize = 11 })
		end
	end
	render()
	ctx.onState(function() end)
end
table.insert(apps, Thumbs)

---------------------------------------------------------------------------
-- VIEWTUBE STUDIO (canal + publicación)
---------------------------------------------------------------------------
local Studio = { Id = "studio", Name = "ViewTube Studio", Icon = "▶️", Order = 0, Surfaces = { pc = true, phone = true, panel = false }, Width = 900, Height = 580 }

function Studio.build(container, ctx)
	local publishing = nil
	local form = {}
	local editingChannel = false
	local render
	render = function()
		UI.clear(container)
		local data = State.Data
		if not data then
			return
		end
		local ch = data.Channel
		local s = UI.scroll(container, { Pad = 8 })
		-- Cabecera del canal
		local banner = VideoData.Banners[ch.Banner] or VideoData.Banners[1]
		local head = UI.frame(s, { Height = 110, Color = UI.rgb(banner[1]) })
		UI.new("UIGradient", { Color = ColorSequence.new(UI.rgb(banner[1]), UI.rgb(banner[2])), Parent = head })
		UI.label(head, VideoData.Avatars[ch.Avatar] or "🎬", { Size = UDim2.fromOffset(80, 80), Position = UDim2.fromOffset(14, 15), TextSize = 56, Align = Enum.TextXAlignment.Center })
		UI.label(head, ch.Name ~= "" and ch.Name or "Tu canal (sin nombre)", { Size = UDim2.new(1, -120, 0, 34), Position = UDim2.fromOffset(104, 14), Font = Enum.Font.GothamBlack, TextSize = 24 })
		UI.label(head, Util.formatInt(ch.Subs) .. " suscriptores · " .. Util.formatInt(ch.TotalViews) .. " visitas · $" .. Util.formatInt(ch.TotalRevenue) .. " ganados", { Size = UDim2.new(1, -120, 0, 22), Position = UDim2.fromOffset(104, 50), TextSize = 14 })
		UI.label(head, ch.Monetized and "✅ Socio del programa de creadores" or ("Programa de socios: " .. ch.Subs .. "/100 suscriptores y " .. (data.Counters.published or 0) .. "/3 vídeos"), { Size = UDim2.new(1, -120, 0, 20), Position = UDim2.fromOffset(104, 74), TextSize = 12, Color = ch.Monetized and T.Ok or Color3.fromRGB(230, 230, 230) })
		if editingChannel then
			local card = UI.card(s, { Height = 0, Auto = Enum.AutomaticSize.Y })
			local nb = UI.input(card, "Nombre del canal", ch.Name)
			local db = UI.input(card, "Descripción", ch.Description, { Height = 60, Multi = true })
			local bIdx, aIdx = ch.Banner, ch.Avatar
			local bannerNames = {}
			for i = 1, #VideoData.Banners do
				bannerNames[i] = "Banner " .. i
			end
			UI.cycle(card, "Banner", bannerNames, bIdx, function(i)
				bIdx = i
			end)
			UI.cycle(card, "Foto de perfil", VideoData.Avatars, aIdx, function(i)
				aIdx = i
			end)
			local row = UI.row(card, 34)
			UI.button(row, "💾 Guardar canal", function()
				local r = Net.call("Channel.Update", { name = nb.Text, description = db.Text, banner = bIdx, avatar = aIdx })
				if r.ok then
					editingChannel = false
					render()
				end
			end, { Width = 150, Color = T.Ok })
			UI.button(row, "Cancelar", function()
				editingChannel = false
				render()
			end, { Width = 100 })
		else
			UI.button(s, "✏ Personalizar canal", function()
				editingChannel = true
				render()
			end, { Width = 180 })
		end
		-- Publicación
		UI.title(s, "⬆ Listos para publicar")
		local ready = 0
		for _, p in ipairs(projectsList()) do
			if p.Export and p.Export.ReadyAt then
				ready = ready + 1
				local done = workspace:GetServerTimeNow() >= p.Export.ReadyAt
				local card = UI.card(s, { Height = 0, Auto = Enum.AutomaticSize.Y })
				UI.label(card, p.Name .. " · " .. catName(p.Category) .. " · calidad " .. math.floor(p.Export.Res.Final) .. (done and "" or " (exportando...)"), { Font = Enum.Font.GothamBold })
				if publishing == p.Id then
					form.title = form.title or p.Name
					local tb = UI.input(card, "Título (20-60 caracteres funciona mejor)", form.title)
					tb:GetPropertyChangedSignal("Text"):Connect(function()
						form.title = tb.Text
					end)
					local db = UI.input(card, "Descripción", form.description or "", { Height = 50, Multi = true })
					db:GetPropertyChangedSignal("Text"):Connect(function()
						form.description = db.Text
					end)
					local tg = UI.input(card, "Etiquetas separadas por comas", form.tags or catName(p.Category):lower())
					tg:GetPropertyChangedSignal("Text"):Connect(function()
						form.tags = tg.Text
					end)
					local thumbs = { { Id = false, Name = "Fotograma automático (⭐30)" } }
					for _, t in pairs(data.Thumbnails) do
						thumbs[#thumbs + 1] = { Id = t.Id, Name = "«" .. (t.Design.text ~= "" and t.Design.text or "sin texto") .. "» ⭐" .. math.floor(t.Score) }
					end
					local tNames, tIdx = {}, 1
					for i, t in ipairs(thumbs) do
						tNames[i] = t.Name
						if t.Id == (form.thumbId or (p.ThumbId ~= "" and p.ThumbId) or false) then
							tIdx = i
						end
					end
					form.thumbId = thumbs[tIdx].Id or nil
					UI.cycle(card, "Miniatura", tNames, tIdx, function(i)
						form.thumbId = thumbs[i].Id or nil
					end, { ValueWidth = 260 })
					local vis = { "Público", "Oculto (pocas visitas)" }
					UI.cycle(card, "Visibilidad", vis, form.unlisted and 2 or 1, function(i)
						form.unlisted = i == 2
					end)
					local fmtNames = {}
					for i, f in ipairs(VideoData.Formats) do
						fmtNames[i] = f.Name
					end
					form.formatIdx = form.formatIdx or 1
					UI.cycle(card, "Formato", fmtNames, form.formatIdx, function(i)
						form.formatIdx = i
						render()
					end, { ValueWidth = 200 })
					local fdef = VideoData.Formats[form.formatIdx]
					UI.label(card, fdef.Desc, { TextSize = 11, Color = T.Sub })
					if fdef.Series then
						local sb = UI.input(card, "Nombre de la serie (los episodios suman público fiel)", form.series or "")
						sb:GetPropertyChangedSignal("Text"):Connect(function()
							form.series = sb.Text
						end)
					end
					local contracts = { { Id = false, Name = "Sin patrocinio" } }
					for cid, c in pairs(data.Sponsors and data.Sponsors.Active or {}) do
						contracts[#contracts + 1] = { Id = cid, Name = "🤝 " .. c.Brand:upper() .. " · " .. catName(c.Category) .. " Q" .. c.MinQ }
					end
					local cNames, cIdx = {}, 1
					for i, c in ipairs(contracts) do
						cNames[i] = c.Name
						if c.Id == (form.sponsor or false) then
							cIdx = i
						end
					end
					UI.cycle(card, "Patrocinio", cNames, cIdx, function(i)
						form.sponsor = contracts[i].Id or nil
					end, { ValueWidth = 260 })
					UI.label(card, "Puntuación del título: " .. math.floor(F.title(form.title or "", p.Category)) .. "/100", { TextSize = 12, Color = T.Sub })
					local row = UI.row(card, 36)
					UI.button(row, "🚀 Publicar", function()
						local tags = {}
						for t in (form.tags or ""):gmatch("[^,]+") do
							tags[#tags + 1] = Util.trim(t)
						end
						local r = Net.call("Video.Publish", { pid = p.Id, title = form.title, description = form.description or "", tags = tags, thumbId = form.thumbId, visibility = form.unlisted and "unlisted" or "public",
							format = VideoData.Formats[form.formatIdx or 1].Id, series = form.series, sponsor = form.sponsor })
						if r.ok then
							publishing = nil
							form = {}
						end
					end, { Width = 140, Color = T.Accent })
					UI.button(row, "Cancelar", function()
						publishing = nil
						render()
					end, { Width = 100 })
				elseif done then
					UI.button(card, "Preparar publicación", function()
						publishing = p.Id
						form = {}
						render()
					end, { Width = 180, Color = T.Accent })
				end
			end
		end
		if ready == 0 then
			UI.label(s, "Nada listo. Exporta un proyecto en el Editor para publicarlo aquí.", { Color = T.Sub })
		end
		-- Vídeos publicados
		UI.title(s, "📺 Tus vídeos (" .. #data.Videos .. ")")
		for i, v in ipairs(data.Videos) do
			if i <= 30 then
				local card = UI.frame(s, { Height = 96, Color = T.Panel2 })
				if v.ThumbDesign then
					drawThumb(card, v.ThumbDesign, UDim2.fromOffset(150, 84)).Position = UDim2.fromOffset(6, 6)
				else
					local ph = UI.frame(card, { Size = UDim2.fromOffset(150, 84), Position = UDim2.fromOffset(6, 6), Color = T.Panel3 })
					UI.label(ph, "▶ " .. catName(v.Cat), { Size = UDim2.fromScale(1, 1), Align = Enum.TextXAlignment.Center, TextSize = 12 })
				end
				UI.label(card, v.Title, { Position = UDim2.fromOffset(166, 6), Size = UDim2.new(1, -176, 0, 22), Font = Enum.Font.GothamBold })
				UI.label(card, Util.formatInt(v.Views) .. " visitas · 👍 " .. Util.formatInt(v.Likes) .. " · 💬 " .. v.Comments .. " · $" .. string.format("%.2f", v.Revenue) .. " · +" .. (v.SubsGained or 0) .. " subs",
					{ Position = UDim2.fromOffset(166, 30), Size = UDim2.new(1, -176, 0, 20), TextSize = 13 })
				UI.label(card, "Calidad " .. math.floor(v.Q) .. " · CTR " .. v.Ctr .. "% · " .. catName(v.Cat) .. ((v.Format and v.Format ~= "video") and (" · " .. VideoData.FormatById[v.Format].Name .. (v.Episode and (" #" .. v.Episode) or "")) or "") .. (v.Sponsor and " · 🤝 patrocinado" or "") .. (v.Label and (" · " .. v.Label) or "") .. (v.Trend and " · 🔥 tendencia" or "") .. (v.Viral and " · 🚀 viral" or "") .. (v.Unlisted and " · oculto" or ""),
					{ Position = UDim2.fromOffset(166, 52), Size = UDim2.new(1, -176, 0, 20), TextSize = 12, Color = T.Sub })
				local c = v.CommentList and v.CommentList[1]
				if c then
					UI.label(card, "💬 " .. c.U .. ": " .. c.Txt, { Position = UDim2.fromOffset(166, 72), Size = UDim2.new(1, -176, 0, 18), TextSize = 11, Color = T.Sub })
				end
			end
		end
	end
	render()
	ctx.onState(function()
		if not publishing and not editingChannel then
			render()
		end
	end)
end
table.insert(apps, Studio)

---------------------------------------------------------------------------
-- ESTADÍSTICAS
---------------------------------------------------------------------------
local Analytics = { Id = "analytics", Name = "Estadísticas", Icon = "📊", Order = 4, Surfaces = { pc = true, phone = true, panel = false }, Width = 860, Height = 560 }

function Analytics.build(container, ctx)
	task.spawn(Net.call, "Channel.OpenAnalytics", {}, { silent = true })
	local selected, compareWith = 1, nil
	local function render()
		UI.clear(container)
		local data = State.Data
		if not data then
			return
		end
		local s = UI.scroll(container, { Pad = 8 })
		local ch = data.Channel
		local d = data.Derived
		UI.title(s, "📊 Resumen del canal")
		local row = UI.frame(s, { Height = 0, Auto = Enum.AutomaticSize.Y, Transparency = 1, Radius = false })
		UI.grid(row, ctx.kind == "phone" and 140 or 190, 60, 6)
		local function stat(label, value, color)
			local c = UI.card(row, { Height = 60 })
			UI.label(c, label, { TextSize = 12, Color = T.Sub })
			UI.label(c, value, { Font = Enum.Font.GothamBlack, TextSize = 20, Color = color or T.Text })
		end
		stat("Suscriptores", Util.formatInt(ch.Subs), T.Accent)
		stat("Visitas totales", Util.formatInt(ch.TotalViews), T.Accent2)
		stat("Ingresos del canal", "$" .. Util.formatInt(ch.TotalRevenue), T.Ok)
		stat("Reputación", tostring(data.Reputation) .. "/100", T.Gold)
		stat("Rango", d.RankName)
		stat("Vídeos", tostring(#data.Videos))
		local vids = data.Videos
		if #vids == 0 then
			UI.label(s, "Publica tu primer vídeo para ver estadísticas.", { Color = T.Sub })
			return
		end
		-- Visitas de los últimos 10 vídeos
		local values, labels = {}, {}
		for i = math.min(10, #vids), 1, -1 do
			values[#values + 1] = vids[i].Views
			labels[#labels + 1] = "#" .. i
		end
		UI.label(s, "Visitas de los últimos vídeos (el #1 es el más reciente)", { Font = Enum.Font.GothamBold })
		UI.bars(s, values, labels, T.Accent2)
		-- Detalle del vídeo seleccionado
		local names = {}
		for i, v in ipairs(vids) do
			names[i] = "#" .. i .. " " .. v.Title
		end
		UI.cycle(s, "Vídeo", names, selected, function(i)
			selected = i
			render()
		end, { ValueWidth = 320, LabelWidth = 60 })
		local v = vids[selected]
		if v then
			local card = UI.card(s, { Height = 0, Auto = Enum.AutomaticSize.Y })
			UI.label(card, v.Title, { Font = Enum.Font.GothamBold })
			UI.label(card, Util.formatInt(v.Views) .. " visitas (previstas ~" .. Util.formatInt(v.Expected) .. ") · CTR " .. v.Ctr .. "% · 👍 " .. v.Likes .. " · 💬 " .. v.Comments .. " · $" .. string.format("%.2f", v.Revenue), { TextSize = 13 })
			UI.label(card, "Calidad " .. math.floor(v.Q) .. " (material " .. math.floor(v.Footage or 0) .. ", edición " .. math.floor(v.EditQ or 0) .. ") · Miniatura ⭐" .. math.floor(v.Thumb) .. " · Título " .. math.floor(v.TitleScore or 0), { TextSize = 12, Color = T.Sub })
			if v.Labels and #v.Labels > 0 then
				UI.label(card, "Tipo: " .. table.concat(v.Labels, " · "), { TextSize = 12, Color = T.Gold })
			end
			UI.label(card, "Evolución de visitas (cada punto = 2 min tras publicar):", { TextSize = 12, Color = T.Sub })
			UI.bars(card, v.Hist or {}, nil, T.Accent, { Height = 100 })
			for _, c in ipairs(v.CommentList or {}) do
				UI.label(card, "💬 " .. c.U .. ": " .. c.Txt, { TextSize = 12 })
			end
		end
		-- Comparación entre publicaciones
		UI.label(s, "⚖ Comparar con otro vídeo", { Font = Enum.Font.GothamBold })
		local cmpNames = { "—" }
		for i, vv in ipairs(vids) do
			cmpNames[i + 1] = "#" .. i .. " " .. vv.Title
		end
		UI.cycle(s, "Comparar", cmpNames, (compareWith or 0) + 1, function(i)
			compareWith = i > 1 and (i - 1) or nil
			render()
		end, { ValueWidth = 320, LabelWidth = 70 })
		if compareWith and vids[compareWith] and v then
			local o = vids[compareWith]
			local function line(label, a, b)
				local r = UI.row(s, 22)
				UI.label(r, label, { Size = UDim2.new(0.3, 0, 1, 0), Color = T.Sub, TextSize = 12 })
				UI.label(r, tostring(a), { Size = UDim2.new(0.35, 0, 1, 0), TextSize = 12, Color = (tonumber(a) or 0) >= (tonumber(b) or 0) and T.Ok or T.Text })
				UI.label(r, tostring(b), { Size = UDim2.new(0.35, 0, 1, 0), TextSize = 12, Color = (tonumber(b) or 0) > (tonumber(a) or 0) and T.Ok or T.Text })
			end
			line("Visitas", v.Views, o.Views)
			line("Calidad", math.floor(v.Q), math.floor(o.Q))
			line("CTR %", v.Ctr, o.Ctr)
			line("Me gusta", v.Likes, o.Likes)
			line("Ingresos $", math.floor(v.Revenue), math.floor(o.Revenue))
			line("Suscriptores", v.SubsGained or 0, o.SubsGained or 0)
		end
	end
	render()
	ctx.onState(render)
end
table.insert(apps, Analytics)

apps.drawThumbFn = drawThumb
return apps
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000057"><Properties><string name="Name">FoodApp</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- App Comida: menú del lugar donde estás (restaurante, cafetería, máquina), cocina con recetas,
-- comida a domicilio y despensa.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Client = script.Parent.Parent
local UI = require(Client.UIKit)
local Net = require(Client.Net)
local State = require(Client.State)
local FoodData = require(Shared.FoodData)
local Catalog = require(Shared.ItemCatalog)
local T = UI.Theme

local Food = { Id = "food", Name = "Comida", Icon = "🍽", Order = 9, Surfaces = { pc = true, phone = true, panel = true }, Width = 720, Height = 540 }

function Food.build(container, ctx)
	local tab = ctx.params.tab or (ctx.params.place and "menu" or "pantry")
	local place = ctx.params.place
	local function render()
		UI.clear(container)
		local data = State.Data
		if not data then
			return
		end
		local n = data.Needs or { Energy = 100, Mood = 70 }
		local top = UI.row(container, 34)
		local tabs = { { "pantry", "🧺 Despensa" }, { "cook", "👨‍🍳 Cocinar" }, { "delivery", "🛵 Domicilio" } }
		if place then
			table.insert(tabs, 1, { "menu", "📜 Menú" })
		end
		for _, t in ipairs(tabs) do
			UI.button(top, t[2], function()
				tab = t[1]
				render()
			end, { Width = 120, Height = 28, Color = tab == t[1] and T.Accent or T.Panel3 })
		end
		local s = UI.scroll(container, { Size = UDim2.new(1, 0, 1, -40), Position = UDim2.fromOffset(0, 40), Pad = 6 })
		UI.label(s, "⚡ Energía " .. math.floor(n.Energy) .. "/100 · 😊 Ánimo " .. math.floor(n.Mood) .. "/100 · 💰 $" .. data.Money, { Font = Enum.Font.GothamBold })
		UI.progress(s, n.Energy / 100, T.Ok, { Height = 8 })
		UI.label(s, "Efecto moderado: con poca energía las escenas son algo menos interesantes y exportas más despacio. Con buen ánimo, tus escenas y directos mejoran un poco.", { TextSize = 11, Color = T.Sub, Height = 30 })
		if tab == "menu" and place then
			local menu = FoodData.Menus[place]
			UI.title(s, menu.Name)
			for _, it in ipairs(menu.Items) do
				local row = UI.row(s, 32)
				UI.label(row, it[2] .. " · energía +" .. it[4] .. " · ánimo +" .. it[5], { Size = UDim2.new(1, -110, 1, 0), TextSize = 13 })
				UI.button(row, "$" .. it[3], function()
					Net.call("Food.Order", { place = place, item = it[1] })
				end, { Width = 90, Height = 28, Color = T.Ok })
			end
		elseif tab == "cook" then
			UI.label(s, "Cocina en tu casa (nevera de la habitación o cocina de tu propiedad). Los ingredientes se compran en el Supermercado Fresco (Distrito de restaurantes) o online.", { TextSize = 12, Color = T.Sub, Height = 36 })
			local have = {}
			for _, rec in pairs(data.Inventory) do
				if rec.Loc == "home" or rec.Loc == "backpack" then
					have[rec.Id] = (have[rec.Id] or 0) + 1
				end
			end
			for _, r in ipairs(FoodData.Recipes) do
				local meal = Catalog.get(r.Id)
				local parts, ok = {}, true
				for _, need in ipairs(r.Needs) do
					local has = (have[need] or 0) > 0
					ok = ok and has
					parts[#parts + 1] = (has and "✔ " or "✖ ") .. Catalog.get(need).Name
				end
				local card = UI.card(s, { Height = 0, Auto = Enum.AutomaticSize.Y })
				UI.label(card, meal.Name .. " · energía +" .. meal.Stats.Energy .. " · ánimo +" .. meal.Stats.Mood, { Font = Enum.Font.GothamBold, TextSize = 13 })
				UI.label(card, table.concat(parts, "  "), { TextSize = 12, Color = ok and T.Ok or T.Sub, Height = 0, Auto = Enum.AutomaticSize.Y })
				UI.button(card, "Cocinar", function()
					Net.call("Food.Cook", { recipe = r.Id })
				end, { Width = 100, Height = 26, Color = ok and T.Accent2 or T.Panel3 })
			end
		elseif tab == "delivery" then
			UI.label(s, "Llega a tu casa en " .. FoodData.Delivery.Seconds .. " s · envío $" .. FoodData.Delivery.Fee, { TextSize = 12, Color = T.Sub })
			for _, id in ipairs(FoodData.Delivery.Items) do
				local def = Catalog.get(id)
				local row = UI.row(s, 32)
				UI.label(row, def.Name .. " · energía +" .. def.Stats.Energy .. " · ánimo +" .. def.Stats.Mood, { Size = UDim2.new(1, -110, 1, 0), TextSize = 13 })
				UI.button(row, "$" .. (FoodData.Delivery.Prices[id] + FoodData.Delivery.Fee), function()
					Net.call("Food.Delivery", { item = id })
				end, { Width = 90, Height = 28, Color = T.Ok })
			end
			for _, o in ipairs(data.FoodOrders or {}) do
				UI.label(s, "🛵 " .. Catalog.get(o.Item).Name .. " llega en " .. math.max(0, math.ceil(o.Eta - workspace:GetServerTimeNow())) .. " s", { TextSize = 12, Color = T.Gold })
			end
		else
			local items = State.items(function(rec, def)
				return def.Cat == "food" and (rec.Loc == "home" or rec.Loc == "backpack")
			end)
			if #items == 0 then
				UI.label(s, "La despensa está vacía. Compra en el supermercado, cocina o pide a domicilio.", { Color = T.Sub, Height = 30 })
			end
			for _, it in ipairs(items) do
				local row = UI.row(s, 30)
				UI.label(row, it.Def.Name .. " · ⚡+" .. it.Def.Stats.Energy .. " 😊+" .. it.Def.Stats.Mood, { Size = UDim2.new(1, -100, 1, 0), TextSize = 13 })
				UI.button(row, "🍽 Comer", function()
					Net.call("Food.Eat", { uid = it.Uid })
				end, { Width = 90, Height = 26, TextSize = 12, Color = T.Ok })
			end
		end
	end
	render()
	ctx.onState(render)
end

return Food
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000058"><Properties><string name="Name">LifeApps</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Apps de vida diaria: Misiones, Mapa y transporte, Empleo, Álbum, Cámara, Estilo, Mensajes, Calendario,
-- Tendencias, Música, Archivos, Tareas, Noticias y Ajustes.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local Lighting = game:GetService("Lighting")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Client = script.Parent.Parent
local UI = require(Client.UIKit)
local Net = require(Client.Net)
local State = require(Client.State)
local Notify = require(Client.Notify)
local Actions = require(Client.Actions)
local PhotoView = require(Client.PhotoView)
local Catalog = require(Shared.ItemCatalog)
local QuestDefs = require(Shared.QuestDefs)
local WorldData = require(Shared.WorldData)
local VideoData = require(Shared.VideoData)
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local F = require(Shared.VideoFormulas)
local T = UI.Theme

local apps = {}
local player = Players.LocalPlayer

local function catName(id)
	local c = VideoData.CategoryById[id]
	return c and c.Name or id
end

---------------------------------------------------------------------------
-- MISIONES Y LOGROS
---------------------------------------------------------------------------
local Missions = { Id = "missions", Name = "Misiones", Icon = "🏆", Order = 10, Surfaces = { pc = true, phone = true, panel = true }, Width = 820, Height = 560 }
function Missions.build(container, ctx)
	local groupFilter = 1
	local function render()
		UI.clear(container)
		local data = State.Data
		if not data then
			return
		end
		local q = data.Quests
		local s = UI.scroll(container, { Pad = 6 })
		local step = QuestDefs.Tutorial[q.Step]
		if step and not q.Skipped then
			local card = UI.card(s, { Height = 0, Auto = Enum.AutomaticSize.Y, Color = Color3.fromRGB(40, 50, 80) })
			UI.label(card, "🎓 Tutorial " .. q.Step .. "/" .. #QuestDefs.Tutorial .. ": " .. step.Name, { Font = Enum.Font.GothamBold })
			UI.label(card, step.Hint, { TextSize = 13, Height = 36 })
			UI.label(card, "Recompensa: $" .. step.Reward.Money .. " y " .. step.Reward.Xp .. " XP", { TextSize = 12, Color = T.Gold })
			local row = UI.row(card, 30)
			UI.button(row, "Saltar este paso", function()
				Net.call("Quest.SkipStep", {})
			end, { Width = 140, Height = 26, TextSize = 12 })
			UI.button(row, "Ocultar tutorial", function()
				Net.call("Quest.SkipTutorial", {})
			end, { Width = 140, Height = 26, TextSize = 12 })
		elseif step and q.Skipped then
			UI.button(s, "Reactivar explicaciones del tutorial", function()
				Net.call("Quest.RestartTutorial", {})
			end, { Width = 300 })
		else
			UI.label(s, "🎓 Tutorial completado.", { Color = T.Ok })
		end
		-- Logros
		local pending = 0
		for _, a in ipairs(QuestDefs.Achievements) do
			if q.Completed[a.Id] and not q.Claimed[a.Id] then
				pending = pending + 1
			end
		end
		local row = UI.row(s, 34)
		UI.label(row, "🏆 Logros (" .. State.count(q.Completed) .. "/" .. #QuestDefs.Achievements .. ")", { Size = UDim2.fromOffset(220, 30), Font = Enum.Font.GothamBlack, TextSize = 16 })
		if pending > 0 then
			UI.button(row, "Cobrar todo (" .. pending .. ")", function()
				Net.call("Quest.ClaimAll", {})
			end, { Width = 170, Height = 30, Color = T.Ok })
		end
		local groups = { "Todos", "Pendientes de cobrar" }
		local groupKeys = {}
		for _, a in ipairs(QuestDefs.Achievements) do
			if not Util.indexOf(groups, a.Group) then
				groups[#groups + 1] = a.Group
			end
		end
		UI.cycle(s, "Mostrar", groups, groupFilter, function(i)
			groupFilter = i
			render()
		end, { ValueWidth = 220, LabelWidth = 70 })
		local values = data.Derived.QuestValues
		local shownPerTrack = {}
		for _, a in ipairs(QuestDefs.Achievements) do
			local done = q.Completed[a.Id] ~= nil
			local claimed = q.Claimed[a.Id] ~= nil
			local g = groups[groupFilter]
			local show = (groupFilter == 1) or (groupFilter == 2 and done and not claimed) or (g == a.Group)
			-- en la vista general solo el siguiente nivel de cada grupo (y los pendientes)
			if groupFilter == 1 and claimed then
				show = false
			end
			if groupFilter == 1 and not done then
				if shownPerTrack[a.Counter] then
					show = false
				end
				shownPerTrack[a.Counter] = true
			end
			if show then
				local card = UI.card(s, { Height = 0, Auto = Enum.AutomaticSize.Y, Color = done and (claimed and T.Panel2 or Color3.fromRGB(40, 70, 50)) or T.Panel2 })
				local v = values[a.Counter] or 0
				UI.label(card, (claimed and "✔ " or (done and "🎁 " or "")) .. a.Name, { Font = Enum.Font.GothamBold, TextSize = 13 })
				UI.progress(card, v / a.Target, done and T.Ok or T.Accent2, { Height = 8 })
				UI.label(card, Util.formatInt(math.min(v, a.Target)) .. "/" .. Util.formatInt(a.Target) .. " · $" .. Util.formatInt(a.Reward.Money) .. " · " .. a.Reward.Xp .. " XP" .. (a.Reward.Title and (" · título «" .. a.Reward.Title .. "»") or ""), { TextSize = 11, Color = T.Sub })
				if done and not claimed then
					UI.button(card, "Cobrar", function()
						Net.call("Quest.Claim", { id = a.Id })
					end, { Width = 100, Height = 26, Color = T.Ok })
				end
			end
		end
		-- Títulos
		UI.title(s, "🏷 Títulos")
		local tRow = UI.frame(s, { Height = 0, Auto = Enum.AutomaticSize.Y, Transparency = 1, Radius = false })
		UI.grid(tRow, 200, 28, 4)
		UI.button(tRow, data.EquippedTitle == "" and "● Sin título" or "Sin título", function()
			Net.call("Title.Equip", { title = "" })
		end, { Size = UDim2.fromOffset(200, 28), TextSize = 12 })
		for title in pairs(data.Titles) do
			UI.button(tRow, (data.EquippedTitle == title and "● " or "") .. title, function()
				Net.call("Title.Equip", { title = title })
			end, { Size = UDim2.fromOffset(200, 28), TextSize = 12, Color = data.EquippedTitle == title and T.Accent or T.Panel3 })
		end
		-- Estadísticas personales
		UI.title(s, "📈 Estadísticas personales")
		for key, name in pairs(QuestDefs.TrackNames) do
			UI.label(s, name .. ": " .. Util.formatInt(values[key] or 0), { TextSize = 12, Color = T.Sub, Height = 16 })
		end
	end
	render()
	ctx.onState(render)
end
table.insert(apps, Missions)

---------------------------------------------------------------------------
-- MAPA Y TRANSPORTE
---------------------------------------------------------------------------
local Map = { Id = "map", Name = "Mapa", Icon = "🗺", Order = 11, Surfaces = { pc = true, phone = true, panel = true }, Width = 900, Height = 580 }
local busLine = { budget = true, apartments = true, studios = true, entertainment = true, events = true, commercial = true, park = true, creators = true, financial = true, tourist = true, university = true, beach = true }
function Map.build(container, ctx)
	local selected = nil
	local function render()
		UI.clear(container)
		local data = State.Data
		if not data then
			return
		end
		local narrow = ctx.kind == "phone"
		local mapW = narrow and 290 or 480
		local cell = mapW / WorldData.Cols
		local mapFrame = UI.frame(container, { Size = UDim2.fromOffset(mapW, cell * WorldData.Rows), Color = Color3.fromRGB(40, 40, 46) })
		local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		local here = root and WorldData.districtAt(root.Position.X, root.Position.Z)
		for _, d in ipairs(WorldData.Districts) do
			local visited = data.Visited.Districts[d.Id]
			local b = UI.button(mapFrame, (here == d and "📍" or (visited and "" or "?")) .. (narrow and "" or ("\n" .. d.Name)), function()
				selected = d.Id
				render()
			end, { Size = UDim2.fromOffset(cell - 3, cell - 3), Position = UDim2.fromOffset((d.Col - 1) * cell + 1.5, (d.Row - 1) * cell + 1.5), Color = UI.rgb(d.Ground), TextSize = 10, Radius = 3 })
			b.TextColor3 = Color3.new(1, 1, 1)
			b.TextStrokeTransparency = 0.3
			if not visited then
				b.BackgroundTransparency = 0.45
			end
			if selected == d.Id then
				UI.stroke(b, T.Gold, 3)
			end
		end
		if root then
			local w, h = WorldData.totalSize()
			local px = (root.Position.X + w / 2) / w * mapW
			local pz = (root.Position.Z + h / 2) / h * (cell * WorldData.Rows)
			local dot = UI.frame(mapFrame, { Size = UDim2.fromOffset(10, 10), Position = UDim2.fromOffset(px - 5, pz - 5), Color = T.Accent, Radius = 5 })
			dot.ZIndex = 5
		end
		local info = UI.scroll(container, { Size = narrow and UDim2.new(1, 0, 1, -(cell * WorldData.Rows) - 8) or UDim2.new(1, -mapW - 10, 1, 0), Position = narrow and UDim2.fromOffset(0, cell * WorldData.Rows + 8) or UDim2.fromOffset(mapW + 10, 0), Pad = 6 })
		local visitedCount = State.count(data.Visited.Districts)
		UI.label(info, "Distritos visitados: " .. visitedCount .. "/30 · Secretos: " .. State.count(data.Visited.Secrets) .. "/" .. #WorldData.Secrets, { Font = Enum.Font.GothamBold })
		UI.button(info, "🏠 Taxi a casa", function()
			Net.call("Home.Teleport", {})
		end, { Width = 160, Height = 30 })
		local d = selected and WorldData.DistrictById[selected]
		if not d then
			UI.label(info, "Toca un distrito para ver sus lugares y viajar. Los distritos con «?» aún no los has visitado.", { Color = T.Sub, Height = 40 })
			-- pista de un secreto no descubierto
			for _, sec in ipairs(WorldData.Secrets) do
				if not data.Visited.Secrets[sec.Id] then
					UI.label(info, "🔎 Pista: " .. sec.Hint, { Color = T.Gold, TextSize = 12, Height = 34 })
					break
				end
			end
			return
		end
		UI.title(info, d.Name)
		local tags = {}
		for _, t in ipairs(d.Tags) do
			tags[#tags + 1] = t
		end
		UI.label(info, "Ambiente: " .. table.concat(tags, ", ") .. " · ruido " .. d.Noise .. "/10 · gente " .. d.Busy .. "/10", { TextSize = 12, Color = T.Sub })
		if root then
			local cx, cz = WorldData.center(d)
			local dist = math.sqrt((cx - root.Position.X) ^ 2 + (cz - root.Position.Z) ^ 2)
			local fare = math.floor(Config.TaxiBaseFare + dist * Config.TaxiPerStud + 0.5)
			local row = UI.row(info, 34)
			UI.button(row, "🚕 Taxi ($" .. fare .. ")", function()
				Net.call("Travel.Taxi", { district = d.Id })
			end, { Width = 140, Height = 30, Color = T.Gold, TextColor = Color3.new(0, 0, 0) })
			if busLine[d.Id] then
				UI.button(row, "🚌 Autobús ($3)", function()
					Net.call("Travel.Bus", { district = d.Id })
				end, { Width = 140, Height = 30 })
			end
		end
		UI.label(info, "🎥 Lugares de grabación:", { Font = Enum.Font.GothamBold })
		for _, sp in ipairs(WorldData.Spots) do
			if sp.District == d.Id and not sp.Secret then
				local card = UI.card(info, { Height = 0, Auto = Enum.AutomaticSize.Y })
				UI.label(card, sp.Name .. " · interés " .. sp.Interest, { TextSize = 13, Font = Enum.Font.GothamBold })
				local good = {}
				for _, c in ipairs(VideoData.Categories) do
					if F.overlap(c.Tags, sp.Tags) > 0 and #good < 5 then
						good[#good + 1] = c.Name
					end
				end
				UI.label(card, "Ideal para: " .. table.concat(good, ", "), { TextSize = 11, Color = T.Sub, Height = 28 })
				UI.button(card, "🚕 Ir aquí", function()
					Net.call("Travel.TaxiSpot", { spot = sp.Id })
				end, { Width = 100, Height = 26, TextSize = 12 })
			end
		end
		for _, sp in ipairs(WorldData.Specials) do
			if sp.District == d.Id then
				local n = sp.Name or (sp.StoreId and Catalog.Stores[sp.StoreId].Name) or sp.Type
				UI.label(info, "🏬 " .. n, { TextSize = 13 })
			end
		end
	end
	render()
	task.spawn(function()
		while container.Parent do
			task.wait(3)
			if container.Parent and not selected then
				render()
			end
		end
	end)
end
table.insert(apps, Map)

---------------------------------------------------------------------------
-- EMPLEO
---------------------------------------------------------------------------
local Jobs = { Id = "jobs", Name = "Empleo", Icon = "💼", Order = 12, Surfaces = { pc = true, phone = true, panel = true }, Width = 760, Height = 540 }
local jobInfo = {
	{ Id = "edit", Name = "Editor de vídeos freelance", Req = "Estar usando un computador", Desc = "Ordena los clips de un cliente. Paga más con un PC mejor." },
	{ Id = "photo", Name = "Fotógrafo por encargo", Req = "Cámara o teléfono", Desc = "Haz una foto concreta en un lugar de la ciudad. Paga según la calidad." },
	{ Id = "delivery", Name = "Repartidor", Req = "Empezar dentro de una tienda", Desc = "Lleva un paquete a un lugar. Paga según la distancia." },
	{ Id = "cashier", Name = "Cajero / dependiente", Req = "Empezar dentro de una tienda", Desc = "Calcula el cambio de tres clientes." },
	{ Id = "camera", Name = "Camarógrafo", Req = "Cámara o teléfono", Desc = "Graba 2 escenas de calidad mínima en el lugar que pide el cliente." },
	{ Id = "thumbs", Name = "Diseñador de miniaturas", Req = "Computador o tableta", Desc = "Diseña una miniatura con la palabra del cliente y buena puntuación." },
	{ Id = "tech", Name = "Técnico informático", Req = "Conocer los zócalos", Desc = "Elige la placa base compatible con cada procesador." },
	{ Id = "reporter", Name = "Periodista de eventos", Req = "Ir al evento del día", Desc = "Haz una foto y graba una escena en el evento de hoy." },
}
function Jobs.build(container, ctx)
	local order = nil
	local answers = nil
	local render
	render = function()
		UI.clear(container)
		local data = State.Data
		if not data then
			return
		end
		local s = UI.scroll(container, { Pad = 6 })
		local job = data.Job or {}
		if job.Type then
			local card = UI.card(s, { Height = 0, Auto = Enum.AutomaticSize.Y, Color = Color3.fromRGB(40, 60, 90) })
			UI.label(card, "📌 Encargo en curso", { Font = Enum.Font.GothamBold })
			if job.Type == "edit" then
				order = order or Util.deepCopy(job.Clips)
				UI.label(card, "Ordena los clips en el orden lógico de un vídeo:", { TextSize = 13 })
				for i, clip in ipairs(order) do
					local row = UI.row(card, 28)
					UI.label(row, i .. ". " .. clip, { Size = UDim2.fromOffset(200, 26), TextSize = 13 })
					UI.button(row, "▲", function()
						if i > 1 then
							order[i], order[i - 1] = order[i - 1], order[i]
							render()
						end
					end, { Width = 30, Height = 24 })
					UI.button(row, "▼", function()
						if i < #order then
							order[i], order[i + 1] = order[i + 1], order[i]
							render()
						end
					end, { Width = 30, Height = 24 })
				end
				UI.button(card, "📤 Entregar edición", function()
					local r = Net.call("Job.Submit", { order = order })
					order = nil
				end, { Width = 180, Color = T.Ok })
			elseif job.Type == "cashier" or job.Type == "tech" then
				answers = answers or {}
				local list = job.Type == "cashier" and job.Rounds or job.Questions
				for i, q in ipairs(list) do
					if job.Type == "cashier" then
						local row = UI.row(card, 32)
						UI.label(row, "Cliente " .. i .. ": compra $" .. q.Price .. " y paga con $" .. q.Paid .. ". Cambio:", { Size = UDim2.fromOffset(330, 28), TextSize = 13 })
						local box = UI.input(row, "$", answers[i] and tostring(answers[i]) or "", { Size = UDim2.fromOffset(80, 28) })
						box.FocusLost:Connect(function()
							answers[i] = tonumber(box.Text)
						end)
					else
						local cpu = require(Shared.ItemCatalog).get(q.Cpu)
						UI.label(card, i .. ". Procesador " .. cpu.Name .. " — ¿qué placa es compatible?", { TextSize = 13 })
						local row = UI.row(card, 30)
						for _, opt in ipairs(q.Options) do
							local mdef = require(Shared.ItemCatalog).get(opt)
							UI.button(row, (answers[i] == opt and "● " or "") .. mdef.Name, function()
								answers[i] = opt
								render()
							end, { Width = 190, Height = 26, TextSize = 11, Color = answers[i] == opt and T.Accent2 or T.Panel3 })
						end
					end
				end
				UI.button(card, "📤 Entregar", function()
					Net.call("Job.Submit", { answers = answers })
					answers = nil
				end, { Width = 150, Color = T.Ok })
			elseif job.Type == "camera" then
				UI.label(card, "Graba 2 escenas de calidad " .. job.MinQ .. "+ en " .. job.SpotName .. " (llevas " .. (job.Count or 0) .. "/2).", { TextSize = 13, Height = 36 })
				UI.button(card, "🚕 Taxi al lugar", function()
					Net.call("Travel.TaxiSpot", { spot = job.Spot })
				end, { Width = 150 })
			elseif job.Type == "thumbs" then
				UI.label(card, "El cliente quiere una miniatura con la palabra «" .. job.Keyword .. "» y puntuación " .. job.MinScore .. "+. Diséñala en la app Miniaturas.", { TextSize = 13, Height = 36 })
			elseif job.Type == "reporter" then
				UI.label(card, "Reportaje en " .. job.SpotName .. ": " .. (job.Photo and "✔" or "○") .. " foto · " .. (job.Scene and "✔" or "○") .. " escena", { TextSize = 13, Height = 36 })
				UI.button(card, "🚕 Ir al evento", function()
					Net.call("Travel.TaxiSpot", { spot = job.Spot })
				end, { Width = 150 })
			elseif job.Type == "photo" then
				UI.label(card, "Haz una foto «" .. job.ModeName .. "» en " .. job.SpotName .. ". Usa el taxi si queda lejos.", { TextSize = 13, Height = 36 })
				UI.button(card, "🚕 Taxi al lugar", function()
					Net.call("Travel.TaxiSpot", { spot = job.Spot })
				end, { Width = 150 })
			elseif job.Type == "delivery" then
				UI.label(card, "Entrega el paquete en " .. job.SpotName .. " (" .. job.Dist .. " studs).", { TextSize = 13 })
				UI.button(card, "📦 Entregar aquí", function()
					Net.call("Job.Submit", {})
				end, { Width = 150, Color = T.Ok })
			end
			UI.button(card, "Cancelar encargo", function()
				order = nil
				Net.call("Job.Cancel", {})
			end, { Width = 160, Color = Color3.fromRGB(110, 40, 40) })
		end
		UI.title(s, "💼 Empleos disponibles")
		local bonus = Util.indexOf(data.Derived.Passes, "VIP") and " (+10% VIP)" or ""
		for _, j in ipairs(jobInfo) do
			local n = data.Counters["job_" .. j.Id] or 0
			local promo = math.min(50, math.floor(n / 10) * 5)
			local card = UI.card(s, { Height = 0, Auto = Enum.AutomaticSize.Y })
			UI.label(card, j.Name, { Font = Enum.Font.GothamBold })
			UI.label(card, j.Desc, { TextSize = 12, Color = T.Sub })
			UI.label(card, "Requisito: " .. j.Req .. " · completados: " .. n .. " · ascenso: +" .. promo .. "% paga" .. bonus, { TextSize = 12, Color = T.Sub })
			UI.progress(card, (n % 10) / 10, T.Gold, { Height = 6 })
			if not job.Type then
				UI.button(card, "Aceptar encargo", function()
					order = nil
					Net.call("Job.Start", { type = j.Id })
				end, { Width = 150, Height = 28, Color = T.Accent2 })
			end
		end
		UI.label(s, "Los ingresos de empleos pagan un 8% de impuesto simulado.", { TextSize = 11, Color = T.Sub })
	end
	render()
	ctx.onState(render)
end
table.insert(apps, Jobs)

---------------------------------------------------------------------------
-- ÁLBUM DE FOTOS
---------------------------------------------------------------------------
local Album = { Id = "album", Name = "Álbum", Icon = "🖼", Order = 13, Surfaces = { pc = true, phone = true, panel = true }, Width = 820, Height = 560 }
function Album.build(container, ctx)
	local selected, albumIdx = nil, 1
	local function render()
		UI.clear(container)
		local data = State.Data
		if not data then
			return
		end
		local albums = { "Todas" }
		for _, a in ipairs(data.Albums) do
			albums[#albums + 1] = a
		end
		local top = UI.row(container, 34)
		UI.cycle(top, "Álbum", albums, albumIdx, function(i)
			albumIdx = i
			render()
		end, { LabelWidth = 50, ValueWidth = 120 })
		UI.label(top, #data.Photos .. "/" .. data.Derived.PhotoCap .. " fotos", { Size = UDim2.fromOffset(110, 28), TextSize = 12, Color = T.Sub })
		local nb = UI.input(top, "Nuevo álbum", "", { Size = UDim2.fromOffset(120, 28) })
		UI.button(top, "+", function()
			Net.call("Photo.CreateAlbum", { name = nb.Text })
		end, { Width = 30, Height = 28 })
		local narrow = ctx.kind == "phone"
		local list = UI.scroll(container, { Size = narrow and UDim2.new(1, 0, 0.45, -40) or UDim2.new(0.45, 0, 1, -40), Position = UDim2.fromOffset(0, 40), Pad = 4 })
		for _, ph in ipairs(data.Photos) do
			if albumIdx == 1 or ph.Album == albums[albumIdx] then
				local mode = VideoData.PhotoModeById[ph.Mode]
				UI.button(list, (mode and mode.Name or "") .. " · " .. ph.SpotName .. " · Q" .. math.floor(ph.Q), function()
					selected = ph.Id
					render()
				end, { Size = UDim2.new(1, -8, 0, 30), TextSize = 12, Color = selected == ph.Id and T.Accent2 or T.Panel2 })
			end
		end
		if #data.Photos == 0 then
			UI.label(list, "Aún no hay fotos. Pulsa F (o el botón FOTO) para el modo fotógrafo.", { Color = T.Sub, Height = 40 })
		end
		if data.Posts and #data.Posts > 0 then
			UI.label(list, "📲 Tus publicaciones", { Font = Enum.Font.GothamBold })
			for _, post in ipairs(data.Posts) do
				UI.label(list, "«" .. post.Caption .. "» · " .. post.Spot .. " · ❤️ " .. post.Likes .. " · +" .. post.Subs, { TextSize = 11, Color = T.Sub })
			end
		end
		local ph = nil
		for _, p in ipairs(data.Photos) do
			if p.Id == selected then
				ph = p
			end
		end
		if ph then
			local right = UI.scroll(container, { Size = narrow and UDim2.new(1, 0, 0.55, 0) or UDim2.new(0.55, -8, 1, -40), Position = narrow and UDim2.fromScale(0, 0.45) or UDim2.new(0.45, 8, 0, 40) })
			PhotoView.render(right, ph, UDim2.fromOffset(narrow and 280 or 400, narrow and 158 or 225))
			local mode = VideoData.PhotoModeById[ph.Mode]
			UI.label(right, (mode and mode.Name or "") .. " en " .. ph.SpotName .. " · calidad " .. math.floor(ph.Q) .. " · " .. string.format("%02d:%02d", math.floor(ph.Hour), math.floor((ph.Hour % 1) * 60)) .. " · " .. (VideoData.PhotoFilters[ph.Filter] or ""), { TextSize = 12, Height = 30 })
			if ph.Probs and #ph.Probs > 0 then
				UI.label(right, "⚠ " .. table.concat(ph.Probs, ", "), { TextSize = 12, Color = T.Warn })
			end
			UI.cycle(right, "Mover a", data.Albums, Util.indexOf(data.Albums, ph.Album) or 1, function(i)
				Net.call("Photo.SetAlbum", { id = ph.Id, album = data.Albums[i] })
			end, { LabelWidth = 70 })
			local cap = UI.input(right, "Texto para la publicación en redes", "")
			UI.button(right, "📲 Publicar en redes", function()
				Net.call("Social.Post", { photoId = ph.Id, caption = cap.Text })
			end, { Width = 200, Color = T.Accent2 })
			local row = UI.row(right, 34)
			UI.button(row, "🖼 Usar en miniatura", function()
				ctx.open("thumbs", { photoId = ph.Id })
			end, { Width = 170 })
			UI.button(row, "🗑 Borrar", function()
				Notify.confirm("¿Borrar esta foto?", function()
					selected = nil
					Net.call("Photo.Delete", { id = ph.Id })
				end)
			end, { Width = 100, Color = Color3.fromRGB(110, 40, 40) })
		end
	end
	render()
	ctx.onState(render)
end
table.insert(apps, Album)

---------------------------------------------------------------------------
-- CÁMARA (teléfono) y VESTIDOR
---------------------------------------------------------------------------
local Camera = { Id = "camera", Name = "Cámara", Icon = "📷", Order = 14, Surfaces = { phone = true } }
function Camera.build(container, ctx)
	UI.label(container, "📷 Cámara", { Font = Enum.Font.GothamBlack, TextSize = 20, Height = 30 })
	UI.label(container, "Modo fotógrafo: elige tipo de foto, encuadre, zoom y filtro. Las fotos se guardan en el álbum.", { TextSize = 13, Height = 50, Position = UDim2.fromOffset(0, 34) })
	UI.button(container, "📸 Abrir modo fotógrafo", function()
		ctx.close()
		require(Client.Shell).close()
		Actions.photoMode()
	end, { Size = UDim2.new(1, 0, 0, 44), Position = UDim2.fromOffset(0, 90), Color = T.Accent })
	UI.button(container, "🎬 Grabar vídeo", function()
		require(Client.Shell).close()
		Actions.record()
	end, { Size = UDim2.new(1, 0, 0, 44), Position = UDim2.fromOffset(0, 142) })
end
table.insert(apps, Camera)

local Style = { Id = "style", Name = "Estilo", Icon = "👕", Order = 15, Surfaces = { phone = true, panel = true }, Width = 520, Height = 480 }
local styleColors = {
	{ 240, 240, 240 }, { 30, 30, 35 }, { 200, 40, 40 }, { 40, 90, 200 }, { 50, 160, 90 }, { 250, 200, 40 },
	{ 255, 120, 0 }, { 140, 70, 200 }, { 255, 110, 170 }, { 120, 85, 60 }, { 90, 100, 110 }, { 0, 170, 190 },
}
function Style.build(container, ctx)
	local data = State.Data
	local shirt = data and data.Appearance.Shirt or 5
	local pants = data and data.Appearance.Pants or 2
	local function render()
		UI.clear(container)
		local s = UI.scroll(container, { Pad = 8 })
		UI.label(s, "Elige los colores de tu ropa. No cambia tu tono de piel. La ropa es estética: no hace falta para progresar.", { TextSize = 13, Height = 36, Color = T.Sub })
		local preview = UI.frame(s, { Height = 120, Color = T.Bg })
		UI.frame(preview, { Size = UDim2.fromOffset(60, 50), Position = UDim2.new(0.5, -30, 0, 10), Color = UI.rgb(styleColors[shirt]) })
		UI.frame(preview, { Size = UDim2.fromOffset(60, 50), Position = UDim2.new(0.5, -30, 0, 62), Color = UI.rgb(styleColors[pants]) })
		local function palette(label, current, set)
			UI.label(s, label, { Font = Enum.Font.GothamBold })
			local row = UI.frame(s, { Height = 34, Transparency = 1, Radius = false })
			UI.list(row, Enum.FillDirection.Horizontal, 4)
			for i, c in ipairs(styleColors) do
				UI.button(row, current == i and "●" or "", function()
					set(i)
					render()
				end, { Width = 30, Height = 30, Color = UI.rgb(c), TextColor = Color3.new(0.5, 0.5, 0.5) })
			end
		end
		palette("Camiseta / chaqueta", shirt, function(i)
			shirt = i
		end)
		palette("Pantalón", pants, function(i)
			pants = i
		end)
		local row = UI.row(s, 38)
		UI.button(row, "✅ Aplicar estilo", function()
			Net.call("Style.Set", { shirt = shirt, pants = pants })
		end, { Width = 160, Color = T.Ok })
		UI.button(row, "Usar mi avatar de Roblox", function()
			Net.call("Style.Set", { mode = "roblox" })
		end, { Width = 210 })
		UI.label(s, "Conjuntos guardados:", { Font = Enum.Font.GothamBold })
		local outfits = State.Data and State.Data.Appearance.Outfits or {}
		for slot = 1, 3 do
			local o = outfits[tostring(slot)]
			local r = UI.row(s, 32)
			UI.label(r, "Conjunto " .. slot .. (o and "" or " (vacío)"), { Size = UDim2.fromOffset(140, 28) })
			UI.button(r, "Guardar actual", function()
				Net.call("Style.SaveOutfit", { slot = slot })
			end, { Width = 130, Height = 28, TextSize = 12 })
			if o then
				UI.button(r, "Ponerse", function()
					shirt, pants = o.Shirt, o.Pants
					Net.call("Style.Set", { shirt = shirt, pants = pants })
					render()
				end, { Width = 90, Height = 28, TextSize = 12 })
			end
		end
	end
	render()
end
table.insert(apps, Style)

---------------------------------------------------------------------------
-- MENSAJES, CALENDARIO, TENDENCIAS, NOTICIAS, TAREAS
---------------------------------------------------------------------------
local Messages = { Id = "messages", Name = "Mensajes", Icon = "💬", Order = 16, Surfaces = { pc = true, phone = true }, Width = 600, Height = 480 }
function Messages.build(container, ctx)
	local function render()
		UI.clear(container)
		local s = UI.scroll(container, { Pad = 4 })
		UI.label(s, "Notificaciones y mensajes de esta sesión (" .. #State.Messages .. ")", { Font = Enum.Font.GothamBold })
		for _, m in ipairs(State.Messages) do
			local card = UI.card(s, { Height = 0, Auto = Enum.AutomaticSize.Y })
			UI.label(card, os.date("%H:%M", m.T) .. " · " .. m.Text, { TextSize = 12, Height = 0, Auto = Enum.AutomaticSize.Y })
		end
	end
	render()
	ctx.onState(render)
end
table.insert(apps, Messages)

local Calendar = { Id = "calendar", Name = "Calendario", Icon = "📅", Order = 17, Surfaces = { pc = true, phone = true }, Width = 600, Height = 480 }
function Calendar.build(container, ctx)
	local data = State.Data
	if not data then
		return
	end
	local s = UI.scroll(container, { Pad = 6 })
	local day = workspace:GetAttribute("GameDay") or 1
	local hour = workspace:GetAttribute("GameHour") or 12
	UI.title(s, "📅 Día " .. day .. " · Mes " .. data.Derived.Month .. " · " .. (workspace:GetAttribute("TimeLabel") or ""))
	UI.label(s, string.format("Hora: %02d:%02d · Clima: %s", math.floor(hour), math.floor((hour % 1) * 60), workspace:GetAttribute("Weather") or "Clear"), { TextSize = 13 })
	local h = data.Home
	UI.label(s, "🏠 Alquiler en " .. math.max(0, h.NextDue - h.PlayDays) .. " días de juego ($" .. h.Rent .. ")", { TextSize = 13 })
	for _, o in ipairs(data.Orders) do
		if o.Status == "En camino" then
			UI.label(s, "📦 Pedido #" .. o.Num .. " llega en " .. math.max(0, math.ceil(o.Eta - workspace:GetServerTimeNow())) .. " s", { TextSize = 13 })
		end
	end
	for _, p in pairs(data.Projects) do
		if p.Plan.Time ~= "" and p.Plan.Time ~= "Cualquiera" then
			UI.label(s, "🎬 «" .. p.Name .. "» planificado para: " .. p.Plan.Time, { TextSize = 13 })
		end
	end
	UI.label(s, "🌅 Hora dorada: 5:30-7:00 y 17:00-19:00 (mejores tomas exteriores).", { TextSize = 12, Color = T.Gold })
	UI.label(s, "Las tendencias cambian cada día. Un día dura " .. math.floor(Config.DayLengthSeconds / 60) .. " minutos reales.", { TextSize = 12, Color = T.Sub })
end
table.insert(apps, Calendar)

local Trends = { Id = "trends", Name = "Tendencias", Icon = "🔥", Order = 18, Surfaces = { pc = true, phone = true }, Width = 620, Height = 500 }
function Trends.build(container, ctx)
	local data = State.Data
	if not data then
		return
	end
	local tr = data.Derived.Trends
	local s = UI.scroll(container, { Pad = 6 })
	UI.title(s, "🔥 En tendencia hoy (x1,4 de alcance)")
	for _, id in ipairs(tr.Hot or {}) do
		local c = VideoData.CategoryById[id]
		local card = UI.card(s, { Height = 0, Auto = Enum.AutomaticSize.Y })
		UI.label(card, c.Name, { Font = Enum.Font.GothamBold })
		local spots = {}
		for _, sp in ipairs(WorldData.Spots) do
			if not sp.Secret and F.overlap(sp.Tags, c.Tags) > 0 and #spots < 4 then
				spots[#spots + 1] = sp.Name
			end
		end
		UI.label(card, "Dónde grabar: " .. table.concat(spots, ", "), { TextSize = 12, Color = T.Sub, Height = 30 })
		UI.button(card, "💡 Crear proyecto", function()
			Net.call("Video.CreateProject", { category = id })
		end, { Width = 160, Height = 26, TextSize = 12 })
	end
	if tr.Cold and tr.Cold ~= "" then
		UI.label(s, "🧊 De capa caída: " .. catName(tr.Cold) .. " (x0,85)", { Color = T.Accent2 })
	end
	UI.label(s, "Competencia hoy: " .. math.floor((1 - (tr.Competition or 1)) * 100) .. "% de visitas repartidas con otros creadores.", { TextSize = 12, Color = T.Sub })
end
table.insert(apps, Trends)

local News = { Id = "news", Name = "Noticias", Icon = "📰", Order = 19, Surfaces = { pc = true, phone = true }, Width = 620, Height = 500 }
function News.build(container, ctx)
	local data = State.Data
	if not data then
		return
	end
	local s = UI.scroll(container, { Pad = 8 })
	UI.title(s, "📰 Diario de la Ciudad")
	local tr = data.Derived.Trends
	local headlines = {}
	for _, id in ipairs(tr.Hot or {}) do
		headlines[#headlines + 1] = "Furor por los vídeos de " .. catName(id):lower() .. ": el público pide más."
	end
	local w = workspace:GetAttribute("Weather") or "Clear"
	local wText = { Clear = "Cielo despejado: día ideal para grabar en exteriores.", Cloudy = "Nubes sobre la ciudad: luz suave para retratos.", Rain = "Lluvia en la ciudad: protege tu cámara.", Fog = "Niebla matinal: fotos misteriosas en el lago y el bosque.", Storm = "Tormenta pasajera: mejor grabar en interiores un rato." }
	headlines[#headlines + 1] = wText[w] or ""
	headlines[#headlines + 1] = "MegaTec y FotoPro amplían su catálogo con " .. #Catalog.Order .. " productos."
	headlines[#headlines + 1] = "Rumores de lugares secretos: vecinos hablan de destellos dorados en " .. #WorldData.Secrets .. " rincones."
	if data.Channel.Subs >= 100 then
		headlines[#headlines + 1] = "El canal «" .. (data.Channel.Name ~= "" and data.Channel.Name or player.DisplayName) .. "» supera los " .. Util.formatInt(data.Channel.Subs) .. " suscriptores."
	end
	for _, hl in ipairs(headlines) do
		local card = UI.card(s, { Height = 0, Auto = Enum.AutomaticSize.Y })
		UI.label(card, hl, { TextSize = 14, Height = 0, Auto = Enum.AutomaticSize.Y })
	end
end
table.insert(apps, News)

local Tasks = { Id = "tasks", Name = "Tareas", Icon = "✅", Order = 20, Surfaces = { pc = true, phone = true }, Width = 600, Height = 480 }
function Tasks.build(container, ctx)
	local function render()
		UI.clear(container)
		local data = State.Data
		if not data then
			return
		end
		local s = UI.scroll(container, { Pad = 6 })
		UI.title(s, "✅ Tus tareas")
		local items = {}
		local step = QuestDefs.Tutorial[data.Quests.Step]
		if step and not data.Quests.Skipped then
			items[#items + 1] = "🎓 " .. step.Name
		end
		for _, p in pairs(data.Projects) do
			if p.Status == "planning" then
				items[#items + 1] = "🎬 Graba escenas para «" .. p.Name .. "»"
			elseif p.Status == "recording" then
				items[#items + 1] = "🏠 Importa y edita «" .. p.Name .. "»"
			elseif p.Status == "editing" then
				items[#items + 1] = "⬆ Exporta «" .. p.Name .. "»"
			elseif p.Status == "exported" then
				items[#items + 1] = "🚀 Publica «" .. p.Name .. "» en ViewTube Studio"
			end
		end
		if data.Job and data.Job.Type then
			items[#items + 1] = "💼 Termina tu encargo de trabajo"
		end
		if data.Home.Debt > 0 then
			items[#items + 1] = "⚠ Paga la deuda del alquiler ($" .. data.Home.Debt .. ")"
		end
		local pending = 0
		for id in pairs(data.Quests.Completed) do
			if not data.Quests.Claimed[id] then
				pending = pending + 1
			end
		end
		if pending > 0 then
			items[#items + 1] = "🎁 Cobra " .. pending .. " recompensas en Misiones"
		end
		if #items == 0 then
			items[1] = "Todo al día. ¿Una nueva idea?"
		end
		for _, it in ipairs(items) do
			local card = UI.card(s, { Height = 0, Auto = Enum.AutomaticSize.Y })
			UI.label(card, it, { TextSize = 13 })
		end
	end
	render()
	ctx.onState(render)
end
table.insert(apps, Tasks)

