	Spots = { { Name = "Exposición de deportivos", X = 0, Z = 0, Tags = { "vehicle", "luxury" }, Interest = 11 },
		{ Name = "Aparcamiento de clásicos", X = -70, Z = 70, Tags = { "vehicle" }, Interest = 9 } } })
district({ Id = "port", Name = "Puerto", Col = 4, Row = 5, Ground = { 90, 90, 90 }, Material = "Concrete",
	Style = "containers", Count = 10, Palette = { { 200, 60, 50 }, { 50, 100, 180 }, { 230, 170, 40 } }, Trees = 0, Water = { X = 0, Z = 90, W = 260, D = 90 },
	Tags = { "water", "business", "travel" }, Noise = 6, Busy = 4,
	Spots = { { Name = "Grúas del puerto", X = -60, Z = -40, Tags = { "business", "water" }, Interest = 8 },
		{ Name = "Embarcadero del ferry", X = 60, Z = 30, Tags = { "travel", "water" }, Interest = 9 } } })
district({ Id = "coast", Name = "Zona costera", Col = 5, Row = 5, Ground = { 190, 180, 140 }, Material = "Sand",
	Style = "house", Count = 4, Palette = { { 250, 250, 245 }, { 120, 190, 220 } }, Trees = 8, Water = { X = 0, Z = 100, W = 260, D = 70 },
	Tags = { "beach", "tourism", "luxury" }, Noise = 3, Busy = 3,
	Specials = { { Type = "gas", Name = "Gasolinera Brisa Marina", X = -70, Z = -60 } },
	Spots = { { Name = "Paseo marítimo", X = 0, Z = 30, Tags = { "beach", "tourism" }, Interest = 10 },
		{ Name = "Faro de la costa", X = 90, Z = -60, Tags = { "tourism", "beach" }, Interest = 11 } } })
district({ Id = "beach", Name = "Playa", Col = 6, Row = 5, Ground = { 230, 210, 160 }, Material = "Sand",
	Style = "kiosk", Count = 3, Palette = { { 255, 200, 60 }, { 60, 200, 220 } }, Trees = 10, Water = { X = 0, Z = 85, W = 260, D = 100 },
	Tags = { "beach", "water", "fun", "tourism" }, Noise = 4, Busy = 6,
	Spots = { { Name = "Orilla de la playa", X = 0, Z = 20, Tags = { "beach", "water" }, Interest = 11 },
		{ Name = "Chiringuito", X = -70, Z = -50, Tags = { "beach", "food" }, Interest = 9 } } })

WorldData.Districts = D
WorldData.DistrictById = {}
for _, d in ipairs(D) do
	WorldData.DistrictById[d.Id] = d
end

function WorldData.totalSize()
	return WorldData.Cols * WorldData.CellSize, WorldData.Rows * WorldData.CellSize
end

-- Centro del distrito en coordenadas del mundo (x, z). El mapa está centrado en el origen.
function WorldData.center(d)
	local w, h = WorldData.totalSize()
	local x = -w / 2 + (d.Col - 0.5) * WorldData.CellSize
	local z = -h / 2 + (d.Row - 0.5) * WorldData.CellSize
	return x, z
end

function WorldData.districtAt(x, z)
	local w, h = WorldData.totalSize()
	local col = math.floor((x + w / 2) / WorldData.CellSize) + 1
	local row = math.floor((z + h / 2) / WorldData.CellSize) + 1
	for _, d in ipairs(D) do
		if d.Col == col and d.Row == row then
			return d
		end
	end
	return nil
end

-- Lista plana de lugares de grabación con posición absoluta.
WorldData.Spots = {}
for _, d in ipairs(D) do
	local cx, cz = WorldData.center(d)
	for i, s in ipairs(d.Spots) do
		local spot = {
			Id = d.Id .. "_" .. i,
			Name = s.Name,
			District = d.Id,
			X = cx + s.X,
			Z = cz + s.Z,
			Tags = s.Tags,
			Interest = s.Interest or 6,
			Noise = s.Noise or d.Noise or 3,
			Busy = s.Busy or d.Busy or 3,
			Indoor = s.Indoor or false,
		}
		WorldData.Spots[#WorldData.Spots + 1] = spot
	end
end

-- Lugares secretos: se descubren al acercarse.
WorldData.Secrets = {
	{ Id = "sec_peak", Name = "Mirador escondido", District = "mountains", X = -110, Z = -110, Reward = 250, Hint = "Lo más alto y apartado de las montañas." },
	{ Id = "sec_studio", Name = "Estudio abandonado", District = "industrial", X = -110, Z = 110, Reward = 300, Hint = "Una nave olvidada en la esquina del distrito industrial." },
	{ Id = "sec_cave", Name = "Cueva del lago", District = "lake", X = 115, Z = -110, Reward = 250, Hint = "Detrás de los árboles, al otro lado del lago." },
	{ Id = "sec_cove", Name = "Cala secreta", District = "beach", X = 120, Z = -115, Reward = 250, Hint = "Un rincón de la playa que casi nadie visita." },
	{ Id = "sec_garden", Name = "Jardín oculto", District = "luxury", X = -115, Z = 115, Reward = 300, Hint = "Tras las mansiones hay un jardín privado... ¿o no tanto?" },
	{ Id = "sec_arcade", Name = "Recreativa legendaria", District = "entertainment", X = 115, Z = 115, Reward = 300, Hint = "Una máquina de juegos que nadie recuerda." },
	{ Id = "sec_forest", Name = "Árbol milenario", District = "forest", X = -115, Z = 110, Reward = 250, Hint = "El árbol más viejo del bosque." },
	{ Id = "sec_dock", Name = "Barco fantasma", District = "port", X = 120, Z = -110, Reward = 300, Hint = "Un barco que nunca zarpa." },
}
for _, s in ipairs(WorldData.Secrets) do
	local cx, cz = WorldData.center(WorldData.DistrictById[s.District])
	s.WX = cx + s.X
	s.WZ = cz + s.Z
	-- El secreto también es un lugar de grabación especial
	WorldData.Spots[#WorldData.Spots + 1] = { Id = s.Id, Name = s.Name, District = s.District, X = s.WX, Z = s.WZ,
		Tags = { "tourism", "fun" }, Interest = 15, Noise = 1, Busy = 0, Indoor = false, Secret = true }
end

-- Lugares de grabación de los destinos de viaje (zonas lejos de la ciudad, fuera de la cuadrícula:
-- districtAt devuelve nil allí). District = id del destino y Dest = true (no son de la ciudad:
-- los encargos, el taxi y los repartos no los usan).
local LifeData = require(script.Parent.LifeData)
for _, dest in ipairs(LifeData.Destinations) do
	for i, s in ipairs(dest.Spots) do
		WorldData.Spots[#WorldData.Spots + 1] = { Id = "dest_" .. dest.Id .. "_" .. i, Name = s[1], District = dest.Id,
			X = dest.Center[1] + s[2], Z = dest.Center[2] + s[3], Tags = s[4], Interest = s[5] or 10,
			Noise = dest.Noise or 3, Busy = dest.Busy or 3, Indoor = false, Dest = true }
	end
end

WorldData.SpotById = {}
for _, s in ipairs(WorldData.Spots) do
	WorldData.SpotById[s.Id] = s
end

-- Lista de edificios especiales con posición absoluta.
WorldData.Specials = {}
for _, d in ipairs(D) do
	local cx, cz = WorldData.center(d)
	for _, sp in ipairs(d.Specials or {}) do
		local s = {}
		for k, v in pairs(sp) do
			s[k] = v
		end
		s.District = d.Id
		s.WX = cx + sp.X
		s.WZ = cz + sp.Z
		WorldData.Specials[#WorldData.Specials + 1] = s
	end
end

WorldData.SpawnDistrict = "budget"

return WorldData
]]></ProtectedString></Properties></Item></Item></Item><Item class="ServerScriptService" referent="RBX000062"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Folder" referent="RBX000024"><Properties><string name="Name">Server</string></Properties><Item class="Script" referent="RBX000025"><Properties><string name="Name">Main</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Main (Script de servidor): arranca todos los servicios en orden y gestiona la entrada de jugadores.

local Players = game:GetService("Players")
local Services = script.Parent:WaitForChild("Services")

local S = {}
local order = {
	{ "Net", "Net" },
	{ "Text", "TextFilter" },
	{ "Data", "DataService" },
	{ "Time", "TimeWeatherService" },
	{ "Economy", "EconomyService" },
	{ "Monetization", "MonetizationService" },
	{ "Progress", "ProgressService" },
	{ "Quest", "QuestService" },
	{ "Inventory", "InventoryService" },
	{ "Computer", "ComputerService" },
	{ "Shop", "ShopService" },
	{ "Travel", "TravelService" },
	{ "Property", "PropertyService" },
	{ "World", "WorldBuilder" },
	{ "Home", "HomeService" },
	{ "Avatar", "AvatarService" },
	{ "Needs", "NeedsService" },
	{ "Events", "EventService" },
	{ "Sponsor", "SponsorService" },
	{ "Live", "LiveService" },
	{ "Vehicle", "VehicleService" },
	{ "Studio", "StudioService" },
	{ "Leisure", "LeisureService" },
	{ "Video", "VideoService" },
	{ "Pet", "PetService" },
	{ "Collab", "CollabService" },
	{ "Channel", "ChannelService" },
	{ "Market", "MarketService" },
	{ "Trade", "TradeService" },
	{ "Jobs", "JobsService" },
	{ "Company", "CompanyService" },
	{ "Friend", "FriendService" },
	{ "NPC", "NPCService" },
	{ "Destination", "DestinationService" },
	{ "Sync", "SyncService" },
}

for _, entry in ipairs(order) do
	S[entry[1]] = require(Services:WaitForChild(entry[2]))
end
for _, entry in ipairs(order) do
	S[entry[1]].Init(S)
end
for _, entry in ipairs(order) do
	local ok, err = true, nil
	if S[entry[1]].Start then
		ok, err = pcall(S[entry[1]].Start)
	end
	if not ok then
		warn("[YTLife] Error al iniciar " .. entry[2] .. ": " .. tostring(err))
	end
end

local Catalog = require(game:GetService("ReplicatedStorage").Shared.ItemCatalog)
local Config = require(game:GetService("ReplicatedStorage").Shared.Config)

local function giveStarterKit(player)
	local data = S.Data.get(player)
	local phone = S.Inventory.add(player, "phone_basic", { src = "starter", paid = 0 })
	data.Equipped.Phone = phone
	S.Inventory.add(player, "tripod_basic", { src = "starter", paid = 10 })
	S.Inventory.add(player, "mon_22", { src = "starter", paid = 40 })
	S.Inventory.add(player, "kb_basic", { src = "starter", paid = 5 })
	S.Inventory.add(player, "mouse_basic", { src = "starter", paid = 5 })
	S.Inventory.add(player, "chair_basic", { src = "starter", paid = 15 })
	S.Computer.createRigFromPrebuilt(player, Catalog.get("pc_old"), { src = "starter", paid = 150 })
	data.Counters.items_bought = 0
	S.Net.notify(player, "📱 Recibiste un teléfono básico y una habitación con un computador viejo.", "success")
end

local function onPlayerAdded(player)
	player.CharacterAdded:Connect(function(char)
		if S.Data.get(player) then
			S.Avatar.onCharacter(player, char)
		end
	end)
	local profile = S.Data.load(player)
	if not profile or not player.Parent then
		return
	end
	S.Monetization.onPlayerReady(player)
	S.Home.onPlayerReady(player)
	local data = profile.Data
	if next(data.Inventory) == nil then
		giveStarterKit(player)
	end
	-- Crecimiento de los vídeos mientras estaba desconectado (limitado)
	S.Channel.tickPlayer(player, Config.OfflineCatchUpHours * 3600)
	data.LastSeen = os.time()
	S.Shop.processOrders(player)
	pcall(S.Sponsor.refreshOffers, player)
	S.Quest.check(player)
	if player.Character then
		task.spawn(S.Avatar.onCharacter, player, player.Character)
	end
	S.Sync.send(player)
	S.Net.push(player, "ready", { isNew = profile.IsNew, readOnly = profile.ReadOnly })
	if profile.ReadOnly then
		S.Net.notify(player, "Modo de prueba en Studio: el progreso NO se guardará. Activa «Enable Studio Access to API Services» para guardar.", "warn")
	end
end

Players.PlayerAdded:Connect(function(player)
	local ok, err = pcall(onPlayerAdded, player)
	if not ok then
		S.Net.logError("PlayerAdded", err)
	end
end)
for _, player in ipairs(Players:GetPlayers()) do
	task.spawn(onPlayerAdded, player)
end

Players.PlayerRemoving:Connect(function(player)
	S.Computer.close(player)
	S.Data.release(player)
end)

print("[YTLife] Servidor listo: " .. Config.GameName .. " v" .. Config.Version)
]]></ProtectedString></Properties></Item><Item class="Folder" referent="RBX000026"><Properties><string name="Name">Services</string></Properties><Item class="ModuleScript" referent="RBX000027"><Properties><string name="Name">AvatarService</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- AvatarService: aparición en casa, apariencia (colores de ropa) y cartel sobre la cabeza
-- (nombre, rango, título y suscriptores). Respeta el avatar de Roblox si el jugador lo prefiere.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage.Shared
local Util = require(Shared.Util)
local VideoData = require(Shared.VideoData)

local Avatar = {}
local S

-- Colores disponibles para ropa (no se cambia el tono de piel)
Avatar.Colors = {
	{ 240, 240, 240 }, { 30, 30, 35 }, { 200, 40, 40 }, { 40, 90, 200 }, { 50, 160, 90 }, { 250, 200, 40 },
	{ 255, 120, 0 }, { 140, 70, 200 }, { 255, 110, 170 }, { 120, 85, 60 }, { 90, 100, 110 }, { 0, 170, 190 },
}

function Avatar.Init(services)
	S = services
end

local function rgb(t)
	return Color3.fromRGB(t[1], t[2], t[3])
end

function Avatar.applyAppearance(player)
	local data = S.Data.get(player)
	local char = player.Character
	if not data or not char then
		return
	end
	local a = data.Appearance
	if a.Mode ~= "custom" then
		return
	end
	for _, c in ipairs(char:GetChildren()) do
		if c:IsA("Shirt") or c:IsA("Pants") or c:IsA("ShirtGraphic") then
			c:Destroy()
		end
	end
	local shirt = rgb(Avatar.Colors[a.Shirt] or Avatar.Colors[5])
	local pants = rgb(Avatar.Colors[a.Pants] or Avatar.Colors[2])
	for _, part in ipairs(char:GetChildren()) do
		if part:IsA("BasePart") then
			local n = part.Name
			if n == "UpperTorso" or n == "LowerTorso" or n == "Torso" or n:find("UpperArm") or n == "Left Arm" or n == "Right Arm" then
				part.Color = shirt
			elseif n:find("Leg") or n:find("Foot") then
				part.Color = pants
			end
		end
	end
	local bc = char:FindFirstChildOfClass("BodyColors")
	if bc then
		bc.TorsoColor3 = shirt
		bc.LeftLegColor3 = pants
		bc.RightLegColor3 = pants
	end
end

function Avatar.refreshOverhead(player)
	local data = S.Data.get(player)
	local char = player.Character
	local head = char and char:FindFirstChild("Head")
	if not data or not head then
		return
	end
	local gui = head:FindFirstChild("CreatorTag")
	if not gui then
		gui = Instance.new("BillboardGui")
		gui.Name = "CreatorTag"
		gui.Size = UDim2.fromOffset(220, 64)
		gui.StudsOffset = Vector3.new(0, 2.6, 0)
		gui.MaxDistance = 80
		gui.AlwaysOnTop = false
		gui.Parent = head
		local name = Instance.new("TextLabel")
		name.Name = "NameLabel"
		name.BackgroundTransparency = 1
		name.Size = UDim2.new(1, 0, 0.45, 0)
		name.Font = Enum.Font.GothamBlack
		name.TextScaled = true
		name.TextColor3 = Color3.new(1, 1, 1)
		name.TextStrokeTransparency = 0.4
		name.Parent = gui
		local sub = Instance.new("TextLabel")
		sub.Name = "SubLabel"
		sub.BackgroundTransparency = 1
		sub.Position = UDim2.new(0, 0, 0.45, 0)
		sub.Size = UDim2.new(1, 0, 0.3, 0)
		sub.Font = Enum.Font.GothamBold
		sub.TextScaled = true
		sub.TextColor3 = Color3.fromRGB(255, 214, 0)
		sub.TextStrokeTransparency = 0.5
		sub.Parent = gui
		local title = Instance.new("TextLabel")
		title.Name = "TitleLabel"
		title.BackgroundTransparency = 1
		title.Position = UDim2.new(0, 0, 0.75, 0)
		title.Size = UDim2.new(1, 0, 0.25, 0)
		title.Font = Enum.Font.GothamMedium
		title.TextScaled = true
		title.TextColor3 = Color3.fromRGB(150, 220, 255)
		title.TextStrokeTransparency = 0.5
		title.Parent = gui
	end
	local _, rank = S.Progress.rank(data)
	local channel = data.Channel.Name ~= "" and data.Channel.Name or player.DisplayName
	local vip = S.Monetization.owns(player, "VIP") and "⭐ " or ""
	gui.NameLabel.Text = vip .. VideoData.Avatars[data.Channel.Avatar] .. " " .. channel
	gui.SubLabel.Text = rank.Name .. " · " .. Util.formatShort(data.Channel.Subs) .. " subs"
	gui.TitleLabel.Text = data.EquippedTitle ~= "" and ("«" .. data.EquippedTitle .. "»") or ""
	-- ocultar el nombre por defecto de Roblox
	local hum = char:FindFirstChildOfClass("Humanoid")
	if hum then
		hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	end
end

function Avatar.onCharacter(player, char)
	local hum = char:WaitForChild("Humanoid", 10)
	char:WaitForChild("HumanoidRootPart", 10)
	if not hum then
		return
	end
	hum.WalkSpeed = 18
	local cf = S.Home.spawnCFrame(player)
	if cf then
		task.wait(0.1)
		char:PivotTo(cf)
	end
	Avatar.applyAppearance(player)
	Avatar.refreshOverhead(player)
end

function Avatar.Start()
	local Net = S.Net

	Net.on("Style.Set", function(player, p)
		local data = S.Data.get(player)
		local a = data.Appearance
		if p.mode == "roblox" then
			a.Mode = "roblox"
			a.Chosen = true
			S.Quest.tutorialEvent(player, "appearance")
			player:LoadCharacter()
			return true, "Usarás tu avatar de Roblox."
		end
		local shirt, pants = tonumber(p.shirt), tonumber(p.pants)
		if not shirt or not pants or not Avatar.Colors[shirt] or not Avatar.Colors[pants] then
			return false, "Colores no válidos."
		end
		a.Mode = "custom"
		a.Shirt, a.Pants = shirt, pants
		a.Chosen = true
		Avatar.applyAppearance(player)
		S.Quest.tutorialEvent(player, "appearance")
		return true, "¡Nuevo estilo aplicado!"
	end)

	local settingRules = {
		Music = { "number", 0, 1 }, Sfx = { "number", 0, 1 }, UIScale = { "number", 0.7, 1.4 }, Wallpaper = { "number", 1, 5 },
		ReduceMotion = { "boolean" }, Hints = { "boolean" }, Shadows = { "boolean" },
	}
	Net.on("Settings.Set", function(player, p)
		local data = S.Data.get(player)
		local rule = settingRules[p.key or ""]
		if not rule or type(p.value) ~= rule[1] then
			return false, "Ajuste no válido."
		end
		local v = p.value
		if rule[1] == "number" then
			v = math.clamp(v, rule[2], rule[3])
			if p.key == "Wallpaper" then
				v = math.floor(v)
			end
		end
		data.Settings[p.key] = v
		return true, "Ajuste guardado."
	end)

	Net.on("Style.SaveOutfit", function(player, p)
		local data = S.Data.get(player)
		local slot = tonumber(p.slot)
		if not slot or slot < 1 or slot > 3 then
			return false, "Espacio no válido."
		end
		data.Appearance.Outfits = data.Appearance.Outfits or {}
		data.Appearance.Outfits[tostring(slot)] = { Shirt = data.Appearance.Shirt, Pants = data.Appearance.Pants }
		return true, "Conjunto guardado en el espacio " .. slot .. "."
	end)
end

return Avatar
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000028"><Properties><string name="Name">ChannelService</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- ChannelService: crecimiento progresivo de cada vídeo publicado (visitas, me gusta, comentarios,
-- suscriptores, ingresos), tendencias diarias, competencia, programa de socios y ajustes del canal.
-- Las cifras siguen curvas con límite (VideoFormulas.expectedViews), nunca números aleatorios absurdos.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local VideoData = require(Shared.VideoData)
local F = require(Shared.VideoFormulas)
local Util = require(Shared.Util)

local Channel = {}
local S
local trends = { Hot = {}, Cold = "", Competition = 0.95, Day = 0 }
local commenters = { "AnaVlogs", "PixelPedro", "LuciaTech", "Mateo_Viajes", "SofiCocina", "Leo2010", "CreadorX", "MarioFoto", "NoraGamer", "TomásReseñas", "Valen_Moda", "Diego_Motor" }

function Channel.Init(services)
	S = services
end

-- Categorías en tendencia (y la que está de capa caída) de un día concreto. Es determinista:
-- FriendService lo usa para que un amigo te avise de las tendencias de mañana.
function Channel.trendsFor(day)
	local ids = {}
	for _, c in ipairs(VideoData.Categories) do
		ids[#ids + 1] = c.Id
	end
	local hot = {}
	local salt = 0
	while #hot < 3 and salt < 100 do
		local idx = (Util.hashString("hot" .. day .. ":" .. salt) % #ids) + 1
		if not Util.indexOf(hot, ids[idx]) then
			hot[#hot + 1] = ids[idx]
		end
		salt = salt + 1
	end
	local cold = ids[(Util.hashString("cold" .. day) % #ids) + 1]
	if Util.indexOf(hot, cold) then
		cold = ""
	end
	return hot, cold
end

function Channel.onNewDay(day)
	trends.Day = day
	local hot, cold = Channel.trendsFor(day)
	trends.Hot = hot
	trends.Cold = cold
	trends.Competition = Util.seededRandom("comp" .. day, 0.85, 1.0)
	workspace:SetAttribute("TrendHot", table.concat(hot, ","))
	for _, player in ipairs(Players:GetPlayers()) do
		S.Data.markDirty(player)
	end
end

function Channel.trends()
	return trends
end

function Channel.trendFor(categoryId)
	if Util.indexOf(trends.Hot, categoryId) then
		return 1.4
	elseif trends.Cold == categoryId then
		return 0.85
	end
	return 1
end

function Channel.competition()
	return trends.Competition
end

local function pickComment(video, n)
	local pool = video.Q >= 70 and VideoData.Comments.high or (video.Q >= 40 and VideoData.Comments.mid or VideoData.Comments.low)
	local h = Util.hashString(video.Id .. ":" .. n)
	return { U = commenters[(h % #commenters) + 1], Txt = pool[(math.floor(h / 7) % #pool) + 1] }
end

-- Avanza las estadísticas de todos los vídeos del jugador hasta "ahora" (máximo `capSeconds` de retraso).
function Channel.tickPlayer(player, capSeconds)
	local data = S.Data.get(player)
	if not data then
		return
	end
	local now = os.time()
	local ch = data.Channel
	local partner = ch.Monetized
	local totalRevenue, totalNew = 0, 0
	for _, v in ipairs(data.Videos) do
		local age = now - v.At
		if capSeconds and data.LastSeen > 0 and v.At < data.LastSeen then
			-- recuperación tras estar desconectado: se limita el tiempo que cuenta
			local offline = now - data.LastSeen
			if offline > capSeconds then
				age = age - (offline - capSeconds)
			end
		end
		local minutes = math.max(0, age / 60)
		local target = v.Expected * F.viewCurve(minutes, Config.ViewCurveMinutes)
		-- cola larga: vídeos de calidad siguen sumando un poco durante varios días
		local days = minutes / (Config.DayLengthSeconds / 60)
		if v.Q >= 50 then
			target = target + v.Expected * 0.05 * math.min(days, 7) * (v.Q / 100)
		end
		target = math.floor(target)
		local new = target - v.Views
		if new > 0 then
			v.Views = target
			totalNew = totalNew + new
			local rate = F.likeRate(v.Q)
			v.Likes = math.floor(v.Views * rate)
			local comments = math.floor(v.Views * 0.004)
			while v.Comments < comments do
				v.Comments = v.Comments + 1
				if #v.CommentList < 6 then
					table.insert(v.CommentList, pickComment(v, v.Comments))
				end
			end
			local subs = new * F.subConversion(v.Q) * (v.SubMult or 1)
			ch.SubFrac = ch.SubFrac + subs
			local whole = math.floor(ch.SubFrac)
			ch.SubFrac = ch.SubFrac - whole
			ch.Subs = ch.Subs + whole
			v.SubsGained = (v.SubsGained or 0) + whole
			local rev = new * F.revenuePerView(v.Cat, partner) * (v.RpmMult or 1)
			if v.Unlisted then
				rev = 0
			end
			v.Revenue = Util.round((v.Revenue or 0) + rev, 2)
			-- Vídeo colaborativo: la parte del colaborador sale de lo que genera este vídeo, solo si ambos están conectados
			if v.Collab and S.Collab and not capSeconds and rev > 0 then
				rev = rev - S.Collab.payShare(player, v, rev)
			end
			totalRevenue = totalRevenue + rev
			ch.TotalViews = ch.TotalViews + new
		end
		-- historial (un punto cada 2 minutos durante las primeras horas)
		local slot = math.floor(minutes / 2)
		if slot < Config.HistoryPoints and (#v.Hist <= slot) then
			while #v.Hist <= slot do
				table.insert(v.Hist, v.Views)
			end
		end
	end
	ch.PendingRev = (ch.PendingRev or 0) + totalRevenue
	if ch.PendingRev >= 1 then
		local pay = math.floor(ch.PendingRev)
		ch.PendingRev = ch.PendingRev - pay
		ch.TotalRevenue = ch.TotalRevenue + pay
		S.Economy.add(player, pay, "Ingresos de vídeos", partner and "Publicidad del canal" or "Fondo para creadores", { taxable = true, silent = pay < 5 })
	end
	if not ch.Monetized and ch.Subs >= Config.PartnerSubs and (data.Counters.published or 0) >= Config.PartnerVideos then
		ch.Monetized = true
		S.Net.notify(player, "🎉 ¡Ya eres socio del programa de creadores! Tus vídeos ganan más por cada visita.", "success")
	end
	if totalNew > 0 then
		S.Data.markDirty(player)
		S.Quest.check(player)
	end
end

function Channel.Start()
	Channel.onNewDay(S.Time.day())
	local Net = S.Net

	Net.on("Channel.Update", function(player, p)
		local data = S.Data.get(player)
		local ch = data.Channel
		if p.name ~= nil then
			local name = Util.cleanText(p.name, 30)
			if not name or #name < 3 then
				return false, "El nombre del canal necesita al menos 3 caracteres."
			end
			local f = S.Text.filter(player, name)
			if not f then
				return false, "Ese nombre no está permitido."
			end
			ch.Name = f
		end
		if p.description ~= nil then
			local d = Util.cleanText(p.description, 200) or ""
			local f = S.Text.filter(player, d)
			if not f then
				return false, "No se pudo comprobar la descripción."
			end
			ch.Description = f
		end
		local banners = #VideoData.Banners
		local avatars = #VideoData.Avatars
		if tonumber(p.banner) then
			ch.Banner = Util.clamp(math.floor(tonumber(p.banner)), 1, banners)
		end
		if tonumber(p.avatar) then
			ch.Avatar = Util.clamp(math.floor(tonumber(p.avatar)), 1, avatars)
		end
		S.Avatar.refreshOverhead(player)
		return true, "Canal actualizado."
	end)

	Net.on("Channel.OpenAnalytics", function(player)
		S.Quest.tutorialEvent(player, "open_analytics")
		return true
	end)

	task.spawn(function()
		while true do
			task.wait(Config.StatsTickSeconds)
			for _, player in ipairs(Players:GetPlayers()) do
				local ok, err = pcall(Channel.tickPlayer, player)
				if not ok then
					S.Net.logError("channel", err)
				end
			end
		end
	end)
end

return Channel
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000029"><Properties><string name="Name">CollabService</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- CollabService: colaboraciones entre jugadores en proyectos de vídeo.
--  * El dueño invita a un jugador cercano (≤ 25 studs) a UNO de sus proyectos, con reparto (0-50 % para el invitado)
--    y permisos: grabar (escenas en el proyecto del dueño estando a ≤ 40 studs de él) y editar (mover/quitar clips).
--    Publicar es SIEMPRE exclusivo del dueño. La invitación caduca a los 60 s.
--  * Las colaboraciones viven solo en la sesión: se cancelan si uno sale del juego. Nunca se transfieren objetos ni
--    proyectos; el dueño conserva el proyecto (y las escenas grabadas por el invitado, marcadas con By = userId).
--  * Al publicar, el vídeo guarda Collab = { userId, name, share } y, si el invitado grabó al menos una escena,
--    gana +10 % de visitas esperadas y +15 % de conversión a suscriptores. ChannelService paga la parte del
--    colaborador (sacada de lo que genera ese vídeo, nunca más) solo mientras ambos están conectados.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage.Shared
local VideoData = require(Shared.VideoData)
local Util = require(Shared.Util)

local Collab = {}
local S

Collab.InviteRadius = 25
Collab.RecordRadius = 40
Collab.InviteSeconds = 60
Collab.MaxShare = 50
Collab.MaxActive = 3
Collab.ViewBonus = 1.10
Collab.SubBonus = 1.15
Collab.LogMax = 30

local invites = {} -- [id] = { Id, From, To, Pid, Share, Perms, Created }
local active = {} -- [id] = { Id, Owner, Guest, Pid, Share, Perms, Started }
local lastInvite = {}
local nextId = 0

function Collab.Init(services)
	S = services
end

local function nameOf(p)
	return p.DisplayName or p.Name
end

local function online(p)
	return p ~= nil and p.Parent ~= nil and S.Data.get(p) ~= nil
end

local function dist(a, b)
	local ra = a.Character and a.Character:FindFirstChild("HumanoidRootPart")
	local rb = b.Character and b.Character:FindFirstChild("HumanoidRootPart")
	if not ra or not rb then
		return math.huge
	end
	local pa, pb = ra.Position, rb.Position
	local dx, dy, dz = pa.X - pb.X, pa.Y - pb.Y, pa.Z - pb.Z
	return math.sqrt(dx * dx + dy * dy + dz * dz)
end

local function byUserId(id)
	for _, p in ipairs(Players:GetPlayers()) do
		if p.UserId == id and S.Data.get(p) then
			return p
		end
	end
end

local function projectOf(owner, pid)
	local data = online(owner) and S.Data.get(owner)
	return data and type(pid) == "string" and data.Projects[pid] or nil
end

local function permsText(perms)
	return (perms.record and "grabar" or "") .. (perms.record and perms.edit and " y " or "") .. (perms.edit and "editar" or "")
end

local function dirty(...)
	for _, p in ipairs({ ... }) do
		if online(p) then
			S.Data.markDirty(p)
		end
	end
end

local function countFor(player)
	local n = 0
	for _, c in pairs(active) do
		if c.Owner == player or c.Guest == player then
			n = n + 1
		end
	end
	return n
end

local function findActive(ownerUserId, pid)
	for _, c in pairs(active) do
		if c.Owner.UserId == ownerUserId and c.Pid == pid then
			return c
		end
	end
end

function Collab.get(id)
	return active[tonumber(id) or -1]
end

local function endCollab(c, msgOwner, msgGuest, style)
	if active[c.Id] ~= c then
		return
	end
	active[c.Id] = nil
	if msgOwner and online(c.Owner) then
		S.Net.notify(c.Owner, msgOwner, style or "warn")
	end
	if msgGuest and online(c.Guest) then
		S.Net.notify(c.Guest, msgGuest, style or "warn")
	end
	dirty(c.Owner, c.Guest)
end

local function dropInvite(inv, msgFrom, msgTo, style)
	if invites[inv.Id] ~= inv then
		return
	end
	invites[inv.Id] = nil
	if msgFrom and online(inv.From) then
		S.Net.notify(inv.From, msgFrom, style or "info")
	end
	if msgTo and online(inv.To) then
		S.Net.notify(inv.To, msgTo, style or "info")
	end
	dirty(inv.From, inv.To)
end

local function expired(inv)
	return os.time() - inv.Created > Collab.InviteSeconds
end

---------------------------------------------------------------------------
-- Vista para el cliente (Derived.Collab)
---------------------------------------------------------------------------
function Collab.view(player)
	local v = {
		Incoming = {},
		Outgoing = {},
		Active = {},
		InviteRadius = Collab.InviteRadius,
		RecordRadius = Collab.RecordRadius,
		MaxShare = Collab.MaxShare,
		InviteSeconds = Collab.InviteSeconds,
	}
	local now = os.time()
	for _, inv in pairs(invites) do
		if inv.To == player or inv.From == player then
			local proj = projectOf(inv.From, inv.Pid)
			local cat = proj and VideoData.CategoryById[proj.Category]
			local e = {
				Id = inv.Id,
				Pid = inv.Pid,
				Project = proj and proj.Name or "?",
				Category = cat and cat.Name or "",
				Share = inv.Share,
				Perms = { record = inv.Perms.record, edit = inv.Perms.edit },
				Left = math.max(0, inv.Created + Collab.InviteSeconds - now),
			}
			if inv.To == player then
				e.From, e.FromId = nameOf(inv.From), inv.From.UserId
				table.insert(v.Incoming, e)
			else
				e.To, e.ToId = nameOf(inv.To), inv.To.UserId
				table.insert(v.Outgoing, e)
			end
		end
	end
	for _, c in pairs(active) do
		if c.Owner == player or c.Guest == player then
			local proj = projectOf(c.Owner, c.Pid)
			local isOwner = c.Owner == player
			local partner = isOwner and c.Guest or c.Owner
			local e = {
				Id = c.Id,
				Role = isOwner and "owner" or "guest",
				Partner = nameOf(partner),
				PartnerId = partner.UserId,
				OwnerId = c.Owner.UserId,
				Pid = c.Pid,
				Project = proj and proj.Name or "?",
				Status = proj and proj.Status or "",
				Share = c.Share,
				Perms = { record = c.Perms.record, edit = c.Perms.edit },
				CanEdit = isOwner or c.Perms.edit,
				Dist = math.floor(math.min(9999, dist(c.Owner, c.Guest)) + 0.5),
				Scenes = {},
				Timeline = {},
				Mine = 0,
				Theirs = 0,
			}
			if proj then
				local names = {}
				for _, sc in ipairs(proj.Scenes) do
					local by = sc.By or c.Owner.UserId
					local byName = by == c.Guest.UserId and nameOf(c.Guest) or nameOf(c.Owner)
					local shot = VideoData.ShotById[sc.Shot]
					local label = (shot and shot.Name or sc.Shot) .. " en " .. tostring(sc.SpotName)
					names[sc.Id] = label .. " (" .. byName .. ")"
					table.insert(e.Scenes, { Id = sc.Id, Name = label, Q = math.floor(sc.Q or 0), By = by, ByName = byName })
					if by == player.UserId then
						e.Mine = e.Mine + 1
					else
						e.Theirs = e.Theirs + 1
					end
				end
				for i, clip in ipairs(proj.Edit and proj.Edit.Timeline or {}) do
					table.insert(e.Timeline, { Index = i, Name = clip.k == "s" and (names[clip.id] or "Escena") or "📷 Foto" })
				end
			end
			table.insert(v.Active, e)
		end
	end
	local function byId(a, b)
		return a.Id < b.Id
	end
	table.sort(v.Incoming, byId)
	table.sort(v.Outgoing, byId)
	table.sort(v.Active, byId)
	return v
end

---------------------------------------------------------------------------
-- Ganchos para VideoService y ChannelService
---------------------------------------------------------------------------
-- ¿Puede `player` grabar ahora en el proyecto `pid` del jugador `ownerUserId`? → ok, error, proyecto, dueño
function Collab.canRecord(player, ownerUserId, pid)
	local c = findActive(tonumber(ownerUserId) or -1, pid)
	if not c or c.Guest ~= player then
		return false, "No colaboras en ese proyecto."
	end
	local proj = projectOf(c.Owner, pid)
	if not proj then
		return false, "Ese proyecto ya no existe."
	end
	if not c.Perms.record then
		return false, "El dueño no te ha dado permiso para grabar en «" .. proj.Name .. "»."
	end
	if dist(player, c.Owner) > Collab.RecordRadius then
		return false, "Tienes que estar cerca de " .. nameOf(c.Owner) .. " (máximo " .. Collab.RecordRadius .. " studs) para grabar en su proyecto."
	end
	return true, nil, proj, c.Owner
end

-- Escena grabada por el invitado en el proyecto del dueño
function Collab.onScene(guest, owner, proj, scene)
	S.Net.notify(owner, "🤜 " .. nameOf(guest) .. " grabó «" .. tostring(scene.SpotName) .. "» para «" .. proj.Name .. "».", "info")
	dirty(owner)
end

-- Datos de colaboración que guardará el vídeo al publicar (o nil si no hay colaborador activo)
function Collab.forPublish(player, pid, proj)
	local c = findActive(player.UserId, pid)
	if not c or c.Owner ~= player or not online(c.Guest) then
		return nil
	end
	local scenes = 0
	for _, sc in ipairs(proj.Scenes) do
		if sc.By == c.Guest.UserId then
			scenes = scenes + 1
		end
	end
	return { userId = c.Guest.UserId, name = nameOf(c.Guest), share = c.Share, bonus = scenes > 0, scenes = scenes, paid = 0 }
end

local function addLog(data, entry)
	data.CollabLog = data.CollabLog or {}
	table.insert(data.CollabLog, 1, entry)
	while #data.CollabLog > Collab.LogMax do
		table.remove(data.CollabLog)
	end
end

local function bumpLog(data, vid, withId, amount)
	for _, e in ipairs(data.CollabLog or {}) do
		if e.Vid == vid and e.WithId == withId then
			e.Amount = (e.Amount or 0) + amount
			return
		end
	end
end

-- El dueño publicó el proyecto: termina la colaboración y queda en el historial de ambos
function Collab.onPublished(owner, pid, video)
	local c = findActive(owner.UserId, pid)
	if not c then
		return
	end
	active[c.Id] = nil
	local info = video.Collab
	local od, gd = S.Data.get(owner), S.Data.get(c.Guest)
	local base = { Vid = video.Id, Title = video.Title, Share = c.Share, Amount = 0, At = os.time(), Bonus = info and info.bonus or false }
	if od then
		local e = Util.deepCopy(base)
		e.Role, e.With, e.WithId = "owner", nameOf(c.Guest), c.Guest.UserId
		addLog(od, e)
		od.Counters.collabs = (od.Counters.collabs or 0) + 1
	end
	if gd then
		local e = Util.deepCopy(base)
		e.Role, e.With, e.WithId = "guest", nameOf(owner), owner.UserId
		addLog(gd, e)
		gd.Counters.collabs = (gd.Counters.collabs or 0) + 1
		S.Net.notify(c.Guest, "🎉 " .. nameOf(owner) .. " publicó «" .. video.Title .. "», vuestro vídeo colaborativo"
			.. (c.Share > 0 and (". Cobrarás el " .. c.Share .. " % de sus ingresos mientras los dos estéis conectados.") or "."), "success")
		S.Quest.check(c.Guest)
	end
	dirty(owner, c.Guest)
end

-- Reparto en el tick de ingresos: devuelve la parte de `rev` que corresponde al colaborador (0 si no está conectado)
function Collab.payShare(owner, v, rev)
	local info = v.Collab
	if not info or (tonumber(info.share) or 0) <= 0 or rev <= 0 then
		return 0
	end
	local guest = byUserId(info.userId)
	if not guest or guest == owner or not online(owner) then
		return 0
	end
	local part = math.min(rev, rev * Util.clamp(info.share, 0, Collab.MaxShare) / 100)
	info.pend = (info.pend or 0) + part
	if info.pend >= 1 then
		local pay = math.floor(info.pend)
		info.pend = info.pend - pay
		info.paid = (info.paid or 0) + pay
		local od, gd = S.Data.get(owner), S.Data.get(guest)
		S.Economy.add(guest, pay, "Colaboraciones", "Parte de «" .. tostring(v.Title) .. "» (colab con " .. nameOf(owner) .. ")", { taxable = true, silent = pay < 5 })
		gd.Counters.collab_earned = (gd.Counters.collab_earned or 0) + pay
		od.Counters.collab_paid = (od.Counters.collab_paid or 0) + pay
		bumpLog(gd, v.Id, owner.UserId, pay)
		bumpLog(od, v.Id, guest.UserId, pay)
		dirty(owner, guest)
	end
	return part
end

---------------------------------------------------------------------------
-- Comprobación periódica: invitaciones caducadas, jugadores que se van, proyectos borrados
---------------------------------------------------------------------------
function Collab.tick()
	for _, inv in pairs(invites) do
		if not online(inv.From) or not online(inv.To) then
			dropInvite(inv, "🤜 La invitación a colaborar se canceló: el otro jugador se ha ido.", "🤜 La invitación a colaborar se canceló: el otro jugador se ha ido.")
		elseif expired(inv) then
			dropInvite(inv, "🤜 " .. nameOf(inv.To) .. " no respondió: la invitación caducó.", "🤜 La invitación de " .. nameOf(inv.From) .. " caducó.")
		elseif not projectOf(inv.From, inv.Pid) then
			dropInvite(inv, nil, "🤜 La invitación de " .. nameOf(inv.From) .. " se canceló: el proyecto ya no existe.")
		end
	end
	for _, c in pairs(active) do
		if not online(c.Owner) or not online(c.Guest) then
			endCollab(c, "🤜 Colaboración terminada: " .. nameOf(c.Guest) .. " se ha ido.", "🤜 Colaboración terminada: " .. nameOf(c.Owner) .. " se ha ido.")
		elseif not projectOf(c.Owner, c.Pid) then
			endCollab(c, nil, "🤜 Colaboración terminada: " .. nameOf(c.Owner) .. " borró el proyecto.")
		end
	end
end

local function ownedCollab(player, id)
	local c = Collab.get(id)
	if not c or c.Owner ~= player then
		return nil, "No eres el dueño de esa colaboración."
	end
	return c
end

local function readPerms(p)
	return { record = p.record == true, edit = p.edit == true }
end

function Collab.Start()
	local Net = S.Net

	Net.on("Collab.Nearby", function(player)
		local list = {}
		for _, o in ipairs(Players:GetPlayers()) do
			if o ~= player and online(o) then
				local d = dist(player, o)
				if d <= Collab.InviteRadius then
					list[#list + 1] = { userId = o.UserId, name = nameOf(o), dist = math.floor(d + 0.5), busy = countFor(o) >= Collab.MaxActive }
				end
			end
		end
		table.sort(list, function(a, b)
			return a.dist < b.dist
		end)
		return true, nil, { players = list }
	end)

	Net.on("Collab.Invite", function(player, p)
		local data = S.Data.get(player)
		local target = byUserId(math.floor(tonumber(p.userId) or 0))
		if not target or not online(target) then
			return false, "Ese jugador no está disponible."
		end
		if target == player then
			return false, "No puedes colaborar contigo mismo."
		end
		local proj = type(p.pid) == "string" and data.Projects[p.pid] or nil
		if not proj then
			return false, "Elige uno de tus proyectos."
		end
		if p.publish == true then
			return false, "Publicar es siempre exclusivo del dueño: ese permiso no se puede dar."
		end
		local share = tonumber(p.share)
		if not share or share ~= share or share < 0 or share > Collab.MaxShare then
			return false, "El reparto para el colaborador debe estar entre 0 y " .. Collab.MaxShare .. " %."
		end
		share = math.floor(share)
		if findActive(player.UserId, p.pid) then
			return false, "Ese proyecto ya tiene colaborador."
		end
		for _, inv in pairs(invites) do
			if inv.From == player and inv.Pid == p.pid then
				return false, "Ya hay una invitación pendiente para ese proyecto."
			end
		end
		if countFor(player) >= Collab.MaxActive then
			return false, "Ya tienes " .. Collab.MaxActive .. " colaboraciones activas."
		end
		if countFor(target) >= Collab.MaxActive then
			return false, nameOf(target) .. " ya tiene demasiadas colaboraciones."
		end
		if dist(player, target) > Collab.InviteRadius then
			return false, "Acércate a " .. nameOf(target) .. " (máximo " .. Collab.InviteRadius .. " studs) para invitarle."
		end
		if lastInvite[player] and os.clock() - lastInvite[player] < 2 then
			return false, "Espera un momento antes de enviar otra invitación."
		end
		lastInvite[player] = os.clock()
		nextId = nextId + 1
		local perms = readPerms(p)
		local inv = { Id = nextId, From = player, To = target, Pid = p.pid, Share = share, Perms = perms, Created = os.time() }
		invites[inv.Id] = inv
		local pt = permsText(perms)
		S.Net.notify(target, "🤜 " .. nameOf(player) .. " te invita a colaborar en «" .. proj.Name .. "» (" .. share .. " % de los ingresos para ti"
			.. (pt ~= "" and (", puedes " .. pt) or "") .. "). Abre la app Colaborar.", "info")
		dirty(target)
		return true, "Invitación enviada a " .. nameOf(target) .. " (caduca en " .. Collab.InviteSeconds .. " s).", { id = inv.Id }
	end)

	Net.on("Collab.Respond", function(player, p)
		local inv = invites[tonumber(p.id) or -1]
		if not inv or inv.To ~= player then
			return false, "No tienes esa invitación."
		end
		if expired(inv) then
			dropInvite(inv, "🤜 La invitación a " .. nameOf(player) .. " caducó.", nil)
			return false, "La invitación ha caducado."
		end
		if not online(inv.From) then
			dropInvite(inv)
			return false, "Esa persona ya no está."
		end
		if p.accept ~= true then
			dropInvite(inv, "🤜 " .. nameOf(player) .. " rechazó colaborar contigo.", nil)
			return true, "Invitación rechazada."
		end
		local proj = projectOf(inv.From, inv.Pid)
		if not proj then
			dropInvite(inv)
			return false, "Ese proyecto ya no existe."
		end
		if findActive(inv.From.UserId, inv.Pid) then
			dropInvite(inv)
			return false, "Ese proyecto ya tiene colaborador."
		end
		if countFor(player) >= Collab.MaxActive or countFor(inv.From) >= Collab.MaxActive then
			return false, "Hay demasiadas colaboraciones activas."
		end
		invites[inv.Id] = nil
		nextId = nextId + 1
		local c = { Id = nextId, Owner = inv.From, Guest = player, Pid = inv.Pid, Share = inv.Share, Perms = inv.Perms, Started = os.time() }
		active[c.Id] = c
		S.Net.notify(c.Owner, "🤜 " .. nameOf(player) .. " aceptó colaborar en «" .. proj.Name .. "».", "success")
		dirty(c.Owner, player)
		return true, "¡Colaboras con " .. nameOf(c.Owner) .. " en «" .. proj.Name .. "»! Reparto: " .. c.Share .. " % para ti.", { id = c.Id }
	end)

	Net.on("Collab.CancelInvite", function(player, p)
		local inv = invites[tonumber(p.id) or -1]
		if not inv or inv.From ~= player then
			return false, "No tienes esa invitación."
		end
		dropInvite(inv, nil, "🤜 " .. nameOf(player) .. " retiró su invitación.")
		return true, "Invitación retirada."
	end)

	Net.on("Collab.SetPerms", function(player, p)
		local c, err = ownedCollab(player, p.id)
		if not c then
			return false, err
		end
		if p.publish == true then
			return false, "Publicar es siempre exclusivo del dueño."
		end
		c.Perms = readPerms(p)
		local pt = permsText(c.Perms)
		S.Net.notify(c.Guest, "🤜 " .. nameOf(player) .. " cambió tus permisos: " .. (pt ~= "" and ("puedes " .. pt) or "solo mirar") .. ".", "info")
		dirty(c.Guest)
		return true, "Permisos de " .. nameOf(c.Guest) .. " actualizados."
	end)

	Net.on("Collab.Kick", function(player, p)
		local c, err = ownedCollab(player, p.id)
		if not c then
			return false, err
		end
		endCollab(c, nil, "🤜 " .. nameOf(player) .. " terminó la colaboración contigo. Tus escenas se quedan en su proyecto.")
		return true, nameOf(c.Guest) .. " ya no colabora en el proyecto."
	end)

	Net.on("Collab.Leave", function(player, p)
		local c = Collab.get(p.id)
		if not c or c.Guest ~= player then
			return false, "No colaboras en ese proyecto."
		end
		endCollab(c, "🤜 " .. nameOf(player) .. " dejó la colaboración.", nil)
		return true, "Has salido de la colaboración."
	end)

	-- Mover/quitar clips de la línea de tiempo del proyecto del dueño (permiso de edición)
	Net.on("Collab.EditClip", function(player, p)
		local c = Collab.get(p.id)
		if not c or (c.Guest ~= player and c.Owner ~= player) then
			return false, "No colaboras en ese proyecto."
		end
		if c.Guest == player and not c.Perms.edit then
			return false, "El dueño no te ha dado permiso para editar."
		end
		local proj = projectOf(c.Owner, c.Pid)
		if not proj then
			return false, "Ese proyecto ya no existe."
		end
		local tl = proj.Edit and proj.Edit.Timeline
		local i = math.floor(tonumber(p.index) or 0)
		if not tl or i < 1 or i > #tl then
			return false, "Clip no válido."
		end
		local msg
		if p.op == "up" or p.op == "down" then
			local j = p.op == "up" and i - 1 or i + 1
			if j < 1 or j > #tl then
				return false, "Ese clip no se puede mover más."
			end
			tl[i], tl[j] = tl[j], tl[i]
			msg = "Clip movido."
		elseif p.op == "remove" then
			table.remove(tl, i)
			msg = "Clip quitado de la línea de tiempo."
		else
			return false, "Acción no válida."
		end
		proj.Export = nil
		if c.Guest == player then
			S.Net.notify(c.Owner, "✂ " .. nameOf(player) .. " editó la línea de tiempo de «" .. proj.Name .. "» (hay que volver a exportar).", "info")
		end
		dirty(c.Owner, c.Guest)
		return true, msg
	end)

	Players.PlayerRemoving:Connect(function(player)
		for _, inv in pairs(invites) do
			if inv.From == player or inv.To == player then
				local o = inv.From == player and inv.To or inv.From
				invites[inv.Id] = nil
				if online(o) and o ~= player then
					S.Net.notify(o, "🤜 La invitación a colaborar se canceló: " .. nameOf(player) .. " salió del juego.", "info")
					S.Data.markDirty(o)
				end
			end
		end
		for _, c in pairs(active) do
			if c.Owner == player or c.Guest == player then
				local o = c.Owner == player and c.Guest or c.Owner
				active[c.Id] = nil
				if online(o) and o ~= player then
					S.Net.notify(o, "🤜 Colaboración cancelada: " .. nameOf(player) .. " salió del juego.", "warn")
					S.Data.markDirty(o)
				end
			end
		end
		lastInvite[player] = nil
	end)

	task.spawn(function()
		while true do
			task.wait(1)
			local ok, err = pcall(Collab.tick)
			if not ok then
				S.Net.logError("collab tick", err)
			end
		end
	end)
end

return Collab
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000030"><Properties><string name="Name">CompanyService</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- CompanyService: tu propia empresa de producción, con empleados y clientes.
--  * Se funda con nivel 10 o 5.000 suscriptores: nombre (filtrado), logotipo ficticio (emoji + color).
--  * Cuenta propia de la empresa, separada de tu dinero: tú ingresas y retiras. Los salarios, las indemnizaciones
--    y los pagos de clientes se mueven SOLO en esa cuenta (nunca se toca tu dinero personal sin tu permiso).
--  * Reputación de empresa (0-100) y nivel según contratos cumplidos (LifeData.CompanyTiers), que fija el máximo
--    de empleados (+2 si tienes en propiedad o alquiler un local de negocio o un estudio).
--  * Cada día de juego: 6 candidatos deterministas y 3 encargos de clientes ficticios.
--  * Salarios cada 7 días jugados. Sin fondos: la moral baja y tras 2 impagos seguidos el empleado se va.
--  * Efectos reales del personal (los consultan VideoService, NeedsService, SponsorService, InventoryService y
--    VehicleService con `if S.Company then ... end`).
--  * Los encargos se cumplen publicando en ViewTube Studio con «Cliente de la empresa» (Video.Publish con client = id).

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage.Shared
local LifeData = require(Shared.LifeData)
local PropertyData = require(Shared.PropertyData)
local VideoData = require(Shared.VideoData)
local Util = require(Shared.Util)

local Company = {}
local S

function Company.Init(services)
	S = services
end

---------------------------------------------------------------------------
-- Estado
---------------------------------------------------------------------------
local function ensure(c)
	c.Funds = c.Funds or 0
	c.Rep = c.Rep or 50
	c.Contracts = c.Contracts or 0
	c.Failed = c.Failed or 0
	c.Staff = c.Staff or {}
	c.Seq = c.Seq or 0
	c.Candidates = c.Candidates or {}
	c.CandDay = c.CandDay or -1
	c.Offers = c.Offers or {}
	c.OffersDay = c.OffersDay or -1
	c.Active = c.Active or {}
	c.NextPay = c.NextPay or 0
	c.Report = c.Report or {}
	c.Report.Inc = c.Report.Inc or {}
	c.Report.Exp = c.Report.Exp or {}
	c.Report.Deposits = c.Report.Deposits or 0
	c.Report.Withdrawals = c.Report.Withdrawals or 0
	c.Weeks = c.Weeks or {}
	c.Ledger = c.Ledger or {}
	c.History = c.History or {}
	return c
end

-- Devuelve la empresa del perfil o nil si no tiene (Company = {} significa sin empresa)
local function companyOf(data)
	local c = data and data.Company
	if type(c) ~= "table" or type(c.Name) ~= "string" then
		return nil
	end
	return ensure(c)
end

function Company.get(player)
	local data = S.Data.get(player)
	return companyOf(data), data
end

function Company.canFound(data)
	return data.Level >= LifeData.CompanyReq.Level or data.Channel.Subs >= LifeData.CompanyReq.Subs
end

function Company.maxStaff(player)
	local c, data = Company.get(player)
	if not c then
		return 0
	end
	return LifeData.companyMaxStaff(c, data.Properties, PropertyData.ById)
end

local function clientName(idx)
	local cl = LifeData.Clients[idx]
	return cl and cl.Name or "Cliente"
end

local function catName(id)
	local c = VideoData.CategoryById[id]
	return c and c.Name or tostring(id)
end

local function roleName(id)
	local r = LifeData.RoleById[id]
	return r and r.Name or tostring(id)
end

local function history(c, day, text, kind)
	Util.pushCapped(c.History, { T = os.time(), D = day, X = text, K = kind or "info" }, 30)
end

-- Movimiento de la cuenta de la empresa. cat = categoría del informe; transfer = aportación/retirada del dueño.
local function move(c, day, amount, cat, text, transfer)
	amount = math.floor(amount + 0.5)
	c.Funds = c.Funds + amount
	if not transfer then
		if amount >= 0 then
			c.Report.Inc[cat] = (c.Report.Inc[cat] or 0) + amount
		else
			c.Report.Exp[cat] = (c.Report.Exp[cat] or 0) - amount
		end
		local week = math.floor(day / 7) + 1
		local w = c.Weeks[1]
		if not w or w.W ~= week then
			w = { W = week, Inc = 0, Exp = 0 }
			Util.pushCapped(c.Weeks, w, 8)
		end
		if amount >= 0 then
			w.Inc = w.Inc + amount
		else
			w.Exp = w.Exp - amount
		end
	end
	Util.pushCapped(c.Ledger, { T = os.time(), D = day, A = amount, C = cat, X = text, B = c.Funds }, 40)
end

local function changeRep(c, delta)
	c.Rep = Util.clamp(c.Rep + delta, 0, 100)
end

local function changeMorale(c, delta)
	for _, e in pairs(c.Staff) do
		e.Morale = Util.clamp((e.Morale or 70) + delta, 0, 100)
	end
end

---------------------------------------------------------------------------
-- Efectos reales del personal (neutros si no hay empresa)
---------------------------------------------------------------------------
function Company.effects(player)
	local data = S.Data.get(player)
	return LifeData.companyEffects(data and companyOf(data) or nil)
end

-- Editor: exportaciones hasta un 25% más rápidas
function Company.exportMult(player)
	return Company.effects(player).exportMult
end

-- Camarógrafo: hasta +4 de calidad por escena
function Company.sceneBonus(player)
	return Company.effects(player).sceneBonus
end

-- Diseñador: hasta +5 en la puntuación de miniaturas
function Company.thumbBonus(player)
	return Company.effects(player).thumbBonus
end

-- Asistente: gastas un 25% menos de energía
function Company.energyMult(player)
	return Company.effects(player).energyMult
end

-- Gestor: +1 oferta de patrocinio y +10% de pago
function Company.sponsorExtra(player)
	return Company.effects(player).sponsorExtra
end

function Company.sponsorMult(player)
	return Company.effects(player).sponsorMult
end

-- Técnico: reparaciones a mitad de precio
function Company.repairMult(player)
	return Company.effects(player).repairMult
end

---------------------------------------------------------------------------
-- Candidatos y ofertas de clientes (deterministas por jugador y día)
---------------------------------------------------------------------------
function Company.candidatesFor(player, day)
	local rng = Random.new(player.UserId * 7907 + day * 104729 + 11)
	local list = {}
	for i = 1, LifeData.CandidatesPerDay do
		local role = LifeData.Roles[rng:NextInteger(1, #LifeData.Roles)]
		local skill = rng:NextInteger(30, 95)
		local name = LifeData.FirstNames[rng:NextInteger(1, #LifeData.FirstNames)] .. " " .. LifeData.LastNames[rng:NextInteger(1, #LifeData.LastNames)]
		list[i] = { Id = "c" .. day .. "_" .. i, Name = name, Role = role.Id, Skill = skill, Salary = LifeData.salaryFor(skill, role.Id) }
	end
	return list
end

local function genOffers(player, c, day)
	c.Offers = {}
	local rng = Random.new(player.UserId * 3571 + day * 92821 + 5)
	local tierIdx = LifeData.companyTier(c.Contracts)
	local fx = LifeData.companyEffects(c)
	-- Con mala reputación casi nadie confía en la empresa
	local n = c.Rep < 20 and 1 or (LifeData.ClientOffersPerDay + fx.clientExtra)
	for i = 1, n do
		local ci = rng:NextInteger(1, #LifeData.Clients)
		local cl = LifeData.Clients[ci]
		local cat = cl.Cats[rng:NextInteger(1, #cl.Cats)]
		local minQ = math.min(80, 30 + tierIdx * 5 + rng:NextInteger(0, 15))
		local pay = (300 + minQ * 15) * (0.6 + c.Rep / 125) * (1 + 0.15 * (tierIdx - 1)) * fx.sponsorMult * rng:NextNumber(0.9, 1.15)
		c.Seq = c.Seq + 1
		c.Offers[i] = {
			Id = "k" .. c.Seq,
			Client = ci,
			Category = cat,
			MinQ = minQ,
			Days = rng:NextInteger(2, 4),
			Pay = math.floor(pay / 5) * 5,
			Bonus = math.floor(pay * 0.25 / 5) * 5,
		}
	end
end

-- Genera candidatos y ofertas del día si aún no existen
function Company.refresh(player)
	local c, data = Company.get(player)
	if not c then
		return
	end
	local day = data.Home.PlayDays
	if c.CandDay ~= day then
		c.CandDay = day
		c.Candidates = Company.candidatesFor(player, day)
	end
	if c.OffersDay ~= day then
		c.OffersDay = day
		genOffers(player, c, day)
	end
end

---------------------------------------------------------------------------
-- Salarios y día nuevo
---------------------------------------------------------------------------
local function sortedStaff(c)
	local list = {}
	for id, e in pairs(c.Staff) do
		list[#list + 1] = e
	end
	table.sort(list, function(a, b)
		return (a.N or 0) < (b.N or 0)
	end)
	return list
end

function Company.payroll(player, c, day)
	local paid, unpaid, left = 0, 0, {}
	for _, e in ipairs(sortedStaff(c)) do
		local days = math.min(LifeData.PayPeriodDays, day - (e.Since or day))
		local due = math.floor(e.Salary * days / LifeData.PayPeriodDays + 0.5)
		if due > 0 then
			if c.Funds >= due then
				move(c, day, -due, "Salarios", "Salario de " .. e.Name .. " (" .. roleName(e.Role) .. ")")
				e.Missed = 0
				e.Morale = Util.clamp((e.Morale or 70) + 5, 0, 100)
				e.Since = day
				paid = paid + due
			else
				e.Missed = (e.Missed or 0) + 1
				e.Morale = Util.clamp((e.Morale or 70) - 30, 0, 100)
				e.Since = day
				unpaid = unpaid + 1
				if e.Missed >= 2 then
					c.Staff[e.Id] = nil
					left[#left + 1] = e.Name
					changeRep(c, -5)
					history(c, day, e.Name .. " (" .. roleName(e.Role) .. ") se fue tras 2 salarios impagados.", "bad")
				else
					history(c, day, "Salario impagado a " .. e.Name .. ": su moral baja.", "bad")
				end
			end
		end
	end
	if paid > 0 then
		history(c, day, "Nóminas pagadas: $" .. Util.formatInt(paid) .. ".", "ok")
		S.Net.notify(player, "🏢 " .. c.Name .. " pagó $" .. Util.formatInt(paid) .. " en salarios.", "info")
	end
	if unpaid > 0 then
		S.Net.notify(player, "⚠️ " .. c.Name .. " no tiene fondos para " .. unpaid .. " salario(s). La moral baja; tras 2 impagos el empleado se va. Ingresa dinero en la app Empresa.", "warn")
	end
	if #left > 0 then
		S.Net.notify(player, "🚪 " .. table.concat(left, ", ") .. " dejó la empresa por impagos. Reputación de empresa −5.", "warn")
	end
	return paid, unpaid, left
end

function Company.onNewDay(player)
	local c, data = Company.get(player)
	if not c then
		return
	end
	local day = data.Home.PlayDays
	-- Fotógrafos: venta diaria de fotos para la empresa
	local fx = LifeData.companyEffects(c)
	if fx.photoIncome > 0 then
		move(c, day, fx.photoIncome, "Venta de fotos", "Venta de fotos del día")
	end
	-- Encargos vencidos
	for id, k in pairs(c.Active) do
		if day > k.DueDay then
			c.Active[id] = nil
			c.Failed = c.Failed + 1
			changeRep(c, -10)
			changeMorale(c, -5)
			history(c, day, "Encargo incumplido: " .. clientName(k.Client) .. " (" .. catName(k.Category) .. ").", "bad")
			S.Net.notify(player, "⚠️ " .. c.Name .. " no entregó el vídeo a " .. clientName(k.Client) .. ". Reputación de empresa −10.", "warn")
		end
	end
	-- Nóminas cada 7 días jugados
	if day >= c.NextPay then
		c.NextPay = day + LifeData.PayPeriodDays
		Company.payroll(player, c, day)
	end
	Company.refresh(player)
	S.Data.markDirty(player)
end

---------------------------------------------------------------------------
-- Clientes (los llama VideoService al publicar)
---------------------------------------------------------------------------
-- Comprueba si un proyecto cumple el encargo. Devuelve el contrato o nil y el motivo.
function Company.checkClient(player, id, proj, quality)
	local c, data = Company.get(player)
	if not c then
		return nil, "No tienes una empresa."
	end
	local k = type(id) == "string" and c.Active[id] or nil
	if not k then
		return nil, "Ese encargo no existe o ya terminó."
	end
	if data.Home.PlayDays > k.DueDay then
		return nil, "El plazo del encargo ha vencido."
	end
	if proj.Category ~= k.Category then
		return nil, clientName(k.Client) .. " pidió un vídeo de " .. catName(k.Category) .. "."
	end
	if quality < k.MinQ then
		return nil, clientName(k.Client) .. " exige calidad " .. k.MinQ .. " (tu vídeo tiene " .. math.floor(quality) .. ")."
	end
	return k
end

function Company.clientLabel(k)
	return clientName(k.Client)
end

function Company.completeClient(player, id, quality, videoId)
	local c, data = Company.get(player)
	if not c or type(id) ~= "string" then
		return
	end
	local k = c.Active[id]
	if not k then
		return
	end
	local day = data.Home.PlayDays
	c.Active[id] = nil
	local bonus = quality >= k.MinQ + 15 and k.Bonus or 0
	local total = k.Pay + bonus
	local oldTier = LifeData.companyTier(c.Contracts)
	move(c, day, total, "Clientes", "Encargo de " .. clientName(k.Client) .. (videoId and (" (vídeo " .. videoId .. ")") or ""))
	c.Contracts = c.Contracts + 1
	changeRep(c, bonus > 0 and 5 or 3)
	changeMorale(c, 3)
	data.Counters.client_contracts = (data.Counters.client_contracts or 0) + 1
	history(c, day, "Encargo cumplido para " .. clientName(k.Client) .. ": +$" .. Util.formatInt(total) .. (bonus > 0 and " (con bonus)" or "") .. ".", "ok")
	S.Net.notify(player, "🏢 Encargo de " .. clientName(k.Client) .. " entregado: +$" .. Util.formatInt(total) .. " para " .. c.Name .. ".", "success")
	local newTier, tier = LifeData.companyTier(c.Contracts)
	if newTier > oldTier then
		history(c, day, "La empresa sube a «" .. tier.Name .. "».", "ok")
		S.Net.notify(player, "🏆 " .. c.Name .. " ahora es «" .. tier.Name .. "»: hasta " .. Company.maxStaff(player) .. " empleados.", "gold")
	end
	S.Quest.check(player)
	S.Data.markDirty(player)
end

---------------------------------------------------------------------------
-- Acciones
---------------------------------------------------------------------------
local function index(v, n)
	v = tonumber(v)
	if not v or v ~= v then
		return nil
	end
	v = math.floor(v)
	if v < 1 or v > n then
		return nil
	end
	return v
end

local function amountOf(v)
	v = tonumber(v)
	if not v or v ~= v or v == math.huge then
		return nil
	end
	v = math.floor(v)
	if v <= 0 or v > 1000000000 then
		return nil
	end
	return v
end

local function noCompany()
	return false, "Primero funda tu empresa (nivel " .. LifeData.CompanyReq.Level .. " o " .. Util.formatInt(LifeData.CompanyReq.Subs) .. " suscriptores)."
end

function Company.Start()
	local Net = S.Net

	Net.on("Company.Refresh", function(player)
		Company.refresh(player)
		return true
	end)

	Net.on("Company.Create", function(player, p)
		local data = S.Data.get(player)
		if companyOf(data) then
			return false, "Ya tienes una empresa."
		end
		if not Company.canFound(data) then
			return false, "Para fundar una empresa necesitas nivel " .. LifeData.CompanyReq.Level .. " o " .. Util.formatInt(LifeData.CompanyReq.Subs) .. " suscriptores."
		end
		local name = Util.cleanText(p.name, 30)
		if not name or #name < 3 then
			return false, "Escribe el nombre de la empresa (mínimo 3 caracteres)."
		end
		local fName = S.Text.filter(player, name)
		if not fName or fName == "" then
			return false, "No se pudo comprobar el nombre. Inténtalo de nuevo."
		end
		if fName ~= name and fName:find("#", 1, true) then
			return false, "Ese nombre no está permitido. Prueba con otro."
		end
		local emoji = index(p.emoji, #LifeData.CompanyEmojis)
		local color = index(p.color, #LifeData.CompanyColors)
		if not emoji or not color then
			return false, "Elige un logotipo válido."
		end
		local day = data.Home.PlayDays
		data.Company = ensure({
			Name = fName,
			Emoji = emoji,
			Color = color,
			Founded = os.time(),
			FoundedDay = day,
			NextPay = day + LifeData.PayPeriodDays,
		})
		local c = data.Company
		history(c, day, "Fundación de «" .. fName .. "».", "ok")
		data.Counters.company_created = 1
		Company.refresh(player)
		S.Progress.addXp(player, 100)
		S.Quest.check(player)
		return true, "🏢 ¡Has fundado «" .. fName .. "»! Ingresa fondos en su cuenta y contrata a tu primer empleado."
	end)

	Net.on("Company.SetLogo", function(player, p)
		local c = Company.get(player)
		if not c then
			return noCompany()
		end
		local emoji = index(p.emoji, #LifeData.CompanyEmojis)
		local color = index(p.color, #LifeData.CompanyColors)
		if not emoji or not color then
			return false, "Elige un logotipo válido."
		end
		if emoji == c.Emoji and color == c.Color then
			return false, "Ese ya es tu logotipo."
		end
		c.Emoji, c.Color = emoji, color
		return true, "Logotipo actualizado: " .. LifeData.CompanyEmojis[emoji] .. " " .. LifeData.CompanyColors[color][1] .. "."
	end)

	Net.on("Company.Deposit", function(player, p)
		local c, data = Company.get(player)
		if not c then
			return noCompany()
		end
		local amount = amountOf(p.amount)
		if not amount then
			return false, "Cantidad no válida."
		end
		if not S.Economy.spend(player, amount, "Empresa", "Aportación a " .. c.Name) then
			return false, "No tienes $" .. Util.formatInt(amount) .. "."
		end
		move(c, data.Home.PlayDays, amount, "Aportación", "Aportación del dueño", true)
		c.Report.Deposits = c.Report.Deposits + amount
		return true, "💼 Ingresaste $" .. Util.formatInt(amount) .. " en la cuenta de " .. c.Name .. "."
	end)

	Net.on("Company.Withdraw", function(player, p)
		local c, data = Company.get(player)
		if not c then
			return noCompany()
		end
		local amount = amountOf(p.amount)
		if not amount then
			return false, "Cantidad no válida."
		end
		if amount > c.Funds then
			return false, "La empresa solo tiene $" .. Util.formatInt(c.Funds) .. "."
		end
		move(c, data.Home.PlayDays, -amount, "Retirada", "Retirada del dueño", true)
		c.Report.Withdrawals = c.Report.Withdrawals + amount
		S.Economy.add(player, amount, "Empresa", "Retirada de " .. c.Name, {})
		return true, "💼 Retiraste $" .. Util.formatInt(amount) .. " de la cuenta de " .. c.Name .. "."
	end)

	Net.on("Company.Hire", function(player, p)
		local c, data = Company.get(player)
		if not c then
			return noCompany()
		end
		Company.refresh(player)
		local cand, idx = nil, nil
		for i, x in ipairs(c.Candidates) do
			if x.Id == p.id then
				cand, idx = x, i
			end
		end
		if not cand or not LifeData.RoleById[cand.Role] then
			return false, "Ese candidato ya no está disponible."
		end
		local max = Company.maxStaff(player)
		if Util.count(c.Staff) >= max then
			return false, "Plantilla completa (" .. max .. " empleados). Cumple más encargos para subir de nivel o consigue un local de negocio o un estudio (+" .. LifeData.CompanyOfficeBonus .. ")."
		end
		local salary = LifeData.salaryFor(cand.Skill, cand.Role)
		if c.Funds < salary then
			return false, "La empresa necesita fondos para al menos una semana de salario ($" .. Util.formatInt(salary) .. "). Ingresa dinero en su cuenta."
		end
		table.remove(c.Candidates, idx)
		local day = data.Home.PlayDays
		c.Seq = c.Seq + 1
		local id = "e" .. c.Seq
		c.Staff[id] = { Id = id, N = c.Seq, Name = cand.Name, Role = cand.Role, Skill = cand.Skill, Salary = salary, Morale = 70, Missed = 0, Hired = day, Since = day }
		data.Counters.employees_hired = (data.Counters.employees_hired or 0) + 1
		history(c, day, "Contratado: " .. cand.Name .. " (" .. roleName(cand.Role) .. ", habilidad " .. cand.Skill .. ").", "ok")
		S.Quest.check(player)
		return true, "👋 " .. cand.Name .. " se une a " .. c.Name .. " como " .. roleName(cand.Role) .. " ($" .. Util.formatInt(salary) .. "/semana). Efecto: " .. LifeData.employeeEffect(c.Staff[id]) .. "."
	end)

	Net.on("Company.Fire", function(player, p)
		local c, data = Company.get(player)
		if not c then
			return noCompany()
		end
		local e = type(p.id) == "string" and c.Staff[p.id] or nil
		if not e then
			return false, "Empleado no encontrado."
		end
		if c.Funds < e.Salary then
			return false, "La indemnización (1 semana: $" .. Util.formatInt(e.Salary) .. ") se paga con los fondos de la empresa. Ingresa dinero primero."
		end
		local day = data.Home.PlayDays
		move(c, day, -e.Salary, "Indemnizaciones", "Indemnización de " .. e.Name)
		c.Staff[p.id] = nil
		changeMorale(c, -3)
		history(c, day, "Despedido: " .. e.Name .. " (indemnización $" .. Util.formatInt(e.Salary) .. ").", "info")
		return true, e.Name .. " ya no trabaja en " .. c.Name .. ". Indemnización pagada: $" .. Util.formatInt(e.Salary) .. "."
	end)

	Net.on("Company.AcceptClient", function(player, p)
		local c, data = Company.get(player)
		if not c then
			return noCompany()
		end
		Company.refresh(player)
		local offer, idx = nil, nil
		for i, o in ipairs(c.Offers) do
			if o.Id == p.id then
				offer, idx = o, i
			end
		end
		if not offer then
			return false, "Esa oferta ya no está disponible."
		end
		if Util.count(c.Active) >= LifeData.MaxClientContracts then
			return false, "Ya tienes " .. LifeData.MaxClientContracts .. " encargos activos. Entrégalos antes de aceptar más."
		end
		table.remove(c.Offers, idx)
		local k = Util.deepCopy(offer)
		k.Accepted = os.time()
		k.DueDay = data.Home.PlayDays + offer.Days
		c.Active[offer.Id] = k
		history(c, data.Home.PlayDays, "Encargo aceptado: " .. clientName(k.Client) .. " (" .. catName(k.Category) .. ", calidad " .. k.MinQ .. "+).", "info")
		return true, "📝 Encargo de " .. clientName(k.Client) .. " aceptado: vídeo de " .. catName(k.Category) .. " con calidad " .. k.MinQ .. "+ en " .. offer.Days .. " días de juego."
	end)

	Net.on("Company.DeclineClient", function(player, p)
		local c = Company.get(player)
		if not c then
			return noCompany()
		end
		for i, o in ipairs(c.Offers) do
			if o.Id == p.id then
				table.remove(c.Offers, i)
				return true, "Oferta rechazada (sin penalización)."
			end
		end
		return false, "Oferta no encontrada."
	end)

	Net.on("Company.CancelClient", function(player, p)
		local c, data = Company.get(player)
		if not c then
			return noCompany()
		end
		local k = type(p.id) == "string" and c.Active[p.id] or nil
		if not k then
			return false, "Encargo no encontrado."
		end
		c.Active[p.id] = nil
		c.Failed = c.Failed + 1
		changeRep(c, -5)
		history(c, data.Home.PlayDays, "Encargo cancelado: " .. clientName(k.Client) .. ".", "bad")
		return true, "Encargo cancelado. Reputación de empresa −5 (incumplirlo cuesta 10)."
	end)
end

return Company
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000031"><Properties><string name="Name">ComputerService</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- ComputerService: montajes de PC (rigs), sesiones de computador y rendimiento real.
-- Un rig es un conjunto de piezas del inventario (uids) instaladas juntas. Comprar un PC completo crea un rig
-- con piezas reales, que se puede desmontar, mejorar o vender por piezas.
-- Solo las piezas reconocidas por PCBuild afectan al rendimiento.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local Shared = ReplicatedStorage.Shared
local Catalog = require(Shared.ItemCatalog)
local PCBuild = require(Shared.PCBuild)
local Util = require(Shared.Util)

local Computer = {}
local S
local sessions = {} -- [player] = { Kind = "home"|"public"|"laptop", Pos = Vector3?, Uid = laptop uid }

Computer.MaxRigs = 4
Computer.SessionRadius = 16

function Computer.Init(services)
	S = services
end

local function rigLoc(rigId)
	return "rig:" .. rigId
end

-- Convierte un rig (uids) en IDs de catálogo para PCBuild
function Computer.rigParts(player, rig)
	local data = S.Data.get(player)
	local out = {}
	local condSum, condN = 0, 0
	for slot, v in pairs(rig.Parts) do
		if type(v) == "table" then
			out[slot] = {}
			for _, uid in ipairs(v) do
				local rec = data.Inventory[uid]
				if rec then
					table.insert(out[slot], rec.Id)
					condSum = condSum + rec.Cond
					condN = condN + 1
				end
			end
		else
			local rec = data.Inventory[v]
			if rec then
				out[slot] = rec.Id
				condSum = condSum + rec.Cond
				condN = condN + 1
			end
		end
	end
	local cond = condN > 0 and condSum / condN or 100
	return out, 0.85 + 0.15 * cond / 100
end

function Computer.rigStats(player, rigId)
	local data = S.Data.get(player)
	local rig = data.Rigs[rigId]
	if not rig then
		return nil
	end
	local parts, cf = Computer.rigParts(player, rig)
	local ok = PCBuild.validate(parts)
	if not ok then
		return nil
	end
	return PCBuild.stats(parts, cf)
end

function Computer.createRigFromPrebuilt(player, def, opts)
	local data = S.Data.get(player)
	if Util.count(data.Rigs) >= Computer.MaxRigs then
		S.Net.notify(player, "Ya tienes " .. Computer.MaxRigs .. " computadores montados: las piezas se guardarán sueltas en casa.", "warn")
	end
	opts = opts or {}
	local rigId = S.Data.nextUid(player, "r")
	local partsValue = 0
	for _, v in pairs(def.Parts) do
		if type(v) == "table" then
			for _, id in ipairs(v) do
				partsValue = partsValue + Catalog.get(id).Price
			end
		else
			partsValue = partsValue + Catalog.get(v).Price
		end
	end
	local ratio = (opts.paid or def.Price) / math.max(1, partsValue)
	local canMount = Util.count(data.Rigs) < Computer.MaxRigs
	local rig = { Name = def.Name, Parts = {}, From = def.Id }
	for slot, v in pairs(def.Parts) do
		local ids = type(v) == "table" and v or { v }
		local uids = {}
		for _, id in ipairs(ids) do
			local uid = S.Inventory.add(player, id, { src = opts.src or "shop", paid = math.floor(Catalog.get(id).Price * ratio + 0.5), loc = "home" })
			if uid then
				if canMount then
					data.Inventory[uid].Loc = rigLoc(rigId)
				end
				uids[#uids + 1] = uid
			end
		end
		if type(v) == "table" then
			rig.Parts[slot] = uids
		else
			rig.Parts[slot] = uids[1]
		end
	end
	if not canMount then
		return nil
	end
	data.Rigs[rigId] = rig
	if data.ActiveRig == "" or not data.Rigs[data.ActiveRig] then
		data.ActiveRig = rigId
	end
	S.Home.refreshRoom(player)
	return rigId
end

-- Estadísticas del puesto de trabajo de la sesión actual (incluye periféricos de casa)
function Computer.sessionStats(player)
	local s = sessions[player]
	if not s then
		return nil
	end
	local data = S.Data.get(player)
	local stats
	if s.Kind == "home" then
		stats = Computer.rigStats(player, data.ActiveRig) or PCBuild.publicStats()
	elseif s.Kind == "laptop" then
		local rec, def = S.Inventory.get(player, s.Uid)
		stats = def and PCBuild.laptopStats(def, S.Inventory.condFactor(rec)) or PCBuild.publicStats()
	else
		stats = PCBuild.publicStats()
	end
	stats.Kind = s.Kind
	-- Periféricos y mobiliario (solo cuentan en casa)
	stats.ColorAcc, stats.Screens, stats.EditSpeed, stats.Comfort, stats.AudioMix = 40, 1, 0, 0, 0
	if s.Kind == "home" then
		local mon = S.Inventory.bestCatAtHome(player, "monitor", nil, "ColorAcc")
		if mon then
			stats.ColorAcc = mon.Stats.ColorAcc
			stats.Screens = mon.Stats.Screens
		end
		for _, sub in ipairs({ "Teclado", "Ratón", "Alfombrilla" }) do
			local d = S.Inventory.bestCatAtHome(player, "peripheral", sub, "EditSpeed")
			if d then
				stats.EditSpeed = stats.EditSpeed + d.Stats.EditSpeed
			end
		end
		stats.EditSpeed = stats.EditSpeed + (stats.Screens - 1) * 4
		local chair = S.Inventory.bestCatAtHome(player, "furniture", "Silla", "Comfort")
		local desk = S.Inventory.bestCatAtHome(player, "furniture", "Escritorio", "Comfort")
		stats.Comfort = (chair and chair.Stats.Comfort or 0) + (desk and desk.Stats.Comfort or 0)
		local head = S.Inventory.bestCatAtHome(player, "peripheral", "Auriculares", "AudioMix")
		local spk = S.Inventory.bestCatAtHome(player, "peripheral", "Altavoces", "AudioMix")
		stats.AudioMix = math.max(head and head.Stats.AudioMix or 0, spk and spk.Stats.AudioMix or 0)
	elseif s.Kind == "laptop" then
		stats.ColorAcc = 60
		stats.AudioMix = 20
	end
	-- Almacenamiento externo (en casa o en la mochila según dónde estés)
	local where = s.Kind == "home" and "home" or "backpack"
	for _, rec in pairs(data.Inventory) do
		local def = Catalog.get(rec.Id)
		if def and def.Slot == "external" and (rec.Loc == where) then
			stats.StorageGb = stats.StorageGb + def.Stats.Gb
		end
	end
	-- Tableta Pro: edición ligera
	return stats
end

function Computer.storageUsed(player)
	local data = S.Data.get(player)
	local used = 0
	for _, proj in pairs(data.Projects) do
		for _, sc in ipairs(proj.Scenes) do
			if sc.Imported then
				used = used + (sc.Gb or 0)
			end
		end
	end
	return math.floor(used * 10 + 0.5) / 10
end

function Computer.hasSession(player)
	local s = sessions[player]
	if not s then
		return false
	end
	if s.Kind == "laptop" then
		local rec = S.Inventory.get(player, s.Uid)
		if not rec or (rec.Loc ~= "backpack" and not S.Home.isAtHome(player)) then
			sessions[player] = nil
			return false
		end
		return true
	end
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if not root or (root.Position - s.Pos).Magnitude > Computer.SessionRadius then
		sessions[player] = nil
		S.Net.push(player, "closeComputer", {})
		return false
	end
	return true
end

function Computer.session(player)
	if Computer.hasSession(player) then
		return sessions[player]
	end
	return nil
end

function Computer.open(player, kind, pos, uid)
	sessions[player] = { Kind = kind, Pos = pos, Uid = uid }
	S.Quest.tutorialEvent(player, "open_computer")
	S.Net.push(player, "openComputer", { kind = kind, stats = Computer.sessionStats(player) })
	S.Data.markDirty(player)
end

function Computer.close(player)
	sessions[player] = nil
end

-- Lo llama WorldBuilder/Home cuando se activa el aviso de un escritorio.
function Computer.onPrompt(player, part, kind, ownerUserId)
	if kind == "home" and ownerUserId ~= player.UserId then
		S.Net.notify(player, "Este no es tu computador.", "error")
		return
	end
	Computer.open(player, kind, part.Position)
end

local function validateRigInput(player, parts, rigId)
	local data = S.Data.get(player)
	if type(parts) ~= "table" then
		return nil, "Montaje no válido."
	end
	local used = {}
	local ids, uidParts = {}, {}
	for _, slot in ipairs(PCBuild.Slots) do
		local v = parts[slot.Key]
		local list = {}
		if slot.Multi then
			if v ~= nil and type(v) ~= "table" then
				return nil, "Montaje no válido."
			end
			list = v or {}
			if #list > 8 then
				return nil, "Demasiadas piezas."
			end
		elseif v ~= nil then
			list = { v }
		end
		local slotIds, slotUids = {}, {}
		for _, uid in ipairs(list) do
			if type(uid) ~= "string" or used[uid] then
				return nil, "Pieza repetida o no válida."
			end
			used[uid] = true
			local rec = data.Inventory[uid]
			if not rec then
				return nil, "No tienes una de las piezas."
			end
			if rec.Loc ~= "home" and rec.Loc ~= rigLoc(rigId or "") then
				return nil, Catalog.get(rec.Id).Name .. " no está disponible en casa (está en la mochila o en otro PC)."
			end
			slotIds[#slotIds + 1] = rec.Id
			slotUids[#slotUids + 1] = uid
		end
		if slot.Multi then
			ids[slot.Key] = slotIds
			uidParts[slot.Key] = slotUids
		else
			ids[slot.Key] = slotIds[1]
			uidParts[slot.Key] = slotUids[1]
		end
	end
	local ok, errors, warnings = PCBuild.validate(ids)
	if not ok then
		return nil, "No se puede montar: " .. table.concat(errors, " ")
	end
	return uidParts, nil, warnings
end

function Computer.Start()
	local Net = S.Net

	Net.on("PC.OpenLaptop", function(player, p)
		local uid = S.Inventory.best(player, "laptop", "backpack", "CpuScore")
		if not uid and S.Home.isAtHome(player) then
			uid = S.Inventory.best(player, "laptop", "home", "CpuScore")
		end
		if not uid then
			return false, "No llevas un portátil en la mochila."
		end
		Computer.open(player, "laptop", nil, uid)
		return true
	end)

	Net.on("PC.Close", function(player)
		Computer.close(player)
		return true
	end)

	Net.on("PC.Stats", function(player)
		if not Computer.hasSession(player) then
			return false, "No estás usando un computador."
		end
		return true, nil, { stats = Computer.sessionStats(player), used = Computer.storageUsed(player) }
	end)

	Net.on("PC.SaveRig", function(player, p)
		local data = S.Data.get(player)
		if not S.Home.isAtHome(player) then
			return false, "Monta tus computadores en casa."
		end
		local rigId = p.rigId
		if rigId ~= nil and not data.Rigs[rigId] then
			return false, "Ese computador no existe."
		end
		if rigId == nil and Util.count(data.Rigs) >= Computer.MaxRigs then
			return false, "Máximo " .. Computer.MaxRigs .. " computadores montados."
		end
		local uidParts, err, warnings = validateRigInput(player, p.parts, rigId)
		if not uidParts then
			return false, err
		end
		local isNew = rigId == nil
		if isNew then
			rigId = S.Data.nextUid(player, "r")
			data.Rigs[rigId] = { Name = "PC personalizado", Parts = {}, From = "custom" }
		end
		local rig = data.Rigs[rigId]
		-- liberar piezas anteriores
		for _, rec in pairs(data.Inventory) do
			if rec.Loc == rigLoc(rigId) then
				rec.Loc = "home"
			end
		end
		for _, v in pairs(uidParts) do
			if type(v) == "table" then
				for _, uid in ipairs(v) do
					data.Inventory[uid].Loc = rigLoc(rigId)
				end
			elseif v then
				data.Inventory[v].Loc = rigLoc(rigId)
			end
		end
		rig.Parts = uidParts
		local name = Util.cleanText(p.name, 30)
		if name and #name > 0 then
			rig.Name = S.Text.filter(player, name) or rig.Name
		end
		if isNew then
			data.Counters.pcs_built = (data.Counters.pcs_built or 0) + 1
			S.Progress.addXp(player, S.Progress.Xp.PCBuilt)
			S.Quest.check(player)
		end
		if data.ActiveRig == "" or not data.Rigs[data.ActiveRig] then
			data.ActiveRig = rigId
		end
		S.Home.refreshRoom(player)
		local msg = isNew and "¡Computador montado!" or "Computador actualizado."
		if warnings and #warnings > 0 then
			msg = msg .. " Aviso: " .. table.concat(warnings, " ")
		end
		return true, msg, { rigId = rigId, stats = Computer.rigStats(player, rigId) }
	end)

	Net.on("PC.Disassemble", function(player, p)
		local data = S.Data.get(player)
		if not S.Home.isAtHome(player) then
			return false, "Desmonta tus computadores en casa."
		end
		local rig = data.Rigs[p.rigId]
		if not rig then
			return false, "Ese computador no existe."
		end
		for _, rec in pairs(data.Inventory) do
			if rec.Loc == rigLoc(p.rigId) then
				rec.Loc = "home"
			end
		end
		data.Rigs[p.rigId] = nil
		if data.ActiveRig == p.rigId then
			data.ActiveRig = next(data.Rigs) or ""
		end
		S.Home.refreshRoom(player)
		return true, "Computador desmontado: las piezas están en casa."
	end)

	Net.on("PC.SetActive", function(player, p)
		local data = S.Data.get(player)
		if not data.Rigs[p.rigId] then
			return false, "Ese computador no existe."
		end
		data.ActiveRig = p.rigId
		S.Home.refreshRoom(player)
		return true, "Ahora usas " .. data.Rigs[p.rigId].Name .. " en tu escritorio."
	end)

	local lastBench = {}
	Net.on("PC.Benchmark", function(player, p)
		local data = S.Data.get(player)
		local stats = Computer.rigStats(player, p.rigId)
		if not stats then
			return false, "Ese computador no es válido."
		end
		if lastBench[player] and os.clock() - lastBench[player] < 5 then
			return false, "Espera a que termine la prueba anterior."
		end
		lastBench[player] = os.clock()
		local points = math.floor(stats.Score * 137 * (0.97 + math.random() * 0.06))
		data.Counters.benchmarks = (data.Counters.benchmarks or 0) + 1
		S.Quest.check(player)
		return true, "Prueba completada: " .. Util.formatInt(points) .. " puntos.", { points = points, stats = stats }
	end)

	Players.PlayerRemoving:Connect(function(player)
		sessions[player] = nil
		lastBench[player] = nil
	end)
end

return Computer
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000032"><Properties><string name="Name">DataService</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- DataService: carga y guardado seguro con DataStoreService.
--  * Reintentos limitados con espera creciente.
--  * Bloqueo de sesión: si otro servidor tiene los datos abiertos, se espera en lugar de sobrescribir.
--  * Si la carga falla en un servidor real, NUNCA se guarda encima: el jugador es expulsado con un mensaje claro.
--  * En Studio sin acceso a API, se usa un perfil temporal que no se guarda (modo de prueba).
--  * Guardado automático, al salir y al cerrar el servidor.

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Util = require(Shared.Util)

local DataService = {}
local S
local profiles = {}
local dirty = {}
local store = nil
local SCHEMA_VERSION = 1

DataService.Template = {
	Version = SCHEMA_VERSION,
	Money = Config.StartingMoney,
	LifetimeEarned = 0,
	XP = 0,
	Level = 1,
	Reputation = 10,
	BizRep = 50,
	Channel = { Name = "", Description = "", Banner = 1, Avatar = 1, Subs = 0, SubFrac = 0, TotalViews = 0, TotalRevenue = 0, Monetized = false },
	Inventory = {},
	Equipped = { Phone = "" },
	Rigs = {},
	ActiveRig = "",
	Orders = {},
	Processed = {},
	ProcessedOrder = {},
	Transactions = {},
	Monthly = {},
	Bank = { Savings = 0, Loan = 0, LoanRate = 0.1, Goals = {}, LastInterestDay = 0 },
	Projects = {},
	Photos = {},
	Albums = { "General", "Miniaturas", "Personal" },
	Thumbnails = {},
	Videos = {},
	Counters = {},
	Visited = { Districts = {}, Recorded = {}, Stores = {}, Categories = {}, Secrets = {}, Cameras = {}, Collectibles = {}, Destinations = {} },
	Trip = { At = "", Since = 0 },
	Quests = { Completed = {}, Claimed = {}, Step = 1, StepProgress = 0, Skipped = false },
	Titles = {},
	EquippedTitle = "",
	Home = { Type = "room_cheap", Rent = Config.StarterRent, PlayDays = 0, NextDue = Config.RentPeriodDays, Debt = 0, Missed = 0, Paid = 0 },
	Appearance = { Shirt = 5, Pants = 2, Chosen = false },
	Settings = { Music = 0.5, Sfx = 0.7, ReduceMotion = false, UIScale = 1, Wallpaper = 1, Hints = true, Shadows = true },
	Receipts = {},
	ReceiptOrder = {},
	ExportTokens = 0,
	Job = {},
	Properties = {},
	Vehicles = {},
	HomeProperty = "",
	Sponsors = { Offers = {}, Active = {}, History = {}, Seq = 0, OffersDay = -1 },
	EventProg = { Day = 0, Done = {}, Scenes = 0, Published = 0, Joined = false },
	Lives = {},
	Needs = { Energy = 100, Mood = 70 },
	FoodOrders = {},
	Posts = {},
	Series = {},
	Pets = {},
	ActivePet = "",
	PetGear = { Acc = {}, Toys = {} },
	UsedBought = { Day = -1, Units = {} },
	LastLive = 0,
	Company = {},
	Friends = {},
	LastPost = 0,
	CollabLog = {},
	Studio = { Set = "", Ends = 0, Warned = false, Bg = "tourism" },
	Leisure = { CinemaNext = 0, BowlDay = 0, BowlGames = 0, BowlBest = 0, BowlTotal = 0, Idea = { Category = "", Title = "" } },
	Fitness = 0,
	Uid = 0,
	CreatedAt = 0,
	LastSeen = 0,
}

function DataService.Init(services)
	S = services
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(Config.DataStoreName)
	end)
	if ok then
		store = result
	else
		warn("[YTLife] DataStore no disponible: " .. tostring(result))
	end
end

local function lockIsForeign(lock)
	return lock ~= nil and lock.Job ~= game.JobId and (os.time() - (lock.T or 0)) < Config.SessionLockTimeout
end

local function migrate(data)
	-- Aquí se añadirán migraciones cuando cambie el esquema (data.Version < SCHEMA_VERSION).
	Util.reconcile(data, DataService.Template)
	data.Version = SCHEMA_VERSION
	return data
end

-- Devuelve data, estado ("ok" | "new" | "locked" | "error")
local function tryLoad(key)
	local status = "error"
	local loaded = nil
	local ok, err = pcall(function()
		store:UpdateAsync(key, function(old)
			if old ~= nil and lockIsForeign(old.__lock) then
				status = "locked"
				return nil -- cancela la escritura
			end
			if old == nil then
				status = "new"
				old = Util.deepCopy(DataService.Template)
				old.CreatedAt = os.time()
			else
				status = "ok"
			end
			old.__lock = { Job = game.JobId, T = os.time() }
			loaded = old
			return old
		end)
	end)
	if not ok then
		return nil, "error", err
	end
	return loaded, status
end

function DataService.load(player)
	local key = "u_" .. player.UserId
	local data, status, lastErr
	if store then
		for attempt = 1, Config.LoadRetries do
			data, status, lastErr = tryLoad(key)
			if data then
				break
			end
			if not player.Parent then
				return
			end
			task.wait(attempt * 2 + (status == "locked" and 4 or 0))
		end
	end

	local readOnly = false
	if not data then
		if RunService:IsStudio() then
			-- Modo de prueba: perfil temporal que NO se guarda.
			data = Util.deepCopy(DataService.Template)
			data.CreatedAt = os.time()
			readOnly = true
			warn("[YTLife] Studio: usando perfil temporal (activa 'Studio Access to API Services' para guardar). " .. tostring(lastErr or status))
		else
			S.Net.logError("load " .. player.UserId, tostring(lastErr or status))
			player:Kick("No se pudieron cargar tus datos de forma segura (" .. tostring(status) .. "). Tu progreso está a salvo: vuelve a entrar en unos minutos.")
			return
		end
	end
	if not player.Parent then
		-- Se fue durante la carga: liberar el bloqueo sin cambiar nada más.
		if not readOnly then
			pcall(function()
				store:UpdateAsync(key, function(old)
					if old and old.__lock and old.__lock.Job == game.JobId then
						old.__lock = nil
						return old
					end
					return nil
				end)
			end)
		end
		return
	end

	data.__lock = nil
	migrate(data)
	local isNew = status == "new" or readOnly
	profiles[player] = { Data = data, ReadOnly = readOnly, Key = key, IsNew = isNew, LoadedAt = os.time() }
	return profiles[player]
end

-- Recorta listas para no superar el límite de tamaño del DataStore.
local function trimForSize(data)
	local ok, json = pcall(HttpService.JSONEncode, HttpService, data)
	if ok and #json > 3500000 then
		while #data.Videos > 50 do
			table.remove(data.Videos)
		end
		while #data.Photos > 60 do
			table.remove(data.Photos)
		end
		while #data.Transactions > 50 do
			table.remove(data.Transactions)
		end
	end
end

function DataService.save(player, release)
	local profile = profiles[player]
	if not profile or profile.ReadOnly or not store then
		return true
	end
	local data = profile.Data
	data.LastSeen = os.time()
	trimForSize(data)
	local success = false
	for attempt = 1, 3 do
		local ok, err = pcall(function()
			store:UpdateAsync(profile.Key, function(old)
				if old ~= nil and lockIsForeign(old.__lock) then
					-- Otro servidor tiene la sesión: no sobrescribir.
					return nil
				end
				local copy = data
				copy.__lock = (not release) and { Job = game.JobId, T = os.time() } or nil
				return copy
			end)
		end)
		data.__lock = nil
		if ok then
			success = true
			break
		end
		S.Net.logError("save " .. player.UserId, err)
		task.wait(attempt)
	end
	return success
end

function DataService.get(player)
	local p = profiles[player]
	return p and p.Data or nil
end

function DataService.getProfile(player)
	return profiles[player]
end

function DataService.isNew(player)
	local p = profiles[player]
	return p ~= nil and p.IsNew
end

function DataService.markDirty(player)
	dirty[player] = true
end

function DataService.nextUid(player, prefix)
	local data = DataService.get(player)
	data.Uid = data.Uid + 1
	return (prefix or "i") .. data.Uid
end

function DataService.release(player)
	if profiles[player] then
		DataService.save(player, true)
		profiles[player] = nil
		dirty[player] = nil
	end
end

function DataService.Start()
	-- Sincronización con el cliente (agrupa cambios cada 0,3 s)
	task.spawn(function()
		while true do
			task.wait(0.3)
			for player in pairs(dirty) do
				dirty[player] = nil
				if profiles[player] and player.Parent then
					local ok, err = pcall(S.Sync.send, player)
					if not ok then
						S.Net.logError("sync", err)
					end
				end
			end
		end
	end)

	-- Guardado automático
	task.spawn(function()
		while true do
			task.wait(Config.AutosaveInterval)
			for player in pairs(profiles) do
				task.spawn(DataService.save, player, false)
			end
		end
	end)

	game:BindToClose(function()
		local pending = 0
		for player in pairs(profiles) do
			pending = pending + 1
			task.spawn(function()
				DataService.save(player, true)
				pending = pending - 1
			end)
		end
		local start = os.clock()
		while pending > 0 and os.clock() - start < 25 do
			task.wait(0.2)
		end
	end)
end

return DataService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000033"><Properties><string name="Name">DestinationService</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- DestinationService: viajes y turismo a destinos desbloqueables (LifeData.Destinations).
--  * Vuelos desde el mostrador de la Terminal Internacional (Aeropuerto). El servidor comprueba la cercanía,
--    el coste (ida y vuelta), el nivel y la invitación (rango de creador o un patrocinio activo).
--  * Llegada a la zona del destino (lejos de la ciudad). Sus lugares 🎥 están en WorldData.Spots.
--  * Hotel opcional (recupera energía y ánimo), tienda exclusiva (objetos Exclusive del destino, solo allí)
--    y vuelo de vuelta al aeropuerto.
--  * Registra data.Visited.Destinations, data.Trip (dónde está, para el cliente) y contadores
--    (flights, hotel_nights, exclusives_bought).

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local Shared = ReplicatedStorage.Shared
local LifeData = require(Shared.LifeData)
local WorldData = require(Shared.WorldData)
local Catalog = require(Shared.ItemCatalog)
local Progression = require(Shared.Progression)
local Util = require(Shared.Util)

local Dest = {}
local S
local lastFlight = {}
local lastHotel = {}
local tripChanged = {}

Dest.CounterRadius = 35 -- distancia máxima al centro de la terminal para facturar
Dest.HotelCooldown = 90 -- segundos reales entre noches de hotel
Dest.FlightEnergy = 6 -- volar cansa un poco
Dest.FirstVisitXp = 60

function Dest.Init(services)
	S = services
end

local function rootOf(player)
	return player.Character and player.Character:FindFirstChild("HumanoidRootPart")
end

-- Destino en el que está el jugador ahora mismo (por posición) o nil si está en la ciudad
function Dest.at(player)
	local root = rootOf(player)
	if not root then
		return nil
	end
	return LifeData.destinationAt(root.Position.X, root.Position.Z)
end

function Dest.airport()
	for _, sp in ipairs(WorldData.Specials) do
		if sp.Type == "airport" then
			return sp
		end
	end
	return nil
end

-- Dentro de la terminal, delante del mostrador (llegada de los vuelos de vuelta y del taxi)
function Dest.airportArrival()
	local sp = Dest.airport()
	return Vector3.new(sp.WX, 4, sp.WZ + 6)
end

function Dest.atAirport(player)
	return S.World.nearSpecial(player, "airport", Dest.CounterRadius) ~= nil
end

function Dest.arrivalPoint(d)
	local a = LifeData.DestLayout.Arrival
	return Vector3.new(d.Center[1] + a[1], 4, d.Center[2] + a[2])
end

local function hasSponsor(data)
	return type(data.Sponsors) == "table" and next(data.Sponsors.Active or {}) ~= nil
end

-- ¿Puede volar a este destino? Devuelve ok, motivo
function Dest.check(data, d)
	local req = d.Req or {}
	if data.Level < (req.Level or 1) then
		return false, "Necesitas nivel " .. req.Level .. " para volar a " .. d.Name .. "."
	end
	if req.Rank then
		local rank = S.Progress.rank(data)
		if rank < req.Rank and not hasSponsor(data) then
			local r = Progression.Ranks[req.Rank]
			return false, d.Name .. " es solo con invitación: necesitas el rango «" .. (r and r.Name or tostring(req.Rank)) .. "» o un contrato de patrocinio activo."
		end
	end
	return true
end

local function setTrip(player, data, destId)
	data.Trip = data.Trip or { At = "", Since = 0 }
	data.Trip.At = destId or ""
	data.Trip.Since = os.time()
	tripChanged[player] = os.clock()
	S.Data.markDirty(player)
end

function Dest.fly(player, destId)
	local data = S.Data.get(player)
	local d = LifeData.DestById[type(destId) == "string" and destId or ""]
	if not d then
		return false, "Destino no válido."
	end
	if not rootOf(player) then
		return false, "No puedes viajar ahora."
	end
	local here = Dest.at(player)
	if here then
		return false, "Ya estás de viaje en " .. here.Name .. ". Vuelve primero desde la puerta de embarque."
	end
	if not Dest.atAirport(player) then
		return false, "Los vuelos salen del mostrador de la Terminal Internacional (Aeropuerto). Ve allí o pide un taxi desde la app Viajes."
	end
	local ok, why = Dest.check(data, d)
	if not ok then
		return false, why
	end
	if lastFlight[player] and os.clock() - lastFlight[player] < 3 then
		return false, "Espera un momento antes de volver a volar."
	end
	if not S.Economy.spend(player, d.Cost, "Viajes", "Vuelo a " .. d.Name) then
		return false, "El billete a " .. d.Name .. " cuesta $" .. Util.formatInt(d.Cost) .. " (ida y vuelta)."
	end
	lastFlight[player] = os.clock()
	local first = not data.Visited.Destinations[d.Id]
	data.Visited.Destinations[d.Id] = true
	data.Counters.flights = (data.Counters.flights or 0) + 1
	setTrip(player, data, d.Id)
	if S.Needs then
		S.Needs.spend(player, Dest.FlightEnergy)
	end
	S.Travel.teleport(player, Dest.arrivalPoint(d), "✈️ Volando a " .. d.Name .. "...")
	if first then
		S.Progress.addXp(player, Dest.FirstVisitXp)
		S.Net.notify(player, "🌍 ¡Nuevo destino descubierto: " .. d.Name .. "!", "gold")
	end
	S.Quest.check(player)
	return true, "✈️ Vuelo a " .. d.Name .. " ($" .. Util.formatInt(d.Cost) .. ", ida y vuelta). Busca los lugares 🎥, la tienda exclusiva y el hotel.", { dest = d.Id }
end

function Dest.goBack(player)
	local data = S.Data.get(player)
	local d = Dest.at(player)
	if not d then
		return false, "No estás de viaje: los vuelos de vuelta salen de la puerta de embarque de cada destino."
	end
	if lastFlight[player] and os.clock() - lastFlight[player] < 3 then
		return false, "Espera un momento antes de volver a volar."
	end
	lastFlight[player] = os.clock()
	setTrip(player, data, "")
	S.Travel.teleport(player, Dest.airportArrival(), "✈️ Volando de vuelta a la ciudad...")
	return true, "🛬 Has vuelto de " .. d.Name .. " a la Terminal Internacional."
end

function Dest.hotel(player)
	local data = S.Data.get(player)
	local d = Dest.at(player)
	if not d then
		return false, "Los hoteles de viaje están en los destinos."
	end
	if not S.Needs then
		return false, "El hotel está completo."
	end
	local h = d.Hotel
	if lastHotel[player] and os.clock() - lastHotel[player] < Dest.HotelCooldown then
		return false, "Acabas de descansar en el hotel. Sal a grabar un rato."
	end
	if not S.Economy.spend(player, h.Price, "Viajes", "Hotel: " .. h.Name) then
		return false, "Una noche en " .. h.Name .. " cuesta $" .. Util.formatInt(h.Price) .. "."
	end
	lastHotel[player] = os.clock()
	S.Needs.change(player, h.Energy, h.Mood)
	data.Counters.hotel_nights = (data.Counters.hotel_nights or 0) + 1
	S.Quest.check(player)
	return true, "🏨 Noche en " .. h.Name .. ": energía +" .. h.Energy .. ", ánimo +" .. h.Mood .. " ($" .. Util.formatInt(h.Price) .. ")."
end

local function rememberNonce(data, nonce, result)
	data.Processed[nonce] = result
	table.insert(data.ProcessedOrder, nonce)
	while #data.ProcessedOrder > 40 do
		local old = table.remove(data.ProcessedOrder, 1)
		data.Processed[old] = nil
	end
end

function Dest.buy(player, p)
	local data = S.Data.get(player)
	local nonce = p.nonce
	if type(nonce) ~= "string" or #nonce < 6 or #nonce > 40 then
		return false, "Petición de compra no válida."
	end
	if data.Processed[nonce] then
		return true, "Compra ya registrada (no se ha cobrado dos veces).", data.Processed[nonce]
	end
	local def = Catalog.get(type(p.item) == "string" and p.item or "")
	if not def or not def.Exclusive then
		return false, "Ese producto no es un exclusivo de viaje."
	end
	local origin = LifeData.DestById[def.Exclusive]
	local here = Dest.at(player)
	if not here or here.Id ~= def.Exclusive then
		return false, def.Name .. " solo se vende en " .. (origin and origin.Name or "su destino") .. ". Tienes que estar allí."
	end
	if data.Level < (def.Req.Level or 1) then
		return false, "Necesitas nivel " .. def.Req.Level .. " para comprar " .. def.Name .. "."
	end
	if Util.count(data.Inventory) >= S.Inventory.MaxItems then
		return false, "Tu inventario está lleno. Vende algo primero."
	end
	local fits = def.Portable and S.Inventory.canFit(player, def)
	if not fits and not S.Property.canStore(player, 1) then
		return false, "No cabe en tu mochila y tu vivienda está llena. Haz sitio antes de comprar."
	end
	if not S.Economy.spend(player, def.Price, "Viajes", def.Name .. " (" .. here.Name .. ")") then
		return false, "No tienes suficiente dinero ($" .. Util.formatInt(def.Price) .. ")."
	end
	local uid, loc = S.Inventory.add(player, def.Id, { src = "travel", paid = def.Price, loc = "backpack" })
	if not uid then
		S.Economy.add(player, def.Price, "Viajes", "Reembolso: " .. def.Name, { silent = true })
		return false, "No se pudo entregar el producto. Se te ha devuelto el dinero."
	end
	data.Counters.exclusives_bought = (data.Counters.exclusives_bought or 0) + 1
	local result = { itemId = def.Id, uid = uid, loc = loc }
	rememberNonce(data, nonce, result)
	S.Shop.afterPurchase(player, 1, def.Price)
	return true, "🛍 Compraste " .. def.Name .. " por $" .. Util.formatInt(def.Price) .. ". "
		.. (loc == "backpack" and "Está en tu mochila." or "No cabía en la mochila: te lo envían a casa."), result
end

function Dest.Start()
	local Net = S.Net

	Net.on("Destination.Fly", function(player, p)
		return Dest.fly(player, p.dest)
	end)
	Net.on("Destination.Return", function(player)
		return Dest.goBack(player)
	end)
	Net.on("Destination.Hotel", function(player)
		return Dest.hotel(player)
	end)
	Net.on("Destination.Buy", function(player, p)
		return Dest.buy(player, p)
	end)
	Net.on("Destination.Taxi", function(player)
		if Dest.at(player) then
			return false, "Estás de viaje: vuelve en avión desde la puerta de embarque."
		end
		if Dest.atAirport(player) then
			return false, "Ya estás en la Terminal Internacional."
		end
		return S.Travel.taxiTo(player, Dest.airportArrival(), "Terminal Internacional")
	end)

	Players.PlayerRemoving:Connect(function(player)
		lastFlight[player] = nil
		lastHotel[player] = nil
		tripChanged[player] = nil
	end)

	-- data.Trip sigue a la posición real (p. ej. si reaparece en la ciudad o vuelve a entrar al juego)
	task.spawn(function()
		while true do
			task.wait(2)
			for _, player in ipairs(Players:GetPlayers()) do
				local data = S.Data.get(player)
				if data and rootOf(player) and not (tripChanged[player] and os.clock() - tripChanged[player] < 4) then
					local d = Dest.at(player)
					local id = d and d.Id or ""
					data.Trip = data.Trip or { At = "", Since = 0 }
					if data.Trip.At ~= id then
						data.Trip.At = id
						data.Trip.Since = os.time()
						S.Data.markDirty(player)
					end
				end
			end
		end
	end)
end

return Dest
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000034"><Properties><string name="Name">EconomyService</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- EconomyService: dinero virtual, movimientos, informes mensuales, ahorro, metas y préstamos.
-- El dinero del juego es independiente de Robux. Solo el servidor modifica el saldo.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Util = require(Shared.Util)

local Economy = {}
local S

local function monthKey()
	return "M" .. S.Time.monthIndex()
end

local function bucket(data)
	local key = monthKey()
	local m = data.Monthly[key]
	if not m then
		m = { Inc = {}, Exp = {} }
		data.Monthly[key] = m
		-- conservar solo los últimos meses
		local keys = {}
		for k in pairs(data.Monthly) do
			keys[#keys + 1] = k
		end
		table.sort(keys, function(a, b)
			return tonumber(a:sub(2)) > tonumber(b:sub(2))
		end)
		for i = Config.MonthsKept + 1, #keys do
			data.Monthly[keys[i]] = nil
		end
	end
	return m
end

local function log(data, amount, category, desc)
	Util.pushCapped(data.Transactions, { T = os.time(), A = amount, C = category, D = desc, B = data.Money }, Config.MaxTransactions)
	local m = bucket(data)
	if amount >= 0 then
		m.Inc[category] = (m.Inc[category] or 0) + amount
	else
		m.Exp[category] = (m.Exp[category] or 0) - amount
	end
end

function Economy.Init(services)
	S = services
end

-- Suma dinero. opts.taxable aplica el impuesto simulado; opts.silent no avisa.
function Economy.add(player, amount, category, desc, opts)
	local data = S.Data.get(player)
	if not data or amount <= 0 then
		return 0
	end
	amount = math.floor(amount + 0.5)
	opts = opts or {}
	data.Money = data.Money + amount
	data.LifetimeEarned = data.LifetimeEarned + amount
	log(data, amount, category, desc)
	local net = amount
	if opts.taxable then
		local tax = math.floor(amount * Config.IncomeTaxRate + 0.5)
		if tax > 0 then
			data.Money = data.Money - tax
			log(data, -tax, "Impuestos", "Impuesto (" .. math.floor(Config.IncomeTaxRate * 100) .. "%) sobre " .. desc)
			net = amount - tax
		end
	end
	-- Pago automático del préstamo: 10% de los ingresos imponibles
	if opts.taxable and data.Bank.Loan > 0 then
		local pay = math.min(data.Bank.Loan, math.floor(net * 0.1 + 0.5), data.Money)
		if pay > 0 then
			data.Money = data.Money - pay
			data.Bank.Loan = data.Bank.Loan - pay
			log(data, -pay, "Préstamo", "Cuota automática del préstamo")
		end
	end
	S.Data.markDirty(player)
	if not opts.silent then
		S.Net.push(player, "cash", { amount = net, desc = desc })
	end
	return net
end

function Economy.canAfford(player, amount)
	local data = S.Data.get(player)
	return data ~= nil and data.Money >= amount
end

-- Cobra dinero. Devuelve false si no alcanza (no deja saldo negativo).
function Economy.spend(player, amount, category, desc)
	local data = S.Data.get(player)
	amount = math.floor(amount + 0.5)
	if not data or amount < 0 or data.Money < amount then
		return false
	end
	if amount == 0 then
		return true
	end
	data.Money = data.Money - amount
	log(data, -amount, category, desc)
	S.Data.markDirty(player)
	return true
end

function Economy.balanceSummary(data)
	local m = data.Monthly[monthKey()] or { Inc = {}, Exp = {} }
	local inc, exp = 0, 0
	for _, v in pairs(m.Inc) do
		inc = inc + v
	end
	for _, v in pairs(m.Exp) do
		exp = exp + v
	end
	return inc, exp
end

function Economy.loanLimit(data)
	return 1000 + data.Level * 500
end

-- Interés semanal de ahorros (1% por semana de juego, hasta 500 por semana)
function Economy.onNewDay(player, day)
	local data = S.Data.get(player)
	if not data then
		return
	end
	local bank = data.Bank
	if day - bank.LastInterestDay >= Config.DaysPerMonth then
		bank.LastInterestDay = day
		local interest = math.min(500, math.floor(bank.Savings * 0.01))
		if interest > 0 then
			bank.Savings = bank.Savings + interest
			log(data, 0, "Ahorros", "Intereses de ahorro: +" .. interest .. " (en la cuenta de ahorro)")
			S.Net.notify(player, "Tus ahorros generaron $" .. interest .. " de interés.", "success")
		end
	end
end

function Economy.Start()
	local Net = S.Net

	Net.on("Bank.Deposit", function(player, p)
		local amount = math.floor(tonumber(p.amount) or 0)
		if amount <= 0 then
			return false, "Cantidad no válida."
		end
		if not Economy.spend(player, amount, "Ahorros", "Depósito en la cuenta de ahorro") then
			return false, "No tienes suficiente dinero."
		end
		local data = S.Data.get(player)
		data.Bank.Savings = data.Bank.Savings + amount
		return true, "Depositaste $" .. Util.formatInt(amount) .. " en ahorros."
	end)

	Net.on("Bank.Withdraw", function(player, p)
		local data = S.Data.get(player)
		local amount = math.floor(tonumber(p.amount) or 0)
		if amount <= 0 or amount > data.Bank.Savings then
			return false, "Cantidad no válida."
		end
		data.Bank.Savings = data.Bank.Savings - amount
		data.Money = data.Money + amount
		log(data, amount, "Ahorros", "Retiro de la cuenta de ahorro")
		return true, "Retiraste $" .. Util.formatInt(amount) .. "."
	end)

	Net.on("Bank.TakeLoan", function(player, p)
		local data = S.Data.get(player)
		local amount = math.floor(tonumber(p.amount) or 0)
		local limit = Economy.loanLimit(data)
		if amount < 100 then
			return false, "El préstamo mínimo es de $100."
		end
		if data.Bank.Loan + amount * (1 + data.Bank.LoanRate) > limit * (1 + data.Bank.LoanRate) then
			return false, "Superarías tu límite de préstamo ($" .. Util.formatInt(limit) .. ")."
		end
		local owed = math.floor(amount * (1 + data.Bank.LoanRate) + 0.5)
		data.Bank.Loan = data.Bank.Loan + owed
		data.Money = data.Money + amount
		log(data, amount, "Préstamo", "Préstamo recibido (devolverás $" .. owed .. ")")
		return true, "Préstamo concedido. Devolverás $" .. Util.formatInt(owed) .. " (10% fijo). Se descuenta el 10% de tus ingresos hasta saldarlo."
	end)

	Net.on("Bank.RepayLoan", function(player, p)
		local data = S.Data.get(player)
		local amount = math.min(math.floor(tonumber(p.amount) or 0), data.Bank.Loan)
		if amount <= 0 then
			return false, "No tienes deuda o la cantidad no es válida."
		end
		if not Economy.spend(player, amount, "Préstamo", "Pago manual del préstamo") then
			return false, "No tienes suficiente dinero."
		end
		data.Bank.Loan = data.Bank.Loan - amount
		return true, data.Bank.Loan == 0 and "¡Préstamo saldado!" or ("Quedan $" .. Util.formatInt(data.Bank.Loan) .. " por pagar.")
	end)

	Net.on("Bank.SetGoal", function(player, p)
		local data = S.Data.get(player)
		local name = Util.cleanText(p.name, 40)
		local target = math.floor(tonumber(p.target) or 0)
		if p.remove then
			local idx = tonumber(p.remove)
			if idx and data.Bank.Goals[idx] then
				table.remove(data.Bank.Goals, idx)
				return true, "Meta eliminada."
			end
			return false, "Meta no encontrada."
		end
		if not name or #name == 0 or target <= 0 then
			return false, "Escribe un nombre y una cantidad."
		end
		if #data.Bank.Goals >= 5 then
			return false, "Máximo 5 metas."
		end
		name = S.Text.filter(player, name)
		if not name then
			return false, "Ese nombre no está permitido."
		end
		table.insert(data.Bank.Goals, { Name = name, Target = target })
		return true, "Meta creada."
	end)
end

return Economy
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000035"><Properties><string name="Name">EventService</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- EventService: eventos dinámicos diarios (EventData). Cada evento tiene lugar, horario, efectos reales
-- (descuentos, más visitas, escenas más interesantes en el lugar, taxis más baratos) y objetivos con
-- recompensa que se cobran una vez por evento. Hay un escenario con luces en el lugar del evento.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local Shared = ReplicatedStorage.Shared
local EventData = require(Shared.EventData)
local WorldData = require(Shared.WorldData)
local Util = require(Shared.Util)

local Events = {}
local S
local beacon

function Events.Init(services)
	S = services
end

function Events.current()
	local day = S.Time.day()
	return EventData.forDay(day), day
end

function Events.isActive()
	local ev = Events.current()
	local h = S.Time.hour()
	return h >= ev.Hours[1] and h < ev.Hours[2]
end

local function effect(name)
	local ev = Events.current()
	return ev.Effects and ev.Effects[name] or nil
end

function Events.priceMultiplier(def)
	local d = effect("Discount")
	if d and (d.All or Util.indexOf(d.Cats or {}, def.Cat)) then
		return 1 - d.Rate
	end
	return 1
end

function Events.usedDiscount()
	return effect("UsedDiscount") or 0
end

function Events.taxiMultiplier()
	return effect("TaxiDiscount") and (1 - effect("TaxiDiscount")) or 1
end

function Events.viewMultiplier(categoryId)
	local v = effect("ViewBonus")
	if v and Util.indexOf(v.Cats or {}, categoryId) then
		return v.Mult
	end
	return 1
end

function Events.sceneBonus(spot)
	local ev = Events.current()
	if spot and spot.Id == ev.Spot and Events.isActive() then
		return ev.Effects.EventSpotBonus or 1.1
	end
	return 1
end

function Events.atEvent(player)
	local ev = Events.current()
	local spot = WorldData.SpotById[ev.Spot]
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if not spot or not root then
		return false
	end
	local dx, dz = root.Position.X - spot.X, root.Position.Z - spot.Z
	return dx * dx + dz * dz <= 50 * 50
end

local function progress(data)
	local ev, day = Events.current()
	local p = data.EventProg
	if not p or p.Day ~= day then
		p = { Day = day, Event = ev.Id, Done = {}, Scenes = 0, Published = 0, Joined = false }
		data.EventProg = p
	end
	return p, ev
end
Events.progress = progress

local function complete(player, index)
	local data = S.Data.get(player)
	local p, ev = progress(data)
	local key = tostring(index)
	if p.Done[key] then
		return
	end
	p.Done[key] = true
	local g = ev.Goals[index]
	if not p.Joined then
		p.Joined = true
		data.Counters.events_joined = (data.Counters.events_joined or 0) + 1
	end
	data.Counters.events_goals = (data.Counters.events_goals or 0) + 1
	S.Economy.add(player, g.Reward, "Eventos", ev.Name .. ": " .. EventData.goalText(g), {})
	S.Progress.addXp(player, 25)
	S.Net.notify(player, "🎪 " .. ev.Name .. " — objetivo cumplido: " .. EventData.goalText(g) .. " (+$" .. g.Reward .. ")", "success")
	S.Quest.check(player)
end

local function check(player, kind, value)
	local data = S.Data.get(player)
	if not data then
		return
	end
	local p, ev = progress(data)
	for i, g in ipairs(ev.Goals) do
		if not p.Done[tostring(i)] and g.Type == kind then
			local ok = false
			if kind == "checkin" then
				ok = value == true
			elseif kind == "photo" then
				ok = value >= g.MinQ
			elseif kind == "scene" then
				ok = p.Scenes >= g.N
			elseif kind == "decor" then
				ok = value >= g.Min
			elseif kind == "publish" then
				local v = value
				local catOk = not g.Cats or Util.indexOf(g.Cats, v.Cat) ~= nil
				local editOk = not g.MinEdit or (v.EditQ or 0) >= g.MinEdit
				if catOk and editOk then
					p["Pub" .. i] = (p["Pub" .. i] or 0) + 1
				end
				ok = (p["Pub" .. i] or 0) >= g.N
			end
			if ok then
				complete(player, i)
			end
		end
	end
end

function Events.onScene(player, spot)
	local data = S.Data.get(player)
	local p, ev = progress(data)
	if spot and spot.Id == ev.Spot and Events.isActive() then
		p.Scenes = p.Scenes + 1
		check(player, "scene")
	end
end

function Events.onPhoto(player, photo)
	local ev = Events.current()
	if photo.Spot == ev.Spot and Events.isActive() then
		check(player, "photo", photo.Q)
	end
end

function Events.onPublish(player, video)
	check(player, "publish", video)
end

function Events.onDecor(player, score)
	check(player, "decor", score)
end

local function moveBeacon()
	local ev = Events.current()
	local spot = WorldData.SpotById[ev.Spot]
	if not spot then
		return
	end
	if beacon then
		beacon:Destroy()
	end
	local m = Instance.new("Model")
	m.Name = "EventBeacon"
	local function part(name, size, pos, color, mat, transp)
		local p = Instance.new("Part")
		p.Name = name
		p.Anchored = true
		p.CanCollide = name == "Stage"
		p.Size = size
		p.CFrame = CFrame.new(pos)
		p.Color = color
		p.Material = mat or Enum.Material.Neon
		p.Transparency = transp or 0
		p.Parent = m
		return p
	end
	local base = Vector3.new(spot.X + 18, 0.5, spot.Z - 14)
	part("Stage", Vector3.new(16, 1.2, 10), base + Vector3.new(0, 0.6, 0), Color3.fromRGB(30, 30, 36), Enum.Material.Metal)
	local beam = part("LightBeam", Vector3.new(3, 120, 3), base + Vector3.new(0, 61, 0), Color3.fromRGB(255, 80, 200), Enum.Material.Neon, 0.6)
	beam.CastShadow = false
	for i = -1, 1, 2 do
		part("Flag", Vector3.new(0.4, 14, 0.4), base + Vector3.new(i * 8, 7, -5), Color3.fromRGB(240, 240, 240), Enum.Material.Metal)
		part("Banner", Vector3.new(0.2, 4, 3), base + Vector3.new(i * 8, 11, -3.4), Color3.fromRGB(255, 52, 82), Enum.Material.Fabric)
	end
	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.fromOffset(260, 50)
	bb.StudsOffset = Vector3.new(0, 14, 0)
	bb.MaxDistance = 400
	bb.Parent = m.Stage
	local t = Instance.new("TextLabel")
	t.Size = UDim2.fromScale(1, 1)
	t.BackgroundColor3 = Color3.fromRGB(120, 20, 90)
	t.BackgroundTransparency = 0.15
	t.TextColor3 = Color3.new(1, 1, 1)
	t.Font = Enum.Font.GothamBlack
	t.TextScaled = true
	t.Text = "🎪 " .. ev.Name
	t.Parent = bb
	m.Parent = workspace
	beacon = m
	workspace:SetAttribute("EventId", ev.Id)
end

function Events.Start()
	moveBeacon()
	local lastDay = S.Time.day()
	task.spawn(function()
		while true do
			task.wait(2)
			local day = S.Time.day()
			if day ~= lastDay then
				lastDay = day
				moveBeacon()
				local ev = Events.current()
				for _, player in ipairs(Players:GetPlayers()) do
					S.Net.notify(player, "🎪 Nuevo evento hoy: " .. ev.Name .. " — " .. ev.Desc, "info")
				end
			end
			workspace:SetAttribute("EventActive", Events.isActive())
			for _, player in ipairs(Players:GetPlayers()) do
				local data = S.Data.get(player)
				if data and Events.isActive() and Events.atEvent(player) then
					check(player, "checkin", true)
				end
			end
		end
	end)
end

return Events
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000036"><Properties><string name="Name">FriendService</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- FriendService: amistades con 12 personajes de la ciudad (FriendData). Solo amistad y relación profesional.
--  * Cada personaje está en la acera de su distrito, con su nombre y oficio encima y un aviso «Hablar».
--  * Charlar (1 vez al día por personaje), regalar un objeto de tu inventario (1 al día), pedir favores según el nivel.
--  * Al subir de nivel te escribe un mensaje al teléfono. Si pasas muchos días sin hablar, la amistad se enfría
--    muy despacio (nunca por debajo del nivel 1).
--  * Efectos reales: invitado en tu vídeo (+interés), descuento en su tienda (ShopService), tendencias de mañana,
--    encargos pagados, ofertas de patrocinio, recetas y rutas a lugares secretos.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local Shared = ReplicatedStorage.Shared
local FriendData = require(Shared.FriendData)
local WorldData = require(Shared.WorldData)
local VideoData = require(Shared.VideoData)
local Catalog = require(Shared.ItemCatalog)
local SponsorData = require(Shared.SponsorData)
local PropertyData = require(Shared.PropertyData)
local Util = require(Shared.Util)

local Friend = {}
local S
local spawned = {} -- id -> { Model, Pos, Prompt }
Friend.Spawned = spawned

local GROUND_TOP = 0.5
local catNames = {}
for _, c in ipairs(Catalog.Categories) do
	catNames[c.Key] = c.Name
end

function Friend.Init(services)
	S = services
end

local function today()
	return S.Time.day()
end

local function friendsOf(data)
	if type(data.Friends) ~= "table" then
		data.Friends = {}
	end
	return data.Friends
end

local function districtName(id)
	local d = WorldData.DistrictById[id or ""]
	return d and d.Name or "la ciudad"
end

-- "v:tech" -> "vídeos de Tecnología"; "g:camera" -> "regalos: Cámaras"
function Friend.likeText(key)
	local kind, id = key:sub(1, 1), key:sub(3)
	if kind == "v" then
		local c = VideoData.CategoryById[id]
		return "vídeos de " .. (c and c.Name or id)
	end
	return "regalos de " .. (catNames[id] or id)
end

local function log(f, text)
	f.Log = f.Log or {}
	table.insert(f.Log, 1, { D = today(), T = text })
	while #f.Log > FriendData.MaxLog do
		table.remove(f.Log)
	end
end

local function newRecord(day)
	return { Pts = 0, Lvl = 1, Met = day, Last = day, Chat = -1, Gift = -1, Talks = 0, Gifts = 0, Known = {}, Favors = {}, Log = {} }
end

local function pick(list, seed)
	return list[(seed % #list) + 1]
end

---------------------------------------------------------------------------
-- Puntos, niveles y enfriamiento
---------------------------------------------------------------------------
local function addPts(player, id, f, n)
	local def = FriendData.ById[id]
	local before = FriendData.levelOf(f.Pts)
	f.Pts = f.Pts + n
	local after = FriendData.levelOf(f.Pts)
	f.Lvl = after
	if after > before then
		local pers = FriendData.Personalities[def.Personality]
		local lvlName = FriendData.Levels[after].Name
		local msg = "📱 " .. def.Name .. ": «" .. string.format(pers.Up, lvlName) .. "»"
		local fav = FriendData.favorAt(def, after)
		if fav then
			msg = msg .. " Ya puedes pedirle: " .. FriendData.FavorKinds[fav.Kind].Name .. "."
		end
		S.Net.notify(player, msg, "gold")
		log(f, "Ahora sois " .. lvlName .. ".")
		S.Quest.check(player)
	end
	S.Data.markDirty(player)
	return after > before
end

local function decay(player, id, f, day)
	local start = (f.Last or day) + FriendData.DecayAfterDays
	if f.DecayDay and f.DecayDay > start then
		start = f.DecayDay
	end
	if day <= start then
		return
	end
	local before = FriendData.levelOf(f.Pts)
	f.Pts = math.max(FriendData.Levels[1].Pts, f.Pts - (day - start) * FriendData.DecayPerDay)
	f.DecayDay = day
	local after = FriendData.levelOf(f.Pts)
	f.Lvl = after
	if after < before then
		local def = FriendData.ById[id]
		S.Net.notify(player, "📱 " .. def.Name .. ": «¡Hace mucho que no hablamos! Pásate por " .. districtName(def.District) .. " cuando puedas.»", "info")
		log(f, "La amistad se ha enfriado un poco (" .. FriendData.Levels[after].Name .. ").")
	end
	S.Data.markDirty(player)
end

-- Aplica el enfriamiento y caduca efectos terminados (descuentos, invitados de vídeos ya publicados).
function Friend.refresh(player)
	local data = S.Data.get(player)
	if not data then
		return
	end
	local day = today()
	for id, f in pairs(friendsOf(data)) do
		if FriendData.ById[id] and type(f) == "table" then
			f.Pts = tonumber(f.Pts) or 0
			decay(player, id, f, day)
			if f.Discount and f.Discount.Until < day then
				f.Discount = nil
			end
			local g = f.Guest
			if g and g.Pid then
				local proj = data.Projects[g.Pid]
				if not proj or proj.Status == "published" then
					log(f, "Terminó su aparición como invitado (" .. (g.Scenes or 0) .. " escenas juntos).")
					f.Guest = nil
				end
			end
			if f.Tip and f.Tip.Day < day then
				f.Tip = nil
			end
		end
	end
	Friend.updatePlacement()
end

---------------------------------------------------------------------------
-- Personajes en el mundo
---------------------------------------------------------------------------
local function freePosition(d)
	local cx, cz = WorldData.center(d)
	local half = (WorldData.CellSize - WorldData.RoadWidth) / 2 - 3
	local blockers = {}
	local function block(x, z, r)
		blockers[#blockers + 1] = { x, z, r }
	end
	for _, s in ipairs(d.Spots) do
		block(cx + s.X, cz + s.Z, 18)
	end
	for _, sp in ipairs(WorldData.Specials) do
		if sp.District == d.Id then
			block(sp.WX, sp.WZ, (sp.Type == "home" and 80) or (sp.Type == "dealer" and 64) or 55)
		end
	end
	for _, s in ipairs(WorldData.Secrets) do
		if s.District == d.Id then
			block(s.WX, s.WZ, 14)
		end
	end
	local stop = S.Travel.taxiStop(d)
	block(stop.X, stop.Z, 22)
	block(stop.X - 40, stop.Z, 10) -- parada del autobús
	for _, p in ipairs({ { -half, -half / 2 }, { half, half / 2 }, { half / 2, -half }, { -half / 2, half } }) do
		block(cx + p[1], cz + p[2], 8) -- farolas
	end
	block(cx - 92, cz + 112, 18) -- coches aparcados
	if d.Id == "events" then
		block(cx + 90, cz - 90, 40) -- sala VIP
	end
	for _, np in ipairs(S.World.NpcPoints or {}) do
		block(np.Pos.X, np.Pos.Z, 8)
	end
	for _, l in ipairs(PropertyData.Listings or {}) do
		if l.District == d.Id and S.Property and S.Property.signPosition then
			local ok, pos = pcall(S.Property.signPosition, l)
			if ok and pos then
				block(pos.X, pos.Z, 12)
			end
		end
	end
	for _, other in pairs(spawned) do
		block(other.Pos.X, other.Pos.Z, 12)
	end
	local candidates = { { -40, half }, { half, -30 }, { -half, 30 }, { -30, -half }, { 95, half }, { half, 95 }, { -half, -95 }, { 95, -half }, { -95, -half }, { -half, 95 } }
	for _, c in ipairs(candidates) do
		local x, z = cx + c[1], cz + c[2]
		local free = true
		for _, b in ipairs(blockers) do
			if (x - b[1]) ^ 2 + (z - b[2]) ^ 2 < b[3] ^ 2 then
				free = false
				break
			end
		end
		if free and d.Water then
			local wx, wz = cx + d.Water.X, cz + d.Water.Z
			if math.abs(x - wx) <= d.Water.W / 2 + 8 and math.abs(z - wz) <= d.Water.D / 2 + 8 then
				free = false
			end
		end
		if free then
			return Vector3.new(x, GROUND_TOP, z), Vector3.new(cx, GROUND_TOP, cz)
		end
	end
	return Vector3.new(cx - 40, GROUND_TOP, cz + half), Vector3.new(cx, GROUND_TOP, cz)
end

local function label(parent, text, y, h, font, color)
	local t = Instance.new("TextLabel")
	t.Size = UDim2.new(1, 0, h, 0)
	t.Position = UDim2.new(0, 0, y, 0)
	t.BackgroundTransparency = 1
	t.TextColor3 = color
	t.TextStrokeTransparency = 0.4
	t.Font = font
	t.TextScaled = true
	t.Text = text
	t.Parent = parent
	return t
end

local function place(sp, pos, look)
	sp.Pos = pos
	local at = Vector3.new(pos.X, pos.Y + 3, pos.Z)
	sp.Model:PivotTo(CFrame.lookAt(at, Vector3.new(look.X, at.Y, look.Z)))
end

local function spawnFriend(def, parent)
	local d = WorldData.DistrictById[def.District]
	local pos, center = freePosition(d)
	local shirt = Color3.fromRGB(def.Color[1], def.Color[2], def.Color[3])
	local m = S.NPC.makeModel(def.Name, shirt, Color3.fromRGB(45, 45, 60))
	local hum = m:FindFirstChildOfClass("Humanoid")
	if hum then
		hum.NameDisplayDistance = 0 -- el cartel ya muestra nombre y oficio
	end
	m:SetAttribute("FriendId", def.Id)
	m.Parent = parent
	local root = m.PrimaryPart or m:FindFirstChild("HumanoidRootPart")
	local bb = Instance.new("BillboardGui")
	bb.Name = "FriendTag"
	bb.Size = UDim2.fromOffset(220, 48)
	bb.StudsOffset = Vector3.new(0, 4.4, 0)
	bb.MaxDistance = 90
	bb.Parent = root
	label(bb, def.Name, 0, 0.55, Enum.Font.GothamBlack, Color3.new(1, 1, 1))
	label(bb, def.Job, 0.55, 0.45, Enum.Font.GothamBold, Color3.fromRGB(255, 220, 140))
	local pp = Instance.new("ProximityPrompt")
	pp.ActionText = "Hablar"
	pp.ObjectText = def.Name
	pp.HoldDuration = 0
	pp.MaxActivationDistance = 10
	pp.RequiresLineOfSight = false
	pp:SetAttribute("Action", "friend")
	pp:SetAttribute("FriendId", def.Id)
	pp.Parent = root
	pp.Triggered:Connect(function(player)
		local ok, err = pcall(Friend.talk, player, def.Id)
		if not ok then
			S.Net.logError("friend", err)
		end
	end)
	local sp = { Model = m, Pos = pos, Home = pos, HomeLook = center, Prompt = pp, Away = false }
	spawned[def.Id] = sp
	place(sp, pos, center)
end

-- Lugar de grabación de su distrito donde espera cuando sale como invitado en un vídeo
function Friend.guestSpot(id)
	local def = FriendData.ById[id or ""]
	local d = def and WorldData.DistrictById[def.District]
	if not d or not d.Spots[1] then
		return nil
	end
	return WorldData.SpotById[d.Id .. "_1"]
end

-- Mientras algún jugador lo tenga invitado, el personaje espera junto al lugar de grabación; si no, vuelve a la acera.
function Friend.updatePlacement()
	local wanted = {}
	for _, player in ipairs(Players:GetPlayers()) do
		local data = S.Data.get(player)
		if data and type(data.Friends) == "table" then
			for id, f in pairs(data.Friends) do
				if type(f) == "table" and f.Guest then
					wanted[id] = true
				end
			end
		end
	end
	for id, sp in pairs(spawned) do
		if wanted[id] and not sp.Away then
			local spot = Friend.guestSpot(id)
			if spot then
				sp.Away = true
				place(sp, Vector3.new(spot.X + 7, GROUND_TOP, spot.Z + 5), Vector3.new(spot.X, GROUND_TOP, spot.Z))
			end
		elseif not wanted[id] and sp.Away then
			sp.Away = false
			place(sp, sp.Home, sp.HomeLook)
		end
	end
end

function Friend.position(id)
	local sp = spawned[id]
	return sp and sp.Pos or nil
end

local function nearFriend(player, id, radius)
	local sp = spawned[id]
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if not sp or not root then
		return false
	end
	local dx, dz = root.Position.X - sp.Pos.X, root.Position.Z - sp.Pos.Z
	return dx * dx + dz * dz <= radius * radius
end
Friend.near = nearFriend

---------------------------------------------------------------------------
-- Acciones
---------------------------------------------------------------------------
local function greeting(def, f)
	local pers = FriendData.Personalities[def.Personality]
	local lines = pers.Greet[FriendData.tier(FriendData.levelOf(f.Pts))]
	return pick(lines, today() + (f.Talks or 0))
end

-- Aviso «Hablar»: se conocen (si es la primera vez) y aparece el diálogo con opciones.
function Friend.talk(player, id)
	local def = FriendData.ById[id or ""]
	local data = S.Data.get(player)
	if not def or not data then
		return
	end
	Friend.refresh(player)
	local list = friendsOf(data)
	local f = list[id]
	local text
	if not f then
		f = newRecord(today())
		list[id] = f
		log(f, "Os conocisteis en " .. districtName(def.District) .. ".")
		text = greeting(def, f) .. " Me llamo " .. def.Name .. ". " .. def.Bio
	else
		text = greeting(def, f)
	end
	f.Talks = (f.Talks or 0) + 1
	S.Data.markDirty(player)
	S.Net.push(player, "dialog", {
		name = def.Name .. " · " .. def.Job,
		text = text,
		options = {
			{ label = "💬 Charlar", call = "Friend.Chat", payload = { id = id } },
			{ label = "🫂 Amistad", ui = "app", app = "friends", params = { friend = id } },
		},
	})
	return f
end

function Friend.chat(player, id)
	local def = FriendData.ById[id or ""]
	local data = S.Data.get(player)
	if not def then
		return false, "Personaje no válido."
	end
	if not nearFriend(player, id, FriendData.TalkRadius) then
		return false, "Para charlar con " .. def.Name .. " tienes que estar a su lado. Suele estar en " .. districtName(def.District) .. "."
	end
	Friend.refresh(player)
	local list = friendsOf(data)
	local f = list[id]
	if not f then
		f = newRecord(today())
		list[id] = f
		log(f, "Os conocisteis en " .. districtName(def.District) .. ".")
	end
	local day = today()
	if f.Chat == day then
		return false, "Ya habéis charlado hoy. " .. def.Name .. " te espera mañana."
	end
	f.Chat = day
	f.Last = day
	local pers = FriendData.Personalities[def.Personality]
	local text = pick(pers.Chat[FriendData.tier(FriendData.levelOf(f.Pts))], day + #(f.Known or {}))
	-- En cada charla descubres uno de sus gustos
	f.Known = f.Known or {}
	local unknown = {}
	for _, key in ipairs(FriendData.likeKeys(def)) do
		if not Util.indexOf(f.Known, key) then
			unknown[#unknown + 1] = key
		end
	end
	if #unknown > 0 then
		local key = pick(unknown, day)
		table.insert(f.Known, key)
		text = text .. " Por cierto, me encantan los " .. Friend.likeText(key) .. "."
	end
	log(f, "Charlasteis un rato.")
	data.Counters.friend_chats = (data.Counters.friend_chats or 0) + 1
	if S.Needs and S.Needs.change then
		S.Needs.change(player, 0, 2)
	end
	addPts(player, id, f, FriendData.ChatPts)
	return true, "💬 " .. def.Name .. ": «" .. text .. "» (+" .. FriendData.ChatPts .. " amistad)", { pts = f.Pts, level = FriendData.levelOf(f.Pts) }
end

-- Motivo por el que no se puede regalar un objeto (nil = se puede)
function Friend.giftLock(player, uid)
	local data = S.Data.get(player)
	local rec = data and type(uid) == "string" and data.Inventory[uid]
	if not rec then
		return "No tienes ese objeto."
	end
	local item = Catalog.get(rec.Id)
	if not item then
		return "Objeto desconocido."
	end
	if S.Market and S.Market.lockReason then
		local why = S.Market.lockReason(player, uid)
		if why then
			return why
		end
	else
		local loc = rec.Loc or "home"
		if loc:sub(1, 4) == "rig:" or loc:sub(1, 5) == "prop:" or rec.Loan then
			return item.Name .. " está instalado, colocado o prestado."
		end
	end
	if S.Trade and S.Trade.isOffered and S.Trade.isOffered(player, uid) then
		return item.Name .. " está en una oferta de intercambio."
	end
	if data.Equipped.Phone == uid then
		return "Es el teléfono que usas. Equipa otro antes de regalarlo."
	end
	return nil
end

function Friend.gift(player, id, uid)
	local def = FriendData.ById[id or ""]
	local data = S.Data.get(player)
	if not def then
		return false, "Personaje no válido."
	end
	Friend.refresh(player)
	local f = friendsOf(data)[id]
	if not f then
		return false, "Primero preséntate a " .. def.Name .. " (" .. districtName(def.District) .. ")."
	end
	if not nearFriend(player, id, FriendData.TalkRadius) then
		return false, "Los regalos se dan en persona: ve a ver a " .. def.Name .. " en " .. districtName(def.District) .. "."
	end
	local day = today()
	if f.Gift == day then
		return false, "Ya le has hecho un regalo hoy a " .. def.Name .. ". ¡Mañana más!"
	end
	local why = Friend.giftLock(player, uid)
	if why then
		return false, why
	end
	local rec = data.Inventory[uid]
	local item = Catalog.get(rec.Id)
	local pts = FriendData.GiftBase + math.min(FriendData.GiftValueMax, math.floor((item.Price or 0) / 25))
	local pers = FriendData.Personalities[def.Personality]
	local reaction = pers.Neutral
	local liked = Util.indexOf(def.Gifts, item.Cat) ~= nil
	if liked then
		pts = pts * 2 + FriendData.GiftLikedBonus
		reaction = pers.Liked
		f.Known = f.Known or {}
		if not Util.indexOf(f.Known, "g:" .. item.Cat) then
			table.insert(f.Known, "g:" .. item.Cat)
		end
	elseif item.Cat == def.Dislike then
		pts = math.max(2, math.floor(pts / 2))
		reaction = "Gracias... aunque no es mucho lo mío. ¡Lo que cuenta es el detalle!"
	end
	if item.Collectible then
		pts = pts + 6
	end
	S.Inventory.remove(player, uid)
	f.Gift = day
	f.Last = day
	f.Gifts = (f.Gifts or 0) + 1
	data.Counters.gifts_given = (data.Counters.gifts_given or 0) + 1
	log(f, "Le regalaste " .. item.Name .. (liked and " (¡le encantó!)" or "") .. ".")
	addPts(player, id, f, pts)
	S.Quest.check(player)
	return true, "🎁 " .. def.Name .. ": «" .. reaction .. "» (+" .. pts .. " amistad)", { pts = f.Pts, gained = pts, liked = liked }
end

---------------------------------------------------------------------------
-- Favores
---------------------------------------------------------------------------
local favorHandlers = {}

function favorHandlers.trend(player, data, def, f)
	local hot = S.Channel.trendsFor(today() + 1)
	local names = {}
	for _, id in ipairs(hot) do
		local c = VideoData.CategoryById[id]
		names[#names + 1] = c and c.Name or id
	end
	f.Tip = { Day = today() + 1, Hot = hot }
	return true, "🔥 " .. def.Name .. ": «Me han chivado que mañana serán tendencia: " .. table.concat(names, ", ") .. ".» Prepara tu idea con tiempo."
end

function favorHandlers.guest(player, data, def, f)
	if f.Guest then
		local spot = Friend.guestSpot(def.Id)
		return false, def.Name .. " ya va a salir en tu próximo vídeo: te espera en " .. (spot and spot.Name or districtName(def.District)) .. "."
	end
	local spot = Friend.guestSpot(def.Id)
	if not spot then
		return false, "Hoy no puede salir en vídeos."
	end
	f.Guest = { Day = today(), Scenes = 0 }
	Friend.updatePlacement()
	return true, "🎬 " .. def.Name .. " saldrá en tu próximo vídeo: te espera en " .. spot.Name .. " (" .. districtName(def.District) .. "). Graba allí a su lado: +" .. FriendData.GuestInterest .. " de interés por escena."
end

function favorHandlers.discount(player, data, def, f, fav)
	local store = Catalog.Stores[fav.Store]
	f.Discount = { Store = fav.Store, Pct = fav.Pct, Until = today() + fav.Days }
	return true, "🏷 " .. def.Name .. " te consigue un " .. fav.Pct .. "% de descuento en " .. (store and store.Name or fav.Store) .. " durante " .. fav.Days .. " días (también en pedidos online)."
end

function favorHandlers.commission(player, data, def, f, fav)
	local spot = WorldData.SpotById[fav.Spot]
	if not spot then
		return false, "Ahora mismo no tiene ningún encargo."
	end
	if f.Task then
		return false, "Ya tienes su encargo pendiente: graba una escena en " .. spot.Name .. "."
	end
	f.Task = { Spot = spot.Id, Reward = fav.Reward, Day = today() }
	return true, "📦 Encargo de " .. def.Name .. ": graba una escena en " .. spot.Name .. " (" .. districtName(spot.District) .. ") y te pagará $" .. fav.Reward .. "."
end

function favorHandlers.sponsor(player, data, def, f, fav)
	local brand = SponsorData.BrandById[fav.Brand]
	if not brand or not S.Sponsor then
		return false, "Ahora mismo no conoce a ninguna marca."
	end
	pcall(S.Sponsor.refreshOffers, player) -- así la oferta nueva no se pierde al renovar las del día
	local sp = S.Sponsor.state(data)
	for _, o in ipairs(sp.Offers) do
		if o.Intro then
			return false, "Ya tienes una oferta presentada por un amigo en la app Patrocinios. Respóndela primero."
		end
	end
	local subs = data.Channel.Subs or 0
	local pay = (120 + 6 * math.sqrt(subs)) * (1 + (data.Reputation or 0) / 100) * FriendData.SponsorPayBonus
	sp.Seq = (sp.Seq or 0) + 1
	local cat = brand.Cats[(today() % #brand.Cats) + 1]
	table.insert(sp.Offers, 1, {
		Id = "o" .. sp.Seq,
		Brand = brand.Id,
		Kind = "campaign",
		Category = cat,
		MinQ = math.floor(math.min(70, 30 + math.sqrt(subs) * 0.25)),
		Days = 4,
		Pay = math.floor(pay / 5) * 5,
		Bonus = math.floor(pay * 0.3 / 5) * 5,
		Intro = def.Name,
	})
	local c = VideoData.CategoryById[cat]
	return true, "🤝 " .. def.Name .. " te presenta a " .. brand.Name .. ": tienes una oferta de patrocinio (" .. (c and c.Name or cat) .. ", $" .. math.floor(pay / 5) * 5 .. ") en la app Patrocinios."
end

function favorHandlers.recipe(player, data, def, f, fav)
	local item = Catalog.get(fav.Recipe)
	if not item then
		return false, "Hoy no tiene ninguna receta a mano."
	end
	local learned = false
	if type(data.Recipes) == "table" and not data.Recipes[fav.Recipe] then
		data.Recipes[fav.Recipe] = true
		learned = true
	end
	local uid, err = S.Inventory.add(player, fav.Recipe, { src = "gift", paid = 0, loc = "home" })
	if not uid then
		return false, err or "No tienes sitio para recibirlo."
	end
	f.Recipes = f.Recipes or {}
	if not Util.indexOf(f.Recipes, fav.Recipe) then
		table.insert(f.Recipes, fav.Recipe)
	end
	return true, "👨‍🍳 " .. def.Name .. " te enseña su receta de " .. item.Name .. (learned and " (receta desbloqueada)" or "") .. " y te regala una ración. Está en tu despensa."
end

function favorHandlers.route(player, data, def, f)
	if data.Trip and data.Trip.At and data.Trip.At ~= "" then
		return false, "Estás de viaje. Pídeselo cuando vuelvas a la ciudad."
	end
	-- Primero un secreto de su distrito; si no, el primero que aún no conozcas
	local target
	for _, s in ipairs(WorldData.Secrets) do
		if not data.Visited.Secrets[s.Id] and (not target or (s.District == def.District and target.District ~= def.District)) then
			target = s
		end
	end
	if not target then
		return false, "«¡Ya conoces todos mis rincones secretos!» No quedan lugares secretos por descubrir."
	end
	local cx, cz = WorldData.center(WorldData.DistrictById[target.District])
	local dx, dz = cx - target.WX, cz - target.WZ
	local len = math.sqrt(dx * dx + dz * dz)
	if len < 0.1 then
		dx, dz, len = 1, 0, 1
	end
	local pos = Vector3.new(target.WX + dx / len * 32, 4, target.WZ + dz / len * 32)
	if not S.Travel.teleport(player, pos) then
		return false, "No puedes viajar ahora."
	end
	f.Route = target.Id
	return true, "🧭 " .. def.Name .. " te lleva por una ruta secreta hasta " .. districtName(target.District) .. ": «" .. target.Hint .. "» Camina un poco hacia el destello dorado."
end

function Friend.favor(player, id, level)
	local def = FriendData.ById[id or ""]
	local data = S.Data.get(player)
	if not def then
		return false, "Personaje no válido."
	end
	Friend.refresh(player)
	local f = friendsOf(data)[id]
	if not f then
		return false, "Primero preséntate a " .. def.Name .. " (" .. districtName(def.District) .. ")."
	end
	local fav = FriendData.favorAt(def, math.floor(tonumber(level) or 0))
	if not fav then
		return false, "Ese favor no existe."
	end
	local kind = FriendData.FavorKinds[fav.Kind]
	if FriendData.levelOf(f.Pts) < fav.Level then
		return false, "Necesitáis ser «" .. FriendData.Levels[fav.Level].Name .. "» para pedirle: " .. kind.Name .. "."
	end
	local key = "L" .. fav.Level
	f.Favors = f.Favors or {}
	local last = f.Favors[key]
	local day = today()
	if last and day - last < kind.Cooldown then
		local wait = kind.Cooldown - (day - last)
		return false, def.Name .. " ya te ayudó con eso hace poco. Vuelve a pedírselo en " .. wait .. (wait == 1 and " día." or " días.")
	end
	local ok, msg = favorHandlers[fav.Kind](player, data, def, f, fav)
	if not ok then
		return false, msg
	end
	f.Favors[key] = day
	f.Last = day
	data.Counters.friend_favors = (data.Counters.friend_favors or 0) + 1
	log(f, "Favor: " .. kind.Name .. ".")
	S.Data.markDirty(player)
	return true, msg
end

---------------------------------------------------------------------------
-- Ganchos con otros servicios
---------------------------------------------------------------------------
-- Interés extra de una escena si grabas con tu invitado cerca (VideoService)
function Friend.interestBonus(player, pid)
	local data = S.Data.get(player)
	if not data or type(data.Friends) ~= "table" then
		return 0
	end
	for id, f in pairs(data.Friends) do
		local g = f.Guest
		if g and (g.Pid == nil or g.Pid == pid) and nearFriend(player, id, FriendData.GuestRadius) then
			return FriendData.GuestInterest
		end
	end
	return 0
end

-- Tras grabar una escena: el invitado queda ligado a ese vídeo y se completan encargos
function Friend.onScene(player, scene, pid)
	local data = S.Data.get(player)
	if not data or type(data.Friends) ~= "table" then
		return
	end
	for id, f in pairs(data.Friends) do
		local def = FriendData.ById[id]
		if def then
			local g = f.Guest
			if g and (g.Pid == nil or g.Pid == pid) and nearFriend(player, id, FriendData.GuestRadius) then
				g.Pid = pid
				g.Scenes = (g.Scenes or 0) + 1
				scene.Guest = def.Name
			end
			if f.Task and scene.Spot == f.Task.Spot then
				local reward = f.Task.Reward or 0
				f.Task = nil
				S.Economy.add(player, reward, "Encargos", "Encargo de " .. def.Name, { taxable = true })
				data.Counters.friend_tasks = (data.Counters.friend_tasks or 0) + 1
				log(f, "Completaste su encargo (+$" .. reward .. ").")
				S.Net.notify(player, "📱 " .. def.Name .. ": «¡Encargo recibido, gracias!» +$" .. reward, "success")
				addPts(player, id, f, 10)
			end
		end
	end
end

-- Descuento (0-1) que un amigo te consigue en la tienda que vende este objeto (ShopService)
function Friend.discountFor(player, item)
	local data = S.Data.get(player)
	if not data or type(data.Friends) ~= "table" or not item or not item.Stores then
		return 0
	end
	local best, day = 0, today()
	for _, f in pairs(data.Friends) do
		local dsc = f.Discount
		if dsc and dsc.Until >= day and Util.indexOf(item.Stores, dsc.Store) then
			best = math.max(best, (dsc.Pct or 0) / 100)
		end
	end
	return Util.clamp(best, 0, 0.5)
end

function Friend.Start()
	local Net = S.Net
	local city = workspace:FindFirstChild("City") or workspace
	local folder = Instance.new("Folder")
	folder.Name = "Friends"
	folder.Parent = city
	for _, def in ipairs(FriendData.Friends) do
		local ok, err = pcall(spawnFriend, def, folder)
		if not ok then
			Net.logError("friend spawn " .. def.Id, err)
		end
	end

	Net.on("Friend.Chat", function(player, p)
		return Friend.chat(player, type(p) == "table" and p.id or nil)
	end)
	Net.on("Friend.Gift", function(player, p)
		p = type(p) == "table" and p or {}
		return Friend.gift(player, p.id, p.uid)
	end)
	Net.on("Friend.Favor", function(player, p)
		p = type(p) == "table" and p or {}
		return Friend.favor(player, p.id, p.level)
	end)

	-- Enfriamiento y caducidad de efectos, sin prisa
	task.spawn(function()
		while true do
			task.wait(15)
			for _, player in ipairs(Players:GetPlayers()) do
				pcall(Friend.refresh, player)
			end
		end
	end)
end

return Friend
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000037"><Properties><string name="Name">HomeService</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- HomeService: vivienda inicial alquilada (habitación en la Residencia Económica).
--  * Cada jugador recibe una habitación propia con escritorio, computador, cama y vestidor.
--  * Lo que compras se ve en tu habitación (PC activo, monitores, silla, escritorio, luces, fondos).
--  * Alquiler semanal (cada 7 días de juego jugados). Si no hay saldo: deuda + recargo y aviso.
--    Nunca se pierde el progreso ni se desaloja al jugador.
--  * Estar en casa recarga las baterías.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Catalog = require(Shared.ItemCatalog)
local Util = require(Shared.Util)

local Home = {}
local S
local assigned = {} -- [player] = room
local atHome = {}

function Home.Init(services)
	S = services
end

function Home.room(player)
	return assigned[player]
end

function Home.isAtHome(player)
	if S.Property.inside(player) then
		return true
	end
	local room = assigned[player]
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if not room or not root then
		return false
	end
	local rel = root.Position - room.Center
	return math.abs(rel.X) <= room.Size.X / 2 + 2 and math.abs(rel.Z) <= room.Size.Z / 2 + 2 and math.abs(rel.Y) < 20
end

function Home.spawnCFrame(player)
	local data = S.Data.get(player)
	if data and data.HomeProperty ~= "" and data.Properties[data.HomeProperty] then
		local cf = S.Property.enterCFrame(player, data.HomeProperty)
		if cf then
			return cf
		end
	end
	local room = assigned[player]
	if room then
		return CFrame.new(room.Center + Vector3.new(0, 4, room.Size.Z / 2 - 5))
	end
	return nil
end

local function makePart(parent, name, size, cf, color, material)
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end

local function rgb(t)
	return Color3.fromRGB(t[1], t[2], t[3])
end

-- Redibuja los muebles y equipos dinámicos de la habitación según el inventario.
function Home.refreshRoom(player)
	local room = assigned[player]
	local data = S.Data.get(player)
	if not room or not data then
		return
	end
	local folder = room.Dynamic
	folder:ClearAllChildren()
	local deskCF = room.DeskCFrame -- parte superior del escritorio, mirando a la pared

	local desk = S.Inventory.bestCatAtHome(player, "furniture", "Escritorio", "Comfort")
	local deskColor = desk and rgb(desk.Color) or Color3.fromRGB(150, 115, 80)
	local deskWidth = desk and (desk.Id == "desk_large" and 12 or (desk.Id == "desk_lux" and 11 or 9)) or 8
	makePart(folder, "DeskTop", Vector3.new(deskWidth, 0.6, 4), deskCF, deskColor, desk and desk.Id == "desk_lux" and Enum.Material.Wood or Enum.Material.WoodPlanks)
	for _, sx in ipairs({ -1, 1 }) do
		makePart(folder, "DeskLeg", Vector3.new(0.5, 3, 3.6), deskCF * CFrame.new(sx * (deskWidth / 2 - 0.4), -1.8, 0), deskColor)
	end

	-- Monitores
	local mon = S.Inventory.bestCatAtHome(player, "monitor", nil, "ColorAcc")
	local screens = mon and math.floor(mon.Stats.Screens + 0.5) or 1
	if screens < 1 then
		screens = 1
	end
	local wide = mon and mon.Id == "mon_uw34"
	for i = 1, screens do
		local x = (i - (screens + 1) / 2) * 3.4
		local w = wide and 5 or 3.2
		local screen = makePart(folder, "Monitor", Vector3.new(w, 2, 0.25), deskCF * CFrame.new(x, 1.6, 1.2), Color3.fromRGB(20, 20, 24))
		local glow = makePart(folder, "Screen", Vector3.new(w - 0.2, 1.8, 0.05), screen.CFrame * CFrame.new(0, 0, -0.15), Color3.fromRGB(70, 140, 255), Enum.Material.Neon)
		glow.CanCollide = false
	end

	-- Torre del PC activo
	local rig = data.Rigs[data.ActiveRig]
	if rig then
		local caseRec = data.Inventory[rig.Parts.case or ""]
		local caseDef = caseRec and Catalog.get(caseRec.Id)
		local tower = makePart(folder, "PCTower", Vector3.new(1.6, 3.2, 3), deskCF * CFrame.new(deskWidth / 2 + 1.4, -1.3, 0),
			caseDef and rgb(caseDef.Color) or Color3.fromRGB(50, 50, 55))
		if caseDef and caseDef.Id == "case_glass" then
			tower.Material = Enum.Material.Glass
			tower.Transparency = 0.3
			local light = Instance.new("PointLight")
			light.Color = Color3.fromRGB(200, 80, 255)
			light.Range = 8
			light.Brightness = 1.5
			light.Parent = tower
		end
	end

	-- Silla
	local chair = S.Inventory.bestCatAtHome(player, "furniture", "Silla", "Comfort")
	local chairColor = chair and rgb(chair.Color) or Color3.fromRGB(110, 110, 110)
	local seat = makePart(folder, "ChairSeat", Vector3.new(2.6, 0.5, 2.6), deskCF * CFrame.new(0, -1.4, -3.2), chairColor)
	makePart(folder, "ChairBack", Vector3.new(2.6, chair and chair.Id ~= "chair_basic" and 3.4 or 2.2, 0.4), seat.CFrame * CFrame.new(0, 1.7, -1.2), chairColor)

	-- Luces y fondos de casa
	local light = S.Inventory.best(player, "homelight", "home", "Light")
	if light then
		local ring = makePart(folder, "RingLight", Vector3.new(0.3, 2.4, 2.4), CFrame.new(room.Center) * CFrame.new(-room.Size.X / 2 + 4, 1, 0), Color3.fromRGB(255, 255, 240), Enum.Material.Neon)
		local l = Instance.new("SpotLight")
		l.Face = Enum.NormalId.Right
		l.Brightness = 2
		l.Range = 16
		l.Parent = ring
	end
	local _, backRec, backDef = S.Inventory.best(player, "homeextra", "home", "Decor")
	if backDef then
		local color = backDef.Id == "backdrop_neon" and Color3.fromRGB(255, 60, 200) or Color3.fromRGB(40, 200, 80)
		local wall = makePart(folder, "Backdrop", Vector3.new(0.2, 7, 9), CFrame.new(room.Center) * CFrame.new(room.Size.X / 2 - 1, 1.5, -2), color,
			backDef.Id == "backdrop_neon" and Enum.Material.Neon or Enum.Material.Fabric)
		wall.CanCollide = false
	end
end

local function assignRoom(player)
	for _, room in ipairs(S.World.HomeRooms or {}) do
		if room.Owner == nil then
			room.Owner = player
			assigned[player] = room
			room.Sign.Text = "Hab. " .. room.Index .. " · " .. player.DisplayName
			room.DeskPrompt:SetAttribute("Owner", player.UserId)
			room.Wardrobe:SetAttribute("Owner", player.UserId)
			return room
		end
	end
	return nil
end

local function freeRoom(player)
	local room = assigned[player]
	if room then
		room.Owner = nil
		room.Sign.Text = "Hab. " .. room.Index .. " · Libre"
		room.DeskPrompt:SetAttribute("Owner", 0)
		room.Wardrobe:SetAttribute("Owner", 0)
		room.Dynamic:ClearAllChildren()
		assigned[player] = nil
	end
	atHome[player] = nil
end

function Home.onPlayerReady(player)
	local room = assignRoom(player)
	if not room then
		S.Net.notify(player, "La residencia está llena en este servidor: usa el cibercafé de la Zona universitaria o tu portátil.", "warn")
		return
	end
	player:SetAttribute("HomePos", room.Center + Vector3.new(0, 2, room.Size.Z / 2 + 3))
	Home.refreshRoom(player)
end

-- Alquiler: se cobra cada 7 días de juego JUGADOS (no se cobra mientras estás desconectado)
function Home.onNewDay(player)
	local data = S.Data.get(player)
	if not data then
		return
	end
	local h = data.Home
	h.PlayDays = h.PlayDays + 1
	pcall(S.Property.onNewDay, player)
	pcall(S.Sponsor.onNewDay, player)
	if S.Company then
		pcall(S.Company.onNewDay, player)
	end
	if data.HomeProperty ~= "" then
		-- vive en otra propiedad: no se cobra la habitación de la residencia
		h.NextDue = h.PlayDays + Config.RentPeriodDays
		return
	end
	if h.PlayDays < h.NextDue then
		return
	end
	h.NextDue = h.PlayDays + Config.RentPeriodDays
	local due = h.Rent
	if S.Economy.spend(player, due, "Alquiler", "Alquiler semanal (" .. "Residencia Económica" .. ")") then
		h.Paid = h.Paid + due
		h.Missed = 0
		data.Counters.rent_paid = (data.Counters.rent_paid or 0) + 1
		S.Net.notify(player, "🏠 Alquiler pagado: $" .. due .. ".", "info")
	else
		local fee = math.floor(due * Config.LateFeeRate + 0.5)
		h.Debt = h.Debt + due + fee
		h.Missed = h.Missed + 1
		data.Reputation = math.max(0, data.Reputation - 1)
		S.Net.notify(player, "⚠️ No pudiste pagar el alquiler. Deuda: $" .. h.Debt .. " (incluye recargo). Págala en la app Banco." ..
			(h.Missed >= 2 and " Los pedidos online quedan bloqueados hasta pagar." or ""), "warn")
	end
	S.Data.markDirty(player)
end

function Home.Start()
	local Net = S.Net

	Net.on("Home.PayDebt", function(player)
		local data = S.Data.get(player)
		local h = data.Home
		if h.Debt <= 0 then
			return false, "No tienes deudas de alquiler."
		end
		if not S.Economy.spend(player, h.Debt, "Alquiler", "Pago de alquiler atrasado") then
			return false, "Necesitas $" .. Util.formatInt(h.Debt) .. "."
		end
		h.Paid = h.Paid + h.Debt
		h.Debt = 0
		h.Missed = 0
		return true, "Deuda de alquiler saldada. ¡Gracias!"
	end)

	Net.on("Home.Teleport", function(player)
		local data = S.Data.get(player)
		if data.HomeProperty ~= "" and data.Properties[data.HomeProperty] then
			local ok, msg = S.Travel.taxiTo(player, S.Property.exteriorOf(data.HomeProperty), "tu casa")
			if ok then
				local cf = S.Property.enterCFrame(player, data.HomeProperty)
				S.Travel.teleport(player, cf.Position)
			end
			return ok, msg
		end
		local cf = Home.spawnCFrame(player)
		if not cf or not player.Character then
			return false, "No tienes habitación asignada."
		end
		local data = S.Data.get(player)
		-- Volver a casa en taxi tiene coste normal
		return S.Travel.taxiTo(player, cf.Position, "tu casa")
	end)

	Players.PlayerRemoving:Connect(freeRoom)

	-- Detección de entrada en casa + recarga de baterías
	task.spawn(function()
		while true do
			task.wait(1)
			for _, player in ipairs(Players:GetPlayers()) do
				if S.Data.get(player) then
					local inside = Home.isAtHome(player)
					if inside and not atHome[player] then
						S.Quest.tutorialEvent(player, "enter_home")
						if S.Inventory.chargeAll(player) then
							S.Net.notify(player, "🔋 Baterías recargadas en casa.", "info")
						end
					end
					atHome[player] = inside
				end
			end
		end
	end)
end

return Home
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000038"><Properties><string name="Name">InventoryService</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- InventoryService: cada objeto comprado es una unidad con su propio identificador (uid),
-- condición, carga de batería y ubicación: "home" (en casa), "backpack" (mochila) o "rig:<id>" (instalado en un PC).

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Catalog = require(Shared.ItemCatalog)
local Util = require(Shared.Util)

local Inventory = {}
local S

Inventory.MaxItems = 300

function Inventory.Init(services)
	S = services
end

function Inventory.add(player, itemId, opts)
	local data = S.Data.get(player)
	local def = Catalog.get(itemId)
	if not data or not def then
		return nil, "Objeto desconocido."
	end
	if Util.count(data.Inventory) >= Inventory.MaxItems then
		return nil, "Tu inventario está lleno (" .. Inventory.MaxItems .. " objetos). Vende algo primero."
	end
	opts = opts or {}
	local uid = S.Data.nextUid(player, "i")
	local loc = opts.loc or "home"
	if loc == "backpack" and not (def.Portable and Inventory.canFit(player, def)) then
		loc = "home"
	end
	data.Inventory[uid] = {
		Id = itemId,
		Cond = opts.cond or 100,
		Loc = loc,
		Got = os.time(),
		GotDay = S.Time.day(),
		Src = opts.src or "shop",
		Paid = opts.paid or def.Price,
		Charge = 100,
	}
	if def.Cat == "camera" then
		data.Visited.Cameras[itemId] = true
	end
	S.Data.markDirty(player)
	return uid, loc
end

function Inventory.remove(player, uid)
	local data = S.Data.get(player)
	if data and data.Inventory[uid] then
		data.Inventory[uid] = nil
		if data.Equipped.Phone == uid then
			data.Equipped.Phone = ""
		end
		S.Data.markDirty(player)
		return true
	end
	return false
end

function Inventory.get(player, uid)
	local data = S.Data.get(player)
	local rec = data and data.Inventory[uid]
	if not rec then
		return nil
	end
	return rec, Catalog.get(rec.Id)
end

function Inventory.owns(player, itemId)
	local data = S.Data.get(player)
	for _, rec in pairs(data.Inventory) do
		if rec.Id == itemId then
			return true
		end
	end
	return false
end

function Inventory.backpackCap(player)
	local data = S.Data.get(player)
	local cap = Config.BaseBackpackSlots + S.Monetization.perk(player, "BackpackSlots")
	for _, rec in pairs(data.Inventory) do
		if rec.Loc == "backpack" then
			local def = Catalog.get(rec.Id)
			if def and def.Slot == "bag" then
				cap = cap + def.Stats.Slots
			end
		end
	end
	-- Maletero: con tu vehículo cerca puedes transportar más equipo
	cap = cap + (S.Vehicle and S.Vehicle.trunkBonus(player) or 0)
	return cap
end

function Inventory.backpackUsed(player)
	local data = S.Data.get(player)
	local used = 0
	for _, rec in pairs(data.Inventory) do
		if rec.Loc == "backpack" then
			local def = Catalog.get(rec.Id)
			used = used + (def and def.Size or 1)
		end
	end
	return used
end

function Inventory.canFit(player, def)
	return Inventory.backpackUsed(player) + def.Size <= Inventory.backpackCap(player)
end

-- Mejor objeto de un tipo (Slot) en una ubicación según una estadística.
function Inventory.best(player, slot, where, stat)
	local data = S.Data.get(player)
	local bestUid, bestRec, bestDef, bestVal = nil, nil, nil, -1
	for uid, rec in pairs(data.Inventory) do
		local def = Catalog.get(rec.Id)
		local here = where == "any" or rec.Loc == where or (where == "home" and rec.Loc:sub(1, 5) == "prop:")
		if def and def.Slot == slot and here then
			local v = stat and (def.Stats[stat] or 0) or def.Quality
			if type(v) ~= "number" then
				v = def.Quality
			end
			v = v * (0.85 + 0.15 * rec.Cond / 100)
			if v > bestVal then
				bestUid, bestRec, bestDef, bestVal = uid, rec, def, v
			end
		end
	end
	return bestUid, bestRec, bestDef
end

-- Mejor objeto de una categoría en casa (monitores, sillas...)
function Inventory.bestCatAtHome(player, cat, sub, stat)
	local data = S.Data.get(player)
	local best, bestVal = nil, -1
	for _, rec in pairs(data.Inventory) do
		local def = Catalog.get(rec.Id)
		if def and def.Cat == cat and (sub == nil or def.Sub == sub) and (rec.Loc == "home" or rec.Loc:sub(1, 5) == "prop:") then
			local v = def.Stats[stat] or 0
			if v > bestVal then
				best, bestVal = def, v
			end
		end
	end
	return best
end

function Inventory.phone(player)
	local data = S.Data.get(player)
	local uid = data.Equipped.Phone
	local rec = data.Inventory[uid]
	if not rec then
		-- elegir el mejor teléfono disponible
		local u, r = Inventory.best(player, "phone", "any", "Photo")
		if u then
			data.Equipped.Phone = u
			return r, Catalog.get(r.Id), u
		end
		return nil
	end
	return rec, Catalog.get(rec.Id), uid
end

function Inventory.condFactor(rec)
	return 0.85 + 0.15 * (rec.Cond or 100) / 100
end

-- Recarga baterías (al estar en casa)
function Inventory.chargeAll(player)
	local data = S.Data.get(player)
	local changed = false
	for _, rec in pairs(data.Inventory) do
		if rec.Charge ~= nil and rec.Charge < 100 then
			rec.Charge = 100
			changed = true
		end
	end
	if changed then
		S.Data.markDirty(player)
	end
	return changed
end

function Inventory.sellValue(rec, def)
	return math.floor((rec.Paid or def.Price) * Config.SellBackRate * (rec.Cond / 100) + 0.5)
end

function Inventory.canReturn(rec)
	return (rec.Src == "shop" or rec.Src == "online") and rec.Cond >= 90
		and (S.Time.day() - (rec.GotDay or 0)) <= Config.ReturnWindowDays
end

function Inventory.Start()
	local Net = S.Net

	Net.on("Inv.Move", function(player, p)
		local data = S.Data.get(player)
		local rec = data.Inventory[p.uid]
		if not rec then
			return false, "No tienes ese objeto."
		end
		local def = Catalog.get(rec.Id)
		local to = p.to
		if to ~= "home" and to ~= "backpack" then
			return false, "Destino no válido."
		end
		if rec.Loc:sub(1, 4) == "rig:" then
			return false, "Está instalado en un computador. Desmóntalo en el Montador de PC."
		end
		if rec.Loc:sub(1, 5) == "prop:" then
			return false, "Está colocado en una propiedad. Recógelo con el modo construcción."
		end
		if rec.Loc == to then
			return true
		end
		if not S.Home.isAtHome(player) then
			return false, "Solo puedes preparar la mochila en casa."
		end
		if to == "backpack" then
			if not def.Portable then
				return false, def.Name .. " no es portátil."
			end
			if not Inventory.canFit(player, def) then
				return false, "La mochila está llena (" .. Inventory.backpackUsed(player) .. "/" .. Inventory.backpackCap(player) .. ")."
			end
		else
			-- Sacar una bolsa no puede dejar la mochila por encima de su capacidad
			if def.Slot == "bag" then
				local after = Inventory.backpackCap(player) - def.Stats.Slots
				if Inventory.backpackUsed(player) - def.Size > after then
					return false, "Primero saca otros objetos: no cabrían sin esta bolsa."
				end
			end
		end
		rec.Loc = to
		if to == "backpack" then
			S.Quest.tutorialEvent(player, "pack")
		end
		return true, (to == "backpack") and (def.Name .. " → mochila") or (def.Name .. " → casa")
	end)

	Net.on("Inv.EquipPhone", function(player, p)
		local data = S.Data.get(player)
		local rec = data.Inventory[p.uid]
		if not rec or Catalog.get(rec.Id).Slot ~= "phone" then
			return false, "Eso no es un teléfono."
		end
		data.Equipped.Phone = p.uid
		return true, "Ahora usas " .. Catalog.get(rec.Id).Name .. "."
	end)

	local function checkSellable(player, rec, def, uid)
		local data = S.Data.get(player)
		if not rec then
			return "No tienes ese objeto."
		end
		if rec.Loc:sub(1, 4) == "rig:" then
			return "Está instalado en un computador. Desmóntalo primero."
		end
		if rec.Loc:sub(1, 5) == "prop:" then
			return "Está colocado en una propiedad. Recógelo primero con el modo construcción."
		end
		if rec.Loan then
			return "Es equipo prestado por un patrocinador: se devuelve al terminar el contrato."
		end
		if def.Slot == "phone" then
			local phones = 0
			for _, r in pairs(data.Inventory) do
				if Catalog.get(r.Id).Slot == "phone" then
					phones = phones + 1
				end
			end
			if phones <= 1 then
				return "No puedes quedarte sin teléfono."
			end
		end
		if def.Slot == "bag" and rec.Loc == "backpack" then
			return "Saca la bolsa de la mochila antes de venderla."
		end
		return nil
	end

	Net.on("Inv.Sell", function(player, p)
		local data = S.Data.get(player)
		local rec = data.Inventory[p.uid]
		local def = rec and Catalog.get(rec.Id)
		local err = checkSellable(player, rec, def, p.uid)
		if err then
			return false, err
		end
		local value = Inventory.sellValue(rec, def)
		Inventory.remove(player, p.uid)
		S.Economy.add(player, value, "Ventas", "Venta de " .. def.Name, { silent = false })
		return true, "Vendiste " .. def.Name .. " por $" .. Util.formatInt(value) .. "."
	end)

	Net.on("Inv.Return", function(player, p)
		local data = S.Data.get(player)
		local rec = data.Inventory[p.uid]
		local def = rec and Catalog.get(rec.Id)
		local err = checkSellable(player, rec, def, p.uid)
		if err then
			return false, err
		end
		if not Inventory.canReturn(rec) then
			return false, "Ya no se puede devolver (máximo " .. Config.ReturnWindowDays .. " días y en buen estado)."
		end
		local value = math.floor(rec.Paid * Config.ReturnRefundRate + 0.5)
		Inventory.remove(player, p.uid)
		S.Economy.add(player, value, "Devoluciones", "Devolución de " .. def.Name, {})
		return true, "Devolución aceptada: +$" .. Util.formatInt(value) .. "."
	end)

	Net.on("Inv.Clean", function(player, p)
		local data = S.Data.get(player)
		local rec = data.Inventory[p.uid]
		if not rec then
			return false, "No tienes ese objeto."
		end
		if not S.Home.isAtHome(player) then
			return false, "Limpia tu equipo en casa."
		end
		if rec.Cond >= 90 then
			return false, "Ya está limpio y en buen estado."
		end
		if rec.CleanDay == S.Time.day() then
			return false, "Ya lo limpiaste hoy."
		end
		rec.CleanDay = S.Time.day()
		rec.Cond = math.min(90, rec.Cond + 10)
		return true, "Equipo limpiado: condición " .. math.floor(rec.Cond) .. "%."
	end)

	Net.on("Inv.Repair", function(player, p)
		local data = S.Data.get(player)
		local rec = data.Inventory[p.uid]
		if not rec then
			return false, "No tienes ese objeto."
		end
		local def = Catalog.get(rec.Id)
		if rec.Cond >= 100 then
			return false, "No necesita reparación."
		end
		-- Técnico de tu empresa: reparaciones a mitad de precio
		local mult = S.Company and S.Company.repairMult(player) or 1
		local cost = math.max(5, math.floor(def.Price * 0.15 * (100 - rec.Cond) / 50 * mult + 0.5))
		if not S.Economy.spend(player, cost, "Reparaciones", "Reparación de " .. def.Name) then
			return false, "La reparación cuesta $" .. cost .. "."
		end
		rec.Cond = 100
		return true, def.Name .. " reparado por $" .. cost .. "."
	end)
end

return Inventory
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000039"><Properties><string name="Name">JobsService</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- JobsService: encargos de trabajo para ganar dinero además del canal (adelanto de la Fase 5).
--  * Editor de vídeos freelance: ordenar los clips de un cliente en un computador.
--  * Fotógrafo: hacer una foto de un tipo concreto en un lugar concreto.
--  * Repartidor: llevar un paquete desde una tienda hasta un lugar de la ciudad.
-- Cada tipo tiene requisitos, recompensa, experiencia y ascensos (cada 10 encargos +5% de paga, máx. +50%).

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local Shared = ReplicatedStorage.Shared
local WorldData = require(Shared.WorldData)
local VideoData = require(Shared.VideoData)
local Util = require(Shared.Util)

local Jobs = {}
local S
local cooldown = {}

Jobs.Types = {
	edit = { Name = "Editor de vídeos freelance", Req = "Usar un computador", Base = 45, Cooldown = 40 },
	photo = { Name = "Fotógrafo por encargo", Req = "Cámara o teléfono", Base = 60, Cooldown = 30 },
	delivery = { Name = "Repartidor", Req = "Empezar en una tienda", Base = 30, Cooldown = 20 },
	cashier = { Name = "Cajero / dependiente", Req = "Empezar en una tienda", Base = 40, Cooldown = 30 },
	camera = { Name = "Camarógrafo", Req = "Grabar 2 escenas de calidad en un lugar", Base = 70, Cooldown = 40 },
	thumbs = { Name = "Diseñador de miniaturas", Req = "Computador o tableta", Base = 55, Cooldown = 40 },
	tech = { Name = "Técnico informático", Req = "Saber de compatibilidad de piezas", Base = 50, Cooldown = 30 },
	reporter = { Name = "Periodista de eventos", Req = "Foto y escena en el evento del día", Base = 90, Cooldown = 60 },
}
Jobs.Keywords = { "OFERTA", "NUEVO", "TOP 5", "REVIEW", "VIAJE", "RETO", "GRATIS", "VS" }
Jobs.ClipLabels = { "Gancho", "Presentación", "Desarrollo", "Momento clave", "Conclusión", "Despedida" }

function Jobs.Init(services)
	S = services
end

local function promotion(data, jobType)
	local n = data.Counters["job_" .. jobType] or 0
	return math.min(0.5, math.floor(n / 10) * 0.05), n
end

local function pay(player, jobType, base, detail)
	local data = S.Data.get(player)
	local promo, n = promotion(data, jobType)
	local bonus = S.Monetization.perk(player, "JobBonus")
	local amount = math.floor(base * (1 + promo + bonus) + 0.5)
	data.Counters["job_" .. jobType] = n + 1
	data.Counters.jobs_done = (data.Counters.jobs_done or 0) + 1
	if S.Needs then
		S.Needs.spend(player, 3)
	end
	data.Job = {}
	cooldown[player] = cooldown[player] or {}
	cooldown[player][jobType] = os.clock()
	S.Economy.add(player, amount, "Empleos", Jobs.Types[jobType].Name .. (detail and (": " .. detail) or ""), { taxable = true })
	S.Progress.addXp(player, S.Progress.Xp.Job)
	S.Quest.check(player)
	if (n + 1) % 10 == 0 and promo < 0.5 then
		S.Net.notify(player, "📈 ¡Ascenso como " .. Jobs.Types[jobType].Name .. "! Cobrarás un 5% más.", "success")
	end
	return amount
end

function Jobs.onScene(player, scene)
	local data = S.Data.get(player)
	local job = data.Job
	if job.Type == "camera" and scene.Spot == job.Spot and scene.Q >= job.MinQ then
		job.Count = (job.Count or 0) + 1
		if job.Count >= 2 then
			local amount = pay(player, "camera", Jobs.Types.camera.Base + scene.Q * 0.8, job.SpotName)
			S.Net.notify(player, "✅ Grabación para el cliente completada: +$" .. amount, "success")
		else
			S.Net.notify(player, "🎥 Toma válida para el cliente (" .. job.Count .. "/2).", "info")
		end
	elseif job.Type == "reporter" and scene.Spot == job.Spot then
		job.Scene = true
		Jobs.checkReporter(player)
	end
end

function Jobs.checkReporter(player)
	local data = S.Data.get(player)
	local job = data.Job
	if job.Type == "reporter" and job.Scene and job.Photo then
		local amount = pay(player, "reporter", Jobs.Types.reporter.Base, job.SpotName)
		S.Net.notify(player, "📰 Reportaje entregado: +$" .. amount, "success")
	end
end

function Jobs.onThumb(player, design, score)
	local data = S.Data.get(player)
	local job = data.Job
	if job.Type == "thumbs" then
		if not (design.text or ""):upper():find(job.Keyword, 1, true) then
			S.Net.notify(player, "El cliente quería la palabra «" .. job.Keyword .. "» en la miniatura.", "warn")
		elseif score < job.MinScore then
			S.Net.notify(player, "El cliente pide al menos " .. job.MinScore .. " puntos (tu diseño: " .. math.floor(score) .. ").", "warn")
		else
			local amount = pay(player, "thumbs", Jobs.Types.thumbs.Base + score * 0.6, "«" .. job.Keyword .. "»")
			S.Net.notify(player, "✅ Miniatura aceptada por el cliente: +$" .. amount, "success")
		end
	end
end

function Jobs.onPhoto(player, photo)
	local data = S.Data.get(player)
	local job = data.Job
	if job.Type == "reporter" and photo.Spot == job.Spot and photo.Q >= 45 then
		job.Photo = true
		Jobs.checkReporter(player)
		return
	end
	if job.Type == "photo" and photo.Spot == job.Spot and photo.Mode == job.Mode then
		local amount = pay(player, "photo", Jobs.Types.photo.Base + photo.Q * 0.8, job.SpotName)
		S.Net.notify(player, "✅ Encargo de fotografía completado: +$" .. amount, "success")
	end
end

function Jobs.Start()
	local Net = S.Net

	Net.on("Job.Start", function(player, p)
		local data = S.Data.get(player)
		local def = Jobs.Types[p.type or ""]
		if not def then
			return false, "Empleo no válido."
		end
		if data.Job.Type then
			return false, "Ya tienes un encargo en curso. Termínalo o cancélalo."
		end
		local last = cooldown[player] and cooldown[player][p.type]
		if last and os.clock() - last < def.Cooldown then
			return false, "Vuelve en " .. math.ceil(def.Cooldown - (os.clock() - last)) .. " s para otro encargo de este tipo."
		end
		local rng = Random.new()
		if p.type == "edit" then
			if not S.Computer.hasSession(player) then
				return false, "Necesitas estar usando un computador."
			end
			local stats = S.Computer.sessionStats(player)
			local n = math.min(#Jobs.ClipLabels, 3 + stats.Tier)
			local order = {}
			for i = 1, n do
				order[i] = Jobs.ClipLabels[i]
			end
			local shuffled = {}
			for i = 1, n do
				shuffled[i] = order[i]
			end
			for i = n, 2, -1 do
				local j = rng:NextInteger(1, i)
				shuffled[i], shuffled[j] = shuffled[j], shuffled[i]
			end
			data.Job = { Type = "edit", Answer = order, Clips = shuffled, Tier = stats.Tier, Started = os.time() }
			return true, "Encargo de edición: ordena los clips del cliente.", { clips = shuffled }
		elseif p.type == "photo" then
			local candidates = {}
			for _, s in ipairs(WorldData.Spots) do
				if not s.Secret and not s.Dest then
					candidates[#candidates + 1] = s
				end
			end
			local spot = candidates[rng:NextInteger(1, #candidates)]
			local modes = {}
			for _, m in ipairs(VideoData.PhotoModes) do
				if not m.NeedsProduct and m.Id ~= "pet" and m.Id ~= "night" then
					for _, t in ipairs(m.Tags) do
						if Util.indexOf(spot.Tags, t) then
							modes[#modes + 1] = m
							break
						end
					end
				end
			end
			if #modes == 0 then
				modes = { VideoData.PhotoModeById.closeup }
			end
			local mode = modes[rng:NextInteger(1, #modes)]
			data.Job = { Type = "photo", Spot = spot.Id, SpotName = spot.Name, Mode = mode.Id, ModeName = mode.Name, Started = os.time() }
			return true, "Encargo: foto «" .. mode.Name .. "» en " .. spot.Name .. ".", { spot = spot.Id }
		elseif p.type == "delivery" then
			if not S.Shop.storeNear(player) then
				return false, "Los repartos empiezan en una tienda (MegaTec, FotoPro, Conecta o Creator Hub)."
			end
			local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
			local candidates = {}
			for _, s in ipairs(WorldData.Spots) do
				if not s.Secret and not s.Dest and root then
					local d = math.sqrt((s.X - root.Position.X) ^ 2 + (s.Z - root.Position.Z) ^ 2)
					if d > 200 and d < 900 then
						candidates[#candidates + 1] = { s = s, d = d }
					end
				end
			end
			if #candidates == 0 then
				return false, "No hay repartos disponibles ahora."
			end
			local c = candidates[rng:NextInteger(1, #candidates)]
			data.Job = { Type = "delivery", Spot = c.s.Id, SpotName = c.s.Name, Dist = math.floor(c.d), Started = os.time() }
			return true, "Reparto: lleva el paquete a " .. c.s.Name .. " (" .. math.floor(c.d) .. " studs).", { spot = c.s.Id }
		elseif p.type == "cashier" then
			if not S.Shop.storeNear(player) then
				return false, "Este turno empieza dentro de una tienda."
			end
			local rounds, answers = {}, {}
			for i = 1, 3 do
				local price = rng:NextInteger(3, 95)
				local paid = price <= 10 and 10 or (price <= 20 and 20 or (price <= 50 and 50 or 100))
				rounds[i] = { Price = price, Paid = paid }
				answers[i] = paid - price
			end
			data.Job = { Type = "cashier", Rounds = rounds, Answer = answers, Started = os.time() }
			return true, "Turno de caja: calcula el cambio de 3 clientes.", { rounds = rounds }
		elseif p.type == "camera" then
			local candidates = {}
			for _, s in ipairs(WorldData.Spots) do
				if not s.Secret and not s.Dest then
					candidates[#candidates + 1] = s
				end
			end
			local spot = candidates[rng:NextInteger(1, #candidates)]
			local minQ = math.min(70, 30 + data.Level * 2)
			data.Job = { Type = "camera", Spot = spot.Id, SpotName = spot.Name, MinQ = minQ, Count = 0, Started = os.time() }
			return true, "Encargo de grabación: 2 escenas de calidad " .. minQ .. "+ en " .. spot.Name .. " (en cualquier proyecto).", { spot = spot.Id }
		elseif p.type == "thumbs" then
			local kw = Jobs.Keywords[rng:NextInteger(1, #Jobs.Keywords)]
			local minScore = math.min(75, 45 + data.Level)
			data.Job = { Type = "thumbs", Keyword = kw, MinScore = minScore, Started = os.time() }
			return true, "Encargo: miniatura con la palabra «" .. kw .. "» y puntuación " .. minScore .. "+ (app Miniaturas).", {}
		elseif p.type == "tech" then
			local cpus, mobos = {}, {}
			for _, def in pairs(require(Shared.ItemCatalog).Items) do
				if def.Sub == "cpu" then
					cpus[#cpus + 1] = def
				elseif def.Sub == "mobo" then
					mobos[#mobos + 1] = def
				end
			end
			table.sort(cpus, function(a, b)
				return a.Id < b.Id
			end)
			table.sort(mobos, function(a, b)
				return a.Id < b.Id
			end)
			local questions, answers = {}, {}
			for i = 1, 3 do
				local cpu = cpus[rng:NextInteger(1, #cpus)]
				local good, bad = {}, {}
				for _, m in ipairs(mobos) do
					if m.Compat.Socket == cpu.Compat.Socket then
						good[#good + 1] = m
					else
						bad[#bad + 1] = m
					end
				end
				local correct = good[rng:NextInteger(1, #good)]
				local opts = { correct.Id }
				while #opts < 3 and #bad > 0 do
					local b = table.remove(bad, rng:NextInteger(1, #bad))
					opts[#opts + 1] = b.Id
				end
				for j = #opts, 2, -1 do
					local k = rng:NextInteger(1, j)
					opts[j], opts[k] = opts[k], opts[j]
				end
				questions[i] = { Cpu = cpu.Id, Options = opts }
				answers[i] = correct.Id
			end
			data.Job = { Type = "tech", Questions = questions, Answer = answers, Started = os.time() }
			return true, "Cliente con averías: elige la placa base compatible con cada procesador.", { questions = questions }
		elseif p.type == "reporter" then
			local ev = S.Events.current()
			local spot = WorldData.SpotById[ev.Spot]
			data.Job = { Type = "reporter", Spot = ev.Spot, SpotName = spot.Name .. " (" .. ev.Name .. ")", Started = os.time() }
			return true, "Reportaje: haz una foto (calidad 45+) y graba una escena en " .. spot.Name .. ".", { spot = ev.Spot }
		end
		return false, "Empleo no válido."
	end)

	Net.on("Job.Submit", function(player, p)
		local data = S.Data.get(player)
		local job = data.Job
		if job.Type == "edit" then
			if not S.Computer.hasSession(player) then
				return false, "Necesitas estar usando un computador."
			end
			if type(p.order) ~= "table" or #p.order ~= #job.Answer then
				return false, "Orden incompleto."
			end
			local correct = 0
			for i, label in ipairs(job.Answer) do
				if p.order[i] == label then
					correct = correct + 1
				end
			end
			local ratio = correct / #job.Answer
			if ratio < 0.5 then
				data.Job = {}
				cooldown[player] = cooldown[player] or {}
				cooldown[player].edit = os.clock()
				return false, "El cliente rechazó la edición (" .. correct .. "/" .. #job.Answer .. " clips bien). Inténtalo en otro encargo."
			end
			local amount = pay(player, "edit", (Jobs.Types.edit.Base + job.Tier * 15) * ratio, correct .. "/" .. #job.Answer .. " clips")
			return true, "✅ Edición entregada: +$" .. amount .. " (" .. correct .. "/" .. #job.Answer .. ")."
		elseif job.Type == "delivery" then
			local spot = WorldData.SpotById[job.Spot]
			local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
			if not spot or not root then
				return false, "No puedes entregar ahora."
			end
			local d = math.sqrt((spot.X - root.Position.X) ^ 2 + (spot.Z - root.Position.Z) ^ 2)
			if d > 30 then
				return false, "Aún no estás en " .. spot.Name .. " (a " .. math.floor(d) .. " studs)."
			end
			local amount = pay(player, "delivery", Jobs.Types.delivery.Base + job.Dist * 0.05, job.SpotName)
			return true, "✅ Paquete entregado: +$" .. amount .. "."
		elseif job.Type == "cashier" or job.Type == "tech" then
			if type(p.answers) ~= "table" or #p.answers ~= #job.Answer then
				return false, "Responde a todo."
			end
			local correct = 0
			for i, a in ipairs(job.Answer) do
				if tostring(p.answers[i]) == tostring(a) then
					correct = correct + 1
				end
			end
			if correct == 0 then
				data.Job = {}
				cooldown[player] = cooldown[player] or {}
				cooldown[player][job.Type] = os.clock()
				return false, "Ninguna respuesta correcta. El encargado te pide repasar."
			end
			local amount = pay(player, job.Type, Jobs.Types[job.Type].Base * correct / 3 + (job.Type == "tech" and data.Level * 3 or 0), correct .. "/3")
			return true, "✅ Turno completado: +$" .. amount .. " (" .. correct .. "/3 correctas)."
		elseif job.Type == "photo" then
			return false, "Este encargo se completa al hacer la foto pedida en el lugar indicado."
		end
		return false, "No tienes encargos en curso."
	end)

	Net.on("Job.Cancel", function(player)
		local data = S.Data.get(player)
		if not data.Job.Type then
			return false, "No tienes encargos en curso."
		end
		data.Job = {}
		return true, "Encargo cancelado (sin penalización)."
	end)

	Players.PlayerRemoving:Connect(function(player)
		cooldown[player] = nil
	end)
end

return Jobs
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000040"><Properties><string name="Name">LeisureService</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- LeisureService: ocio en la ciudad.
--  * Gimnasio Pulso Fit (Barrio residencial): entrenar gasta energía, sube el ánimo y la forma física
--    (data.Fitness 0-100), que da +1 a +3 de interés en vídeos de deporte / fitness.
--  * Cines Lumière (Distrito de entretenimiento): ver una película sube el ánimo, bloquea el cine 10 minutos
--    (no puedes ver otra hasta entonces) y te da una idea de vídeo (categoría + título) para crear un proyecto.
--  * Karaoke Micrófono de Oro (Distrito de restaurantes): sube el ánimo; con un micrófono en la mochila tu
--    actuación es una escena especial de música (si estás grabando, se añade a tu proyecto con bonus).
--  * Bolera Strike & Recreativos (Distrito de entretenimiento): minijuego de bolos (puntuación aleatoria +
--    habilidad: leer la pista, forma física y experiencia) con premio pequeño y límite diario de partidas.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local Shared = ReplicatedStorage.Shared
local StudioData = require(Shared.StudioData)
local VideoData = require(Shared.VideoData)
local Util = require(Shared.Util)

local Leisure = {}
local S
local lastGym = {}
local lastKaraoke = {}

local PLACES = {
	gym = { Type = "gym", Name = StudioData.Gym.Name, Where = "Barrio residencial" },
	cinema = { Type = "cinema", Name = StudioData.Cinema.Name, Where = "Distrito de entretenimiento" },
	karaoke = { Type = "karaoke", Name = StudioData.Karaoke.Name, Where = "Distrito de restaurantes" },
	bowling = { Type = "bowling", Name = StudioData.Bowling.Name, Where = "Distrito de entretenimiento" },
}

function Leisure.Init(services)
	S = services
end

local function state(data)
	if type(data.Leisure) ~= "table" then
		data.Leisure = {}
	end
	local l = data.Leisure
	l.CinemaNext = l.CinemaNext or 0
	l.BowlDay = l.BowlDay or 0
	l.BowlGames = l.BowlGames or 0
	l.BowlBest = l.BowlBest or 0
	l.BowlTotal = l.BowlTotal or 0
	if type(l.Idea) ~= "table" then
		l.Idea = { Category = "", Title = "" }
	end
	return l
end

local function near(player, kind)
	return S.World.nearSpecial(player, PLACES[kind].Type, 35) ~= nil
end

local function notHere(kind)
	local p = PLACES[kind]
	return "Ve a " .. p.Name .. " (" .. p.Where .. ")."
end

-- ¿En qué lugar de ocio estás? (para la app)
function Leisure.where(player)
	for kind in pairs(PLACES) do
		if near(player, kind) then
			return kind
		end
	end
	return nil
end

local function counted(player, data)
	data.Counters.leisure = (data.Counters.leisure or 0) + 1
	S.Quest.check(player)
	S.Data.markDirty(player)
end

-- Interés extra en escenas de vídeos de deporte / fitness según la forma física
function Leisure.interestBonus(player, cat)
	local data = S.Data.get(player)
	if not data or not StudioData.isFitnessCategory(cat) then
		return 0
	end
	return StudioData.fitnessInterest(data.Fitness or 0)
end

function Leisure.bowlLeft(data)
	local l = state(data)
	if l.BowlDay ~= S.Time.day() then
		return StudioData.Bowling.DailyLimit
	end
	return math.max(0, StudioData.Bowling.DailyLimit - l.BowlGames)
end

function Leisure.view(player)
	local data = S.Data.get(player)
	if not data then
		return nil
	end
	local l = state(data)
	return {
		At = Leisure.where(player),
		Fitness = data.Fitness or 0,
		CinemaIn = math.max(0, l.CinemaNext - os.time()),
		BowlLeft = Leisure.bowlLeft(data),
		Lane = StudioData.lane(S.Time.day()),
		HasMic = S.Inventory.best(player, "mic", "backpack", "Audio") ~= nil,
		Recording = S.Video.isRecording(player),
	}
end

function Leisure.workout(player)
	local data = S.Data.get(player)
	local cfg = StudioData.Gym
	if not near(player, "gym") then
		return false, notHere("gym")
	end
	if lastGym[player] and os.clock() - lastGym[player] < cfg.Cooldown then
		return false, "Descansa un poco entre series (" .. math.ceil(cfg.Cooldown - (os.clock() - lastGym[player])) .. " s)."
	end
	local n = S.Needs.get(data)
	if n.Energy < cfg.MinEnergy then
		return false, "Estás sin energía para entrenar. Come algo o descansa primero."
	end
	if not S.Economy.spend(player, cfg.Price, "Ocio", "Sesión en " .. cfg.Name) then
		return false, "La sesión cuesta $" .. cfg.Price .. "."
	end
	lastGym[player] = os.clock()
	local gain = StudioData.fitnessGain(data.Fitness)
	data.Fitness = Util.clamp((data.Fitness or 0) + gain, 0, 100)
	S.Needs.change(player, -cfg.Energy, cfg.Mood)
	data.Counters.workouts = (data.Counters.workouts or 0) + 1
	counted(player, data)
	return true, "🏋 ¡Buen entrenamiento! Forma física " .. math.floor(data.Fitness) .. "/100 (+" .. gain .. "), energía -" .. cfg.Energy .. ", ánimo +" .. cfg.Mood .. ".", { fitness = data.Fitness }
end

function Leisure.watch(player, movieId)
	local data = S.Data.get(player)
	local movie = StudioData.MovieById[movieId or ""]
	if not movie then
		return false, "Elige una película de la cartelera."
	end
	if not near(player, "cinema") then
		return false, notHere("cinema")
	end
	local l = state(data)
	local wait = l.CinemaNext - os.time()
	if wait > 0 then
		return false, "Acabas de salir del cine. Vuelve en " .. StudioData.gameMinutes(wait) .. " min."
	end
	if not S.Economy.spend(player, movie.Price, "Ocio", "Entrada de cine: " .. movie.Name) then
		return false, "La entrada cuesta $" .. movie.Price .. "."
	end
	local cfg = StudioData.Cinema
	l.CinemaNext = os.time() + cfg.Hours * StudioData.HourSeconds
	S.Needs.change(player, cfg.Energy, cfg.Mood)
	local cat = VideoData.CategoryById[movie.Idea[1]]
	l.Idea = { Category = cat and cat.Id or "vlog", Title = movie.Idea[2] }
	-- Si existe un sistema de ideas, la idea también se guarda allí
	if type(data.Ideas) == "table" then
		table.insert(data.Ideas, { Category = l.Idea.Category, Title = l.Idea.Title, Src = "cine", T = os.time() })
	end
	data.Counters.movies = (data.Counters.movies or 0) + 1
	counted(player, data)
	return true, "🎬 Has visto «" .. movie.Name .. "» (" .. cfg.Hours .. " h de juego): ánimo +" .. cfg.Mood .. ". 💡 Idea: «" .. l.Idea.Title .. "» (" .. (cat and cat.Name or "Vlog") .. ").", { idea = l.Idea }
end

function Leisure.sing(player)
	local data = S.Data.get(player)
	local cfg = StudioData.Karaoke
	if not near(player, "karaoke") then
		return false, notHere("karaoke")
	end
	if lastKaraoke[player] and os.clock() - lastKaraoke[player] < cfg.Cooldown then
		return false, "Deja cantar a los demás un momento (" .. math.ceil(cfg.Cooldown - (os.clock() - lastKaraoke[player])) .. " s)."
	end
	if not S.Economy.spend(player, cfg.Price, "Ocio", "Canción en " .. cfg.Name) then
		return false, "Cada canción cuesta $" .. cfg.Price .. "."
	end
	lastKaraoke[player] = os.clock()
	local _, _, mic = S.Inventory.best(player, "mic", "backpack", "Audio")
	local mood = cfg.Mood + (mic and cfg.MicMood or 0)
	S.Needs.change(player, -cfg.Energy, mood)
	local msg = "🎤 ¡Qué actuación! Ánimo +" .. mood .. "."
	local extra = {}
	if mic then
		-- Escena especial de música: con tu micrófono, la actuación se graba como escena del proyecto
		data.Counters.karaoke_mic = (data.Counters.karaoke_mic or 0) + 1
		S.Progress.addXp(player, 8)
		if S.Video.isRecording(player) then
			local ok, smsg, res = S.Video.recordScene(player, { shot = "talking" })
			if ok and res and res.scene then
				local sc = res.scene
				sc.Q = math.min(100, Util.round(sc.Q + cfg.SceneBonus, 1))
				sc.Special = "karaoke"
				sc.SpotName = "🎤 Actuación en " .. cfg.Name
				extra.scene = sc
				msg = msg .. " 🎶 Escena especial de música grabada con tu " .. mic.Name .. " (calidad " .. math.floor(sc.Q) .. ")."
			else
				msg = msg .. " (No se pudo grabar la escena: " .. tostring(smsg) .. ")"
			end
		else
			msg = msg .. " Con tu " .. mic.Name .. " suena de cine: graba un proyecto y será una escena especial de música."
		end
	else
		msg = msg .. " Lleva un micrófono en la mochila para convertirlo en una escena especial de música."
	end
	counted(player, data)
	return true, msg, extra
end

function Leisure.bowl(player, p)
	local data = S.Data.get(player)
	local cfg = StudioData.Bowling
	if not near(player, "bowling") then
		return false, notHere("bowling")
	end
	local aim = math.floor(tonumber(p.aim) or 0)
	local power = math.floor(tonumber(p.power) or 0)
	if aim ~= aim or power ~= power or aim < 1 or aim > 5 or power < 1 or power > 5 then
		return false, "Elige efecto y potencia (1-5)."
	end
	local l = state(data)
	local day = S.Time.day()
	if l.BowlDay ~= day then
		l.BowlDay, l.BowlGames = day, 0
	end
	if l.BowlGames >= cfg.DailyLimit then
		return false, "Ya has jugado " .. cfg.DailyLimit .. " partidas hoy. ¡Vuelve mañana!"
	end
	if not S.Economy.spend(player, cfg.Price, "Ocio", "Partida en " .. cfg.Name) then
		return false, "La partida cuesta $" .. cfg.Price .. "."
	end
	l.BowlGames = l.BowlGames + 1
	l.BowlTotal = l.BowlTotal + 1
	local lane = StudioData.lane(day)
	local skill = StudioData.bowlSkill(aim, power, lane, data.Fitness, l.BowlTotal)
	local score, frames, strikes = StudioData.bowlScore(skill)
	local prize = StudioData.bowlPrize(score)
	local best = score > l.BowlBest
	if best then
		l.BowlBest = score
	end
	if prize > 0 then
		S.Economy.add(player, prize, "Ocio", "Premio de la bolera (" .. score .. " puntos)")
	end
	S.Needs.change(player, -2, strikes >= 3 and 8 or 4)
	data.Counters.bowling = (data.Counters.bowling or 0) + 1
	counted(player, data)
	local msg = "🎳 " .. score .. " puntos (" .. strikes .. " plenos)" .. (best and " · ¡récord personal!" or "")
	msg = msg .. (prize > 0 and (" · premio $" .. prize) or " · sin premio esta vez")
	return true, msg, { score = score, frames = frames, prize = prize, left = cfg.DailyLimit - l.BowlGames }
end

function Leisure.Start()
	local Net = S.Net
	Net.on("Leisure.Workout", function(player)
		return Leisure.workout(player)
	end)
	Net.on("Leisure.Movie", function(player, p)
		return Leisure.watch(player, type(p) == "table" and p.movie or nil)
	end)
	Net.on("Leisure.Karaoke", function(player)
		return Leisure.sing(player)
	end)
	Net.on("Leisure.Bowl", function(player, p)
		return Leisure.bowl(player, type(p) == "table" and p or {})
	end)
	Players.PlayerRemoving:Connect(function(player)
		lastGym[player] = nil
		lastKaraoke[player] = nil
	end)
end

return Leisure
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000041"><Properties><string name="Name">LiveService</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- LiveService: directos simulados y publicaciones en redes sociales ficticias.
--  * Directo: desde un computador (casa, propiedad o portátil) con cámara o cámara web.
--    Los espectadores dependen de tus suscriptores, del equipo, de la decoración y de cómo respondas
--    a las preguntas del chat. Hay donaciones, nuevos suscriptores e ingresos al terminar.
--  * Publicación social: una foto del álbum con texto; consigue "me gusta" y algunos seguidores.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Util = require(Shared.Util)

local Live = {}
local S
local sessions = {}

Live.Duration = 75
Live.Cooldown = 180

Live.Topics = {
	{ Id = "gaming", Name = "Partida en directo", Cat = "gaming" },
	{ Id = "qa", Name = "Preguntas y respuestas", Cat = "vlog" },
	{ Id = "tech", Name = "Charla de tecnología", Cat = "tech" },
	{ Id = "cooking", Name = "Cocinando en directo", Cat = "cooking" },
	{ Id = "edit", Name = "Editando en directo", Cat = "tutorial" },
}

-- Preguntas del chat: la respuesta Best es la más adecuada para la comunidad
Live.Questions = {
	{ Q = "¿Qué cámara usas?", A = { "Te cuento mi equipo y por qué lo elegí", "Secreto", "La más cara, obvio" }, Best = 1 },
	{ Q = "¿Cada cuánto subes vídeos?", A = { "Cuando me apetece", "Intento publicar con constancia cada semana", "No sé" }, Best = 2 },
	{ Q = "¡Saludos desde la playa!", A = { "¡Hola! Gracias por pasarte 😊", "…", "Silencio, que me concentro" }, Best = 1 },
	{ Q = "¿Algún consejo para empezar?", A = { "Compra equipo caro", "Empieza con el teléfono y mejora poco a poco", "Copia a otros" }, Best = 2 },
	{ Q = "¿Harás un vídeo en la montaña?", A = { "¡Buena idea! Lo apunto", "Nunca", "Pregunta otra cosa" }, Best = 1 },
	{ Q = "Tu audio suena un poco bajo", A = { "Gracias por avisar, lo subo", "Será tu altavoz", "Ignorar" }, Best = 1 },
	{ Q = "¿Cuál es tu vídeo favorito?", A = { "Todos son malos", "El último, me costó mucho editarlo", "No me acuerdo" }, Best = 2 },
	{ Q = "¿Qué PC recomiendas para editar?", A = { "Depende del presupuesto; te explico", "El que sea", "No respondo eso" }, Best = 1 },
	{ Q = "¡Primera vez en tu directo!", A = { "¡Bienvenido a la comunidad!", "Vale", "¿Y?" }, Best = 1 },
	{ Q = "¿Cómo haces las miniaturas?", A = { "Texto corto, buen contraste y una foto clara", "Pongo mucho texto", "Al azar" }, Best = 1 },
}

function Live.Init(services)
	S = services
end

local function setupQuality(player)
	local stats = S.Computer.sessionStats(player) or {}
	local data = S.Data.get(player)
	local cam = S.Inventory.bestCatAtHome(player, "peripheral", "Cámara web", "Video")
	local video = cam and cam.Stats.Video or 0
	local _, _, camera = S.Inventory.best(player, "camera", "any", "Video")
	if camera then
		video = math.max(video, camera.Stats.Video * 0.9)
	end
	local _, _, mic = S.Inventory.best(player, "mic", "any", "Audio")
	local audio = mic and mic.Stats.Audio or 25
	local spot = S.Travel.currentSpot(player)
	local decor = spot and spot.Decor or 5
	local q = video * 0.4 + audio * 0.35 + math.min(45, decor) * 0.5 + math.min(20, (stats.Score or 20) / 5)
	return Util.clamp(q, 5, 100), video
end

local function pushState(player, s, kind, extra)
	local payload = { kind = kind, viewers = s.Viewers, peak = s.Peak, donations = s.Donations, subs = s.Subs, engagement = math.floor(s.Engagement * 100), left = math.max(0, math.floor(s.Ends - os.time())), topic = s.Topic.Name }
	for k, v in pairs(extra or {}) do
		payload[k] = v
	end
	S.Net.push(player, "live", payload)
end

local function finish(player)
	local s = sessions[player]
	if not s then
		return
	end
	sessions[player] = nil
	local data = S.Data.get(player)
	if not data then
		return
	end
	local avg = s.Ticks > 0 and math.floor(s.ViewerSum / s.Ticks) or 0
	local ads = math.floor(avg * 0.6)
	local total = ads + s.Donations
	data.Channel.Subs = data.Channel.Subs + s.Subs
	data.Counters.lives = (data.Counters.lives or 0) + 1
	data.Lives = data.Lives or {}
	Util.pushCapped(data.Lives, { Topic = s.Topic.Name, Peak = s.Peak, Avg = avg, Donations = s.Donations, Ads = ads, Subs = s.Subs, Engagement = math.floor(s.Engagement * 100), T = os.time() }, 20)
	if total > 0 then
		S.Economy.add(player, total, "Directos", "Directo: " .. s.Topic.Name, { taxable = true })
	end
	S.Progress.addXp(player, 30 + math.floor(s.Engagement * 30))
	S.Quest.check(player)
	pushState(player, s, "end", { avg = avg, ads = ads, total = total })
	S.Data.markDirty(player)
end

function Live.Start()
	local Net = S.Net

	Net.on("Live.Start", function(player, p)
		local data = S.Data.get(player)
		if sessions[player] then
			return false, "Ya estás en directo."
		end
		if not S.Computer.hasSession(player) then
			return false, "Haz el directo desde un computador o un portátil."
		end
		if os.time() - (data.LastLive or 0) < Live.Cooldown then
			return false, "Descansa un poco: podrás volver a emitir en " .. (Live.Cooldown - (os.time() - (data.LastLive or 0))) .. " s."
		end
		local topic = nil
		for _, t in ipairs(Live.Topics) do
			if t.Id == p.topic then
				topic = t
			end
		end
		if not topic then
			return false, "Elige un tema."
		end
		local q, video = setupQuality(player)
		if video <= 0 then
			return false, "Necesitas una cámara web en casa o una cámara para emitir."
		end
		data.LastLive = os.time()
		local s = { Topic = topic, Quality = q, Started = os.time(), Ends = os.time() + Live.Duration, Viewers = 1, Peak = 1, Donations = 0, Subs = 0, SubFrac = 0, Engagement = 0.35 + (S.Needs and S.Needs.mood(player) or 60) / 400, Ticks = 0, ViewerSum = 0, Question = nil, NextQ = os.time() + 8 }
		sessions[player] = s
		pushState(player, s, "start", { quality = math.floor(q) })
		return true, "🔴 ¡Estás en directo! Responde al chat para mantener a la audiencia."
	end)

	Net.on("Live.Answer", function(player, p)
		local s = sessions[player]
		if not s or not s.Question then
			return false, "No hay ninguna pregunta pendiente."
		end
		local q = s.Question
		s.Question = nil
		local choice = tonumber(p.choice)
		if choice == q.Best then
			s.Engagement = math.min(1, s.Engagement + 0.12)
			return true, "💬 ¡Buena respuesta! El chat se anima."
		end
		s.Engagement = math.max(0, s.Engagement - 0.06)
		return true, "💬 Al chat no le convenció mucho esa respuesta."
	end)

	Net.on("Live.Stop", function(player)
		if not sessions[player] then
			return false, "No estás en directo."
		end
		finish(player)
		return true, "Directo terminado."
	end)

	Net.on("Social.Post", function(player, p)
		local data = S.Data.get(player)
		if os.time() - (data.LastPost or 0) < 45 then
			return false, "Espera un poco antes de publicar otra vez."
		end
		local photo
		for _, ph in ipairs(data.Photos) do
			if ph.Id == p.photoId then
				photo = ph
			end
		end
		if not photo then
			return false, "Elige una foto del álbum."
		end
		local caption = Util.cleanText(p.caption or "", 80) or ""
		caption = S.Text.filter(player, caption)
		if not caption then
			return false, "No se pudo comprobar el texto."
		end
		data.LastPost = os.time()
		data.Counters.post_id = (data.Counters.post_id or 0) + 1
		local luck = Util.seededRandom("post" .. data.Counters.post_id .. player.UserId, 0.8, 1.2)
		local likes = math.floor((10 + data.Channel.Subs * 0.04 + math.sqrt(data.Channel.Subs) * 2) * (photo.Q / 60) * luck)
		local subs = math.floor(likes * 0.02 * (photo.Q / 70))
		data.Channel.Subs = data.Channel.Subs + subs
		data.Posts = data.Posts or {}
		Util.pushCapped(data.Posts, { Id = "s" .. data.Counters.post_id, PhotoId = photo.Id, Caption = caption, Likes = likes, Subs = subs, T = os.time(), Spot = photo.SpotName }, 30)
		data.Counters.posts = (data.Counters.posts or 0) + 1
		S.Progress.addXp(player, 5)
		S.Quest.check(player)
		return true, "📲 Publicado: ❤️ " .. likes .. " me gusta y +" .. subs .. " suscriptores."
	end)

	Players.PlayerRemoving:Connect(function(player)
		sessions[player] = nil
	end)

	task.spawn(function()
		while true do
			task.wait(3)
			for player, s in pairs(sessions) do
				local ok, err = pcall(function()
					local data = S.Data.get(player)
					if not data or not player.Parent then
						sessions[player] = nil
						return
					end
					if not S.Computer.hasSession(player) then
						finish(player)
						return
					end
					if s.Ticks % 10 == 0 and S.Needs then
						S.Needs.spend(player, 1)
					end
					local subs = data.Channel.Subs
					local trend = S.Channel.trendFor(s.Topic.Cat)
					local target = (4 + subs * 0.03 + math.sqrt(subs) * 2) * (0.5 + s.Quality / 100) * (0.6 + s.Engagement * 0.8) * trend
					s.Viewers = math.max(0, math.floor(s.Viewers + (target - s.Viewers) * 0.35 + (math.random() - 0.5) * target * 0.1))
					s.Peak = math.max(s.Peak, s.Viewers)
					s.Ticks = s.Ticks + 1
					s.ViewerSum = s.ViewerSum + s.Viewers
					s.SubFrac = s.SubFrac + s.Viewers * 0.004 * (0.5 + s.Engagement)
					local whole = math.floor(s.SubFrac)
					s.SubFrac = s.SubFrac - whole
					s.Subs = s.Subs + whole
					local extra = {}
					if math.random() < math.min(0.6, s.Viewers * 0.01) * (0.5 + s.Engagement) then
						local d = math.floor((1 + math.random() * 9) * (1 + subs / 5000))
						s.Donations = s.Donations + d
						extra.donation = d
					end
					if s.Question and os.time() > s.QuestionUntil then
						s.Question = nil
						s.Engagement = math.max(0, s.Engagement - 0.05)
					end
					if not s.Question and os.time() >= s.NextQ then
						local q = Live.Questions[math.random(1, #Live.Questions)]
						s.Question = q
						s.QuestionUntil = os.time() + 12
						s.NextQ = os.time() + 14
						extra.question = q.Q
						extra.answers = q.A
					end
					if os.time() >= s.Ends then
						finish(player)
					else
						pushState(player, s, "tick", extra)
					end
				end)
				if not ok then
					sessions[player] = nil
					S.Net.logError("live", err)
				end
			end
		end
	end)
end

return Live
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000042"><Properties><string name="Name">MarketService</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- MarketService: tienda de segunda mano «Rastro & Retro» (Zona de tiendas de segunda mano).
--  * Stock diario determinista (MarketData.stock): 12-15 artículos usados con condición 35-90%.
--    Precio = Price × (0,3 + 0,5 × condición) × descuento del evento de segunda mano (si lo hay).
--  * Cada unidad se vende una sola vez por jugador y día (data.UsedBought).
--  * Comprar, vender al rastro (70% × condición del precio pagado) y reparar con descuento exigen estar en la tienda.
--  * Coleccionables: objetos ocultos que solo aparecen a veces; los distintos conseguidos se guardan en Visited.Collectibles.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage.Shared
local Catalog = require(Shared.ItemCatalog)
local MarketData = require(Shared.MarketData)
local Util = require(Shared.Util)

local Market = {}
local S

function Market.Init(services)
	S = services
end

function Market.discount()
	local d = S.Events and S.Events.usedDiscount and S.Events.usedDiscount() or 0
	if type(d) ~= "number" or d <= 0 then
		return 0
	end
	return Util.clamp(d, 0, 0.9)
end

function Market.stock()
	return MarketData.stock(S.Time.day())
end

function Market.findUnit(key)
	if type(key) ~= "string" then
		return nil
	end
	for _, u in ipairs(Market.stock()) do
		if u.Key == key then
			return u
		end
	end
	return nil
end

-- Registro de unidades compradas hoy por el jugador (se reinicia cada día)
local function boughtToday(data)
	local day = S.Time.day()
	local b = data.UsedBought
	if type(b) ~= "table" or b.Day ~= day then
		b = { Day = day, Units = {} }
		data.UsedBought = b
	end
	if type(b.Units) ~= "table" then
		b.Units = {}
	end
	return b
end

function Market.inStore(player)
	return S.World.nearSpecial(player, "usedstore", MarketData.StoreRadius) ~= nil
end

function Market.unitInfo(player, u)
	local data = S.Data.get(player)
	local def = Catalog.get(u.Id)
	local price = MarketData.usedPrice(def, u.Cond, Market.discount())
	local newPrice = (not def.Collectible) and S.Shop.priceOf(player, def) or nil
	local b = data and data.UsedBought
	return {
		Key = u.Key,
		Id = u.Id,
		Name = def.Name,
		Cat = def.Cat,
		Cond = u.Cond,
		CondText = MarketData.condText(u.Cond),
		Price = price,
		NewPrice = newPrice,
		Saving = newPrice and math.max(0, newPrice - price) or nil,
		Collectible = def.Collectible == true,
		Level = def.Req and def.Req.Level or 1,
		Sold = type(b) == "table" and b.Day == S.Time.day() and type(b.Units) == "table" and b.Units[u.Key] == true or false,
	}
end

-- Registra un coleccionable distinto (compra o intercambio). Devuelve true si es nuevo.
function Market.registerCollectible(player, itemId)
	local def = Catalog.get(itemId)
	local data = S.Data.get(player)
	if not def or not def.Collectible or not data then
		return false
	end
	data.Visited.Collectibles = data.Visited.Collectibles or {}
	if data.Visited.Collectibles[itemId] then
		return false
	end
	data.Visited.Collectibles[itemId] = true
	S.Net.notify(player, "⭐ ¡Nuevo coleccionable para tu colección! " .. def.Name .. " (" .. Util.count(data.Visited.Collectibles) .. "/" .. #MarketData.collectibles() .. ")", "gold")
	S.Quest.check(player)
	S.Data.markDirty(player)
	return true
end

-- Motivo por el que un objeto no puede salir de tu inventario (venta en el rastro o intercambio). nil = se puede.
-- opts.leaving: conjunto de uids que también salen a la vez (para no quedarte sin teléfono).
function Market.lockReason(player, uid, opts)
	local data = S.Data.get(player)
	local rec = data and type(uid) == "string" and data.Inventory[uid]
	if not rec then
		return "No tienes ese objeto."
	end
	local def = Catalog.get(rec.Id)
	if not def then
		return "Objeto desconocido."
	end
	local loc = rec.Loc or "home"
	if loc:sub(1, 4) == "rig:" then
		return def.Name .. " está instalado en un computador. Desmóntalo primero en el Montador de PC."
	end
	if loc:sub(1, 5) == "prop:" then
		return def.Name .. " está colocado en una propiedad. Recógelo primero con el modo construcción."
	end
	if rec.Loan then
		return def.Name .. " es equipo prestado por un patrocinador: se devuelve al terminar el contrato."
	end
	if def.Slot == "bag" and loc == "backpack" then
		return "Saca " .. def.Name .. " de la mochila primero."
	end
	if def.Slot == "phone" then
		local leaving = opts and opts.leaving or {}
		local left = 0
		for u, r in pairs(data.Inventory) do
			if u ~= uid and not leaving[u] and not r.Loan then
				local d = Catalog.get(r.Id)
				if d and d.Slot == "phone" then
					left = left + 1
				end
			end
		end
		if left < 1 then
			return "No puedes quedarte sin teléfono: es tu único teléfono propio."
		end
	end
	return nil
end

local function tradeLocked(player, uid)
	return S.Trade and S.Trade.isOffered and S.Trade.isOffered(player, uid)
end

function Market.Start()
	local Net = S.Net

	Net.on("Market.Stock", function(player)
		local units = {}
		for i, u in ipairs(Market.stock()) do
			units[i] = Market.unitInfo(player, u)
		end
		return true, nil, { day = S.Time.day(), discount = Market.discount(), inStore = Market.inStore(player), units = units }
	end)

	Net.on("Market.Inspect", function(player, p)
		local u = Market.findUnit(p.key)
		if not u then
			return false, "Ese artículo ya no está en el stock de hoy."
		end
		local info = Market.unitInfo(player, u)
		local def = Catalog.get(u.Id)
		info.Note = MarketData.wearNote(u.Cond)
		info.Performance = MarketData.performance(u.Cond)
		info.RepairCost = MarketData.repairCost(def, u.Cond)
		info.Desc = def.Desc
		local msg = def.Name .. ": condición " .. u.Cond .. "% (" .. info.CondText .. ") · $" .. Util.formatInt(info.Price)
		if info.NewPrice then
			msg = msg .. " (nuevo $" .. Util.formatInt(info.NewPrice) .. ", ahorras $" .. Util.formatInt(info.Saving) .. ")"
		else
			msg = msg .. " · ⭐ pieza de colección"
		end
		return true, msg, info
	end)

	Net.on("Market.Buy", function(player, p)
		local data = S.Data.get(player)
		local u = Market.findUnit(p.key)
		if not u then
			return false, "Ese artículo ya no está en el stock de hoy."
		end
		local b = boughtToday(data)
		if b.Units[u.Key] then
			return false, "Ya compraste esta unidad hoy: cada artículo usado se vende una sola vez."
		end
		if not Market.inStore(player) then
			return false, "Tienes que estar en Rastro & Retro (Zona de tiendas de segunda mano) para comprar."
		end
		local def = Catalog.get(u.Id)
		local lvl = def.Req and def.Req.Level or 1
		if data.Level < lvl then
			return false, "Necesitas nivel " .. lvl .. " para usar " .. def.Name .. "."
		end
		if Util.count(data.Inventory) >= S.Inventory.MaxItems then
			return false, "Tu inventario está lleno (" .. S.Inventory.MaxItems .. " objetos). Vende algo primero."
		end
		local toBackpack = def.Portable and S.Inventory.canFit(player, def)
		if not toBackpack and not S.Property.canStore(player, 1) then
			return false, "Tu vivienda está llena (" .. S.Property.storedCount(player) .. "/" .. S.Property.storageCap(player) .. " objetos). Vende algo o consigue más almacenaje."
		end
		local price = MarketData.usedPrice(def, u.Cond, Market.discount())
		if not S.Economy.spend(player, price, "Compras", "Segunda mano: " .. def.Name) then
			return false, "No tienes suficiente dinero ($" .. Util.formatInt(price) .. ")."
		end
		local uid, loc = S.Inventory.add(player, def.Id, { src = "used", paid = price, cond = u.Cond, loc = "backpack" })
		if not uid then
			S.Economy.add(player, price, "Reembolsos", "Compra de segunda mano anulada", { silent = true })
			return false, tostring(loc or "No se pudo entregar el artículo.")
		end
		b.Units[u.Key] = true
		data.Counters.used_bought = (data.Counters.used_bought or 0) + 1
		S.Shop.afterPurchase(player, 1, price)
		if def.Collectible then
			Market.registerCollectible(player, def.Id)
		end
		local saving = (not def.Collectible) and math.max(0, S.Shop.priceOf(player, def) - price) or 0
		return true, "Compraste " .. def.Name .. " usado (" .. u.Cond .. "%) por $" .. Util.formatInt(price)
			.. (saving > 0 and (" · ahorraste $" .. Util.formatInt(saving)) or "") .. ". Está en " .. (loc == "backpack" and "tu mochila" or "tu casa") .. ".",
			{ uid = uid, price = price, cond = u.Cond }
	end)

	Net.on("Market.Sell", function(player, p)
		local data = S.Data.get(player)
		if not Market.inStore(player) then
			return false, "Para vender al rastro tienes que estar en Rastro & Retro. (Desde el inventario puedes vender online, pero pagan menos)."
		end
		local err = Market.lockReason(player, p.uid)
		if err then
			return false, err
		end
		if tradeLocked(player, p.uid) then
			return false, "Está en tu oferta de intercambio: quítalo de la oferta antes de venderlo."
		end
		local rec = data.Inventory[p.uid]
		local def = Catalog.get(rec.Id)
		if def.Cat == "food" then
			return false, "En el rastro no compramos comida."
		end
		local value = MarketData.sellValue(rec, def)
		if value < 1 then
			return false, "Nadie pagaría nada por " .. def.Name .. "."
		end
		local online = S.Inventory.sellValue(rec, def)
		S.Inventory.remove(player, p.uid)
		S.Economy.add(player, value, "Ventas", "Venta en Rastro & Retro: " .. def.Name, {})
		data.Counters.used_sold = (data.Counters.used_sold or 0) + 1
		return true, "Vendiste " .. def.Name .. " al rastro por $" .. Util.formatInt(value) .. (value > online and (" (online te daban $" .. Util.formatInt(online) .. ")") or "") .. ".", { value = value }
	end)

	Net.on("Market.Repair", function(player, p)
		local data = S.Data.get(player)
		local rec = type(p.uid) == "string" and data.Inventory[p.uid]
		if not rec then
			return false, "No tienes ese objeto."
		end
		if not Market.inStore(player) then
			return false, "El taller está en Rastro & Retro: ve allí para reparar con descuento."
		end
		local def = Catalog.get(rec.Id)
		if rec.Cond >= 100 then
			return false, def.Name .. " no necesita reparación."
		end
		local cost = MarketData.repairCost(def, rec.Cond)
		if not S.Economy.spend(player, cost, "Reparaciones", "Taller de Rastro & Retro: " .. def.Name) then
			return false, "La reparación cuesta $" .. Util.formatInt(cost) .. "."
		end
		rec.Cond = 100
		data.Counters.used_repairs = (data.Counters.used_repairs or 0) + 1
		return true, def.Name .. " reparado en el taller por $" .. Util.formatInt(cost) .. " (condición 100%).", { cost = cost }
	end)
end

return Market
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000043"><Properties><string name="Name">MonetizationService</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- MonetizationService: Game Passes (UserOwnsGamePassAsync) y Developer Products (ProcessReceipt).
--  * Los IDs vienen de ReplicatedStorage.Shared.MonetizationConfig (0 = no configurado).
--  * ProcessReceipt es idempotente: cada PurchaseId se registra en el perfil y nunca se entrega dos veces.
--  * Solo devuelve PurchaseGranted cuando la entrega quedó guardada; si el guardado falla, Roblox reintentará
--    y el registro evitará la entrega duplicada.

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local MonetizationConfig = require(ReplicatedStorage.Shared.MonetizationConfig)

local Monetization = {}
local S
local owned = {} -- [player] = { [key] = true }

function Monetization.Init(services)
	S = services
end

function Monetization.owns(player, key)
	return owned[player] ~= nil and owned[player][key] == true
end

function Monetization.ownedList(player)
	local list = {}
	for k in pairs(owned[player] or {}) do
		list[#list + 1] = k
	end
	return list
end

-- Suma de una ventaja numérica entre todos los pases que posee el jugador.
function Monetization.perk(player, perkName)
	local total = 0
	for key, pass in pairs(MonetizationConfig.GamePasses) do
		if Monetization.owns(player, key) then
			local v = pass.Perks[perkName]
			if type(v) == "number" then
				total = total + v
			elseif v == true then
				total = total + 1
			end
		end
	end
	return total
end

local function refresh(player)
	owned[player] = owned[player] or {}
	for key, pass in pairs(MonetizationConfig.GamePasses) do
		if MonetizationConfig.isConfigured(pass) then
			local ok, has = pcall(MarketplaceService.UserOwnsGamePassAsync, MarketplaceService, player.UserId, pass.Id)
			if ok and has then
				owned[player][key] = true
			end
		end
	end
end

function Monetization.onPlayerReady(player)
	refresh(player)
end

local function productById(id)
	for key, prod in pairs(MonetizationConfig.Products) do
		if MonetizationConfig.isConfigured(prod) and prod.Id == id then
			return key, prod
		end
	end
	return nil
end

local function processReceipt(info)
	local player = Players:GetPlayerByUserId(info.PlayerId)
	if not player then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local data = S.Data.get(player)
	if not data then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local purchaseId = tostring(info.PurchaseId)
	if data.Receipts[purchaseId] then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
	local key, prod = productById(info.ProductId)
	if not prod then
		S.Net.logError("receipt", "Producto desconocido " .. tostring(info.ProductId))
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	-- Entrega
	if prod.Grant.Money then
		S.Economy.add(player, prod.Grant.Money, "Tienda Robux", prod.Name, {})
	end
	if prod.Grant.ExportTokens then
		data.ExportTokens = data.ExportTokens + prod.Grant.ExportTokens
	end
	data.Receipts[purchaseId] = os.time()
	table.insert(data.ReceiptOrder, purchaseId)
	while #data.ReceiptOrder > 200 do
		data.Receipts[table.remove(data.ReceiptOrder, 1)] = nil
	end
	S.Net.notify(player, "¡Gracias por tu compra! Recibiste: " .. prod.Name, "success")
	S.Data.markDirty(player)
	if not S.Data.save(player, false) then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

function Monetization.Start()
	MarketplaceService.ProcessReceipt = processReceipt

	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
		if not purchased then
			return
		end
		for key, pass in pairs(MonetizationConfig.GamePasses) do
			if pass.Id == passId and MonetizationConfig.isConfigured(pass) then
				owned[player] = owned[player] or {}
				owned[player][key] = true
				S.Net.notify(player, "Game Pass activado: " .. pass.Name, "success")
				S.Avatar.refreshOverhead(player)
				S.Data.markDirty(player)
			end
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		owned[player] = nil
	end)

	S.Net.on("Shop.PassInfo", function(player)
		local list = {}
		for key, pass in pairs(MonetizationConfig.GamePasses) do
			list[#list + 1] = { Key = key, Name = pass.Name, Desc = pass.Description, Id = pass.Id, Configured = MonetizationConfig.isConfigured(pass), Owned = Monetization.owns(player, key) }
		end
		local prods = {}
		for key, prod in pairs(MonetizationConfig.Products) do
			prods[#prods + 1] = { Key = key, Name = prod.Name, Id = prod.Id, Configured = MonetizationConfig.isConfigured(prod) }
		end
		table.sort(list, function(a, b)
			return a.Name < b.Name
		end)
		table.sort(prods, function(a, b)
			return a.Name < b.Name
		end)
		return true, nil, { passes = list, products = prods }
	end)
end

return Monetization
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000044"><Properties><string name="Name">NPCService</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- NPCService: dependientes, barista, asesora del banco y vecinos con diálogos útiles.
-- Usa Players:CreateHumanoidModelFromDescription; si falla (por ejemplo en pruebas sin red),
-- crea un maniquí sencillo de Parts para que el NPC siga siendo funcional.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CollectionService = game:GetService("CollectionService")
local Shared = ReplicatedStorage.Shared
local Catalog = require(Shared.ItemCatalog)
local WorldData = require(Shared.WorldData)

local NPC = {}
local S
local npcs = {}

local tips = {
	"Los lugares con 🎥 son ideales para grabar. Cada distrito tiene los suyos.",
	"En la hora dorada (amanecer y atardecer) las tomas exteriores quedan más bonitas.",
	"Si llueve, una cámara resistente al agua evita gotas en la lente.",
	"Un trípode permite hacer time-lapses. ¡Al público le encantan!",
	"Un micrófono de solapa o de cañón mejora mucho el audio en la calle.",
	"Las reseñas con prueba real necesitan que tengas el producto en la mochila.",
	"Dicen que hay lugares secretos repartidos por la ciudad... busca destellos dorados.",
	"Con el taxi del teléfono llegas a cualquier distrito rápido, pero cuesta dinero.",
	"Las tendencias cambian cada día. Mira la app Tendencias antes de elegir idea.",
	"Un buen monitor mejora el etalonaje; un buen PC exporta mucho más rápido.",
}

local roleLines = {
	studio = { "¡Bienvenido a Prisma! Alquila un plató por horas: gaming, música, cocina, podcast, croma o fotografía.",
		"Dentro del plató alquilado tus escenas y fotos ganan calidad y luz profesional.",
		"Con el croma eliges el fondo y tu escena cuenta como si grabaras en ese tipo de lugar." },
	leisure = { "¡Hola! Aquí se viene a desconectar: sube el ánimo y vuelve a grabar con energía.",
		"Entrenar mejora tu forma física; el cine te da ideas para vídeos; en el karaoke, con micrófono, ¡hasta grabas!",
		"En la bolera, lee la pista: el efecto y la potencia correctos dan más plenos." },
	shopkeeper = { "¡Bienvenido! Puedes inspeccionar cualquier producto expuesto o ver todo el catálogo en el mostrador.",
		"Si compras aquí, te lo llevas al momento. Online tarda un poco más en llegar.",
		"¿Vas a grabar una reseña? Puedes probar los productos de exposición mientras estés en la tienda." },
	barista = { "Los computadores públicos son gratis. Perfectos para editar si aún no tienes uno bueno.",
		"Aquí vienen muchos estudiantes a editar sus vídeos." },
	waiter = { "¡Bienvenido! El menú del día es lo más popular. Pide en el mostrador.", "Comer bien sube tu energía y tu ánimo." },
	petkeeper = { "¡Hola! Aquí puedes adoptar perros, gatos, pájaros, conejos, tortugas y peces. Máximo 3 por familia.",
		"Juega con tu mascota y dale de comer: se pone muy contenta. Si la notas triste, solo necesita un poco de cariño.",
		"Una cama o un rascador en casa hace que tus mascotas estén siempre a gusto." },
	banker = { "Desde el cajero puedes ahorrar, crear metas y pedir préstamos con un 10% fijo.",
		"Revisa tu informe mensual: verás en qué gastas y cuánto ganas." },
	dealer = { "¡Bienvenido a Motor City! Cada modelo es distinto: velocidad, giro, maletero y consumo.",
		"¿Aún no te llega? Alquílalo un día y pruébalo por la ciudad.",
		"Con un buen maletero llevas mucho más equipo cuando grabas fuera de casa." },
	mechanic = { "Aquí repostamos, cargamos eléctricos y reparamos. Un vehículo cuidado corre más.",
		"Si te quedas sin combustible irás muy despacio: no esperes a la reserva." },
	travel = { "¡Bienvenido! Desde este mostrador salen los vuelos a todos los destinos. El billete incluye la vuelta.",
		"Algunos destinos piden invitación: sube de rango o consigue un patrocinio activo.",
		"En cada destino hay lugares 🎥 únicos, un hotel y una tienda con productos que no se venden en la ciudad." },
	dest_shop = { "Todo lo que ves aquí es exclusivo: no lo encontrarás en la ciudad.", "Si no cabe en tu mochila, te lo enviamos a casa." },
	hotel = { "Una noche en el hotel te deja como nuevo para seguir grabando.", "Las vistas desde las habitaciones son de postal." },
}

function NPC.Init(services)
	S = services
end

local function buildDummy(name)
	local m = Instance.new("Model")
	m.Name = name
	local function part(n, size, offset, color)
		local p = Instance.new("Part")
		p.Name = n
		p.Size = size
		p.Anchored = true
		p.Color = color
		p.CFrame = CFrame.new(offset)
		p.Parent = m
		return p
	end
	local root = part("HumanoidRootPart", Vector3.new(2, 2, 1), Vector3.new(0, 3, 0), Color3.fromRGB(60, 120, 200))
	root.Transparency = 1
	part("Torso", Vector3.new(2, 2, 1), Vector3.new(0, 3, 0), Color3.fromRGB(60, 120, 200))
	part("Head", Vector3.new(1.2, 1.2, 1.2), Vector3.new(0, 4.6, 0), Color3.fromRGB(240, 200, 160))
	part("Legs", Vector3.new(2, 2, 1), Vector3.new(0, 1, 0), Color3.fromRGB(40, 40, 50))
	local hum = Instance.new("Humanoid")
	hum.Parent = m
	m.PrimaryPart = root
	return m
end

-- Crea el modelo anclado de un personaje (avatar o maniquí de respaldo). También lo usa FriendService.
function NPC.makeModel(name, shirt, pants)
	local m
	local ok = pcall(function()
		local desc = Instance.new("HumanoidDescription")
		if shirt then
			desc.TorsoColor = shirt
			desc.LeftArmColor = shirt
			desc.RightArmColor = shirt
		end
		if pants then
			desc.LeftLegColor = pants
			desc.RightLegColor = pants
		end
		m = Players:CreateHumanoidModelFromDescription(desc, Enum.HumanoidRigType.R15)
	end)
	if not ok or not m then
		m = buildDummy(name)
		if shirt and m:FindFirstChild("Torso") then
			m.Torso.Color = shirt
		end
		if pants and m:FindFirstChild("Legs") then
			m.Legs.Color = pants
		end
	end
	m.Name = name
	for _, p in ipairs(m:GetDescendants()) do
		if p:IsA("BasePart") then
			p.Anchored = true
		end
	end
	local hum = m:FindFirstChildOfClass("Humanoid")
	if hum then
		hum.DisplayName = name
		hum.NameDisplayDistance = 40
	end
	return m, hum
end

local function spawnNpc(point, index)
	local m = NPC.makeModel(point.Name)
	m.Parent = workspace:FindFirstChild("City") or workspace
	local look = Vector3.new(point.Look.X, point.Pos.Y + 3, point.Look.Z)
	local pos = Vector3.new(point.Pos.X, point.Pos.Y + 3, point.Pos.Z)
	if (look - pos).Magnitude < 0.1 then
		look = pos + Vector3.new(0, 0, 1)
	end
	m:PivotTo(CFrame.lookAt(pos, look))
	local root = m.PrimaryPart or m:FindFirstChild("HumanoidRootPart")
	local id = "npc" .. index
	local pp = Instance.new("ProximityPrompt")
	pp.ActionText = "Hablar"
	pp.ObjectText = point.Name
	pp.HoldDuration = 0
	pp.MaxActivationDistance = 10
	pp.RequiresLineOfSight = false
	pp:SetAttribute("Action", "npc")
	pp:SetAttribute("NpcId", id)
	pp.Parent = root
	pp.Triggered:Connect(function(player)
		local okTalk, err = pcall(S.World.onPrompt, pp, player)
		if not okTalk then
			S.Net.logError("npc", err)
		end
	end)
	npcs[id] = { Point = point, Count = 0 }
end

function NPC.talk(player, id)
	local npc = npcs[id or ""]
	if not npc then
		return
	end
	npc.Count = npc.Count + 1
	local p = npc.Point
	local lines = roleLines[p.Role] or tips
	local text = lines[(npc.Count % #lines) + 1]
	local options = {}
	if p.Role == "shopkeeper" and p.Store then
		options[#options + 1] = { label = "Ver catálogo", ui = "store", store = p.Store }
		S.Travel.markStoreVisit(player, p.Store)
	elseif p.Role == "petkeeper" then
		options[#options + 1] = { label = "Ver mascotas", ui = "app", app = "pets" }
	elseif p.Role == "banker" then
		options[#options + 1] = { label = "Abrir banco", ui = "app", app = "bank" }
	elseif p.Role == "dealer" or p.Role == "mechanic" then
		options[#options + 1] = { label = "Vehículos", ui = "app", app = "vehicles" }
	elseif p.Role == "travel" or p.Role == "dest_shop" or p.Role == "hotel" then
		options[#options + 1] = { label = "Abrir Viajes", ui = "app", app = "travel" }
	elseif p.Role == "studio" then
		options[#options + 1] = { label = "Abrir Estudios", ui = "app", app = "studios" }
	elseif p.Role == "leisure" then
		options[#options + 1] = { label = "Abrir Ocio", ui = "app", app = "leisure" }
	elseif p.Role == "citizen" then
		local d = WorldData.DistrictById[p.District or ""]
		text = tips[(npc.Count + #(p.Name)) % #tips + 1]
		if d then
			text = "¡Hola! Esto es " .. d.Name .. ". " .. text
		end
	end
	S.Net.push(player, "dialog", { name = p.Name, text = text, options = options })
end

function NPC.Start()
	task.defer(function()
		for i, point in ipairs(S.World.NpcPoints) do
			local ok, err = pcall(spawnNpc, point, i)
			if not ok then
				S.Net.logError("npc spawn", err)
			end
		end
	end)
end

return NPC
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000045"><Properties><string name="Name">NeedsService</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- NeedsService: energía y ánimo con efectos MODERADOS (nunca bloquean el juego).
--  * La energía baja despacio mientras juegas y al grabar, trabajar o emitir.
--  * Comer (supermercado, restaurante, cafetería, máquinas, cocina, domicilio) y descansar la recuperan.
--  * Energía < 25: escenas algo menos interesantes y exportaciones un 15% más lentas.
--  * Ánimo alto (> 80): escenas algo más interesantes y directos más animados.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local Shared = ReplicatedStorage.Shared
local FoodData = require(Shared.FoodData)
local Catalog = require(Shared.ItemCatalog)
local Util = require(Shared.Util)

local Needs = {}
local S
local lastRest = {}
local warned = {}

function Needs.Init(services)
	S = services
end

local function needs(data)
	data.Needs = data.Needs or { Energy = 100, Mood = 70 }
	return data.Needs
end
Needs.get = needs

function Needs.change(player, energy, mood)
	local data = S.Data.get(player)
	if not data then
		return
	end
	local n = needs(data)
	n.Energy = Util.clamp(n.Energy + (energy or 0), 0, 100)
	n.Mood = Util.clamp(n.Mood + (mood or 0), 0, 100)
	if n.Energy < 20 and not warned[player] then
		warned[player] = true
		S.Net.notify(player, "🥱 Estás cansado: come algo o descansa en una cama (efecto leve en tus vídeos).", "warn")
	elseif n.Energy >= 40 then
		warned[player] = nil
	end
	S.Data.markDirty(player)
end

function Needs.spend(player, amount)
	-- Asistente de tu empresa: gastas menos energía
	if S.Company and amount > 0 then
		amount = amount * S.Company.energyMult(player)
	end
	Needs.change(player, -amount, 0)
end

function Needs.interestBonus(player)
	local data = S.Data.get(player)
	if not data then
		return 0
	end
	local n = needs(data)
	local b = 0
	if n.Energy < 25 then
		b = b - 4
	end
	if n.Mood > 80 then
		b = b + 3
	elseif n.Mood < 30 then
		b = b - 2
	end
	return b
end

function Needs.exportMult(player)
	local data = S.Data.get(player)
	return (data and needs(data).Energy < 25) and 1.15 or 1
end

function Needs.mood(player)
	local data = S.Data.get(player)
	return data and needs(data).Mood or 60
end

local function eat(player, name, energy, mood)
	Needs.change(player, energy, mood)
	local data = S.Data.get(player)
	data.Counters.meals = (data.Counters.meals or 0) + 1
	S.Quest.check(player)
	return "🍽 " .. name .. ": energía +" .. energy .. ", ánimo +" .. mood .. "."
end

function Needs.rest(player)
	if not S.Home.isAtHome(player) then
		S.Net.notify(player, "Descansa en tu casa.", "info")
		return
	end
	if lastRest[player] and os.clock() - lastRest[player] < 90 then
		S.Net.notify(player, "Acabas de descansar.", "info")
		return
	end
	lastRest[player] = os.clock()
	Needs.change(player, 50, 6)
	S.Net.notify(player, "😴 Has descansado: energía +50.", "success")
end

local function placeNear(player, kind)
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if not root then
		return false
	end
	local list = {}
	if kind == "vending" then
		list = S.World.VendingMachines or {}
	else
		for _, sp in ipairs(S.World.Specials) do
			if (kind == "restaurant" and sp.Type == "restaurant") or (kind == "cafe" and sp.Type == "cafe") then
				list[#list + 1] = Vector3.new(sp.WX, 0, sp.WZ)
			end
		end
	end
	for _, pos in ipairs(list) do
		local dx, dz = root.Position.X - pos.X, root.Position.Z - pos.Z
		if dx * dx + dz * dz <= 40 * 40 then
			return true
		end
	end
	return false
end

function Needs.Start()
	local Net = S.Net

	Net.on("Food.Eat", function(player, p)
		local data = S.Data.get(player)
		local rec = data.Inventory[p.uid or ""]
		local def = rec and Catalog.get(rec.Id)
		if not def or def.Cat ~= "food" then
			return false, "Eso no se puede comer."
		end
		if rec.Loc ~= "home" and rec.Loc ~= "backpack" then
			return false, "No lo tienes a mano."
		end
		S.Inventory.remove(player, p.uid)
		return true, eat(player, def.Name, def.Stats.Energy, def.Stats.Mood)
	end)

	Net.on("Food.Order", function(player, p)
		local menu = FoodData.Menus[p.place or ""]
		if not menu then
			return false, "Lugar no válido."
		end
		if not placeNear(player, p.place) then
			return false, "Tienes que estar en " .. menu.Name .. "."
		end
		local item
		for _, it in ipairs(menu.Items) do
			if it[1] == p.item then
				item = it
			end
		end
		if not item then
			return false, "Ese plato no está en el menú."
		end
		if not S.Economy.spend(player, item[3], "Comida", item[2] .. " (" .. menu.Name .. ")") then
			return false, "Cuesta $" .. item[3] .. "."
		end
		local data = S.Data.get(player)
		if p.place == "restaurant" then
			data.Counters.restaurant_meals = (data.Counters.restaurant_meals or 0) + 1
		end
		return true, eat(player, item[2], item[4], item[5])
	end)

	Net.on("Food.Cook", function(player, p)
		local data = S.Data.get(player)
		if not S.Home.isAtHome(player) then
			return false, "Cocina en la cocina de tu casa."
		end
		local recipe
		for _, r in ipairs(FoodData.Recipes) do
			if r.Id == p.recipe then
				recipe = r
			end
		end
		if not recipe then
			return false, "Receta no válida."
		end
		local used = {}
		for _, need in ipairs(recipe.Needs) do
			local found = nil
			for uid, rec in pairs(data.Inventory) do
				if rec.Id == need and not used[uid] and (rec.Loc == "home" or rec.Loc == "backpack") then
					found = uid
					break
				end
			end
			if not found then
				return false, "Te falta: " .. Catalog.get(need).Name .. ". Cómpralo en el Supermercado Fresco."
			end
			used[found] = true
		end
		for uid in pairs(used) do
			S.Inventory.remove(player, uid)
		end
		S.Inventory.add(player, recipe.Id, { src = "cook", paid = 0, loc = "home" })
		data.Counters.cooked = (data.Counters.cooked or 0) + 1
		Needs.change(player, 0, 4)
		S.Quest.check(player)
		return true, "👨‍🍳 Has cocinado " .. Catalog.get(recipe.Id).Name .. ". Está en tu despensa."
	end)

	Net.on("Food.Delivery", function(player, p)
		local data = S.Data.get(player)
		local price = FoodData.Delivery.Prices[p.item or ""]
		if not price then
			return false, "Ese plato no está disponible a domicilio."
		end
		data.FoodOrders = data.FoodOrders or {}
		if #data.FoodOrders >= 3 then
			return false, "Ya tienes 3 pedidos de comida en camino."
		end
		local total = price + FoodData.Delivery.Fee
		if not S.Economy.spend(player, total, "Comida", "Comida a domicilio: " .. Catalog.get(p.item).Name) then
			return false, "Cuesta $" .. total .. " (incluye $" .. FoodData.Delivery.Fee .. " de envío)."
		end
		table.insert(data.FoodOrders, { Item = p.item, Eta = os.time() + FoodData.Delivery.Seconds })
		return true, "🛵 Pedido en camino: llega a tu casa en " .. FoodData.Delivery.Seconds .. " s."
	end)

	Net.on("Food.Rest", function(player)
		Needs.rest(player)
		return true
	end)

	Players.PlayerRemoving:Connect(function(player)
		lastRest[player] = nil
		warned[player] = nil
	end)

	task.spawn(function()
		while true do
			task.wait(10)
			for _, player in ipairs(Players:GetPlayers()) do
				local data = S.Data.get(player)
				if data then
					local n = needs(data)
					n.Energy = math.max(0, n.Energy - 0.25)
					n.Mood = n.Mood + (60 - n.Mood) * 0.01
					-- comida a domicilio
					local orders = data.FoodOrders or {}
					for i = #orders, 1, -1 do
						if os.time() >= orders[i].Eta then
							local item = orders[i].Item
							table.remove(orders, i)
							S.Inventory.add(player, item, { src = "delivery", paid = 0, loc = "home" })
							S.Net.notify(player, "🛵 Tu comida ha llegado a casa: " .. Catalog.get(item).Name, "success")
						end
					end
					S.Data.markDirty(player)
				end
			end
		end
	end)
end

return Needs
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000046"><Properties><string name="Name">Net</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Net: único punto de entrada de peticiones del cliente.
--   Remotes/Request (RemoteFunction): el cliente pide una acción -> { ok, msg, data }
--   Remotes/Push (RemoteEvent): el servidor envía estado, avisos y aperturas de interfaz.
-- Todas las acciones se validan en el servidor. Hay límite de peticiones por jugador
-- y los errores se registran sin tumbar el servidor.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

local Config = require(ReplicatedStorage.Shared.Config)

local Net = {}
local S
local handlers = {}
local buckets = {}
local errorLog = {}

Net.ErrorLog = errorLog

function Net.Init(services)
	S = services
	local folder = ReplicatedStorage:FindFirstChild("Remotes")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "Remotes"
		folder.Parent = ReplicatedStorage
	end
	local request = folder:FindFirstChild("Request") or Instance.new("RemoteFunction")
	request.Name = "Request"
	request.Parent = folder
	local push = folder:FindFirstChild("Push") or Instance.new("RemoteEvent")
	push.Name = "Push"
	push.Parent = folder
	Net.RequestRemote = request
	Net.PushRemote = push

	request.OnServerInvoke = function(player, action, payload)
		return Net.dispatch(player, action, payload)
	end
	Players.PlayerRemoving:Connect(function(player)
		buckets[player] = nil
	end)
end

function Net.logError(where, err)
	local entry = os.date("!%H:%M:%S") .. " [" .. tostring(where) .. "] " .. tostring(err)
	table.insert(errorLog, 1, entry)
	while #errorLog > 50 do
		table.remove(errorLog)
	end
	warn("[YTLife] " .. entry)
end

-- Registra una acción. opts.noProfile = no requiere datos cargados.
function Net.on(action, fn, opts)
	assert(handlers[action] == nil, "Acción duplicada: " .. action)
	handlers[action] = { fn = fn, opts = opts or {} }
end

local function allow(player)
	local now = os.clock()
	local b = buckets[player]
	if not b then
		b = { tokens = Config.RequestsPerSecond, last = now }
		buckets[player] = b
	end
	b.tokens = math.min(Config.RequestsPerSecond, b.tokens + (now - b.last) * Config.RequestsPerSecond)
	b.last = now
	if b.tokens < 1 then
		return false
	end
	b.tokens = b.tokens - 1
	return true
end

function Net.dispatch(player, action, payload)
	if type(action) ~= "string" then
		return { ok = false, msg = "Petición no válida." }
	end
	local h = handlers[action]
	if not h then
		return { ok = false, msg = "Acción desconocida: " .. action }
	end
	if not allow(player) then
		return { ok = false, msg = "Vas demasiado rápido. Espera un momento." }
	end
	if not h.opts.noProfile and not S.Data.get(player) then
		return { ok = false, msg = "Tus datos aún se están cargando." }
	end
	if payload ~= nil and type(payload) ~= "table" then
		payload = {}
	end
	payload = payload or {}
	local success, ok, msg, data = pcall(h.fn, player, payload)
	if not success then
		Net.logError(action, ok)
		return { ok = false, msg = "Ha ocurrido un error. Inténtalo de nuevo." }
	end
	if ok ~= false then
		S.Data.markDirty(player)
	end
	return { ok = ok ~= false, msg = msg, data = data }
end

function Net.push(player, kind, data)
	if player and player.Parent then
		Net.PushRemote:FireClient(player, kind, data)
	end
end

function Net.pushAll(kind, data)
	Net.PushRemote:FireAllClients(kind, data)
end

-- Atajos de notificación
function Net.notify(player, text, style)
	Net.push(player, "notify", { text = text, style = style or "info" })
end

return Net
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000047"><Properties><string name="Name">PetService</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- PetService: mascotas.
--  * Se adoptan en la Tienda de mascotas Huellitas (máximo 3). Nombre filtrado, color, accesorios y juguetes.
--  * Solo una mascota sale contigo a la vez. Los peces se quedan en casa, en su acuario.
--  * La mascota activa es un modelo de Parts distinto por especie que te sigue de forma suave
--    (AlignPosition/AlignOrientation hacia un Attachment de tu HumanoidRootPart, con la propiedad de red
--    del jugador). Si se queda lejos (taxi, reaparición), el servidor la acerca. Se elimina al salir.
--  * Felicidad 0-100: baja muy despacio mientras juegas y sube al jugar, comer y pasear.
--    Si está baja, la mascota solo se ve triste: NUNCA penaliza tu progreso.
--  * Integración: fotos en modo "mascota" (+8 calidad, requiere tu mascota cerca) y escenas grabadas
--    con tu mascota cerca (+3 de interés, ver Pet.interestBonus).

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local Shared = ReplicatedStorage.Shared
local LifeData = require(Shared.LifeData)
local Util = require(Shared.Util)

local Pet = {}
local S
local Care = LifeData.PetCare
local spawned = {} -- [player] = { Id, Model, Root, Att, Follow, Align, Orient, Tag, Offset, Last }
local lastPlay = {} -- [player] = { [petId] = os.clock() }

function Pet.Init(services)
	S = services
end

local function rgb(t)
	return Color3.fromRGB(t[1], t[2], t[3])
end

local function rootOf(player)
	return player.Character and player.Character:FindFirstChild("HumanoidRootPart")
end

local function pets(data)
	data.Pets = data.Pets or {}
	return data.Pets
end

local function gear(data)
	data.PetGear = data.PetGear or {}
	data.PetGear.Acc = data.PetGear.Acc or {}
	data.PetGear.Toys = data.PetGear.Toys or {}
	return data.PetGear
end

local function moodIcon(rec)
	if rec.Happy < Care.SadBelow then
		return "😢"
	elseif rec.Happy >= Care.HappyAbove then
		return "💖"
	end
	return "🙂"
end

-- ¿Tiene el jugador una cama o rascador colocado en alguna de sus propiedades?
local function hasPetBed(data)
	for _, rec in pairs(data.Inventory or {}) do
		if type(rec.Loc) == "string" and rec.Loc:sub(1, 5) == "prop:" and Util.indexOf(Care.BedItems, rec.Id) then
			return true
		end
	end
	return false
end
Pet.hasPetBed = hasPetBed

---------------------------------------------------------------------------
-- Modelos (Parts sin anclar, soldadas a una raíz invisible; sin colisiones para no empujar a nadie)
---------------------------------------------------------------------------
-- Geometría de cada especie en "unidades de escala 1"; se multiplica por def.Size.
-- Cada parte: { nombre, tamaño, posición, color ("body" = color elegido), opciones }
-- Anclajes de accesorios: Neck (cuello), Head (parte alta de la cabeza), Eyes, HeadW (ancho de cabeza).
local DARK = { 35, 30, 30 }
local SPECIES = {
	dog = {
		RootY = 1.2,
		Parts = {
			{ "Body", { 1.2, 1, 2.2 }, { 0, 1.2, 0 }, "body" },
			{ "Head", { 1, 1, 1 }, { 0, 1.9, -1.3 }, "body" },
			{ "Snout", { 0.6, 0.45, 0.5 }, { 0, 1.7, -1.95 }, "light" },
			{ "Nose", { 0.22, 0.2, 0.15 }, { 0, 1.85, -2.22 }, DARK },
			{ "EarL", { 0.3, 0.6, 0.2 }, { -0.42, 2.2, -1.25 }, "dark" },
			{ "EarR", { 0.3, 0.6, 0.2 }, { 0.42, 2.2, -1.25 }, "dark" },
			{ "EyeL", { 0.15, 0.15, 0.08 }, { -0.25, 2.05, -1.82 }, DARK },
			{ "EyeR", { 0.15, 0.15, 0.08 }, { 0.25, 2.05, -1.82 }, DARK },
			{ "Tail", { 0.2, 0.2, 0.9 }, { 0, 1.6, 1.4 }, "body", { Rot = { 35, 0, 0 } } },
			{ "LegFL", { 0.35, 0.8, 0.35 }, { -0.4, 0.4, -0.8 }, "body" },
			{ "LegFR", { 0.35, 0.8, 0.35 }, { 0.4, 0.4, -0.8 }, "body" },
			{ "LegBL", { 0.35, 0.8, 0.35 }, { -0.4, 0.4, 0.8 }, "body" },
			{ "LegBR", { 0.35, 0.8, 0.35 }, { 0.4, 0.4, 0.8 }, "body" },
		},
		Neck = { 0, 1.5, -0.95 }, Head = { 0, 2.4, -1.3 }, Eyes = { 0, 2.05, -1.86 }, HeadW = 1,
	},
	cat = {
		RootY = 1.1,
		Parts = {
			{ "Body", { 1, 0.85, 2 }, { 0, 1.1, 0 }, "body" },
			{ "Head", { 0.95, 0.85, 0.85 }, { 0, 1.75, -1.15 }, "body" },
			{ "EarL", { 0.3, 0.4, 0.3 }, { -0.28, 2.35, -1.1 }, "body", { Class = "WedgePart" } },
			{ "EarR", { 0.3, 0.4, 0.3 }, { 0.28, 2.35, -1.1 }, "body", { Class = "WedgePart" } },
			{ "Nose", { 0.15, 0.12, 0.08 }, { 0, 1.68, -1.6 }, { 255, 150, 170 } },
			{ "EyeL", { 0.16, 0.16, 0.08 }, { -0.22, 1.85, -1.59 }, { 120, 200, 90 } },
			{ "EyeR", { 0.16, 0.16, 0.08 }, { 0.22, 1.85, -1.59 }, { 120, 200, 90 } },
			{ "Tail", { 0.18, 1.3, 0.18 }, { 0, 1.75, 1.05 }, "body", { Rot = { -20, 0, 0 } } },
			{ "LegFL", { 0.28, 0.7, 0.28 }, { -0.32, 0.35, -0.7 }, "body" },
			{ "LegFR", { 0.28, 0.7, 0.28 }, { 0.32, 0.35, -0.7 }, "body" },
			{ "LegBL", { 0.28, 0.7, 0.28 }, { -0.32, 0.35, 0.7 }, "body" },
			{ "LegBR", { 0.28, 0.7, 0.28 }, { 0.32, 0.35, 0.7 }, "body" },
		},
		Neck = { 0, 1.4, -0.8 }, Head = { 0, 2.2, -1.15 }, Eyes = { 0, 1.85, -1.63 }, HeadW = 0.95,
	},
	bird = {
		RootY = 0, -- vuela: la raíz está en el centro del cuerpo
		Flies = true,
		Parts = {
			{ "Body", { 1.6, 1.6, 2 }, { 0, 0, 0 }, "body", { Ball = true } },
			{ "Head", { 1.1, 1.1, 1.1 }, { 0, 0.85, -0.85 }, "body", { Ball = true } },
			{ "Beak", { 0.3, 0.25, 0.55 }, { 0, 0.75, -1.5 }, { 255, 170, 40 } },
			{ "EyeL", { 0.16, 0.16, 0.08 }, { -0.3, 1, -1.3 }, DARK },
			{ "EyeR", { 0.16, 0.16, 0.08 }, { 0.3, 1, -1.3 }, DARK },
			{ "WingL", { 0.18, 0.9, 1.4 }, { -0.9, 0.1, 0 }, "dark", { Rot = { 0, 0, 25 } } },
			{ "WingR", { 0.18, 0.9, 1.4 }, { 0.9, 0.1, 0 }, "dark", { Rot = { 0, 0, -25 } } },
			{ "Tail", { 0.7, 0.15, 0.9 }, { 0, 0.1, 1.2 }, "dark", { Rot = { -15, 0, 0 } } },
		},
		Neck = { 0, 0.45, -0.7 }, Head = { 0, 1.45, -0.85 }, Eyes = { 0, 1, -1.36 }, HeadW = 1.1,
	},
	rabbit = {
		RootY = 1,
		Parts = {
			{ "Body", { 1.8, 1.6, 2.1 }, { 0, 1, 0.1 }, "body", { Ball = true } },
			{ "Head", { 1.3, 1.2, 1.2 }, { 0, 1.85, -0.8 }, "body", { Ball = true } },
			{ "EarL", { 0.3, 1.3, 0.18 }, { -0.25, 2.9, -0.75 }, "body", { Rot = { 0, 0, 8 } } },
			{ "EarR", { 0.3, 1.3, 0.18 }, { 0.25, 2.9, -0.75 }, "body", { Rot = { 0, 0, -8 } } },
			{ "Nose", { 0.18, 0.14, 0.1 }, { 0, 1.8, -1.42 }, { 255, 150, 170 } },
			{ "EyeL", { 0.16, 0.16, 0.08 }, { -0.3, 2, -1.33 }, DARK },
			{ "EyeR", { 0.16, 0.16, 0.08 }, { 0.3, 2, -1.33 }, DARK },
			{ "Tail", { 0.6, 0.6, 0.6 }, { 0, 1.1, 1.2 }, { 250, 250, 250 }, { Ball = true } },
			{ "FootL", { 0.4, 0.3, 0.9 }, { -0.5, 0.15, 0.3 }, "body" },
			{ "FootR", { 0.4, 0.3, 0.9 }, { 0.5, 0.15, 0.3 }, "body" },
		},
		Neck = { 0, 1.45, -0.6 }, Head = { 0, 2.45, -0.8 }, Eyes = { 0, 2, -1.38 }, HeadW = 1.3,
	},
	turtle = {
		RootY = 0.7,
		Slow = true,
		Parts = {
			{ "Shell", { 2.8, 1.5, 3.2 }, { 0, 0.85, 0 }, "body", { Ball = true } },
			{ "Belly", { 2.4, 0.35, 2.8 }, { 0, 0.45, 0 }, { 230, 210, 150 } },
			{ "Head", { 0.9, 0.8, 1 }, { 0, 0.8, -1.95 }, { 120, 170, 90 }, { Ball = true } },
			{ "EyeL", { 0.14, 0.14, 0.08 }, { -0.22, 0.95, -2.42 }, DARK },
			{ "EyeR", { 0.14, 0.14, 0.08 }, { 0.22, 0.95, -2.42 }, DARK },
			{ "LegFL", { 0.6, 0.4, 0.6 }, { -1.05, 0.2, -0.9 }, { 120, 170, 90 } },
			{ "LegFR", { 0.6, 0.4, 0.6 }, { 1.05, 0.2, -0.9 }, { 120, 170, 90 } },
			{ "LegBL", { 0.6, 0.4, 0.6 }, { -1.05, 0.2, 0.9 }, { 120, 170, 90 } },
			{ "LegBR", { 0.6, 0.4, 0.6 }, { 1.05, 0.2, 0.9 }, { 120, 170, 90 } },
		},
		Neck = { 0, 0.75, -1.5 }, Head = { 0, 1.2, -1.95 }, Eyes = { 0, 0.95, -2.46 }, HeadW = 0.9,
	},
}
Pet.Species = SPECIES

local function weld(a, b)
	local w = Instance.new("WeldConstraint")
	w.Part0 = a
	w.Part1 = b
	w.Parent = a
end

-- Crea una parte de la mascota soldada a la raíz
local function piece(m, root, name, size, cf, color, opts)
	opts = opts or {}
	local p = Instance.new(opts.Class or "Part")
	p.Name = name
	p.Size = size
	p.CFrame = cf
	p.Color = typeof(color) == "Color3" and color or rgb(color)
	p.Material = opts.Material or Enum.Material.SmoothPlastic
	if opts.Ball then
		p.Shape = Enum.PartType.Ball
	elseif opts.Cylinder then
		p.Shape = Enum.PartType.Cylinder
	end
	if opts.Transparency then
		p.Transparency = opts.Transparency
	end
	p.Anchored = false
	p.CanCollide = false
	p.CanTouch = false
	p.CanQuery = false
	p.Massless = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = m
	weld(root, p)
	return p
end

local function shade(c, k)
	return { math.floor(c[1] * k), math.floor(c[2] * k), math.floor(c[3] * k) }
end

local function rotOf(o)
	if o and o.Rot then
		return CFrame.Angles(math.rad(o.Rot[1]), math.rad(o.Rot[2]), math.rad(o.Rot[3]))
	end
	return CFrame.new()
end

-- Accesorio sobre los anclajes de la especie (base = CFrame del suelo bajo la mascota)
local function buildAccessory(m, root, spec, acc, base, k)
	local function at(anchor, dx, dy, dz)
		return base * CFrame.new((anchor[1] + (dx or 0)) * k, (anchor[2] + (dy or 0)) * k, (anchor[3] + (dz or 0)) * k)
	end
	local hw = spec.HeadW
	if acc == "Collar rojo" then
		piece(m, root, "AccCollar", Vector3.new(hw * 0.95 * k, 0.2 * k, hw * 0.7 * k), at(spec.Neck), { 210, 30, 40 })
		piece(m, root, "AccTag", Vector3.new(0.22 * k, 0.22 * k, 0.22 * k), at(spec.Neck, 0, -0.18, -hw * 0.38), { 255, 205, 60 }, { Ball = true, Material = Enum.Material.Metal })
	elseif acc == "Pajarita" then
		piece(m, root, "AccBowKnot", Vector3.new(0.18 * k, 0.18 * k, 0.12 * k), at(spec.Neck, 0, 0, -hw * 0.4), { 40, 40, 120 })
		piece(m, root, "AccBowL", Vector3.new(0.32 * k, 0.26 * k, 0.1 * k), at(spec.Neck, -0.22, 0, -hw * 0.4) * CFrame.Angles(0, 0, math.rad(15)), { 60, 60, 170 })
		piece(m, root, "AccBowR", Vector3.new(0.32 * k, 0.26 * k, 0.1 * k), at(spec.Neck, 0.22, 0, -hw * 0.4) * CFrame.Angles(0, 0, math.rad(-15)), { 60, 60, 170 })
	elseif acc == "Gorrito" then
		-- gorro de fiesta: cilindros cada vez más estrechos y un pompón
		for i = 0, 2 do
			local dia = hw * (0.6 - i * 0.17)
			piece(m, root, "AccHat", Vector3.new(0.25 * k, dia * k, dia * k), at(spec.Head, 0, 0.12 + i * 0.24, 0) * CFrame.Angles(0, 0, math.rad(90)), i % 2 == 0 and { 255, 210, 40 } or { 80, 170, 255 }, { Cylinder = true })
		end
		piece(m, root, "AccPompom", Vector3.new(0.22 * k, 0.22 * k, 0.22 * k), at(spec.Head, 0, 0.82, 0), { 255, 70, 110 }, { Ball = true })
	elseif acc == "Pañuelo" then
		piece(m, root, "AccScarf", Vector3.new(hw * 0.9 * k, 0.45 * k, 0.12 * k), at(spec.Neck, 0, -0.15, -hw * 0.38) * CFrame.Angles(0, math.rad(180), 0), { 60, 140, 230 }, { Class = "WedgePart", Material = Enum.Material.Fabric })
	elseif acc == "Gafas de sol" then
		piece(m, root, "AccLensL", Vector3.new(0.3 * k, 0.2 * k, 0.06 * k), at(spec.Eyes, -hw * 0.24, 0, -0.02), { 15, 15, 20 }, { Material = Enum.Material.Glass })
		piece(m, root, "AccLensR", Vector3.new(0.3 * k, 0.2 * k, 0.06 * k), at(spec.Eyes, hw * 0.24, 0, -0.02), { 15, 15, 20 }, { Material = Enum.Material.Glass })
		piece(m, root, "AccBridge", Vector3.new(hw * 0.25 * k, 0.05 * k, 0.05 * k), at(spec.Eyes, 0, 0.05, -0.02), { 15, 15, 20 })
	end
end

local function tagText(rec)
	local def = LifeData.PetById[rec.Species]
	return (def and def.Icon or "🐾") .. " " .. rec.Name .. " " .. moodIcon(rec)
end

-- Construye el modelo de una mascota. base = CFrame en el suelo bajo la mascota.
function Pet.buildModel(rec, base, owner)
	local def = LifeData.PetById[rec.Species]
	local spec = SPECIES[rec.Species]
	if not def or not spec then
		return nil
	end
	local k = def.Size
	local color = (LifeData.PetColors[rec.Color] or LifeData.PetColors[1])
	local m = Instance.new("Model")
	m.Name = "Mascota_" .. owner.Name
	local root = Instance.new("Part")
	root.Name = "PetRoot"
	root.Size = Vector3.new(1, 1, 1)
	root.CFrame = base * CFrame.new(0, spec.RootY * k, 0)
	root.Transparency = 1
	root.Anchored = false
	root.CanCollide = false
	root.CanTouch = false
	root.CanQuery = false
	root.Parent = m
	m.PrimaryPart = root
	for _, pd in ipairs(spec.Parts) do
		local c = pd[4]
		if c == "body" then
			c = color
		elseif c == "dark" then
			c = shade(color, 0.7)
		elseif c == "light" then
			c = { math.min(255, color[1] + 40), math.min(255, color[2] + 40), math.min(255, color[3] + 40) }
		end
		local size = Vector3.new(pd[2][1] * k, pd[2][2] * k, pd[2][3] * k)
		local cf = base * CFrame.new(pd[3][1] * k, pd[3][2] * k, pd[3][3] * k) * rotOf(pd[5])
		piece(m, root, pd[1], size, cf, c, pd[5])
	end
	buildAccessory(m, root, spec, rec.Acc, base, k)
	-- Seguimiento suave
	local att = Instance.new("Attachment")
	att.Name = "PetAttachment"
	att.Parent = root
	local align = Instance.new("AlignPosition")
	align.Name = "PetFollow"
	align.Attachment0 = att
	align.MaxForce = 30000
	align.MaxVelocity = spec.Slow and 20 or 45
	align.Responsiveness = spec.Slow and 10 or 22
	align.RigidityEnabled = false
	align.Parent = root
	local orient = Instance.new("AlignOrientation")
	orient.Name = "PetTurn"
	orient.Attachment0 = att
	orient.MaxTorque = 30000
	orient.Responsiveness = 14
	orient.Parent = root
	-- Nombre
	local bb = Instance.new("BillboardGui")
	bb.Name = "PetTag"
	bb.Size = UDim2.fromOffset(160, 26)
	bb.StudsOffset = Vector3.new(0, 2.6 * k + 1, 0)
	bb.MaxDistance = 60
	bb.AlwaysOnTop = false
	bb.Parent = root
	local t = Instance.new("TextLabel")
	t.Size = UDim2.fromScale(1, 1)
	t.BackgroundTransparency = 0.35
	t.BackgroundColor3 = Color3.fromRGB(20, 20, 24)
	t.TextColor3 = Color3.new(1, 1, 1)
	t.TextScaled = true
	t.Font = Enum.Font.GothamBold
	t.Text = tagText(rec)
	t.Parent = bb
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 8)
	corner.Parent = t
	m:SetAttribute("YTPet", true)
	m:SetAttribute("Owner", owner.UserId)
	m:SetAttribute("Species", rec.Species)
	m:SetAttribute("Sad", rec.Happy < Care.SadBelow)
	return m, root, att, align, orient, t
end

-- Posición junto al jugador (detrás y a la derecha; el pájaro vuela a la altura del hombro)
local function offsetFor(rec)
	local def = LifeData.PetById[rec.Species]
	local spec = SPECIES[rec.Species]
	if spec.Flies then
		return Vector3.new(2.2, 1.8, 0.5)
	end
	return Vector3.new(3, -3 + spec.RootY * def.Size, 2.5)
end

-- Attachment de destino dentro del HumanoidRootPart (se recrea si el personaje reaparece)
local function ensureFollow(sp, hrp, player)
	if sp.Follow and sp.Follow.Parent == hrp then
		return false
	end
	if sp.Follow then
		sp.Follow:Destroy()
	end
	local f = Instance.new("Attachment")
	f.Name = "PetFollowTarget"
	f.Position = sp.Offset
	f.Parent = hrp
	sp.Follow = f
	sp.Align.Attachment1 = f
	sp.Orient.Attachment1 = f
	pcall(function()
		sp.Root:SetNetworkOwner(player)
	end)
	return true
end

local function placeNear(sp, hrp)
	local p = hrp.Position + sp.Offset
	sp.Model:PivotTo(CFrame.new(p.X, p.Y, p.Z))
end

function Pet.despawn(player)
	local sp = spawned[player]
	if sp then
		if sp.Model then
			sp.Model:Destroy()
		end
		if sp.Follow then
			sp.Follow:Destroy()
		end
	end
	spawned[player] = nil
end

-- Saca una mascota (sustituye a la que estuviera fuera)
function Pet.spawn(player, id)
	local data = S.Data.get(player)
	local rec = data and pets(data)[id]
	if not rec then
		return false, "No tienes esa mascota."
	end
	local def = LifeData.PetById[rec.Species]
	if not def or not def.Follows or not SPECIES[rec.Species] then
		return false, "Los peces se quedan en casa, en su acuario. Visítalos en casa para jugar con ellos o darles de comer."
	end
	local hrp = rootOf(player)
	if not hrp then
		return false, "No puedes sacar a tu mascota ahora."
	end
	Pet.despawn(player)
	local offset = offsetFor(rec)
	local p = hrp.Position + offset
	local base = CFrame.new(p.X, p.Y - SPECIES[rec.Species].RootY * def.Size, p.Z)
	local model, root, att, align, orient, tag = Pet.buildModel(rec, base, player)
	local sp = { Id = id, Model = model, Root = root, Att = att, Align = align, Orient = orient, Tag = tag, Offset = offset, Last = hrp.Position }
	spawned[player] = sp
	model.Parent = workspace
	ensureFollow(sp, hrp, player)
	data.ActivePet = id
	return true, def.Icon .. " " .. rec.Name .. " te acompaña. ¡Pasead juntos!"
end

function Pet.active(player)
	local sp = spawned[player]
	return sp and sp.Id or nil, sp and sp.Model or nil
end

-- Mascota visible junto al jugador: la activa si está cerca o, en casa, el acuario de peces.
function Pet.nearPet(player)
	local data = S.Data.get(player)
	if not data then
		return nil
	end
	local list = pets(data)
	local sp = spawned[player]
	local hrp = rootOf(player)
	if sp and hrp and sp.Model and sp.Model.Parent and list[sp.Id] then
		if (sp.Root.Position - hrp.Position).Magnitude <= Care.NearRadius then
			return sp.Id, list[sp.Id]
		end
	end
	if S.Home.isAtHome(player) then
		for id, rec in pairs(list) do
			if rec.Species == "fish" then
				return id, rec
			end
		end
	end
	return nil
end

-- +3 de interés en escenas grabadas con tu mascota cerca (lo suma VideoService)
function Pet.interestBonus(player)
	return Pet.nearPet(player) and Care.SceneInterest or 0
end

-- Foto en modo mascota: devuelve el bonus de calidad y la mascota, o nil y un mensaje claro
function Pet.photoBonus(player)
	local id, rec = Pet.nearPet(player)
	if id then
		return Care.PhotoBonus, rec
	end
	local data = S.Data.get(player)
	if not data or next(pets(data)) == nil then
		return nil, "Para una foto de mascota necesitas una mascota. Adopta una en la Tienda de mascotas Huellitas (Zona de apartamentos)."
	end
	return nil, "Tu mascota no está contigo: sácala desde la app Mascotas 🐾 para hacerle una foto."
end

local function refreshModel(player, id)
	local sp = spawned[player]
	if sp and sp.Id == id then
		Pet.spawn(player, id)
	end
end

local function updateTag(sp, rec)
	if sp.Tag then
		sp.Tag.Text = tagText(rec)
		sp.Tag.TextColor3 = rec.Happy < Care.SadBelow and Color3.fromRGB(170, 200, 255) or Color3.new(1, 1, 1)
	end
	sp.Model:SetAttribute("Sad", rec.Happy < Care.SadBelow)
end

-- ¿Puede cuidar a esta mascota aquí? (está contigo o estás en casa, donde viven tus mascotas)
local function canCare(player, id)
	local sp = spawned[player]
	local hrp = rootOf(player)
	if sp and sp.Id == id and hrp and (sp.Root.Position - hrp.Position).Magnitude <= Care.NearRadius then
		return true
	end
	return S.Home.isAtHome(player)
end

local function cleanName(player, raw)
	local name = Util.cleanText(raw, Care.NameMax)
	if not name or #name < 1 then
		return nil, "Escribe un nombre para tu mascota."
	end
	local f = S.Text.filter(player, name)
	if not f or f == "" then
		return nil, "No se pudo comprobar ese nombre. Prueba con otro."
	end
	return f
end

local function happyAdd(rec, n)
	rec.Happy = Util.clamp((rec.Happy or Care.StartHappy) + n, 0, 100)
end

local function bestToy(data)
	local best = nil
	for id in pairs(gear(data).Toys) do
		local t = LifeData.PetToyById[id]
		if t and (not best or t.Bonus > best.Bonus) then
			best = t
		end
	end
	return best
end

local function petOf(player, p)
	local data = S.Data.get(player)
	if type(p.id) ~= "string" then
		return nil, nil, data
	end
	return pets(data)[p.id], LifeData.PetById[(pets(data)[p.id] or {}).Species or ""], data
end

local function atShop(player)
	return S.World.nearSpecial(player, "petshop", 45) ~= nil
end

local SHOP_HINT = "Ve a la Tienda de mascotas Huellitas (Zona de apartamentos)."

---------------------------------------------------------------------------
-- Paseo, felicidad y seguimiento (bucle cada segundo)
---------------------------------------------------------------------------
local function addWalk(player, data, rec, d)
	rec.Walk = (rec.Walk or 0) + d
	local before = math.floor((data.Counters.pet_walk_m or 0) / 100)
	data.Counters.pet_walk_m = (data.Counters.pet_walk_m or 0) + d
	local after = math.floor(data.Counters.pet_walk_m / 100)
	data.Counters.pet_walk = after
	if after > before then
		happyAdd(rec, Care.WalkHappy * (after - before))
		if S.Needs then
			S.Needs.change(player, 0, 1)
		end
		S.Quest.check(player)
	end
end

local function tickPlayer(player, decay)
	local data = S.Data.get(player)
	if not data then
		return
	end
	local list = pets(data)
	if decay and next(list) ~= nil and not hasPetBed(data) then
		for _, rec in pairs(list) do
			happyAdd(rec, -Care.DecayPerMinute)
		end
	end
	data.ActivePet = data.ActivePet or ""
	if data.ActivePet ~= "" and not list[data.ActivePet] then
		data.ActivePet = ""
	end
	local sp = spawned[player]
	-- Tu mascota vuelve contigo al reaparecer o al volver a entrar
	if data.ActivePet ~= "" and (not sp or sp.Id ~= data.ActivePet or not sp.Model.Parent) and rootOf(player) then
		Pet.spawn(player, data.ActivePet)
		sp = spawned[player]
	end
	if not sp or not sp.Model.Parent then
		return
	end
	local hrp = rootOf(player)
	if not hrp then
		return
	end
	local rec = list[sp.Id]
	if ensureFollow(sp, hrp, player) then
		placeNear(sp, hrp)
	end
	local pos = hrp.Position
	local last = sp.Last
	sp.Last = pos
	if last then
		local d = (Vector3.new(pos.X, 0, pos.Z) - Vector3.new(last.X, 0, last.Z)).Magnitude
		local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
		local seated = hum and (hum.Sit == true or hum.SeatPart ~= nil)
		if d > 0.5 and d <= Care.WalkMaxStep and not seated then
			addWalk(player, data, rec, d)
		end
	end
	if (sp.Root.Position - pos).Magnitude > Care.SnapDistance then
		placeNear(sp, hrp)
	end
	updateTag(sp, rec)
end

---------------------------------------------------------------------------
-- Acciones
---------------------------------------------------------------------------
function Pet.Start()
	local Net = S.Net

	Net.on("Pet.Adopt", function(player, p)
		local data = S.Data.get(player)
		local def = type(p.species) == "string" and LifeData.PetById[p.species] or nil
		if not def then
			return false, "Especie no válida."
		end
		if not atShop(player) then
			return false, "Para adoptar, " .. SHOP_HINT:sub(1, 1):lower() .. SHOP_HINT:sub(2)
		end
		if Util.count(pets(data)) >= Care.MaxPets then
			return false, "Ya cuidas de " .. Care.MaxPets .. " mascotas: es el máximo para poder darles todo el cariño que necesitan."
		end
		local color = Util.clamp(math.floor(tonumber(p.color) or 1), 1, #LifeData.PetColors)
		local name
		if type(p.name) == "string" and Util.trim(p.name) ~= "" then
			local err
			name, err = cleanName(player, p.name)
			if not name then
				return false, err
			end
		end
		local price = math.floor(def.Price * S.Events.priceMultiplier({ Cat = "pet" }) + 0.5)
		if not S.Economy.spend(player, price, "Mascotas", "Adopción: " .. def.Name) then
			return false, "Adoptar " .. def.Name:lower() .. " cuesta $" .. Util.formatInt(price) .. " (vacunas y chip incluidos)."
		end
		local id = S.Data.nextUid(player, "pet")
		if not name then
			name = LifeData.PetNames[(data.Uid % #LifeData.PetNames) + 1]
		end
		pets(data)[id] = { Species = def.Id, Name = name, Color = color, Acc = "Ninguno", Happy = Care.StartHappy, Walk = 0, Fed = 0, Since = os.time() }
		data.Counters.pets_adopted = (data.Counters.pets_adopted or 0) + 1
		S.Progress.addXp(player, 15)
		S.Quest.check(player)
		if def.Follows then
			return true, def.Icon .. " ¡Bienvenido a la familia, " .. name .. "! Sácalo a pasear desde la app Mascotas 🐾.", { id = id }
		end
		return true, def.Icon .. " ¡Tu acuario con " .. name .. " ya está en casa! Visítalos para jugar y darles de comer.", { id = id }
	end)

	Net.on("Pet.Rename", function(player, p)
		local rec = petOf(player, p)
		if not rec then
			return false, "No tienes esa mascota."
		end
		local name, err = cleanName(player, p.name)
		if not name then
			return false, err
		end
		rec.Name = name
		local sp = spawned[player]
		if sp and sp.Id == p.id then
			updateTag(sp, rec)
		end
		return true, "Ahora se llama " .. name .. "."
	end)

	Net.on("Pet.Color", function(player, p)
		local rec = petOf(player, p)
		local c = tonumber(p.color)
		if not rec or not c or not LifeData.PetColors[math.floor(c)] then
			return false, "Color no válido."
		end
		rec.Color = math.floor(c)
		refreshModel(player, p.id)
		return true, "🎨 " .. rec.Name .. " luce color " .. LifeData.PetColorNames[rec.Color]:lower() .. "."
	end)

	-- Compra (en la tienda) y/o pone un accesorio. Una vez comprado sirve para todas tus mascotas.
	Net.on("Pet.Accessory", function(player, p)
		local rec, _, data = petOf(player, p)
		local acc = p.acc
		if not rec then
			return false, "No tienes esa mascota."
		end
		if type(acc) ~= "string" or not Util.indexOf(LifeData.PetAccessories, acc) then
			return false, "Accesorio no válido."
		end
		local g = gear(data)
		local bought = false
		if acc ~= "Ninguno" and not g.Acc[acc] then
			if not atShop(player) then
				return false, "Compra accesorios en la tienda. " .. SHOP_HINT
			end
			local price = LifeData.PetAccessoryPrices[acc] or 0
			if not S.Economy.spend(player, price, "Mascotas", "Accesorio: " .. acc) then
				return false, acc .. " cuesta $" .. price .. "."
			end
			g.Acc[acc] = true
			bought = true
		end
		rec.Acc = acc
		refreshModel(player, p.id)
		if acc == "Ninguno" then
			return true, rec.Name .. " ya no lleva accesorio."
		end
		return true, (bought and "🛍 Comprado. " or "") .. rec.Name .. " lleva " .. acc:lower() .. "."
	end)

	Net.on("Pet.BuyToy", function(player, p)
		local data = S.Data.get(player)
		local toy = type(p.toy) == "string" and LifeData.PetToyById[p.toy] or nil
		if not toy then
			return false, "Juguete no válido."
		end
		local g = gear(data)
		if g.Toys[toy.Id] then
			return false, "Ya tienes " .. toy.Name:lower() .. "."
		end
		if not atShop(player) then
			return false, "Compra juguetes en la tienda. " .. SHOP_HINT
		end
		if not S.Economy.spend(player, toy.Price, "Mascotas", "Juguete: " .. toy.Name) then
			return false, toy.Name .. " cuesta $" .. toy.Price .. "."
		end
		g.Toys[toy.Id] = true
		return true, "🧸 " .. toy.Name .. ": jugar con tus mascotas las hará aún más felices (+" .. toy.Bonus .. ")."
	end)

	Net.on("Pet.Spawn", function(player, p)
		local data = S.Data.get(player)
		if type(p.id) ~= "string" or not pets(data)[p.id] then
			return false, "No tienes esa mascota."
		end
		local sp = spawned[player]
		if sp and sp.Id == p.id and sp.Model.Parent then
			return false, pets(data)[p.id].Name .. " ya está contigo."
		end
		return Pet.spawn(player, p.id)
	end)

	Net.on("Pet.Store", function(player)
		local data = S.Data.get(player)
		local sp = spawned[player]
		local id = (sp and sp.Id) or (data.ActivePet ~= "" and data.ActivePet) or nil
		if not id then
			return false, "No tienes ninguna mascota fuera."
		end
		Pet.despawn(player)
		data.ActivePet = ""
		local rec = pets(data)[id]
		return true, rec and (rec.Name .. " vuelve a casa a descansar.") or "Tu mascota vuelve a casa."
	end)

	Net.on("Pet.Play", function(player, p)
		local rec, def, data = petOf(player, p)
		if not rec then
			return false, "No tienes esa mascota."
		end
		if not canCare(player, p.id) then
			return false, "Para jugar con " .. rec.Name .. ", sácalo contigo o ve a casa."
		end
		lastPlay[player] = lastPlay[player] or {}
		local wait = Care.PlayCooldown - (os.clock() - (lastPlay[player][p.id] or -1e9))
		if wait > 0 then
			return false, rec.Name .. " está descansando un poco. Vuelve a jugar en " .. math.ceil(wait) .. " s."
		end
		lastPlay[player][p.id] = os.clock()
		local toy = bestToy(data)
		happyAdd(rec, Care.PlayHappy + (toy and toy.Bonus or 0))
		if S.Needs then
			S.Needs.change(player, 0, Care.PlayMood)
		end
		data.Counters.pet_play = (data.Counters.pet_play or 0) + 1
		local sp = spawned[player]
		if sp and sp.Id == p.id then
			updateTag(sp, rec)
			local fx = Instance.new("Sparkles")
			fx.Parent = sp.Root
			task.delay(3, function()
				fx:Destroy()
			end)
		end
		return true, (def and def.Icon or "🐾") .. " Jugaste con " .. rec.Name .. (toy and (" (" .. toy.Name:lower() .. ")") or "") .. ": felicidad " .. math.floor(rec.Happy) .. "/100 · tu ánimo +" .. Care.PlayMood
	end)

	Net.on("Pet.Feed", function(player, p)
		local rec, def = petOf(player, p)
		if not rec or not def then
			return false, "No tienes esa mascota."
		end
		if not canCare(player, p.id) then
			return false, "Para dar de comer a " .. rec.Name .. ", sácalo contigo o ve a casa."
		end
		local wait = Care.FeedCooldown - (os.time() - (rec.Fed or 0))
		if wait > 0 then
			return false, rec.Name .. " ya ha comido. Podrás darle más en " .. math.ceil(wait) .. " s."
		end
		if not S.Economy.spend(player, def.Food, "Mascotas", "Comida para " .. rec.Name) then
			return false, "La comida cuesta $" .. def.Food .. "."
		end
		rec.Fed = os.time()
		happyAdd(rec, Care.FeedHappy)
		local sp = spawned[player]
		if sp and sp.Id == p.id then
			updateTag(sp, rec)
		end
		return true, "🍖 " .. rec.Name .. " ha comido ($" .. def.Food .. "): felicidad " .. math.floor(rec.Happy) .. "/100"
	end)

	-- Si ya no puedes cuidarla, Huellitas le busca una familia (sin reembolso, sin penalización)
	Net.on("Pet.Rehome", function(player, p)
		local rec, _, data = petOf(player, p)
		if not rec then
			return false, "No tienes esa mascota."
		end
		if not atShop(player) then
			return false, "Habla con la cuidadora de la tienda. " .. SHOP_HINT
		end
		local sp = spawned[player]
		if sp and sp.Id == p.id then
			Pet.despawn(player)
		end
		if data.ActivePet == p.id then
			data.ActivePet = ""
		end
		pets(data)[p.id] = nil
		return true, "💞 " .. rec.Name .. " se va a vivir con una familia que lo cuidará muy bien."
	end)

	Players.PlayerRemoving:Connect(function(player)
		Pet.despawn(player)
		lastPlay[player] = nil
	end)

	task.spawn(function()
		local ticks = 0
		while true do
			task.wait(1)
			ticks = ticks + 1
			local decay = ticks % 60 == 0
			for _, player in ipairs(Players:GetPlayers()) do
				local ok, err = pcall(tickPlayer, player, decay)
				if not ok then
					S.Net.logError("PetTick", err)
				end
			end
			for player in pairs(spawned) do
				if not player.Parent then
					Pet.despawn(player)
				end
			end
		end
	end)
end

return Pet
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000048"><Properties><string name="Name">ProgressService</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- ProgressService: experiencia, niveles y rango de creador.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Progression = require(ReplicatedStorage.Shared.Progression)

local Progress = {}
local S

Progress.Xp = Progression.Xp

function Progress.Init(services)
	S = services
end

function Progress.rank(data)
	return Progression.rankFor(data.Level, data.Channel.Subs, data.Counters.published or 0, data.Reputation)
end

function Progress.addXp(player, amount)
	local data = S.Data.get(player)
	if not data or amount <= 0 then
		return
	end
	local oldRank = Progress.rank(data)
	local level, xp, ups = Progression.applyXp(data.Level, data.XP, amount)
	data.Level, data.XP = level, xp
	if ups > 0 then
		S.Net.push(player, "levelUp", { level = level })
		S.Quest.check(player)
	end
	local newRank, rank = Progress.rank(data)
	if newRank > oldRank then
		S.Net.push(player, "rankUp", { name = rank.Name, unlock = rank.Unlock })
		S.Avatar.refreshOverhead(player)
	end
	S.Data.markDirty(player)
end

function Progress.Start() end

return Progress
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000049"><Properties><string name="Name">PropertyService</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- PropertyService (Fase 2): inmobiliaria, contratos, interiores y modo construcción.
--  * Alquilar (primera semana + fianza), comprar, convertir alquiler en compra, terminar contrato, vender.
--  * Pagos cada 7 días JUGADOS: alquiler o mantenimiento. Impago = deuda + recargo. Tras 3 impagos un
--    alquiler se rescinde, pero los muebles vuelven al inventario (nunca se pierde nada).
--  * Cada jugador tiene un interior privado que se construye al entrar, con su decoración y muebles.
--  * Modo construcción: colocar, mover, rotar y recoger muebles; paredes, suelo, luz, cortinas, estilos,
--    mejoras (aislamiento, seguridad, almacenaje, iluminación) y diseños guardados.
--  * La decoración y las mejoras afectan de verdad a las grabaciones hechas dentro.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local CollectionService = game:GetService("CollectionService")
local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Catalog = require(Shared.ItemCatalog)
local PropertyData = require(Shared.PropertyData)
local WorldData = require(Shared.WorldData)
local Util = require(Shared.Util)

local Property = {}
local S
local interiors = {} -- [player] = { Id, Origin, Model, W, D }
local slots = {} -- [index] = player
local folderRoot

Property.WallHeight = 14

function Property.Init(services)
	S = services
end

local function rgb(t)
	return Color3.fromRGB(t[1], t[2], t[3])
end

---------------------------------------------------------------------------
-- Posiciones exteriores (carteles en cada distrito)
---------------------------------------------------------------------------
function Property.signPosition(listing)
	local d = WorldData.DistrictById[listing.District]
	local cx, cz = WorldData.center(d)
	local idx = 0
	for _, l in ipairs(PropertyData.Listings) do
		if l.District == listing.District then
			idx = idx + 1
		end
		if l == listing then
			break
		end
	end
	return Vector3.new(cx - 66 + (idx - 1) * 26, 0.5, cz + 121)
end

---------------------------------------------------------------------------
-- Consultas
---------------------------------------------------------------------------
local function held(data, id)
	return data.Properties[id]
end

function Property.count(data)
	return Util.count(data.Properties)
end

function Property.storageCap(player)
	local data = S.Data.get(player)
	local cap = PropertyData.StarterStorage
	for id, rec in pairs(data.Properties) do
		local l = PropertyData.ById[id]
		if l then
			cap = cap + math.floor(l.Storage * (rec.Upgrades.storage and 1.5 or 1))
		end
	end
	return cap
end

function Property.storedCount(player)
	local data = S.Data.get(player)
	local n = 0
	for _, rec in pairs(data.Inventory) do
		if rec.Loc ~= "backpack" then
			n = n + 1
		end
	end
	return n
end

function Property.canStore(player, n)
	return Property.storedCount(player) + (n or 1) <= Property.storageCap(player)
end

function Property.inside(player)
	local it = interiors[player]
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if not it or not root then
		return nil
	end
	local rel = root.Position - it.Origin
	if math.abs(rel.X) <= it.W / 2 + 2 and math.abs(rel.Z) <= it.D / 2 + 2 and rel.Y > -5 and rel.Y < 30 then
		return it.Id
	end
	return nil
end

function Property.interiorInfo(player)
	local it = interiors[player]
	if not it then
		return nil
	end
	return { Id = it.Id, Origin = { it.Origin.X, it.Origin.Y, it.Origin.Z }, W = it.W, D = it.D }
end

-- Puntuación de decoración de una propiedad (0-45)
function Property.decorScore(player, id)
	local data = S.Data.get(player)
	local rec = data.Properties[id]
	if not rec then
		return 0
	end
	local score, styles = 0, {}
	for uid in pairs(rec.Placed) do
		local item = data.Inventory[uid]
		local def = item and Catalog.get(item.Id)
		if def then
			score = score + (def.Stats.Decor or 0) * (0.7 + 0.3 * def.Quality / 100)
			if def.Style then
				styles[def.Style] = (styles[def.Style] or 0) + 1
			end
		end
	end
	local bonus = 0
	for _, n in pairs(styles) do
		if n >= 3 then
			bonus = bonus + 5
		end
	end
	score = score + math.min(10, bonus)
	-- Paredes/suelo/luz que coinciden con un estilo
	for _, st in ipairs(PropertyData.Styles) do
		if st.Wall == rec.Decor.Wall and st.Floor == rec.Decor.Floor and st.Light == rec.Decor.Light then
			score = score + 4
			break
		end
	end
	if rec.Decor.Curtain then
		score = score + 1
	end
	return math.floor(math.min(45, score) * 10 + 0.5) / 10
end

-- Lugar de grabación cuando estás dentro de una propiedad
function Property.spot(player)
	local id = Property.inside(player)
	if not id then
		return nil
	end
	local data = S.Data.get(player)
	local l = PropertyData.ById[id]
	local rec = data.Properties[id]
	local tags = { "home" }
	if l.Kind == "home" then
		tags[#tags + 1] = "food"
	end
	for _, t in ipairs(l.Tags or {}) do
		if not Util.indexOf(tags, t) then
			tags[#tags + 1] = t
		end
	end
	if l.Kind == "studio" and not Util.indexOf(tags, "studio") then
		tags[#tags + 1] = "studio"
	end
	local decor = Property.decorScore(player, id)
	if decor >= 15 and not Util.indexOf(tags, "studio") then
		tags[#tags + 1] = "studio"
	end
	local acoustic = 0
	for uid in pairs(rec.Placed) do
		local item = data.Inventory[uid]
		local def = item and Catalog.get(item.Id)
		if def and def.Stats.Acoustic then
			acoustic = acoustic + def.Stats.Acoustic
		end
	end
	local noise = math.max(0, 2 - (rec.Upgrades.soundproof and 3 or 0) - math.min(4, acoustic))
	local light = (rec.Upgrades.lightrig and 20 or 0) + (rec.Decor.Light == 5 and 8 or 0)
	return {
		Id = "prop_" .. id,
		Name = l.Name,
		Tags = tags,
		Indoor = true,
		Interest = 5 + math.floor((l.Env + (rec.Upgrades.security and 5 or 0)) / 10) + math.floor(l.Studio / 3),
		Noise = noise,
		Busy = 0,
		IsHome = true,
		Decor = 5 + decor,
		ExtraLight = light,
		District = l.District,
	}
end

---------------------------------------------------------------------------
-- Construcción de interiores
---------------------------------------------------------------------------
local function P(parent, name, size, cf, color, material, opts)
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.Size = size
	p.CFrame = cf
	p.Color = typeof(color) == "Color3" and color or rgb(color)
	p.Material = material or Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if opts then
		if opts.Shape then
			p.Shape = opts.Shape
		end
		if opts.Transparency then
			p.Transparency = opts.Transparency
		end
		if opts.NoCollide then
			p.CanCollide = false
		end
	end
	p.Parent = parent
	return p
end

local function addPrompt(part, action, text, objectText, attrs)
	local pp = Instance.new("ProximityPrompt")
	pp.ActionText = text
	pp.ObjectText = objectText or ""
	pp.HoldDuration = 0
	pp.MaxActivationDistance = 10
	pp.RequiresLineOfSight = false
	pp:SetAttribute("Action", action)
	for k, v in pairs(attrs or {}) do
		pp:SetAttribute(k, v)
	end
	pp.Parent = part
	CollectionService:AddTag(pp, "YTPrompt")
	return pp
end

-- Modelo de un mueble (huella en el suelo centrada en cf)
function Property.furnitureModel(parent, def, cf, uid)
	local m = Instance.new("Model")
	m.Name = def.Name
	m:SetAttribute("FurnitureUid", uid)
	local c = rgb(def.Color)
	local f = def.Foot or { 4, 4, 3 }
	local w, d, h = f[1], f[2], f[3]
	local shape = def.Shape
	if shape == "sofa" then
		P(m, "Seat", Vector3.new(w, 1.4, d), cf * CFrame.new(0, 0.9, 0), c, Enum.Material.Fabric)
		P(m, "Back", Vector3.new(w, 2.2, 0.8), cf * CFrame.new(0, 2.4, -d / 2 + 0.4), c, Enum.Material.Fabric)
		P(m, "ArmL", Vector3.new(0.8, 1.8, d), cf * CFrame.new(-w / 2 + 0.4, 1.6, 0), c, Enum.Material.Fabric)
		P(m, "ArmR", Vector3.new(0.8, 1.8, d), cf * CFrame.new(w / 2 - 0.4, 1.6, 0), c, Enum.Material.Fabric)
	elseif shape == "lamp" then
		P(m, "Pole", Vector3.new(0.3, h - 1, 0.3), cf * CFrame.new(0, (h - 1) / 2, 0), { 40, 40, 44 }, Enum.Material.Metal)
		local shade = P(m, "Shade", Vector3.new(w, 1.2, d), cf * CFrame.new(0, h - 0.6, 0), c, Enum.Material.Neon)
		local l = Instance.new("PointLight")
		l.Range = 16
		l.Brightness = 1.2
		l.Color = c
		l.Parent = shade
	elseif shape == "painting" then
		P(m, "Stand", Vector3.new(0.3, 3, 0.3), cf * CFrame.new(0, 1.5, 0), { 60, 45, 35 }, Enum.Material.Wood)
		P(m, "Frame", Vector3.new(w, h, 0.3), cf * CFrame.new(0, 3 + h / 2 - 1, 0), { 60, 45, 35 }, Enum.Material.Wood)
		P(m, "Canvas", Vector3.new(w - 0.6, h - 0.6, 0.1), cf * CFrame.new(0, 3 + h / 2 - 1, 0.2), c, Enum.Material.SmoothPlastic)
	elseif shape == "plant" then
		P(m, "Pot", Vector3.new(w * 0.7, 1.4, d * 0.7), cf * CFrame.new(0, 0.7, 0), { 170, 90, 60 }, Enum.Material.Slate)
		P(m, "Leaves", Vector3.new(w, h - 1.4, d), cf * CFrame.new(0, 1.4 + (h - 1.4) / 2, 0), c, Enum.Material.Grass, { Shape = Enum.PartType.Ball })
	elseif shape == "rug" then
		P(m, "Rug", Vector3.new(w, 0.15, d), cf * CFrame.new(0, 0.08, 0), c, Enum.Material.Fabric, { NoCollide = true })
	elseif shape == "shelf" then
		P(m, "Shelf", Vector3.new(w, h, d), cf * CFrame.new(0, h / 2, 0), c, Enum.Material.WoodPlanks)
		for i = 1, 3 do
			P(m, "Items", Vector3.new(w - 1, 1, d * 0.6), cf * CFrame.new(0, i * h / 4, d * 0.15), { 200, 60 + i * 40, 80 }, Enum.Material.SmoothPlastic)
		end
	elseif shape == "bed" then
		P(m, "Frame", Vector3.new(w, 1, d), cf * CFrame.new(0, 0.5, 0), { 110, 80, 60 }, Enum.Material.Wood)
		P(m, "Mattress", Vector3.new(w - 0.4, 1, d - 0.4), cf * CFrame.new(0, 1.5, 0), c, Enum.Material.Fabric)
		P(m, "Pillow", Vector3.new(w - 1.5, 0.6, 1.4), cf * CFrame.new(0, 2.2, -d / 2 + 1.2), { 255, 255, 255 }, Enum.Material.Fabric)
	elseif shape == "table" or shape == "desk" then
		P(m, "Top", Vector3.new(w, 0.4, d), cf * CFrame.new(0, h - 0.2, 0), c, Enum.Material.WoodPlanks)
		for _, sx in ipairs({ -1, 1 }) do
			for _, sz in ipairs({ -1, 1 }) do
				P(m, "Leg", Vector3.new(0.4, h - 0.4, 0.4), cf * CFrame.new(sx * (w / 2 - 0.4), (h - 0.4) / 2, sz * (d / 2 - 0.4)), c, Enum.Material.Wood)
			end
		end
	elseif shape == "curtain" then
		P(m, "Rod", Vector3.new(w, 0.3, 0.3), cf * CFrame.new(0, h, 0), { 50, 50, 55 }, Enum.Material.Metal)
		P(m, "Curtain", Vector3.new(w, h, 0.3), cf * CFrame.new(0, h / 2, 0.2), c, Enum.Material.Fabric)
	elseif shape == "panel" then
		for i = 0, 2 do
			P(m, "Foam", Vector3.new(w / 3 - 0.2, h, 0.6), cf * CFrame.new(-w / 3 + i * w / 3, h / 2 + 1, 0), c, Enum.Material.Fabric)
		end
	elseif shape == "partition" then
		P(m, "Partition", Vector3.new(w, h, d), cf * CFrame.new(0, h / 2, 0), c, Enum.Material.Plaster)
	elseif shape == "neon" then
		P(m, "Stand", Vector3.new(0.3, 4, 0.3), cf * CFrame.new(0, 2, 0), { 30, 30, 34 }, Enum.Material.Metal)
		local sign = P(m, "Neon", Vector3.new(w, h, 0.3), cf * CFrame.new(0, 4 + h / 2, 0), c, Enum.Material.Neon)
		local gui = Instance.new("SurfaceGui")
		gui.Face = Enum.NormalId.Front
		gui.Parent = sign
		local t = Instance.new("TextLabel")
		t.Size = UDim2.fromScale(1, 1)
		t.BackgroundTransparency = 1
		t.TextScaled = true
		t.Font = Enum.Font.GothamBlack
		t.TextColor3 = Color3.new(1, 1, 1)
		t.Text = "ON AIR"
		t.Parent = gui
	elseif shape == "beanbag" then
		P(m, "Bag", Vector3.new(w, w, w), cf * CFrame.new(0, w / 2 - 0.4, 0), c, Enum.Material.Fabric, { Shape = Enum.PartType.Ball })
	elseif shape == "seccam" then
		P(m, "Pole", Vector3.new(0.3, 9, 0.3), cf * CFrame.new(0, 4.5, 0), { 40, 40, 44 }, Enum.Material.Metal)
		local cam = P(m, "Camera", Vector3.new(1, 0.8, 1.4), cf * CFrame.new(0, 9.4, 0), c, Enum.Material.Metal)
		P(m, "Led", Vector3.new(0.2, 0.2, 0.1), cam.CFrame * CFrame.new(0.3, 0.2, -0.72), { 255, 30, 30 }, Enum.Material.Neon)
	elseif shape == "chair" then
		P(m, "Seat", Vector3.new(w, 0.5, d), cf * CFrame.new(0, 1.8, 0), c)
		P(m, "Back", Vector3.new(w, 2.6, 0.4), cf * CFrame.new(0, 3.2, -d / 2 + 0.2), c)
		P(m, "Base", Vector3.new(0.5, 1.6, 0.5), cf * CFrame.new(0, 0.8, 0), { 40, 40, 44 }, Enum.Material.Metal)
	else
		P(m, "Body", Vector3.new(w, h, d), cf * CFrame.new(0, h / 2, 0), c)
	end
	m.Parent = parent
	return m
end

local function slotFor(player)
	for i = 1, 60 do
		if slots[i] == player then
			return i
		end
	end
	for i = 1, 60 do
		if slots[i] == nil then
			slots[i] = player
			return i
		end
	end
	return 60
end

function Property.buildInterior(player, id)
	local data = S.Data.get(player)
	local rec = data.Properties[id]
	local l = PropertyData.ById[id]
	if not rec or not l then
		return nil
	end
	if not folderRoot then
		folderRoot = workspace:FindFirstChild("Interiors") or Instance.new("Folder")
		folderRoot.Name = "Interiors"
		folderRoot.Parent = workspace
	end
	local old = interiors[player]
	if old and old.Model then
		old.Model:Destroy()
	end
	local index = slotFor(player)
	local origin = Vector3.new(-4200 - (index - 1) % 6 * 260, 0, (math.floor((index - 1) / 6)) * 260)
	local base = CFrame.new(origin)
	local m = Instance.new("Model")
	m.Name = "Interior_" .. player.UserId
	local W, D, H = l.W, l.D, Property.WallHeight
	local wall = PropertyData.Walls[rec.Decor.Wall] or PropertyData.Walls[1]
	local floor = PropertyData.Floors[rec.Decor.Floor] or PropertyData.Floors[1]
	local light = PropertyData.Lights[rec.Decor.Light] or PropertyData.Lights[2]
	local isLand = l.Kind == "land"
	P(m, "Floor", Vector3.new(W, 1, D), base * CFrame.new(0, -0.5, 0), isLand and { 90, 150, 80 } or floor[3], isLand and Enum.Material.Grass or Enum.Material[floor[2]])
	if isLand then
		for _, side in ipairs({ { 0, -D / 2, W, 0.5 }, { 0, D / 2, W, 0.5 }, { -W / 2, 0, 0.5, D }, { W / 2, 0, 0.5, D } }) do
			P(m, "Fence", Vector3.new(side[3], 3, side[4]), base * CFrame.new(side[1], 1.5, side[2]), { 240, 240, 240 }, Enum.Material.WoodPlanks)
		end
		P(m, "OuterGround", Vector3.new(W + 200, 1, D + 200), base * CFrame.new(0, -0.6, 0), { 80, 140, 70 }, Enum.Material.Grass)
	else
		P(m, "Ceiling", Vector3.new(W, 1, D), base * CFrame.new(0, H + 0.5, 0), { 245, 245, 245 }, Enum.Material.SmoothPlastic)
		for _, side in ipairs({ { 0, -D / 2, W, 1 }, { 0, D / 2, W, 1 }, { -W / 2, 0, 1, D }, { W / 2, 0, 1, D } }) do
			P(m, "Wall", Vector3.new(side[3], H, side[4]), base * CFrame.new(side[1], H / 2, side[2]), wall[2], Enum.Material.Plaster)
		end
		for i = -1, 1, 2 do
			local lamp = P(m, "CeilingLight", Vector3.new(4, 0.3, 4), base * CFrame.new(i * W / 4, H - 0.2, 0), light[2], Enum.Material.Neon)
			local pl = Instance.new("PointLight")
			pl.Range = math.max(W, D) * 0.7
			pl.Brightness = light[3]
			pl.Color = rgb(light[2])
			pl.Parent = lamp
		end
		-- Ventana con vista
		local win = P(m, "Window", Vector3.new(math.min(16, W - 8), 6, 0.3), base * CFrame.new(0, 7, -D / 2 + 0.7), { 150, 200, 240 }, Enum.Material.Glass, { Transparency = 0.2 })
		local gui = Instance.new("SurfaceGui")
		gui.Face = Enum.NormalId.Back
		gui.Parent = win
		local t = Instance.new("TextLabel")
		t.Size = UDim2.fromScale(1, 1)
		t.BackgroundTransparency = 1
		t.TextScaled = true
		t.Font = Enum.Font.GothamBold
		t.TextColor3 = Color3.fromRGB(255, 255, 255)
		t.TextTransparency = 0.4
		t.Text = l.View or "Vista a la ciudad"
		t.Parent = gui
		if rec.Decor.Curtain then
			P(m, "WindowCurtain", Vector3.new(3, 8, 0.3), base * CFrame.new(-math.min(16, W - 8) / 2 - 1.5, 7, -D / 2 + 1), { 140, 30, 50 }, Enum.Material.Fabric)
			P(m, "WindowCurtain", Vector3.new(3, 8, 0.3), base * CFrame.new(math.min(16, W - 8) / 2 + 1.5, 7, -D / 2 + 1), { 140, 30, 50 }, Enum.Material.Fabric)
		end
	end
	if l.Pool then
		local pool = P(m, "Pool", Vector3.new(W * 0.35, 0.4, D * 0.25), base * CFrame.new(W * 0.25, 0.05, D * 0.25), { 60, 180, 230 }, Enum.Material.Glass, { Transparency = 0.2, NoCollide = true })
		pool.Name = "Pool"
	end
	-- Puerta de salida
	local door = P(m, "ExitDoor", Vector3.new(6, 9, 0.6), base * CFrame.new(0, 4.5, D / 2 - 0.6), { 90, 60, 40 }, Enum.Material.Wood)
	addPrompt(door, "prop_exit", "Salir", l.Name)
	-- Puesto de trabajo y vestidor (viviendas, estudios y negocios)
	if l.Kind ~= "garage" and l.Kind ~= "land" then
		local deskCF = base * CFrame.new(-W / 2 + 6, 3.4, -D / 2 + 4)
		P(m, "Workdesk", Vector3.new(8, 0.5, 4), deskCF, { 120, 85, 60 }, Enum.Material.WoodPlanks)
		P(m, "Monitor", Vector3.new(3.2, 2, 0.25), deskCF * CFrame.new(0, 1.4, -1.2), { 20, 20, 24 })
		P(m, "Screen", Vector3.new(3, 1.8, 0.05), deskCF * CFrame.new(0, 1.4, -1.05), { 70, 140, 255 }, Enum.Material.Neon)
		local anchor = P(m, "DeskAnchor", Vector3.new(8, 4, 4), deskCF * CFrame.new(0, -1.5, 0), { 0, 0, 0 }, nil, { Transparency = 1, NoCollide = true })
		addPrompt(anchor, "computer_home", "Usar computador", l.Name, { Owner = player.UserId })
		local kitchen = P(m, "Kitchen", Vector3.new(8, 4, 3), base * CFrame.new(W / 2 - 6, 2, D / 2 - 3), { 230, 230, 235 }, Enum.Material.Marble)
		addPrompt(kitchen, "cook", "Cocinar", "Cocina")
		local sofa = P(m, "RestSpot", Vector3.new(7, 1.5, 3), base * CFrame.new(-W / 2 + 5, 0.75, D / 2 - 4), { 90, 90, 110 }, Enum.Material.Fabric)
		addPrompt(sofa, "rest", "Descansar", "Sofá cama")
		local wardrobe = P(m, "Wardrobe", Vector3.new(2, 8, 5), base * CFrame.new(W / 2 - 1.6, 4, -D / 2 + 5), { 160, 120, 90 }, Enum.Material.WoodPlanks)
		addPrompt(wardrobe, "wardrobe", "Vestidor", "Cambiar estilo", { Owner = player.UserId })
	end
	-- Muebles colocados
	local furn = Instance.new("Folder")
	furn.Name = "Furniture"
	furn.Parent = m
	for uid, pos in pairs(rec.Placed) do
		local item = data.Inventory[uid]
		local def = item and Catalog.get(item.Id)
		if def then
			Property.furnitureModel(furn, def, base * CFrame.new(pos.X, 0, pos.Z) * CFrame.Angles(0, math.rad(pos.R or 0), 0), uid)
		end
	end
	m.Parent = folderRoot
	interiors[player] = { Id = id, Origin = origin, Model = m, W = W, D = D }
	S.Data.markDirty(player)
	return origin
end

function Property.enterCFrame(player, id)
	local origin = Property.buildInterior(player, id)
	if not origin then
		return nil
	end
	local l = PropertyData.ById[id]
	return CFrame.new(origin + Vector3.new(0, 3, l.D / 2 - 5))
end

---------------------------------------------------------------------------
-- Pagos periódicos
---------------------------------------------------------------------------
local function releaseFurniture(data, id)
	local rec = data.Properties[id]
	for uid in pairs(rec.Placed) do
		if data.Inventory[uid] then
			data.Inventory[uid].Loc = "home"
		end
	end
	rec.Placed = {}
end

function Property.onNewDay(player)
	local data = S.Data.get(player)
	if not data then
		return
	end
	local day = data.Home.PlayDays
	for id, rec in pairs(data.Properties) do
		local l = PropertyData.ById[id]
		if l and day >= rec.NextDue then
			rec.NextDue = day + Config.RentPeriodDays
			local amount = rec.Mode == "rent" and l.Rent or l.Upkeep
			local label = (rec.Mode == "rent" and "Alquiler de " or "Mantenimiento de ") .. l.Name
			if amount > 0 and S.Economy.spend(player, amount, rec.Mode == "rent" and "Alquiler" or "Mantenimiento", label) then
				rec.Missed = 0
			elseif amount > 0 then
				local fee = math.floor(amount * Config.LateFeeRate + 0.5)
				rec.Debt = rec.Debt + amount + fee
				rec.Missed = rec.Missed + 1
				S.Net.notify(player, "⚠️ Impago: " .. label .. ". Deuda $" .. rec.Debt .. ". Págala en la app Inmobiliaria.", "warn")
				if rec.Mode == "rent" and rec.Missed >= 3 then
					releaseFurniture(data, id)
					data.Properties[id] = nil
					if data.HomeProperty == id then
						data.HomeProperty = ""
					end
					S.Net.notify(player, "📄 Contrato de «" .. l.Name .. "» rescindido por impago. Tus muebles están en tu inventario.", "error")
				end
			end
		end
	end
	S.Data.markDirty(player)
end

---------------------------------------------------------------------------
-- Validación de colocación
---------------------------------------------------------------------------
local function footprint(def, r)
	local f = def.Foot or { 4, 4, 3 }
	local w, d = f[1], f[2]
	if math.floor((r or 0) / 90) % 2 == 1 then
		w, d = d, w
	end
	return w, d
end

local function overlaps(data, rec, uid, def, x, z, r)
	local w, d = footprint(def, r)
	if def.Shape == "rug" then
		return false
	end
	for other, pos in pairs(rec.Placed) do
		if other ~= uid then
			local item = data.Inventory[other]
			local odef = item and Catalog.get(item.Id)
			if odef and odef.Shape ~= "rug" then
				local ow, od = footprint(odef, pos.R)
				if math.abs(x - pos.X) * 2 < (w + ow) - 0.2 and math.abs(z - pos.Z) * 2 < (d + od) - 0.2 then
					return true
				end
			end
		end
	end
	return false
end

local function placeValid(player, id, uid, x, z, r)
	local data = S.Data.get(player)
	local rec = data.Properties[id]
	local l = PropertyData.ById[id]
	local item = data.Inventory[uid]
	local def = item and Catalog.get(item.Id)
	if not def or not def.Placeable then
		return "Ese objeto no se puede colocar."
	end
	local w, d = footprint(def, r)
	if math.abs(x) + w / 2 > l.W / 2 - 0.5 or math.abs(z) + d / 2 > l.D / 2 - 0.5 then
		return "No cabe ahí: queda fuera de la sala."
	end
	-- dejar libre la puerta y el puesto de trabajo
	if math.abs(x) < 5 and z > l.D / 2 - 6 then
		return "No bloquees la puerta."
	end
	if l.Kind ~= "garage" and l.Kind ~= "land" and x < -l.W / 2 + 12 and z < -l.D / 2 + 8 then
		return "Ese espacio es el puesto de trabajo."
	end
	if overlaps(data, rec, uid, def, x, z, r) then
		return "Choca con otro mueble."
	end
	return nil
end

local function insideOwn(player)
	local id = Property.inside(player)
	if not id then
		return nil, "Entra en tu propiedad para usar el modo construcción."
	end
	return id
end

---------------------------------------------------------------------------
-- Acciones
---------------------------------------------------------------------------
local function newRecord(mode, day)
	return { Mode = mode, Since = os.time(), NextDue = day + Config.RentPeriodDays, Debt = 0, Missed = 0, Deposit = 0,
		Decor = { Wall = 1, Floor = 1, Light = 2, Curtain = false }, Placed = {}, Upgrades = {}, Presets = {}, Spent = 0 }
end

local function checkReq(data, l)
	if data.Level < (l.Req.Level or 1) then
		return "Necesitas nivel " .. l.Req.Level .. "."
	end
	if data.Channel.Subs < (l.Req.Subs or 0) then
		return "Necesitas " .. Util.formatInt(l.Req.Subs) .. " suscriptores."
	end
	return nil
end

local function totalDebt(data)
	local n = 0
	for _, rec in pairs(data.Properties) do
		n = n + rec.Debt
	end
	return n
end

function Property.exteriorOf(id)
	local l = PropertyData.ById[id]
	return l and Property.signPosition(l) + Vector3.new(0, 3, -6) or nil
end

function Property.Start()
	local Net = S.Net

	Net.on("Prop.Rent", function(player, p)
		local data = S.Data.get(player)
		local l = PropertyData.ById[p.id or ""]
		if not l or not l.Rent then
			return false, "Esta propiedad no se alquila."
		end
		if held(data, l.Id) then
			return false, "Ya tienes esta propiedad."
		end
		local err = checkReq(data, l)
		if err then
			return false, err
		end
		if Property.count(data) >= PropertyData.maxProperties(data.Level) then
			return false, "Has alcanzado el máximo de propiedades para tu nivel (" .. PropertyData.maxProperties(data.Level) .. ")."
		end
		if totalDebt(data) > 0 then
			return false, "Paga primero tus deudas inmobiliarias."
		end
		local cost = l.Rent * 2
		if not S.Economy.spend(player, cost, "Alquiler", "Contrato de alquiler: " .. l.Name .. " (semana + fianza)") then
			return false, "Necesitas $" .. Util.formatInt(cost) .. " (primera semana + fianza)."
		end
		local rec = newRecord("rent", data.Home.PlayDays)
		rec.Deposit = l.Rent
		data.Properties[l.Id] = rec
		if (l.Kind == "home" or l.Kind == "studio") and data.HomeProperty == "" then
			data.HomeProperty = l.Id
		end
		data.Counters.rentals = (data.Counters.rentals or 0) + 1
		S.Quest.check(player)
		return true, "📄 Contrato firmado: " .. l.Name .. ". Alquiler $" .. l.Rent .. " cada 7 días jugados; fianza $" .. l.Rent .. " (se devuelve al terminar sin deudas)."
	end)

	Net.on("Prop.Buy", function(player, p)
		local data = S.Data.get(player)
		local l = PropertyData.ById[p.id or ""]
		if not l or not l.Buy then
			return false, "Esta propiedad no está a la venta."
		end
		local current = held(data, l.Id)
		if current and current.Mode == "own" then
			return false, "Ya es tuya."
		end
		local err = checkReq(data, l)
		if err then
			return false, err
		end
		if not current and Property.count(data) >= PropertyData.maxProperties(data.Level) then
			return false, "Has alcanzado el máximo de propiedades para tu nivel (" .. PropertyData.maxProperties(data.Level) .. ")."
		end
		if totalDebt(data) > 0 then
			return false, "Paga primero tus deudas inmobiliarias."
		end
		if not S.Economy.spend(player, l.Buy, "Inmuebles", "Compra de " .. l.Name) then
			return false, "Necesitas $" .. Util.formatInt(l.Buy) .. ". Puedes alquilarla mientras ahorras."
		end
		if current then
			-- de alquiler a propiedad: se devuelve la fianza
			if current.Deposit > 0 then
				S.Economy.add(player, current.Deposit, "Fianzas", "Devolución de fianza de " .. l.Name, {})
			end
			current.Mode = "own"
			current.Deposit = 0
		else
			data.Properties[l.Id] = newRecord("own", data.Home.PlayDays)
			if (l.Kind == "home" or l.Kind == "studio") and data.HomeProperty == "" then
				data.HomeProperty = l.Id
			end
		end
		data.Counters.properties_bought = (data.Counters.properties_bought or 0) + 1
		S.Quest.check(player)
		return true, "🔑 ¡" .. l.Name .. " es tuya! Mantenimiento: $" .. l.Upkeep .. " cada 7 días."
	end)

	Net.on("Prop.EndRent", function(player, p)
		local data = S.Data.get(player)
		local rec = held(data, p.id or "")
		local l = PropertyData.ById[p.id or ""]
		if not rec or rec.Mode ~= "rent" then
			return false, "No tienes un alquiler aquí."
		end
		if Property.inside(player) == p.id then
			return false, "Sal de la propiedad antes de terminar el contrato."
		end
		local back = rec.Deposit - rec.Debt
		releaseFurniture(data, p.id)
		data.Properties[p.id] = nil
		if data.HomeProperty == p.id then
			data.HomeProperty = ""
		end
		if back > 0 then
			S.Economy.add(player, back, "Fianzas", "Devolución de fianza de " .. l.Name, {})
		elseif back < 0 then
			S.Economy.spend(player, math.min(-back, data.Money), "Alquiler", "Deuda pendiente de " .. l.Name)
		end
		return true, "Contrato terminado. Muebles devueltos a tu inventario." .. (back > 0 and (" Fianza devuelta: $" .. back) or "")
	end)

	Net.on("Prop.Sell", function(player, p)
		local data = S.Data.get(player)
		local rec = held(data, p.id or "")
		local l = PropertyData.ById[p.id or ""]
		if not rec or rec.Mode ~= "own" then
			return false, "No eres propietario de esta propiedad."
		end
		if Property.inside(player) == p.id then
			return false, "Sal de la propiedad antes de venderla."
		end
		local value = math.floor(l.Buy * l.Resale + (rec.Spent or 0) * 0.5 - rec.Debt)
		releaseFurniture(data, p.id)
		data.Properties[p.id] = nil
		if data.HomeProperty == p.id then
			data.HomeProperty = ""
		end
		S.Economy.add(player, math.max(0, value), "Inmuebles", "Venta de " .. l.Name, {})
		return true, "Vendiste " .. l.Name .. " por $" .. Util.formatInt(math.max(0, value)) .. "."
	end)

	Net.on("Prop.PayDebt", function(player, p)
		local data = S.Data.get(player)
		local rec = held(data, p.id or "")
		if not rec or rec.Debt <= 0 then
			return false, "No hay deuda en esta propiedad."
		end
		if not S.Economy.spend(player, rec.Debt, "Alquiler", "Pago de deuda inmobiliaria") then
			return false, "Necesitas $" .. Util.formatInt(rec.Debt) .. "."
		end
		rec.Debt = 0
		rec.Missed = 0
		return true, "Deuda pagada."
	end)

	Net.on("Prop.MoveIn", function(player, p)
		local data = S.Data.get(player)
		local id = p.id or ""
		if id == "" then
			data.HomeProperty = ""
			return true, "Vuelves a vivir en la Residencia Económica."
		end
		local l = PropertyData.ById[id]
		if not held(data, id) or (l.Kind ~= "home" and l.Kind ~= "studio") then
			return false, "Solo puedes vivir en viviendas o estudios que tengas."
		end
		data.HomeProperty = id
		return true, "🏠 Ahora vives en " .. l.Name .. ". Aparecerás aquí al entrar al juego."
	end)

	Net.on("Prop.Enter", function(player, p)
		local data = S.Data.get(player)
		local id = p.id or ""
		if not held(data, id) then
			return false, "No tienes acceso a esta propiedad."
		end
		local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		local ext = Property.exteriorOf(id)
		if not root or (root.Position - ext).Magnitude > 30 then
			return false, "Ve a la entrada de la propiedad (usa el taxi de la app Inmobiliaria)."
		end
		local cf = Property.enterCFrame(player, id)
		S.Travel.teleport(player, cf.Position)
		S.Quest.tutorialEvent(player, "enter_home")
		return true
	end)

	Net.on("Prop.Exit", function(player)
		local id = Property.inside(player)
		if not id then
			return false, "No estás dentro de una propiedad."
		end
		S.Travel.teleport(player, Property.exteriorOf(id))
		return true
	end)

	Net.on("Prop.Go", function(player, p)
		local l = PropertyData.ById[p.id or ""]
		if not l then
			return false, "Propiedad no encontrada."
		end
		return S.Travel.taxiTo(player, Property.exteriorOf(l.Id), l.Name)
	end)

	-- Modo construcción
	Net.on("Prop.Place", function(player, p)
		local data = S.Data.get(player)
		local id, err = insideOwn(player)
		if not id then
			return false, err
		end
		local rec = data.Properties[id]
		local l = PropertyData.ById[id]
		local item = data.Inventory[p.uid or ""]
		if not item then
			return false, "No tienes ese objeto."
		end
		local already = rec.Placed[p.uid] ~= nil
		if not already and item.Loc ~= "home" then
			return false, "El objeto debe estar en casa (no en la mochila ni en otra propiedad)."
		end
		if not already and Util.count(rec.Placed) >= l.Slots then
			return false, "No hay más espacio para muebles aquí (" .. l.Slots .. ")."
		end
		local x, z = tonumber(p.x), tonumber(p.z)
		local r = math.floor((tonumber(p.r) or 0) / 90 + 0.5) % 4 * 90
		if not x or not z or x ~= x or z ~= z then
			return false, "Posición no válida."
		end
		x = math.floor(x * 2 + 0.5) / 2
		z = math.floor(z * 2 + 0.5) / 2
		local verr = placeValid(player, id, p.uid, x, z, r)
		if verr then
			return false, verr
		end
		rec.Placed[p.uid] = { X = x, Z = z, R = r }
		item.Loc = "prop:" .. id
		if not already then
			data.Counters.furniture_placed = (data.Counters.furniture_placed or 0) + 1
		end
		data.Counters.decor_max = math.max(data.Counters.decor_max or 0, math.floor(Property.decorScore(player, id)))
		S.Events.onDecor(player, Property.decorScore(player, id))
		Property.buildInterior(player, id)
		S.Quest.check(player)
		return true, (already and "Mueble movido." or "Mueble colocado.") .. " Decoración: " .. Property.decorScore(player, id) .. "/45"
	end)

	Net.on("Prop.Pick", function(player, p)
		local data = S.Data.get(player)
		local id, err = insideOwn(player)
		if not id then
			return false, err
		end
		local rec = data.Properties[id]
		if not rec.Placed[p.uid or ""] then
			return false, "Ese mueble no está colocado aquí."
		end
		rec.Placed[p.uid] = nil
		if data.Inventory[p.uid] then
			data.Inventory[p.uid].Loc = "home"
		end
		Property.buildInterior(player, id)
		return true, "Mueble guardado en el inventario."
	end)

	Net.on("Prop.Rotate", function(player, p)
		local data = S.Data.get(player)
		local id, err = insideOwn(player)
		if not id then
			return false, err
		end
		local pos = data.Properties[id].Placed[p.uid or ""]
		if not pos then
			return false, "Ese mueble no está colocado aquí."
		end
		local r = (pos.R + 90) % 360
		local verr = placeValid(player, id, p.uid, pos.X, pos.Z, r)
		if verr then
			return false, "No se puede girar: " .. verr
		end
		pos.R = r
		Property.buildInterior(player, id)
		return true
	end)

	Net.on("Prop.Decor", function(player, p)
		local data = S.Data.get(player)
		local id, err = insideOwn(player)
		if not id then
			return false, err
		end
		local rec = data.Properties[id]
		local l = PropertyData.ById[id]
		local d = rec.Decor
		local cost, changed = 0, {}
		local function setIdx(key, list, value)
			local v = tonumber(value)
			if v and list[v] and d[key] ~= v then
				d[key] = v
				cost = cost + 50
				changed[#changed + 1] = key
			end
		end
		if p.style then
			local st = PropertyData.StyleById[p.style]
			if not st then
				return false, "Estilo no válido."
			end
			if not l.Remodel then
				return false, "En esta propiedad no se permite remodelar (solo la luz y las cortinas)."
			end
			local before = Util.deepCopy(d)
			d.Wall, d.Floor, d.Light = st.Wall, st.Floor, st.Light
			cost = 120
			if not S.Economy.spend(player, cost, "Remodelación", "Estilo " .. st.Name .. " en " .. l.Name) then
				rec.Decor = before
				return false, "Aplicar un estilo cuesta $" .. cost .. "."
			end
		else
			if (p.wall or p.floor) and not l.Remodel then
				return false, "En esta propiedad no se permite cambiar paredes ni suelos."
			end
			local before = Util.deepCopy(d)
			setIdx("Wall", PropertyData.Walls, p.wall)
			setIdx("Floor", PropertyData.Floors, p.floor)
			setIdx("Light", PropertyData.Lights, p.light)
			if p.curtain ~= nil and (p.curtain == true) ~= d.Curtain then
				d.Curtain = p.curtain == true
				cost = cost + 50
			end
			if cost == 0 then
				return false, "No hay cambios."
			end
			if not S.Economy.spend(player, cost, "Remodelación", "Decoración de " .. l.Name) then
				rec.Decor = before
				return false, "Cuesta $" .. cost .. "."
			end
		end
		rec.Spent = (rec.Spent or 0) + cost
		data.Counters.remodels = (data.Counters.remodels or 0) + 1
		data.Counters.decor_max = math.max(data.Counters.decor_max or 0, math.floor(Property.decorScore(player, id)))
		S.Events.onDecor(player, Property.decorScore(player, id))
		Property.buildInterior(player, id)
		S.Quest.check(player)
		return true, "Remodelación hecha ($" .. cost .. "). Decoración: " .. Property.decorScore(player, id) .. "/45"
	end)

	Net.on("Prop.Upgrade", function(player, p)
		local data = S.Data.get(player)
		local id = p.id or ""
		local rec = held(data, id)
		local up = PropertyData.Upgrades[p.key or ""]
		if not rec or not up then
			return false, "Mejora no válida."
		end
		if rec.Mode ~= "own" and p.key ~= "lightrig" then
			return false, "En un alquiler solo puedes instalar el rig de iluminación (es desmontable)."
		end
		if rec.Upgrades[p.key] then
			return false, "Ya está instalada."
		end
		if not S.Economy.spend(player, up.Cost, "Mejoras", up.Name .. " en " .. PropertyData.ById[id].Name) then
			return false, "Cuesta $" .. Util.formatInt(up.Cost) .. "."
		end
		rec.Upgrades[p.key] = true
		rec.Spent = (rec.Spent or 0) + up.Cost
		if interiors[player] and interiors[player].Id == id then
			Property.buildInterior(player, id)
		end
		return true, "Mejora instalada: " .. up.Name .. "."
	end)

	Net.on("Prop.SavePreset", function(player, p)
		local data = S.Data.get(player)
		local id, err = insideOwn(player)
		if not id then
			return false, err
		end
		local rec = data.Properties[id]
		local name = Util.cleanText(p.name or "", 24) or ""
		if #name == 0 then
			name = "Diseño " .. (#rec.Presets + 1)
		end
		name = S.Text.filter(player, name) or ("Diseño " .. (#rec.Presets + 1))
		if #rec.Presets >= 3 then
			table.remove(rec.Presets, 1)
		end
		table.insert(rec.Presets, { Name = name, Layout = Util.deepCopy(rec.Placed), Decor = Util.deepCopy(rec.Decor) })
		return true, "Diseño «" .. name .. "» guardado."
	end)

	Net.on("Prop.LoadPreset", function(player, p)
		local data = S.Data.get(player)
		local id, err = insideOwn(player)
		if not id then
			return false, err
		end
		local rec = data.Properties[id]
		local preset = rec.Presets[tonumber(p.index) or 0]
		if not preset then
			return false, "Diseño no encontrado."
		end
		-- recoger todo y volver a colocar lo que siga disponible
		releaseFurniture(data, id)
		local placed, skipped = 0, 0
		for uid, pos in pairs(preset.Layout) do
			local item = data.Inventory[uid]
			if item and item.Loc == "home" and not placeValid(player, id, uid, pos.X, pos.Z, pos.R) then
				rec.Placed[uid] = { X = pos.X, Z = pos.Z, R = pos.R }
				item.Loc = "prop:" .. id
				placed = placed + 1
			else
				skipped = skipped + 1
			end
		end
		Property.buildInterior(player, id)
		return true, "Diseño aplicado: " .. placed .. " muebles colocados" .. (skipped > 0 and (", " .. skipped .. " no disponibles") or "") .. "."
	end)

	Players.PlayerRemoving:Connect(function(player)
		local it = interiors[player]
		if it and it.Model then
			it.Model:Destroy()
		end
		interiors[player] = nil
		for i = 1, 60 do
			if slots[i] == player then
				slots[i] = nil
			end
		end
	end)
end

return Property
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000050"><Properties><string name="Name">QuestService</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- QuestService: tutorial guiado (eventos) + logros (contadores).
--  * Un logro se marca completado una vez y su recompensa se cobra una sola vez (Claimed).
--  * Los pasos del tutorial se pueden saltar; los saltados no dan recompensa.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage.Shared
local QuestDefs = require(Shared.QuestDefs)
local Util = require(Shared.Util)
local FriendData = require(Shared.FriendData)

local Quest = {}
local S

function Quest.Init(services)
	S = services
end

-- Valor actual de un contador de logros
function Quest.valueOf(data, key)
	if key == "subs" then
		return data.Channel.Subs
	elseif key == "total_views" then
		return data.Channel.TotalViews
	elseif key == "revenue" then
		return data.Channel.TotalRevenue
	elseif key == "level" then
		return data.Level
	elseif key == "districts_visited" then
		return Util.count(data.Visited.Districts)
	elseif key == "districts_recorded" then
		return Util.count(data.Visited.Recorded)
	elseif key == "stores_visited" then
		return Util.count(data.Visited.Stores)
	elseif key == "categories_published" then
		return Util.count(data.Visited.Categories)
	elseif key == "secrets_found" then
		return Util.count(data.Visited.Secrets)
	elseif key == "cameras_owned" then
		return Util.count(data.Visited.Cameras)
	elseif key == "collectibles" then
		return Util.count(data.Visited.Collectibles or {})
	elseif key == "destinations_visited" then
		return Util.count(data.Visited.Destinations)
	elseif key == "friends_made" then
		local n = 0
		for _, f in pairs(data.Friends or {}) do
			if FriendData.levelOf(f.Pts) >= 3 then
				n = n + 1
			end
		end
		return n
	elseif key == "properties_owned" then
		local n = 0
		for _, rec in pairs(data.Properties or {}) do
			if rec.Mode == "own" then
				n = n + 1
			end
		end
		return n
	end
	return data.Counters[key] or 0
end

function Quest.check(player)
	local data = S.Data.get(player)
	if not data then
		return
	end
	local q = data.Quests
	for _, a in ipairs(QuestDefs.Achievements) do
		if not q.Completed[a.Id] and Quest.valueOf(data, a.Counter) >= a.Target then
			q.Completed[a.Id] = os.time()
			S.Net.push(player, "achievement", { id = a.Id, name = a.Name })
		end
	end
	S.Data.markDirty(player)
end

local function grant(player, reward, why)
	local data = S.Data.get(player)
	if reward.Money and reward.Money > 0 then
		S.Economy.add(player, reward.Money, "Recompensas", why, {})
	end
	if reward.Xp and reward.Xp > 0 then
		S.Progress.addXp(player, reward.Xp)
	end
	if reward.Title then
		data.Titles[reward.Title] = true
		S.Net.notify(player, "🏷 Nuevo título desbloqueado: «" .. reward.Title .. "»", "success")
	end
end

function Quest.tutorialEvent(player, event)
	local data = S.Data.get(player)
	if not data then
		return
	end
	local q = data.Quests
	if q.Skipped then
		return
	end
	local step = QuestDefs.Tutorial[q.Step]
	if not step or step.Event ~= event then
		return
	end
	q.StepProgress = q.StepProgress + 1
	if q.StepProgress >= (step.Target or 1) then
		q.Step = q.Step + 1
		q.StepProgress = 0
		grant(player, step.Reward, "Tutorial: " .. step.Name)
		local nxt = QuestDefs.Tutorial[q.Step]
		S.Net.push(player, "tutorial", { done = step.Name, next = nxt and nxt.Name or nil, finished = nxt == nil })
		if not nxt then
			S.Net.notify(player, "🎓 ¡Tutorial completado! El mundo es tuyo: elige tu propio camino.", "success")
		end
	end
	S.Data.markDirty(player)
end

function Quest.Start()
	local Net = S.Net

	Net.on("Quest.Claim", function(player, p)
		local data = S.Data.get(player)
		local def = QuestDefs.ById[p.id or ""]
		if not def or not def.Counter then
			return false, "Logro no encontrado."
		end
		if not data.Quests.Completed[def.Id] then
			return false, "Aún no has completado este logro."
		end
		if data.Quests.Claimed[def.Id] then
			return false, "Ya cobraste esta recompensa."
		end
		data.Quests.Claimed[def.Id] = os.time()
		grant(player, def.Reward, "Logro: " .. def.Name)
		Quest.tutorialEvent(player, "claim_reward")
		return true, "Recompensa cobrada: $" .. Util.formatInt(def.Reward.Money) .. " y " .. def.Reward.Xp .. " XP."
	end)

	Net.on("Quest.ClaimAll", function(player)
		local data = S.Data.get(player)
		local n = 0
		for _, def in ipairs(QuestDefs.Achievements) do
			if data.Quests.Completed[def.Id] and not data.Quests.Claimed[def.Id] then
				data.Quests.Claimed[def.Id] = os.time()
				grant(player, def.Reward, "Logro: " .. def.Name)
				n = n + 1
			end
		end
		if n == 0 then
			return false, "No hay recompensas pendientes."
		end
		Quest.tutorialEvent(player, "claim_reward")
		return true, n .. " recompensas cobradas."
	end)

	Net.on("Phone.Opened", function(player)
		Quest.tutorialEvent(player, "open_phone")
		return true
	end)

	Net.on("Quest.SkipTutorial", function(player)
		local data = S.Data.get(player)
		data.Quests.Skipped = true
		return true, "Tutorial omitido. Puedes ver las misiones en cualquier momento (tecla M)."
	end)

	Net.on("Quest.SkipStep", function(player)
		local data = S.Data.get(player)
		local q = data.Quests
		if QuestDefs.Tutorial[q.Step] then
			q.Step = q.Step + 1
			q.StepProgress = 0
			return true, "Paso saltado (sin recompensa)."
		end
		return false, "No hay paso que saltar."
	end)

	Net.on("Quest.RestartTutorial", function(player)
		local data = S.Data.get(player)
		-- Reactivar las explicaciones no vuelve a dar recompensas de pasos ya completados
		data.Quests.Skipped = false
		return true, "Explicaciones del tutorial reactivadas."
	end)

	Net.on("Title.Equip", function(player, p)
		local data = S.Data.get(player)
		if p.title ~= "" and not data.Titles[p.title or ""] then
			return false, "No tienes ese título."
		end
		data.EquippedTitle = p.title or ""
		S.Avatar.refreshOverhead(player)
		return true, p.title == "" and "Título quitado." or ("Título «" .. p.title .. "» equipado.")
	end)
end

return Quest
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000051"><Properties><string name="Name">ShopService</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- ShopService: compras en tiendas físicas y online.
--  * Física: hay que estar dentro de la tienda que vende el objeto. Entrega inmediata (mochila o casa).
--  * Online: carrito, cobro único por pedido, entrega simulada, cancelación con reembolso.
--  * Cada petición de compra lleva un "nonce": si se repite (doble clic, reintento) no se cobra dos veces.
--  * Los PC completos se entregan como un montaje real de piezas (se pueden desmontar).

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Catalog = require(Shared.ItemCatalog)
local Util = require(Shared.Util)

local Shop = {}
local S

Shop.StoreRadius = 45

function Shop.Init(services)
	S = services
end

local function rememberNonce(data, nonce, result)
	data.Processed[nonce] = result
	table.insert(data.ProcessedOrder, nonce)
	while #data.ProcessedOrder > 40 do
		local old = table.remove(data.ProcessedOrder, 1)
		data.Processed[old] = nil
	end
end

local function validNonce(nonce)
	return type(nonce) == "string" and #nonce >= 6 and #nonce <= 40
end

function Shop.storeNear(player)
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if not root then
		return nil
	end
	for _, sp in ipairs(S.World.Specials) do
		if sp.Type == "store" then
			local dx, dz = root.Position.X - sp.WX, root.Position.Z - sp.WZ
			if dx * dx + dz * dz <= Shop.StoreRadius * Shop.StoreRadius then
				return sp.StoreId
			end
		end
	end
	return nil
end

function Shop.priceOf(player, def)
	local mult = S.Events and S.Events.priceMultiplier and S.Events.priceMultiplier(def) or 1
	if S.Friend and S.Friend.discountFor then
		mult = mult * (1 - S.Friend.discountFor(player, def))
	end
	return math.floor(def.Price * mult + 0.5)
end

-- Entrega un objeto (o un PC completo como montaje de piezas). Devuelve texto de destino.
function Shop.deliver(player, def, opts)
	if def.Cat == "pc" then
		local rigId = S.Computer.createRigFromPrebuilt(player, def, opts)
		return rigId and "tu casa (montado)" or nil
	end
	local uid, loc = S.Inventory.add(player, def.Id, opts)
	if not uid then
		return nil
	end
	return loc == "backpack" and "tu mochila" or "tu casa"
end

local function units(def, qty)
	if def.Parts then
		local n = 0
		for _, v in pairs(def.Parts) do
			n = n + (type(v) == "table" and #v or 1)
		end
		return n * qty
	end
	return qty
end

local function storageError(player, n)
	if not S.Property.canStore(player, n) then
		return "Tu vivienda está llena (" .. S.Property.storedCount(player) .. "/" .. S.Property.storageCap(player) .. " objetos). Vende algo o consigue una propiedad con más almacenaje."
	end
	return nil
end

local function checkBuyable(player, def, qty)
	local data = S.Data.get(player)
	if not def or not Catalog.isForSale(def.Id) then
		return "Ese producto no está a la venta."
	end
	if data.Level < (def.Req.Level or 1) then
		return "Necesitas nivel " .. def.Req.Level .. " para comprar " .. def.Name .. "."
	end
	if qty < 1 or qty > 10 then
		return "Cantidad no válida (1-10)."
	end
	return nil
end

function Shop.afterPurchase(player, n, total)
	local data = S.Data.get(player)
	data.Counters.items_bought = (data.Counters.items_bought or 0) + n
	data.Counters.money_spent = (data.Counters.money_spent or 0) + total
	S.Progress.addXp(player, S.Progress.Xp.Purchase * math.min(n, 5))
	S.Quest.tutorialEvent(player, "buy_item")
	S.Quest.check(player)
end

-- Entregas pendientes de pedidos online
function Shop.processOrders(player)
	local data = S.Data.get(player)
	if not data then
		return
	end
	local now = os.time()
	for _, order in ipairs(data.Orders) do
		if order.Status == "En camino" and now >= order.Eta then
			order.Status = "Entregado"
			order.DeliveredAt = now
			for _, line in ipairs(order.Items) do
				local def = Catalog.get(line.Id)
				for _ = 1, line.Qty do
					Shop.deliver(player, def, { src = "online", paid = line.Unit, loc = "home" })
				end
			end
			S.Net.notify(player, "📦 Pedido #" .. order.Num .. " entregado en tu casa.", "success")
			S.Data.markDirty(player)
		end
	end
end

function Shop.Start()
	local Net = S.Net

	-- Compra en tienda física
	Net.on("Shop.BuyInStore", function(player, p)
		local data = S.Data.get(player)
		if not validNonce(p.nonce) then
			return false, "Petición de compra no válida."
		end
		if data.Processed[p.nonce] then
			return true, "Compra ya registrada (no se ha cobrado dos veces).", data.Processed[p.nonce]
		end
		local def = Catalog.get(p.itemId)
		local qty = math.floor(tonumber(p.qty) or 1)
		local err = checkBuyable(player, def, qty)
		if err then
			return false, err
		end
		local storeId = Shop.storeNear(player)
		if not storeId then
			return false, "Tienes que estar dentro de una tienda. También puedes pedirlo online desde la app Tienda."
		end
		if not Util.indexOf(def.Stores, storeId) then
			return false, "Esta tienda no vende " .. def.Name .. "."
		end
		local serr = storageError(player, units(def, qty))
		if serr then
			return false, serr
		end
		local unit = Shop.priceOf(player, def)
		local total = unit * qty
		if not S.Economy.spend(player, total, "Compras", def.Name .. (qty > 1 and (" x" .. qty) or "")) then
			return false, "No tienes suficiente dinero ($" .. Util.formatInt(total) .. ")."
		end
		local where
		for _ = 1, qty do
			where = Shop.deliver(player, def, { src = "shop", paid = unit, loc = "backpack" })
		end
		local result = { itemId = def.Id, qty = qty, total = total }
		rememberNonce(data, p.nonce, result)
		Shop.afterPurchase(player, qty, total)
		return true, "Compraste " .. def.Name .. " por $" .. Util.formatInt(total) .. ". Está en " .. tostring(where) .. ".", result
	end)

	-- Pedido online (carrito)
	Net.on("Shop.Checkout", function(player, p)
		local data = S.Data.get(player)
		if not validNonce(p.nonce) then
			return false, "Petición de compra no válida."
		end
		if data.Processed[p.nonce] then
			return true, "Pedido ya registrado (no se ha cobrado dos veces).", data.Processed[p.nonce]
		end
		if data.Home.Missed >= 2 then
			return false, "Tienes alquileres pendientes. Págalos en la app Banco antes de hacer pedidos online."
		end
		if type(p.items) ~= "table" or #p.items == 0 or #p.items > 20 then
			return false, "El carrito está vacío o es demasiado grande."
		end
		local lines, total, count = {}, 0, 0
		for _, line in ipairs(p.items) do
			local def = Catalog.get(type(line) == "table" and line.id or nil)
			local qty = math.floor(tonumber(type(line) == "table" and line.qty or 0) or 0)
			local err = checkBuyable(player, def, qty)
			if err then
				return false, err
			end
			local unit = Shop.priceOf(player, def)
			lines[#lines + 1] = { Id = def.Id, Qty = qty, Unit = unit }
			total = total + unit * qty
			count = count + units(def, qty)
		end
		local serr = storageError(player, count)
		if serr then
			return false, serr
		end
		local shipping = total >= 500 and 0 or 15
		total = total + shipping
		if not S.Economy.spend(player, total, "Compras online", "Pedido online (" .. count .. " artículos)") then
			return false, "No tienes suficiente dinero ($" .. Util.formatInt(total) .. ")."
		end
		data.Counters.order_num = (data.Counters.order_num or 0) + 1
		local hours = Config.OnlineDeliveryHours
		local order = {
			Num = data.Counters.order_num,
			Items = lines,
			Total = total,
			Shipping = shipping,
			Status = "En camino",
			Placed = os.time(),
			Eta = os.time() + math.floor(hours * Config.DayLengthSeconds / 24),
		}
		table.insert(data.Orders, 1, order)
		while #data.Orders > 30 do
			table.remove(data.Orders)
		end
		local result = { num = order.Num, total = total }
		rememberNonce(data, p.nonce, result)
		Shop.afterPurchase(player, count, total)
		return true, "Pedido #" .. order.Num .. " confirmado ($" .. Util.formatInt(total) .. "). Llegará a tu casa en unos " .. math.floor(hours * Config.DayLengthSeconds / 24 / 60 + 0.5) .. " minutos.", result
	end)

	Net.on("Shop.CancelOrder", function(player, p)
		local data = S.Data.get(player)
		for _, order in ipairs(data.Orders) do
			if order.Num == tonumber(p.num) then
				if order.Status ~= "En camino" then
					return false, "Este pedido ya no se puede cancelar."
				end
				order.Status = "Cancelado"
				S.Economy.add(player, order.Total, "Reembolsos", "Cancelación del pedido #" .. order.Num, {})
				return true, "Pedido #" .. order.Num .. " cancelado. Reembolso: $" .. Util.formatInt(order.Total) .. "."
			end
		end
		return false, "Pedido no encontrado."
	end)

	Net.on("Shop.VisitStore", function(player, p)
		-- El cliente avisa al abrir el catálogo físico; el servidor comprueba la posición.
		local storeId = Shop.storeNear(player)
		if storeId then
			S.Travel.markStoreVisit(player, storeId)
		end
		return true
	end)

	task.spawn(function()
		while true do
			task.wait(5)
			for _, player in ipairs(game:GetService("Players"):GetPlayers()) do
				local ok, err = pcall(Shop.processOrders, player)
				if not ok then
					S.Net.logError("orders", err)
				end
			end
		end
	end)
end

return Shop
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000052"><Properties><string name="Name">SponsorService</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- SponsorService: patrocinios con marcas ficticias.
--  * Cada día de juego llegan ofertas nuevas según tu reputación y suscriptores.
--  * Revisa requisitos, duración, pago, condiciones, producto y fecha de entrega antes de aceptar.
--  * Regalo: el producto es tuyo. Préstamo: se devuelve al terminar. Campaña: sin producto.
--  * Se cumple publicando un vídeo que respete el contrato (el servidor lo comprueba).
--  * Incumplir (pasar la fecha) baja la reputación comercial y devuelve el equipo prestado.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage.Shared
local SponsorData = require(Shared.SponsorData)
local VideoData = require(Shared.VideoData)
local Catalog = require(Shared.ItemCatalog)
local Util = require(Shared.Util)

local Sponsor = {}
local S

function Sponsor.Init(services)
	S = services
end

local function state(data)
	data.Sponsors = data.Sponsors or {}
	local sp = data.Sponsors
	sp.Offers = sp.Offers or {}
	sp.Active = sp.Active or {}
	sp.History = sp.History or {}
	sp.Seq = sp.Seq or 0
	sp.OffersDay = sp.OffersDay or 0
	return sp
end
Sponsor.state = state

function Sponsor.refreshOffers(player)
	local data = S.Data.get(player)
	local sp = state(data)
	local day = data.Home.PlayDays
	if sp.OffersDay == day and #sp.Offers > 0 then
		return
	end
	sp.OffersDay = day
	sp.Offers = {}
	local rng = Random.new(player.UserId * 1009 + day * 7919)
	local eligible = {}
	for _, b in ipairs(SponsorData.Brands) do
		if data.Reputation >= b.MinRep then
			eligible[#eligible + 1] = b
		end
	end
	if #eligible == 0 or data.BizRep < 10 then
		return
	end
	local subs = data.Channel.Subs
	-- Gestor de tu empresa: +1 oferta y mejor pago
	local extra = S.Company and S.Company.sponsorExtra(player) or 0
	local payMult = S.Company and S.Company.sponsorMult(player) or 1
	for i = 1, SponsorData.OffersPerDay + extra do
		local b = eligible[rng:NextInteger(1, #eligible)]
		local cat = b.Cats[rng:NextInteger(1, #b.Cats)]
		local product = (#b.Products > 0 and rng:NextNumber() < 0.75) and b.Products[rng:NextInteger(1, #b.Products)] or nil
		local def = product and Catalog.get(product)
		local kind = "campaign"
		if def then
			kind = def.Price >= 700 and "loan" or "gift"
		end
		local pay = math.floor((120 + 6 * math.sqrt(subs)) * (1 + data.Reputation / 100) * (0.5 + data.BizRep / 100) * (kind == "loan" and 1.3 or 1) * payMult * rng:NextNumber(0.85, 1.15))
		sp.Seq = sp.Seq + 1
		table.insert(sp.Offers, {
			Id = "o" .. sp.Seq,
			Brand = b.Id,
			Kind = kind,
			Category = cat,
			Product = product,
			MinQ = math.floor(math.min(85, 35 + math.sqrt(subs) * 0.3 + rng:NextInteger(0, 10))),
			Days = rng:NextInteger(2, 4),
			Pay = math.floor(pay / 5) * 5,
			Bonus = math.floor(pay * 0.3 / 5) * 5,
		})
	end
end

local function brandName(id)
	local b = SponsorData.BrandById[id]
	return b and b.Name or id
end

-- Comprueba si un proyecto cumple un contrato. Devuelve nil o el motivo.
function Sponsor.check(contract, proj, quality)
	if proj.Category ~= contract.Category then
		return "El contrato pide un vídeo de " .. (VideoData.CategoryById[contract.Category] or {}).Name .. "."
	end
	if quality < contract.MinQ then
		return "El contrato exige calidad " .. contract.MinQ .. " (tu vídeo tiene " .. math.floor(quality) .. ")."
	end
	if contract.Product then
		local shown = false
		for _, sc in ipairs(proj.Scenes) do
			if sc.Feat == contract.Product and sc.Own then
				shown = true
			end
		end
		if not shown then
			return "Debes mostrar el producto patrocinado (" .. Catalog.get(contract.Product).Name .. ") en un plano de producto, con el producto en tu mochila."
		end
	end
	return nil
end

-- Lo llama VideoService al publicar con contrato. Devuelve etiqueta o error.
function Sponsor.fulfill(player, contractId, proj, quality)
	local data = S.Data.get(player)
	local sp = state(data)
	local c = sp.Active[contractId]
	if not c then
		return nil, "Ese contrato no existe o ya terminó."
	end
	local err = Sponsor.check(c, proj, quality)
	if err then
		return nil, err
	end
	return c
end

function Sponsor.complete(player, contractId, quality)
	local data = S.Data.get(player)
	local sp = state(data)
	local c = sp.Active[contractId]
	if not c then
		return
	end
	sp.Active[contractId] = nil
	local total = c.Pay + (quality >= c.MinQ + 15 and c.Bonus or 0)
	if c.Kind == "loan" and c.ItemUid and data.Inventory[c.ItemUid] then
		S.Inventory.remove(player, c.ItemUid)
	end
	data.BizRep = math.min(100, data.BizRep + 5)
	data.Counters.sponsors_done = (data.Counters.sponsors_done or 0) + 1
	Util.pushCapped(sp.History, { Brand = c.Brand, Result = "Cumplido", Pay = total, T = os.time() }, 20)
	S.Economy.add(player, total, "Patrocinios", "Contrato con " .. brandName(c.Brand), { taxable = true })
	S.Net.notify(player, "🤝 Contrato con " .. brandName(c.Brand) .. " cumplido: +$" .. total .. (c.Kind == "loan" and " (equipo prestado devuelto)" or ""), "success")
	S.Quest.check(player)
end

function Sponsor.onNewDay(player)
	local data = S.Data.get(player)
	if not data then
		return
	end
	local sp = state(data)
	for id, c in pairs(sp.Active) do
		if data.Home.PlayDays > c.DueDay then
			sp.Active[id] = nil
			if c.Kind == "loan" and c.ItemUid and data.Inventory[c.ItemUid] then
				S.Inventory.remove(player, c.ItemUid)
			end
			data.BizRep = math.max(0, data.BizRep - 10)
			data.Reputation = math.max(0, data.Reputation - 2)
			Util.pushCapped(sp.History, { Brand = c.Brand, Result = "Incumplido", Pay = 0, T = os.time() }, 20)
			S.Net.notify(player, "⚠️ No cumpliste el contrato con " .. brandName(c.Brand) .. ". Reputación comercial −10." .. (c.Kind == "loan" and " El equipo prestado se ha devuelto." or ""), "warn")
		end
	end
	Sponsor.refreshOffers(player)
	S.Data.markDirty(player)
end

function Sponsor.Start()
	local Net = S.Net

	Net.on("Sponsor.Refresh", function(player)
		Sponsor.refreshOffers(player)
		return true
	end)

	Net.on("Sponsor.Accept", function(player, p)
		local data = S.Data.get(player)
		local sp = state(data)
		local offer, idx = nil, nil
		for i, o in ipairs(sp.Offers) do
			if o.Id == p.id then
				offer, idx = o, i
			end
		end
		if not offer then
			return false, "Esa oferta ya no está disponible."
		end
		if Util.count(sp.Active) >= 3 then
			return false, "Ya tienes 3 contratos activos. Cúmplelos antes de aceptar más."
		end
		if offer.Product then
			local def = Catalog.get(offer.Product)
			if def.Cat == "pc" then
				return false, "Esta oferta no está disponible."
			end
			if not S.Property.canStore(player, 1) then
				return false, "No tienes espacio en casa para recibir el producto."
			end
		end
		table.remove(sp.Offers, idx)
		local c = Util.deepCopy(offer)
		c.Accepted = os.time()
		c.DueDay = data.Home.PlayDays + offer.Days
		if offer.Product then
			local uid = S.Inventory.add(player, offer.Product, { src = offer.Kind == "loan" and "loan" or "sponsor", paid = 0, loc = "home" })
			c.ItemUid = uid
			if uid and offer.Kind == "loan" then
				data.Inventory[uid].Loan = offer.Id
			end
		end
		sp.Active[offer.Id] = c
		return true, "🤝 Contrato aceptado con " .. brandName(offer.Brand) .. ". Entrega antes de " .. offer.Days .. " días de juego." .. (offer.Product and (" Producto enviado a tu casa: " .. Catalog.get(offer.Product).Name .. (offer.Kind == "loan" and " (prestado)." or " (regalo).")) or "")
	end)

	Net.on("Sponsor.Decline", function(player, p)
		local data = S.Data.get(player)
		local sp = state(data)
		for i, o in ipairs(sp.Offers) do
			if o.Id == p.id then
				table.remove(sp.Offers, i)
				return true, "Oferta rechazada (sin penalización)."
			end
		end
		return false, "Oferta no encontrada."
	end)

	Net.on("Sponsor.Cancel", function(player, p)
		local data = S.Data.get(player)
		local sp = state(data)
		local c = sp.Active[p.id or ""]
		if not c then
			return false, "Contrato no encontrado."
		end
		sp.Active[p.id] = nil
		if c.Kind == "loan" and c.ItemUid and data.Inventory[c.ItemUid] then
			S.Inventory.remove(player, c.ItemUid)
		end
		data.BizRep = math.max(0, data.BizRep - 4)
		Util.pushCapped(sp.History, { Brand = c.Brand, Result = "Cancelado", Pay = 0, T = os.time() }, 20)
		return true, "Contrato cancelado. Reputación comercial −4 (menos que incumplirlo)."
	end)
end

return Sponsor
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000053"><Properties><string name="Name">StudioService</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- StudioService: Complejo de Estudios Prisma (Distrito de estudios de grabación).
--  * 6 platós especializados (gaming, música, cocina, podcast, croma y fotografía) alquilables en la
--    recepción por bloques de 5 minutos. Un plató solo puede tenerlo un jugador a la vez en el servidor.
--  * Al alquilar te lleva dentro; puedes salir y volver a entrar (desde la recepción) mientras dure el alquiler,
--    ampliar 1 bloque (hasta StudioData.MaxHours pendientes). Avisa 1 minuto antes del final y,
--    al acabar, te devuelve a la recepción.
--  * Mientras tienes el alquiler activo y estás dentro: el plató es tu lugar de grabación (Tags/Interest propios),
--    +luz de plató, +calidad de escena (sceneBonus) y +calidad de fotos (photoBonus).
--  * Croma: eliges un «fondo» (categoría de vídeo) y las Tags de la escena pasan a ser las de esa categoría.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local Shared = ReplicatedStorage.Shared
local StudioData = require(Shared.StudioData)
local VideoData = require(Shared.VideoData)
local WorldData = require(Shared.WorldData)
local Util = require(Shared.Util)

local Studio = {}
local S
local occupant = {} -- [setId] = player

function Studio.Init(services)
	S = services
end

local function lobby()
	for _, sp in ipairs(WorldData.Specials) do
		if sp.Type == "studios" then
			return sp
		end
	end
	return nil
end

local function rootOf(player)
	return player.Character and player.Character:FindFirstChild("HumanoidRootPart")
end

local function rec(data)
	if type(data.Studio) ~= "table" then
		data.Studio = { Set = "", Ends = 0, Warned = false, Bg = StudioData.DefaultBackdrop }
	end
	return data.Studio
end

-- Punto de la recepción (dentro del vestíbulo, delante del mostrador)
function Studio.lobbyPosition()
	local sp = lobby()
	if not sp then
		return Vector3.new(0, 1, 0)
	end
	return Vector3.new(sp.WX, 1, sp.WZ + 6)
end

-- Punto de entrada de un plató (junto a la puerta de salida)
function Studio.setPosition(set)
	return Vector3.new(set.OX, 1, set.OZ + StudioData.SetSize.D / 2 - 6)
end

function Studio.atDesk(player)
	return S.World.nearSpecial(player, "studios", StudioData.DeskRadius) ~= nil
end

-- Plató en el que está físicamente el jugador (con o sin alquiler)
function Studio.insideSet(player)
	local root = rootOf(player)
	if not root then
		return nil
	end
	local pos = root.Position
	local half = StudioData.SetSize
	for _, set in ipairs(StudioData.Sets) do
		if math.abs(pos.X - set.OX) <= half.W / 2 + 2 and math.abs(pos.Z - set.OZ) <= half.D / 2 + 2 and pos.Y > -5 and pos.Y < 30 then
			return set
		end
	end
	return nil
end

-- Alquiler activo (valida que el plató sigue siendo tuyo en este servidor)
function Studio.rental(player)
	local data = S.Data.get(player)
	if not data then
		return nil
	end
	local r = rec(data)
	if r.Set == "" then
		return nil
	end
	local set = StudioData.ById[r.Set]
	local occ = occupant[r.Set]
	if not set or (occ and occ ~= player and occ.Parent) then
		-- otro jugador lo tiene en este servidor: tu alquiler anterior no sigue aquí
		r.Set, r.Ends, r.Warned = "", 0, false
		return nil
	end
	if os.time() >= r.Ends then
		return nil -- caducado: el bucle lo cierra y avisa
	end
	occupant[r.Set] = player
	return set, r, data
end

-- Plató alquilado en el que estás ahora mismo (alquiler activo + dentro)
function Studio.current(player)
	local set = Studio.rental(player)
	if not set then
		return nil
	end
	local here = Studio.insideSet(player)
	if here and here.Id == set.Id then
		return set
	end
	return nil
end

function Studio.sceneBonus(player)
	local set = Studio.current(player)
	return set and set.Scene or 0
end

function Studio.photoBonus(player)
	local set = Studio.current(player)
	return set and set.Photo or 0
end

local function backdropOf(data)
	local cat = VideoData.CategoryById[rec(data).Bg or ""] or VideoData.CategoryById[StudioData.DefaultBackdrop]
	return cat
end

-- Lugar de grabación del plató (solo con alquiler activo y estando dentro)
function Studio.spot(player)
	local set = Studio.current(player)
	if not set then
		return nil
	end
	local data = S.Data.get(player)
	local tags, name = {}, set.Name
	if set.Chroma then
		local cat = backdropOf(data)
		for _, t in ipairs(cat.Tags) do
			tags[#tags + 1] = t
		end
		name = set.Name .. " (fondo: " .. cat.Name .. ")"
	else
		for _, t in ipairs(set.Tags) do
			tags[#tags + 1] = t
		end
	end
	return {
		Id = "studio_" .. set.Id,
		Name = name,
		Tags = tags,
		Indoor = true,
		Interest = set.Interest,
		Noise = set.Noise,
		Busy = 0,
		Decor = set.Decor,
		StudioLight = set.Light,
		District = "studios",
		Studio = set.Id,
	}
end

local function freeIn(set, player)
	local occ = occupant[set.Id]
	if not occ or occ == player or not occ.Parent then
		return 0
	end
	local d = S.Data.get(occ)
	local r = d and rec(d)
	if not r or r.Set ~= set.Id then
		return 0
	end
	return math.max(0, r.Ends - os.time())
end

-- Vista para el cliente (Derived.Studio)
function Studio.view(player)
	local data = S.Data.get(player)
	if not data then
		return nil
	end
	local set, r = Studio.rental(player)
	local sets = {}
	for _, s in ipairs(StudioData.Sets) do
		local wait = freeIn(s, player)
		sets[#sets + 1] = { Id = s.Id, Free = wait <= 0, FreeIn = wait }
	end
	local here = Studio.current(player)
	return {
		Set = set and set.Id or "",
		Ends = r and r.Ends or 0,
		Left = r and math.max(0, r.Ends - os.time()) or 0,
		Inside = here ~= nil,
		AtDesk = Studio.atDesk(player),
		Bg = rec(data).Bg,
		Sets = sets,
	}
end

local function updateChromaMonitor(data)
	local info = S.World.StudioSets and S.World.StudioSets.chroma
	if info and info.Monitor then
		info.Monitor.Text = "FONDO: " .. backdropOf(data).Name
	end
end

-- Fin del alquiler (caducado o liberado)
function Studio.finish(player, reason)
	local data = S.Data.get(player)
	if not data then
		return
	end
	local r = rec(data)
	local set = StudioData.ById[r.Set]
	if not set then
		r.Set, r.Ends, r.Warned = "", 0, false
		return
	end
	local here = Studio.insideSet(player)
	r.Set, r.Ends, r.Warned = "", 0, false
	if occupant[set.Id] == player then
		occupant[set.Id] = nil
	end
	if here and here.Id == set.Id then
		S.Travel.teleport(player, Studio.lobbyPosition(), "🎛 Recepción de Prisma")
	end
	if reason == "expired" then
		S.Net.notify(player, "⌛ Se acabó tu tiempo en el " .. set.Name .. ". ¡Gracias por grabar en Prisma!", "info")
	end
	S.Data.markDirty(player)
end

-- Bucle: aviso 1 minuto antes y cierre al acabar
function Studio.tick()
	local now = os.time()
	for _, player in ipairs(Players:GetPlayers()) do
		local data = S.Data.get(player)
		if data and type(data.Studio) == "table" and data.Studio.Set ~= "" then
			local r = data.Studio
			local left = r.Ends - now
			if left <= 0 then
				Studio.finish(player, "expired")
			elseif left <= StudioData.WarnSeconds and not r.Warned then
				r.Warned = true
				local set = StudioData.ById[r.Set]
				S.Net.notify(player, "⏳ Tu alquiler del " .. (set and set.Name or "plató") .. " termina en 1 minuto. Amplíalo en la app Estudios.", "warn")
			end
		end
	end
	for id, p in pairs(occupant) do
		if not p.Parent then
			occupant[id] = nil
		end
	end
end

-- Salir del plató (puerta o app): el alquiler sigue corriendo
function Studio.leave(player)
	local here = Studio.insideSet(player)
	if not here then
		return false, "No estás en ningún plató."
	end
	S.Travel.teleport(player, Studio.lobbyPosition(), "🎛 Recepción de Prisma")
	local set, r = Studio.rental(player)
	if set then
		return true, "Has salido del " .. set.Name .. ". Tu alquiler sigue: vuelve desde la recepción (quedan " .. StudioData.gameMinutes(r.Ends - os.time()) .. " min)."
	end
	return true, "Has vuelto a la recepción."
end

function Studio.Start()
	local Net = S.Net

	Net.on("Studio.Rent", function(player, p)
		p = type(p) == "table" and p or {}
		local set = StudioData.ById[p.set or ""]
		if not set then
			return false, "Elige un plató."
		end
		local hours = math.floor(tonumber(p.hours) or 1)
		if hours ~= hours or hours < 1 or hours > StudioData.MaxHours then
			return false, "Puedes alquilar de 1 a " .. StudioData.MaxHours .. " bloques de 5 minutos."
		end
		if not Studio.atDesk(player) then
			return false, "Los platós se alquilan en la recepción del " .. StudioData.Name .. " (Distrito de estudios de grabación)."
		end
		local data = S.Data.get(player)
		local cur = Studio.rental(player)
		if cur then
			return false, "Ya tienes alquilado el " .. cur.Name .. ". Amplíalo o espera a que termine."
		end
		if data.Level < set.Level then
			return false, "El " .. set.Name .. " requiere nivel " .. set.Level .. "."
		end
		local wait = freeIn(set, player)
		if wait > 0 then
			return false, "El " .. set.Name .. " está ocupado. Quedará libre en " .. StudioData.gameMinutes(wait) .. " min."
		end
		local price = StudioData.price(set, hours)
		if not S.Economy.spend(player, price, "Estudios", "Alquiler del " .. set.Name .. " (" .. hours .. " h)") then
			return false, "Necesitas $" .. price .. " para alquilar el " .. set.Name .. "."
		end
		local r = rec(data)
		r.Set, r.Ends, r.Warned = set.Id, os.time() + hours * StudioData.HourSeconds, false
		occupant[set.Id] = player
		data.Counters.studio_rentals = (data.Counters.studio_rentals or 0) + 1
		data.Counters.studio_hours = (data.Counters.studio_hours or 0) + hours
		if set.Chroma then
			updateChromaMonitor(data)
		end
		S.Travel.teleport(player, Studio.setPosition(set), set.Icon .. " " .. set.Name)
		S.Progress.addXp(player, 10)
		S.Quest.check(player)
		S.Data.markDirty(player)
		return true, set.Icon .. " ¡" .. set.Name .. " alquilado " .. hours .. " h por $" .. price .. "! +" .. set.Scene .. " calidad de escena mientras grabes dentro.", { set = set.Id, ends = r.Ends }
	end)

	Net.on("Studio.Extend", function(player)
		local set, r = Studio.rental(player)
		if not set then
			return false, "No tienes ningún plató alquilado."
		end
		if not Studio.atDesk(player) and not Studio.current(player) then
			return false, "Amplía el alquiler desde el plató o la recepción."
		end
		if (r.Ends - os.time()) + StudioData.HourSeconds > StudioData.MaxHours * StudioData.HourSeconds + 1 then
			return false, "Como máximo puedes tener " .. StudioData.MaxHours .. " bloques pendientes."
		end
		if not S.Economy.spend(player, set.Price, "Estudios", "Ampliación del " .. set.Name .. " (1 h)") then
			return false, "Necesitas $" .. set.Price .. " para ampliar 5 minutos."
		end
		r.Ends = r.Ends + StudioData.HourSeconds
		r.Warned = false
		local data = S.Data.get(player)
		data.Counters.studio_hours = (data.Counters.studio_hours or 0) + 1
		S.Data.markDirty(player)
		return true, "⏱ +5 minutos en el " .. set.Name .. " ($" .. set.Price .. "). Quedan " .. StudioData.gameMinutes(r.Ends - os.time()) .. " min.", { ends = r.Ends }
	end)

	Net.on("Studio.Enter", function(player)
		local set = Studio.rental(player)
		if not set then
			return false, "No tienes ningún plató alquilado."
		end
		if not Studio.atDesk(player) then
			return false, "Vuelve a entrar desde la recepción del " .. StudioData.Name .. "."
		end
		S.Travel.teleport(player, Studio.setPosition(set), set.Icon .. " " .. set.Name)
		return true, "Entras en el " .. set.Name .. "."
	end)

	Net.on("Studio.Leave", function(player)
		return Studio.leave(player)
	end)

	Net.on("Studio.SetBackdrop", function(player, p)
		p = type(p) == "table" and p or {}
		local set = Studio.rental(player)
		if not set or not set.Chroma then
			return false, "Necesitas el Plató Croma alquilado para cambiar el fondo."
		end
		local cat = VideoData.CategoryById[p.category or ""]
		if not cat then
			return false, "Fondo no válido."
		end
		local data = S.Data.get(player)
		rec(data).Bg = cat.Id
		updateChromaMonitor(data)
		S.Data.markDirty(player)
		return true, "🟩 Fondo del croma: " .. cat.Name .. ". Tus escenas aquí cuentan como «" .. cat.Name .. "».", { bg = cat.Id }
	end)

	Players.PlayerRemoving:Connect(function(player)
		for id, p in pairs(occupant) do
			if p == player then
				occupant[id] = nil
			end
		end
	end)

	task.spawn(function()
		while true do
			task.wait(1)
			local ok, err = pcall(Studio.tick)
			if not ok then
				S.Net.logError("StudioTick", err)
			end
		end
	end)
end

return Studio
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000054"><Properties><string name="Name">SyncService</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- SyncService: construye la vista del perfil que recibe el cliente (solo lectura en el cliente).
-- Incluye valores derivados que el servidor calcula (rango, capacidad de mochila, rendimiento del PC...).

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage.Shared
local Progression = require(Shared.Progression)
local QuestDefs = require(Shared.QuestDefs)
local Catalog = require(Shared.ItemCatalog)

local Sync = {}
local S

local HIDDEN = { Receipts = true, ReceiptOrder = true, Processed = true, ProcessedOrder = true, __lock = true }

function Sync.Init(services)
	S = services
end

function Sync.build(player)
	local data = S.Data.get(player)
	local view = {}
	for k, v in pairs(data) do
		if not HIDDEN[k] then
			view[k] = v
		end
	end
	local rankIndex, rank = S.Progress.rank(data)
	view.Derived = {
		XpNext = Progression.xpToNext(data.Level),
		RankIndex = rankIndex,
		RankName = rank.Name,
		BackpackCap = S.Inventory.backpackCap(player),
		BackpackUsed = S.Inventory.backpackUsed(player),
		PhotoCap = S.Video.photoCapacity(player),
		StorageUsed = S.Computer.storageUsed(player),
		RigStats = {},
		Passes = S.Monetization.ownedList(player),
		Trends = S.Channel.trends(),
		ReadOnly = S.Data.getProfile(player).ReadOnly,
		LoanLimit = S.Economy.loanLimit(data),
		Day = S.Time.day(),
		Month = S.Time.monthIndex(),
		AtHome = S.Home.isAtHome(player),
		Recording = S.Video.isRecording(player),
		Session = S.Computer.session(player) and S.Computer.sessionStats(player) or nil,
		QuestValues = {},
		PropInside = S.Property.inside(player),
		EventId = S.Events.current().Id,
		EventActive = S.Events.isActive(),
		AtEvent = S.Events.atEvent(player),
		Interior = S.Property.interiorInfo(player),
		DecorScore = S.Property.inside(player) and S.Property.decorScore(player, S.Property.inside(player)) or nil,
		StorageCap = S.Property.storageCap(player),
		Stored = S.Property.storedCount(player),
		MaxProps = require(Shared.PropertyData).maxProperties(data.Level),
		Returnable = {},
		SellValues = {},
		VehicleOut = S.Vehicle and S.Vehicle.spawnedId(player) or nil,
		TrunkBonus = S.Vehicle and S.Vehicle.trunkBonus(player) or 0,
		Trade = S.Trade and S.Trade.view(player) or nil,
		Collab = S.Collab and S.Collab.view(player) or nil,
		Studio = S.Studio and S.Studio.view(player) or nil,
		Leisure = S.Leisure and S.Leisure.view(player) or nil,
	}
	for rigId in pairs(data.Rigs) do
		view.Derived.RigStats[rigId] = S.Computer.rigStats(player, rigId)
	end
	for key in pairs(QuestDefs.TrackNames) do
		view.Derived.QuestValues[key] = S.Quest.valueOf(data, key)
	end
	for uid, rec in pairs(data.Inventory) do
		local def = Catalog.get(rec.Id)
		if def then
			view.Derived.SellValues[uid] = S.Inventory.sellValue(rec, def)
			if S.Inventory.canReturn(rec) then
				view.Derived.Returnable[uid] = math.floor(rec.Paid * 0.9 + 0.5)
			end
		end
	end
	local inc, exp = S.Economy.balanceSummary(data)
	view.Derived.MonthIncome, view.Derived.MonthExpense = inc, exp
	return view
end

function Sync.send(player)
	S.Net.push(player, "profile", Sync.build(player))
end

function Sync.Start()
	S.Net.on("Sync.Request", function(player)
		Sync.send(player)
		return true
	end)
end

return Sync
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000055"><Properties><string name="Name">TextFilter</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- TextFilter: filtra con TextService todo texto escrito por jugadores que otros puedan ver
-- (nombre del canal, títulos, descripciones, metas...). Si el filtro falla, se rechaza el texto.

local TextService = game:GetService("TextService")

local TextFilter = {}

function TextFilter.Init() end

function TextFilter.filter(player, text)
	if type(text) ~= "string" then
		return nil
	end
	if text == "" then
		return ""
	end
	local ok, result = pcall(function()
		local filtered = TextService:FilterStringAsync(text, player.UserId)
		return filtered:GetNonChatStringForBroadcastAsync()
	end)
	if ok and type(result) == "string" then
		return result
	end
	return nil
end

return TextFilter
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000056"><Properties><string name="Name">TimeWeatherService</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- TimeWeatherService: ciclo día/noche compartido y clima.
--  * 1 día de juego = Config.DayLengthSeconds segundos reales.
--  * El clima cambia cada pocas horas de juego (despejado, nublado, lluvia, niebla, tormenta moderada).
--  * Publica atributos en Workspace: GameHour, GameDay, Weather. El cliente dibuja la lluvia/relámpagos.
--  * Enciende farolas y ventanas de noche (etiqueta "NightLight").

local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)

local Time = {}
local S
local startOffset = 9 -- el servidor empieza a las 9:00
local startClock = os.time()
local lastDay = nil
local nightState = nil

Time.WeatherNames = { Clear = "Despejado", Cloudy = "Nublado", Rain = "Lluvia", Fog = "Niebla", Storm = "Tormenta" }
local weatherWeights = { { "Clear", 45 }, { "Cloudy", 25 }, { "Rain", 12 }, { "Fog", 10 }, { "Storm", 8 } }
Time.Weather = "Clear"
local nextWeatherAt = 0

function Time.Init(services)
	S = services
end

local function totalHours()
	return startOffset + (os.time() - startClock) / Config.DayLengthSeconds * 24
end

function Time.hour()
	return totalHours() % 24
end

function Time.day()
	return math.floor(totalHours() / 24) + 1
end

function Time.monthIndex()
	return math.floor((Time.day() - 1) / Config.DaysPerMonth) + 1
end

function Time.isNight()
	local h = Time.hour()
	return h < 6 or h >= 19.5
end

function Time.label()
	local h = Time.hour()
	if h >= 5 and h < 7 then
		return "Amanecer"
	elseif h >= 7 and h < 11.5 then
		return "Mañana"
	elseif h >= 11.5 and h < 14 then
		return "Mediodía"
	elseif h >= 14 and h < 17.5 then
		return "Tarde"
	elseif h >= 17.5 and h < 19.5 then
		return "Atardecer"
	end
	return "Noche"
end

local function pickWeather()
	local total = 0
	for _, w in ipairs(weatherWeights) do
		total = total + w[2]
	end
	local r = math.random() * total
	for _, w in ipairs(weatherWeights) do
		r = r - w[2]
		if r <= 0 then
			return w[1]
		end
	end
	return "Clear"
end

local atmosphere
local function applyWeather(w)
	Time.Weather = w
	workspace:SetAttribute("Weather", w)
	if atmosphere then
		local density = ({ Clear = 0.25, Cloudy = 0.32, Rain = 0.4, Fog = 0.62, Storm = 0.5 })[w] or 0.3
		atmosphere.Density = density
		atmosphere.Haze = (w == "Fog") and 3 or ((w == "Clear") and 0.5 or 1.5)
	end
	local clouds = workspace.Terrain:FindFirstChildOfClass("Clouds")
	if clouds then
		clouds.Cover = ({ Clear = 0.35, Cloudy = 0.75, Rain = 0.85, Fog = 0.6, Storm = 0.95 })[w] or 0.5
		clouds.Density = (w == "Storm" or w == "Rain") and 0.9 or 0.5
	end
	Lighting.Brightness = (w == "Storm") and 1.3 or ((w == "Rain") and 1.7 or 2.4)
	for _, player in ipairs(Players:GetPlayers()) do
		S.Net.notify(player, "Clima: " .. (Time.WeatherNames[w] or w), "info")
	end
end

local function setNight(isNight)
	if nightState == isNight then
		return
	end
	nightState = isNight
	for _, part in ipairs(CollectionService:GetTagged("NightLight")) do
		local light = part:FindFirstChildWhichIsA("Light")
		if light then
			light.Enabled = isNight
		end
		if part:GetAttribute("GlowNight") then
			part.Material = isNight and Enum.Material.Neon or Enum.Material.Glass
		end
	end
end

function Time.Start()
	atmosphere = Lighting:FindFirstChildOfClass("Atmosphere") or Instance.new("Atmosphere")
	atmosphere.Parent = Lighting
	if not Lighting:FindFirstChildOfClass("Sky") then
		Instance.new("Sky").Parent = Lighting
	end
	if not workspace.Terrain:FindFirstChildOfClass("Clouds") then
		local c = Instance.new("Clouds")
		c.Parent = workspace.Terrain
	end
	Lighting.OutdoorAmbient = Color3.fromRGB(120, 120, 130)
	applyWeather("Clear")
	nextWeatherAt = os.time() + math.random(4, 8) * Config.DayLengthSeconds / 24

	task.spawn(function()
		while true do
			local h = Time.hour()
			Lighting.ClockTime = h
			workspace:SetAttribute("GameHour", h)
			workspace:SetAttribute("GameDay", Time.day())
			workspace:SetAttribute("TimeLabel", Time.label())
			setNight(Time.isNight())
			if os.time() >= nextWeatherAt then
				local w = pickWeather()
				-- Las tormentas duran poco para no molestar
				local hours = (w == "Storm") and math.random(1, 2) or math.random(3, 7)
				nextWeatherAt = os.time() + hours * Config.DayLengthSeconds / 24
				if w ~= Time.Weather then
					applyWeather(w)
				end
			end
			local day = Time.day()
			if lastDay and day ~= lastDay then
				for _, player in ipairs(Players:GetPlayers()) do
					if S.Data.get(player) then
						pcall(S.Home.onNewDay, player)
						pcall(S.Economy.onNewDay, player, day)
					end
				end
				pcall(S.Channel.onNewDay, day)
			end
			lastDay = day
			task.wait(1)
		end
	end)
end

return Time
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000057"><Properties><string name="Name">TradeService</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- TradeService: intercambio seguro de objetos y dinero entre dos jugadores cercanos.
--  Flujo: solicitar (≤ 20 studs) → el otro acepta → cada uno prepara su oferta (máx. 8 objetos + dinero) → ambos confirman.
--  * Cualquier cambio en una oferta anula las confirmaciones; confirmar exige la versión actual de las ofertas.
--  * Al ejecutar, el servidor vuelve a validar TODO (que cada objeto siga siendo de quien lo ofrece y se pueda dar,
--    el dinero y el espacio del receptor) y transfiere de forma atómica: el objeto pasa al receptor con un uid nuevo
--    y desaparece del emisor; si algo falla se restaura todo y no se transfiere nada.
--  * Se puede cancelar en cualquier momento; se cancela solo si alguien se aleja (> 25 studs) o sale del juego.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage.Shared
local Catalog = require(Shared.ItemCatalog)
local MarketData = require(Shared.MarketData)
local Util = require(Shared.Util)

local Trade = {}
local S
local byPlayer = {} -- player -> intercambio en curso (pendiente o abierto)
local lastSeq = {} -- player -> número de la última versión enviada al cliente
local lastResult = {} -- player -> { Status, Msg } del último intercambio terminado
local lastRequest = {} -- player -> os.clock() de su última solicitud
local seq = 0
local nextId = 0

function Trade.Init(services)
	S = services
end

local function nameOf(p)
	return p.DisplayName or p.Name
end

local function other(t, player)
	return t.A == player and t.B or t.A
end

local function dist(a, b)
	local ra = a.Character and a.Character:FindFirstChild("HumanoidRootPart")
	local rb = b.Character and b.Character:FindFirstChild("HumanoidRootPart")
	if not ra or not rb then
		return math.huge
	end
	local pa, pb = ra.Position, rb.Position
	local dx, dy, dz = pa.X - pb.X, pa.Y - pb.Y, pa.Z - pb.Z
	return math.sqrt(dx * dx + dy * dy + dz * dz)
end

local function online(p)
	return p and p.Parent ~= nil and S.Data.get(p) ~= nil
end

local function offerView(data, offer, mine)
	local items = {}
	for _, uid in ipairs(offer.Items) do
		local rec = data and data.Inventory[uid]
		local def = rec and Catalog.get(rec.Id)
		items[#items + 1] = {
			Uid = mine and uid or nil,
			Id = rec and rec.Id or "",
			Name = def and def.Name or "(ya no lo tiene)",
			Cond = rec and math.floor(rec.Cond or 100) or 0,
			Collectible = def and def.Collectible == true or false,
			Missing = rec == nil,
		}
	end
	return { Items = items, Money = offer.Money }
end

-- Vista del intercambio para un jugador (la incluye SyncService en Derived.Trade y se envía con push "trade")
function Trade.view(player)
	local v = { Seq = lastSeq[player] or 0, Status = "none", Last = lastResult[player] }
	local t = byPlayer[player]
	if not t then
		return v
	end
	local o = other(t, player)
	v.Status = t.Status
	v.Id = t.Id
	v.Incoming = t.Status == "pending" and t.B == player
	v.Partner = { Name = nameOf(o), UserId = o.UserId }
	v.Version = t.Version
	v.Mine = offerView(S.Data.get(player), t.Offers[player], true)
	v.Theirs = offerView(S.Data.get(o), t.Offers[o], false)
	v.MyConfirmed = t.Confirmed[player] == true
	v.TheirConfirmed = t.Confirmed[o] == true
	v.MaxItems = MarketData.TradeMaxItems
	return v
end

local function pushState(p)
	seq = seq + 1
	lastSeq[p] = seq
	S.Net.push(p, "trade", Trade.view(p))
	S.Data.markDirty(p)
end

local function pushBoth(t)
	pushState(t.A)
	pushState(t.B)
end

local function close(t, status, msg, style)
	t.Status = status
	for _, p in ipairs({ t.A, t.B }) do
		if byPlayer[p] == t then
			byPlayer[p] = nil
		end
		lastResult[p] = { Status = status, Msg = msg }
		S.Net.notify(p, msg, style or (status == "done" and "success" or "warn"))
		pushState(p)
	end
end

-- Un cambio en una oferta: nueva versión y confirmaciones anuladas
local function changed(t, by)
	t.Version = t.Version + 1
	local had = t.Confirmed[t.A] or t.Confirmed[t.B]
	t.Confirmed = {}
	if had then
		S.Net.notify(other(t, by), "🤝 " .. nameOf(by) .. " cambió su oferta: las confirmaciones se han anulado.", "warn")
	end
	pushBoth(t)
end

function Trade.isOffered(player, uid)
	local t = byPlayer[player]
	if not t or t.Status ~= "open" then
		return false
	end
	return Util.indexOf(t.Offers[player].Items, uid) ~= nil
end

function Trade.get(player)
	return byPlayer[player]
end

-- Validación de la oferta de un jugador (al confirmar y otra vez al ejecutar)
local function validateOffer(t, p)
	local data = S.Data.get(p)
	if not data then
		return "sus datos no están disponibles."
	end
	local offer = t.Offers[p]
	local leaving = {}
	for _, uid in ipairs(offer.Items) do
		leaving[uid] = true
	end
	for _, uid in ipairs(offer.Items) do
		local rec = data.Inventory[uid]
		if not rec then
			return "ya no tiene uno de los objetos ofrecidos."
		end
		local err = S.Market.lockReason(p, uid, { leaving = leaving })
		if err then
			return err
		end
	end
	if type(offer.Money) ~= "number" or offer.Money < 0 or offer.Money ~= math.floor(offer.Money) then
		return "la cantidad de dinero no es válida."
	end
	if data.Money < offer.Money then
		return "ya no tiene los $" .. Util.formatInt(offer.Money) .. " ofrecidos."
	end
	return nil
end

-- ¿Le caben al receptor los objetos que recibe?
local function capacityError(t, receiver, giver)
	local data = S.Data.get(receiver)
	local incoming = #t.Offers[giver].Items
	if incoming == 0 then
		return nil
	end
	local outgoing = t.Offers[receiver].Items
	if Util.count(data.Inventory) - #outgoing + incoming > S.Inventory.MaxItems then
		return nameOf(receiver) .. " no tiene sitio en el inventario (máx. " .. S.Inventory.MaxItems .. " objetos)."
	end
	local outStored = 0
	for _, uid in ipairs(outgoing) do
		local rec = data.Inventory[uid]
		if rec and rec.Loc ~= "backpack" then
			outStored = outStored + 1
		end
	end
	if S.Property.storedCount(receiver) - outStored + incoming > S.Property.storageCap(receiver) then
		return nameOf(receiver) .. " no tiene espacio en su vivienda para lo que recibe."
	end
	return nil
end

local SNAP_KEYS = { "Inventory", "Equipped", "Money", "LifetimeEarned", "Uid", "Transactions", "Monthly", "Visited", "Counters" }
local function snapshot(data)
	local snap = {}
	for _, k in ipairs(SNAP_KEYS) do
		snap[k] = Util.deepCopy(data[k])
	end
	return snap
end
local function restore(data, snap)
	for _, k in ipairs(SNAP_KEYS) do
		data[k] = snap[k]
	end
end

-- Quita de las ofertas lo que ya no se puede dar (tras un fallo al ejecutar)
local function prune(t)
	for _, p in ipairs({ t.A, t.B }) do
		local offer = t.Offers[p]
		local keep = {}
		local leaving = {}
		for _, uid in ipairs(offer.Items) do
			leaving[uid] = true
		end
		for _, uid in ipairs(offer.Items) do
			if not S.Market.lockReason(p, uid, { leaving = leaving }) then
				keep[#keep + 1] = uid
			end
		end
		offer.Items = keep
		local data = S.Data.get(p)
		if data and offer.Money > data.Money then
			offer.Money = 0
		end
	end
end

-- Ejecuta el intercambio. Devuelve ok, mensaje de error
local function execute(t)
	local A, B = t.A, t.B
	if not online(A) or not online(B) then
		return false, "uno de los dos ya no está conectado."
	end
	if dist(A, B) > MarketData.TradeLeaveRadius then
		return false, "estáis demasiado lejos el uno del otro."
	end
	for _, p in ipairs({ A, B }) do
		local err = validateOffer(t, p)
		if err then
			return false, nameOf(p) .. " " .. err
		end
	end
	local capErr = capacityError(t, A, B) or capacityError(t, B, A)
	if capErr then
		return false, capErr
	end
	local dA, dB = S.Data.get(A), S.Data.get(B)
	local snapA, snapB = snapshot(dA), snapshot(dB)
	local received = { [A] = {}, [B] = {} }
	local ok, err = pcall(function()
		-- 1) Sacar los objetos de cada emisor
		local moving = { [A] = {}, [B] = {} }
		for _, p in ipairs({ A, B }) do
			local d = S.Data.get(p)
			for _, uid in ipairs(t.Offers[p].Items) do
				local rec = d.Inventory[uid]
				assert(rec, "objeto desaparecido durante el intercambio")
				moving[p][#moving[p] + 1] = Util.deepCopy(rec)
				d.Inventory[uid] = nil
				if d.Equipped.Phone == uid then
					d.Equipped.Phone = ""
				end
			end
		end
		-- 2) Dinero
		for _, p in ipairs({ A, B }) do
			local o = other(t, p)
			local amount = t.Offers[p].Money
			if amount > 0 then
				assert(S.Economy.spend(p, amount, "Intercambios", "Pago a " .. nameOf(o) .. " en un intercambio"), "dinero insuficiente")
				S.Economy.add(o, amount, "Intercambios", "Recibido de " .. nameOf(p) .. " en un intercambio", { silent = true })
				local od = S.Data.get(o)
				od.LifetimeEarned = od.LifetimeEarned - amount -- un intercambio no es dinero ganado
			end
		end
		-- 3) Entregar los objetos al receptor con uid nuevo
		for _, p in ipairs({ A, B }) do
			local o = other(t, p)
			local od = S.Data.get(o)
			for _, rec in ipairs(moving[p]) do
				local newUid = S.Data.nextUid(o, "i")
				assert(od.Inventory[newUid] == nil, "uid repetido")
				rec.Loc = "home"
				rec.Src = "trade"
				rec.Got = os.time()
				rec.GotDay = S.Time.day()
				rec.CleanDay = nil
				rec.Loan = nil
				od.Inventory[newUid] = rec
				local def = Catalog.get(rec.Id)
				if def and def.Cat == "camera" then
					od.Visited.Cameras[rec.Id] = true
				end
				received[o][#received[o] + 1] = { uid = newUid, id = rec.Id }
			end
		end
		for _, p in ipairs({ A, B }) do
			local d = S.Data.get(p)
			d.Counters.trades = (d.Counters.trades or 0) + 1
			d.Counters.trade_items = (d.Counters.trade_items or 0) + #received[p]
		end
	end)
	if not ok then
		restore(dA, snapA)
		restore(dB, snapB)
		S.Net.logError("trade execute", err)
		return false, "error interno: no se ha transferido nada."
	end
	-- Avisos y efectos posteriores (ya confirmado)
	for _, p in ipairs({ A, B }) do
		local o = other(t, p)
		local money = t.Offers[o].Money
		if money > 0 then
			S.Net.push(p, "cash", { amount = money, desc = "Intercambio con " .. nameOf(o) })
		end
		for _, r in ipairs(received[p]) do
			S.Market.registerCollectible(p, r.id)
		end
		S.Quest.check(p)
		S.Data.markDirty(p)
	end
	return true, received
end

local function summary(t, p)
	local o = other(t, p)
	local got, gave = #t.Offers[o].Items, #t.Offers[p].Items
	local txt = "recibiste " .. got .. (got == 1 and " objeto" or " objetos")
	if t.Offers[o].Money > 0 then
		txt = txt .. " y $" .. Util.formatInt(t.Offers[o].Money)
	end
	txt = txt .. "; diste " .. gave .. (gave == 1 and " objeto" or " objetos")
	if t.Offers[p].Money > 0 then
		txt = txt .. " y $" .. Util.formatInt(t.Offers[p].Money)
	end
	return txt
end

-- Comprobación periódica: solicitudes caducadas, jugadores que se van o se alejan
function Trade.tick(t)
	if byPlayer[t.A] ~= t and byPlayer[t.B] ~= t then
		return
	end
	if not online(t.A) or not online(t.B) then
		local gone = online(t.A) and t.B or t.A
		close(t, "cancelled", "🤝 Intercambio cancelado: " .. nameOf(gone) .. " se ha ido.")
	elseif t.Status == "pending" and os.time() - t.Created > MarketData.TradeRequestSeconds then
		close(t, "cancelled", "🤝 La solicitud de intercambio caducó.", "info")
	elseif dist(t.A, t.B) > MarketData.TradeLeaveRadius then
		close(t, "cancelled", "🤝 Intercambio cancelado: os habéis alejado demasiado.")
	end
end

local function openTrade(player)
	local t = byPlayer[player]
	if not t then
		return nil, "No tienes ningún intercambio en curso."
	end
	if t.Status ~= "open" then
		return nil, "El intercambio aún no ha sido aceptado."
	end
	return t
end

local function accept(t)
	t.Status = "open"
	S.Net.notify(t.A, "🤝 " .. nameOf(t.B) .. " aceptó el intercambio. Preparad vuestras ofertas.", "success")
	pushBoth(t)
	return true, "Intercambio con " .. nameOf(t.A) .. " abierto."
end

function Trade.Start()
	local Net = S.Net

	Net.on("Trade.Nearby", function(player)
		local list = {}
		for _, o in ipairs(Players:GetPlayers()) do
			if o ~= player and online(o) then
				local d = dist(player, o)
				if d <= MarketData.TradeRadius then
					list[#list + 1] = { userId = o.UserId, name = nameOf(o), busy = byPlayer[o] ~= nil, dist = math.floor(d + 0.5) }
				end
			end
		end
		table.sort(list, function(a, b)
			return a.dist < b.dist
		end)
		return true, nil, { players = list }
	end)

	Net.on("Trade.Request", function(player, p)
		local target = Players:GetPlayerByUserId(math.floor(tonumber(p.userId) or 0))
		if not target or not online(target) then
			return false, "Ese jugador no está disponible."
		end
		if target == player then
			return false, "No puedes intercambiar contigo mismo."
		end
		local mine = byPlayer[player]
		if mine then
			if mine.Status == "pending" and mine.B == player and mine.A == target then
				return accept(mine)
			end
			return false, "Ya tienes un intercambio en curso. Termínalo o cancélalo primero."
		end
		if byPlayer[target] then
			return false, nameOf(target) .. " ya está en otro intercambio."
		end
		if dist(player, target) > MarketData.TradeRadius then
			return false, "Acércate a " .. nameOf(target) .. " (máximo " .. MarketData.TradeRadius .. " studs) para proponer un intercambio."
		end
		if lastRequest[player] and os.clock() - lastRequest[player] < 2 then
			return false, "Espera un momento antes de enviar otra solicitud."
		end
		lastRequest[player] = os.clock()
		nextId = nextId + 1
		local t = {
			Id = nextId,
			A = player,
			B = target,
			Status = "pending",
			Created = os.time(),
			Version = 1,
			Offers = { [player] = { Items = {}, Money = 0 }, [target] = { Items = {}, Money = 0 } },
			Confirmed = {},
		}
		byPlayer[player] = t
		byPlayer[target] = t
		S.Net.notify(target, "🤝 " .. nameOf(player) .. " quiere intercambiar contigo. Abre la app Intercambio para aceptar.", "info")
		pushBoth(t)
		return true, "Solicitud de intercambio enviada a " .. nameOf(target) .. "."
	end)

	Net.on("Trade.Accept", function(player)
		local t = byPlayer[player]
		if not t or t.Status ~= "pending" or t.B ~= player then
			return false, "No tienes ninguna solicitud de intercambio pendiente."
		end
		if not online(t.A) then
			close(t, "cancelled", "🤝 Intercambio cancelado: " .. nameOf(t.A) .. " se ha ido.")
			return false, "Esa persona ya no está."
		end
		if dist(player, t.A) > MarketData.TradeLeaveRadius then
			return false, "Acércate a " .. nameOf(t.A) .. " para aceptar."
		end
		return accept(t)
	end)

	Net.on("Trade.Cancel", function(player)
		local t = byPlayer[player]
		if not t then
			return false, "No tienes ningún intercambio en curso."
		end
		local declined = t.Status == "pending" and t.B == player
		close(t, "cancelled", "🤝 " .. nameOf(player) .. (declined and " rechazó" or " canceló") .. " el intercambio. No se ha transferido nada.", "info")
		return true
	end)

	Net.on("Trade.AddItem", function(player, p)
		local t, err = openTrade(player)
		if not t then
			return false, err
		end
		local offer = t.Offers[player]
		if type(p.uid) ~= "string" then
			return false, "Objeto no válido."
		end
		if Util.indexOf(offer.Items, p.uid) then
			return false, "Ya está en tu oferta."
		end
		if #offer.Items >= MarketData.TradeMaxItems then
			return false, "Máximo " .. MarketData.TradeMaxItems .. " objetos por oferta."
		end
		local leaving = { [p.uid] = true }
		for _, uid in ipairs(offer.Items) do
			leaving[uid] = true
		end
		local lock = S.Market.lockReason(player, p.uid, { leaving = leaving })
		if lock then
			return false, lock
		end
		table.insert(offer.Items, p.uid)
		changed(t, player)
		local rec = S.Data.get(player).Inventory[p.uid]
		return true, Catalog.get(rec.Id).Name .. " añadido a tu oferta."
	end)

	Net.on("Trade.RemoveItem", function(player, p)
		local t, err = openTrade(player)
		if not t then
			return false, err
		end
		local offer = t.Offers[player]
		local i = Util.indexOf(offer.Items, p.uid)
		if not i then
			return false, "Ese objeto no está en tu oferta."
		end
		table.remove(offer.Items, i)
		changed(t, player)
		return true, "Objeto quitado de tu oferta."
	end)

	Net.on("Trade.SetMoney", function(player, p)
		local t, err = openTrade(player)
		if not t then
			return false, err
		end
		local amount = tonumber(p.amount)
		if not amount or amount ~= amount or amount < 0 or amount > MarketData.TradeMaxMoney then
			return false, "Cantidad no válida."
		end
		amount = math.floor(amount)
		local data = S.Data.get(player)
		if amount > data.Money then
			return false, "Solo tienes $" .. Util.formatInt(data.Money) .. "."
		end
		local offer = t.Offers[player]
		if offer.Money == amount then
			return true, "Tu oferta ya incluye $" .. Util.formatInt(amount) .. "."
		end
		offer.Money = amount
		changed(t, player)
		return true, "Ofreces $" .. Util.formatInt(amount) .. "."
	end)

	Net.on("Trade.Confirm", function(player, p)
		local t, err = openTrade(player)
		if not t then
			return false, err
		end
		if tonumber(p.version) ~= t.Version then
			return false, "Las ofertas han cambiado: revísalas antes de confirmar."
		end
		local o = other(t, player)
		if #t.Offers[player].Items == 0 and #t.Offers[o].Items == 0 and t.Offers[player].Money == 0 and t.Offers[o].Money == 0 then
			return false, "No hay nada que intercambiar todavía."
		end
		local own = validateOffer(t, player)
		if own then
			return false, "Tu oferta no es válida: " .. own
		end
		t.Confirmed[player] = true
		if not t.Confirmed[o] then
			S.Net.notify(o, "🤝 " .. nameOf(player) .. " confirmó el intercambio. Revisa y confirma tú también.", "info")
			pushBoth(t)
			return true, "Has confirmado. Esperando a " .. nameOf(o) .. "."
		end
		local done, res = execute(t)
		if not done then
			-- No se ha movido nada: se quitan de las ofertas los objetos que ya no son válidos y hay que volver a confirmar
			prune(t)
			t.Version = t.Version + 1
			t.Confirmed = {}
			local msg = "⚠ El intercambio no se pudo completar: " .. tostring(res) .. " No se ha transferido nada; revisad las ofertas."
			S.Net.notify(o, msg, "error")
			pushBoth(t)
			return false, msg
		end
		local msgA = "🤝 Intercambio completado con " .. nameOf(o) .. ": " .. summary(t, player) .. "."
		local msgB = "🤝 Intercambio completado con " .. nameOf(player) .. ": " .. summary(t, o) .. "."
		t.Status = "done"
		byPlayer[player], byPlayer[o] = nil, nil
		lastResult[player] = { Status = "done", Msg = msgA }
		lastResult[o] = { Status = "done", Msg = msgB }
		S.Net.notify(o, msgB, "success")
		pushState(player)
		pushState(o)
		return true, msgA, { received = res[player] }
	end)

	Players.PlayerRemoving:Connect(function(player)
		local t = byPlayer[player]
		if t then
			close(t, "cancelled", "🤝 Intercambio cancelado: " .. nameOf(player) .. " salió del juego.")
		end
		lastSeq[player], lastResult[player], lastRequest[player] = nil, nil, nil
	end)

	task.spawn(function()
		while true do
			task.wait(1)
			local list, seen = {}, {}
			for _, t in pairs(byPlayer) do
				if not seen[t] then
					seen[t] = true
					list[#list + 1] = t
				end
			end
			for _, t in ipairs(list) do
				local ok, err = pcall(Trade.tick, t)
				if not ok then
					S.Net.logError("trade tick", err)
				end
			end
		end
	end)
end

return Trade
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000058"><Properties><string name="Name">TravelService</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- TravelService: dónde está cada jugador (distrito, lugar de grabación, tienda), descubrimientos,
-- lugares secretos, taxi y autobús.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local WorldData = require(Shared.WorldData)
local Catalog = require(Shared.ItemCatalog)
local Util = require(Shared.Util)
local LifeData = require(Shared.LifeData)

local Travel = {}
local S
local lastDistrict = {}
local lastTaxi = {}

Travel.BusLine = { "budget", "apartments", "studios", "entertainment", "events", "commercial", "park", "creators", "financial", "tourist", "university", "beach" }

local storeTags = {
	tech = { "shop", "tech" },
	camera = { "shop", "tech", "studio" },
	phone = { "shop", "tech" },
	creator = { "shop", "studio" },
	home = { "shop", "home" },
}

function Travel.Init(services)
	S = services
end

local function rootOf(player)
	return player.Character and player.Character:FindFirstChild("HumanoidRootPart")
end

-- Lugar de grabación en el que está el jugador (o nil)
function Travel.currentSpot(player)
	local root = rootOf(player)
	if not root then
		return nil
	end
	local pos = root.Position
	local district = WorldData.districtAt(pos.X, pos.Z)
	local pspot = S.Property.spot(player)
	if pspot then
		return pspot
	end
	-- Plató alquilado del Complejo de Estudios Prisma (solo con alquiler activo y estando dentro)
	if S.Studio then
		local sspot = S.Studio.spot(player)
		if sspot then
			return sspot
		end
	end
	if S.Home.isAtHome(player) then
		local _, _, decor = S.Inventory.best(player, "homeextra", "home", "Decor")
		local tags = { "home", "food" }
		if decor then
			tags[#tags + 1] = "studio"
		end
		return { Id = "home", Name = "Tu habitación", Tags = tags, Indoor = true, Interest = 5, Noise = 1, Busy = 0, IsHome = true, District = district and district.Id }
	end
	local vip = S.World.VipLounge
	if vip then
		local rel = pos - vip.Center
		if math.abs(rel.X) < vip.Size.X / 2 and math.abs(rel.Z) < vip.Size.Z / 2 and math.abs(rel.Y) < 15 then
			return { Id = "vip", Name = "Sala VIP", Tags = { "luxury", "event" }, Indoor = true, Interest = 12, Noise = 2, Busy = 3, District = "events", Decor = 20 }
		end
	end
	for _, sp in ipairs(WorldData.Specials) do
		local dx, dz = pos.X - sp.WX, pos.Z - sp.WZ
		if dx * dx + dz * dz <= 40 * 40 then
			if sp.Type == "store" then
				return { Id = "store_" .. sp.StoreId, Name = Catalog.Stores[sp.StoreId].Name, Tags = storeTags[sp.StoreId] or { "shop" }, Indoor = true, Interest = 8, Noise = 3, Busy = 5, District = sp.District, Decor = 12 }
			elseif sp.Type == "cafe" then
				return { Id = "cafe", Name = sp.Name, Tags = { "education", "tech", "food" }, Indoor = true, Interest = 6, Noise = 3, Busy = 5, District = sp.District, Decor = 8 }
			elseif sp.Type == "petshop" then
				return { Id = "petshop", Name = sp.Name, Tags = { "shop", "fun", "nature" }, Indoor = true, Interest = 8, Noise = 3, Busy = 4, District = sp.District, Decor = 12 }
			elseif sp.Type == "bank" then
				return { Id = "bank", Name = sp.Name, Tags = { "business" }, Indoor = true, Interest = 5, Noise = 2, Busy = 4, District = sp.District, Decor = 10 }
			elseif sp.Type == "dealer" then
				return { Id = "dealer", Name = sp.Name, Tags = { "vehicle", "luxury", "shop" }, Indoor = true, Interest = 10, Noise = 3, Busy = 4, District = sp.District, Decor = 14 }
			elseif sp.Type == "studios" then
				return { Id = "studios_lobby", Name = sp.Name, Tags = { "studio", "business" }, Indoor = true, Interest = 7, Noise = 2, Busy = 3, District = sp.District, Decor = 12 }
			elseif sp.Type == "gym" then
				return { Id = "gym", Name = sp.Name, Tags = { "fun", "urban", "sport", "fitness" }, Indoor = true, Interest = 8, Noise = 4, Busy = 5, District = sp.District, Decor = 10 }
			elseif sp.Type == "cinema" then
				return { Id = "cinema", Name = sp.Name, Tags = { "fun", "night", "event" }, Indoor = true, Interest = 8, Noise = 3, Busy = 5, District = sp.District, Decor = 12 }
			elseif sp.Type == "karaoke" then
				return { Id = "karaoke", Name = sp.Name, Tags = { "fun", "night", "event" }, Indoor = true, Interest = 10, Noise = 3, Busy = 5, District = sp.District, Decor = 12 }
			elseif sp.Type == "bowling" then
				return { Id = "bowling", Name = sp.Name, Tags = { "fun", "night" }, Indoor = true, Interest = 9, Noise = 4, Busy = 5, District = sp.District, Decor = 12 }
			elseif sp.Type == "airport" then
				return { Id = "airport_terminal", Name = sp.Name, Tags = { "travel", "urban", "business" }, Indoor = true, Interest = 9, Noise = 5, Busy = 6, District = sp.District, Decor = 10 }
			end
		end
	end
	local best, bestD = nil, Config.RecordSpotRadius
	for _, s in ipairs(WorldData.Spots) do
		local d = math.sqrt((pos.X - s.X) ^ 2 + (pos.Z - s.Z) ^ 2)
		if d <= bestD and (not s.Secret or (S.Data.get(player).Visited.Secrets[s.Id])) then
			best, bestD = s, d
		end
	end
	if best then
		-- de noche, los lugares con etiqueta "night" son más interesantes
		if S.Time.isNight() and Util.indexOf(best.Tags, "night") then
			local copy = Util.deepCopy(best)
			copy.Interest = copy.Interest + 4
			return copy
		end
		return best
	end
	return nil
end

-- Lugar genérico para fotos fuera de los puntos de grabación
function Travel.genericSpot(player)
	local root = rootOf(player)
	local d = root and WorldData.districtAt(root.Position.X, root.Position.Z)
	if not d then
		local dest = root and LifeData.destinationAt(root.Position.X, root.Position.Z)
		if dest then
			return { Id = "free_" .. dest.Id, Name = dest.Name, Tags = { "travel", "tourism" }, Indoor = false, Interest = 6, Noise = dest.Noise or 3, Busy = dest.Busy or 3, District = dest.Id }
		end
		return { Id = "outside", Name = "Afueras", Tags = { "nature" }, Indoor = false, Interest = 2, Noise = 2, Busy = 1 }
	end
	return { Id = "free_" .. d.Id, Name = d.Name, Tags = d.Tags, Indoor = false, Interest = 3, Noise = d.Noise, Busy = d.Busy, District = d.Id }
end

function Travel.markStoreVisit(player, storeId)
	local data = S.Data.get(player)
	if not data.Visited.Stores[storeId] then
		data.Visited.Stores[storeId] = true
		S.Quest.check(player)
	end
	S.Quest.tutorialEvent(player, "visit_store")
end

function Travel.taxiStop(district)
	local cx, cz = WorldData.center(district)
	return Vector3.new(cx + 24, 4, cz + WorldData.CellSize / 2 - WorldData.RoadWidth / 2 - 8)
end

function Travel.teleport(player, pos, label)
	local char = player.Character
	if not char or not rootOf(player) then
		return false
	end
	S.Net.push(player, "travelFade", { text = label })
	task.delay(0.35, function()
		if char.Parent then
			char:PivotTo(CFrame.new(pos + Vector3.new(0, 3, 0)))
		end
	end)
	return true
end

function Travel.taxiTo(player, pos, label)
	local root = rootOf(player)
	if not root then
		return false, "No puedes viajar ahora."
	end
	local abroad = LifeData.destinationAt(root.Position.X, root.Position.Z)
	if abroad then
		return false, "Estás de viaje en " .. abroad.Name .. ": vuelve en avión desde la puerta de embarque (app Viajes)."
	end
	if lastTaxi[player] and os.clock() - lastTaxi[player] < 4 then
		return false, "Espera un momento antes de pedir otro taxi."
	end
	local dist = (Vector3.new(pos.X, 0, pos.Z) - Vector3.new(root.Position.X, 0, root.Position.Z)).Magnitude
	if dist < 60 then
		return false, "Ya estás muy cerca."
	end
	local fare = math.floor((Config.TaxiBaseFare + dist * Config.TaxiPerStud) * S.Events.taxiMultiplier() + 0.5)
	if not S.Economy.spend(player, fare, "Transporte", "Taxi a " .. label) then
		return false, "El taxi cuesta $" .. fare .. "."
	end
	lastTaxi[player] = os.clock()
	local data = S.Data.get(player)
	data.Counters.taxi_rides = (data.Counters.taxi_rides or 0) + 1
	S.Quest.check(player)
	Travel.teleport(player, pos)
	return true, "🚕 Taxi a " .. label .. " ($" .. fare .. ")."
end

function Travel.Start()
	local Net = S.Net

	Net.on("Travel.Taxi", function(player, p)
		local d = WorldData.DistrictById[p.district or ""]
		if not d then
			return false, "Destino no válido."
		end
		return Travel.taxiTo(player, Travel.taxiStop(d), d.Name)
	end)

	Net.on("Travel.TaxiSpot", function(player, p)
		local spot = WorldData.SpotById[p.spot or ""]
		if not spot or spot.Secret or spot.Dest then
			return false, "Destino no válido."
		end
		return Travel.taxiTo(player, Vector3.new(spot.X, 4, spot.Z + 12), spot.Name)
	end)

	Net.on("Travel.Bus", function(player, p)
		local d = WorldData.DistrictById[p.district or ""]
		if not d or not Util.indexOf(Travel.BusLine, d.Id) then
			return false, "El autobús no llega a ese distrito."
		end
		local root = rootOf(player)
		local here = root and WorldData.districtAt(root.Position.X, root.Position.Z)
		if not here or not Util.indexOf(Travel.BusLine, here.Id) then
			return false, "Aquí no hay parada de autobús. Las paradas están en: " .. #Travel.BusLine .. " distritos de la línea."
		end
		if here.Id == d.Id then
			return false, "Ya estás en ese distrito."
		end
		if not S.Economy.spend(player, 3, "Transporte", "Autobús a " .. d.Name) then
			return false, "El billete cuesta $3."
		end
		Travel.teleport(player, Travel.taxiStop(d) + Vector3.new(-40, 0, 0))
		return true, "🚌 Autobús a " .. d.Name .. " ($3)."
	end)

	Players.PlayerRemoving:Connect(function(player)
		lastDistrict[player] = nil
		lastTaxi[player] = nil
	end)

	task.spawn(function()
		while true do
			task.wait(1.5)
			for _, player in ipairs(Players:GetPlayers()) do
				local data = S.Data.get(player)
				local root = rootOf(player)
				if data and root then
					local pos = root.Position
					local d = WorldData.districtAt(pos.X, pos.Z)
					if d and d.Id ~= lastDistrict[player] then
						lastDistrict[player] = d.Id
						player:SetAttribute("District", d.Name)
						if not data.Visited.Districts[d.Id] then
							local first = Util.count(data.Visited.Districts) == 0
							data.Visited.Districts[d.Id] = true
							if not first then
								S.Net.notify(player, "🗺 Nuevo distrito descubierto: " .. d.Name, "success")
								S.Progress.addXp(player, S.Progress.Xp.District)
								S.Quest.tutorialEvent(player, "new_district")
							end
							S.Quest.check(player)
						end
					elseif not d then
						local dest = LifeData.destinationAt(pos.X, pos.Z)
						lastDistrict[player] = nil
						local set = S.Studio and S.Studio.insideSet(player)
						player:SetAttribute("District", (dest and ("✈️ " .. dest.Name)) or (set and (set.Icon .. " " .. set.Name)) or "Afueras")
					end
					-- Tiendas
					local storeId = S.Shop.storeNear(player)
					if storeId and player:GetAttribute("InStore") ~= storeId then
						player:SetAttribute("InStore", storeId)
						Travel.markStoreVisit(player, storeId)
					elseif not storeId then
						player:SetAttribute("InStore", nil)
					end
					-- Lugar de grabación cercano (para el HUD)
					local spot = Travel.currentSpot(player)
					player:SetAttribute("Spot", spot and spot.Name or nil)
					-- Secretos
					for _, s in ipairs(WorldData.Secrets) do
						if not data.Visited.Secrets[s.Id] then
							local dx, dz = pos.X - s.WX, pos.Z - s.WZ
							if dx * dx + dz * dz < 20 * 20 then
								data.Visited.Secrets[s.Id] = true
								S.Economy.add(player, s.Reward, "Descubrimientos", "Lugar secreto: " .. s.Name, {})
								S.Net.push(player, "secret", { name = s.Name, reward = s.Reward })
								S.Progress.addXp(player, 50)
								S.Quest.check(player)
							end
						end
					end
				end
			end
		end
	end)
end

return Travel
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000059"><Properties><string name="Name">VehicleService</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- VehicleService: concesionario, alquiler, garaje, colores, mejoras, combustible/batería, mantenimiento.
--  * Cada vehículo es un modelo con VehicleSeat. Al sentarse, el conductor recibe la propiedad de red y
--    VehicleController (cliente) aplica velocidad y giro con LinearVelocity/AngularVelocity (control suave).
--  * Las ruedas son las únicas piezas que tocan el suelo (sin fricción): el movimiento lo dan las
--    restricciones, así que el control es preciso y el vehículo sube bordillos sin atascarse.
--  * El servidor mide la distancia recorrida: gasta combustible/batería y desgasta el vehículo.
--  * Sin combustible se avanza muy despacio (nunca te quedas atrapado). Repostar en la gasolinera.
--  * Maletero: mientras estás cerca de tu vehículo, la mochila gana espacios (transporte de equipos).

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local Shared = ReplicatedStorage.Shared
local LifeData = require(Shared.LifeData)
local Util = require(Shared.Util)

local Vehicle = {}
local S
local spawned = {} -- [player] = { Id, Model, Seat, Chassis, Body, Last, Near, FuelStep }

Vehicle.MaxOwned = LifeData.MaxVehicles
Vehicle.TrunkRadius = 30
Vehicle.PaintCost = LifeData.PaintCost
Vehicle.KmPerStud = 0.001 -- 1 stud = 1 m (distancias del juego)

function Vehicle.Init(services)
	S = services
end

local function rgb(t)
	return Color3.fromRGB(t[1], t[2], t[3])
end

local function vehicles(data)
	data.Vehicles = data.Vehicles or {}
	return data.Vehicles
end

local function rentalActive(data)
	return data.Rental ~= nil and data.Rental.Rec ~= nil and S.Time.day() <= (data.Rental.Until or 0)
end

-- Registro de un vehículo del jugador ("rental" = alquiler activo)
local function recOf(data, id)
	if type(id) ~= "string" then
		return nil
	end
	if id == "rental" then
		return rentalActive(data) and data.Rental.Rec or nil
	end
	return vehicles(data)[id]
end
Vehicle.recOf = recOf

Vehicle.stats = LifeData.vehicleStats
Vehicle.fuelCost = LifeData.fuelCost
Vehicle.sellValue = LifeData.sellValue
Vehicle.rentPrice = LifeData.rentPrice

function Vehicle.repairCost(player, def, rec)
	local mult = 1
	if S.Company and S.Company.repairMult then
		mult = S.Company.repairMult(player) or 1
	end
	return math.ceil(LifeData.repairCost(def, rec) * mult)
end

function Vehicle.upgradeCost(rec, key)
	return LifeData.upgradeCost(LifeData.VehicleById[rec.Model], key)
end

function Vehicle.spawnedId(player)
	local sp = spawned[player]
	return sp and sp.Id or nil
end

function Vehicle.spawnedModel(player)
	local sp = spawned[player]
	return sp and sp.Model or nil
end

-- ¿Está el jugador cerca de su vehículo? Devuelve el registro activo.
local function nearRec(player)
	local sp = spawned[player]
	local data = S.Data.get(player)
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if not sp or not data or not root or not sp.Model.Parent then
		return nil
	end
	local a, b = sp.Chassis.Position, root.Position
	local dx, dz = a.X - b.X, a.Z - b.Z
	if dx * dx + dz * dz > Vehicle.TrunkRadius * Vehicle.TrunkRadius then
		return nil
	end
	return recOf(data, sp.Id)
end

-- Espacios extra de mochila si tu vehículo está cerca
function Vehicle.trunkBonus(player)
	local rec = nearRec(player)
	return rec and Vehicle.stats(rec).Trunk or 0
end

function Vehicle.despawn(player)
	local sp = spawned[player]
	if sp and sp.Model then
		sp.Model:Destroy()
	end
	spawned[player] = nil
end

local function part(parent, name, size, cf, color, material, collide)
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.CFrame = cf
	p.Color = typeof(color) == "Color3" and color or rgb(color)
	p.Material = material or Enum.Material.SmoothPlastic
	p.CanCollide = collide == true
	p.Massless = not collide
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end

local function weld(a, b)
	local w = Instance.new("WeldConstraint")
	w.Part0 = a
	w.Part1 = b
	w.Parent = a
end

-- Rueda: cilindro con el eje en X (lateral). Choca con el suelo sin fricción.
local function wheel(m, chassis, size, cf)
	local w = part(m, "Wheel", size, cf, { 20, 20, 22 }, Enum.Material.SmoothPlastic, true)
	w.Shape = Enum.PartType.Cylinder
	w.CustomPhysicalProperties = PhysicalProperties.new(0.7, 0, 0, 100, 1)
	weld(chassis, w)
	return w
end

local function applyAttributes(model, rec)
	local st = Vehicle.stats(rec)
	model:SetAttribute("MaxSpeed", st.Speed)
	model:SetAttribute("Turn", st.Turn)
	model:SetAttribute("Fuel", rec.Fuel)
	model:SetAttribute("Cond", rec.Cond)
end

function Vehicle.buildModel(def, rec, cf, owner, id)
	local m = Instance.new("Model")
	m.Name = def.Name
	local w, h, l = def.Size[1], def.Size[2], def.Size[3]
	local color = rgb((LifeData.VehicleColors[rec.Color] or LifeData.VehicleColors[1])[2])
	-- El chasis es la pieza raíz (con masa); no choca: solo las ruedas tocan el suelo.
	local chassis = part(m, "Chassis", Vector3.new(w, 0.6, l), cf * CFrame.new(0, 1.4, 0), { 40, 40, 44 }, Enum.Material.Metal, false)
	chassis.Massless = false
	chassis.CustomPhysicalProperties = PhysicalProperties.new(2, 0, 0, 1, 1)
	m.PrimaryPart = chassis
	local two = def.Type == "Bicicleta" or def.Type == "Patinete" or def.Type == "Motocicleta"
	local seatCF = cf * CFrame.new(0, 2.6, two and 0.4 or 1)
	local body
	if two then
		body = part(m, "Body", Vector3.new(0.8, 1.2, l * 0.7), cf * CFrame.new(0, 2, 0), color, Enum.Material.Metal)
		weld(chassis, body)
		for _, z in ipairs({ -l / 2 + 1.1, l / 2 - 1.1 }) do
			wheel(m, chassis, Vector3.new(0.5, 2.2, 2.2), cf * CFrame.new(0, 1.1, z))
		end
		local bar = part(m, "Handlebar", Vector3.new(2.2, 0.3, 0.3), cf * CFrame.new(0, 3.4, -l / 2 + 1.3), { 60, 60, 66 }, Enum.Material.Metal)
		weld(chassis, bar)
		if def.Type == "Motocicleta" then
			local light = part(m, "Headlight", Vector3.new(0.8, 0.6, 0.2), cf * CFrame.new(0, 2.8, -l / 2 + 0.9), { 255, 250, 220 }, Enum.Material.Neon)
			weld(chassis, light)
		end
	else
		-- Carrocería sólida (los peatones no la atraviesan); está por encima del suelo y no roza bordillos
		body = part(m, "Body", Vector3.new(w, h * 0.42, l), cf * CFrame.new(0, 1.7 + h * 0.21, 0), color, Enum.Material.SmoothPlastic, true)
		body.Massless = true
		weld(chassis, body)
		local cargo = def.Type == "Furgoneta" or def.Type == "Vehículo de carga"
		local cabinLen = cargo and l * 0.85 or l * 0.5
		local cabin = part(m, "Cabin", Vector3.new(w - 0.4, h * 0.4, cabinLen), cf * CFrame.new(0, 1.7 + h * 0.62, def.Type == "Vehículo de carga" and -l * 0.05 or 0.6), { 40, 50, 60 }, Enum.Material.Glass)
		cabin.Transparency = 0.25
		weld(chassis, cabin)
		for _, x in ipairs({ -w / 2 + 0.4, w / 2 - 0.4 }) do
			for _, z in ipairs({ -l / 2 + 2, l / 2 - 2 }) do
				wheel(m, chassis, Vector3.new(1.2, 2.4, 2.4), cf * CFrame.new(x, 1.2, z))
			end
		end
		for _, x in ipairs({ -w / 2 + 1, w / 2 - 1 }) do
			local light = part(m, "Headlight", Vector3.new(1, 0.6, 0.2), cf * CFrame.new(x, 1.7 + h * 0.21, -l / 2 - 0.1), { 255, 250, 220 }, Enum.Material.Neon)
			weld(chassis, light)
			local back = part(m, "Taillight", Vector3.new(1, 0.5, 0.2), cf * CFrame.new(x, 1.7 + h * 0.21, l / 2 + 0.1), { 220, 30, 30 }, Enum.Material.Neon)
			weld(chassis, back)
		end
	end
	local seat = Instance.new("VehicleSeat")
	seat.Name = "DriveSeat"
	seat.Size = Vector3.new(2, 0.6, 2)
	seat.CFrame = seatCF
	seat.Transparency = two and 0 or 1
	seat.Color = Color3.fromRGB(30, 30, 34)
	seat.MaxSpeed = 0
	seat.Torque = 0
	seat.HeadsUpDisplay = false
	seat.Massless = true
	seat.Parent = m
	weld(chassis, seat)
	-- Movimiento controlado por el conductor (ver cliente VehicleController)
	local att = Instance.new("Attachment")
	att.Name = "DriveAttachment"
	att.Parent = chassis
	local lv = Instance.new("LinearVelocity")
	lv.Name = "Drive"
	lv.Attachment0 = att
	lv.VelocityConstraintMode = Enum.VelocityConstraintMode.Plane
	lv.PrimaryTangentAxis = Vector3.new(1, 0, 0)
	lv.SecondaryTangentAxis = Vector3.new(0, 0, 1)
	lv.RelativeTo = Enum.ActuatorRelativeTo.World
	lv.MaxForce = 1e6
	lv.PlaneVelocity = Vector2.new(0, 0)
	lv.Parent = chassis
	local av = Instance.new("AngularVelocity")
	av.Name = "Steer"
	av.Attachment0 = att
	av.RelativeTo = Enum.ActuatorRelativeTo.World
	av.MaxTorque = 1e7
	av.AngularVelocity = Vector3.new(0, 0, 0)
	av.Parent = chassis
	m:SetAttribute("YTVehicle", true)
	m:SetAttribute("VehicleId", id)
	m:SetAttribute("Model", def.Id)
	m:SetAttribute("FuelType", def.Fuel)
	m:SetAttribute("Owner", owner.UserId)
	applyAttributes(m, rec)
	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.fromOffset(180, 28)
	bb.StudsOffset = Vector3.new(0, h + 2, 0)
	bb.MaxDistance = 60
	bb.Parent = chassis
	local t = Instance.new("TextLabel")
	t.Size = UDim2.fromScale(1, 1)
	t.BackgroundTransparency = 0.4
	t.BackgroundColor3 = Color3.fromRGB(20, 20, 24)
	t.TextColor3 = Color3.new(1, 1, 1)
	t.TextScaled = true
	t.Font = Enum.Font.GothamBold
	t.Text = (two and "🛵 " or "🚗 ") .. owner.DisplayName
	t.Parent = bb
	m.Parent = workspace
	seat:GetPropertyChangedSignal("Occupant"):Connect(function()
		local hum = seat.Occupant
		if hum then
			local p = Players:GetPlayerFromCharacter(hum.Parent)
			if p ~= owner then
				-- solo el dueño conduce; los demás bajan
				task.defer(function()
					hum.Sit = false
				end)
				return
			end
			pcall(function()
				chassis:SetNetworkOwner(p)
			end)
		else
			lv.PlaneVelocity = Vector2.new(0, 0)
			av.AngularVelocity = Vector3.new(0, 0, 0)
		end
	end)
	return m, seat, chassis, body
end

-- Dónde aparece el vehículo: en la zona de entrega si estás en el concesionario; si no, delante de ti.
local function spawnCFrame(player, root)
	local dealer = S.World.nearSpecial(player, "dealer", 45)
	if dealer then
		local p = Vector3.new(dealer.WX + 14, 1.2, dealer.WZ + 40)
		return CFrame.lookAt(p, p + Vector3.new(0, 0, 1))
	end
	local look = root.CFrame and root.CFrame.LookVector or Vector3.new(0, 0, -1)
	local flat = Vector3.new(look.X, 0, look.Z)
	if flat.Magnitude < 0.1 then
		flat = Vector3.new(0, 0, -1)
	end
	flat = flat.Unit
	local pos = root.Position + flat * 10
	local base = Vector3.new(pos.X, 1.2, pos.Z)
	return CFrame.lookAt(base, base + flat)
end

function Vehicle.spawn(player, id, rec)
	local def = LifeData.VehicleById[rec.Model]
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if not def or not root then
		return false, "No puedes sacar el vehículo ahora."
	end
	if S.Home.isAtHome(player) or S.Property.inside(player) then
		return false, "Sal a la calle para usar tu vehículo."
	end
	Vehicle.despawn(player)
	local cf = spawnCFrame(player, root)
	local model, seat, chassis, body = Vehicle.buildModel(def, rec, cf, player, id)
	spawned[player] = { Id = id, Model = model, Seat = seat, Chassis = chassis, Body = body, Last = chassis.Position, Near = nil, FuelStep = math.floor(rec.Fuel / 5) }
	S.Data.markDirty(player)
	return true, (def.Fuel == "none" and "🚲 " or "🚗 ") .. def.Name .. " listo. Siéntate (E) para conducir: W/S acelerar y frenar, A/D girar, Espacio para bajar.", { id = id }
end

-- Recorrido de un segundo: combustible, desgaste, cuentakilómetros y logros
function Vehicle.trackDistance(player, sp, data)
	local pos = sp.Chassis.Position
	local d = (Vector3.new(pos.X, 0, pos.Z) - Vector3.new(sp.Last.X, 0, sp.Last.Z)).Magnitude
	sp.Last = pos
	if d <= 0.5 or d >= 400 then
		return 0
	end
	local rec = recOf(data, sp.Id)
	if not rec then
		return 0
	end
	local def = LifeData.VehicleById[rec.Model]
	rec.Odo = (rec.Odo or 0) + d
	if def.Fuel ~= "none" then
		local before = rec.Fuel
		rec.Fuel = math.max(0, rec.Fuel - d * def.Use / 300)
		if before > 0 and rec.Fuel <= 0 then
			S.Net.notify(player, def.Fuel == "battery" and "🔋 Batería agotada: vas muy despacio. Carga en una gasolinera o en casa." or "⛽ Sin combustible: vas muy despacio. Reposta en una gasolinera.", "warn")
		elseif before >= 15 and rec.Fuel < 15 then
			S.Net.notify(player, def.Fuel == "battery" and "🔋 Batería baja (" .. math.floor(rec.Fuel) .. "%)." or "⛽ Queda poco combustible (" .. math.floor(rec.Fuel) .. "%).", "warn")
		end
	end
	rec.Cond = math.max(20, rec.Cond - d / 2000)
	local km0 = data.Counters.drive_km or 0
	data.Counters.drive_m = (data.Counters.drive_m or 0) + d
	data.Counters.drive_km = math.floor(data.Counters.drive_m * Vehicle.KmPerStud)
	applyAttributes(sp.Model, rec)
	local step = math.floor(rec.Fuel / 5)
	if data.Counters.drive_km > km0 then
		S.Quest.check(player)
		S.Data.markDirty(player)
	elseif step ~= sp.FuelStep then
		S.Data.markDirty(player)
	end
	sp.FuelStep = step
	return d
end

function Vehicle.tick()
	for player, sp in pairs(spawned) do
		local data = S.Data.get(player)
		if not data or not player.Parent or not sp.Model.Parent or not sp.Chassis.Parent then
			if sp.Model then
				sp.Model:Destroy()
			end
			spawned[player] = nil
		elseif sp.Id == "rental" and not rentalActive(data) then
			Vehicle.despawn(player)
			data.Rental = nil
			S.Data.markDirty(player)
			S.Net.notify(player, "🔑 El alquiler ha terminado: el vehículo vuelve al concesionario.", "info")
		else
			Vehicle.trackDistance(player, sp, data)
			-- El maletero cambia la capacidad de la mochila: avisar al cliente al acercarse/alejarse
			local near = nearRec(player) ~= nil
			if near ~= sp.Near then
				sp.Near = near
				S.Data.markDirty(player)
			end
		end
	end
end

function Vehicle.Start()
	local Net = S.Net

	Net.on("Veh.Buy", function(player, p)
		local data = S.Data.get(player)
		local def = LifeData.VehicleById[p.model or ""]
		if not def then
			return false, "Modelo no válido."
		end
		if not S.World.nearSpecial(player, "dealer", 45) then
			return false, "Compra vehículos en el Concesionario Motor City (Distrito de concesionarios)."
		end
		if data.Level < def.Level then
			return false, "Necesitas nivel " .. def.Level .. "."
		end
		if Util.count(vehicles(data)) >= Vehicle.MaxOwned then
			return false, "Tu garaje está lleno (" .. Vehicle.MaxOwned .. " vehículos). Vende alguno primero."
		end
		local color = Util.clamp(math.floor(tonumber(p.color) or 1), 1, #LifeData.VehicleColors)
		local price = math.floor(def.Price * S.Events.priceMultiplier({ Cat = "vehicle" }) + 0.5)
		if not S.Economy.spend(player, price, "Vehículos", "Compra de " .. def.Name) then
			return false, "Cuesta $" .. Util.formatInt(price) .. ". Puedes alquilarlo mientras ahorras."
		end
		local id = S.Data.nextUid(player, "car")
		vehicles(data)[id] = { Model = def.Id, Color = color, Fuel = 100, Cond = 100, Upgrades = {}, Odo = 0, Paid = price, Extra = 0, Bought = S.Time.day() }
		data.Counters.vehicles_bought = (data.Counters.vehicles_bought or 0) + 1
		S.Quest.check(player)
		return true, "🔑 ¡" .. def.Name .. " es tuyo! Sácalo desde la app Vehículos (pestaña Mi garaje).", { id = id }
	end)

	Net.on("Veh.Rent", function(player, p)
		local data = S.Data.get(player)
		local def = LifeData.VehicleById[p.model or ""]
		if not def then
			return false, "Modelo no válido."
		end
		if not S.World.nearSpecial(player, "dealer", 45) then
			return false, "Alquila en el Concesionario Motor City."
		end
		if data.Level < def.Level then
			return false, "Necesitas nivel " .. def.Level .. " para conducirlo."
		end
		local color = Util.clamp(math.floor(tonumber(p.color) or 1), 1, #LifeData.VehicleColors)
		local price = Vehicle.rentPrice(def)
		if not S.Economy.spend(player, price, "Vehículos", "Alquiler de " .. def.Name .. " (1 día)") then
			return false, "El alquiler cuesta $" .. Util.formatInt(price) .. "."
		end
		if spawned[player] and spawned[player].Id == "rental" then
			Vehicle.despawn(player)
		end
		data.Rental = { Until = S.Time.day() + 1, Rec = { Model = def.Id, Color = color, Fuel = 100, Cond = 100, Upgrades = {}, Odo = 0 } }
		data.Counters.rentals_car = (data.Counters.rentals_car or 0) + 1
		local ok, msg = Vehicle.spawn(player, "rental", data.Rental.Rec)
		return true, "Alquilado hasta el día " .. data.Rental.Until .. ". " .. (ok and msg or ""), { id = "rental" }
	end)

	Net.on("Veh.Spawn", function(player, p)
		local data = S.Data.get(player)
		if p.id == "rental" and not rentalActive(data) then
			data.Rental = nil
			return false, "No tienes un alquiler activo."
		end
		local rec = recOf(data, p.id)
		if not rec then
			return false, "No tienes ese vehículo."
		end
		return Vehicle.spawn(player, p.id, rec)
	end)

	Net.on("Veh.Store", function(player)
		if not spawned[player] then
			return false, "No tienes ningún vehículo fuera."
		end
		Vehicle.despawn(player)
		return true, "Vehículo guardado en el garaje."
	end)

	local function refuelOrRepair(player, p, kind)
		local data = S.Data.get(player)
		local rec = recOf(data, p.id)
		if not rec then
			return false, "No tienes ese vehículo."
		end
		local def = LifeData.VehicleById[rec.Model]
		local msg
		if kind == "fuel" then
			if def.Fuel == "none" then
				return false, "La bicicleta no necesita combustible."
			end
			if not S.World.nearSpecial(player, "gas", 40) and not (def.Fuel == "battery" and S.Home.isAtHome(player)) then
				return false, def.Fuel == "battery" and "Carga en una gasolinera (tienen cargadores) o desde casa." or "Reposta en una gasolinera (Distrito industrial, Zona de apartamentos o Zona costera)."
			end
			if rec.Fuel > 99 then
				return false, def.Fuel == "battery" and "La batería ya está llena." or "El depósito ya está lleno."
			end
			local cost = Vehicle.fuelCost(def, rec)
			if not S.Economy.spend(player, cost, "Transporte", (def.Fuel == "battery" and "Carga de " or "Combustible para ") .. def.Name) then
				return false, "Cuesta $" .. cost .. "."
			end
			rec.Fuel = 100
			data.Counters.refuels = (data.Counters.refuels or 0) + 1
			msg = def.Fuel == "battery" and "🔋 Batería cargada al 100 % ($" .. cost .. ")." or "⛽ Depósito lleno ($" .. cost .. ")."
		else
			if rec.Cond >= 100 then
				return false, "Está perfecto."
			end
			if not S.World.nearSpecial(player, "gas", 40) and not S.World.nearSpecial(player, "dealer", 45) then
				return false, "El taller está en las gasolineras y en el concesionario."
			end
			local cost = Vehicle.repairCost(player, def, rec)
			if not S.Economy.spend(player, cost, "Reparaciones", "Taller: " .. def.Name) then
				return false, "La reparación cuesta $" .. Util.formatInt(cost) .. "."
			end
			rec.Cond = 100
			msg = "🔧 Vehículo reparado ($" .. Util.formatInt(cost) .. ")."
		end
		local sp = spawned[player]
		if sp and sp.Id == p.id then
			applyAttributes(sp.Model, rec)
		end
		return true, msg
	end
	Net.on("Veh.Refuel", function(player, p)
		return refuelOrRepair(player, p, "fuel")
	end)
	Net.on("Veh.Repair", function(player, p)
		return refuelOrRepair(player, p, "repair")
	end)

	Net.on("Veh.Upgrade", function(player, p)
		local data = S.Data.get(player)
		local rec = vehicles(data)[p.id or ""]
		local up = LifeData.VehicleUpgrades[p.key or ""]
		if not rec or not up then
			return false, "Mejora no válida."
		end
		rec.Upgrades = rec.Upgrades or {}
		if rec.Upgrades[p.key] then
			return false, "Ya instalada."
		end
		if not S.World.nearSpecial(player, "dealer", 45) then
			return false, "Las mejoras se instalan en el taller del concesionario."
		end
		local cost = Vehicle.upgradeCost(rec, p.key)
		if not S.Economy.spend(player, cost, "Vehículos", up.Name .. " (" .. LifeData.VehicleById[rec.Model].Name .. ")") then
			return false, "Cuesta $" .. Util.formatInt(cost) .. "."
		end
		rec.Upgrades[p.key] = true
		rec.Extra = (rec.Extra or 0) + cost
		local sp = spawned[player]
		if sp and sp.Id == p.id then
			applyAttributes(sp.Model, rec)
		end
		return true, "Mejora instalada: " .. up.Name .. " (" .. up.Desc .. ")."
	end)

	Net.on("Veh.Paint", function(player, p)
		local data = S.Data.get(player)
		local rec = vehicles(data)[p.id or ""]
		local c = tonumber(p.color)
		if not rec or not c or not LifeData.VehicleColors[c] then
			return false, "Color no válido."
		end
		c = math.floor(c)
		if rec.Color == c then
			return false, "Ya tiene ese color."
		end
		if not S.World.nearSpecial(player, "dealer", 45) then
			return false, "Pinta tu vehículo en el taller del concesionario."
		end
		if not S.Economy.spend(player, Vehicle.PaintCost, "Vehículos", "Pintura") then
			return false, "La pintura cuesta $" .. Vehicle.PaintCost .. "."
		end
		rec.Color = c
		local sp = spawned[player]
		if sp and sp.Id == p.id and sp.Body then
			sp.Body.Color = rgb(LifeData.VehicleColors[c][2])
		end
		return true, "🎨 Color cambiado a " .. LifeData.VehicleColors[c][1] .. "."
	end)

	Net.on("Veh.Sell", function(player, p)
		local data = S.Data.get(player)
		local rec = vehicles(data)[p.id or ""]
		if not rec then
			return false, "No tienes ese vehículo."
		end
		if spawned[player] and spawned[player].Id == p.id then
			Vehicle.despawn(player)
		end
		local value = Vehicle.sellValue(rec)
		vehicles(data)[p.id] = nil
		S.Economy.add(player, value, "Vehículos", "Venta de " .. LifeData.VehicleById[rec.Model].Name, {})
		return true, "Vendido por $" .. Util.formatInt(value) .. "."
	end)

	Players.PlayerRemoving:Connect(Vehicle.despawn)

	-- Consumo y desgaste según la distancia recorrida
	task.spawn(function()
		while true do
			task.wait(1)
			local ok, err = pcall(Vehicle.tick)
			if not ok then
				S.Net.logError("vehicles", err)
			end
		end
	end)
end

return Vehicle
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000060"><Properties><string name="Name">VideoService</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- VideoService: ciclo completo de creación de vídeos.
--   IDEA -> PLAN -> MOCHILA -> VIAJE -> GRABACIÓN (escenas) / FOTOS -> IMPORTAR -> EDICIÓN
--   -> EXPORTACIÓN -> MINIATURA -> PUBLICACIÓN -> RESULTADOS (ChannelService)
-- Todo se calcula en el servidor con VideoFormulas y el equipo REAL que lleva el jugador.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Catalog = require(Shared.ItemCatalog)
local VideoData = require(Shared.VideoData)
local F = require(Shared.VideoFormulas)
local Util = require(Shared.Util)

local Video = {}
local S
local recording = {} -- [player] = { Pid, UseCamera, Last }
local collabRec = {} -- [player] = { UseCamera, Last } al grabar en el proyecto de otro (colaboración)
local lastPhoto = {}

Video.GbScale = 10

function Video.Init(services)
	S = services
end

local function projectSlots(player)
	return Config.BaseProjectSlots + S.Monetization.perk(player, "ProjectSlots")
end

local function getProject(player, pid)
	local data = S.Data.get(player)
	return type(pid) == "string" and data.Projects[pid] or nil
end

local function newEdit()
	return { Timeline = {}, Titles = false, TitleText = "", Subtitles = false, Music = "none", MusicVol = 0.3, VoiceVol = 1,
		Effects = {}, Color = { b = 0, c = 0, s = 0 }, Intro = "none", Outro = "none" }
end

---------------------------------------------------------------------------
-- Equipo usado para grabar
---------------------------------------------------------------------------
-- Devuelve una descripción del equipo disponible ahora mismo (según dónde esté el jugador)
function Video.gear(player, preferPhone)
	local atHome = S.Home.isAtHome(player)
	local gear = {}
	local camUid, camRec, camDef = S.Inventory.best(player, "camera", "backpack", "Video")
	if not camUid and atHome then
		camUid, camRec, camDef = S.Inventory.best(player, "camera", "home", "Video")
	end
	local phoneRec, phoneDef, phoneUid = S.Inventory.phone(player)
	if camUid and not preferPhone then
		gear.DeviceUid, gear.DeviceRec, gear.Device, gear.IsPhone = camUid, camRec, camDef, false
	elseif phoneRec then
		gear.DeviceUid, gear.DeviceRec, gear.Device, gear.IsPhone = phoneUid, phoneRec, phoneDef, true
	end
	local function pick(slot, stat)
		local uid, rec, def = S.Inventory.best(player, slot, "backpack", stat)
		if not uid and atHome then
			uid, rec, def = S.Inventory.best(player, slot, "home", stat)
		end
		return def, rec, uid
	end
	gear.Mic = pick("mic", "Audio")
	if gear.Mic and not gear.Mic.Portable and not atHome then
		gear.Mic = nil
	end
	gear.Tripod = pick("tripod", "Stability")
	gear.Gimbal = pick("gimbal", "Stab")
	gear.Mount = gear.IsPhone and pick("mount", "Stab") or nil
	gear.Light = pick("light", "Light")
	gear.Drone = pick("drone")
	if atHome then
		gear.HomeLight = S.Inventory.best(player, "homelight", "home", "Light") and select(3, S.Inventory.best(player, "homelight", "home", "Light"))
		gear.Decor = select(3, S.Inventory.best(player, "homeextra", "home", "Decor"))
		local tp = nil
		for _, rec in pairs(S.Data.get(player).Inventory) do
			if rec.Id == "teleprompter" and rec.Loc == "home" then
				tp = Catalog.get("teleprompter")
			end
		end
		gear.Teleprompter = tp
	end
	gear.AtHome = atHome
	return gear
end

local function drainBattery(player, gear)
	local rec, def = gear.DeviceRec, gear.Device
	local drain = 100 / math.max(1, def.Stats.Battery or 10)
	if rec.Charge >= drain - 0.01 then
		rec.Charge = math.max(0, rec.Charge - drain)
		return true, rec.Charge < drain
	end
	if not gear.IsPhone then
		-- usar una batería de repuesto de la mochila
		local data = S.Data.get(player)
		for _, brec in pairs(data.Inventory) do
			local bdef = Catalog.get(brec.Id)
			if bdef.Slot == "battery" and brec.Loc == "backpack" and brec.Charge > 1 then
				brec.Charge = math.max(0, brec.Charge - 100 / bdef.Stats.Charges)
				rec.Charge = 100 - drain
				S.Net.notify(player, "🔋 Batería de repuesto colocada.", "info")
				return true, false
			end
		end
	end
	return false
end

---------------------------------------------------------------------------
-- Escena
---------------------------------------------------------------------------
local function featuredFrom(player, p, spot, gear)
	-- Producto propio (en la mochila o en casa si grabas en casa)
	local data = S.Data.get(player)
	if type(p.featuredUid) == "string" and data.Inventory[p.featuredUid] then
		local rec = data.Inventory[p.featuredUid]
		if rec.Loc == "backpack" or (gear.AtHome and rec.Loc == "home") then
			local def = Catalog.get(rec.Id)
			return def, true
		end
		return nil, nil, "Ese producto no está contigo: llévalo en la mochila."
	end
	-- Producto de exposición en la tienda donde estás (prueba en tienda, sin poseerlo)
	if type(p.featuredStoreItem) == "string" then
		local def = Catalog.get(p.featuredStoreItem)
		local storeId = S.Shop.storeNear(player)
		if def and storeId and Util.indexOf(def.Stores, storeId) then
			return def, false
		end
		return nil, nil, "Solo puedes probar productos de exposición dentro de la tienda que los vende."
	end
	return nil
end

function Video.recordScene(player, p)
	local data = S.Data.get(player)
	local rec = recording[player]
	local proj, owner
	local ownerId = tonumber(p.owner)
	if ownerId and ownerId ~= player.UserId then
		-- Colaboración: grabar en el proyecto de otro jugador (con permiso y cerca de él)
		if not S.Collab then
			return false, "Las colaboraciones no están disponibles."
		end
		local ok, err
		ok, err, proj, owner = S.Collab.canRecord(player, ownerId, p.pid)
		if not ok then
			return false, err
		end
		collabRec[player] = collabRec[player] or { Last = 0 }
		rec = collabRec[player]
		rec.UseCamera = p.usePhone ~= true
	else
		if not rec then
			return false, "No estás grabando. Pulsa GRABAR primero."
		end
		proj = data.Projects[rec.Pid]
		if not proj then
			recording[player] = nil
			return false, "El proyecto ya no existe."
		end
	end
	if #proj.Scenes >= Config.MaxScenesPerProject then
		return false, "Este proyecto ya tiene el máximo de escenas (" .. Config.MaxScenesPerProject .. ")."
	end
	if os.clock() - (rec.Last or 0) < Config.SceneCooldown then
		return false, "Espera un momento entre tomas."
	end
	local shot = VideoData.ShotById[p.shot or ""]
	if not shot then
		return false, "Tipo de toma no válido."
	end
	local spot = S.Travel.currentSpot(player)
	if not spot then
		return false, "Aquí no hay nada interesante que grabar. Busca un lugar 🎥, una tienda o tu casa."
	end
	local gear = Video.gear(player, not rec.UseCamera)
	if not gear.Device then
		return false, "No tienes con qué grabar."
	end
	if shot.NeedsTripod and not gear.Tripod then
		return false, "El time-lapse necesita un trípode en la mochila."
	end
	if shot.NeedsDrone and (not gear.Drone or spot.Indoor) then
		return false, "La toma aérea necesita un dron en la mochila y estar al aire libre."
	end
	if shot.NeedsPeople and (spot.Busy or 0) < 4 and not Util.indexOf(spot.Tags, "event") then
		return false, "No hay nadie para entrevistar aquí. Prueba en un lugar concurrido."
	end
	local product, owned, perr = featuredFrom(player, p, spot, gear)
	if perr then
		return false, perr
	end
	if shot.NeedsProduct and not product then
		return false, "El plano de producto necesita un producto: elige uno de tu mochila o uno expuesto en la tienda."
	end
	local okBattery, low = drainBattery(player, gear)
	if not okBattery then
		return false, "Batería agotada. Vuelve a casa a cargar, lleva baterías de repuesto o cambia al teléfono."
	end

	local cat = VideoData.CategoryById[proj.Category]
	local hour = S.Time.hour()
	local stats = {}
	for k, v in pairs(gear.Device.Stats) do
		stats[k] = v
	end
	local cf = S.Inventory.condFactor(gear.DeviceRec)
	stats.Video = stats.Video * cf
	stats.Audio = gear.IsPhone and 25 or (gear.Device.Sub == "Vlog" and 42 or 30)
	local result = F.scene({
		shot = shot,
		device = stats,
		micAudio = gear.Mic and gear.Mic.Stats.Audio or nil,
		micPortable = gear.Mic and gear.Mic.Portable or false,
		tripod = gear.Tripod and gear.Tripod.Stats.Stability or 0,
		gimbal = gear.Gimbal and gear.Gimbal.Stats.Stab or 0,
		mount = gear.Mount and gear.Mount.Stats.Stab or 0,
		portableLight = gear.Light and gear.Light.Stats.Light or 0,
		homeLight = (spot.IsHome and ((gear.HomeLight and gear.HomeLight.Stats.Light or 0) + (spot.ExtraLight or 0)) or 0) + (spot.StudioLight or 0),
		decor = spot.Decor or (spot.IsHome and (5 + (gear.Decor and gear.Decor.Stats.Decor or 0))) or 0,
		presentation = spot.IsHome and gear.Teleprompter and gear.Teleprompter.Stats.Presentation or 0,
		indoor = spot.Indoor,
		hour = hour,
		goldenHour = F.isGoldenHour(hour),
		weather = S.Time.Weather,
		spotTags = spot.Tags,
		spotInterest = spot.Interest * S.Events.sceneBonus(spot) + (S.Needs and S.Needs.interestBonus(player) or 0) + (S.Pet and S.Pet.interestBonus(player) or 0) + (S.Friend and S.Friend.interestBonus(player, rec.Pid) or 0) + (S.Leisure and S.Leisure.interestBonus(player, cat) or 0),
		spotNoise = spot.Noise,
		busy = spot.Busy,
		categoryTags = cat.Tags,
		productQuality = product and product.Quality or nil,
		batteryLow = low,
	})

	local idData = owner and S.Data.get(owner) or data -- los ids de escena son del dueño del proyecto
	idData.Counters.scene_id = (idData.Counters.scene_id or 0) + 1
	local scene = {
		Id = "s" .. idData.Counters.scene_id,
		By = player.UserId,
		Shot = shot.Id,
		Spot = spot.Id,
		SpotName = spot.Name,
		District = spot.District,
		Q = math.min(100, Util.round(result.Quality + (S.Company and S.Company.sceneBonus(player) or 0) + (S.Studio and S.Studio.sceneBonus(player) or 0), 1)),
		Img = result.Image,
		Aud = result.Audio,
		Light = result.Lighting,
		Int = result.Interest,
		Probs = result.Problems,
		Sec = result.Seconds,
		Dev = gear.Device.Name,
		Gb = Util.round((gear.Device.Stats.GbPerMin or 1) * result.Seconds / 60 * Video.GbScale, 1),
		Imp = false,
		Feat = product and product.Id or nil,
		Own = owned,
		Hour = Util.round(hour, 1),
		W = S.Time.Weather,
	}
	table.insert(proj.Scenes, scene)
	if proj.Status == "planning" then
		proj.Status = "recording"
	end
	rec.Last = os.clock()
	-- desgaste leve del equipo
	gear.DeviceRec.Cond = math.max(30, gear.DeviceRec.Cond - 0.15)

	data.Counters.scenes = (data.Counters.scenes or 0) + 1
	if F.isGoldenHour(hour) and not spot.Indoor then
		data.Counters.golden_scenes = (data.Counters.golden_scenes or 0) + 1
	end
	if spot.District then
		data.Visited.Recorded[spot.District] = true
	end
	S.Progress.addXp(player, S.Progress.Xp.Scene)
	S.Events.onScene(player, spot)
	S.Jobs.onScene(player, scene)
	if S.Friend then
		S.Friend.onScene(player, scene, rec.Pid)
	end
	if S.Needs then
		S.Needs.spend(player, 1)
	end
	if owner and S.Collab then
		S.Collab.onScene(player, owner, proj, scene)
	end
	S.Quest.tutorialEvent(player, "record_scene")
	S.Quest.check(player)
	local msg = "🎬 " .. shot.Name .. " en " .. spot.Name .. " — calidad " .. math.floor(scene.Q)
	if owner then
		msg = msg .. " · para «" .. proj.Name .. "»"
	end
	if #scene.Probs > 0 then
		msg = msg .. " (" .. table.concat(scene.Probs, ", ") .. ")"
	end
	return true, msg, { scene = scene, charge = gear.DeviceRec.Charge }
end

---------------------------------------------------------------------------
-- Fotografías
---------------------------------------------------------------------------
function Video.photoCapacity(player)
	local phoneRec, phoneDef = S.Inventory.phone(player)
	local cap = phoneDef and phoneDef.Stats.PhotoStorage or 40
	if S.Inventory.best(player, "camera", "any", "Photo") then
		cap = cap + 60
	end
	return math.min(Config.MaxPhotos, cap)
end

local function num(v, lo, hi)
	v = tonumber(v)
	if not v or v ~= v then
		return nil
	end
	return Util.clamp(v, lo, hi)
end

function Video.takePhoto(player, p)
	local data = S.Data.get(player)
	if os.clock() - (lastPhoto[player] or 0) < Config.PhotoCooldown then
		return false, "Espera un momento."
	end
	local mode = VideoData.PhotoModeById[p.mode or ""]
	if not mode then
		return false, "Modo de foto no válido."
	end
	-- Modo mascota: solo con tu mascota cerca (+8 de calidad)
	local petBonus, petRec = 0, nil
	if mode.Id == "pet" then
		if not S.Pet then
			return false, "Necesitas una mascota contigo para hacer una foto de mascota."
		end
		local bonus, info = S.Pet.photoBonus(player)
		if not bonus then
			return false, info
		end
		petBonus, petRec = bonus, info
	end
	if #data.Photos >= Video.photoCapacity(player) then
		return false, "Álbum lleno (" .. #data.Photos .. " fotos). Borra fotos o consigue más almacenamiento (mejor teléfono o una cámara)."
	end
	local spot = S.Travel.currentSpot(player) or S.Travel.genericSpot(player)
	local gear = Video.gear(player, false)
	-- Para fotos se usa el dispositivo con mejor calidad fotográfica
	local camUid, camRec, camDef = S.Inventory.best(player, "camera", "backpack", "Photo")
	local phoneRec, phoneDef = S.Inventory.phone(player)
	local dev, devRec = phoneDef, phoneRec
	if camDef and (not phoneDef or camDef.Stats.Photo > phoneDef.Stats.Photo) then
		dev, devRec = camDef, camRec
	end
	if not dev then
		return false, "No tienes cámara ni teléfono."
	end
	local product = nil
	if mode.NeedsProduct then
		local def, owned, perr = featuredFrom(player, p, spot, gear)
		if not def then
			return false, perr or "Elige un producto para la foto de producto."
		end
		product = def
	end
	local hour = S.Time.hour()
	local stats = {}
	for k, v in pairs(dev.Stats) do
		stats[k] = v
	end
	stats.Photo = stats.Photo * S.Inventory.condFactor(devRec)
	local result = F.photo({
		mode = mode,
		device = stats,
		indoor = spot.Indoor,
		hour = hour,
		goldenHour = F.isGoldenHour(hour),
		weather = S.Time.Weather,
		spotTags = spot.Tags,
		homeLight = (spot.IsHome and ((gear.HomeLight and gear.HomeLight.Stats.Light or 0) + (spot.ExtraLight or 0)) or 0) + (spot.StudioLight or 0),
		portableLight = gear.Light and gear.Light.Stats.Light or 0,
		tripod = gear.Tripod and gear.Tripod.Stats.Stability or 0,
		composition = num(p.composition, 0, 10) or 5,
	})
	if petBonus > 0 then
		result.Quality = Util.round(Util.clamp(result.Quality + petBonus, 1, 100), 1)
	end
	-- Estudio fotográfico y demás platós alquilados: +calidad mientras estás dentro con el alquiler activo
	if S.Studio then
		local studioBonus = S.Studio.photoBonus(player)
		if studioBonus > 0 then
			result.Quality = Util.round(Util.clamp(result.Quality + studioBonus, 1, 100), 1)
		end
	end
	data.Counters.photo_id = (data.Counters.photo_id or 0) + 1
	local cam = nil
	if type(p.cam) == "table" then
		local c = {}
		for i = 1, 6 do
			c[i] = num(p.cam[i], -5000, 5000)
		end
		if c[6] then
			cam = c
		end
	end
	local filter = math.floor(num(p.filter, 1, #VideoData.PhotoFilters) or 1)
	local photo = {
		Id = "f" .. data.Counters.photo_id,
		Mode = mode.Id,
		Q = result.Quality,
		Spot = spot.Id,
		SpotName = spot.Name,
		District = spot.District,
		Tags = spot.Tags,
		Hour = Util.round(hour, 1),
		W = S.Time.Weather,
		T = os.time(),
		Filter = filter,
		Cam = cam,
		Fov = num(p.fov, 20, 100) or 70,
		Album = "General",
		Dev = dev.Name,
		Prod = product and product.Id or nil,
		Pet = petRec and petRec.Name or nil,
		Probs = result.Problems,
	}
	table.insert(data.Photos, 1, photo)
	lastPhoto[player] = os.clock()
	data.Counters.photos = (data.Counters.photos or 0) + 1
	if petRec then
		data.Counters.pet_photos = (data.Counters.pet_photos or 0) + 1
	end
	if mode.Night and S.Time.isNight() then
		data.Counters.night_photos = (data.Counters.night_photos or 0) + 1
	end
	S.Progress.addXp(player, S.Progress.Xp.Photo)
	S.Quest.check(player)
	-- Encargos de fotógrafo (JobsService) y concursos de eventos
	S.Jobs.onPhoto(player, photo)
	S.Events.onPhoto(player, photo)
	return true, "📸 Foto guardada (" .. mode.Name .. ", calidad " .. math.floor(photo.Q) .. ")", { photo = photo }
end

---------------------------------------------------------------------------
-- Edición
---------------------------------------------------------------------------
local function canEdit(player)
	if S.Computer.hasSession(player) then
		return true, S.Computer.sessionStats(player)
	end
	local _, _, tab = S.Inventory.best(player, "tablet", "backpack", "EditLite")
	if tab and (tab.Stats.EditLite or 0) > 0 then
		return true, { MaxScenes = tab.Stats.EditLite, ColorAcc = 55, ProColor = 0, AudioMix = 10, Kind = "tablet", RenderMult = 0.8, EditSpeed = 0, Comfort = 0 }
	end
	return false
end

local function validEdit(proj, data, edit, maxScenes)
	if type(edit) ~= "table" or type(edit.Timeline) ~= "table" then
		return nil, "Edición no válida."
	end
	if #edit.Timeline > maxScenes then
		return nil, "Tu equipo solo puede manejar " .. maxScenes .. " clips. Mejora el computador para proyectos más grandes."
	end
	local scenes = {}
	for _, sc in ipairs(proj.Scenes) do
		scenes[sc.Id] = sc
	end
	local photos = {}
	for _, ph in ipairs(data.Photos) do
		photos[ph.Id] = ph
	end
	local transitions = {}
	for _, t in ipairs(VideoData.Transitions) do
		transitions[t.Id] = true
	end
	local out = newEdit()
	for _, e in ipairs(edit.Timeline) do
		if type(e) ~= "table" then
			return nil, "Clip no válido."
		end
		if e.k == "s" then
			local sc = scenes[e.id]
			if not sc then
				return nil, "Una escena ya no existe."
			end
			if not sc.Imp then
				return nil, "Importa el material antes de editarlo."
			end
		elseif e.k == "p" then
			if not photos[e.id] then
				return nil, "Una foto ya no existe."
			end
		else
			return nil, "Clip no válido."
		end
		table.insert(out.Timeline, { k = e.k, id = e.id, trim = num(e.trim, 0.3, 1) or 1, tr = transitions[e.tr] and e.tr or "cut" })
	end
	out.Titles = edit.Titles == true
	out.TitleText = Util.cleanText(edit.TitleText or "", 40) or ""
	out.Subtitles = edit.Subtitles == true
	out.Music = VideoData.MusicById[edit.Music or ""] and edit.Music or "none"
	out.MusicVol = num(edit.MusicVol, 0, 1) or 0.3
	out.VoiceVol = num(edit.VoiceVol, 0, 1) or 1
	local fx = {}
	for _, id in ipairs(type(edit.Effects) == "table" and edit.Effects or {}) do
		for _, def in ipairs(VideoData.Effects) do
			if def.Id == id and not Util.indexOf(fx, id) then
				fx[#fx + 1] = id
			end
		end
	end
	out.Effects = fx
	local c = type(edit.Color) == "table" and edit.Color or {}
	out.Color = { b = math.floor(num(c.b, -100, 100) or 0), c = math.floor(num(c.c, -100, 100) or 0), s = math.floor(num(c.s, -100, 100) or 0) }
	local function validId(list, id)
		for _, it in ipairs(list) do
			if it.Id == id then
				return id
			end
		end
		return "none"
	end
	out.Intro = validId(VideoData.Intros, edit.Intro)
	out.Outro = validId(VideoData.Outros, edit.Outro)
	return out
end

function Video.evaluate(player, proj, stats)
	local data = S.Data.get(player)
	local scenes, photos = {}, {}
	for _, sc in ipairs(proj.Scenes) do
		scenes[sc.Id] = sc
	end
	for _, ph in ipairs(data.Photos) do
		photos[ph.Id] = ph
	end
	local entries, nPhotos, nTrans = {}, 0, 0
	for i, e in ipairs(proj.Edit.Timeline) do
		if e.k == "s" and scenes[e.id] then
			local sc = scenes[e.id]
			entries[#entries + 1] = { q = sc.Q, seconds = sc.Sec, trim = e.trim, shot = sc.Shot, transition = e.tr }
		elseif e.k == "p" and photos[e.id] then
			nPhotos = nPhotos + 1
			entries[#entries + 1] = { q = photos[e.id].Q * 0.8, seconds = 4, trim = 1, shot = "photo", transition = e.tr }
		end
		if i > 1 and e.tr ~= "cut" then
			nTrans = nTrans + 1
		end
	end
	local dur = VideoData.Durations[1]
	for _, d in ipairs(VideoData.Durations) do
		if d.Id == proj.Plan.Duration then
			dur = d
		end
	end
	local ed = proj.Edit
	local res = F.edit({
		entries = entries,
		targetSeconds = dur.Seconds,
		titles = ed.Titles,
		subtitles = ed.Subtitles,
		music = ed.Music,
		musicVol = ed.MusicVol,
		voiceVol = ed.VoiceVol,
		effects = ed.Effects,
		color = ed.Color,
		intro = ed.Intro,
		outro = ed.Outro,
		category = proj.Category,
		colorAcc = stats and stats.ColorAcc or 40,
		proColor = stats and stats.ProColor or 0,
		audioMix = stats and stats.AudioMix or 0,
	})
	local c = ed.Color
	local graded = (math.abs(c.b) + math.abs(c.c) + math.abs(c.s)) > 0
	return res, { seconds = res.Seconds, effects = ed.Effects, transitions = nTrans, photos = nPhotos, colorGraded = graded }
end

---------------------------------------------------------------------------
-- Publicación
---------------------------------------------------------------------------
local function classify(proj, cat)
	local owned, store = {}, {}
	local talking = false
	for _, sc in ipairs(proj.Scenes) do
		if sc.Feat then
			if sc.Own then
				owned[sc.Feat] = true
			else
				store[sc.Feat] = true
			end
		end
		if sc.Shot == "talking" then
			talking = true
		end
	end
	local nOwned, nStore = Util.count(owned), Util.count(store)
	local need = cat.NeedsProducts or 0
	local label, mult = nil, 1
	if need > 0 or cat.ProductBonus then
		if nOwned >= math.max(1, need) then
			label, mult = "Prueba real", 1.1
		elseif nOwned + nStore >= math.max(1, need) then
			label, mult = "Prueba en tienda", 1.0
		elseif need > 0 then
			label, mult = "Comparación de especificaciones", 0.8
		end
	end
	local tags = {}
	if label then
		tags[#tags + 1] = label
	end
	if talking then
		tags[#tags + 1] = "Opinión personal"
	end
	local products = {}
	for id in pairs(owned) do
		products[#products + 1] = id
	end
	for id in pairs(store) do
		products[#products + 1] = id
	end
	return label, mult, tags, products, nOwned
end

function Video.publish(player, p)
	local data = S.Data.get(player)
	if tonumber(p.owner) and tonumber(p.owner) ~= player.UserId then
		return false, "Solo el dueño del proyecto puede publicarlo."
	end
	local proj = getProject(player, p.pid)
	if not proj then
		return false, "Proyecto no encontrado."
	end
	if not proj.Export or proj.Export.ReadyAt == nil then
		return false, "Primero exporta el vídeo en el Editor."
	end
	if os.time() < proj.Export.ReadyAt then
		return false, "La exportación aún no ha terminado."
	end
	local title = Util.cleanText(p.title, Config.MaxTextTitle)
	if not title or #title < 3 then
		return false, "Escribe un título (mínimo 3 caracteres)."
	end
	local desc = Util.cleanText(p.description or "", Config.MaxTextDescription) or ""
	local tagList = {}
	if type(p.tags) == "table" then
		for i = 1, math.min(8, #p.tags) do
			local t = Util.cleanText(p.tags[i], 20)
			if t and #t > 0 then
				tagList[#tagList + 1] = t
			end
		end
	end
	local fTitle = S.Text.filter(player, title)
	local fDesc = S.Text.filter(player, desc)
	local fTags = S.Text.filter(player, table.concat(tagList, ","))
	if not fTitle or not fDesc or not fTags then
		return false, "No se pudo comprobar el texto. Inténtalo de nuevo."
	end
	local thumb = type(p.thumbId) == "string" and data.Thumbnails[p.thumbId] or nil
	local cat = VideoData.CategoryById[proj.Category]
	local res = proj.Export.Res
	local label, labelMult, labels, products, nOwned = classify(proj, cat)

	-- Formato
	local fmt = VideoData.FormatById[p.format or "video"] or VideoData.FormatById.video
	if fmt.MaxSeconds and res.Seconds > fmt.MaxSeconds then
		return false, "Un Short dura como máximo " .. fmt.MaxSeconds .. " s (el tuyo dura " .. res.Seconds .. " s). Recorta en el Editor."
	end
	if fmt.MinTalk then
		local talk, audio = 0, 0
		for _, sc in ipairs(proj.Scenes) do
			if sc.Shot == "talking" or sc.Shot == "interview" then
				talk = talk + 1
				audio = audio + sc.Aud
			end
		end
		if talk < fmt.MinTalk then
			return false, "Un podcast necesita al menos " .. fmt.MinTalk .. " tomas de presentación o entrevista."
		end
		if audio / talk < fmt.MinAudio then
			return false, "El audio de las tomas habladas es demasiado bajo para un podcast (usa un buen micrófono)."
		end
	end
	if fmt.MinScenes and (#proj.Scenes < fmt.MinScenes or res.Seconds < fmt.MinSeconds) then
		return false, "Un documental necesita al menos " .. fmt.MinScenes .. " escenas y " .. math.floor(fmt.MinSeconds / 60) .. " minutos."
	end
	local seriesName, episode, loyal = nil, nil, 1
	if fmt.Series then
		local n = Util.cleanText(p.series or "", 30)
		if not n or #n < 2 then
			return false, "Escribe el nombre de la serie."
		end
		seriesName = S.Text.filter(player, n)
		if not seriesName then
			return false, "No se pudo comprobar el nombre de la serie."
		end
		data.Series = data.Series or {}
		episode = (data.Series[seriesName] or 0) + 1
		loyal = 1 + math.min(0.3, 0.06 * (episode - 1))
	end
	-- Patrocinio
	local contract, contractId = nil, nil
	if type(p.sponsor) == "string" and p.sponsor ~= "" then
		local c, err = S.Sponsor.fulfill(player, p.sponsor, proj, res.Final)
		if not c then
			return false, "No cumple el contrato: " .. err
		end
		contract, contractId = c, p.sponsor
		labels[#labels + 1] = "Contenido patrocinado"
	end
	-- Encargo de un cliente de tu empresa
	local client, clientId = nil, nil
	if type(p.client) == "string" and p.client ~= "" then
		if not S.Company then
			return false, "Las empresas no están disponibles."
		end
		local k, err = S.Company.checkClient(player, p.client, proj, res.Final)
		if not k then
			return false, "No cumple el encargo del cliente: " .. err
		end
		client, clientId = k, p.client
		labels[#labels + 1] = "Producción para cliente"
	end

	data.Counters.video_id = (data.Counters.video_id or 0) + 1
	local vid = "v" .. data.Counters.video_id
	local seed = vid .. ":" .. player.UserId
	local luck = Util.seededRandom(seed, 0.8, 1.25)
	local viral = nil
	if res.Final >= 75 and Util.seededRandom(seed .. ":viral", 0, 1) > 0.96 then
		viral = Util.seededRandom(seed .. ":mult", 2.5, 4)
	end
	local fatigue = 1
	local same = 0
	for i = 1, math.min(3, #data.Videos) do
		if data.Videos[i].Cat == proj.Category then
			same = same + 1
		end
	end
	if same >= 3 then
		fatigue = 0.85
	end
	local thumbScore = thumb and thumb.Score or 30
	local titleScore = F.title(fTitle, proj.Category)
	local ctr = F.ctr(thumbScore, titleScore)
	local trend = S.Channel.trendFor(proj.Category)
	local expected = F.expectedViews({
		subs = data.Channel.Subs,
		quality = res.Final,
		ctr = ctr,
		interest = cat.Interest * labelMult,
		trend = trend,
		reputation = data.Reputation,
		luck = luck,
		competition = S.Channel.competition(),
		fatigue = fatigue,
		viral = viral,
	})
	expected = math.floor(expected * (fmt.ViewMult or 1) * loyal * S.Events.viewMultiplier(proj.Category))
	-- Colaboración: el vídeo guarda el colaborador; bonus si grabó al menos una escena
	local collab = nil
	if S.Collab then
		collab = S.Collab.forPublish(player, p.pid, proj)
		if collab then
			labels[#labels + 1] = "Colaboración con " .. collab.name
			if collab.bonus then
				expected = math.floor(expected * S.Collab.ViewBonus)
			end
		end
	end
	local unlisted = p.visibility == "unlisted"
	if unlisted then
		expected = math.floor(expected * 0.1)
	end

	local video = {
		Id = vid,
		Title = fTitle,
		Desc = fDesc,
		Tags = fTags,
		Cat = proj.Category,
		Q = res.Final,
		EditQ = res.EditQuality,
		Footage = res.Footage,
		Sec = res.Seconds,
		Thumb = thumbScore,
		ThumbDesign = thumb and thumb.Design or nil,
		TitleScore = titleScore,
		Ctr = Util.round(ctr * 100, 2),
		Expected = expected,
		Views = 0,
		Likes = 0,
		Comments = 0,
		CommentList = {},
		Revenue = 0,
		SubsGained = 0,
		At = os.time(),
		Hist = {},
		Label = label,
		Labels = labels,
		Products = products,
		Trend = trend > 1,
		Viral = viral ~= nil,
		Unlisted = unlisted,
		Format = fmt.Id,
		RpmMult = fmt.RpmMult or 1,
		SubMult = (fmt.SubMult or 1) * ((collab and collab.bonus) and S.Collab.SubBonus or 1),
		Collab = collab,
		Series = seriesName,
		Episode = episode,
		Sponsor = contract and contract.Brand or nil,
		Client = client and S.Company.clientLabel(client) or nil,
	}
	table.insert(data.Videos, 1, video)
	while #data.Videos > Config.MaxVideosKept do
		table.remove(data.Videos)
	end
	data.Projects[p.pid] = nil
	if recording[player] and recording[player].Pid == p.pid then
		recording[player] = nil
	end

	-- Progreso
	if seriesName then
		data.Series[seriesName] = episode
		data.Counters.series_eps = (data.Counters.series_eps or 0) + 1
	end
	if fmt.Id == "short" then
		data.Counters.shorts = (data.Counters.shorts or 0) + 1
	elseif fmt.Id == "podcast" then
		data.Counters.podcasts = (data.Counters.podcasts or 0) + 1
	elseif fmt.Id == "doc" then
		data.Counters.docs = (data.Counters.docs or 0) + 1
		if res.Final >= 65 then
			data.Reputation = math.min(100, data.Reputation + 1)
		end
	end
	if contractId then
		S.Sponsor.complete(player, contractId, res.Final)
	end
	if clientId then
		S.Company.completeClient(player, clientId, res.Final, vid)
	end
	S.Events.onPublish(player, video)
	data.Counters.published = (data.Counters.published or 0) + 1
	data.Visited.Categories[proj.Category] = true
	data.Counters.max_quality = math.max(data.Counters.max_quality or 0, math.floor(res.Final))
	if proj.Category == "compare" then
		data.Counters.comparisons = (data.Counters.comparisons or 0) + 1
	end
	if label == "Prueba real" and (proj.Category == "review" or proj.Category == "unboxing" or proj.Category == "tech" or proj.Category == "compare") then
		data.Counters.reviews = (data.Counters.reviews or 0) + 1
	end
	if res.Final >= 70 then
		data.Reputation = math.min(100, data.Reputation + 1)
	elseif res.Final < 30 then
		data.Reputation = math.max(0, data.Reputation - 1)
	end
	if collab and S.Collab then
		S.Collab.onPublished(player, p.pid, video)
	end
	S.Progress.addXp(player, S.Progress.Xp.PublishBase + math.floor(res.Final / 2))
	S.Quest.tutorialEvent(player, "publish")
	S.Quest.check(player)
	S.Channel.tickPlayer(player)
	return true, "🎉 ¡Vídeo publicado! Calidad final " .. math.floor(res.Final) .. "/100. Mira cómo crece en Estadísticas.", { videoId = vid }
end

---------------------------------------------------------------------------
-- Registro de acciones
---------------------------------------------------------------------------
function Video.Start()
	local Net = S.Net

	Net.on("Video.CreateProject", function(player, p)
		local data = S.Data.get(player)
		local cat = VideoData.CategoryById[p.category or ""]
		if not cat then
			return false, "Elige una categoría."
		end
		if Util.count(data.Projects) >= projectSlots(player) then
			return false, "Tienes " .. projectSlots(player) .. " proyectos abiertos. Publica o borra alguno."
		end
		local name = Util.cleanText(p.name or "", 40)
		if not name or #name == 0 then
			name = cat.Name .. " #" .. ((data.Counters.project_id or 0) + 1)
		end
		name = S.Text.filter(player, name) or (cat.Name .. " #" .. ((data.Counters.project_id or 0) + 1))
		data.Counters.project_id = (data.Counters.project_id or 0) + 1
		local pid = "p" .. data.Counters.project_id
		data.Projects[pid] = {
			Id = pid,
			Name = name,
			Category = cat.Id,
			Status = "planning",
			Created = os.time(),
			Plan = { Style = 1, Duration = "short", Budget = 0, Goal = 1, Transport = 1, Location = "", Featured = {}, Time = "", Notes = "" },
			Scenes = {},
			Edit = newEdit(),
			Versions = {},
			Export = nil,
			ThumbId = "",
		}
		S.Quest.tutorialEvent(player, "create_project")
		return true, "Proyecto «" .. name .. "» creado. Planifícalo y sal a grabar.", { pid = pid }
	end)

	Net.on("Video.UpdatePlan", function(player, p)
		local proj = getProject(player, p.pid)
		if not proj then
			return false, "Proyecto no encontrado."
		end
		local plan = proj.Plan
		local q = type(p.plan) == "table" and p.plan or {}
		plan.Style = math.floor(num(q.Style, 1, #VideoData.Styles) or plan.Style)
		plan.Goal = math.floor(num(q.Goal, 1, #VideoData.Goals) or plan.Goal)
		plan.Transport = math.floor(num(q.Transport, 1, #VideoData.Transport) or plan.Transport)
		plan.Budget = math.floor(num(q.Budget, 0, 1000000) or plan.Budget)
		for _, d in ipairs(VideoData.Durations) do
			if d.Id == q.Duration then
				plan.Duration = d.Id
			end
		end
		if type(q.Location) == "string" and (q.Location == "" or S.World.SpotById[q.Location] or q.Location == "home") then
			plan.Location = q.Location
		end
		if type(q.Time) == "string" and #q.Time <= 20 then
			plan.Time = q.Time
		end
		if type(q.Featured) == "table" then
			local f = {}
			for i = 1, math.min(4, #q.Featured) do
				if Catalog.get(q.Featured[i]) then
					f[#f + 1] = q.Featured[i]
				end
			end
			plan.Featured = f
		end
		return true, "Plan guardado."
	end)

	Net.on("Video.DeleteProject", function(player, p)
		local data = S.Data.get(player)
		if not getProject(player, p.pid) then
			return false, "Proyecto no encontrado."
		end
		data.Projects[p.pid] = nil
		if recording[player] and recording[player].Pid == p.pid then
			recording[player] = nil
		end
		return true, "Proyecto movido a la papelera y eliminado."
	end)

	Net.on("Video.DuplicateProject", function(player, p)
		local data = S.Data.get(player)
		local proj = getProject(player, p.pid)
		if not proj then
			return false, "Proyecto no encontrado."
		end
		if Util.count(data.Projects) >= projectSlots(player) then
			return false, "No quedan espacios para proyectos."
		end
		data.Counters.project_id = (data.Counters.project_id or 0) + 1
		local pid = "p" .. data.Counters.project_id
		local copy = Util.deepCopy(proj)
		copy.Id = pid
		copy.Name = (proj.Name .. " (copia)"):sub(1, 40)
		copy.Export = nil
		copy.Versions = {}
		data.Projects[pid] = copy
		return true, "Proyecto duplicado.", { pid = pid }
	end)

	Net.on("Video.StartRecording", function(player, p)
		local proj = getProject(player, p.pid)
		if not proj then
			return false, "Elige un proyecto."
		end
		local gear = Video.gear(player, p.usePhone == true)
		if not gear.Device then
			return false, "No tienes cámara ni teléfono."
		end
		recording[player] = { Pid = p.pid, UseCamera = p.usePhone ~= true, Last = 0 }
		local spot = S.Travel.currentSpot(player)
		return true, "Grabando «" .. proj.Name .. "» con " .. gear.Device.Name .. ".", {
			device = gear.Device.Name,
			charge = gear.DeviceRec.Charge,
			spot = spot and spot.Name or nil,
			mic = gear.Mic and gear.Mic.Name or "Micrófono interno",
			tripod = gear.Tripod ~= nil,
			gimbal = gear.Gimbal ~= nil,
			light = gear.Light ~= nil,
			drone = gear.Drone ~= nil,
		}
	end)

	Net.on("Video.StopRecording", function(player)
		recording[player] = nil
		return true, "Grabación terminada. Vuelve a casa para importar y editar."
	end)

	Net.on("Video.RecordScene", Video.recordScene)
	Net.on("Video.DeleteScene", function(player, p)
		local proj = getProject(player, p.pid)
		if not proj then
			return false, "Proyecto no encontrado."
		end
		for i, sc in ipairs(proj.Scenes) do
			if sc.Id == p.sceneId then
				table.remove(proj.Scenes, i)
				local tl = {}
				for _, e in ipairs(proj.Edit.Timeline) do
					if not (e.k == "s" and e.id == p.sceneId) then
						tl[#tl + 1] = e
					end
				end
				proj.Edit.Timeline = tl
				proj.Export = nil
				return true, "Escena eliminada."
			end
		end
		return false, "Escena no encontrada."
	end)

	Net.on("Photo.Take", Video.takePhoto)
	Net.on("Photo.Delete", function(player, p)
		local data = S.Data.get(player)
		for i, ph in ipairs(data.Photos) do
			if ph.Id == p.id then
				table.remove(data.Photos, i)
				return true, "Foto eliminada."
			end
		end
		return false, "Foto no encontrada."
	end)
	Net.on("Photo.SetAlbum", function(player, p)
		local data = S.Data.get(player)
		if not Util.indexOf(data.Albums, p.album) then
			return false, "Álbum no válido."
		end
		for _, ph in ipairs(data.Photos) do
			if ph.Id == p.id then
				ph.Album = p.album
				return true, "Foto movida a «" .. p.album .. "»."
			end
		end
		return false, "Foto no encontrada."
	end)
	Net.on("Photo.CreateAlbum", function(player, p)
		local data = S.Data.get(player)
		local name = Util.cleanText(p.name, 20)
		if not name or #name == 0 or #data.Albums >= 10 or Util.indexOf(data.Albums, name) then
			return false, "Nombre no válido o demasiados álbumes."
		end
		name = S.Text.filter(player, name)
		if not name then
			return false, "Nombre no permitido."
		end
		table.insert(data.Albums, name)
		return true, "Álbum creado."
	end)

	Net.on("Video.Import", function(player, p)
		local proj = getProject(player, p.pid)
		if not proj then
			return false, "Proyecto no encontrado."
		end
		if not S.Computer.hasSession(player) then
			return false, "Importa el material desde un computador o un portátil."
		end
		local stats = S.Computer.sessionStats(player)
		local used = S.Computer.storageUsed(player)
		local need = 0
		local count = 0
		for _, sc in ipairs(proj.Scenes) do
			if not sc.Imp then
				need = need + sc.Gb
				count = count + 1
			end
		end
		if count == 0 then
			return false, "No hay material nuevo que importar."
		end
		if used + need > stats.StorageGb then
			return false, "Sin espacio: necesitas " .. math.ceil(need) .. " GB y quedan " .. math.floor(stats.StorageGb - used) .. " GB. Publica proyectos, borra escenas o compra almacenamiento."
		end
		for _, sc in ipairs(proj.Scenes) do
			sc.Imp = true
		end
		if proj.Status == "recording" or proj.Status == "planning" then
			proj.Status = "editing"
		end
		return true, count .. " escenas importadas (" .. math.ceil(need) .. " GB)."
	end)

	Net.on("Video.SaveEdit", function(player, p)
		local data = S.Data.get(player)
		local proj = getProject(player, p.pid)
		if not proj then
			return false, "Proyecto no encontrado."
		end
		local ok, stats = canEdit(player)
		if not ok then
			return false, "Necesitas un computador, un portátil o una tableta Pro para editar."
		end
		local edit, err = validEdit(proj, data, p.edit, math.min(stats.MaxScenes, Config.MaxScenesPerProject))
		if not edit then
			return false, err
		end
		proj.Edit = edit
		proj.Export = nil
		proj.Status = "editing"
		local res = Video.evaluate(player, proj, stats)
		S.Quest.tutorialEvent(player, "save_edit")
		return true, "Proyecto guardado. Calidad estimada " .. math.floor(res.Final) .. "/100.", { eval = res }
	end)

	Net.on("Video.Evaluate", function(player, p)
		local proj = getProject(player, p.pid)
		if not proj then
			return false, "Proyecto no encontrado."
		end
		local _, stats = canEdit(player)
		return true, nil, { eval = Video.evaluate(player, proj, stats) }
	end)

	Net.on("Video.SaveVersion", function(player, p)
		local proj = getProject(player, p.pid)
		if not proj then
			return false, "Proyecto no encontrado."
		end
		local label = Util.cleanText(p.label or "", 24) or ""
		if #label == 0 then
			label = "Versión " .. (#proj.Versions + 1)
		end
		table.insert(proj.Versions, 1, { Label = label, T = os.time(), Edit = Util.deepCopy(proj.Edit) })
		while #proj.Versions > Config.MaxVersionsPerProject do
			table.remove(proj.Versions)
		end
		return true, "Versión «" .. label .. "» guardada."
	end)

	Net.on("Video.RestoreVersion", function(player, p)
		local proj = getProject(player, p.pid)
		local idx = tonumber(p.index)
		if not proj or not idx or not proj.Versions[idx] then
			return false, "Versión no encontrada."
		end
		proj.Edit = Util.deepCopy(proj.Versions[idx].Edit)
		proj.Export = nil
		return true, "Versión restaurada."
	end)

	Net.on("Video.Export", function(player, p)
		local data = S.Data.get(player)
		local proj = getProject(player, p.pid)
		if not proj then
			return false, "Proyecto no encontrado."
		end
		if not S.Computer.hasSession(player) then
			return false, "Exporta desde un computador o un portátil."
		end
		if #proj.Edit.Timeline == 0 then
			return false, "La línea de tiempo está vacía."
		end
		if proj.Export and proj.Export.ReadyAt and os.time() < proj.Export.ReadyAt then
			return false, "Ya se está exportando."
		end
		local stats = S.Computer.sessionStats(player)
		local res, cx = Video.evaluate(player, proj, stats)
		-- Editor de tu empresa: exportación más rápida
		local secs = math.floor(F.exportSeconds(cx, stats, stats.EditSpeed, stats.Comfort) * (S.Needs and S.Needs.exportMult(player) or 1) * (S.Company and S.Company.exportMult(player) or 1) + 0.5)
		secs = math.max(1, secs)
		if p.useToken and data.ExportTokens > 0 then
			data.ExportTokens = data.ExportTokens - 1
			secs = 1
		end
		proj.Export = { Started = os.time(), ReadyAt = os.time() + secs, Secs = secs, Res = res }
		proj.Status = "exported"
		data.Counters.exports = (data.Counters.exports or 0) + 1
		S.Progress.addXp(player, S.Progress.Xp.Export)
		S.Quest.check(player)
		return true, "Exportando... tiempo estimado " .. secs .. " s (" .. stats.TierName .. ").", { secs = secs, readyAt = proj.Export.ReadyAt, eval = res }
	end)

	Net.on("Thumb.Save", function(player, p)
		local data = S.Data.get(player)
		local _, _, tab = S.Inventory.best(player, "tablet", "backpack")
		if not S.Computer.hasSession(player) and not tab then
			return false, "Diseña miniaturas en un computador o con una tableta en la mochila."
		end
		local d = type(p.design) == "table" and p.design or {}
		local text = Util.cleanText(d.text or "", 40) or ""
		local fText = S.Text.filter(player, text)
		if not fText then
			return false, "No se pudo comprobar el texto."
		end
		local design = {
			text = fText,
			font = VideoData.FontById[d.font or ""] and d.font or "GothamBlack",
			textColor = math.floor(num(d.textColor, 1, #VideoData.Palette) or 1),
			bg = math.floor(num(d.bg, 1, #VideoData.Palette) or 2),
			outline = d.outline == true,
			frame = "none",
			template = VideoData.ThumbTemplateById[d.template or ""] and d.template or "center",
			stickers = {},
			photoId = nil,
			textSize = num(d.textSize, 0.5, 1.5) or 1,
		}
		for _, f in ipairs(VideoData.Frames) do
			if f.Id == d.frame then
				design.frame = f.Id
			end
		end
		if type(d.stickers) == "table" then
			for i = 1, math.min(6, #d.stickers) do
				for _, st in ipairs(VideoData.Stickers) do
					if st.Id == d.stickers[i] then
						table.insert(design.stickers, st.Id)
					end
				end
			end
		end
		local photo = nil
		if type(d.photoId) == "string" then
			for _, ph in ipairs(data.Photos) do
				if ph.Id == d.photoId then
					photo = ph
				end
			end
			if not photo then
				return false, "La foto elegida no existe."
			end
			design.photoId = photo.Id
			design.photoCam = photo.Cam
			design.photoFilter = photo.Filter
			design.photoSpot = photo.SpotName
		end
		local proj = getProject(player, p.pid)
		local cat = proj and VideoData.CategoryById[proj.Category] or nil
		local kw = proj and F.categoryKeyword(proj.Category) or nil
		local score = F.thumbnail(design, {
			photoQuality = photo and photo.Q or nil,
			photoMatches = photo and cat and F.overlap(photo.Tags, cat.Tags) > 0 or false,
			keywordInText = kw ~= nil and fText:lower():find(kw, 1, true) ~= nil,
		})
		-- Diseñador de tu empresa: miniaturas mejores
		if S.Company then
			local tb = S.Company.thumbBonus(player)
			if tb > 0 then
				score.Score = math.min(100, Util.round(score.Score + tb, 1))
			end
		end
		if Util.count(data.Thumbnails) >= Config.MaxThumbnails then
			-- eliminar la más antigua
			local oldestId, oldestT = nil, math.huge
			for id, t in pairs(data.Thumbnails) do
				if t.T < oldestT then
					oldestId, oldestT = id, t.T
				end
			end
			data.Thumbnails[oldestId] = nil
		end
		data.Counters.thumb_id = (data.Counters.thumb_id or 0) + 1
		local tid = "t" .. data.Counters.thumb_id
		data.Thumbnails[tid] = { Id = tid, Design = design, Score = score.Score, Read = score.Readability, Comp = score.Composition, Rel = score.Relevance, Details = score.Details, Pid = proj and proj.Id or nil, T = os.time() }
		if proj then
			proj.ThumbId = tid
		end
		data.Counters.thumbnails = (data.Counters.thumbnails or 0) + 1
		S.Jobs.onThumb(player, design, score.Score)
		S.Progress.addXp(player, S.Progress.Xp.Thumbnail)
		S.Quest.tutorialEvent(player, "thumbnail")
		S.Quest.check(player)
		return true, "Miniatura guardada: " .. math.floor(score.Score) .. "/100.", { thumbId = tid, score = score }
	end)

	Net.on("Thumb.Delete", function(player, p)
		local data = S.Data.get(player)
		if type(p.id) ~= "string" or not data.Thumbnails[p.id] then
			return false, "Miniatura no encontrada."
		end
		data.Thumbnails[p.id] = nil
		return true, "Miniatura eliminada."
	end)

	Net.on("Video.Publish", Video.publish)

	Players.PlayerRemoving:Connect(function(player)
		recording[player] = nil
		lastPhoto[player] = nil
		collabRec[player] = nil
	end)
end

function Video.isRecording(player)
	return recording[player] ~= nil
end

return Video
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000061"><Properties><string name="Name">WorldBuilder</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- WorldBuilder: construye la ciudad con Parts a partir de WorldData al arrancar el servidor.
--  * 30 distritos con suelo, aceras, calles, línea central, semáforos, farolas, señales y edificios con estilo propio.
--  * Edificios importantes con interior funcional: Residencia Económica (12 habitaciones), 4 tiendas,
--    cibercafé, banco y sala VIP.
--  * Lugares de grabación 🎥, paradas de taxi, bancos de parque, coches aparcados, árboles, agua, montañas.
-- Todo es anclado y reutiliza las mismas funciones, así que añadir distritos solo requiere editar WorldData.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CollectionService = game:GetService("CollectionService")
local Shared = ReplicatedStorage.Shared
local WorldData = require(Shared.WorldData)
local Catalog = require(Shared.ItemCatalog)
local Util = require(Shared.Util)
local PropertyData = require(Shared.PropertyData)
local LifeData = require(Shared.LifeData)
local StudioData = require(Shared.StudioData)

local World = {}
local S
local city

World.Specials = WorldData.Specials
World.SpotById = WorldData.SpotById
World.HomeRooms = {}
World.NpcPoints = {}
World.TrafficLights = {}
World.VendingMachines = {}

local CELL = WorldData.CellSize
local ROAD = WorldData.RoadWidth
local GROUND_TOP = 0.5

function World.Init(services)
	S = services
end

-- ¿Está el jugador cerca de un edificio especial de cierto tipo? (tienda, concesionario, gasolinera...)
function World.nearSpecial(player, specialType, radius)
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if not root then
		return nil
	end
	radius = radius or 45
	for _, sp in ipairs(World.Specials) do
		if sp.Type == specialType then
			local dx, dz = root.Position.X - sp.WX, root.Position.Z - sp.WZ
			if dx * dx + dz * dz <= radius * radius then
				return sp
			end
		end
	end
	return nil
end

---------------------------------------------------------------------------
-- Utilidades de construcción
---------------------------------------------------------------------------
local function rgb(t)
	return Color3.fromRGB(t[1], t[2], t[3])
end

local function P(parent, name, size, cf, color, material, opts)
	local p = Instance.new(opts and opts.Class or "Part")
	p.Name = name
	p.Anchored = true
	p.Size = size
	p.CFrame = typeof(cf) == "Vector3" and CFrame.new(cf) or cf
	p.Color = typeof(color) == "Color3" and color or rgb(color)
	p.Material = material or Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if opts then
		if opts.Shape then
			p.Shape = opts.Shape
		end
		if opts.Transparency then
			p.Transparency = opts.Transparency
		end
		if opts.NoCollide then
			p.CanCollide = false
		end
		if opts.NoShadow then
			p.CastShadow = false
		end
	end
	p.Parent = parent
	return p
end

local function folder(parent, name)
	local f = Instance.new("Folder")
	f.Name = name
	f.Parent = parent
	return f
end

local function model(parent, name)
	local m = Instance.new("Model")
	m.Name = name
	m.Parent = parent
	return m
end

local function sign(part, face, text, bg, fg, font)
	local gui = Instance.new("SurfaceGui")
	gui.Face = face or Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 30
	gui.Parent = part
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundColor3 = bg or Color3.fromRGB(20, 20, 24)
	label.BackgroundTransparency = bg and 0 or 1
	label.TextColor3 = fg or Color3.new(1, 1, 1)
	label.Font = font or Enum.Font.GothamBlack
	label.TextScaled = true
	label.Text = text
	label.Parent = gui
	return label
end

-- Cartel legible por las dos caras (la cara Front de Roblox mira a -Z; las fachadas están en +Z)
local function signBoth(part, text, bg, fg, font)
	sign(part, Enum.NormalId.Front, text, bg, fg, font)
	return sign(part, Enum.NormalId.Back, text, bg, fg, font)
end

local function prompt(part, action, actionText, objectText, attrs)
	local pp = Instance.new("ProximityPrompt")
	pp.ActionText = actionText
	pp.ObjectText = objectText or ""
	pp.HoldDuration = 0
	pp.MaxActivationDistance = 10
	pp.RequiresLineOfSight = false
	pp:SetAttribute("Action", action)
	for k, v in pairs(attrs or {}) do
		pp:SetAttribute(k, v)
	end
	pp.Parent = part
	CollectionService:AddTag(pp, "YTPrompt")
	return pp
end

local function nightLight(part, range, color)
	local l = Instance.new("PointLight")
	l.Range = range or 24
	l.Brightness = 1.4
	l.Color = color or Color3.fromRGB(255, 220, 160)
	l.Enabled = false
	l.Parent = part
	CollectionService:AddTag(part, "NightLight")
	return l
end

local function tree(parent, x, z, scale, rng)
	scale = scale or 1
	local h = (10 + rng:NextNumber() * 6) * scale
	P(parent, "Trunk", Vector3.new(h, 1.6 * scale, 1.6 * scale), CFrame.new(x, GROUND_TOP + h / 2, z) * CFrame.Angles(0, 0, math.rad(90)),
		{ 110, 80, 55 }, Enum.Material.Wood, { Shape = Enum.PartType.Cylinder })
	local leaf = { 60 + rng:NextInteger(0, 30), 130 + rng:NextInteger(0, 40), 60 }
	P(parent, "Leaves", Vector3.new(9, 9, 9) * scale, Vector3.new(x, GROUND_TOP + h + 2 * scale, z), leaf, Enum.Material.Grass,
		{ Shape = Enum.PartType.Ball, NoShadow = false })
end

local function bench(parent, x, z, rotY)
	local cf = CFrame.new(x, GROUND_TOP, z) * CFrame.Angles(0, rotY or 0, 0)
	P(parent, "BenchSeat", Vector3.new(6, 0.5, 2), cf * CFrame.new(0, 1.6, 0), { 140, 100, 60 }, Enum.Material.WoodPlanks)
	P(parent, "BenchBack", Vector3.new(6, 1.6, 0.4), cf * CFrame.new(0, 2.6, -0.9), { 140, 100, 60 }, Enum.Material.WoodPlanks)
	P(parent, "BenchLeg", Vector3.new(0.4, 1.4, 1.8), cf * CFrame.new(-2.6, 0.7, 0), { 50, 50, 55 }, Enum.Material.Metal)
	P(parent, "BenchLeg", Vector3.new(0.4, 1.4, 1.8), cf * CFrame.new(2.6, 0.7, 0), { 50, 50, 55 }, Enum.Material.Metal)
end

local function car(parent, x, z, color, rotY)
	local m = model(parent, "ParkedCar")
	local cf = CFrame.new(x, GROUND_TOP, z) * CFrame.Angles(0, rotY or 0, 0)
	P(m, "Body", Vector3.new(6, 2, 12), cf * CFrame.new(0, 1.8, 0), color, Enum.Material.SmoothPlastic)
	P(m, "Cabin", Vector3.new(5.6, 1.8, 6), cf * CFrame.new(0, 3.6, -0.5), { 40, 50, 60 }, Enum.Material.Glass, { Transparency = 0.2 })
	for _, w in ipairs({ { -3, 3.8 }, { 3, 3.8 }, { -3, -3.8 }, { 3, -3.8 } }) do
		P(m, "Wheel", Vector3.new(1.2, 2.2, 2.2), cf * CFrame.new(w[1], 1.1, w[2]), { 20, 20, 20 }, Enum.Material.SmoothPlastic, { Shape = Enum.PartType.Cylinder })
	end
	return m
end

local function streetLamp(parent, x, z)
	P(parent, "LampPole", Vector3.new(0.6, 14, 0.6), Vector3.new(x, GROUND_TOP + 7, z), { 60, 60, 66 }, Enum.Material.Metal)
	local head = P(parent, "LampHead", Vector3.new(1.6, 0.8, 1.6), Vector3.new(x, GROUND_TOP + 14.2, z), { 255, 240, 200 }, Enum.Material.Neon, { NoShadow = true })
	nightLight(head, 30)
end

---------------------------------------------------------------------------
-- Edificios genéricos por estilo
---------------------------------------------------------------------------
local shopNames = { "Panadería", "Café Central", "Moda Urbana", "Zapatería", "Librería", "Papelería", "Deportes", "Bicicletas",
	"Electrodomésticos", "Mascotas", "Jardinería", "Viajes", "Coleccionables", "Herramientas", "Juegos", "Instrumentos", "Supermercado", "Floristería" }
local foodNames = { "Pizzería Napoli", "Sushi Zen", "Tacos El Sol", "Hamburguesas 24", "Paella & Co.", "Ramen Nube", "Asador Brasa", "Heladería Polar", "Crepes París", "Arepas Doña Ana" }

local function windowBands(parent, cf, w, h, d, rng)
	local floors = math.min(10, math.floor(h / 10))
	for i = 1, floors do
		local y = -h / 2 + i * (h / (floors + 1))
		local band = P(parent, "Windows", Vector3.new(w + 0.3, 2.6, d + 0.3), cf * CFrame.new(0, y, 0), { 40, 60, 90 }, Enum.Material.Glass,
			{ Transparency = 0.1, NoShadow = true })
		band:SetAttribute("GlowNight", rng:NextNumber() < 0.7)
		band.Color = Color3.fromRGB(255, 225, 150)
		band.Material = Enum.Material.Glass
		CollectionService:AddTag(band, "NightLight")
	end
end

local styleBuilders = {}

styleBuilders.tower = function(parent, x, z, d, rng)
	local w, dd = rng:NextInteger(30, 42), rng:NextInteger(30, 42)
	local h = rng:NextInteger(60, 140)
	local cf = CFrame.new(x, GROUND_TOP + h / 2, z)
	local color = d.Palette[rng:NextInteger(1, #d.Palette)]
	P(parent, "Tower", Vector3.new(w, h, dd), cf, color, Enum.Material.Concrete)
	windowBands(parent, cf, w, h, dd, rng)
	if d.Neon then
		P(parent, "Crown", Vector3.new(w + 1, 1, dd + 1), cf * CFrame.new(0, h / 2 + 0.5, 0), d.Neon, Enum.Material.Neon, { NoShadow = true })
	end
end
styleBuilders.office = function(parent, x, z, d, rng)
	local w, dd, h = rng:NextInteger(34, 46), rng:NextInteger(28, 38), rng:NextInteger(28, 60)
	local cf = CFrame.new(x, GROUND_TOP + h / 2, z)
	P(parent, "Office", Vector3.new(w, h, dd), cf, d.Palette[rng:NextInteger(1, #d.Palette)], Enum.Material.Concrete)
	windowBands(parent, cf, w, h, dd, rng)
	P(parent, "Entrance", Vector3.new(8, 8, 1), cf * CFrame.new(0, -h / 2 + 4, dd / 2 + 0.5), { 30, 40, 50 }, Enum.Material.Glass, { Transparency = 0.3 })
end
styleBuilders.apartment = function(parent, x, z, d, rng)
	local w, dd, h = rng:NextInteger(36, 44), rng:NextInteger(26, 32), rng:NextInteger(30, 54)
	local cf = CFrame.new(x, GROUND_TOP + h / 2, z)
	P(parent, "Apartments", Vector3.new(w, h, dd), cf, d.Palette[rng:NextInteger(1, #d.Palette)], Enum.Material.Brick)
	windowBands(parent, cf, w, h, dd, rng)
	for i = 1, math.floor(h / 10) do
		P(parent, "Balcony", Vector3.new(w - 6, 0.6, 3), cf * CFrame.new(0, -h / 2 + i * 10, dd / 2 + 1.5), { 220, 220, 220 }, Enum.Material.Concrete)
	end
end
styleBuilders.house = function(parent, x, z, d, rng)
	local w, dd, h = rng:NextInteger(18, 24), rng:NextInteger(16, 22), 11
	local base = CFrame.new(x, GROUND_TOP, z)
	local color = d.Palette[rng:NextInteger(1, #d.Palette)]
	P(parent, "House", Vector3.new(w, h, dd), base * CFrame.new(0, h / 2, 0), color, Enum.Material.Plaster)
	local roofColor = { 150, 60, 50 }
	P(parent, "Roof", Vector3.new(w + 1, 5, dd / 2 + 0.5), base * CFrame.new(0, h + 2.5, dd / 4 + 0.25), roofColor, Enum.Material.Slate, { Class = "WedgePart" })
	P(parent, "Roof", Vector3.new(w + 1, 5, dd / 2 + 0.5), base * CFrame.new(0, h + 2.5, -dd / 4 - 0.25) * CFrame.Angles(0, math.pi, 0), roofColor, Enum.Material.Slate, { Class = "WedgePart" })
	P(parent, "Door", Vector3.new(4, 7, 0.4), base * CFrame.new(0, 3.5, dd / 2 + 0.2), { 90, 60, 40 }, Enum.Material.Wood)
	local win = P(parent, "Window", Vector3.new(4, 3, 0.4), base * CFrame.new(-w / 4 - 1, 6, dd / 2 + 0.2), { 255, 225, 150 }, Enum.Material.Glass)
	win:SetAttribute("GlowNight", true)
	CollectionService:AddTag(win, "NightLight")
	P(parent, "Fence", Vector3.new(w + 6, 2.5, 0.4), base * CFrame.new(0, 1.25, dd / 2 + 6), { 245, 245, 245 }, Enum.Material.WoodPlanks)
end
styleBuilders.mansion = function(parent, x, z, d, rng)
	local w, dd, h = 44, 30, 18
	local base = CFrame.new(x, GROUND_TOP, z)
	P(parent, "Mansion", Vector3.new(w, h, dd), base * CFrame.new(0, h / 2, 0), d.Palette[rng:NextInteger(1, #d.Palette)], Enum.Material.Marble)
	P(parent, "RoofTop", Vector3.new(w + 2, 1, dd + 2), base * CFrame.new(0, h + 0.5, 0), { 60, 60, 70 }, Enum.Material.Slate)
	for i = -2, 2 do
		P(parent, "Column", Vector3.new(h, 1.6, 1.6), base * CFrame.new(i * 8, h / 2, dd / 2 + 3) * CFrame.Angles(0, 0, math.rad(90)), { 250, 250, 245 }, Enum.Material.Marble, { Shape = Enum.PartType.Cylinder })
	end
	local pool = P(parent, "Pool", Vector3.new(20, 0.6, 10), base * CFrame.new(0, 0.4, dd / 2 + 14), { 60, 180, 230 }, Enum.Material.Glass, { Transparency = 0.25 })
	pool.CanCollide = false
	windowBands(parent, base * CFrame.new(0, h / 2, 0), w, h, dd, rng)
end
styleBuilders.shop = function(parent, x, z, d, rng)
	local w, dd, h = rng:NextInteger(26, 34), 22, rng:NextInteger(12, 18)
	local base = CFrame.new(x, GROUND_TOP, z)
	P(parent, "Shop", Vector3.new(w, h, dd), base * CFrame.new(0, h / 2, 0), d.Palette[rng:NextInteger(1, #d.Palette)], Enum.Material.Brick)
	local glass = P(parent, "ShopWindow", Vector3.new(w - 4, 7, 0.4), base * CFrame.new(0, 4.5, dd / 2 + 0.2), { 255, 230, 170 }, Enum.Material.Glass, { Transparency = 0.2 })
	glass:SetAttribute("GlowNight", true)
	CollectionService:AddTag(glass, "NightLight")
	local awningColor = ({ { 220, 60, 60 }, { 40, 140, 90 }, { 40, 90, 180 }, { 230, 160, 30 } })[rng:NextInteger(1, 4)]
	P(parent, "Awning", Vector3.new(w, 1.5, 4), base * CFrame.new(0, 9, dd / 2 + 2), awningColor, Enum.Material.Fabric, { Class = "WedgePart" })
	local list = Util.indexOf(d.Tags, "food") and foodNames or shopNames
	local board = P(parent, "Sign", Vector3.new(w - 6, 2.4, 0.4), base * CFrame.new(0, h - 2, dd / 2 + 0.3), { 20, 20, 24 }, Enum.Material.SmoothPlastic)
	signBoth(board, list[rng:NextInteger(1, #list)], nil, Color3.new(1, 1, 1), Enum.Font.FredokaOne)
end
styleBuilders.warehouse = function(parent, x, z, d, rng)
	local w, dd, h = rng:NextInteger(44, 56), rng:NextInteger(34, 44), rng:NextInteger(16, 22)
	local base = CFrame.new(x, GROUND_TOP, z)
	P(parent, "Warehouse", Vector3.new(w, h, dd), base * CFrame.new(0, h / 2, 0), d.Palette[rng:NextInteger(1, #d.Palette)], Enum.Material.CorrodedMetal)
	P(parent, "BigDoor", Vector3.new(16, 12, 0.4), base * CFrame.new(0, 6, dd / 2 + 0.2), { 70, 70, 75 }, Enum.Material.DiamondPlate)
	if d.Neon then
		P(parent, "NeonStrip", Vector3.new(w, 0.6, 0.4), base * CFrame.new(0, h - 1, dd / 2 + 0.3), d.Neon, Enum.Material.Neon, { NoShadow = true })
	end
end
styleBuilders.cabin = function(parent, x, z, d, rng)
	local base = CFrame.new(x, GROUND_TOP, z)
	P(parent, "Cabin", Vector3.new(16, 9, 14), base * CFrame.new(0, 4.5, 0), d.Palette[1] or { 120, 80, 50 }, Enum.Material.WoodPlanks)
	P(parent, "Roof", Vector3.new(17, 4, 7.5), base * CFrame.new(0, 11, 3.5), { 70, 50, 40 }, Enum.Material.Wood, { Class = "WedgePart" })
	P(parent, "Roof", Vector3.new(17, 4, 7.5), base * CFrame.new(0, 11, -3.5) * CFrame.Angles(0, math.pi, 0), { 70, 50, 40 }, Enum.Material.Wood, { Class = "WedgePart" })
end
styleBuilders.tent = function(parent, x, z, d, rng)
	local c = d.Palette[rng:NextInteger(1, #d.Palette)]
	local base = CFrame.new(x, GROUND_TOP, z) * CFrame.Angles(0, rng:NextNumber() * math.pi, 0)
	P(parent, "Tent", Vector3.new(8, 5, 4), base * CFrame.new(0, 2.5, 2), c, Enum.Material.Fabric, { Class = "WedgePart" })
	P(parent, "Tent", Vector3.new(8, 5, 4), base * CFrame.new(0, 2.5, -2) * CFrame.Angles(0, math.pi, 0), c, Enum.Material.Fabric, { Class = "WedgePart" })
end
styleBuilders.hotel = function(parent, x, z, d, rng)
	local w, dd, h = 40, 36, rng:NextInteger(60, 90)
	local cf = CFrame.new(x, GROUND_TOP + h / 2, z)
	P(parent, "Hotel", Vector3.new(w, h, dd), cf, d.Palette[rng:NextInteger(1, #d.Palette)], Enum.Material.Concrete)
	windowBands(parent, cf, w, h, dd, rng)
	local board = P(parent, "HotelSign", Vector3.new(20, 4, 0.5), cf * CFrame.new(0, h / 2 - 4, dd / 2 + 0.4), { 30, 30, 40 }, Enum.Material.SmoothPlastic)
	signBoth(board, "HOTEL ✦", nil, Color3.fromRGB(255, 214, 120))
end
styleBuilders.kiosk = function(parent, x, z, d, rng)
	local base = CFrame.new(x, GROUND_TOP, z)
	P(parent, "Kiosk", Vector3.new(10, 7, 8), base * CFrame.new(0, 3.5, 0), d.Palette[rng:NextInteger(1, #d.Palette)], Enum.Material.WoodPlanks)
	P(parent, "Umbrella", Vector3.new(0.6, 10, 10), base * CFrame.new(10, 8, 0) * CFrame.Angles(0, 0, math.rad(90)), { 255, 90, 90 }, Enum.Material.Fabric, { Shape = Enum.PartType.Cylinder })
	P(parent, "Pole", Vector3.new(0.4, 8, 0.4), base * CFrame.new(10, 4, 0), { 240, 240, 240 }, Enum.Material.Metal)
end
styleBuilders.containers = function(parent, x, z, d, rng)
	local base = CFrame.new(x, GROUND_TOP, z)
	for i = 0, rng:NextInteger(1, 3) do
		P(parent, "Container", Vector3.new(10, 9, 24), base * CFrame.new(0, 4.5 + i * 9, 0), d.Palette[rng:NextInteger(1, #d.Palette)], Enum.Material.CorrodedMetal)
	end
end
styleBuilders.showroom = function(parent, x, z, d, rng)
	local base = CFrame.new(x, GROUND_TOP, z)
	P(parent, "ShowroomFloor", Vector3.new(44, 0.4, 30), base * CFrame.new(0, 0.2, 0), { 235, 235, 240 }, Enum.Material.Marble)
	P(parent, "ShowroomRoof", Vector3.new(44, 1, 30), base * CFrame.new(0, 14, 0), { 40, 40, 45 }, Enum.Material.Metal)
	for _, cx in ipairs({ -20, 20 }) do
		for _, cz in ipairs({ -13, 13 }) do
			P(parent, "Pillar", Vector3.new(1, 14, 1), base * CFrame.new(cx, 7, cz), { 200, 200, 210 }, Enum.Material.Metal)
		end
	end
	car(parent, x - 10, z, { 220, 30, 40 }, 0.4)
	car(parent, x + 10, z, { 20, 20, 25 }, -0.4)
end
styleBuilders.arena = function(parent, x, z, d, rng)
	local base = CFrame.new(x, GROUND_TOP, z)
	P(parent, "Stage", Vector3.new(50, 3, 24), base * CFrame.new(0, 1.5, -40), { 30, 30, 36 }, Enum.Material.Wood)
	P(parent, "StageBack", Vector3.new(50, 24, 2), base * CFrame.new(0, 13, -52), { 20, 20, 26 }, Enum.Material.SmoothPlastic)
	local screen = P(parent, "Screen", Vector3.new(30, 14, 0.4), base * CFrame.new(0, 14, -50.8), { 255, 60, 200 }, Enum.Material.Neon, { NoShadow = true })
	signBoth(screen, "FESTIVAL DE CREADORES", Color3.fromRGB(40, 0, 70), Color3.fromRGB(255, 220, 255))
	for i = 1, 4 do
		P(parent, "Bleacher", Vector3.new(60, 2 * i, 4), base * CFrame.new(0, i, 10 + i * 4), { 120, 120, 130 }, Enum.Material.Concrete)
	end
end
styleBuilders.rides = function(parent, x, z, d, rng)
	local base = CFrame.new(x, GROUND_TOP, z)
	local wheel = model(parent, "FerrisWheel")
	local hub = P(wheel, "Hub", Vector3.new(4, 4, 4), base * CFrame.new(0, 34, 0), { 240, 240, 240 }, Enum.Material.Metal, { Shape = Enum.PartType.Ball })
	for i = 1, 12 do
		local a = i / 12 * math.pi * 2
		P(wheel, "Spoke", Vector3.new(0.6, 30, 0.6), hub.CFrame * CFrame.Angles(0, 0, a) * CFrame.new(0, 15, 0), { 255, 80, 80 }, Enum.Material.Metal)
		P(wheel, "Cabin", Vector3.new(4, 4, 4), hub.CFrame * CFrame.Angles(0, 0, a) * CFrame.new(0, 30, 0), d.Palette[(i % #d.Palette) + 1], Enum.Material.SmoothPlastic)
	end
	wheel.PrimaryPart = hub
	CollectionService:AddTag(wheel, "Spin")
	P(parent, "Support", Vector3.new(2, 36, 2), base * CFrame.new(-6, 17, 0) * CFrame.Angles(0, 0, math.rad(10)), { 200, 200, 210 }, Enum.Material.Metal)
	P(parent, "Support", Vector3.new(2, 36, 2), base * CFrame.new(6, 17, 0) * CFrame.Angles(0, 0, math.rad(-10)), { 200, 200, 210 }, Enum.Material.Metal)
end
styleBuilders.none = function() end

---------------------------------------------------------------------------
-- Interiores especiales
---------------------------------------------------------------------------
local function shell(parent, cx, cz, w, d, h, wallColor, floorColor, doorSide)
	-- doorSide: "S" (+Z) por defecto; hueco de puerta de 8 studs
	local base = CFrame.new(cx, GROUND_TOP, cz)
	P(parent, "Floor", Vector3.new(w, 0.6, d), base * CFrame.new(0, 0.3, 0), floorColor, Enum.Material.WoodPlanks)
	P(parent, "Roof", Vector3.new(w + 1, 1, d + 1), base * CFrame.new(0, h + 0.5, 0), { 60, 60, 66 }, Enum.Material.Concrete)
	P(parent, "WallN", Vector3.new(w, h, 1), base * CFrame.new(0, h / 2, -d / 2), wallColor, Enum.Material.Concrete)
	P(parent, "WallW", Vector3.new(1, h, d), base * CFrame.new(-w / 2, h / 2, 0), wallColor, Enum.Material.Concrete)
	P(parent, "WallE", Vector3.new(1, h, d), base * CFrame.new(w / 2, h / 2, 0), wallColor, Enum.Material.Concrete)
	local side = (w - 10) / 2
	P(parent, "WallS", Vector3.new(side, h, 1), base * CFrame.new(-w / 2 + side / 2, h / 2, d / 2), wallColor, Enum.Material.Concrete)
	P(parent, "WallS", Vector3.new(side, h, 1), base * CFrame.new(w / 2 - side / 2, h / 2, d / 2), wallColor, Enum.Material.Concrete)
	P(parent, "WallS", Vector3.new(10, h - 9, 1), base * CFrame.new(0, 9 + (h - 9) / 2, d / 2), wallColor, Enum.Material.Concrete)
	for _, lx in ipairs({ -w / 4, w / 4 }) do
		local lamp = P(parent, "CeilingLamp", Vector3.new(4, 0.4, 4), base * CFrame.new(lx, h - 0.3, 0), { 255, 250, 230 }, Enum.Material.Neon, { NoShadow = true })
		local l = Instance.new("PointLight")
		l.Range = 30
		l.Brightness = 1.2
		l.Parent = lamp
	end
	return base
end

-- Modelo de exposición de un objeto del catálogo
local function displayModel(parent, def, cf)
	local c = rgb(def.Color)
	local shape = def.Shape
	if shape == "monitor" then
		P(parent, "Display", Vector3.new(3.4, 2.2, 0.3), cf * CFrame.new(0, 1.4, 0), { 20, 20, 24 })
		P(parent, "DisplayScreen", Vector3.new(3.1, 1.9, 0.05), cf * CFrame.new(0, 1.4, 0.18), { 70, 140, 255 }, Enum.Material.Neon, { NoShadow = true })
	elseif shape == "tower" then
		local t = P(parent, "Display", Vector3.new(1.4, 3, 2.8), cf * CFrame.new(0, 1.5, 0), c)
		if def.Id == "pc_gamer" or def.Id == "pc_lux" then
			t.Material = Enum.Material.Glass
			t.Transparency = 0.25
			P(parent, "RGB", Vector3.new(1, 0.3, 2.4), cf * CFrame.new(0, 2.6, 0), { 200, 80, 255 }, Enum.Material.Neon, { NoShadow = true })
		end
	elseif shape == "camera" then
		P(parent, "Display", Vector3.new(1.6, 1.1, 0.9), cf * CFrame.new(0, 0.7, 0), { 25, 25, 28 })
		P(parent, "Lens", Vector3.new(0.9, 0.8, 0.8), cf * CFrame.new(0, 0.7, 0.8) * CFrame.Angles(0, math.rad(90), 0), { 40, 40, 45 }, Enum.Material.Metal, { Shape = Enum.PartType.Cylinder })
	elseif shape == "phone" then
		P(parent, "Display", Vector3.new(0.9, 1.7, 0.15), cf * CFrame.new(0, 1, 0) * CFrame.Angles(math.rad(-15), 0, 0), { 20, 20, 24 })
	elseif shape == "laptop" then
		P(parent, "Display", Vector3.new(2.6, 0.15, 1.8), cf * CFrame.new(0, 0.2, 0), { 160, 165, 175 }, Enum.Material.Metal)
		P(parent, "LaptopScreen", Vector3.new(2.6, 1.7, 0.1), cf * CFrame.new(0, 1, -0.9) * CFrame.Angles(math.rad(-15), 0, 0), { 70, 140, 255 }, Enum.Material.Neon, { NoShadow = true })
	elseif shape == "mic" then
		P(parent, "Display", Vector3.new(0.6, 1.4, 0.6), cf * CFrame.new(0, 0.9, 0), { 30, 30, 34 }, Enum.Material.Metal)
		P(parent, "MicHead", Vector3.new(0.9, 0.9, 0.9), cf * CFrame.new(0, 1.8, 0), { 120, 120, 125 }, Enum.Material.DiamondPlate, { Shape = Enum.PartType.Ball })
	elseif shape == "light" then
		P(parent, "Display", Vector3.new(0.3, 2, 2), cf * CFrame.new(0, 1.4, 0), { 255, 255, 240 }, Enum.Material.Neon, { NoShadow = true })
	elseif shape == "tripod" then
		for i = 0, 2 do
			P(parent, "Leg", Vector3.new(0.15, 2.6, 0.15), cf * CFrame.Angles(0, i * 2.1, 0) * CFrame.new(0, 1.2, 0.4) * CFrame.Angles(math.rad(15), 0, 0), { 40, 40, 44 }, Enum.Material.Metal)
		end
	elseif shape == "chair" then
		P(parent, "Display", Vector3.new(2, 0.4, 2), cf * CFrame.new(0, 1, 0), c)
		P(parent, "Back", Vector3.new(2, 2.2, 0.3), cf * CFrame.new(0, 2.2, -0.9), c)
	elseif shape == "desk" then
		P(parent, "Display", Vector3.new(4, 0.3, 2), cf * CFrame.new(0, 1.6, 0), c, Enum.Material.WoodPlanks)
	else
		P(parent, "Display", Vector3.new(1.4, 1, 1.4), cf * CFrame.new(0, 0.6, 0), c)
	end
end

local function buildStore(parent, sp, rng)
	local store = Catalog.Stores[sp.StoreId]
	local m = model(parent, "Store_" .. store.Name)
	m:SetAttribute("StoreId", sp.StoreId)
	local w, d, h = 64, 46, 16
	local base = shell(m, sp.WX, sp.WZ, w, d, h, { 235, 235, 240 }, { 200, 200, 205 })
	local board = P(m, "StoreSign", Vector3.new(30, 4, 0.6), base * CFrame.new(0, h - 2.5, d / 2 + 0.6), { 20, 20, 24 })
	signBoth(board, store.Name, Color3.fromRGB(255, 40, 70), Color3.new(1, 1, 1))
	-- Mostrador y dependiente
	local counter = P(m, "Counter", Vector3.new(18, 4, 3), base * CFrame.new(0, 2, -d / 2 + 7), { 40, 40, 48 }, Enum.Material.Wood)
	prompt(counter, "store_catalog", "Ver catálogo completo", store.Name, { StoreId = sp.StoreId })
	table.insert(World.NpcPoints, { Pos = (base * CFrame.new(0, 0, -d / 2 + 4)).Position, Look = (base * CFrame.new(0, 0, 0)).Position, Name = "Dependiente de " .. store.Name, Role = "shopkeeper", Store = sp.StoreId })
	-- Expositores (8 productos variados de la tienda)
	local items = Catalog.list({ Store = sp.StoreId })
	local picks = {}
	local step = math.max(1, math.floor(#items / 8))
	for i = 1, #items, step do
		if #picks < 8 then
			picks[#picks + 1] = items[i]
		end
	end
	for i, def in ipairs(picks) do
		local col = (i - 1) % 4
		local row = math.floor((i - 1) / 4)
		local px = -21 + col * 14
		local pz = -2 + row * 12
		local pedestal = P(m, "Pedestal", Vector3.new(5, 3, 5), base * CFrame.new(px, 1.5, pz), { 250, 250, 252 }, Enum.Material.Marble)
		displayModel(m, def, base * CFrame.new(px, 3, pz))
		local tag = P(m, "PriceTag", Vector3.new(4.6, 1, 0.2), base * CFrame.new(px, 2.2, pz + 2.6), { 255, 214, 0 })
		signBoth(tag, "$" .. Util.formatInt(def.Price), nil, Color3.fromRGB(20, 20, 24))
		prompt(pedestal, "inspect", "Inspeccionar", def.Name, { ItemId = def.Id, StoreId = sp.StoreId })
	end
end

-- Rastro & Retro: tienda de segunda mano con estanterías, vitrina de coleccionables y taller
local function buildUsedStore(parent, sp)
	local m = model(parent, "RastroRetro")
	m:SetAttribute("Special", "usedstore")
	local w, d, h = 60, 44, 15
	local base = shell(m, sp.WX, sp.WZ, w, d, h, { 190, 140, 105 }, { 140, 100, 70 })
	local board = P(m, "UsedStoreSign", Vector3.new(30, 4, 0.6), base * CFrame.new(0, h - 2.5, d / 2 + 0.6), { 20, 20, 24 })
	signBoth(board, "♻ " .. sp.Name, Color3.fromRGB(70, 110, 70), Color3.fromRGB(255, 235, 190))
	P(m, "Awning", Vector3.new(22, 0.4, 5), base * CFrame.new(0, 10.6, d / 2 + 2.6) * CFrame.Angles(math.rad(12), 0, 0), { 200, 70, 60 }, Enum.Material.Fabric)
	P(m, "Rug", Vector3.new(26, 0.1, 16), base * CFrame.new(0, 0.65, 4), { 150, 60, 50 }, Enum.Material.Fabric, { NoCollide = true })
	-- Mostrador: abre la app de segunda mano
	local counter = P(m, "UsedCounter", Vector3.new(16, 4, 3), base * CFrame.new(0, 2, -d / 2 + 7), { 110, 75, 50 }, Enum.Material.Wood)
	prompt(counter, "usedstore", "Ver stock, vender y reparar", sp.Name)
	P(m, "CashRegister", Vector3.new(2, 1.2, 1.6), base * CFrame.new(5, 4.6, -d / 2 + 7), { 60, 60, 66 }, Enum.Material.Metal)
	local note = P(m, "CounterSign", Vector3.new(6, 1.4, 0.2), base * CFrame.new(-3, 4.8, -d / 2 + 5.4), { 255, 240, 200 })
	signBoth(note, "COMPRAMOS Y VENDEMOS USADOS", Color3.fromRGB(255, 240, 200), Color3.fromRGB(60, 40, 20))
	table.insert(World.NpcPoints, { Pos = (base * CFrame.new(0, 0, -d / 2 + 4)).Position, Look = (base * CFrame.new(0, 0, 0)).Position, Name = "Dependienta de " .. sp.Name, Role = "shopkeeper" })
	-- Estanterías en las paredes laterales con objetos variados
	local rng = Random.new(Util.hashString(sp.Name))
	local colors = { { 200, 60, 50 }, { 60, 120, 200 }, { 230, 190, 60 }, { 80, 160, 90 }, { 40, 40, 44 }, { 220, 220, 225 }, { 150, 90, 160 } }
	for _, side in ipairs({ -1, 1 }) do
		for j = 0, 2 do
			local sx = side * (w / 2 - 1.8)
			local sz = -9 + j * 11
			P(m, "ShelfBack", Vector3.new(0.4, 9, 9), base * CFrame.new(sx + side * 1, 4.5, sz), { 110, 80, 55 }, Enum.Material.WoodPlanks)
			for level = 0, 2 do
				local y = 1.2 + level * 2.9
				P(m, "ShelfBoard", Vector3.new(2.6, 0.3, 9), base * CFrame.new(sx, y, sz), { 130, 95, 65 }, Enum.Material.WoodPlanks)
				for k = 0, 2 do
					local s = 0.8 + rng:NextNumber() * 0.9
					P(m, "UsedThing", Vector3.new(s, s * (0.7 + rng:NextNumber()), s), base * CFrame.new(sx - side * 0.2, y + 0.15 + s * 0.6, sz - 3 + k * 3) * CFrame.Angles(0, rng:NextNumber() * 0.8, 0),
						colors[rng:NextInteger(1, #colors)], Enum.Material.SmoothPlastic)
				end
			end
		end
	end
	-- Mesas centrales con productos de muestra (cámara, teléfono, consola, monitor...)
	local samples = {}
	for _, cat in ipairs({ "camera", "phone", "gadget", "monitor", "audio", "laptop" }) do
		local list = Catalog.list({ Cat = cat })
		if list[1] then
			samples[#samples + 1] = list[math.min(#list, 2)]
		end
	end
	for i, def in ipairs(samples) do
		local tx = -12 + ((i - 1) % 3) * 12
		local tz = -2 + math.floor((i - 1) / 3) * 10
		P(m, "UsedTable", Vector3.new(6, 0.4, 4), base * CFrame.new(tx, 2.8, tz), { 120, 85, 55 }, Enum.Material.Wood)
		P(m, "UsedTableLeg", Vector3.new(0.6, 2.6, 0.6), base * CFrame.new(tx, 1.4, tz), { 70, 50, 35 }, Enum.Material.Wood)
		displayModel(m, def, base * CFrame.new(tx, 3, tz))
		local tag = P(m, "UsedTag", Vector3.new(3.6, 0.9, 0.2), base * CFrame.new(tx, 2.2, tz + 2.1), { 255, 214, 0 })
		signBoth(tag, "USADO", nil, Color3.fromRGB(20, 20, 24))
	end
	-- Vitrina de coleccionables
	local vit = P(m, "CollectorCase", Vector3.new(10, 3, 3), base * CFrame.new(-16, 1.5, -d / 2 + 4), { 90, 60, 40 }, Enum.Material.Wood)
	P(m, "CollectorGlass", Vector3.new(10, 3, 3), base * CFrame.new(-16, 4.5, -d / 2 + 4), { 200, 230, 255 }, Enum.Material.Glass, { Transparency = 0.6 })
	local shown = 0
	for _, id in ipairs(Catalog.Order) do
		local def = Catalog.get(id)
		if def.Collectible and shown < 4 then
			P(m, "Collectible", Vector3.new(1.4, 1.2, 1), base * CFrame.new(-19.5 + shown * 2.4, 3.6, -d / 2 + 4), def.Color, Enum.Material.SmoothPlastic)
			shown = shown + 1
		end
	end
	local cs = P(m, "CollectorSign", Vector3.new(8, 1.2, 0.2), base * CFrame.new(-16, 6.6, -d / 2 + 2.5), { 30, 20, 10 })
	signBoth(cs, "⭐ COLECCIONABLES", Color3.fromRGB(30, 20, 10), Color3.fromRGB(255, 214, 0))
	prompt(vit, "usedstore", "Ver coleccionables", sp.Name)
	-- Taller de reparación
	local bench = P(m, "RepairBench", Vector3.new(8, 3.4, 3), base * CFrame.new(16, 1.7, -d / 2 + 4), { 80, 80, 86 }, Enum.Material.Metal)
	P(m, "Toolbox", Vector3.new(2, 1, 1), base * CFrame.new(14, 3.9, -d / 2 + 4), { 200, 40, 40 }, Enum.Material.Metal)
	P(m, "SolderLamp", Vector3.new(0.4, 2, 0.4), base * CFrame.new(18.5, 4.4, -d / 2 + 3.5), { 40, 40, 44 }, Enum.Material.Metal)
	local ts = P(m, "RepairSign", Vector3.new(6, 1.2, 0.2), base * CFrame.new(16, 6.4, -d / 2 + 2.5), { 30, 30, 34 })
	signBoth(ts, "🔧 TALLER −30%", Color3.fromRGB(30, 30, 34), Color3.fromRGB(120, 230, 255))
	prompt(bench, "usedstore", "Reparar equipo", sp.Name)
	-- Rincón retro: sofá viejo y caja de vinilos
	P(m, "OldSofa", Vector3.new(8, 2, 3), base * CFrame.new(12, 1.6, 14), { 120, 140, 90 }, Enum.Material.Fabric)
	P(m, "OldSofaBack", Vector3.new(8, 2.4, 0.8), base * CFrame.new(12, 3, 15.3), { 110, 130, 80 }, Enum.Material.Fabric)
	P(m, "VinylCrate", Vector3.new(3, 1.8, 2.4), base * CFrame.new(-14, 1.5, 14), { 150, 110, 70 }, Enum.Material.WoodPlanks)
	for k = 0, 4 do
		P(m, "Vinyl", Vector3.new(0.1, 1.6, 1.6), base * CFrame.new(-15 + k * 0.5, 2.6, 14), colors[(k % #colors) + 1], Enum.Material.SmoothPlastic)
	end
end

local function buildCafe(parent, sp)
	local m = model(parent, "Cibercafe")
	local w, d, h = 48, 36, 14
	local base = shell(m, sp.WX, sp.WZ, w, d, h, { 250, 230, 200 }, { 150, 110, 80 })
	local board = P(m, "CafeSign", Vector3.new(24, 3.5, 0.6), base * CFrame.new(0, h - 2.5, d / 2 + 0.6), { 20, 20, 24 })
	signBoth(board, "☕ " .. sp.Name, Color3.fromRGB(90, 50, 30), Color3.fromRGB(255, 230, 190))
	for i = 1, 4 do
		local x = -18 + (i - 1) * 12
		local desk = P(m, "PublicDesk", Vector3.new(7, 0.5, 3.5), base * CFrame.new(x, 3, -d / 2 + 4), { 120, 85, 60 }, Enum.Material.WoodPlanks)
		P(m, "PublicMonitor", Vector3.new(3, 2, 0.3), base * CFrame.new(x, 4.6, -d / 2 + 3), { 20, 20, 24 })
		P(m, "PublicScreen", Vector3.new(2.7, 1.7, 0.05), base * CFrame.new(x, 4.6, -d / 2 + 3.2), { 70, 140, 255 }, Enum.Material.Neon, { NoShadow = true })
		prompt(desk, "computer_public", "Usar computador público", "Cibercafé")
	end
	table.insert(World.NpcPoints, { Pos = (base * CFrame.new(14, 0, 8)).Position, Look = (base * CFrame.new(0, 0, 8)).Position, Name = "Barista", Role = "barista" })
	local bar = P(m, "CafeCounter", Vector3.new(10, 4, 3), base * CFrame.new(14, 2, 12), { 90, 60, 40 }, Enum.Material.Wood)
	prompt(bar, "cafe", "Pedir", "Cafetería")
end

local function buildRestaurant(parent, sp)
	local m = model(parent, "Restaurante")
	local w, d, h = 54, 40, 14
	local base = shell(m, sp.WX, sp.WZ, w, d, h, { 250, 235, 215 }, { 120, 70, 50 })
	local board = P(m, "RestaurantSign", Vector3.new(26, 3.5, 0.6), base * CFrame.new(0, h - 2.5, d / 2 + 0.6), { 20, 20, 24 })
	signBoth(board, "🍽 " .. sp.Name, Color3.fromRGB(130, 30, 30), Color3.fromRGB(255, 230, 190))
	for i = 0, 5 do
		local tx, tz = -16 + (i % 3) * 16, -2 + math.floor(i / 3) * 12
		P(m, "Table", Vector3.new(5, 0.4, 5), base * CFrame.new(tx, 3, tz), { 245, 245, 245 }, Enum.Material.Fabric)
		P(m, "TableLeg", Vector3.new(0.6, 3, 0.6), base * CFrame.new(tx, 1.5, tz), { 60, 40, 30 }, Enum.Material.Wood)
		for _, sx in ipairs({ -3.4, 3.4 }) do
			P(m, "Chair", Vector3.new(2, 2, 2), base * CFrame.new(tx + sx, 1.6, tz), { 140, 40, 40 }, Enum.Material.Fabric)
		end
	end
	local counter = P(m, "Counter", Vector3.new(16, 4, 3), base * CFrame.new(0, 2, -d / 2 + 6), { 90, 50, 35 }, Enum.Material.Wood)
	prompt(counter, "restaurant", "Ver menú", sp.Name)
	table.insert(World.NpcPoints, { Pos = (base * CFrame.new(0, 0, -d / 2 + 3)).Position, Look = (base * CFrame.new(0, 0, 0)).Position, Name = "Camarero", Role = "waiter" })
end

-- Tienda de mascotas: escaparate, jaulas y peceras decorativas, mostrador (app Mascotas) y cuidadora
local function buildPetShop(parent, sp)
	local m = model(parent, "TiendaMascotas")
	local w, d, h = 50, 38, 14
	local base = shell(m, sp.WX, sp.WZ, w, d, h, { 255, 244, 225 }, { 205, 185, 150 })
	local board = P(m, "PetShopSign", Vector3.new(30, 3.5, 0.6), base * CFrame.new(0, h - 2.5, d / 2 + 0.6), { 20, 20, 24 })
	signBoth(board, "🐾 " .. sp.Name, Color3.fromRGB(60, 160, 130), Color3.new(1, 1, 1))
	-- Escaparates a ambos lados de la puerta (vitrina con un rascador y un peluche de perro)
	for _, sx in ipairs({ -1, 1 }) do
		local cx = sx * 15
		P(m, "ShowcaseBase", Vector3.new(12, 1.5, 4), base * CFrame.new(cx, 0.75, d / 2 + 2.5), { 240, 240, 245 }, Enum.Material.Marble)
		P(m, "ShowcaseGlass", Vector3.new(12, 6, 4), base * CFrame.new(cx, 4.5, d / 2 + 2.5), { 200, 230, 255 }, Enum.Material.Glass, { Transparency = 0.6 })
		P(m, "CatTreePost", Vector3.new(0.8, 4.5, 0.8), base * CFrame.new(cx - 3, 3.75, d / 2 + 2.5), { 210, 180, 140 }, Enum.Material.Fabric)
		P(m, "CatTreeTop", Vector3.new(2.6, 0.4, 2.6), base * CFrame.new(cx - 3, 6, d / 2 + 2.5), { 170, 120, 90 }, Enum.Material.Fabric)
		P(m, "PlushBody", Vector3.new(2.4, 1.6, 1.4), base * CFrame.new(cx + 2.5, 2.3, d / 2 + 2.5), sx < 0 and { 200, 150, 90 } or { 240, 240, 240 }, Enum.Material.Fabric)
		P(m, "PlushHead", Vector3.new(1.3, 1.3, 1.3), base * CFrame.new(cx + 4, 3.4, d / 2 + 2.5), sx < 0 and { 200, 150, 90 } or { 240, 240, 240 }, Enum.Material.Fabric)
	end
	-- Jaulas decorativas (pared oeste) con conejitos y pájaros de exposición
	for i = 0, 2 do
		local z = -8 + i * 8
		local cage = base * CFrame.new(-w / 2 + 4, 0, z)
		P(m, "CageBase", Vector3.new(5, 0.4, 5), cage * CFrame.new(0, 2.2, 0), { 230, 230, 235 }, Enum.Material.Metal)
		P(m, "CageTable", Vector3.new(5.4, 2, 5.4), cage * CFrame.new(0, 1, 0), { 150, 110, 80 }, Enum.Material.Wood)
		P(m, "CageTop", Vector3.new(5, 0.3, 5), cage * CFrame.new(0, 6.4, 0), { 230, 230, 235 }, Enum.Material.Metal)
		for b = -2, 2 do
			P(m, "CageBar", Vector3.new(0.12, 4, 0.12), cage * CFrame.new(2.4, 4.4, b), { 200, 200, 210 }, Enum.Material.Metal, { NoShadow = true })
			P(m, "CageBar", Vector3.new(0.12, 4, 0.12), cage * CFrame.new(b, 4.4, 2.4), { 200, 200, 210 }, Enum.Material.Metal, { NoShadow = true })
		end
		local figure = i == 1 and { 255, 210, 60 } or { 245, 245, 245 }
		P(m, "CagePet", Vector3.new(1.4, 1.2, 1.6), cage * CFrame.new(0, 3, 0), figure, Enum.Material.Fabric, { Shape = Enum.PartType.Ball })
	end
	-- Peceras (pared este)
	for i = 0, 1 do
		local tank = base * CFrame.new(w / 2 - 4, 0, -6 + i * 12)
		P(m, "TankStand", Vector3.new(4, 3, 8), tank * CFrame.new(0, 1.5, 0), { 60, 60, 70 }, Enum.Material.Wood)
		P(m, "TankWater", Vector3.new(3.4, 3.4, 7.4), tank * CFrame.new(0, 4.8, 0), { 60, 170, 230 }, Enum.Material.Glass, { Transparency = 0.45, NoShadow = true })
		P(m, "TankGlass", Vector3.new(3.8, 4, 7.8), tank * CFrame.new(0, 5, 0), { 220, 240, 255 }, Enum.Material.Glass, { Transparency = 0.75 })
		P(m, "TankSand", Vector3.new(3.4, 0.4, 7.4), tank * CFrame.new(0, 3.3, 0), { 230, 210, 160 }, Enum.Material.Sand)
		P(m, "TankPlant", Vector3.new(0.5, 2.2, 0.5), tank * CFrame.new(0, 4.5, 2.5), { 60, 170, 80 }, Enum.Material.Grass)
		for f = 0, 2 do
			P(m, "TankFish", Vector3.new(0.3, 0.5, 0.8), tank * CFrame.new(0.3 - f * 0.3, 4.6 + f * 0.5, -2 + f * 1.6), f == 1 and { 255, 220, 60 } or { 255, 120, 30 }, Enum.Material.Neon, { NoShadow = true })
		end
		local light = P(m, "TankLight", Vector3.new(3.8, 0.3, 7.8), tank * CFrame.new(0, 7.15, 0), { 230, 245, 255 }, Enum.Material.Neon, { NoShadow = true })
		nightLight(light, 12, Color3.fromRGB(150, 210, 255))
	end
	-- Estantería de comida y juguetes
	P(m, "PetShelf", Vector3.new(10, 6, 2), base * CFrame.new(-8, 3, -d / 2 + 1.5), { 230, 220, 200 }, Enum.Material.WoodPlanks)
	for i = 0, 3 do
		P(m, "PetFoodBag", Vector3.new(1.6, 2, 1), base * CFrame.new(-11.5 + i * 2.3, 2.5, -d / 2 + 2.6), ({ { 230, 80, 60 }, { 60, 140, 230 }, { 90, 190, 100 }, { 250, 200, 60 } })[i + 1], Enum.Material.Fabric)
		P(m, "PetToyBall", Vector3.new(0.9, 0.9, 0.9), base * CFrame.new(-11.5 + i * 2.3, 5, -d / 2 + 2.6), ({ { 255, 80, 120 }, { 255, 220, 60 }, { 80, 200, 255 }, { 140, 230, 120 } })[i + 1], Enum.Material.SmoothPlastic, { Shape = Enum.PartType.Ball })
	end
	-- Mostrador con aviso: abre la app Mascotas
	local counter = P(m, "PetCounter", Vector3.new(14, 4, 3), base * CFrame.new(6, 2, -d / 2 + 7), { 120, 80, 50 }, Enum.Material.Wood)
	local cs = P(m, "PetCounterSign", Vector3.new(8, 1.4, 0.2), base * CFrame.new(6, 3, -d / 2 + 8.6), { 60, 160, 130 })
	signBoth(cs, "ADOPCIONES · ACCESORIOS", Color3.fromRGB(60, 160, 130), Color3.new(1, 1, 1))
	prompt(counter, "petshop", "Ver mascotas", sp.Name)
	table.insert(World.NpcPoints, { Pos = (base * CFrame.new(6, 0, -d / 2 + 4)).Position, Look = (base * CFrame.new(6, 0, 0)).Position, Name = "Cuidadora de Huellitas", Role = "petkeeper" })
end

local function vending(parent, x, z)
	local mach = P(parent, "VendingMachine", Vector3.new(4, 7, 3), Vector3.new(x, GROUND_TOP + 3.5, z), { 200, 30, 50 }, Enum.Material.SmoothPlastic)
	P(parent, "VendingGlass", Vector3.new(2.6, 4, 0.2), Vector3.new(x, GROUND_TOP + 4.5, z + 1.55), { 180, 220, 255 }, Enum.Material.Glass, { Transparency = 0.3 })
	prompt(mach, "vending", "Comprar", "Máquina expendedora")
	table.insert(World.VendingMachines, Vector3.new(x, 0, z))
end

local function buildBank(parent, sp)
	local m = model(parent, "Banco")
	local w, d, h = 50, 36, 18
	local base = shell(m, sp.WX, sp.WZ, w, d, h, { 230, 225, 210 }, { 240, 240, 240 })
	local board = P(m, "BankSign", Vector3.new(28, 4, 0.6), base * CFrame.new(0, h - 2.5, d / 2 + 0.6), { 20, 40, 70 })
	signBoth(board, "🏦 " .. sp.Name, Color3.fromRGB(20, 40, 70), Color3.fromRGB(255, 214, 120))
	for i = 1, 3 do
		local atm = P(m, "ATM", Vector3.new(3, 6, 2), base * CFrame.new(-14 + (i - 1) * 14, 3, -d / 2 + 2), { 60, 70, 90 }, Enum.Material.Metal)
		P(m, "ATMScreen", Vector3.new(2, 1.4, 0.1), base * CFrame.new(-14 + (i - 1) * 14, 4.2, -d / 2 + 3.05), { 80, 220, 140 }, Enum.Material.Neon, { NoShadow = true })
		prompt(atm, "atm", "Abrir banco", "Cajero automático")
	end
	table.insert(World.NpcPoints, { Pos = (base * CFrame.new(16, 0, 6)).Position, Look = (base * CFrame.new(0, 0, 6)).Position, Name = "Asesora del banco", Role = "banker" })
end

-- Concesionario: sala de exposición acristalada, coches de exposición, mostrador y zona de entrega
local function buildDealer(parent, sp)
	local m = model(parent, "Concesionario")
	local w, d, h = 64, 46, 16
	local base = CFrame.new(sp.WX, GROUND_TOP, sp.WZ)
	P(m, "Floor", Vector3.new(w, 0.6, d), base * CFrame.new(0, 0.3, 0), { 235, 236, 240 }, Enum.Material.Marble)
	P(m, "Roof", Vector3.new(w + 2, 1, d + 2), base * CFrame.new(0, h + 0.5, 0), { 40, 42, 48 }, Enum.Material.Metal)
	P(m, "WallN", Vector3.new(w, h, 1), base * CFrame.new(0, h / 2, -d / 2), { 50, 52, 60 }, Enum.Material.Concrete)
	-- Paredes de cristal (este, oeste y fachada con puerta de 12 studs)
	local glass = { 170, 210, 235 }
	P(m, "GlassW", Vector3.new(0.6, h, d), base * CFrame.new(-w / 2, h / 2, 0), glass, Enum.Material.Glass, { Transparency = 0.6 })
	P(m, "GlassE", Vector3.new(0.6, h, d), base * CFrame.new(w / 2, h / 2, 0), glass, Enum.Material.Glass, { Transparency = 0.6 })
	local side = (w - 12) / 2
	P(m, "GlassS", Vector3.new(side, h, 0.6), base * CFrame.new(-w / 2 + side / 2, h / 2, d / 2), glass, Enum.Material.Glass, { Transparency = 0.6 })
	P(m, "GlassS", Vector3.new(side, h, 0.6), base * CFrame.new(w / 2 - side / 2, h / 2, d / 2), glass, Enum.Material.Glass, { Transparency = 0.6 })
	P(m, "GlassS", Vector3.new(12, h - 10, 0.6), base * CFrame.new(0, 10 + (h - 10) / 2, d / 2), glass, Enum.Material.Glass, { Transparency = 0.6 })
	for _, x in ipairs({ -w / 2, -w / 4, 0, w / 4, w / 2 }) do
		P(m, "Mullion", Vector3.new(0.6, h, 0.8), base * CFrame.new(x, h / 2, d / 2), { 200, 200, 210 }, Enum.Material.Metal)
	end
	local board = P(m, "DealerSign", Vector3.new(34, 4, 0.6), base * CFrame.new(0, h + 3, d / 2), { 20, 20, 24 })
	signBoth(board, "🚗 " .. sp.Name, Color3.fromRGB(20, 30, 60), Color3.fromRGB(120, 220, 255))
	for _, lx in ipairs({ -w / 4, w / 4 }) do
		local lamp = P(m, "CeilingLamp", Vector3.new(10, 0.4, 3), base * CFrame.new(lx, h - 0.3, 0), { 255, 252, 240 }, Enum.Material.Neon, { NoShadow = true })
		local l = Instance.new("PointLight")
		l.Range = 34
		l.Brightness = 1.3
		l.Parent = lamp
	end
	-- Coches de exposición sobre plataformas giratorias, con su precio
	local shown = { "v_compact", "v_ev", "v_sport", "v_lux" }
	for i, id in ipairs(shown) do
		local def = LifeData.VehicleById[id]
		local x = -24 + (i - 1) * 16
		local col = LifeData.VehicleColors[({ 1, 6, 5, 4 })[i]][2]
		local plat = P(m, "Turntable", Vector3.new(0.4, 13, 13), base * CFrame.new(x, 0.75, 2) * CFrame.Angles(0, 0, math.rad(90)), { 210, 214, 222 }, Enum.Material.Metal, { Shape = Enum.PartType.Cylinder })
		P(m, "TurntableRing", Vector3.new(0.2, 13.6, 13.6), base * CFrame.new(x, 0.62, 2) * CFrame.Angles(0, 0, math.rad(90)), { 0, 190, 255 }, Enum.Material.Neon, { Shape = Enum.PartType.Cylinder, NoShadow = true, NoCollide = true })
		local show = car(m, sp.WX + x, sp.WZ + 2, col, 0.35 * ((i % 2 == 0) and 1 or -1))
		show.Name = "ShowCar"
		for _, piece in ipairs(show:GetChildren()) do
			piece.CFrame = piece.CFrame + Vector3.new(0, 0.95, 0) -- sobre la plataforma
		end
		local tag = P(m, "PriceTag", Vector3.new(9, 2.2, 0.3), base * CFrame.new(x, 1.6, 10.5), { 255, 214, 0 })
		signBoth(tag, def.Name .. "\n$" .. Util.formatInt(def.Price), nil, Color3.fromRGB(20, 20, 24), Enum.Font.GothamBold)
		prompt(plat, "dealer", "Ver modelos", def.Name)
	end
	-- Mostrador del vendedor
	local counter = P(m, "Counter", Vector3.new(18, 4, 3), base * CFrame.new(0, 2, -d / 2 + 7), { 30, 34, 44 }, Enum.Material.Wood)
	P(m, "CounterTop", Vector3.new(18.4, 0.3, 3.4), base * CFrame.new(0, 4.15, -d / 2 + 7), { 235, 236, 240 }, Enum.Material.Marble)
	prompt(counter, "dealer", "Comprar o alquilar", sp.Name)
	table.insert(World.NpcPoints, { Pos = (base * CFrame.new(0, 0, -d / 2 + 4)).Position, Look = (base * CFrame.new(0, 0, 0)).Position, Name = "Vendedora de " .. sp.Name, Role = "dealer" })
	-- Taller (lateral): mejoras y pintura
	local garage = P(m, "WorkshopDoor", Vector3.new(0.6, 10, 12), base * CFrame.new(-w / 2 - 0.4, 5, -10), { 90, 95, 105 }, Enum.Material.DiamondPlate)
	local ws = P(m, "WorkshopSign", Vector3.new(0.4, 2, 10), base * CFrame.new(-w / 2 - 0.8, 11.5, -10), { 20, 20, 24 })
	sign(ws, Enum.NormalId.Left, "🔧 TALLER · MEJORAS · PINTURA", Color3.fromRGB(30, 30, 36), Color3.fromRGB(255, 214, 0))
	prompt(garage, "dealer", "Taller y mejoras", sp.Name)
	-- Zona de entrega (aquí aparecen los vehículos comprados o alquilados)
	local bay = P(m, "DeliveryBay", Vector3.new(26, 0.1, 22), base * CFrame.new(14, 0.13, d / 2 + 17), { 60, 62, 70 }, Enum.Material.Asphalt, { NoShadow = true })
	bay.CanCollide = false
	for _, bx in ipairs({ 1, 27 }) do
		P(m, "BayLine", Vector3.new(0.5, 0.06, 22), base * CFrame.new(bx, 0.18, d / 2 + 17), { 250, 250, 250 }, Enum.Material.SmoothPlastic, { NoShadow = true, NoCollide = true })
	end
	local bsign = P(m, "BaySign", Vector3.new(10, 2, 0.4), base * CFrame.new(14, 4, d / 2 + 6), { 20, 20, 24 })
	signBoth(bsign, "ENTREGA DE VEHÍCULOS", Color3.fromRGB(20, 110, 70), Color3.new(1, 1, 1))
	P(m, "BaySignPole", Vector3.new(0.4, 3, 0.4), base * CFrame.new(14, 1.5, d / 2 + 6), { 200, 200, 210 }, Enum.Material.Metal)
end

-- Gasolinera: marquesina, dos surtidores, cargador eléctrico y tienda/taller
local function buildGasStation(parent, sp)
	local m = model(parent, "Gasolinera")
	local base = CFrame.new(sp.WX, GROUND_TOP, sp.WZ)
	P(m, "Forecourt", Vector3.new(44, 0.3, 34), base * CFrame.new(0, 0.15, 0), { 120, 122, 128 }, Enum.Material.Concrete)
	-- Marquesina
	local roofH = 13
	P(m, "Canopy", Vector3.new(32, 1.6, 18), base * CFrame.new(0, roofH, 2), { 245, 245, 250 }, Enum.Material.SmoothPlastic)
	local trim = P(m, "CanopyTrim", Vector3.new(32.4, 0.8, 18.4), base * CFrame.new(0, roofH - 1, 2), { 230, 40, 50 }, Enum.Material.Neon, { NoShadow = true, NoCollide = true })
	local cs = P(m, "CanopySign", Vector3.new(20, 2.6, 0.4), base * CFrame.new(0, roofH + 2.2, 11.2), { 20, 20, 24 })
	signBoth(cs, "⛽ " .. sp.Name, Color3.fromRGB(200, 30, 40), Color3.new(1, 1, 1))
	for _, x in ipairs({ -13, 13 }) do
		for _, z in ipairs({ -4, 8 }) do
			P(m, "CanopyPillar", Vector3.new(1, roofH, 1), base * CFrame.new(x, roofH / 2, z), { 210, 210, 218 }, Enum.Material.Metal)
		end
	end
	for _, x in ipairs({ -8, 8 }) do
		local lamp = P(m, "CanopyLight", Vector3.new(6, 0.2, 2), base * CFrame.new(x, roofH - 0.9, 2), { 255, 250, 235 }, Enum.Material.Neon, { NoShadow = true })
		nightLight(lamp, 30)
	end
	-- Surtidores
	for i, x in ipairs({ -6, 6 }) do
		P(m, "PumpIsland", Vector3.new(4, 0.6, 9), base * CFrame.new(x, 0.6, 2), { 200, 200, 205 }, Enum.Material.Concrete)
		local pump = P(m, "FuelPump", Vector3.new(2.4, 5.2, 1.8), base * CFrame.new(x, 3.5, 2), { 230, 40, 50 }, Enum.Material.SmoothPlastic)
		P(m, "PumpScreen", Vector3.new(1.6, 1, 0.1), base * CFrame.new(x, 4.6, 2.95), { 80, 220, 140 }, Enum.Material.Neon, { NoShadow = true })
		P(m, "PumpHose", Vector3.new(0.3, 2.6, 0.3), base * CFrame.new(x + 1.35, 3, 2.6), { 20, 20, 22 }, Enum.Material.Rubber)
		local pn = P(m, "PumpNumber", Vector3.new(1.4, 0.8, 0.1), base * CFrame.new(x, 5.6, 2.95), { 255, 255, 255 })
		signBoth(pn, tostring(i), Color3.new(1, 1, 1), Color3.fromRGB(200, 30, 40))
		prompt(pump, "gas", "Repostar", "Surtidor " .. i)
	end
	-- Cargador eléctrico
	local charger = P(m, "EVCharger", Vector3.new(1.6, 5, 1.2), base * CFrame.new(17, 2.8, 4), { 240, 245, 245 }, Enum.Material.SmoothPlastic)
	local glow = P(m, "EVGlow", Vector3.new(1.7, 0.4, 1.3), base * CFrame.new(17, 4.6, 4), { 60, 230, 120 }, Enum.Material.Neon, { NoShadow = true, NoCollide = true })
	nightLight(glow, 12, Color3.fromRGB(80, 255, 140))
	local es = P(m, "EVSign", Vector3.new(4, 1.4, 0.2), base * CFrame.new(17, 6.4, 4), { 20, 20, 24 })
	signBoth(es, "🔋 CARGA", Color3.fromRGB(20, 110, 70), Color3.new(1, 1, 1))
	prompt(charger, "gas", "Cargar batería", "Cargador eléctrico")
	-- Tienda 24 h con taller
	P(m, "Shop", Vector3.new(16, 9, 9), base * CFrame.new(-10, 4.8, -12), { 245, 240, 230 }, Enum.Material.Concrete)
	P(m, "ShopWindow", Vector3.new(10, 4, 0.3), base * CFrame.new(-11, 4.5, -7.4), { 170, 210, 235 }, Enum.Material.Glass, { Transparency = 0.4 })
	local ss = P(m, "ShopSign", Vector3.new(14, 2, 0.4), base * CFrame.new(-10, 10.2, -7.4), { 20, 20, 24 })
	signBoth(ss, "TIENDA 24H · TALLER", Color3.fromRGB(30, 30, 36), Color3.fromRGB(255, 214, 0))
	local shopDoor = P(m, "WorkshopDoor", Vector3.new(8, 7, 0.4), base * CFrame.new(8, 3.8, -11.6), { 90, 95, 105 }, Enum.Material.DiamondPlate)
	P(m, "Workshop", Vector3.new(10, 9, 8), base * CFrame.new(8, 4.8, -16), { 200, 200, 205 }, Enum.Material.Concrete)
	prompt(shopDoor, "gas", "Taller", sp.Name)
	table.insert(World.NpcPoints, { Pos = (base * CFrame.new(2, 0, -6)).Position, Look = (base * CFrame.new(0, 0, 2)).Position, Name = "Mecánico de " .. sp.Name, Role = "mechanic" })
	trim.CanQuery = false
end

local function buildResidence(parent, sp)
	local m = model(parent, "ResidenciaEconomica")
	local roomW, roomD, h = 22, 20, 12
	local perRow = 6
	local corridor = 10
	local totalW = roomW * perRow
	local totalD = roomD * 2 + corridor
	local base = CFrame.new(sp.WX, GROUND_TOP, sp.WZ)
	P(m, "Floor", Vector3.new(totalW, 0.6, totalD), base * CFrame.new(0, 0.3, 0), { 120, 110, 100 }, Enum.Material.WoodPlanks)
	P(m, "Roof", Vector3.new(totalW + 2, 1, totalD + 2), base * CFrame.new(0, h + 0.5, 0), { 90, 80, 75 }, Enum.Material.Slate)
	P(m, "WallN", Vector3.new(totalW, h, 1), base * CFrame.new(0, h / 2, -totalD / 2), { 200, 185, 160 }, Enum.Material.Brick)
	P(m, "WallS", Vector3.new(totalW, h, 1), base * CFrame.new(0, h / 2, totalD / 2), { 200, 185, 160 }, Enum.Material.Brick)
	-- extremos con puertas (pasillo a lo largo del eje X)
	for _, sx in ipairs({ -1, 1 }) do
		local ex = sx * totalW / 2
		local side = (totalD - 10) / 2
		P(m, "WallEnd", Vector3.new(1, h, side), base * CFrame.new(ex, h / 2, -totalD / 2 + side / 2), { 200, 185, 160 }, Enum.Material.Brick)
		P(m, "WallEnd", Vector3.new(1, h, side), base * CFrame.new(ex, h / 2, totalD / 2 - side / 2), { 200, 185, 160 }, Enum.Material.Brick)
		P(m, "WallEnd", Vector3.new(1, h - 9, 10), base * CFrame.new(ex, 9 + (h - 9) / 2, 0), { 200, 185, 160 }, Enum.Material.Brick)
	end
	local board = P(m, "ResidenceSign", Vector3.new(0.6, 3, 16), base * CFrame.new(totalW / 2 + 0.6, h - 2, 0), { 30, 30, 36 })
	sign(board, Enum.NormalId.Right, "🏠 " .. sp.Name, nil, Color3.fromRGB(255, 214, 120))
	local index = 0
	for row = 0, 1 do
		for col = 0, perRow - 1 do
			index = index + 1
			local rx = -totalW / 2 + roomW / 2 + col * roomW
			local rz = (row == 0) and (-totalD / 2 + roomD / 2) or (totalD / 2 - roomD / 2)
			local rbase = base * CFrame.new(rx, 0, rz)
			local towardCorridor = (row == 0) and 1 or -1 -- dirección Z hacia el pasillo
			-- tabiques entre habitaciones
			P(m, "Partition", Vector3.new(0.6, h, roomD), rbase * CFrame.new(-roomW / 2, h / 2, 0), { 230, 225, 215 }, Enum.Material.Plaster)
			-- pared del pasillo con puerta
			local wz = towardCorridor * roomD / 2
			P(m, "RoomWall", Vector3.new(8, h, 0.6), rbase * CFrame.new(-7, h / 2, wz), { 230, 225, 215 }, Enum.Material.Plaster)
			P(m, "RoomWall", Vector3.new(8, h, 0.6), rbase * CFrame.new(7, h / 2, wz), { 230, 225, 215 }, Enum.Material.Plaster)
			P(m, "RoomWall", Vector3.new(6, h - 8, 0.6), rbase * CFrame.new(0, 8 + (h - 8) / 2, wz), { 230, 225, 215 }, Enum.Material.Plaster)
			local plate = P(m, "DoorSign", Vector3.new(6, 1.4, 0.2), rbase * CFrame.new(0, 9.2, wz + towardCorridor * 0.45), { 30, 30, 36 })
			local face = (towardCorridor > 0) and Enum.NormalId.Back or Enum.NormalId.Front
			local label = sign(plate, face, "Hab. " .. index .. " · Libre", nil, Color3.new(1, 1, 1), Enum.Font.GothamBold)
			-- alfombra, cama, ventana, luz, vestidor
			local inward = -towardCorridor
			P(m, "Rug", Vector3.new(10, 0.1, 8), rbase * CFrame.new(0, 0.65, 0), { 140 + (index * 13) % 80, 90, 110 }, Enum.Material.Fabric, { NoCollide = true })
			local bed = P(m, "Bed", Vector3.new(6, 1.6, 9), rbase * CFrame.new(-7, 1.4, inward * 4), { 250, 250, 255 }, Enum.Material.Fabric)
			prompt(bed, "rest", "Descansar", "Cama")
			P(m, "BedFrame", Vector3.new(6.4, 1, 9.4), rbase * CFrame.new(-7, 0.9, inward * 4), { 110, 80, 60 }, Enum.Material.Wood)
			P(m, "Pillow", Vector3.new(4, 0.6, 1.6), rbase * CFrame.new(-7, 2.4, inward * 7.6), { 255, 255, 255 }, Enum.Material.Fabric)
			local lamp = P(m, "RoomLamp", Vector3.new(3, 0.3, 3), rbase * CFrame.new(0, h - 0.3, 0), { 255, 245, 220 }, Enum.Material.Neon, { NoShadow = true })
			local pl = Instance.new("PointLight")
			pl.Range = 18
			pl.Brightness = 1
			pl.Parent = lamp
			local win = P(m, "Window", Vector3.new(8, 4, 0.3), rbase * CFrame.new(0, 6.5, inward * (roomD / 2) + inward * -0.2), { 180, 220, 255 }, Enum.Material.Glass, { Transparency = 0.4 })
			win.CanCollide = true
			local wardrobe = P(m, "Wardrobe", Vector3.new(2, 8, 5), rbase * CFrame.new(roomW / 2 - 1.6, 4, inward * -4), { 160, 120, 90 }, Enum.Material.WoodPlanks)
			local wp = prompt(wardrobe, "wardrobe", "Vestidor", "Cambiar estilo", { Owner = 0 })
			local fridge = P(m, "Fridge", Vector3.new(3, 6, 3), rbase * CFrame.new(roomW / 2 - 2, 3, inward * 6), { 230, 235, 240 }, Enum.Material.Metal)
			prompt(fridge, "cook", "Cocinar", "Cocina")
			-- Escritorio: los muebles visibles los dibuja HomeService según el inventario
			local deskCF = rbase * CFrame.new(5, 3.4, inward * (roomD / 2 - 3)) * CFrame.Angles(0, (inward > 0) and 0 or math.pi, 0)
			local anchor = P(m, "DeskAnchor", Vector3.new(8, 4, 4), deskCF * CFrame.new(0, -1.5, 0), { 0, 0, 0 }, Enum.Material.SmoothPlastic, { Transparency = 1, NoCollide = true })
			anchor.CanQuery = false
			local dp = prompt(anchor, "computer_home", "Usar computador", "Tu escritorio", { Owner = 0 })
			local dynamic = folder(m, "Room" .. index .. "Furniture")
			table.insert(World.HomeRooms, {
				Index = index,
				Center = (rbase * CFrame.new(0, 1, 0)).Position,
				Size = Vector3.new(roomW, h, roomD),
				DeskCFrame = deskCF,
				Dynamic = dynamic,
				Sign = label,
				DeskPrompt = dp,
				Wardrobe = wp,
			})
		end
	end
	-- Marcador para la flecha del tutorial
	World.HomePosition = Vector3.new(sp.WX + totalW / 2 + 6, GROUND_TOP + 3, sp.WZ)
end

local function buildVipLounge(parent, cx, cz)
	local m = model(parent, "SalaVIP")
	-- La sala está elevada y cerrada: solo se entra con el aviso de la puerta.
	local center = Vector3.new(cx, -60, cz) -- bajo tierra: invisible desde la ciudad
	local base = CFrame.new(center)
	local w, d, h = 40, 30, 12
	P(m, "Floor", Vector3.new(w, 1, d), base, { 30, 20, 40 }, Enum.Material.Marble)
	P(m, "Ceiling", Vector3.new(w, 1, d), base * CFrame.new(0, h, 0), { 20, 15, 30 }, Enum.Material.Marble)
	for _, wall in ipairs({ { 0, -d / 2, w, 1 }, { 0, d / 2, w, 1 }, { -w / 2, 0, 1, d }, { w / 2, 0, 1, d } }) do
		P(m, "Wall", Vector3.new(wall[3], h, wall[4]), base * CFrame.new(wall[1], h / 2, wall[2]), { 60, 30, 80 }, Enum.Material.Fabric)
	end
	P(m, "Sofa", Vector3.new(14, 2, 4), base * CFrame.new(0, 1.5, -10), { 200, 160, 60 }, Enum.Material.Fabric)
	local neon = P(m, "Neon", Vector3.new(w - 2, 0.4, 0.4), base * CFrame.new(0, h - 1, -d / 2 + 0.8), { 255, 200, 80 }, Enum.Material.Neon, { NoShadow = true })
	local l = Instance.new("PointLight")
	l.Range = 40
	l.Color = Color3.fromRGB(255, 200, 120)
	l.Parent = neon
	local exit = P(m, "ExitDoor", Vector3.new(6, 9, 0.5), base * CFrame.new(0, 5, d / 2 - 0.6), { 40, 40, 44 }, Enum.Material.Metal)
	prompt(exit, "vip_exit", "Salir", "Sala VIP")
	local door = P(m, "VipDoor", Vector3.new(8, 10, 1), Vector3.new(cx, GROUND_TOP + 5, cz + 20), { 20, 20, 24 }, Enum.Material.Metal)
	local s = P(m, "VipSign", Vector3.new(8, 2, 0.4), Vector3.new(cx, GROUND_TOP + 11, cz + 20.6), { 20, 20, 24 })
	signBoth(s, "⭐ SALA VIP", nil, Color3.fromRGB(255, 214, 0))
	prompt(door, "vip_enter", "Entrar", "Sala VIP (Game Pass VIP)")
	World.VipLounge = { Center = center + Vector3.new(0, 3, 0), Size = Vector3.new(w, h, d), Entry = Vector3.new(cx, GROUND_TOP + 3, cz + 26) }
end

-- Cartel de una propiedad en venta / alquiler
local function buildPropertySign(parent, l)
	local pos = S.Property.signPosition(l)
	P(parent, "PropertyPost", Vector3.new(0.5, 7, 0.5), Vector3.new(pos.X, GROUND_TOP + 3.5, pos.Z), { 240, 240, 240 }, Enum.Material.Metal)
	local board = P(parent, "PropertySign", Vector3.new(10, 5, 0.4), Vector3.new(pos.X, GROUND_TOP + 7.5, pos.Z), { 255, 255, 255 })
	local price = {}
	if l.Rent then
		price[#price + 1] = "Alquiler $" .. Util.formatInt(l.Rent) .. "/sem"
	end
	if l.Buy then
		price[#price + 1] = "Venta $" .. Util.formatInt(l.Buy)
	end
	local text = "🏠 " .. l.Type:upper() .. "\n" .. table.concat(price, " · ")
	sign(board, Enum.NormalId.Back, text, Color3.fromRGB(20, 110, 70), Color3.new(1, 1, 1), Enum.Font.GothamBold)
	signBoth(board, text, Color3.fromRGB(20, 110, 70), Color3.new(1, 1, 1), Enum.Font.GothamBold)
	local base = P(parent, "PropertyDoor", Vector3.new(6, 8, 1), Vector3.new(pos.X, GROUND_TOP + 4, pos.Z - 4), { 90, 60, 40 }, Enum.Material.Wood)
	prompt(base, "prop_view", "Ver anuncio", l.Name, { PropId = l.Id })
	local enter = prompt(base, "prop_enter", "Entrar", l.Name, { PropId = l.Id })
	enter.KeyboardKeyCode = Enum.KeyCode.G
end

---------------------------------------------------------------------------
-- Aeropuerto (Terminal Internacional) y destinos de viaje (lejos de la ciudad)
---------------------------------------------------------------------------

-- Marcador 🎥 de un lugar de grabación (igual que los de la ciudad)
local function recordMarker(parent, x, z, name)
	local marker = P(parent, "RecordSpot", Vector3.new(0.3, 10, 10), CFrame.new(x, GROUND_TOP + 0.2, z) * CFrame.Angles(0, 0, math.rad(90)),
		{ 255, 50, 90 }, Enum.Material.Neon, { Shape = Enum.PartType.Cylinder, NoCollide = true, Transparency = 0.45, NoShadow = true })
	marker.CanQuery = false
	CollectionService:AddTag(marker, "RecordSpot")
	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.fromOffset(220, 40)
	bb.StudsOffset = Vector3.new(0, 7, 0)
	bb.MaxDistance = 160
	bb.Parent = marker
	local t = Instance.new("TextLabel")
	t.Size = UDim2.fromScale(1, 1)
	t.BackgroundColor3 = Color3.fromRGB(20, 20, 24)
	t.BackgroundTransparency = 0.25
	t.TextColor3 = Color3.new(1, 1, 1)
	t.Font = Enum.Font.GothamBold
	t.TextScaled = true
	t.Text = "🎥 " .. name
	t.Parent = bb
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 10)
	corner.Parent = t
	return marker
end

local function buildAirport(parent, sp)
	local m = model(parent, "TerminalInternacional")
	local w, d, h = 56, 34, 16
	local base = shell(m, sp.WX, sp.WZ, w, d, h, { 225, 230, 238 }, { 205, 210, 218 })
	local board = P(m, "TerminalSign", Vector3.new(30, 4, 0.6), base * CFrame.new(0, h - 2.5, d / 2 + 1.2), { 20, 40, 80 })
	signBoth(board, "✈ " .. sp.Name, Color3.fromRGB(20, 40, 80), Color3.new(1, 1, 1))
	-- Mostrador de facturación
	local counter = P(m, "CheckInCounter", Vector3.new(22, 4, 3), base * CFrame.new(0, 2, -d / 2 + 8), { 60, 70, 90 }, Enum.Material.Metal)
	P(m, "CounterTop", Vector3.new(22.4, 0.4, 3.4), base * CFrame.new(0, 4.2, -d / 2 + 8), { 235, 235, 240 }, Enum.Material.Marble)
	prompt(counter, "airport", "Ver vuelos", sp.Name)
	table.insert(World.NpcPoints, { Pos = (base * CFrame.new(0, 0, -d / 2 + 4)).Position, Look = (base * CFrame.new(0, 0, 0)).Position, Name = "Agente de viajes", Role = "travel" })
	-- Panel de salidas con todos los destinos
	local names = {}
	for _, dest in ipairs(LifeData.Destinations) do
		names[#names + 1] = "✈ " .. dest.Name .. "  $" .. Util.formatInt(dest.Cost)
	end
	local screen = P(m, "DeparturesBoard", Vector3.new(26, 9, 0.4), base * CFrame.new(0, 9.5, -d / 2 + 1), { 10, 14, 30 }, Enum.Material.Neon, { NoShadow = true })
	signBoth(screen, "SALIDAS\n" .. table.concat(names, "\n"), Color3.fromRGB(10, 14, 30), Color3.fromRGB(255, 214, 80), Enum.Font.Code)
	-- Asientos de espera (pasillo central libre)
	for _, sx in ipairs({ -1, 1 }) do
		for row = 0, 1 do
			for i = 0, 2 do
				P(m, "Seat", Vector3.new(3, 1.2, 3), base * CFrame.new(sx * (10 + i * 4), 1.6, 5 + row * 6), { 40, 90, 160 }, Enum.Material.Fabric)
				P(m, "SeatBack", Vector3.new(3, 2, 0.4), base * CFrame.new(sx * (10 + i * 4), 2.8, 6.3 + row * 6), { 40, 90, 160 }, Enum.Material.Fabric)
			end
		end
	end
	-- Torre de control en el tejado
	P(m, "ControlTower", Vector3.new(4, 10, 4), base * CFrame.new(w / 2 - 6, h + 5, -d / 2 + 6), { 200, 205, 215 }, Enum.Material.Concrete)
	local cab = P(m, "ControlCab", Vector3.new(8, 4, 8), base * CFrame.new(w / 2 - 6, h + 12, -d / 2 + 6), { 120, 180, 220 }, Enum.Material.Glass, { Transparency = 0.3 })
	nightLight(cab, 30, Color3.fromRGB(120, 200, 255))
end

-- Edificio abierto por delante (+Z local): suelo, paredes trasera y laterales, techo y luz
local function destBooth(parent, cf, w, d, h, wallColor, floorColor)
	P(parent, "Floor", Vector3.new(w, 0.6, d), cf * CFrame.new(0, 0.3, 0), floorColor, Enum.Material.WoodPlanks)
	P(parent, "WallBack", Vector3.new(w, h, 1), cf * CFrame.new(0, h / 2, -d / 2), wallColor, Enum.Material.Concrete)
	P(parent, "WallSide", Vector3.new(1, h, d), cf * CFrame.new(-w / 2, h / 2, 0), wallColor, Enum.Material.Concrete)
	P(parent, "WallSide", Vector3.new(1, h, d), cf * CFrame.new(w / 2, h / 2, 0), wallColor, Enum.Material.Concrete)
	P(parent, "Roof", Vector3.new(w + 2, 1, d + 2), cf * CFrame.new(0, h + 0.5, 0), { 60, 60, 66 }, Enum.Material.Concrete)
	local lamp = P(parent, "CeilingLamp", Vector3.new(4, 0.4, 4), cf * CFrame.new(0, h - 0.3, 0), { 255, 250, 230 }, Enum.Material.Neon, { NoShadow = true })
	local l = Instance.new("PointLight")
	l.Range = 30
	l.Brightness = 1.2
	l.Parent = lamp
end

local function palm(parent, x, z, h, rng)
	local lean = math.rad(rng:NextInteger(-8, 8))
	P(parent, "PalmTrunk", Vector3.new(h, 1.4, 1.4), CFrame.new(x, GROUND_TOP + h / 2, z) * CFrame.Angles(lean, 0, math.rad(90)), { 150, 110, 70 }, Enum.Material.Wood, { Shape = Enum.PartType.Cylinder })
	for i = 1, 6 do
		local a = i / 6 * math.pi * 2
		P(parent, "PalmFrond", Vector3.new(9, 0.4, 2.4), CFrame.new(x, GROUND_TOP + h + 0.5, z) * CFrame.Angles(0, a, 0) * CFrame.new(4, 0, 0) * CFrame.Angles(0, 0, math.rad(-18)),
			{ 60, 150, 70 }, Enum.Material.Grass)
	end
	for i = 1, 3 do
		P(parent, "Coconut", Vector3.new(1.1, 1.1, 1.1), Vector3.new(x + math.cos(i * 2.1), GROUND_TOP + h - 0.6, z + math.sin(i * 2.1)), { 110, 80, 40 }, Enum.Material.Wood, { Shape = Enum.PartType.Ball })
	end
end

local function pine(parent, x, z, s, snow)
	P(parent, "PineTrunk", Vector3.new(6 * s, 1.4 * s, 1.4 * s), CFrame.new(x, GROUND_TOP + 3 * s, z) * CFrame.Angles(0, 0, math.rad(90)), { 100, 70, 45 }, Enum.Material.Wood, { Shape = Enum.PartType.Cylinder })
	for i = 0, 2 do
		local r = (9 - i * 2.5) * s
		P(parent, "PineLeaves", Vector3.new(r, r * 0.8, r), Vector3.new(x, GROUND_TOP + (7 + i * 4.5) * s, z), { 40, 95, 60 }, Enum.Material.Grass, { Shape = Enum.PartType.Ball })
	end
	if snow then
		P(parent, "SnowCap", Vector3.new(3 * s, 2 * s, 3 * s), Vector3.new(x, GROUND_TOP + 18.5 * s, z), { 250, 252, 255 }, Enum.Material.Snow, { Shape = Enum.PartType.Ball })
	end
end

-- Cable recto entre dos puntos (telesilla, guirnaldas)
local function cable(parent, a, b, thickness, color, material)
	local dx, dy, dz = b.X - a.X, b.Y - a.Y, b.Z - a.Z
	local len = math.sqrt(dx * dx + dy * dy + dz * dz)
	local yaw = math.atan2(dx, dz)
	local pitch = -math.asin(dy / len)
	local mid = Vector3.new((a.X + b.X) / 2, (a.Y + b.Y) / 2, (a.Z + b.Z) / 2)
	return P(parent, "Cable", Vector3.new(thickness, thickness, len), CFrame.new(mid) * CFrame.Angles(0, yaw, 0) * CFrame.Angles(pitch, 0, 0), color, material or Enum.Material.Metal, { NoShadow = true })
end

local destThemes = {}

destThemes.island = function(m, dest, cx, cz, rng, free, block)
	-- Mar alrededor de la isla y laguna del arrecife junto a la playa
	workspace.Terrain:FillBlock(CFrame.new(cx, -4, cz), Vector3.new(820, 8, 820), Enum.Material.Water)
	workspace.Terrain:FillBlock(CFrame.new(cx, GROUND_TOP + 1, cz + 90), Vector3.new(110, 4, 28), Enum.Material.Water)
	block(cx - 30, cz + 90, 26)
	block(cx + 30, cz + 90, 26)
	for _, c in ipairs({ { -20, 86, { 255, 120, 120 } }, { 15, 94, { 255, 200, 80 } }, { 35, 84, { 200, 120, 255 } } }) do
		P(m, "Coral", Vector3.new(3, 3, 3), Vector3.new(cx + c[1], GROUND_TOP + 0.8, cz + c[2]), c[3], Enum.Material.Pebble, { Shape = Enum.PartType.Ball })
	end
	-- Playa: sombrillas y toallas
	for i, p in ipairs({ { -24, 48 }, { 22, 46 }, { 34, 70 }, { -30, 72 } }) do
		local x, z = cx + p[1], cz + p[2]
		P(m, "UmbrellaPole", Vector3.new(0.4, 8, 0.4), Vector3.new(x, GROUND_TOP + 4, z), { 240, 240, 240 }, Enum.Material.Metal)
		P(m, "Umbrella", Vector3.new(0.6, 10, 10), CFrame.new(x, GROUND_TOP + 8, z) * CFrame.Angles(0, 0, math.rad(90)), i % 2 == 0 and { 255, 90, 90 } or { 60, 180, 230 }, Enum.Material.Fabric, { Shape = Enum.PartType.Cylinder })
		P(m, "Towel", Vector3.new(3, 0.1, 6), Vector3.new(x + 4, GROUND_TOP + 0.15, z), i % 2 == 0 and { 255, 220, 80 } or { 255, 140, 200 }, Enum.Material.Fabric, { NoCollide = true })
	end
	-- Muelle del pueblo pesquero, barcas y casas
	P(m, "Pier", Vector3.new(44, 1, 8), Vector3.new(cx - 120, GROUND_TOP + 1, cz - 40), { 130, 95, 65 }, Enum.Material.WoodPlanks)
	for _, b in ipairs({ { -150, -55 }, { -150, -25 } }) do
		P(m, "Boat", Vector3.new(14, 2.4, 5), Vector3.new(cx + b[1], GROUND_TOP + 1.2, cz + b[2]), { 240, 240, 245 }, Enum.Material.Wood)
		P(m, "BoatStripe", Vector3.new(14.2, 0.6, 5.2), Vector3.new(cx + b[1], GROUND_TOP + 1.8, cz + b[2]), { 30, 110, 200 }, Enum.Material.SmoothPlastic)
	end
	local village = { Palette = { { 250, 245, 230 }, { 120, 200, 220 }, { 255, 200, 150 } } }
	for _, hpos in ipairs({ { -150, -110 }, { -110, -140 }, { -160, 30 }, { -60, -150 } }) do
		if free(cx + hpos[1], cz + hpos[2], 14) then
			styleBuilders.house(m, cx + hpos[1], cz + hpos[2], village, rng)
			block(cx + hpos[1], cz + hpos[2], 18)
		end
	end
	-- Mirador: colina con una palmera gigante
	P(m, "Hill", Vector3.new(70, 40, 70), Vector3.new(cx + 150, GROUND_TOP - 10, cz - 120), { 200, 185, 130 }, Enum.Material.Sand, { Shape = Enum.PartType.Ball })
	block(cx + 150, cz - 120, 38)
	palm(m, cx + 104, cz - 84, 30, rng)
	for _ = 1, 60 do
		local x, z = cx + rng:NextInteger(-195, 195), cz + rng:NextInteger(-195, 195)
		if free(x, z, 6) then
			palm(m, x, z, rng:NextInteger(14, 22), rng)
			block(x, z, 10)
		end
	end
end

destThemes.neo = function(m, dest, cx, cz, rng, free, block)
	local neon = { { 0, 220, 255 }, { 255, 40, 200 }, { 140, 80, 255 }, { 60, 255, 160 } }
	-- Rejilla luminosa en el suelo
	for i = -3, 3 do
		P(m, "GridLine", Vector3.new(0.6, 0.1, 400), Vector3.new(cx + i * 60, GROUND_TOP + 0.12, cz), neon[1], Enum.Material.Neon, { NoCollide = true, NoShadow = true })
		P(m, "GridLine", Vector3.new(400, 0.1, 0.6), Vector3.new(cx, GROUND_TOP + 0.12, cz + i * 60), neon[2], Enum.Material.Neon, { NoCollide = true, NoShadow = true })
	end
	-- Avenida de hologramas: columnas holográficas
	for _, sx in ipairs({ -26, 26 }) do
		for k = -2, 2 do
			local col = P(m, "HoloPillar", Vector3.new(14, 3, 3), CFrame.new(cx + sx, GROUND_TOP + 7, cz + k * 26) * CFrame.Angles(0, 0, math.rad(90)),
				neon[(k + 3) % #neon + 1], Enum.Material.Neon, { Shape = Enum.PartType.Cylinder, Transparency = 0.35, NoShadow = true })
			col.CanCollide = false
		end
	end
	-- Torre de datos
	local tx, tz = cx + 125, cz - 100
	P(m, "DataTower", Vector3.new(30, 200, 30), Vector3.new(tx, GROUND_TOP + 100, tz), { 25, 25, 40 }, Enum.Material.Glass)
	for i = 1, 8 do
		P(m, "DataBand", Vector3.new(31, 1.2, 31), Vector3.new(tx, GROUND_TOP + i * 24, tz), neon[i % #neon + 1], Enum.Material.Neon, { NoShadow = true })
	end
	P(m, "Antenna", Vector3.new(1, 40, 1), Vector3.new(tx, GROUND_TOP + 220, tz), { 200, 200, 210 }, Enum.Material.Metal)
	block(tx, tz, 26)
	-- Mercado robótico: puestos con toldos de neón
	for i, s in ipairs({ { -110, 40 }, { -95, 80 }, { -40, 80 }, { -45, 35 } }) do
		local x, z = cx + s[1], cz + s[2]
		if free(x, z, 6) then
			P(m, "Stall", Vector3.new(10, 4, 6), Vector3.new(x, GROUND_TOP + 2, z), { 50, 50, 70 }, Enum.Material.Metal)
			P(m, "StallAwning", Vector3.new(11, 0.4, 7), Vector3.new(x, GROUND_TOP + 7, z), neon[i % #neon + 1], Enum.Material.Neon, { NoShadow = true })
			block(x, z, 8)
		end
	end
	-- Robots
	for _ = 1, 10 do
		local x, z = cx + rng:NextInteger(-150, 150), cz + rng:NextInteger(-150, 150)
		if free(x, z, 3) then
			P(m, "RobotBody", Vector3.new(2, 3, 1.4), Vector3.new(x, GROUND_TOP + 2.5, z), { 200, 205, 215 }, Enum.Material.Metal)
			P(m, "RobotHead", Vector3.new(1.6, 1.6, 1.6), Vector3.new(x, GROUND_TOP + 4.8, z), { 220, 225, 235 }, Enum.Material.Metal, { Shape = Enum.PartType.Ball })
			P(m, "RobotEye", Vector3.new(1.2, 0.3, 0.2), Vector3.new(x, GROUND_TOP + 5, z + 0.75), neon[1], Enum.Material.Neon, { NoShadow = true })
			block(x, z, 4)
		end
	end
	-- Rascacielos con franjas de neón y pantallas
	local screens = { "NEO 2099", "HOLOGRAMAS 24 h", "ROBÓTICA ORBIS", "NEO STORE", "VIAJA AL FUTURO" }
	local placed = 0
	for _ = 1, 80 do
		if placed >= 12 then
			break
		end
		local x, z = cx + rng:NextInteger(-185, 185), cz + rng:NextInteger(-185, 185)
		if free(x, z, 18) then
			local h = rng:NextInteger(70, 170)
			local w = rng:NextInteger(22, 32)
			P(m, "NeoTower", Vector3.new(w, h, w), Vector3.new(x, GROUND_TOP + h / 2, z), { 30 + rng:NextInteger(0, 20), 30, 50 }, Enum.Material.Glass)
			local c = neon[rng:NextInteger(1, #neon)]
			for k = 1, 4 do
				P(m, "NeonStrip", Vector3.new(w + 0.6, 0.8, w + 0.6), Vector3.new(x, GROUND_TOP + h * k / 5, z), c, Enum.Material.Neon, { NoShadow = true })
			end
			if placed < #screens then
				local scr = P(m, "HoloScreen", Vector3.new(w - 4, 10, 0.4), Vector3.new(x, GROUND_TOP + h * 0.5, z + w / 2 + 0.6), { 10, 10, 20 }, Enum.Material.Neon, { NoShadow = true })
				signBoth(scr, screens[placed + 1], Color3.fromRGB(10, 10, 30), rgb(c))
			end
			block(x, z, w * 0.8)
			placed = placed + 1
		end
	end
	-- Coches voladores (decoración)
	for i = 1, 6 do
		local a = i / 6 * math.pi * 2
		P(m, "HoverCar", Vector3.new(5, 2, 10), CFrame.new(cx + math.cos(a) * 90, GROUND_TOP + 30 + i * 4, cz + math.sin(a) * 90) * CFrame.Angles(0, a, 0), neon[i % #neon + 1], Enum.Material.SmoothPlastic, { NoShadow = true })
	end
end

destThemes.ski = function(m, dest, cx, cz, rng, free, block)
	-- Pista principal: rampa nevada que baja hacia el lugar 🎥
	P(m, "SkiSlope", Vector3.new(60, 40, 160), Vector3.new(cx, GROUND_TOP + 20, cz - 60), { 245, 248, 255 }, Enum.Material.Snow, { Class = "WedgePart" })
	for i = -2, 2 do
		if i ~= 0 then
			P(m, "SlalomFlag", Vector3.new(0.3, 4, 0.3), Vector3.new(cx + i * 9, GROUND_TOP + 2, cz + 24), { 220, 40, 40 }, Enum.Material.SmoothPlastic)
		end
	end
	for z = -130, 10, 20 do
		block(cx, cz + z, 34)
	end
	-- Colinas nevadas alrededor
	for i = 1, 14 do
		local a = i / 14 * math.pi * 2
		local x, z = cx + math.cos(a) * 205, cz + math.sin(a) * 205
		local s = rng:NextInteger(60, 110)
		if math.sin(a) < 0.3 and free(x, z, s * 0.35) then
			P(m, "SnowHill", Vector3.new(s, s * 0.7, s), Vector3.new(x, GROUND_TOP - s * 0.1, z), { 245, 248, 255 }, Enum.Material.Snow, { Shape = Enum.PartType.Ball })
		end
	end
	-- Refugio de montaña
	local cabinStyle = { Palette = { { 120, 80, 50 }, { 150, 100, 60 } } }
	styleBuilders.cabin(m, cx - 100, cz - 80, cabinStyle, rng)
	P(m, "Chimney", Vector3.new(2, 6, 2), Vector3.new(cx - 95, GROUND_TOP + 14, cz - 80), { 120, 110, 100 }, Enum.Material.Brick)
	block(cx - 100, cz - 80, 14)
	-- Telesilla: estación, torres, cable y sillas
	local stations = { Vector3.new(cx + 100, GROUND_TOP + 14, cz - 70), Vector3.new(cx + 125, GROUND_TOP + 22, cz - 105), Vector3.new(cx + 150, GROUND_TOP + 30, cz - 140), Vector3.new(cx + 175, GROUND_TOP + 38, cz - 175) }
	P(m, "LiftStation", Vector3.new(12, 8, 10), Vector3.new(cx + 96, GROUND_TOP + 4, cz - 62), { 200, 60, 50 }, Enum.Material.WoodPlanks)
	for i, top in ipairs(stations) do
		P(m, "LiftTower", Vector3.new(1.4, top.Y - GROUND_TOP, 1.4), Vector3.new(top.X, (top.Y + GROUND_TOP) / 2, top.Z), { 90, 90, 100 }, Enum.Material.Metal)
		P(m, "LiftArm", Vector3.new(6, 0.8, 0.8), CFrame.new(top) * CFrame.Angles(0, math.rad(-35), 0), { 90, 90, 100 }, Enum.Material.Metal)
		block(top.X, top.Z, 6)
		if i > 1 then
			local a = stations[i - 1]
			cable(m, a, top, 0.3, { 40, 40, 44 })
			local mid = Vector3.new((a.X + top.X) / 2, (a.Y + top.Y) / 2 - 3, (a.Z + top.Z) / 2)
			P(m, "ChairHanger", Vector3.new(0.2, 3, 0.2), mid + Vector3.new(0, 1.5, 0), { 40, 40, 44 }, Enum.Material.Metal)
			P(m, "Chair", Vector3.new(4, 0.5, 2), mid, { 30, 90, 200 }, Enum.Material.SmoothPlastic)
		end
	end
	-- Cabañas, pinos nevados y muñecos de nieve
	local placed = 0
	for _ = 1, 40 do
		if placed >= 5 then
			break
		end
		local x, z = cx + rng:NextInteger(-170, 170), cz + rng:NextInteger(-170, 170)
		if free(x, z, 14) then
			styleBuilders.cabin(m, x, z, cabinStyle, rng)
			block(x, z, 16)
			placed = placed + 1
		end
	end
	for _ = 1, 70 do
		local x, z = cx + rng:NextInteger(-185, 185), cz + rng:NextInteger(-185, 185)
		if free(x, z, 5) then
			pine(m, x, z, 0.8 + rng:NextNumber() * 0.6, true)
			block(x, z, 8)
		end
	end
	for _, s in ipairs({ { -30, 70 }, { 40, 80 }, { -60, 10 } }) do
		local x, z = cx + s[1], cz + s[2]
		if free(x, z, 2) then
			P(m, "SnowmanBase", Vector3.new(4, 4, 4), Vector3.new(x, GROUND_TOP + 2, z), { 250, 252, 255 }, Enum.Material.Snow, { Shape = Enum.PartType.Ball })
			P(m, "SnowmanHead", Vector3.new(2.6, 2.6, 2.6), Vector3.new(x, GROUND_TOP + 5, z), { 250, 252, 255 }, Enum.Material.Snow, { Shape = Enum.PartType.Ball })
			P(m, "SnowmanNose", Vector3.new(0.3, 0.3, 1.2), Vector3.new(x, GROUND_TOP + 5, z + 1.5), { 255, 140, 40 }, Enum.Material.SmoothPlastic)
		end
	end
end

destThemes.expo = function(m, dest, cx, cz, rng, free, block)
	-- Pabellón principal: gran cubierta con columnas, pantalla gigante y stands de marcas ficticias
	P(m, "HallFloor", Vector3.new(130, 0.4, 90), Vector3.new(cx, GROUND_TOP + 0.2, cz - 10), { 235, 238, 245 }, Enum.Material.Marble)
	for _, x in ipairs({ -64, -32, 0, 32, 64 }) do
		for _, z in ipairs({ -54, 34 }) do
			P(m, "HallColumn", Vector3.new(2, 26, 2), Vector3.new(cx + x, GROUND_TOP + 13, cz + z), { 200, 205, 215 }, Enum.Material.Metal)
		end
	end
	P(m, "HallRoof", Vector3.new(134, 1.5, 94), Vector3.new(cx, GROUND_TOP + 26.5, cz - 10), { 230, 235, 245 }, Enum.Material.Glass, { Transparency = 0.4 })
	local screen = P(m, "MainScreen", Vector3.new(60, 18, 0.6), Vector3.new(cx, GROUND_TOP + 14, cz - 53), { 20, 40, 90 }, Enum.Material.Neon, { NoShadow = true })
	signBoth(screen, "FERIA TECNOLÓGICA INTERNACIONAL", Color3.fromRGB(10, 20, 60), Color3.fromRGB(120, 220, 255))
	local brands = { "Nexo", "Kairo", "Zenit", "Lumina", "Orbis", "Stratos", "Pixelia", "Ferro" }
	local i = 0
	for _, z in ipairs({ -36, 20 }) do
		for _, x in ipairs({ -50, -25, 25, 50 }) do
			i = i + 1
			local bx, bz = cx + x, cz + z
			P(m, "Stand", Vector3.new(16, 0.6, 12), Vector3.new(bx, GROUND_TOP + 0.7, bz), { 40, 45, 60 }, Enum.Material.SmoothPlastic)
			P(m, "StandDesk", Vector3.new(8, 3.5, 2.5), Vector3.new(bx, GROUND_TOP + 2.75, bz + 3), { 250, 250, 252 }, Enum.Material.SmoothPlastic)
			local panel = P(m, "StandPanel", Vector3.new(14, 7, 0.4), Vector3.new(bx, GROUND_TOP + 5, bz - 5.5), { 30, 30, 40 }, Enum.Material.Neon, { NoShadow = true })
			signBoth(panel, brands[i], Color3.fromRGB(20 + i * 20, 30, 80), Color3.new(1, 1, 1))
			P(m, "StandGadget", Vector3.new(1.4, 1.4, 1.4), Vector3.new(bx, GROUND_TOP + 5.2, bz + 3), { 255, 214, 0 }, Enum.Material.Neon, { Shape = Enum.PartType.Ball, NoShadow = true })
			block(bx, bz, 10)
		end
	end
	-- Zona de prototipos: vitrinas brillantes en círculo
	for k = 1, 6 do
		local a = k / 6 * math.pi * 2
		local x, z = cx + 70 + math.cos(a) * 16, cz + 60 + math.sin(a) * 16
		P(m, "ProtoPedestal", Vector3.new(3, 3, 3), Vector3.new(x, GROUND_TOP + 1.5, z), { 250, 250, 252 }, Enum.Material.Marble)
		P(m, "ProtoGlass", Vector3.new(3, 3, 3), Vector3.new(x, GROUND_TOP + 4.5, z), { 200, 230, 255 }, Enum.Material.Glass, { Transparency = 0.6 })
		P(m, "ProtoItem", Vector3.new(1.2, 1.2, 1.2), Vector3.new(x, GROUND_TOP + 4.2, z), ({ { 0, 220, 255 }, { 255, 40, 200 }, { 60, 255, 160 } })[k % 3 + 1], Enum.Material.Neon, { NoShadow = true })
	end
	-- Banderas de países ficticios en la entrada
	for k = -3, 3 do
		local x, z = cx + k * 14, cz + 75
		if free(x, z, 1) then
			P(m, "FlagPole", Vector3.new(0.4, 14, 0.4), Vector3.new(x, GROUND_TOP + 7, z), { 220, 220, 225 }, Enum.Material.Metal)
			P(m, "Flag", Vector3.new(4, 2.6, 0.1), Vector3.new(x + 2, GROUND_TOP + 12.5, z), ({ { 220, 40, 40 }, { 40, 120, 220 }, { 250, 200, 40 }, { 60, 170, 90 } })[(k + 4) % 4 + 1], Enum.Material.Fabric)
		end
	end
	-- Jardines y bancos alrededor
	for _ = 1, 30 do
		local x, z = cx + rng:NextInteger(-190, 190), cz + rng:NextInteger(-190, 190)
		if free(x, z, 6) and (math.abs(x - cx) > 70 or math.abs(z - cz + 10) > 50) then
			tree(m, x, z, 0.8, rng)
			block(x, z, 9)
		end
	end
end

destThemes.valley = function(m, dest, cx, cz, rng, free, block)
	-- Lago del valle con orilla y embarcadero
	local lx, lz, lw, ld = cx + 140, cz - 30, 100, 90
	workspace.Terrain:FillBlock(CFrame.new(lx, GROUND_TOP + 1, lz), Vector3.new(lw, 4, ld), Enum.Material.Water)
	P(m, "Shore", Vector3.new(lw + 4, 2.4, 2), Vector3.new(lx, GROUND_TOP + 1.2, lz - ld / 2 - 1), { 120, 110, 100 }, Enum.Material.Slate)
	P(m, "Shore", Vector3.new(lw + 4, 2.4, 2), Vector3.new(lx, GROUND_TOP + 1.2, lz + ld / 2 + 1), { 120, 110, 100 }, Enum.Material.Slate)
	P(m, "Shore", Vector3.new(2, 2.4, ld), Vector3.new(lx - lw / 2 - 1, GROUND_TOP + 1.2, lz), { 120, 110, 100 }, Enum.Material.Slate)
	P(m, "Shore", Vector3.new(2, 2.4, ld), Vector3.new(lx + lw / 2 + 1, GROUND_TOP + 1.2, lz), { 120, 110, 100 }, Enum.Material.Slate)
	P(m, "Pier", Vector3.new(30, 1, 6), Vector3.new(lx - lw / 2 + 14, GROUND_TOP + 2.6, cz - 20), { 130, 95, 65 }, Enum.Material.WoodPlanks)
	block(lx, lz, 62)
	-- Cascada esmeralda: acantilado, caída de agua y poza
	P(m, "Cliff", Vector3.new(70, 50, 22), Vector3.new(cx - 60, GROUND_TOP + 25, cz - 117), { 110, 105, 95 }, Enum.Material.Slate)
	local fall = P(m, "Waterfall", Vector3.new(14, 46, 1), Vector3.new(cx - 60, GROUND_TOP + 24, cz - 105.6), { 120, 200, 255 }, Enum.Material.Glass, { Transparency = 0.35, NoCollide = true, NoShadow = true })
	fall.CanQuery = false
	workspace.Terrain:FillBlock(CFrame.new(cx - 60, GROUND_TOP + 1, cz - 92), Vector3.new(36, 4, 22), Enum.Material.Water)
	block(cx - 60, cz - 105, 40)
	-- Sendero de las secuoyas gigantes
	for _, sx in ipairs({ -26, 26 }) do
		for _, z in ipairs({ -10, 15, 65, 90 }) do
			local x, zz = cx + sx, cz + z
			local h = rng:NextInteger(40, 55)
			P(m, "SequoiaTrunk", Vector3.new(h, 4.5, 4.5), CFrame.new(x, GROUND_TOP + h / 2, zz) * CFrame.Angles(0, 0, math.rad(90)), { 140, 70, 45 }, Enum.Material.Wood, { Shape = Enum.PartType.Cylinder })
			P(m, "SequoiaLeaves", Vector3.new(18, 22, 18), Vector3.new(x, GROUND_TOP + h + 4, zz), { 40, 110, 55 }, Enum.Material.Grass, { Shape = Enum.PartType.Ball })
			block(x, zz, 8)
		end
	end
	-- Montañas en el horizonte
	for i = 1, 10 do
		local a = i / 10 * math.pi * 2
		local s = rng:NextInteger(90, 140)
		local x, z = cx + math.cos(a) * 215, cz + math.sin(a) * 215
		if math.sin(a) < 0.3 and free(x, z, s * 0.35) then
			P(m, "Mountain", Vector3.new(s, s, s), Vector3.new(x, GROUND_TOP - s * 0.15, z), { 100, 120, 90 }, Enum.Material.Rock, { Shape = Enum.PartType.Ball })
		end
	end
	-- Señal de los guardas, rocas y bosque
	local ranger = P(m, "RangerSign", Vector3.new(12, 4, 0.4), Vector3.new(cx + 30, GROUND_TOP + 5, cz + 110), { 90, 60, 35 }, Enum.Material.Wood)
	signBoth(ranger, "Parque Nacional · No dejes huella", Color3.fromRGB(90, 60, 35), Color3.fromRGB(255, 240, 200), Enum.Font.GothamBold)
	for _ = 1, 12 do
		local x, z = cx + rng:NextInteger(-180, 180), cz + rng:NextInteger(-180, 180)
		if free(x, z, 4) then
			P(m, "Rock", Vector3.new(5, 3.5, 4), CFrame.new(x, GROUND_TOP + 1.2, z) * CFrame.Angles(0, rng:NextNumber() * 6, 0), { 130, 125, 115 }, Enum.Material.Rock, { Shape = Enum.PartType.Ball })
			block(x, z, 5)
		end
	end
	for _ = 1, 80 do
		local x, z = cx + rng:NextInteger(-185, 185), cz + rng:NextInteger(-185, 185)
		if free(x, z, 5) then
			if rng:NextNumber() < 0.5 then
				pine(m, x, z, 0.9 + rng:NextNumber() * 0.5, false)
			else
				tree(m, x, z, 0.9 + rng:NextNumber() * 0.5, rng)
			end
			block(x, z, 8)
		end
	end
end

destThemes.fest = function(m, dest, cx, cz, rng, free, block)
	-- Escenario Aurora frente al lugar 🎥
	P(m, "Stage", Vector3.new(60, 4, 26), Vector3.new(cx, GROUND_TOP + 2, cz - 100), { 30, 30, 36 }, Enum.Material.Wood)
	P(m, "StageBack", Vector3.new(64, 32, 2), Vector3.new(cx, GROUND_TOP + 16, cz - 114), { 20, 20, 26 }, Enum.Material.SmoothPlastic)
	local screen = P(m, "StageScreen", Vector3.new(40, 16, 0.6), Vector3.new(cx, GROUND_TOP + 17, cz - 112.6), { 255, 60, 200 }, Enum.Material.Neon, { NoShadow = true })
	signBoth(screen, "FESTIVAL DE CREADORES AURORA", Color3.fromRGB(40, 0, 70), Color3.fromRGB(255, 220, 255))
	for _, sx in ipairs({ -36, 36 }) do
		P(m, "LightTower", Vector3.new(2, 30, 2), Vector3.new(cx + sx, GROUND_TOP + 15, cz - 100), { 60, 60, 66 }, Enum.Material.Metal)
		local lamp = P(m, "StageLight", Vector3.new(4, 3, 4), Vector3.new(cx + sx, GROUND_TOP + 31, cz - 100), { 255, 240, 200 }, Enum.Material.Neon, { NoShadow = true })
		nightLight(lamp, 60, Color3.fromRGB(255, 120, 220))
		P(m, "Speaker", Vector3.new(5, 10, 4), Vector3.new(cx + sx * 0.75, GROUND_TOP + 9, cz - 90), { 25, 25, 28 }, Enum.Material.SmoothPlastic)
	end
	block(cx, cz - 100, 44)
	-- Zona de firmas: mesas, vallas y cartel
	for k = 0, 2 do
		local x, z = cx - 115, cz + 5 + k * 22
		P(m, "SigningTable", Vector3.new(4, 3, 12), Vector3.new(x, GROUND_TOP + 1.5, z), { 245, 245, 245 }, Enum.Material.Fabric)
		P(m, "QueueFence", Vector3.new(0.4, 2.4, 16), Vector3.new(x + 10, GROUND_TOP + 1.2, z), { 200, 40, 120 }, Enum.Material.Metal)
		block(x, z, 9)
	end
	local fb = P(m, "SigningBanner", Vector3.new(20, 5, 0.4), Vector3.new(cx - 115, GROUND_TOP + 10, cz - 15), { 140, 60, 220 }, Enum.Material.Fabric)
	signBoth(fb, "✍ ZONA DE FIRMAS", Color3.fromRGB(140, 60, 220), Color3.new(1, 1, 1))
	-- Calle de food trucks
	local truckColors = { { 255, 200, 40 }, { 60, 200, 220 }, { 255, 90, 90 }, { 120, 220, 120 } }
	local foods = { "Tacos Aurora", "Burger Live", "Crepes Stream", "Ramen Viral" }
	for k, tz in ipairs({ -15, 20, 55, 90 }) do
		local x, z = cx + 122, cz + tz
		if free(x, z, 8) then
			P(m, "FoodTruck", Vector3.new(8, 8, 16), Vector3.new(x, GROUND_TOP + 5, z), truckColors[k], Enum.Material.SmoothPlastic)
			local win = P(m, "TruckWindow", Vector3.new(0.3, 3, 8), Vector3.new(x - 4.1, GROUND_TOP + 6, z), { 255, 230, 160 }, Enum.Material.Neon, { NoShadow = true })
			signBoth(win, foods[k], Color3.fromRGB(40, 20, 10), Color3.fromRGB(255, 230, 160))
			for _, w in ipairs({ { -4, 5 }, { 4, 5 }, { -4, -5 }, { 4, -5 } }) do
				P(m, "Wheel", Vector3.new(1.2, 2.4, 2.4), Vector3.new(x + w[1], GROUND_TOP + 1.2, z + w[2]), { 20, 20, 20 }, Enum.Material.SmoothPlastic, { Shape = Enum.PartType.Cylinder })
			end
			block(x, z, 12)
		end
	end
	-- Carpas de patrocinadores y guirnaldas de luces
	local placed = 0
	for _ = 1, 40 do
		if placed >= 8 then
			break
		end
		local x, z = cx + rng:NextInteger(-180, 180), cz + rng:NextInteger(-180, 180)
		if free(x, z, 8) then
			local c = ({ { 255, 80, 160 }, { 80, 160, 255 }, { 255, 200, 60 }, { 140, 80, 255 } })[rng:NextInteger(1, 4)]
			P(m, "Tent", Vector3.new(12, 6, 6), CFrame.new(x, GROUND_TOP + 3, z + 3), c, Enum.Material.Fabric, { Class = "WedgePart" })
			P(m, "Tent", Vector3.new(12, 6, 6), CFrame.new(x, GROUND_TOP + 3, z - 3) * CFrame.Angles(0, math.pi, 0), c, Enum.Material.Fabric, { Class = "WedgePart" })
			block(x, z, 12)
			placed = placed + 1
		end
	end
	local poles = {}
	for k = -3, 3 do
		local p = Vector3.new(cx + k * 24, GROUND_TOP + 12, cz - 30)
		P(m, "LightPole", Vector3.new(0.5, 12, 0.5), Vector3.new(p.X, GROUND_TOP + 6, p.Z), { 60, 60, 66 }, Enum.Material.Metal)
		poles[#poles + 1] = p
	end
	for k = 2, #poles do
		cable(m, poles[k - 1], poles[k], 0.4, { 255, 220, 120 }, Enum.Material.Neon)
	end
end

local function buildDestination(dest)
	local cx, cz = dest.Center[1], dest.Center[2]
	local rng = Random.new(Util.hashString(dest.Id))
	local m = model(city, "Destino " .. dest.Name)
	m:SetAttribute("Destination", dest.Id)
	local half = LifeData.DestHalf - 20
	local L = LifeData.DestLayout
	-- Suelo con su material, borde visible y muros invisibles en el límite
	P(m, "DestGround", Vector3.new(half * 2, 2, half * 2), Vector3.new(cx, GROUND_TOP - 0.9, cz), dest.Ground, Enum.Material[dest.Material] or Enum.Material.Grass)
	local edgeColor = { math.floor(dest.Ground[1] * 0.75), math.floor(dest.Ground[2] * 0.75), math.floor(dest.Ground[3] * 0.75) }
	for _, e in ipairs({ { 0, -half, half * 2 + 2, 2 }, { 0, half, half * 2 + 2, 2 }, { -half, 0, 2, half * 2 + 2 }, { half, 0, 2, half * 2 + 2 } }) do
		P(m, "DestEdge", Vector3.new(e[3], 2, e[4]), Vector3.new(cx + e[1], GROUND_TOP + 1, cz + e[2]), edgeColor, Enum.Material.Rock)
		local wall = P(m, "DestBarrier", Vector3.new(e[3], 80, e[4]), Vector3.new(cx + e[1], GROUND_TOP + 40, cz + e[2]), { 255, 255, 255 }, Enum.Material.SmoothPlastic, { Transparency = 1, NoShadow = true })
		wall.CanQuery = false
	end
	-- Zonas reservadas (lugares, edificios y llegada) para no poner decoración encima
	local keep = {}
	local function block(x, z, r)
		keep[#keep + 1] = { x, z, r }
	end
	local function free(x, z, r)
		for _, k in ipairs(keep) do
			if (x - k[1]) ^ 2 + (z - k[2]) ^ 2 < (k[3] + (r or 0)) ^ 2 then
				return false
			end
		end
		return true
	end
	for _, s in ipairs(dest.Spots) do
		block(cx + s[2], cz + s[3], 22)
	end
	local shopX, shopZ = cx + L.Shop[1], cz + L.Shop[2]
	local hotelX, hotelZ = cx + L.Hotel[1], cz + L.Hotel[2]
	local gateX, gateZ = cx + L.Gate[1], cz + L.Gate[2]
	local arrX, arrZ = cx + L.Arrival[1], cz + L.Arrival[2]
	block(shopX, shopZ, 28)
	block(hotelX + 12, hotelZ, 36)
	block(gateX, gateZ, 30)
	block(arrX, arrZ, 22)
	block(cx + 60, gateZ + 24, 26)

	-- Arco de bienvenida
	for _, sx in ipairs({ -10, 10 }) do
		P(m, "ArchPillar", Vector3.new(2, 14, 2), Vector3.new(arrX + sx, GROUND_TOP + 7, arrZ - 14), { 240, 240, 245 }, Enum.Material.Marble)
	end
	local arch = P(m, "ArchSign", Vector3.new(24, 4, 0.6), Vector3.new(arrX, GROUND_TOP + 15, arrZ - 14), { 20, 30, 50 })
	signBoth(arch, "Bienvenido a " .. dest.Name, Color3.fromRGB(20, 30, 50), Color3.fromRGB(255, 214, 120))

	-- Puerta de embarque (vuelo de vuelta), pista y avión
	local gcf = CFrame.new(gateX, GROUND_TOP, gateZ)
	P(m, "GateFloor", Vector3.new(36, 0.6, 18), gcf * CFrame.new(0, 0.3, 0), { 220, 222, 228 }, Enum.Material.Concrete)
	for _, sx in ipairs({ -1, 1 }) do
		for _, sz in ipairs({ -1, 1 }) do
			P(m, "GateColumn", Vector3.new(1.2, 10, 1.2), gcf * CFrame.new(sx * 17, 5, sz * 8), { 200, 205, 215 }, Enum.Material.Metal)
		end
	end
	P(m, "GateRoof", Vector3.new(38, 1, 20), gcf * CFrame.new(0, 10.5, 0), { 40, 90, 160 }, Enum.Material.Metal)
	local gsign = P(m, "GateSign", Vector3.new(20, 3, 0.4), gcf * CFrame.new(0, 12.6, -9), { 20, 40, 80 })
	signBoth(gsign, "🛫 Puerta de embarque · Vuelo a la ciudad", Color3.fromRGB(20, 40, 80), Color3.new(1, 1, 1))
	local desk = P(m, "GateDesk", Vector3.new(10, 3.6, 2.5), gcf * CFrame.new(0, 1.8, 2), { 60, 70, 90 }, Enum.Material.Metal)
	prompt(desk, "dest_return", "Volar de vuelta", "Vuelo a la ciudad (incluido)")
	table.insert(World.NpcPoints, { Pos = (gcf * CFrame.new(0, 0, 5)).Position, Look = (gcf * CFrame.new(0, 0, -4)).Position, Name = "Auxiliar de vuelo", Role = "travel" })
	P(m, "Airstrip", Vector3.new(320, 0.3, 18), Vector3.new(cx, GROUND_TOP + 0.15, gateZ + 24), { 50, 50, 55 }, Enum.Material.Asphalt)
	local plane = model(m, "Plane")
	P(plane, "Fuselage", Vector3.new(30, 5, 5), Vector3.new(cx + 60, GROUND_TOP + 4, gateZ + 24), { 245, 245, 250 }, Enum.Material.SmoothPlastic, { Shape = Enum.PartType.Cylinder })
	P(plane, "Wings", Vector3.new(7, 0.8, 30), Vector3.new(cx + 58, GROUND_TOP + 3.5, gateZ + 24), { 220, 220, 230 }, Enum.Material.SmoothPlastic)
	P(plane, "Tail", Vector3.new(4, 6, 0.6), Vector3.new(cx + 73, GROUND_TOP + 8, gateZ + 24), { 255, 60, 80 }, Enum.Material.SmoothPlastic)

	-- Tienda exclusiva (abierta hacia el centro)
	local scf = CFrame.new(shopX, GROUND_TOP, shopZ) * CFrame.Angles(0, math.pi / 2, 0)
	destBooth(m, scf, 34, 24, 14, { 245, 240, 230 }, { 190, 170, 140 })
	local sboard = P(m, "ShopSign", Vector3.new(28, 2.6, 0.4), scf * CFrame.new(0, 12.4, 12.4), { 20, 20, 24 })
	signBoth(sboard, "🛍 " .. dest.ShopName .. " · exclusivos", Color3.fromRGB(255, 40, 70), Color3.new(1, 1, 1))
	local scounter = P(m, "ShopCounter", Vector3.new(14, 4, 3), scf * CFrame.new(0, 2, -6), { 40, 40, 48 }, Enum.Material.Wood)
	prompt(scounter, "dest_shop", "Ver tienda exclusiva", dest.ShopName)
	table.insert(World.NpcPoints, { Pos = (scf * CFrame.new(0, 0, -9.5)).Position, Look = (scf * CFrame.new(0, 0, 0)).Position, Name = "Dependiente de " .. dest.ShopName, Role = "dest_shop" })
	for i, id in ipairs(dest.Shop) do
		local def = Catalog.get(id)
		if def then
			local px = -11 + (i - 1) * 11
			local pedestal = P(m, "Pedestal", Vector3.new(4, 3, 4), scf * CFrame.new(px, 1.5, 4), { 250, 250, 252 }, Enum.Material.Marble)
			displayModel(m, def, scf * CFrame.new(px, 3, 4))
			local tag = P(m, "PriceTag", Vector3.new(4, 1, 0.2), scf * CFrame.new(px, 2.2, 6.2), { 255, 214, 0 })
			signBoth(tag, "$" .. Util.formatInt(def.Price), nil, Color3.fromRGB(20, 20, 24))
			prompt(pedestal, "dest_shop", "Ver exclusivo", def.Name)
		end
	end

	-- Hotel: vestíbulo abierto hacia el centro y torre de habitaciones detrás
	local hcf = CFrame.new(hotelX, GROUND_TOP, hotelZ) * CFrame.Angles(0, -math.pi / 2, 0)
	destBooth(m, hcf, 30, 20, 12, { 250, 235, 215 }, { 160, 120, 90 })
	local tower = hcf * CFrame.new(0, 20, -20)
	P(m, "HotelTower", Vector3.new(34, 40, 18), tower, { 235, 225, 205 }, Enum.Material.Concrete)
	windowBands(m, tower, 34, 40, 18, rng)
	local hboard = P(m, "HotelSign", Vector3.new(24, 4, 0.5), hcf * CFrame.new(0, 15, -9), { 30, 30, 40 })
	signBoth(hboard, "🏨 " .. dest.Hotel.Name, Color3.fromRGB(30, 30, 40), Color3.fromRGB(255, 214, 120))
	local reception = P(m, "Reception", Vector3.new(12, 4, 3), hcf * CFrame.new(0, 2, -4), { 120, 80, 50 }, Enum.Material.Wood)
	prompt(reception, "dest_hotel", "Dormir aquí ($" .. dest.Hotel.Price .. ")", dest.Hotel.Name)
	table.insert(World.NpcPoints, { Pos = (hcf * CFrame.new(0, 0, -7.5)).Position, Look = (hcf * CFrame.new(0, 0, 0)).Position, Name = "Recepcionista del " .. dest.Hotel.Name, Role = "hotel" })
	for _, sx in ipairs({ -9, 9 }) do
		P(m, "LobbySofa", Vector3.new(6, 2, 3), hcf * CFrame.new(sx, 1.6, 4), { 180, 60, 60 }, Enum.Material.Fabric)
	end

	-- Lugares de grabación con banco
	for _, s in ipairs(dest.Spots) do
		recordMarker(m, cx + s[2], cz + s[3], s[1])
		bench(m, cx + s[2] + 10, cz + s[3] + 10, rng:NextNumber() * 6)
	end
	-- Decoración temática
	local theme = destThemes[dest.Theme or dest.Id]
	if theme then
		theme(m, dest, cx, cz, rng, free, block)
	end
	-- Farolas y un vecino del lugar
	for _, p in ipairs({ { -40, 120 }, { 40, 120 }, { -40, 150 }, { 40, 150 } }) do
		streetLamp(m, cx + p[1], cz + p[2])
	end
	local s1 = dest.Spots[1]
	table.insert(World.NpcPoints, { Pos = Vector3.new(cx + s1[2] - 8, GROUND_TOP, cz + s1[3] - 6), Look = Vector3.new(cx + s1[2], GROUND_TOP, cz + s1[3]), Name = "Turista en " .. dest.Name, Role = "citizen" })
end

local function buildDestinations()
	for _, dest in ipairs(LifeData.Destinations) do
		buildDestination(dest)
	end
end

---------------------------------------------------------------------------
-- Distritos
---------------------------------------------------------------------------
---------------------------------------------------------------------------
-- Complejo de Estudios Prisma: vestíbulo con recepción en el Distrito de estudios y 6 platós
-- especializados en la zona de interiores (z ≈ -4200), cada uno con su decoración y puerta de salida.
---------------------------------------------------------------------------
World.StudioSets = {}

local function vcyl(parent, name, height, dia, cf, color, material, opts)
	-- Cilindro vertical (en Roblox el cilindro va a lo largo del eje X)
	local o = opts or {}
	o.Shape = Enum.PartType.Cylinder
	return P(parent, name, Vector3.new(height, dia, dia), cf * CFrame.Angles(0, 0, math.rad(90)), color, material, o)
end

local function lightStand(parent, cf, color, boxColor)
	P(parent, "StandPole", Vector3.new(0.3, 7, 0.3), cf * CFrame.new(0, 3.5, 0), { 30, 30, 34 }, Enum.Material.Metal)
	P(parent, "StandFoot", Vector3.new(3, 0.3, 3), cf * CFrame.new(0, 0.15, 0), { 30, 30, 34 }, Enum.Material.Metal)
	local box = P(parent, "Softbox", Vector3.new(3.4, 2.6, 1.2), cf * CFrame.new(0, 7.4, 0), boxColor or { 245, 245, 245 }, Enum.Material.Neon, { NoShadow = true })
	nightLight(box, 18, color and rgb(color) or Color3.fromRGB(255, 250, 235))
	return box
end

local function buildStudioComplex(parent, sp)
	local m = model(parent, "EstudiosPrisma")
	local w, d, h = 60, 44, 18
	local base = shell(m, sp.WX, sp.WZ, w, d, h, { 40, 40, 48 }, { 70, 70, 80 })
	local board = P(m, "PrismaSign", Vector3.new(34, 4, 0.6), base * CFrame.new(0, h - 3, d / 2 + 1.2), { 20, 20, 24 })
	signBoth(board, "🎛 " .. sp.Name, Color3.fromRGB(30, 20, 50), Color3.new(1, 1, 1))
	-- Franja de neón con los colores del prisma
	local colors = { { 255, 60, 60 }, { 255, 170, 40 }, { 255, 230, 60 }, { 60, 220, 120 }, { 60, 160, 255 }, { 170, 90, 255 } }
	for i, c in ipairs(colors) do
		local strip = P(m, "PrismaStrip", Vector3.new(w / 6, 0.6, 0.4), base * CFrame.new(-w / 2 + (i - 0.5) * w / 6, h - 0.6, d / 2 + 0.8), c, Enum.Material.Neon, { NoShadow = true })
		if i == 4 then
			nightLight(strip, 30, rgb(c))
		end
	end
	-- Recepción: aviso que abre la app Estudios
	local desk = P(m, "ReceptionDesk", Vector3.new(16, 4, 3), base * CFrame.new(0, 2, -d / 2 + 9), { 230, 230, 236 }, Enum.Material.Marble)
	P(m, "DeskTop", Vector3.new(16.4, 0.4, 3.4), base * CFrame.new(0, 4.2, -d / 2 + 9), { 30, 30, 36 }, Enum.Material.Glass)
	local ds = P(m, "DeskSign", Vector3.new(12, 1.4, 0.2), base * CFrame.new(0, 3, -d / 2 + 10.6), { 30, 20, 50 })
	signBoth(ds, "RECEPCIÓN · ALQUILER DE PLATÓS", Color3.fromRGB(30, 20, 50), Color3.new(1, 1, 1))
	prompt(desk, "studio_desk", "Alquilar plató", sp.Name)
	table.insert(World.NpcPoints, { Pos = (base * CFrame.new(0, 0, -d / 2 + 6)).Position, Look = (base * CFrame.new(0, 0, 0)).Position, Name = "Recepcionista de Prisma", Role = "studio" })
	-- Pantalla con los platós y precios
	local lines = {}
	for _, set in ipairs(StudioData.Sets) do
		lines[#lines + 1] = set.Icon .. " " .. set.Name .. "  $" .. set.Price .. "/h"
	end
	local board2 = P(m, "SetsBoard", Vector3.new(22, 8, 0.4), base * CFrame.new(0, 10, -d / 2 + 1), { 10, 10, 20 }, Enum.Material.Neon, { NoShadow = true })
	signBoth(board2, table.concat(lines, "\n"), Color3.fromRGB(10, 10, 20), Color3.fromRGB(120, 220, 255), Enum.Font.Code)
	-- Puertas de los platós (3 por lado) con su cartel y luz de «grabando»
	for i, set in ipairs(StudioData.Sets) do
		local sx = i <= 3 and -1 or 1
		local z = -10 + ((i - 1) % 3) * 10
		local doorCF = base * CFrame.new(sx * (w / 2 - 0.8), 0, z)
		P(m, "SetDoor", Vector3.new(0.4, 9, 5), doorCF * CFrame.new(0, 4.5, 0), { 50, 50, 60 }, Enum.Material.Metal)
		local plate = P(m, "SetDoorSign", Vector3.new(0.3, 1.4, 6), doorCF * CFrame.new(-sx * 0.3, 10, 0), { 30, 20, 50 })
		sign(plate, sx < 0 and Enum.NormalId.Right or Enum.NormalId.Left, set.Icon .. " " .. set.Name, Color3.fromRGB(30, 20, 50), Color3.new(1, 1, 1))
		P(m, "OnAirLamp", Vector3.new(0.4, 0.8, 1.6), doorCF * CFrame.new(-sx * 0.3, 11.5, 0), { 255, 40, 40 }, Enum.Material.Neon, { NoShadow = true })
	end
	-- Zona de espera
	for _, sx in ipairs({ -1, 1 }) do
		P(m, "LobbySofa", Vector3.new(8, 1.6, 3), base * CFrame.new(sx * 14, 1.2, 10), { 120, 60, 200 }, Enum.Material.Fabric)
		P(m, "LobbySofaBack", Vector3.new(8, 2.4, 0.8), base * CFrame.new(sx * 14, 2.6, 11.4), { 120, 60, 200 }, Enum.Material.Fabric)
		P(m, "LobbyPlant", Vector3.new(1.6, 4, 1.6), base * CFrame.new(sx * 22, 2.4, 14), { 60, 150, 70 }, Enum.Material.Grass)
	end
end

-- Decoración propia de cada plató
local studioDecor = {}

studioDecor.gaming = function(m, base, W, D, H)
	local screenColors = { { 255, 60, 180 }, { 60, 140, 255 }, { 60, 230, 140 } }
	for i, x in ipairs({ -18, 0, 18 }) do
		P(m, "GameScreenFrame", Vector3.new(15, 9, 0.4), base * CFrame.new(x, 8, -D / 2 + 1), { 15, 15, 18 }, Enum.Material.Metal)
		local scr = P(m, "GameScreen", Vector3.new(14, 8, 0.2), base * CFrame.new(x, 8, -D / 2 + 1.3), screenColors[i], Enum.Material.Neon, { NoShadow = true })
		nightLight(scr, 20, rgb(screenColors[i]))
	end
	P(m, "GamingDesk", Vector3.new(34, 0.6, 4), base * CFrame.new(0, 3.2, -D / 2 + 8), { 20, 20, 24 }, Enum.Material.Metal)
	for i, x in ipairs({ -11, 0, 11 }) do
		P(m, "DeskMonitor", Vector3.new(4, 2.4, 0.3), base * CFrame.new(x, 5, -D / 2 + 6.6), { 15, 15, 18 })
		P(m, "DeskScreen", Vector3.new(3.7, 2.1, 0.05), base * CFrame.new(x, 5, -D / 2 + 6.8), screenColors[i], Enum.Material.Neon, { NoShadow = true })
		P(m, "Keyboard", Vector3.new(3, 0.2, 1), base * CFrame.new(x, 3.6, -D / 2 + 8.4), { 30, 30, 34 })
		P(m, "KeyboardRGB", Vector3.new(3, 0.05, 1), base * CFrame.new(x, 3.72, -D / 2 + 8.4), screenColors[i], Enum.Material.Neon, { NoShadow = true })
		-- Silla gaming RGB
		local chair = base * CFrame.new(x, 0, -D / 2 + 12)
		P(m, "RGBChairSeat", Vector3.new(3, 0.8, 3), chair * CFrame.new(0, 2.2, 0), { 20, 20, 24 }, Enum.Material.Fabric)
		P(m, "RGBChairBack", Vector3.new(3, 4.5, 0.6), chair * CFrame.new(0, 4.6, 1.3), { 20, 20, 24 }, Enum.Material.Fabric)
		P(m, "RGBChairStripe", Vector3.new(0.5, 4.3, 0.1), chair * CFrame.new(0, 4.6, 0.95), screenColors[i], Enum.Material.Neon, { NoShadow = true })
		P(m, "RGBChairBase", Vector3.new(0.5, 1.8, 0.5), chair * CFrame.new(0, 0.9, 0), { 60, 60, 66 }, Enum.Material.Metal)
	end
	for _, side in ipairs({ -1, 1 }) do
		P(m, "LedStrip", Vector3.new(0.3, 0.3, D - 2), base * CFrame.new(side * (W / 2 - 1), 0.3, 0), { 200, 0, 255 }, Enum.Material.Neon, { NoShadow = true })
		P(m, "LedStripTop", Vector3.new(0.3, 0.3, D - 2), base * CFrame.new(side * (W / 2 - 1), H - 1, 0), { 0, 220, 255 }, Enum.Material.Neon, { NoShadow = true })
	end
	P(m, "GamerSofa", Vector3.new(10, 1.8, 3.5), base * CFrame.new(-14, 1.2, 8), { 60, 30, 90 }, Enum.Material.Fabric)
	P(m, "ConsoleTable", Vector3.new(6, 1.6, 2.5), base * CFrame.new(-14, 0.8, 3), { 20, 20, 24 }, Enum.Material.Wood)
	P(m, "Console", Vector3.new(1.6, 0.5, 1.2), base * CFrame.new(-14, 1.85, 3), { 240, 240, 245 })
end

studioDecor.music = function(m, base, W, D, H)
	-- Cabina insonorizada con cristal y micrófono
	local booth = base * CFrame.new(-W / 2 + 9, 0, -D / 2 + 8)
	P(m, "BoothFloor", Vector3.new(14, 0.4, 12), booth * CFrame.new(0, 0.2, 0), { 60, 50, 50 }, Enum.Material.Carpet)
	P(m, "BoothGlass", Vector3.new(14, 10, 0.4), booth * CFrame.new(0, 5, 6), { 180, 210, 230 }, Enum.Material.Glass, { Transparency = 0.5 })
	P(m, "BoothGlass", Vector3.new(0.4, 10, 12), booth * CFrame.new(7, 5, 0), { 180, 210, 230 }, Enum.Material.Glass, { Transparency = 0.5 })
	P(m, "BoothRoof", Vector3.new(14, 0.4, 12), booth * CFrame.new(0, 10.2, 0), { 40, 40, 44 }, Enum.Material.Metal)
	vcyl(m, "BoothMicStand", 5, 0.25, booth * CFrame.new(0, 2.7, 0), { 30, 30, 34 }, Enum.Material.Metal)
	P(m, "BoothMic", Vector3.new(0.5, 1, 0.5), booth * CFrame.new(0, 5.5, 0), { 200, 200, 210 }, Enum.Material.Metal)
	vcyl(m, "PopFilter", 0.1, 1.2, booth * CFrame.new(0, 5.5, 0.8) * CFrame.Angles(math.rad(90), 0, 0), { 20, 20, 24 }, Enum.Material.Fabric, { Transparency = 0.3 })
	local onAir = P(m, "RecLamp", Vector3.new(3, 1, 0.2), booth * CFrame.new(0, 11.3, 6), { 255, 40, 40 }, Enum.Material.Neon, { NoShadow = true })
	signBoth(onAir, "REC", Color3.fromRGB(200, 20, 20), Color3.new(1, 1, 1))
	-- Paneles acústicos en las paredes
	for i = 0, 5 do
		for j = 0, 1 do
			P(m, "AcousticFoam", Vector3.new(3.4, 3.4, 0.6), base * CFrame.new(-W / 2 + 22 + i * 6, 6 + j * 5, -D / 2 + 0.9), (i + j) % 2 == 0 and { 50, 50, 56 } or { 120, 40, 40 }, Enum.Material.Fabric)
		end
	end
	-- Batería
	local drums = base * CFrame.new(10, 0, -4)
	vcyl(m, "BassDrum", 2.4, 3.6, drums * CFrame.new(0, 1.8, 0) * CFrame.Angles(math.rad(90), 0, 0), { 200, 30, 40 }, Enum.Material.SmoothPlastic)
	vcyl(m, "Snare", 1, 2, drums * CFrame.new(-2.4, 2.8, 1.6), { 230, 230, 235 }, Enum.Material.Metal)
	vcyl(m, "Tom", 1, 1.6, drums * CFrame.new(-0.8, 4.1, -0.4), { 200, 30, 40 }, Enum.Material.SmoothPlastic)
	vcyl(m, "Tom", 1, 1.6, drums * CFrame.new(0.9, 4.1, -0.4), { 200, 30, 40 }, Enum.Material.SmoothPlastic)
	for _, sx in ipairs({ -3, 3 }) do
		vcyl(m, "CymbalStand", 5, 0.2, drums * CFrame.new(sx, 2.5, -1), { 40, 40, 44 }, Enum.Material.Metal)
		vcyl(m, "Cymbal", 0.1, 2.6, drums * CFrame.new(sx, 5.1, -1), { 230, 190, 70 }, Enum.Material.Metal)
	end
	P(m, "DrumStool", Vector3.new(1.6, 2, 1.6), drums * CFrame.new(0, 1, 3), { 30, 30, 34 }, Enum.Material.Fabric)
	-- Teclado y guitarras
	local keys = base * CFrame.new(-6, 0, 4)
	P(m, "KeyboardStand", Vector3.new(6, 3, 0.4), keys * CFrame.new(0, 1.5, 0), { 30, 30, 34 }, Enum.Material.Metal)
	P(m, "SynthBody", Vector3.new(6.4, 0.5, 2), keys * CFrame.new(0, 3.25, 0), { 20, 20, 24 })
	P(m, "SynthKeys", Vector3.new(6, 0.1, 1.2), keys * CFrame.new(0, 3.55, 0.3), { 250, 250, 250 })
	for i = 0, 8 do
		P(m, "SynthBlackKey", Vector3.new(0.25, 0.12, 0.7), keys * CFrame.new(-2.6 + i * 0.65, 3.62, 0.05), { 10, 10, 12 }, Enum.Material.SmoothPlastic, { NoShadow = true })
	end
	for i, c in ipairs({ { 230, 120, 40 }, { 40, 120, 220 } }) do
		local gx = W / 2 - 4 - (i - 1) * 4
		P(m, "GuitarStand", Vector3.new(1.4, 0.4, 1.4), base * CFrame.new(gx, 0.2, 6), { 30, 30, 34 }, Enum.Material.Metal)
		P(m, "GuitarBody", Vector3.new(2.2, 2.6, 0.5), base * CFrame.new(gx, 2, 6), c, Enum.Material.Wood)
		P(m, "GuitarNeck", Vector3.new(0.35, 3.2, 0.25), base * CFrame.new(gx, 4.8, 6), { 90, 60, 40 }, Enum.Material.Wood)
	end
	P(m, "MixingDesk", Vector3.new(8, 3, 3), base * CFrame.new(-6, 1.5, -D / 2 + 18), { 40, 40, 46 }, Enum.Material.Metal)
	P(m, "MixerFaders", Vector3.new(7.4, 0.1, 2.4), base * CFrame.new(-6, 3.05, -D / 2 + 18), { 80, 200, 255 }, Enum.Material.Neon, { NoShadow = true })
end

studioDecor.kitchen = function(m, base, W, D, H)
	P(m, "BackCounter", Vector3.new(36, 3.6, 3.4), base * CFrame.new(0, 1.8, -D / 2 + 2.4), { 240, 240, 240 }, Enum.Material.Marble)
	for i = 0, 3 do
		vcyl(m, "Burner", 0.15, 1.6, base * CFrame.new(-6 + (i % 2) * 2.6, 3.7, -D / 2 + 1.6 + math.floor(i / 2) * 1.8), { 20, 20, 24 }, Enum.Material.Metal)
	end
	P(m, "Hood", Vector3.new(8, 2.4, 4), base * CFrame.new(-4.7, 9.5, -D / 2 + 2.6), { 190, 195, 205 }, Enum.Material.Metal)
	P(m, "HoodPipe", Vector3.new(2, 6, 2), base * CFrame.new(-4.7, 13.7, -D / 2 + 2), { 190, 195, 205 }, Enum.Material.Metal)
	P(m, "Fridge", Vector3.new(5, 10, 4), base * CFrame.new(W / 2 - 4, 5, -D / 2 + 3), { 210, 215, 225 }, Enum.Material.Metal)
	P(m, "Oven", Vector3.new(4, 3.4, 0.2), base * CFrame.new(-4.7, 1.8, -D / 2 + 4.2), { 20, 20, 24 }, Enum.Material.Glass)
	P(m, "Sink", Vector3.new(4, 0.3, 2), base * CFrame.new(8, 3.7, -D / 2 + 2.4), { 180, 185, 195 }, Enum.Material.Metal)
	-- Isla central con tabla, sartenes y platos
	P(m, "Island", Vector3.new(16, 3.6, 6), base * CFrame.new(0, 1.8, -2), { 245, 245, 245 }, Enum.Material.Marble)
	P(m, "CuttingBoard", Vector3.new(3, 0.2, 2), base * CFrame.new(-4, 3.7, -2), { 190, 140, 90 }, Enum.Material.Wood)
	vcyl(m, "Pan", 0.4, 2.2, base * CFrame.new(1, 3.8, -2), { 30, 30, 34 }, Enum.Material.Metal)
	vcyl(m, "Pot", 1.4, 1.8, base * CFrame.new(4.5, 4.3, -2.5), { 200, 200, 210 }, Enum.Material.Metal)
	for i = 0, 2 do
		vcyl(m, "Plate", 0.15, 1.5, base * CFrame.new(-6 + i * 1.8, 3.7, 0), { 250, 250, 250 }, Enum.Material.SmoothPlastic)
		P(m, "Veggie", Vector3.new(0.7, 0.7, 0.7), base * CFrame.new(-6 + i * 1.8, 4.1, 0), ({ { 230, 60, 40 }, { 90, 180, 60 }, { 250, 200, 40 } })[i + 1], Enum.Material.SmoothPlastic, { Shape = Enum.PartType.Ball })
	end
	for _, x in ipairs({ -5, 5 }) do
		P(m, "PendantCord", Vector3.new(0.1, 6, 0.1), base * CFrame.new(x, H - 3, -2), { 20, 20, 24 }, Enum.Material.Metal)
		local lamp = P(m, "PendantLamp", Vector3.new(2, 1, 2), base * CFrame.new(x, H - 6.5, -2), { 255, 230, 160 }, Enum.Material.Neon, { NoShadow = true })
		nightLight(lamp, 16, Color3.fromRGB(255, 230, 170))
	end
	for i = 0, 2 do
		P(m, "Stool", Vector3.new(1.6, 3, 1.6), base * CFrame.new(-5 + i * 5, 1.5, 3), { 40, 40, 44 }, Enum.Material.Metal)
	end
end

studioDecor.podcast = function(m, base, W, D, H)
	vcyl(m, "Rug", 0.1, 18, base * CFrame.new(0, 0.05, -4), { 120, 60, 50 }, Enum.Material.Fabric)
	vcyl(m, "RoundTable", 0.5, 10, base * CFrame.new(0, 3.2, -4), { 60, 45, 35 }, Enum.Material.Wood)
	vcyl(m, "TableLeg", 3, 1.2, base * CFrame.new(0, 1.5, -4), { 30, 30, 34 }, Enum.Material.Metal)
	for i = 0, 3 do
		local a = math.rad(45 + i * 90)
		local cx, cz = math.cos(a), math.sin(a)
		P(m, "PodChair", Vector3.new(2.6, 1, 2.6), base * CFrame.new(cx * 7, 2, -4 + cz * 7), { 30, 30, 34 }, Enum.Material.Fabric)
		P(m, "PodChairBack", Vector3.new(2.6, 3, 0.5), base * CFrame.new(cx * 8.3, 3.8, -4 + cz * 8.3) * CFrame.Angles(0, -a + math.rad(90), 0), { 30, 30, 34 }, Enum.Material.Fabric)
		-- Micrófono de brazo
		P(m, "MicArm", Vector3.new(0.2, 0.2, 3), base * CFrame.new(cx * 3.2, 4.6, -4 + cz * 3.2) * CFrame.Angles(0, -a + math.rad(90), 0), { 20, 20, 24 }, Enum.Material.Metal)
		P(m, "PodMic", Vector3.new(0.6, 1.2, 0.6), base * CFrame.new(cx * 4.4, 4.4, -4 + cz * 4.4), { 50, 50, 56 }, Enum.Material.Metal)
		P(m, "Headphones", Vector3.new(1.2, 0.4, 1), base * CFrame.new(cx * 3.6, 3.65, -4 + cz * 3.6), { 220, 60, 60 }, Enum.Material.SmoothPlastic)
	end
	local onAir = P(m, "OnAirSign", Vector3.new(10, 2.6, 0.3), base * CFrame.new(0, 12, -D / 2 + 1), { 200, 20, 30 }, Enum.Material.Neon, { NoShadow = true })
	signBoth(onAir, "ON AIR", Color3.fromRGB(200, 20, 30), Color3.new(1, 1, 1))
	nightLight(onAir, 20, Color3.fromRGB(255, 60, 60))
	for i = 0, 3 do
		P(m, "AcousticPanel", Vector3.new(4, 6, 0.5), base * CFrame.new(-18 + i * 12, 7, -D / 2 + 0.9), i % 2 == 0 and { 90, 60, 110 } or { 50, 90, 110 }, Enum.Material.Fabric)
	end
	P(m, "Bookshelf", Vector3.new(10, 8, 2), base * CFrame.new(W / 2 - 7, 4, 6), { 110, 80, 55 }, Enum.Material.WoodPlanks)
	for i = 0, 3 do
		P(m, "Book", Vector3.new(0.6, 1.6, 1.4), base * CFrame.new(W / 2 - 10 + i * 0.8, 6, 5.6), ({ { 200, 60, 60 }, { 60, 120, 200 }, { 230, 190, 60 }, { 60, 170, 90 } })[i + 1], Enum.Material.SmoothPlastic)
	end
	P(m, "Plant", Vector3.new(2, 4, 2), base * CFrame.new(-W / 2 + 4, 2, 6), { 60, 150, 70 }, Enum.Material.Grass)
end

studioDecor.chroma = function(m, base, W, D, H)
	-- Curva de croma entre el suelo y la pared del fondo
	P(m, "ChromaCove", Vector3.new(W - 8, 0.4, 5), base * CFrame.new(0, 1.6, -D / 2 + 2.6) * CFrame.Angles(math.rad(-40), 0, 0), { 40, 200, 70 }, Enum.Material.SmoothPlastic)
	P(m, "ChromaMark", Vector3.new(2, 0.05, 2), base * CFrame.new(0, 0.03, -6), { 255, 255, 255 }, Enum.Material.SmoothPlastic, { NoShadow = true })
	for _, x in ipairs({ -14, 0, 14 }) do
		lightStand(m, base * CFrame.new(x, 0, 4))
	end
	-- Cámara en trípode
	local cam = base * CFrame.new(0, 0, 10)
	for i = 0, 2 do
		local a = math.rad(i * 120)
		P(m, "TripodLeg", Vector3.new(0.2, 5, 0.2), cam * CFrame.new(math.cos(a) * 0.9, 2.4, math.sin(a) * 0.9), { 30, 30, 34 }, Enum.Material.Metal)
	end
	P(m, "StudioCamera", Vector3.new(1.8, 1.6, 3), cam * CFrame.new(0, 5.6, 0), { 25, 25, 30 }, Enum.Material.Metal)
	-- Monitor de composición: muestra el fondo elegido
	P(m, "CompositeMonitorStand", Vector3.new(0.4, 5, 0.4), base * CFrame.new(8, 2.5, 10), { 30, 30, 34 }, Enum.Material.Metal)
	local mon = P(m, "CompositeMonitor", Vector3.new(6, 3.6, 0.3), base * CFrame.new(8, 6.6, 10), { 15, 15, 18 })
	local label = signBoth(mon, "FONDO: elige uno en el panel", Color3.fromRGB(15, 30, 20), Color3.fromRGB(120, 255, 150), Enum.Font.Code)
	return { Monitor = label }
end

studioDecor.photo = function(m, base, W, D, H)
	-- Rollos de papel de fondo con su barrido hasta el suelo
	local papers = { { 245, 245, 245 }, { 30, 30, 34 }, { 255, 170, 190 } }
	P(m, "BackdropBar", Vector3.new(W - 6, 0.5, 0.5), base * CFrame.new(0, H - 2, -D / 2 + 1.5), { 40, 40, 44 }, Enum.Material.Metal)
	for i, c in ipairs(papers) do
		local x = -16 + (i - 1) * 16
		P(m, "PaperRoll", Vector3.new(14, 1.2, 1.2), base * CFrame.new(x, H - 2, -D / 2 + 2), c, Enum.Material.Fabric, { Shape = Enum.PartType.Cylinder })
		P(m, "Paper", Vector3.new(13, H - 3, 0.2), base * CFrame.new(x, (H - 3) / 2, -D / 2 + 2.2), c, Enum.Material.Fabric)
		P(m, "PaperSweep", Vector3.new(13, 0.1, 8), base * CFrame.new(x, 0.05, -D / 2 + 6), c, Enum.Material.Fabric, { NoShadow = true })
	end
	lightStand(m, base * CFrame.new(-10, 0, 2))
	lightStand(m, base * CFrame.new(10, 0, 2))
	-- Paraguas reflectores
	for _, x in ipairs({ -20, 20 }) do
		P(m, "UmbrellaPole", Vector3.new(0.3, 8, 0.3), base * CFrame.new(x, 4, 4), { 30, 30, 34 }, Enum.Material.Metal)
		P(m, "Umbrella", Vector3.new(5, 2.4, 5), base * CFrame.new(x, 8.6, 4), { 250, 250, 250 }, Enum.Material.Fabric, { Shape = Enum.PartType.Ball })
	end
	vcyl(m, "Reflector", 0.1, 4, base * CFrame.new(5, 2.5, -4) * CFrame.Angles(math.rad(90), 0, 0), { 230, 200, 120 }, Enum.Material.Foil)
	P(m, "PhotoStool", Vector3.new(2, 3, 2), base * CFrame.new(0, 1.5, -8), { 30, 30, 34 }, Enum.Material.Wood)
	P(m, "CameraTripod", Vector3.new(0.4, 5, 0.4), base * CFrame.new(0, 2.5, 8), { 30, 30, 34 }, Enum.Material.Metal)
	P(m, "PhotoCamera", Vector3.new(1.6, 1.2, 1.2), base * CFrame.new(0, 5.6, 8), { 20, 20, 24 }, Enum.Material.Metal)
end

local function buildStudioSets()
	local root = folder(city, "EstudiosPrismaPlatos")
	local size = StudioData.SetSize
	local W, D, H = size.W, size.D, size.H
	for _, set in ipairs(StudioData.Sets) do
		local m = model(root, "Plato_" .. set.Id)
		local base = CFrame.new(set.OX, 0, set.OZ)
		P(m, "Floor", Vector3.new(W, 1, D), base * CFrame.new(0, -0.5, 0), set.Floor, set.Id == "music" and Enum.Material.WoodPlanks or Enum.Material.SmoothPlastic)
		P(m, "Ceiling", Vector3.new(W, 1, D), base * CFrame.new(0, H + 0.5, 0), { 30, 30, 34 }, Enum.Material.SmoothPlastic)
		for _, side in ipairs({ { 0, -D / 2, W, 1 }, { 0, D / 2, W, 1 }, { -W / 2, 0, 1, D }, { W / 2, 0, 1, D } }) do
			P(m, "Wall", Vector3.new(side[3], H, side[4]), base * CFrame.new(side[1], H / 2, side[2]), set.Wall, Enum.Material.SmoothPlastic)
		end
		-- Parrilla de focos
		P(m, "LightTruss", Vector3.new(W - 6, 0.5, 0.5), base * CFrame.new(0, H - 1.2, -4), { 40, 40, 44 }, Enum.Material.Metal)
		for _, lx in ipairs({ -W / 4, 0, W / 4 }) do
			local lamp = P(m, "TrussLight", Vector3.new(2.4, 1.6, 2.4), base * CFrame.new(lx, H - 2.4, -4), { 255, 250, 235 }, Enum.Material.Neon, { NoShadow = true })
			local l = Instance.new("PointLight")
			l.Range = 34
			l.Brightness = 1.4
			l.Parent = lamp
		end
		local title = P(m, "SetTitle", Vector3.new(20, 2.6, 0.3), base * CFrame.new(0, H - 4.5, D / 2 - 0.8), { 20, 20, 24 })
		signBoth(title, set.Icon .. " " .. set.Name .. " · " .. StudioData.Name, Color3.fromRGB(20, 20, 24), Color3.new(1, 1, 1))
		-- Puerta de salida (aviso) y panel del plató (abre la app Estudios)
		local door = P(m, "ExitDoor", Vector3.new(6, 9, 0.6), base * CFrame.new(0, 4.5, D / 2 - 0.8), { 90, 60, 40 }, Enum.Material.Wood)
		prompt(door, "studio_exit", "Salir a la recepción", set.Name)
		local exitSign = P(m, "ExitSign", Vector3.new(4, 1, 0.2), base * CFrame.new(0, 9.8, D / 2 - 0.9), { 40, 200, 90 }, Enum.Material.Neon, { NoShadow = true })
		signBoth(exitSign, "SALIDA", Color3.fromRGB(40, 160, 80), Color3.new(1, 1, 1))
		local panel = P(m, "ControlPanel", Vector3.new(3, 4, 1), base * CFrame.new(8, 2, D / 2 - 2), { 30, 30, 36 }, Enum.Material.Metal)
		P(m, "ControlScreen", Vector3.new(2.6, 1.6, 0.1), base * CFrame.new(8, 3.2, D / 2 - 2.55), { 80, 200, 255 }, Enum.Material.Neon, { NoShadow = true })
		prompt(panel, "studio_panel", "Panel del plató", set.Name)
		local extra = studioDecor[set.Id] and studioDecor[set.Id](m, base, W, D, H) or nil
		World.StudioSets[set.Id] = { Model = m, Center = Vector3.new(set.OX, 0, set.OZ), Monitor = extra and extra.Monitor or nil }
	end
end

---------------------------------------------------------------------------
-- Ocio: gimnasio, cine, karaoke y bolera con recreativos (avisos que abren la app Ocio)
---------------------------------------------------------------------------
local function buildGym(parent, sp)
	local m = model(parent, "Gimnasio")
	local w, d, h = 52, 40, 16
	local base = shell(m, sp.WX, sp.WZ, w, d, h, { 235, 235, 240 }, { 60, 60, 66 })
	local board = P(m, "GymSign", Vector3.new(28, 3.5, 0.6), base * CFrame.new(0, h - 2.5, d / 2 + 1.2), { 20, 20, 24 })
	signBoth(board, "🏋 " .. sp.Name, Color3.fromRGB(230, 80, 30), Color3.new(1, 1, 1))
	-- Cintas de correr frente a los espejos
	P(m, "MirrorWall", Vector3.new(w - 6, 8, 0.3), base * CFrame.new(0, 6, -d / 2 + 0.9), { 200, 220, 235 }, Enum.Material.Glass, { Transparency = 0.2 })
	for i = 0, 3 do
		local tm = base * CFrame.new(-15 + i * 6, 0, -d / 2 + 6)
		P(m, "TreadmillBase", Vector3.new(3, 0.8, 6), tm * CFrame.new(0, 0.4, 0), { 40, 40, 44 }, Enum.Material.Metal)
		P(m, "TreadmillBelt", Vector3.new(2.4, 0.1, 5.4), tm * CFrame.new(0, 0.85, 0), { 20, 20, 22 }, Enum.Material.Fabric, { NoShadow = true })
		P(m, "TreadmillPost", Vector3.new(0.3, 4, 0.3), tm * CFrame.new(0, 2.6, -2.8), { 60, 60, 66 }, Enum.Material.Metal)
		P(m, "TreadmillPanel", Vector3.new(2.4, 1, 0.4), tm * CFrame.new(0, 4.6, -2.8), { 230, 80, 30 }, Enum.Material.Neon, { NoShadow = true })
	end
	-- Pesas, banco y saco de boxeo
	P(m, "DumbbellRack", Vector3.new(10, 3, 2), base * CFrame.new(w / 2 - 6, 1.5, -6), { 40, 40, 44 }, Enum.Material.Metal)
	for i = 0, 4 do
		P(m, "Dumbbell", Vector3.new(1.6, 0.6, 0.6), base * CFrame.new(w / 2 - 10 + i * 2, 3.3, -6), { 30, 30, 34 }, Enum.Material.Metal)
	end
	P(m, "BenchPress", Vector3.new(2, 1.6, 6), base * CFrame.new(w / 2 - 8, 0.8, 4), { 200, 40, 40 }, Enum.Material.Fabric)
	P(m, "Barbell", Vector3.new(8, 0.3, 0.3), base * CFrame.new(w / 2 - 8, 4, 2), { 180, 180, 190 }, Enum.Material.Metal)
	for _, sx in ipairs({ -1, 1 }) do
		vcyl(m, "BarbellPlate", 0.5, 2.4, base * CFrame.new(w / 2 - 8 + sx * 3.4, 4, 2) * CFrame.Angles(0, 0, math.rad(90)), { 20, 20, 24 }, Enum.Material.Metal)
	end
	P(m, "BagChain", Vector3.new(0.2, 4, 0.2), base * CFrame.new(-w / 2 + 6, h - 2, 6), { 120, 120, 130 }, Enum.Material.Metal)
	vcyl(m, "PunchingBag", 5, 2.4, base * CFrame.new(-w / 2 + 6, h - 6.5, 6), { 150, 30, 30 }, Enum.Material.Fabric)
	for i = 0, 2 do
		P(m, "YogaMat", Vector3.new(2.4, 0.15, 6), base * CFrame.new(-8 + i * 4, 0.1, 8), ({ { 60, 160, 220 }, { 120, 200, 90 }, { 230, 120, 180 } })[i + 1], Enum.Material.Fabric, { NoShadow = true })
	end
	local counter = P(m, "GymCounter", Vector3.new(10, 4, 3), base * CFrame.new(12, 2, 10), { 230, 80, 30 }, Enum.Material.SmoothPlastic)
	prompt(counter, "gym", "Entrenar", sp.Name)
	table.insert(World.NpcPoints, { Pos = (base * CFrame.new(12, 0, 7)).Position, Look = (base * CFrame.new(12, 0, 14)).Position, Name = "Entrenadora de Pulso Fit", Role = "leisure" })
end

local function buildCinema(parent, sp)
	local m = model(parent, "Cine")
	local w, d, h = 56, 44, 18
	local base = shell(m, sp.WX, sp.WZ, w, d, h, { 120, 20, 30 }, { 90, 20, 30 })
	local board = P(m, "CinemaSign", Vector3.new(30, 4, 0.6), base * CFrame.new(0, h - 2.5, d / 2 + 1.2), { 20, 20, 24 })
	signBoth(board, "🎬 " .. sp.Name, Color3.fromRGB(20, 10, 10), Color3.fromRGB(255, 214, 80))
	-- Marquesina con la cartelera
	local names = {}
	for _, mv in ipairs(StudioData.Movies) do
		names[#names + 1] = mv.Name
	end
	local marquee = P(m, "Marquee", Vector3.new(24, 6, 0.4), base * CFrame.new(-w / 2 + 14, 13, d / 2 + 1.4), { 255, 240, 200 }, Enum.Material.Neon, { NoShadow = true })
	signBoth(marquee, "EN CARTELERA\n" .. table.concat(names, " · "), Color3.fromRGB(255, 240, 200), Color3.fromRGB(120, 20, 30))
	-- Pantalla y butacas
	local screen = P(m, "MovieScreen", Vector3.new(36, 13, 0.3), base * CFrame.new(0, 9, -d / 2 + 1), { 240, 240, 255 }, Enum.Material.Neon, { NoShadow = true })
	nightLight(screen, 30, Color3.fromRGB(200, 210, 255))
	for row = 0, 2 do
		for i = 0, 7 do
			local x, z = -14 + i * 4, -6 + row * 5
			P(m, "Seat", Vector3.new(3, 1.4, 3), base * CFrame.new(x, 1.4 + row * 0.6, z), { 170, 20, 40 }, Enum.Material.Fabric)
			P(m, "SeatBack", Vector3.new(3, 2.6, 0.5), base * CFrame.new(x, 3.2 + row * 0.6, z + 1.4), { 170, 20, 40 }, Enum.Material.Fabric)
		end
	end
	-- Taquilla y palomitas
	local counter = P(m, "TicketCounter", Vector3.new(10, 4, 3), base * CFrame.new(w / 2 - 8, 2, 12), { 40, 20, 20 }, Enum.Material.Wood)
	prompt(counter, "cinema", "Comprar entrada", sp.Name)
	P(m, "PopcornMachine", Vector3.new(3, 4, 3), base * CFrame.new(w / 2 - 4, 6, 12), { 255, 220, 120 }, Enum.Material.Glass, { Transparency = 0.3 })
	P(m, "Popcorn", Vector3.new(2.6, 1.4, 2.6), base * CFrame.new(w / 2 - 4, 4.8, 12), { 255, 245, 200 }, Enum.Material.Sand)
	table.insert(World.NpcPoints, { Pos = (base * CFrame.new(w / 2 - 8, 0, 9)).Position, Look = (base * CFrame.new(w / 2 - 8, 0, 16)).Position, Name = "Taquillero de Lumière", Role = "leisure" })
end

local function buildKaraoke(parent, sp)
	local m = model(parent, "Karaoke")
	local w, d, h = 46, 36, 14
	local base = shell(m, sp.WX, sp.WZ, w, d, h, { 60, 20, 80 }, { 40, 20, 50 })
	local board = P(m, "KaraokeSign", Vector3.new(26, 3.5, 0.6), base * CFrame.new(0, h - 2.5, d / 2 + 1.2), { 20, 20, 24 })
	signBoth(board, "🎤 " .. sp.Name, Color3.fromRGB(80, 20, 110), Color3.fromRGB(255, 214, 80))
	-- Escenario con micrófono, pantalla de letras y bola de discoteca
	P(m, "Stage", Vector3.new(20, 1.4, 9), base * CFrame.new(0, 0.7, -d / 2 + 5), { 30, 20, 40 }, Enum.Material.WoodPlanks)
	local lyrics = P(m, "LyricsScreen", Vector3.new(16, 6, 0.3), base * CFrame.new(0, 7.5, -d / 2 + 0.9), { 20, 20, 60 }, Enum.Material.Neon, { NoShadow = true })
	signBoth(lyrics, "♪ Canta conmigo bajo las luces de la ciudad ♪", Color3.fromRGB(20, 20, 60), Color3.fromRGB(255, 230, 120))
	vcyl(m, "MicStand", 4.5, 0.25, base * CFrame.new(0, 3.6, -d / 2 + 6), { 200, 200, 210 }, Enum.Material.Metal)
	local mic = P(m, "StageMic", Vector3.new(0.6, 1.2, 0.6), base * CFrame.new(0, 6.3, -d / 2 + 6), { 230, 190, 70 }, Enum.Material.Metal)
	prompt(mic, "karaoke", "Cantar", sp.Name)
	local ball = P(m, "DiscoBall", Vector3.new(2.4, 2.4, 2.4), base * CFrame.new(0, h - 2.5, 0), { 220, 220, 230 }, Enum.Material.Foil, { Shape = Enum.PartType.Ball })
	nightLight(ball, 26, Color3.fromRGB(255, 120, 220))
	for i, c in ipairs({ { 255, 60, 160 }, { 60, 200, 255 }, { 255, 220, 60 } }) do
		local spot = P(m, "Spotlight", Vector3.new(1.4, 1.4, 1.4), base * CFrame.new(-8 + (i - 1) * 8, h - 1.2, -d / 2 + 8), c, Enum.Material.Neon, { NoShadow = true })
		nightLight(spot, 16, rgb(c))
	end
	-- Sofás, mesas y barra
	for i = 0, 2 do
		P(m, "Booth", Vector3.new(8, 1.6, 3), base * CFrame.new(-14 + i * 14, 1.2, 8), { 150, 30, 90 }, Enum.Material.Fabric)
		vcyl(m, "BoothTable", 0.4, 3, base * CFrame.new(-14 + i * 14, 2.6, 4.5), { 30, 20, 40 }, Enum.Material.Wood)
	end
	P(m, "KaraokeBar", Vector3.new(3, 4, 12), base * CFrame.new(w / 2 - 3, 2, 2), { 40, 20, 50 }, Enum.Material.Wood)
	table.insert(World.NpcPoints, { Pos = (base * CFrame.new(w / 2 - 6, 0, 2)).Position, Look = (base * CFrame.new(0, 0, 2)).Position, Name = "Anfitriona del karaoke", Role = "leisure" })
end

local function buildBowling(parent, sp)
	local m = model(parent, "Bolera")
	local w, d, h = 60, 44, 16
	local base = shell(m, sp.WX, sp.WZ, w, d, h, { 30, 40, 90 }, { 50, 50, 60 })
	local board = P(m, "BowlingSign", Vector3.new(32, 3.5, 0.6), base * CFrame.new(0, h - 2.5, d / 2 + 1.2), { 20, 20, 24 })
	signBoth(board, "🎳 " .. sp.Name, Color3.fromRGB(20, 40, 120), Color3.fromRGB(255, 214, 80))
	-- Cuatro pistas con sus bolos
	for lane = 0, 3 do
		local x = -21 + lane * 7
		P(m, "Lane", Vector3.new(5, 0.2, 28), base * CFrame.new(x, 0.7, -d / 2 + 15), { 220, 180, 120 }, Enum.Material.WoodPlanks)
		P(m, "Gutter", Vector3.new(0.8, 0.2, 28), base * CFrame.new(x - 2.9, 0.55, -d / 2 + 15), { 40, 40, 44 }, Enum.Material.Metal)
		P(m, "LaneArrow", Vector3.new(0.6, 0.05, 1.4), base * CFrame.new(x, 0.82, -d / 2 + 20), { 200, 40, 40 }, Enum.Material.SmoothPlastic, { NoShadow = true })
		for r = 1, 4 do
			for k = 1, r do
				vcyl(m, "Pin", 1.4, 0.5, base * CFrame.new(x + (k - (r + 1) / 2) * 0.9, 1.5, -d / 2 + 2.5 + (4 - r) * 0.9), { 250, 250, 250 }, Enum.Material.SmoothPlastic, { NoShadow = true })
			end
		end
		local score = P(m, "ScoreScreen", Vector3.new(5, 2.4, 0.3), base * CFrame.new(x, 9, -d / 2 + 26), { 20, 30, 80 }, Enum.Material.Neon, { NoShadow = true })
		signBoth(score, "PISTA " .. (lane + 1), Color3.fromRGB(20, 30, 80), Color3.fromRGB(255, 214, 80))
	end
	-- Bolas en el retorno y mostrador de zapatos (aviso)
	for i = 0, 5 do
		P(m, "BowlingBall", Vector3.new(1.4, 1.4, 1.4), base * CFrame.new(-21 + i * 1.6, 2.2, -d / 2 + 31), ({ { 220, 40, 40 }, { 40, 90, 220 }, { 30, 30, 34 }, { 120, 40, 180 }, { 40, 170, 90 }, { 240, 160, 30 } })[i + 1], Enum.Material.SmoothPlastic, { Shape = Enum.PartType.Ball })
	end
	P(m, "BallReturn", Vector3.new(10, 1.4, 2), base * CFrame.new(-17, 0.7, -d / 2 + 31), { 40, 40, 44 }, Enum.Material.Metal)
	local counter = P(m, "ShoeCounter", Vector3.new(10, 4, 3), base * CFrame.new(-14, 2, d / 2 - 5), { 20, 40, 120 }, Enum.Material.SmoothPlastic)
	prompt(counter, "bowling", "Jugar a los bolos", sp.Name)
	-- Recreativas junto a la pared este
	for i = 0, 3 do
		local cab = base * CFrame.new(w / 2 - 3, 0, -14 + i * 7)
		P(m, "ArcadeCabinet", Vector3.new(3, 7, 4), cab * CFrame.new(0, 3.5, 0), ({ { 200, 30, 60 }, { 30, 120, 220 }, { 240, 180, 30 }, { 120, 40, 200 } })[i + 1], Enum.Material.SmoothPlastic)
		local scr = P(m, "ArcadeScreen", Vector3.new(0.2, 2.4, 3), cab * CFrame.new(-1.6, 5, 0), { 80, 255, 160 }, Enum.Material.Neon, { NoShadow = true })
		nightLight(scr, 8, Color3.fromRGB(80, 255, 160))
	end
	table.insert(World.NpcPoints, { Pos = (base * CFrame.new(-14, 0, d / 2 - 8)).Position, Look = (base * CFrame.new(-14, 0, d / 2)).Position, Name = "Encargado de la bolera", Role = "leisure" })
end

local function buildDistrict(d)
	local cx, cz = WorldData.center(d)
	local rng = Random.new(Util.hashString(d.Id))
	local m = model(city, d.Name)
	local inner = CELL - ROAD
	-- Acera (borde) y suelo del distrito
	P(m, "Sidewalk", Vector3.new(inner, 1, inner), Vector3.new(cx, GROUND_TOP - 0.6, cz), { 175, 175, 180 }, Enum.Material.Concrete)
	local material = Enum.Material[d.Material] or Enum.Material.Grass
	P(m, "Ground", Vector3.new(inner - 10, 0.2, inner - 10), Vector3.new(cx, GROUND_TOP, cz), d.Ground, material)

	-- Señal del distrito + parada de taxi
	local stop = S.Travel.taxiStop(d)
	P(m, "TaxiPole", Vector3.new(0.5, 9, 0.5), Vector3.new(stop.X, GROUND_TOP + 4.5, stop.Z + 4), { 40, 40, 44 }, Enum.Material.Metal)
	local board = P(m, "DistrictSign", Vector3.new(14, 4, 0.4), Vector3.new(stop.X, GROUND_TOP + 9.5, stop.Z + 4), { 20, 30, 50 })
	signBoth(board, d.Name, Color3.fromRGB(20, 30, 50), Color3.new(1, 1, 1))
	local taxi = P(m, "TaxiSign", Vector3.new(3, 1.6, 0.3), Vector3.new(stop.X + 4, GROUND_TOP + 6, stop.Z + 4), { 255, 210, 0 })
	signBoth(taxi, "TAXI", Color3.fromRGB(255, 210, 0), Color3.fromRGB(20, 20, 20))

	if (d.Busy or 0) >= 5 then
		vending(m, stop.X - 14, stop.Z + 4)
	end

	-- Farolas en las aceras
	local half = inner / 2 - 3
	for _, pos in ipairs({ { -half, -half / 2 }, { half, half / 2 }, { half / 2, -half }, { -half / 2, half } }) do
		streetLamp(m, cx + pos[1], cz + pos[2])
	end

	-- Agua
	if d.Water then
		local wc = Vector3.new(cx + d.Water.X, GROUND_TOP + 1, cz + d.Water.Z)
		workspace.Terrain:FillBlock(CFrame.new(wc), Vector3.new(d.Water.W, 4, d.Water.D), Enum.Material.Water)
		local rim = Util.indexOf(d.Tags, "beach") and { 230, 210, 160 } or { 120, 110, 100 }
		local rimMat = Util.indexOf(d.Tags, "beach") and Enum.Material.Sand or Enum.Material.Slate
		P(m, "Shore", Vector3.new(d.Water.W + 4, 2.4, 2), Vector3.new(wc.X, GROUND_TOP + 1.2, wc.Z - d.Water.D / 2 - 1), rim, rimMat)
		P(m, "Shore", Vector3.new(2, 2.4, d.Water.D), Vector3.new(wc.X - d.Water.W / 2 - 1, GROUND_TOP + 1.2, wc.Z), rim, rimMat)
		P(m, "Shore", Vector3.new(2, 2.4, d.Water.D), Vector3.new(wc.X + d.Water.W / 2 + 1, GROUND_TOP + 1.2, wc.Z), rim, rimMat)
		P(m, "Shore", Vector3.new(d.Water.W + 4, 2.4, 2), Vector3.new(wc.X, GROUND_TOP + 1.2, wc.Z + d.Water.D / 2 + 1), rim, rimMat)
		if d.Id == "lake" or d.Id == "port" then
			P(m, "Pier", Vector3.new(8, 1, 40), Vector3.new(wc.X, GROUND_TOP + 3, wc.Z + d.Water.D / 2 - 18), { 130, 95, 65 }, Enum.Material.WoodPlanks)
		end
	end

	-- Montañas
	if d.Hills then
		for i = 1, 6 do
			local hx, hz = rng:NextInteger(-100, 100), rng:NextInteger(-100, 100)
			local s = rng:NextInteger(40, 80)
			P(m, "Hill", Vector3.new(s, s * 0.8, s), CFrame.new(cx + hx, GROUND_TOP + s * 0.2, cz + hz) * CFrame.Angles(0, rng:NextNumber() * 6, 0),
				{ 120, 115, 105 }, Enum.Material.Slate, { Shape = Enum.PartType.Ball })
		end
		P(m, "SnowCap", Vector3.new(40, 30, 40), Vector3.new(cx + 40, GROUND_TOP + 30, cz - 60), { 245, 248, 255 }, Enum.Material.Snow, { Shape = Enum.PartType.Ball })
	end
	if d.Fields then
		for i = -3, 3 do
			P(m, "Crops", Vector3.new(80, 1.2, 4), Vector3.new(cx - 40, GROUND_TOP + 0.6, cz - 50 + i * 8), { 200, 180, 60 }, Enum.Material.Grass)
		end
	end
	if d.Runway then
		P(m, "Runway", Vector3.new(30, 0.3, 230), Vector3.new(cx + 80, GROUND_TOP + 0.15, cz), { 50, 50, 55 }, Enum.Material.Asphalt)
		for i = -5, 5 do
			P(m, "RunwayMark", Vector3.new(1.5, 0.05, 10), Vector3.new(cx + 80, GROUND_TOP + 0.33, cz + i * 20), { 250, 250, 250 }, Enum.Material.SmoothPlastic, { NoShadow = true })
		end
		local plane = model(m, "Plane")
		P(plane, "Fuselage", Vector3.new(40, 6, 6), CFrame.new(cx + 80, GROUND_TOP + 5, cz - 60) * CFrame.Angles(0, math.rad(90), math.rad(90)), { 245, 245, 250 }, Enum.Material.SmoothPlastic, { Shape = Enum.PartType.Cylinder })
		P(plane, "Wings", Vector3.new(44, 1, 8), Vector3.new(cx + 80, GROUND_TOP + 4, cz - 60), { 220, 220, 230 }, Enum.Material.SmoothPlastic)
	end
	if d.Monument then
		P(m, "MonumentBase", Vector3.new(16, 3, 16), Vector3.new(cx, GROUND_TOP + 1.5, cz - 18), { 200, 190, 170 }, Enum.Material.Marble)
		P(m, "Obelisk", Vector3.new(6, 40, 6), Vector3.new(cx, GROUND_TOP + 23, cz - 18), { 230, 220, 200 }, Enum.Material.Marble)
		local top = P(m, "ObeliskTop", Vector3.new(4, 4, 4), Vector3.new(cx, GROUND_TOP + 45, cz - 18), { 255, 214, 100 }, Enum.Material.Neon, { Shape = Enum.PartType.Ball })
		nightLight(top, 40)
	end

	-- Edificios: huecos en una cuadrícula 4x4 evitando lugares y edificios especiales
	local blocked = {}
	for _, s in ipairs(d.Spots) do
		blocked[#blocked + 1] = { cx + s.X, cz + s.Z, 40 }
	end
	for _, sp in ipairs(d.Specials or {}) do
		blocked[#blocked + 1] = { cx + sp.X, cz + sp.Z, (sp.Type == "home" and 80) or (sp.Type == "dealer" and 64) or 50 }
	end
	blocked[#blocked + 1] = { stop.X, stop.Z, 20 }
	if d.Water then
		blocked[#blocked + 1] = { cx + d.Water.X, cz + d.Water.Z, math.max(d.Water.W, d.Water.D) / 2 + 25 }
	end
	if d.Runway then
		blocked[#blocked + 1] = { cx + 80, cz, 60 }
		blocked[#blocked + 1] = { cx + 80, cz + 90, 50 }
		blocked[#blocked + 1] = { cx + 80, cz - 90, 50 }
	end
	local slots = {}
	for _, ox in ipairs({ -98, -33, 33, 98 }) do
		for _, oz in ipairs({ -98, -33, 33, 98 }) do
			local x, z = cx + ox, cz + oz
			local free = true
			for _, b in ipairs(blocked) do
				if (x - b[1]) ^ 2 + (z - b[2]) ^ 2 < b[3] ^ 2 then
					free = false
				end
			end
			if free then
				slots[#slots + 1] = { x, z }
			end
		end
	end
	for i = #slots, 2, -1 do
		local j = rng:NextInteger(1, i)
		slots[i], slots[j] = slots[j], slots[i]
	end
	local builder = styleBuilders[d.Style] or styleBuilders.none
	local built = 0
	local buildings = folder(m, "Buildings")
	for _, slot in ipairs(slots) do
		if built >= (d.Count or 0) then
			break
		end
		builder(buildings, slot[1], slot[2], d, rng)
		built = built + 1
	end
	-- Huecos sobrantes: árboles, bancos y coches para dar vida
	local deco = folder(m, "Decoration")
	local trees = d.Trees or 0
	local placed = 0
	local tries = 0
	while placed < trees and tries < trees * 6 do
		tries = tries + 1
		local x, z = cx + rng:NextInteger(-115, 115), cz + rng:NextInteger(-115, 115)
		local ok = true
		for _, b in ipairs(blocked) do
			if (x - b[1]) ^ 2 + (z - b[2]) ^ 2 < (b[3] * 0.6) ^ 2 then
				ok = false
			end
		end
		for _, slot in ipairs(slots) do
			if (x - slot[1]) ^ 2 + (z - slot[2]) ^ 2 < 26 ^ 2 and placed < built then
				ok = false
			end
		end
		if ok then
			tree(deco, x, z, 0.8 + rng:NextNumber() * 0.6, rng)
			placed = placed + 1
		end
	end
	for _, s in ipairs(d.Spots) do
		bench(deco, cx + s.X + 10, cz + s.Z + 10, rng:NextNumber() * 6)
	end
	if Util.indexOf(d.Tags, "urban") or Util.indexOf(d.Tags, "shop") or Util.indexOf(d.Tags, "vehicle") then
		local colors = { { 200, 30, 40 }, { 30, 90, 200 }, { 240, 240, 240 }, { 20, 20, 25 }, { 250, 200, 40 }, { 60, 160, 90 } }
		for i = 1, 3 do
			car(deco, cx - 110 + i * 9, cz + 112, colors[rng:NextInteger(1, #colors)], 0)
		end
	end

	-- Lugares de grabación
	for _, s in ipairs(d.Spots) do
		local marker = P(m, "RecordSpot", Vector3.new(0.3, 10, 10), CFrame.new(cx + s.X, GROUND_TOP + 0.2, cz + s.Z) * CFrame.Angles(0, 0, math.rad(90)),
			{ 255, 50, 90 }, Enum.Material.Neon, { Shape = Enum.PartType.Cylinder, NoCollide = true, Transparency = 0.45, NoShadow = true })
		marker.CanQuery = false
		CollectionService:AddTag(marker, "RecordSpot")
		local bb = Instance.new("BillboardGui")
		bb.Size = UDim2.fromOffset(200, 40)
		bb.StudsOffset = Vector3.new(0, 7, 0)
		bb.MaxDistance = 140
		bb.Parent = marker
		local t = Instance.new("TextLabel")
		t.Size = UDim2.fromScale(1, 1)
		t.BackgroundColor3 = Color3.fromRGB(20, 20, 24)
		t.BackgroundTransparency = 0.25
		t.TextColor3 = Color3.new(1, 1, 1)
		t.Font = Enum.Font.GothamBold
		t.TextScaled = true
		t.Text = "🎥 " .. s.Name
		t.Parent = bb
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0, 10)
		corner.Parent = t
	end

	-- Edificios especiales
	for _, sp in ipairs(WorldData.Specials) do
		if sp.District == d.Id then
			if sp.Type == "store" then
				buildStore(m, sp, rng)
			elseif sp.Type == "cafe" then
				buildCafe(m, sp)
			elseif sp.Type == "bank" then
				buildBank(m, sp)
			elseif sp.Type == "restaurant" then
				buildRestaurant(m, sp)
			elseif sp.Type == "home" then
				buildResidence(m, sp)
			elseif sp.Type == "dealer" then
				buildDealer(m, sp)
			elseif sp.Type == "gas" then
				buildGasStation(m, sp)
			elseif sp.Type == "petshop" then
				buildPetShop(m, sp)
			elseif sp.Type == "usedstore" then
				buildUsedStore(m, sp)
			elseif sp.Type == "airport" then
				buildAirport(m, sp)
			elseif sp.Type == "studios" then
				buildStudioComplex(m, sp)
			elseif sp.Type == "gym" then
				buildGym(m, sp)
			elseif sp.Type == "cinema" then
				buildCinema(m, sp)
			elseif sp.Type == "karaoke" then
				buildKaraoke(m, sp)
			elseif sp.Type == "bowling" then
				buildBowling(m, sp)
			end
		end
	end
	if d.Id == "events" then
		buildVipLounge(m, cx + 90, cz - 90)
	end
	for _, l in ipairs(PropertyData.Listings) do
		if l.District == d.Id then
			buildPropertySign(m, l)
		end
	end

	-- Ciudadanos (NPC) junto a lugares concurridos
	if (d.Busy or 0) >= 4 then
		local s = d.Spots[1]
		table.insert(World.NpcPoints, { Pos = Vector3.new(cx + s.X - 8, GROUND_TOP, cz + s.Z - 6), Look = Vector3.new(cx + s.X, GROUND_TOP, cz + s.Z), Name = "Vecino de " .. d.Name, Role = "citizen", District = d.Id })
	end
end

local function buildRoads()
	local roads = folder(city, "Roads")
	local W, H = WorldData.totalSize()
	for k = 0, WorldData.Cols do
		local x = -W / 2 + k * CELL
		P(roads, "RoadNS", Vector3.new(ROAD, 1, H + ROAD), Vector3.new(x, -0.5 + 0.05, 0), { 45, 45, 50 }, Enum.Material.Asphalt)
		P(roads, "LineNS", Vector3.new(0.5, 0.05, H), Vector3.new(x, 0.08, 0), { 240, 200, 40 }, Enum.Material.SmoothPlastic, { NoShadow = true, NoCollide = true })
	end
	for j = 0, WorldData.Rows do
		local z = -H / 2 + j * CELL
		P(roads, "RoadEW", Vector3.new(W + ROAD, 1, ROAD), Vector3.new(0, -0.5 + 0.06, z), { 45, 45, 50 }, Enum.Material.Asphalt)
		P(roads, "LineEW", Vector3.new(W, 0.05, 0.5), Vector3.new(0, 0.09, z), { 240, 200, 40 }, Enum.Material.SmoothPlastic, { NoShadow = true, NoCollide = true })
	end
	-- Semáforos en los cruces interiores
	for k = 1, WorldData.Cols - 1 do
		for j = 1, WorldData.Rows - 1 do
			local x = -W / 2 + k * CELL + ROAD / 2 + 2
			local z = -H / 2 + j * CELL + ROAD / 2 + 2
			P(roads, "TrafficPole", Vector3.new(0.6, 12, 0.6), Vector3.new(x, GROUND_TOP + 6, z), { 40, 40, 44 }, Enum.Material.Metal)
			P(roads, "TrafficBox", Vector3.new(1.4, 4.2, 1.4), Vector3.new(x, GROUND_TOP + 11, z), { 25, 25, 28 }, Enum.Material.Metal)
			local lights = {}
			for i, col in ipairs({ { 255, 40, 40 }, { 255, 200, 0 }, { 40, 255, 90 } }) do
				lights[i] = P(roads, "TrafficLight", Vector3.new(1, 1, 0.3), Vector3.new(x, GROUND_TOP + 12.4 - (i - 1) * 1.3, z - 0.75), col, Enum.Material.Neon, { NoShadow = true })
			end
			table.insert(World.TrafficLights, { Lights = lights, Phase = (k + j) % 2 })
			-- paso de cebra
			for s = -2, 2 do
				P(roads, "Crosswalk", Vector3.new(1.6, 0.05, 8), Vector3.new(x - ROAD / 2 - 2 + s * 3, 0.1, z + 8), { 240, 240, 240 }, Enum.Material.SmoothPlastic, { NoShadow = true, NoCollide = true })
			end
		end
	end
end

local function buildSecrets()
	local f = folder(city, "Secrets")
	for _, s in ipairs(WorldData.Secrets) do
		local star = P(f, "SecretGlow", Vector3.new(1.4, 1.4, 1.4), Vector3.new(s.WX, GROUND_TOP + 2.5, s.WZ), { 255, 240, 140 }, Enum.Material.Neon,
			{ Shape = Enum.PartType.Ball, NoCollide = true, NoShadow = true })
		local sp = Instance.new("Sparkles")
		sp.SparkleColor = Color3.fromRGB(255, 240, 140)
		sp.Parent = star
		CollectionService:AddTag(star, "Spin")
		if s.Id == "sec_studio" then
			P(f, "AbandonedStudio", Vector3.new(24, 12, 20), Vector3.new(s.WX - 14, GROUND_TOP + 6, s.WZ + 2), { 70, 65, 60 }, Enum.Material.CorrodedMetal)
		elseif s.Id == "sec_dock" then
			P(f, "GhostShip", Vector3.new(14, 6, 40), Vector3.new(s.WX - 16, GROUND_TOP + 3, s.WZ), { 60, 50, 45 }, Enum.Material.Wood)
			P(f, "Mast", Vector3.new(1, 22, 1), Vector3.new(s.WX - 16, GROUND_TOP + 15, s.WZ), { 60, 50, 45 }, Enum.Material.Wood)
		elseif s.Id == "sec_arcade" then
			local cab = P(f, "LegendArcade", Vector3.new(4, 7, 3), Vector3.new(s.WX - 4, GROUND_TOP + 3.5, s.WZ), { 40, 0, 80 }, Enum.Material.SmoothPlastic)
			P(f, "ArcadeScreen", Vector3.new(3, 2.4, 0.2), Vector3.new(s.WX - 4, GROUND_TOP + 5, s.WZ + 1.6), { 0, 255, 200 }, Enum.Material.Neon, { NoShadow = true })
			cab:SetAttribute("Secret", true)
		elseif s.Id == "sec_forest" then
			tree(f, s.WX - 8, s.WZ - 8, 2.6, Random.new(7))
		end
	end
end

---------------------------------------------------------------------------
-- Interacciones de los avisos (ProximityPrompt)
---------------------------------------------------------------------------
local function onPrompt(pp, player)
	local action = pp:GetAttribute("Action")
	if not S.Data.get(player) then
		return
	end
	if action == "computer_home" then
		S.Computer.onPrompt(player, pp.Parent, "home", pp:GetAttribute("Owner"))
	elseif action == "computer_public" then
		S.Computer.onPrompt(player, pp.Parent, "public")
	elseif action == "wardrobe" then
		if pp:GetAttribute("Owner") ~= player.UserId then
			S.Net.notify(player, "Este vestidor no es tuyo.", "error")
			return
		end
		S.Net.push(player, "openUI", { ui = "style" })
	elseif action == "store_catalog" then
		S.Travel.markStoreVisit(player, pp:GetAttribute("StoreId"))
		S.Net.push(player, "openUI", { ui = "store", store = pp:GetAttribute("StoreId") })
	elseif action == "inspect" then
		S.Travel.markStoreVisit(player, pp:GetAttribute("StoreId"))
		S.Net.push(player, "openUI", { ui = "product", item = pp:GetAttribute("ItemId"), store = pp:GetAttribute("StoreId") })
	elseif action == "atm" then
		S.Net.push(player, "openUI", { ui = "app", app = "bank" })
	elseif action == "npc" then
		S.NPC.talk(player, pp:GetAttribute("NpcId"))
	elseif action == "vip_enter" then
		if not S.Monetization.owns(player, "VIP") then
			S.Net.notify(player, "La sala VIP es para quienes tienen el Game Pass VIP (opcional). Hay muchos otros lugares para grabar gratis.", "info")
			return
		end
		S.Travel.teleport(player, World.VipLounge.Center)
	elseif action == "vip_exit" then
		S.Travel.teleport(player, World.VipLounge.Entry)
	elseif action == "rest" then
		S.Needs.rest(player)
	elseif action == "cook" then
		if not S.Home.isAtHome(player) then
			S.Net.notify(player, "Esta cocina no es tuya.", "error")
			return
		end
		S.Net.push(player, "openUI", { ui = "food", tab = "cook" })
	elseif action == "vending" or action == "restaurant" or action == "cafe" then
		S.Net.push(player, "openUI", { ui = "food", tab = "menu", place = action })
	elseif action == "dealer" or action == "gas" then
		S.Net.push(player, "openUI", { ui = "app", app = "vehicles" })
	elseif action == "petshop" then
		S.Net.push(player, "openUI", { ui = "app", app = "pets" })
	elseif action == "usedstore" then
		S.Travel.markStoreVisit(player, "usedstore")
		S.Net.push(player, "openUI", { ui = "app", app = "market" })
	elseif action == "prop_view" then
		S.Net.push(player, "openUI", { ui = "realty", listing = pp:GetAttribute("PropId") })
	elseif action == "prop_enter" then
		local id = pp:GetAttribute("PropId")
		local data = S.Data.get(player)
		if not data.Properties[id] then
			S.Net.notify(player, "No es tuya. Alquílala o cómprala desde el anuncio (E) o la app Inmobiliaria.", "info")
			return
		end
		local cf = S.Property.enterCFrame(player, id)
		S.Travel.teleport(player, cf.Position)
		S.Quest.tutorialEvent(player, "enter_home")
	elseif action == "airport" or action == "dest_shop" then
		S.Net.push(player, "openUI", { ui = "app", app = "travel" })
	elseif action == "dest_hotel" or action == "dest_return" then
		local ok, msg
		if action == "dest_hotel" then
			ok, msg = S.Destination.hotel(player)
		else
			ok, msg = S.Destination.goBack(player)
		end
		S.Net.notify(player, msg, ok and "success" or "error")
	elseif action == "studio_desk" or action == "studio_panel" then
		S.Net.push(player, "openUI", { ui = "app", app = "studios" })
	elseif action == "studio_exit" then
		if S.Studio then
			local ok, msg = S.Studio.leave(player)
			S.Net.notify(player, msg, ok and "success" or "info")
		end
	elseif action == "gym" or action == "cinema" or action == "karaoke" or action == "bowling" then
		S.Net.push(player, "openUI", { ui = "app", app = "leisure" })
	elseif action == "prop_exit" then
		local id = S.Property.inside(player)
		if id then
			S.Travel.teleport(player, S.Property.exteriorOf(id))
		end
	end
end
World.onPrompt = onPrompt

function World.build()
	city = workspace:FindFirstChild("City")
	if city then
		city:Destroy()
	end
	city = folder(workspace, "City")
	local W, H = WorldData.totalSize()
	local base = P(city, "Baseplate", Vector3.new(W + 600, 2, H + 600), Vector3.new(0, -2, 0), { 90, 140, 80 }, Enum.Material.Grass)
	base.Locked = true
	-- Mar al sur
	workspace.Terrain:FillBlock(CFrame.new(0, -3, H / 2 + 300), Vector3.new(W + 600, 6, 560), Enum.Material.Water)
	buildRoads()
	for _, d in ipairs(WorldData.Districts) do
		buildDistrict(d)
	end
	buildSecrets()
	buildDestinations()
	buildStudioSets()
	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "FallbackSpawn"
	spawn.Anchored = true
	spawn.Size = Vector3.new(8, 1, 8)
	local hp = World.HomePosition or Vector3.new(0, 2, 0)
	spawn.CFrame = CFrame.new(hp + Vector3.new(8, -2, 0))
	spawn.Transparency = 1
	spawn.CanCollide = false
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.Parent = city
end

function World.Start()
	local function connect(pp)
		pp:SetAttribute("Connected", true)
		pp.Triggered:Connect(function(player)
			local ok, err = pcall(onPrompt, pp, player)
			if not ok then
				S.Net.logError("prompt", err)
			end
		end)
	end
	-- Avisos creados más tarde (interiores de propiedades)
	CollectionService:GetInstanceAddedSignal("YTPrompt"):Connect(connect)
	World.build()
	for _, pp in ipairs(CollectionService:GetTagged("YTPrompt")) do
		if not pp:GetAttribute("Connected") then
			pp:SetAttribute("Connected", true)
			connect(pp)
		end
	end
	-- Semáforos
	task.spawn(function()
		local tick = 0
		while true do
			tick = tick + 1
			local phase = math.floor(tick / 2) % 2
			local amber = tick % 2 == 1
			for _, tl in ipairs(World.TrafficLights) do
				local green = (phase + tl.Phase) % 2 == 0
				tl.Lights[1].Transparency = (not green and not amber) and 0 or 0.8
				tl.Lights[2].Transparency = amber and 0 or 0.8
				tl.Lights[3].Transparency = (green and not amber) and 0 or 0.8
			end
			task.wait(4)
		end
	end)
end

return World
