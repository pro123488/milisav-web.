-- MÚSICA Y ARCHIVOS
---------------------------------------------------------------------------
local Music = { Id = "music", Name = "Música", Icon = "🎵", Order = 21, Surfaces = { pc = true, phone = true }, Width = 640, Height = 500 }
function Music.build(container, ctx)
	local s = UI.scroll(container, { Pad = 6 })
	UI.label(s, "Biblioteca de música libre (ficticia). Asigna una pista a un proyecto: se guarda en su edición.", { TextSize = 12, Color = T.Sub, Height = 30 })
	for _, m in ipairs(VideoData.Music) do
		if m.Id ~= "none" then
			local card = UI.card(s, { Height = 0, Auto = Enum.AutomaticSize.Y })
			UI.label(card, "🎵 " .. m.Name .. " — " .. m.Artist .. " · " .. m.Mood, { Font = Enum.Font.GothamBold, TextSize = 13 })
			local fits = {}
			for _, id in ipairs(m.Fits) do
				fits[#fits + 1] = catName(id)
			end
			UI.label(card, "Encaja con: " .. table.concat(fits, ", "), { TextSize = 11, Color = T.Sub, Height = 28 })
			local row = UI.row(card, 28)
			for pid, p in pairs(State.Data and State.Data.Projects or {}) do
				UI.button(row, "→ " .. p.Name, function()
					local edit = Util.deepCopy(p.Edit)
					edit.Music = m.Id
					Net.call("Video.SaveEdit", { pid = pid, edit = edit })
				end, { Width = 150, Height = 26, TextSize = 11 })
			end
		end
	end
end
table.insert(apps, Music)

local Files = { Id = "files", Name = "Archivos", Icon = "📁", Order = 22, Surfaces = { pc = true }, Width = 720, Height = 520 }
function Files.build(container, ctx)
	local folder = "projects"
	local function render()
		UI.clear(container)
		local data = State.Data
		if not data then
			return
		end
		local session = ctx.session() or {}
		local top = UI.row(container, 34)
		for _, f in ipairs({ { "projects", "📁 Proyectos" }, { "photos", "🖼 Fotos" }, { "thumbs", "🎨 Miniaturas" }, { "videos", "▶ Publicados" } }) do
			UI.button(top, f[2], function()
				folder = f[1]
				render()
			end, { Width = 130, Height = 28, Color = folder == f[1] and T.Accent or T.Panel3 })
		end
		local used = data.Derived.StorageUsed
		local cap = session.StorageGb or 0
		local srow = UI.row(container, 22)
		srow.Position = UDim2.fromOffset(0, 38)
		UI.label(srow, "💾 Almacenamiento: " .. used .. " / " .. Util.formatInt(cap) .. " GB", { Size = UDim2.fromOffset(260, 20), TextSize = 12 })
		UI.progress(srow, cap > 0 and used / cap or 0, used / math.max(cap, 1) > 0.85 and T.Err or T.Ok, { Size = UDim2.fromOffset(300, 10) })
		local s = UI.scroll(container, { Size = UDim2.new(1, 0, 1, -66), Position = UDim2.fromOffset(0, 66), Pad = 4 })
		if folder == "projects" then
			for pid, p in pairs(data.Projects) do
				local gb = 0
				for _, sc in ipairs(p.Scenes) do
					if sc.Imp then
						gb = gb + sc.Gb
					end
				end
				local row = UI.row(s, 30)
				UI.label(row, "📁 " .. p.Name .. " · " .. #p.Scenes .. " escenas · " .. math.floor(gb * 10) / 10 .. " GB", { Size = UDim2.new(1, -110, 1, 0), TextSize = 12 })
				UI.button(row, "🗑 Papelera", function()
					Notify.confirm("¿Eliminar el proyecto «" .. p.Name .. "»?", function()
						Net.call("Video.DeleteProject", { pid = pid })
					end)
				end, { Width = 100, Height = 26, TextSize = 11 })
			end
		elseif folder == "photos" then
			for _, ph in ipairs(data.Photos) do
				local row = UI.row(s, 28)
				UI.label(row, "🖼 [" .. ph.Album .. "] " .. ph.SpotName .. " · Q" .. math.floor(ph.Q), { Size = UDim2.new(1, -110, 1, 0), TextSize = 12 })
				UI.button(row, "🗑 Papelera", function()
					Net.call("Photo.Delete", { id = ph.Id })
				end, { Width = 100, Height = 24, TextSize = 11 })
			end
		elseif folder == "thumbs" then
			for _, t in pairs(data.Thumbnails) do
				local row = UI.row(s, 28)
				UI.label(row, "🎨 «" .. t.Design.text .. "» ⭐" .. math.floor(t.Score), { Size = UDim2.new(1, -110, 1, 0), TextSize = 12 })
				UI.button(row, "🗑 Papelera", function()
					Net.call("Thumb.Delete", { id = t.Id })
				end, { Width = 100, Height = 24, TextSize = 11 })
			end
		else
			for _, v in ipairs(data.Videos) do
				UI.label(s, "▶ " .. v.Title .. " · " .. Util.formatInt(v.Views) .. " visitas", { TextSize = 12 })
			end
		end
	end
	render()
	ctx.onState(render)
end
table.insert(apps, Files)

---------------------------------------------------------------------------
-- AJUSTES (incluye tienda de Robux opcional)
---------------------------------------------------------------------------
local Settings = { Id = "settings", Name = "Ajustes", Icon = "⚙", Order = 30, Surfaces = { pc = true, phone = true, panel = true }, Width = 720, Height = 560 }
function Settings.build(container, ctx)
	local data = State.Data
	if not data then
		return
	end
	local st = Util.deepCopy(data.Settings)
	local s = UI.scroll(container, { Pad = 6 })
	local function save(key, value)
		st[key] = value
		Net.call("Settings.Set", { key = key, value = value }, { quietOk = true })
	end
	UI.title(s, "🔊 Sonido")
	UI.stepper(s, "Efectos", st.Sfx, 0, 1, 0.1, function(v)
		save("Sfx", v)
	end)
	UI.stepper(s, "Música", st.Music, 0, 1, 0.1, function(v)
		save("Music", v)
	end)
	UI.title(s, "🖥 Pantalla y accesibilidad")
	UI.stepper(s, "Tamaño interfaz", st.UIScale, 0.7, 1.4, 0.1, function(v)
		save("UIScale", v)
	end)
	UI.toggle(s, "Reducir animaciones", st.ReduceMotion, function(v)
		save("ReduceMotion", v)
	end)
	UI.toggle(s, "Sombras (gráficos)", st.Shadows ~= false, function(v)
		save("Shadows", v)
	end)
	UI.toggle(s, "Mostrar pistas del tutorial", st.Hints ~= false, function(v)
		save("Hints", v)
	end)
	local wps = {}
	for i = 1, 5 do
		wps[i] = "Fondo " .. i
	end
	UI.cycle(s, "Fondo del escritorio", wps, st.Wallpaper or 1, function(i)
		save("Wallpaper", i)
	end)
	UI.title(s, "🎮 Controles")
	UI.label(s, "PC: WASD moverse · Shift correr · E interactuar · P teléfono · I inventario · M misiones · R grabar · F foto · V estilo · C computador portátil · Esc cerrar.\nMóvil: joystick y botones de la parte inferior; toca los avisos para interactuar.", { TextSize = 12, Height = 70, VAlign = Enum.TextYAlignment.Top })
	if data.Derived.ReadOnly then
		UI.label(s, "⚠ Modo de prueba: los datos NO se guardan (Studio sin acceso a la API).", { Color = T.Warn, TextSize = 12 })
	end
	UI.title(s, "⭐ Apoya el juego (opcional, Robux)")
	UI.label(s, "Todo el juego se puede disfrutar sin pagar. Los pases dan comodidad o cosméticos, nunca contenido bloqueado.", { TextSize = 12, Color = T.Sub, Height = 30 })
	task.spawn(function()
		local r = Net.call("Shop.PassInfo", {}, { silent = true })
		if not r.ok or not s.Parent then
			return
		end
		for _, pass in ipairs(r.data.passes) do
			local card = UI.card(s, { Height = 0, Auto = Enum.AutomaticSize.Y })
			UI.label(card, pass.Name .. (pass.Owned and " ✔" or ""), { Font = Enum.Font.GothamBold, TextSize = 13 })
			UI.label(card, pass.Desc, { TextSize = 12, Color = T.Sub, Height = 30 })
			if not pass.Configured then
				UI.label(card, "No configurado (falta el ID en MonetizationConfig).", { TextSize = 11, Color = T.Warn })
			elseif not pass.Owned then
				UI.button(card, "Comprar", function()
					MarketplaceService:PromptGamePassPurchase(player, pass.Id)
				end, { Width = 100, Height = 26 })
			end
		end
		for _, prod in ipairs(r.data.products) do
			local row = UI.row(s, 30)
			UI.label(row, prod.Name, { Size = UDim2.fromOffset(280, 26), TextSize = 12 })
			if prod.Configured then
				UI.button(row, "Comprar", function()
					MarketplaceService:PromptProductPurchase(player, prod.Id)
				end, { Width = 100, Height = 26 })
			else
				UI.label(row, "No configurado", { Size = UDim2.fromOffset(140, 26), TextSize = 11, Color = T.Warn })
			end
		end
	end)
end
table.insert(apps, Settings)

return apps
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000059"><Properties><string name="Name">RealtyApp</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- App Inmobiliaria: mercado con filtros (precio, tamaño, distrito, calidad, tipo y características),
-- contratos de alquiler, compra, venta, mudanzas, deudas y mejoras de tus propiedades.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Client = script.Parent.Parent
local UI = require(Client.UIKit)
local Net = require(Client.Net)
local State = require(Client.State)
local Notify = require(Client.Notify)
local PropertyData = require(Shared.PropertyData)
local WorldData = require(Shared.WorldData)
local Util = require(Shared.Util)
local T = UI.Theme

local Realty = { Id = "realty", Name = "Inmobiliaria", Icon = "🏘", Order = 6, Surfaces = { pc = true, phone = true, panel = true }, Width = 940, Height = 580 }

function Realty.build(container, ctx)
	local tab = "market"
	local f = { kind = 1, price = 1, size = 1, district = 1, env = 1, pool = false, studio = false, view = false }
	local selected = ctx.params.listing
	local kinds = { "Todos", "Vivienda", "Estudio", "Negocio", "Garaje", "Terreno" }
	local kindKeys = { false, "home", "studio", "business", "garage", "land" }
	local prices = { "Cualquier precio", "Hasta $1.000/sem o $25.000", "Hasta $2.000/sem o $100.000", "Sin límite" }
	local priceRent = { math.huge, 1000, 2000, math.huge }
	local priceBuy = { math.huge, 25000, 100000, math.huge }
	local sizes = { "Cualquier tamaño", "Más de 1.000 m²", "Más de 2.000 m²", "Más de 3.000 m²" }
	local sizeMin = { 0, 1000, 2000, 3000 }
	local envs = { "Cualquier calidad", "Entorno 60+", "Entorno 75+", "Entorno 90+" }
	local envMin = { 0, 60, 75, 90 }
	local districts = { "Todos los distritos" }
	local districtIds = { false }
	for _, l in ipairs(PropertyData.Listings) do
		local d = WorldData.DistrictById[l.District]
		if not Util.indexOf(districtIds, l.District) then
			districts[#districts + 1] = d.Name
			districtIds[#districtIds + 1] = l.District
		end
	end

	local render
	local function detail(parent, l)
		local data = State.Data
		local rec = data.Properties[l.Id]
		local card = UI.card(parent, { Height = 0, Auto = Enum.AutomaticSize.Y })
		UI.label(card, l.Name, { Font = Enum.Font.GothamBlack, TextSize = 16, Height = 22 })
		UI.label(card, l.Type .. " · " .. PropertyData.Kinds[l.Kind] .. " · " .. WorldData.DistrictById[l.District].Name, { TextSize = 12, Color = T.Sub })
		UI.label(card, (l.Rent and ("Alquiler $" .. Util.formatInt(l.Rent) .. "/sem") or "No se alquila") .. "  ·  " .. (l.Buy and ("Compra $" .. Util.formatInt(l.Buy)) or "No se vende"), { Font = Enum.Font.GothamBold, Color = T.Gold })
		UI.label(card, "Mantenimiento $" .. l.Upkeep .. "/sem (si es tuya) · Reventa " .. math.floor(l.Resale * 100) .. "%", { TextSize = 12 })
		UI.label(card, "Superficie " .. Util.formatInt(l.W * l.D) .. " m² · " .. l.Slots .. " muebles · almacena " .. l.Storage .. " objetos", { TextSize = 12 })
		UI.label(card, "Entorno " .. l.Env .. "/100 · Bonus de grabación +" .. l.Studio .. (l.View and (" · " .. l.View) or "") .. (l.Pool and " · Piscina" or "") .. (l.Remodel and " · Remodelable" or " · No remodelable"), { TextSize = 12 })
		local req = {}
		if (l.Req.Level or 1) > 1 then
			req[#req + 1] = "nivel " .. l.Req.Level
		end
		if (l.Req.Subs or 0) > 0 then
			req[#req + 1] = Util.formatInt(l.Req.Subs) .. " suscriptores"
		end
		if #req > 0 then
			UI.label(card, "Requisitos: " .. table.concat(req, ", "), { TextSize = 12, Color = (data.Level >= (l.Req.Level or 1) and data.Channel.Subs >= (l.Req.Subs or 0)) and T.Ok or T.Err })
		end
		if l.Rent then
			UI.label(card, "📄 Contrato simulado: pagas la primera semana + fianza ($" .. Util.formatInt(l.Rent * 2) .. "). Cada 7 días jugados se cobra el alquiler. Impago = recargo del 10%; tras 3 impagos se rescinde el contrato y tus muebles vuelven a tu inventario. La fianza se devuelve al terminar sin deudas.", { TextSize = 11, Color = T.Sub, Height = 0, Auto = Enum.AutomaticSize.Y })
		end
		local row = UI.row(card, 34, nil, 6)
		if not rec then
			if l.Rent then
				UI.button(row, "📄 Alquilar", function()
					Notify.confirm("¿Firmar el contrato de alquiler de «" .. l.Name .. "» por $" .. Util.formatInt(l.Rent * 2) .. " (semana + fianza)?", function()
						Net.call("Prop.Rent", { id = l.Id })
					end, "Firmar")
				end, { Width = 120, Color = T.Accent2 })
			end
			if l.Buy then
				UI.button(row, "🔑 Comprar", function()
					Notify.confirm("¿Comprar «" .. l.Name .. "» por $" .. Util.formatInt(l.Buy) .. "?", function()
						Net.call("Prop.Buy", { id = l.Id })
					end, "Comprar")
				end, { Width = 120, Color = T.Ok })
			end
		end
		UI.button(row, "🚕 Ir a verla", function()
			Net.call("Prop.Go", { id = l.Id })
		end, { Width = 130 })
		return card
	end

	render = function()
		UI.clear(container)
		local data = State.Data
		if not data then
			return
		end
		local d = data.Derived
		local top = UI.row(container, 34)
		UI.button(top, "🏘 Mercado", function()
			tab = "market"
			render()
		end, { Width = 120, Height = 28, Color = tab == "market" and T.Accent or T.Panel3 })
		UI.button(top, "🔑 Mis propiedades (" .. State.count(data.Properties) .. "/" .. d.MaxProps .. ")", function()
			tab = "mine"
			render()
		end, { Width = 210, Height = 28, Color = tab == "mine" and T.Accent or T.Panel3 })
		UI.label(top, "📦 Almacenaje " .. d.Stored .. "/" .. d.StorageCap .. " · 💰 $" .. Util.formatInt(data.Money), { Size = UDim2.fromOffset(300, 28), TextSize = 12, Color = T.Sub })
		local body = UI.frame(container, { Size = UDim2.new(1, 0, 1, -40), Position = UDim2.fromOffset(0, 40), Transparency = 1, Radius = false })
		if tab == "mine" then
			local s = UI.scroll(body, { Pad = 6 })
			UI.label(s, "🏠 Vives en: " .. (data.HomeProperty ~= "" and PropertyData.ById[data.HomeProperty].Name or "Residencia Económica (habitación alquilada)"), { Font = Enum.Font.GothamBold })
			if data.HomeProperty ~= "" then
				UI.button(s, "Volver a la Residencia Económica", function()
					Net.call("Prop.MoveIn", { id = "" })
				end, { Width = 280, Height = 28, TextSize = 12 })
			end
			if next(data.Properties) == nil then
				UI.label(s, "Aún no tienes propiedades. Puedes alquilar antes de tener dinero para comprar.", { Color = T.Sub })
			end
			for id, rec in pairs(data.Properties) do
				local l = PropertyData.ById[id]
				local card = UI.card(s, { Height = 0, Auto = Enum.AutomaticSize.Y, Color = rec.Debt > 0 and Color3.fromRGB(80, 40, 40) or T.Panel2 })
				UI.label(card, (rec.Mode == "own" and "🔑 " or "📄 ") .. l.Name .. (data.HomeProperty == id and "  · 🏠 tu hogar" or ""), { Font = Enum.Font.GothamBold })
				local due = math.max(0, rec.NextDue - data.Home.PlayDays)
				UI.label(card, (rec.Mode == "own" and ("Propia · mantenimiento $" .. l.Upkeep) or ("Alquiler $" .. l.Rent .. " · fianza $" .. rec.Deposit)) .. " · próximo pago en " .. due .. " días · muebles " .. State.count(rec.Placed) .. "/" .. l.Slots, { TextSize = 12, Color = T.Sub })
				local ups = {}
				for key in pairs(rec.Upgrades) do
					ups[#ups + 1] = PropertyData.Upgrades[key].Name
				end
				if #ups > 0 then
					UI.label(card, "Mejoras: " .. table.concat(ups, ", "), { TextSize = 12, Color = T.Ok })
				end
				if rec.Debt > 0 then
					UI.label(card, "⚠ Deuda: $" .. Util.formatInt(rec.Debt) .. " (" .. rec.Missed .. " impagos)", { TextSize = 12, Color = T.Err })
				end
				local row = UI.row(card, 32, nil, 4)
				UI.button(row, "🚕 Ir", function()
					Net.call("Prop.Go", { id = id })
				end, { Width = 70, Height = 28, TextSize = 12 })
				if data.HomeProperty ~= id and (l.Kind == "home" or l.Kind == "studio") then
					UI.button(row, "🏠 Vivir aquí", function()
						Net.call("Prop.MoveIn", { id = id })
					end, { Width = 110, Height = 28, TextSize = 12 })
				end
				if rec.Debt > 0 then
					UI.button(row, "Pagar deuda", function()
						Net.call("Prop.PayDebt", { id = id })
					end, { Width = 110, Height = 28, TextSize = 12, Color = T.Accent })
				end
				if rec.Mode == "rent" then
					if l.Buy then
						UI.button(row, "🔑 Comprar ($" .. Util.formatInt(l.Buy) .. ")", function()
							Net.call("Prop.Buy", { id = id })
						end, { Width = 170, Height = 28, TextSize = 12, Color = T.Ok })
					end
					UI.button(row, "Terminar contrato", function()
						Notify.confirm("¿Terminar el alquiler de «" .. l.Name .. "»? Tus muebles volverán al inventario y se devolverá la fianza si no hay deudas.", function()
							Net.call("Prop.EndRent", { id = id })
						end)
					end, { Width = 150, Height = 28, TextSize = 12, Color = Color3.fromRGB(110, 40, 40) })
				else
					UI.button(row, "Vender ($" .. Util.formatInt(math.floor(l.Buy * l.Resale + (rec.Spent or 0) * 0.5 - rec.Debt)) .. ")", function()
						Notify.confirm("¿Vender «" .. l.Name .. "»? Tus muebles volverán al inventario.", function()
							Net.call("Prop.Sell", { id = id })
						end, "Vender")
					end, { Width = 170, Height = 28, TextSize = 12, Color = Color3.fromRGB(110, 40, 40) })
				end
				local urow = UI.frame(card, { Height = 0, Auto = Enum.AutomaticSize.Y, Transparency = 1, Radius = false })
				UI.grid(urow, 210, 28, 4)
				for key, up in pairs(PropertyData.Upgrades) do
					if not rec.Upgrades[key] then
						UI.button(urow, "+ " .. up.Name .. " $" .. Util.formatInt(up.Cost), function()
							Notify.confirm(up.Name .. ": " .. up.Desc .. " ¿Instalar por $" .. Util.formatInt(up.Cost) .. "?", function()
								Net.call("Prop.Upgrade", { id = id, key = key })
							end)
						end, { Size = UDim2.fromOffset(210, 28), TextSize = 11 })
					end
				end
			end
			return
		end
		-- Mercado con filtros
		local narrow = ctx.kind == "phone"
		local filters = UI.scroll(body, { Size = narrow and UDim2.new(1, 0, 0, 120) or UDim2.new(0, 330, 1, 0), Color = T.Panel2, Transparency = 0, Pad = 2 })
		UI.cycle(filters, "Tipo", kinds, f.kind, function(i)
			f.kind = i
			render()
		end, { LabelWidth = 70, ValueWidth = 150 })
		UI.cycle(filters, "Precio", prices, f.price, function(i)
			f.price = i
			render()
		end, { LabelWidth = 70, ValueWidth = 150 })
		UI.cycle(filters, "Tamaño", sizes, f.size, function(i)
			f.size = i
			render()
		end, { LabelWidth = 70, ValueWidth = 150 })
		UI.cycle(filters, "Distrito", districts, f.district, function(i)
			f.district = i
			render()
		end, { LabelWidth = 70, ValueWidth = 150 })
		UI.cycle(filters, "Calidad", envs, f.env, function(i)
			f.env = i
			render()
		end, { LabelWidth = 70, ValueWidth = 150 })
		UI.toggle(filters, "Con piscina", f.pool, function(v)
			f.pool = v
			render()
		end)
		UI.toggle(filters, "Bueno para grabar (+8)", f.studio, function(v)
			f.studio = v
			render()
		end)
		UI.toggle(filters, "Con vistas", f.view, function(v)
			f.view = v
			render()
		end)
		local list = UI.scroll(body, { Size = narrow and UDim2.new(1, 0, 1, -126) or UDim2.new(1, -340, 1, 0), Position = narrow and UDim2.fromOffset(0, 126) or UDim2.fromOffset(340, 0), Pad = 6 })
		if selected and PropertyData.ById[selected] then
			detail(list, PropertyData.ById[selected])
			UI.button(list, "◀ Ver todos los anuncios", function()
				selected = nil
				render()
			end, { Width = 220, Height = 28 })
			return
		end
		local count = 0
		for _, l in ipairs(PropertyData.Listings) do
			local ok = true
			if kindKeys[f.kind] and l.Kind ~= kindKeys[f.kind] then
				ok = false
			end
			if (l.Rent or math.huge) > priceRent[f.price] and (l.Buy or math.huge) > priceBuy[f.price] and f.price > 1 and f.price < 4 then
				ok = false
			end
			if l.W * l.D < sizeMin[f.size] then
				ok = false
			end
			if districtIds[f.district] and l.District ~= districtIds[f.district] then
				ok = false
			end
			if l.Env < envMin[f.env] then
				ok = false
			end
			if f.pool and not l.Pool then
				ok = false
			end
			if f.studio and l.Studio < 8 then
				ok = false
			end
			if f.view and not l.View then
				ok = false
			end
			if ok then
				count = count + 1
				local mine = data.Properties[l.Id]
				local b = UI.button(list, (mine and "✔ " or "") .. l.Name .. "\n" .. (l.Rent and ("$" .. Util.formatInt(l.Rent) .. "/sem") or "—") .. "  ·  " .. (l.Buy and ("$" .. Util.formatInt(l.Buy)) or "—") .. "  ·  " .. Util.formatInt(l.W * l.D) .. " m²  ·  entorno " .. l.Env .. ((l.Req.Level or 1) > data.Level and ("  · 🔒 nivel " .. l.Req.Level) or ""), function()
					selected = l.Id
					render()
				end, { Size = UDim2.new(1, -8, 0, 46), TextSize = 12, Color = mine and Color3.fromRGB(40, 80, 60) or T.Panel2 })
				b.TextXAlignment = Enum.TextXAlignment.Left
			end
		end
		if count == 0 then
			UI.label(list, "Ningún anuncio cumple los filtros.", { Color = T.Sub })
		end
	end
	render()
	ctx.onState(render)
end

return Realty
]]></ProtectedString></Properties></Item></Item><Item class="ModuleScript" referent="RBX000060"><Properties><string name="Name">BuildUI</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- BuildUI (cliente): modo construcción dentro de tus propiedades.
-- Colocar muebles con una vista previa que sigue al ratón/dedo, girar (R o botón), mover, recoger,
-- cambiar paredes/suelo/luz/cortinas, aplicar estilos, mejoras y diseños guardados.
-- El servidor valida cada colocación (límites, choques, puerta, puesto de trabajo, número de muebles).

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local UI = require(script.Parent.UIKit)
local State = require(script.Parent.State)
local Net = require(script.Parent.Net)
local Notify = require(script.Parent.Notify)
local Catalog = require(Shared.ItemCatalog)
local PropertyData = require(Shared.PropertyData)
local Util = require(Shared.Util)
local T = UI.Theme

local Build = {}
local player = Players.LocalPlayer
local gui, panel
local ghost, ghostConn
local placing = nil -- { uid, def, r }
local tab = "place"
local lastLocal = nil

function Build.init(screenGui)
	gui = screenGui
	UserInputService.InputBegan:Connect(function(input, processed)
		if not placing then
			return
		end
		if input.KeyCode == Enum.KeyCode.R then
			Build.rotate()
		elseif input.KeyCode == Enum.KeyCode.Q or input.UserInputType == Enum.UserInputType.MouseButton2 then
			Build.cancelPlacing()
		elseif not processed and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
			Build.confirm()
		end
	end)
end

function Build.isPlacing()
	return placing ~= nil
end

function Build.isOpen()
	return panel ~= nil
end

local function interior()
	local d = State.Data and State.Data.Derived
	return d and d.Interior and d.PropInside and d.Interior or nil
end

function Build.cancelPlacing()
	placing = nil
	if ghostConn then
		ghostConn:Disconnect()
		ghostConn = nil
	end
	if ghost then
		ghost:Destroy()
		ghost = nil
	end
end

function Build.rotate()
	if placing then
		placing.r = (placing.r + 90) % 360
	end
end

function Build.confirm()
	if not placing or not lastLocal then
		return
	end
	local p = placing
	local r = Net.call("Prop.Place", { uid = p.uid, x = lastLocal.X, z = lastLocal.Z, r = p.r }, { quietOk = false })
	if r.ok then
		Build.cancelPlacing()
	end
end

local function startPlacing(uid, def, r)
	Build.cancelPlacing()
	local info = interior()
	if not info then
		Notify.toast("Entra en tu propiedad para colocar muebles.", "warn")
		return
	end
	placing = { uid = uid, def = def, r = r or 0 }
	local f = def.Foot or { 4, 4, 3 }
	ghost = Instance.new("Part")
	ghost.Name = "BuildGhost"
	ghost.Anchored = true
	ghost.CanCollide = false
	ghost.CanQuery = false
	ghost.Transparency = 0.5
	ghost.Material = Enum.Material.ForceField
	ghost.Size = Vector3.new(f[1], math.max(0.4, f[3]), f[2])
	ghost.Parent = workspace.CurrentCamera
	local origin = Vector3.new(info.Origin[1], info.Origin[2], info.Origin[3])
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	ghostConn = RunService.RenderStepped:Connect(function()
		if not ghost then
			return
		end
		params.FilterDescendantsInstances = { player.Character, ghost }
		local mouse = UserInputService:GetMouseLocation()
		local ray = workspace.CurrentCamera:ViewportPointToRay(mouse.X, mouse.Y)
		local hit = workspace:Raycast(ray.Origin, ray.Direction * 300, params)
		if hit then
			local rel = hit.Position - origin
			local x = math.floor(rel.X * 2 + 0.5) / 2
			local z = math.floor(rel.Z * 2 + 0.5) / 2
			lastLocal = Vector3.new(x, 0, z)
			local w, d = f[1], f[2]
			if placing.r % 180 == 90 then
				w, d = d, w
			end
			local inside = math.abs(x) + w / 2 <= info.W / 2 - 0.5 and math.abs(z) + d / 2 <= info.D / 2 - 0.5
			ghost.Color = inside and Color3.fromRGB(80, 255, 120) or Color3.fromRGB(255, 70, 70)
			ghost.CFrame = CFrame.new(origin + Vector3.new(x, ghost.Size.Y / 2, z)) * CFrame.Angles(0, math.rad(placing.r), 0)
		end
	end)
	Notify.toast("Mueve el ratón (o toca el suelo) para colocar · R girar · Q o clic derecho cancelar", "info")
end

local function render()
	if not panel then
		return
	end
	UI.clear(panel)
	local data = State.Data
	local info = interior()
	if not info then
		UI.label(panel, "Entra en una de tus propiedades para construir.", { Color = T.Sub, Height = 40 })
		return
	end
	local l = PropertyData.ById[info.Id]
	local rec = data.Properties[info.Id]
	if not rec then
		return
	end
	UI.label(panel, "🔨 " .. l.Name, { Font = Enum.Font.GothamBlack, TextSize = 15, Height = 22 })
	UI.label(panel, "Decoración " .. tostring(data.Derived.DecorScore or 0) .. "/45 · muebles " .. State.count(rec.Placed) .. "/" .. l.Slots, { TextSize = 12, Color = T.Gold, Height = 18, Position = UDim2.fromOffset(0, 22) })
	local tabs = UI.row(panel, 30)
	tabs.Position = UDim2.fromOffset(0, 44)
	for _, t in ipairs({ { "place", "Colocar" }, { "placed", "Colocados" }, { "room", "Sala" }, { "designs", "Diseños" } }) do
		UI.button(tabs, t[2], function()
			tab = t[1]
			render()
		end, { Width = 80, Height = 26, TextSize = 12, Color = tab == t[1] and T.Accent or T.Panel3 })
	end
	local s = UI.scroll(panel, { Size = UDim2.new(1, 0, 1, -116), Position = UDim2.fromOffset(0, 78), Pad = 4 })
	if tab == "place" then
		local items = State.items(function(r, def)
			return def.Placeable and r.Loc == "home"
		end)
		if #items == 0 then
			UI.label(s, "No tienes muebles en casa. Cómpralos en Hogar & Deco (Barrio residencial) o en la Tienda online.", { Color = T.Sub, Height = 50 })
		end
		for _, it in ipairs(items) do
			local styleName = it.Def.Style and PropertyData.StyleById[it.Def.Style] and (" · " .. PropertyData.StyleById[it.Def.Style].Name) or ""
			UI.button(s, it.Def.Name .. " (+" .. (it.Def.Stats.Decor or 0) .. ")" .. styleName, function()
				startPlacing(it.Uid, it.Def, 0)
			end, { Size = UDim2.new(1, -8, 0, 30), TextSize = 12, Color = T.Panel2 })
		end
	elseif tab == "placed" then
		for uid, pos in pairs(rec.Placed) do
			local item = data.Inventory[uid]
			local def = item and Catalog.get(item.Id)
			if def then
				local card = UI.card(s, { Height = 0, Auto = Enum.AutomaticSize.Y })
				UI.label(card, def.Name .. " · (" .. pos.X .. ", " .. pos.Z .. ") · " .. pos.R .. "°", { TextSize = 12 })
				local row = UI.row(card, 28, nil, 4)
				UI.button(row, "Mover", function()
					startPlacing(uid, def, pos.R)
				end, { Width = 70, Height = 24, TextSize = 11 })
				UI.button(row, "Girar", function()
					Net.call("Prop.Rotate", { uid = uid }, { quietOk = true })
				end, { Width = 60, Height = 24, TextSize = 11 })
				UI.button(row, "Recoger", function()
					Net.call("Prop.Pick", { uid = uid })
				end, { Width = 80, Height = 24, TextSize = 11, Color = Color3.fromRGB(110, 40, 40) })
			end
		end
	elseif tab == "room" then
		UI.label(s, l.Remodel and "Cada cambio cuesta $50 (estilo completo $120)." or "Propiedad no remodelable: solo luz y cortinas.", { TextSize = 12, Color = T.Sub, Height = 30 })
		local names = {}
		for i, st in ipairs(PropertyData.Styles) do
			names[i] = st.Name
		end
		local styleIdx = 1
		UI.cycle(s, "Estilo", names, 1, function(i)
			styleIdx = i
		end, { LabelWidth = 60, ValueWidth = 130 })
		UI.button(s, "Aplicar estilo", function()
			Net.call("Prop.Decor", { style = PropertyData.Styles[styleIdx].Id })
		end, { Width = 160, Height = 28 })
		local function paletteRow(label, list, key, current)
			UI.label(s, label, { TextSize = 12, Color = T.Sub })
			local grid = UI.frame(s, { Height = 0, Auto = Enum.AutomaticSize.Y, Transparency = 1, Radius = false })
			UI.grid(grid, 26, 26, 4)
			for i, entry in ipairs(list) do
				local color = entry[3] and type(entry[3]) == "table" and entry[3] or entry[2]
				UI.button(grid, current == i and "●" or "", function()
					Net.call("Prop.Decor", { [key] = i })
				end, { Size = UDim2.fromOffset(26, 26), Color = UI.rgb(color), TextColor = Color3.new(0.5, 0.5, 0.5) })
			end
		end
		paletteRow("Paredes", PropertyData.Walls, "wall", rec.Decor.Wall)
		paletteRow("Suelo", PropertyData.Floors, "floor", rec.Decor.Floor)
		paletteRow("Iluminación", PropertyData.Lights, "light", rec.Decor.Light)
		UI.toggle(s, "Cortinas", rec.Decor.Curtain, function(v)
			Net.call("Prop.Decor", { curtain = v })
		end, { Width = 200 })
	elseif tab == "designs" then
		local nb = UI.input(s, "Nombre del diseño", "")
		UI.button(s, "💾 Guardar diseño actual", function()
			Net.call("Prop.SavePreset", { name = nb.Text })
		end, { Width = 220, Height = 28 })
		for i, preset in ipairs(rec.Presets) do
			local row = UI.row(s, 30)
			UI.label(row, preset.Name .. " (" .. State.count(preset.Layout) .. " muebles)", { Size = UDim2.fromOffset(180, 26), TextSize = 12 })
			UI.button(row, "Aplicar", function()
				Net.call("Prop.LoadPreset", { index = i })
			end, { Width = 80, Height = 26, TextSize = 12 })
		end
	end
	local bottom = UI.row(panel, 32)
	bottom.Position = UDim2.new(0, 0, 1, -34)
	UI.button(bottom, "↻ Girar (R)", function()
		Build.rotate()
	end, { Width = 100, Height = 28, TextSize = 12 })
	UI.button(bottom, "✕ Cerrar (B)", function()
		Build.toggle()
	end, { Width = 110, Height = 28, TextSize = 12 })
end

function Build.toggle()
	if panel then
		Build.cancelPlacing()
		panel:Destroy()
		panel = nil
		return
	end
	if not interior() then
		Notify.toast("Entra en una de tus propiedades para usar el modo construcción.", "warn")
		return
	end
	panel = UI.frame(gui, { Size = UDim2.fromOffset(360, 470), Position = UDim2.new(0, 12, 0.5, 20), Anchor = Vector2.new(0, 0.5), Color = T.Panel, Name = "BuildPanel" })
	UI.padding(panel, 10)
	render()
end

State.on(function()
	if panel then
		if not interior() then
			Build.toggle()
		else
			render()
		end
	end
end)

return Build
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000061"><Properties><string name="Name">CaptureUI</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- CaptureUI (cliente): sesión de grabación por escenas y modo fotógrafo profesional.
-- El cliente solo elige la toma/encuadre; la calidad la calcula el servidor con el equipo real.

local Players = game:GetService("Players")
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local UI = require(script.Parent.UIKit)
local State = require(script.Parent.State)
local Net = require(script.Parent.Net)
local Notify = require(script.Parent.Notify)
local VideoData = require(Shared.VideoData)
local Catalog = require(Shared.ItemCatalog)
local Util = require(Shared.Util)
local T = UI.Theme

local Capture = {}
local player = Players.LocalPlayer
local gui
local recFrame, photoFrame, pickFrame
local sound
local colorFx

function Capture.init(screenGui, snd)
	gui = screenGui
	sound = snd
end

-- Productos disponibles para planos de producto: los tuyos en la mochila + expuestos en la tienda donde estás
local function productOptions()
	local opts = { { Name = "Sin producto" } }
	for _, it in ipairs(State.items(function(rec, def)
		return (rec.Loc == "backpack" or (State.Data.Derived.AtHome and rec.Loc == "home")) and def.Cat ~= "component" and def.Slot ~= "battery" and def.Slot ~= "bag"
	end)) do
		opts[#opts + 1] = { Name = "📦 " .. it.Def.Name .. " (tuyo)", Uid = it.Uid }
	end
	local store = player:GetAttribute("InStore")
	if store then
		for _, def in ipairs(Catalog.list({ Store = store })) do
			if #opts < 40 then
				opts[#opts + 1] = { Name = "🏬 " .. def.Name .. " (exposición)", StoreItem = def.Id }
			end
		end
	end
	return opts
end

---------------------------------------------------------------------------
-- Grabación
---------------------------------------------------------------------------
local function closeRec()
	if recFrame then
		recFrame:Destroy()
		recFrame = nil
	end
end

local function showRecorder(info, pid)
	closeRec()
	local proj = State.Data.Projects[pid]
	recFrame = UI.frame(gui, { Size = UDim2.fromOffset(560, 0), Auto = Enum.AutomaticSize.Y, Position = UDim2.new(0.5, 0, 0, 66), Anchor = Vector2.new(0.5, 0), Color = T.Panel, Transparency = 0.05, Name = "Recorder" })
	UI.stroke(recFrame, T.Accent, 2)
	UI.padding(recFrame, 10)
	UI.list(recFrame, Enum.FillDirection.Vertical, 6)
	local head = UI.label(recFrame, "", { Font = Enum.Font.GothamBlack, TextSize = 15, Color = T.Accent })
	local sub = UI.label(recFrame, "", { TextSize = 12, Color = T.Sub })
	local spotL = UI.label(recFrame, "", { TextSize = 13 })
	local productIdx = 1
	local options = productOptions()
	local names = {}
	for i, o in ipairs(options) do
		names[i] = o.Name
	end
	UI.cycle(recFrame, "Producto", names, 1, function(i)
		productIdx = i
	end, { ValueWidth = 300, LabelWidth = 70 })
	local grid = UI.frame(recFrame, { Height = 0, Auto = Enum.AutomaticSize.Y, Transparency = 1, Radius = false })
	UI.grid(grid, 128, 40, 6)
	local result = UI.label(recFrame, "Elige una toma para grabar una escena.", { TextSize = 12, Height = 34, Color = T.Sub })
	for _, shot in ipairs(VideoData.Shots) do
		local missing = (shot.NeedsTripod and not info.tripod) or (shot.NeedsDrone and not info.drone)
		UI.button(grid, shot.Name .. (missing and " 🔒" or ""), function()
			local o = options[productIdx]
			local r = Net.call("Video.RecordScene", { shot = shot.Id, featuredUid = o.Uid, featuredStoreItem = o.StoreItem }, { quietOk = true })
			if r.ok then
				if sound then
					sound.play("Shutter")
				end
				local sc = r.data.scene
				info.charge = r.data.charge
				result.Text = "✅ " .. shot.Name .. " · calidad " .. math.floor(sc.Q) .. " (imagen " .. math.floor(sc.Img) .. ", audio " .. math.floor(sc.Aud) .. ", luz " .. math.floor(sc.Light) .. ", interés " .. math.floor(sc.Int) .. ")" .. (#sc.Probs > 0 and ("\n⚠ " .. table.concat(sc.Probs, ", ")) or "")
				result.TextColor3 = #sc.Probs > 0 and T.Warn or T.Ok
			end
		end, { Size = UDim2.fromOffset(128, 40), TextSize = 11, Color = missing and T.Panel2 or Color3.fromRGB(120, 30, 45) })
	end
	local row = UI.row(recFrame, 34)
	UI.button(row, "⏹ Detener grabación", function()
		Net.call("Video.StopRecording", {})
		closeRec()
	end, { Width = 180, Color = T.Panel3 })
	task.spawn(function()
		local blink = true
		while recFrame and head.Parent do
			local p = State.Data and State.Data.Projects[pid]
			blink = not blink
			head.Text = (blink and "● " or "○ ") .. "REC · " .. (p and p.Name or "?") .. " · " .. (p and #p.Scenes or 0) .. " escenas"
			sub.Text = "🎥 " .. info.device .. " · 🔋 " .. math.floor(info.charge or 100) .. "% · 🎙 " .. info.mic .. (info.tripod and " · trípode" or "") .. (info.gimbal and " · estabilizador" or "") .. (info.light and " · luz" or "")
			local spot = player:GetAttribute("Spot")
			spotL.Text = spot and ("📍 Lugar: " .. spot) or "⚠ No estás en un lugar de grabación (busca 🎥, una tienda o tu casa)"
			spotL.TextColor3 = spot and T.Text or T.Warn
			task.wait(0.5)
		end
	end)
end

local function closePick()
	if pickFrame then
		pickFrame:Destroy()
		pickFrame = nil
	end
end

function Capture.toggleRecord(openIdeas)
	if recFrame then
		Net.call("Video.StopRecording", {})
		closeRec()
		return
	end
	if pickFrame then
		closePick()
		return
	end
	local data = State.Data
	if not data then
		return
	end
	pickFrame = UI.frame(gui, { Size = UDim2.fromOffset(440, 0), Auto = Enum.AutomaticSize.Y, Position = UDim2.fromScale(0.5, 0.45), Anchor = Vector2.new(0.5, 0.5), Color = T.Panel, Name = "RecordPicker" })
	UI.padding(pickFrame, 12)
	UI.list(pickFrame, Enum.FillDirection.Vertical, 6)
	UI.label(pickFrame, "🎬 ¿Qué proyecto vas a grabar?", { Font = Enum.Font.GothamBlack, TextSize = 16 })
	local usePhone = false
	UI.toggle(pickFrame, "Grabar con el teléfono (si no, la mejor cámara de la mochila)", false, function(v)
		usePhone = v
	end, { Width = 400 })
	local any = false
	for pid, p in pairs(data.Projects) do
		any = true
		UI.button(pickFrame, p.Name .. " · " .. (VideoData.CategoryById[p.Category] or {}).Name .. " · " .. #p.Scenes .. " escenas", function()
			local r = Net.call("Video.StartRecording", { pid = pid, usePhone = usePhone }, { quietOk = true })
			closePick()
			if r.ok then
				showRecorder(r.data, pid)
			end
		end, { Size = UDim2.new(1, 0, 0, 34), TextSize = 12, Color = T.Panel2 })
	end
	if not any then
		UI.label(pickFrame, "No tienes proyectos. Crea una idea primero.", { Color = T.Sub })
	end
	local row = UI.row(pickFrame, 34)
	UI.button(row, "💡 Nueva idea", function()
		closePick()
		openIdeas()
	end, { Width = 140, Color = T.Accent2 })
	UI.button(row, "Cancelar", closePick, { Width = 100 })
end

---------------------------------------------------------------------------
-- Modo fotógrafo
---------------------------------------------------------------------------
local framings = { { "Centrado", 5 }, { "Regla de tercios", 8 }, { "Contrapicado", 7 }, { "Picado", 6 }, { "Ángulo holandés", 4 }, { "Simétrico", 7 } }

function Capture.togglePhoto()
	if photoFrame then
		photoFrame:Destroy()
		photoFrame = nil
		if colorFx then
			colorFx:Destroy()
			colorFx = nil
		end
		workspace.CurrentCamera.FieldOfView = 70
		return
	end
	local camera = workspace.CurrentCamera
	local modeIdx, framingIdx, filterIdx, productIdx = 1, 2, 1, 1
	local fov = 70
	colorFx = Instance.new("ColorCorrectionEffect")
	colorFx.Name = "PhotoFilter"
	colorFx.Parent = Lighting
	local function applyFilter()
		if not colorFx then
			return
		end
		local f = filterIdx
		colorFx.Saturation = (f == 2 and 0.4) or (f == 5 and -1) or (f == 6 and -0.4) or 0
		colorFx.Contrast = (f == 7 and 0.25) or (f == 2 and 0.1) or 0
		colorFx.TintColor = (f == 3 and Color3.fromRGB(255, 225, 190)) or (f == 4 and Color3.fromRGB(200, 225, 255)) or (f == 6 and Color3.fromRGB(255, 235, 200)) or Color3.new(1, 1, 1)
	end
	photoFrame = UI.frame(gui, { Size = UDim2.fromScale(1, 1), Transparency = 1, Radius = false, Name = "PhotoMode" })
	-- Cuadrícula de tercios
	for i = 1, 2 do
		local v = UI.frame(photoFrame, { Size = UDim2.new(0, 1, 1, 0), Position = UDim2.fromScale(i / 3, 0), Color = Color3.new(1, 1, 1), Transparency = 0.6, Radius = false })
		local h = UI.frame(photoFrame, { Size = UDim2.new(1, 0, 0, 1), Position = UDim2.fromScale(0, i / 3), Color = Color3.new(1, 1, 1), Transparency = 0.6, Radius = false })
		v.Active = false
		h.Active = false
	end
	local panel = UI.frame(photoFrame, { Size = UDim2.fromOffset(620, 0), Auto = Enum.AutomaticSize.Y, Position = UDim2.new(0.5, 0, 1, -90), Anchor = Vector2.new(0.5, 1), Color = T.Panel, Transparency = 0.1 })
	UI.padding(panel, 10)
	UI.list(panel, Enum.FillDirection.Vertical, 4)
	UI.label(panel, "📸 Modo fotógrafo · mueve la cámara con el ratón/dedo y dispara", { Font = Enum.Font.GothamBold, TextSize = 13 })
	local modeNames = {}
	for i, m in ipairs(VideoData.PhotoModes) do
		modeNames[i] = m.Name
	end
	UI.cycle(panel, "Tipo", modeNames, modeIdx, function(i)
		modeIdx = i
	end, { ValueWidth = 220 })
	local frNames = {}
	for i, f in ipairs(framings) do
		frNames[i] = f[1]
	end
	UI.cycle(panel, "Encuadre", frNames, framingIdx, function(i)
		framingIdx = i
	end, { ValueWidth = 220 })
	UI.cycle(panel, "Filtro", VideoData.PhotoFilters, filterIdx, function(i)
		filterIdx = i
		applyFilter()
	end, { ValueWidth = 220 })
	UI.stepper(panel, "Zoom (FOV)", fov, 20, 100, 5, function(v)
		fov = v
		camera.FieldOfView = v
	end)
	local options = productOptions()
	local pNames = {}
	for i, o in ipairs(options) do
		pNames[i] = o.Name
	end
	UI.cycle(panel, "Producto", pNames, 1, function(i)
		productIdx = i
	end, { ValueWidth = 300 })
	local row = UI.row(panel, 40)
	local flash = UI.frame(photoFrame, { Size = UDim2.fromScale(1, 1), Color = Color3.new(1, 1, 1), Transparency = 1, Radius = false })
	flash.ZIndex = 50
	UI.button(row, "📸 Disparar", function()
		local cf = camera.CFrame
		local look = cf.Position + cf.LookVector * 20
		local o = options[productIdx]
		local r = Net.call("Photo.Take", {
			mode = VideoData.PhotoModes[modeIdx].Id,
			composition = framings[framingIdx][2],
			filter = filterIdx,
			cam = { cf.Position.X, cf.Position.Y, cf.Position.Z, look.X, look.Y, look.Z },
			fov = fov,
			featuredUid = o.Uid,
			featuredStoreItem = o.StoreItem,
		})
		if r.ok and sound then
			sound.play("Shutter")
			flash.BackgroundTransparency = 0.1
			UI.tween(flash, { BackgroundTransparency = 1 }, 0.4)
		end
	end, { Width = 160, Height = 36, Color = T.Accent })
	UI.button(row, "✕ Salir (F)", function()
		Capture.togglePhoto()
	end, { Width = 120, Height = 36 })
	applyFilter()
end

function Capture.isRecording()
	return recFrame ~= nil
end

return Capture
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000062"><Properties><string name="Name">HUD</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- HUD (cliente): dinero, nivel/XP, rango, suscriptores, reloj, clima, ubicación, objetivo actual y botones
-- de acción (adaptados a PC y móvil).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local UI = require(script.Parent.UIKit)
local State = require(script.Parent.State)
local Net = require(script.Parent.Net)
local QuestDefs = require(Shared.QuestDefs)
local Util = require(Shared.Util)
local T = UI.Theme

local HUD = {}
local player = Players.LocalPlayer
local refs = {}

local weatherIcon = { Clear = "☀️", Cloudy = "☁️", Rain = "🌧", Fog = "🌫", Storm = "⛈" }
local weatherName = { Clear = "Despejado", Cloudy = "Nublado", Rain = "Lluvia", Fog = "Niebla", Storm = "Tormenta" }

function HUD.build(gui, actions)
	-- Panel superior izquierdo: canal, nivel y rango
	local left = UI.frame(gui, { Size = UDim2.fromOffset(300, 92), Position = UDim2.fromOffset(12, 12), Color = T.Panel, Transparency = 0.1, Name = "HudLeft" })
	UI.padding(left, 8)
	refs.channel = UI.label(left, "Cargando...", { Font = Enum.Font.GothamBlack, TextSize = 15, Height = 20 })
	refs.rank = UI.label(left, "", { Position = UDim2.fromOffset(0, 20), TextSize = 12, Color = T.Gold, Height = 16 })
	local xpBg, xpFill = UI.progress(left, 0, T.Accent2, { Size = UDim2.new(1, 0, 0, 8) })
	xpBg.Position = UDim2.fromOffset(0, 40)
	refs.xpFill = xpFill
	refs.level = UI.label(left, "", { Position = UDim2.fromOffset(0, 48), TextSize = 11, Color = T.Sub, Height = 14 })
	local enBg, enFill = UI.progress(left, 1, T.Ok, { Size = UDim2.new(0.48, 0, 0, 6) })
	enBg.Position = UDim2.fromOffset(0, 66)
	refs.energy = enFill
	local moBg, moFill = UI.progress(left, 0.7, T.Gold, { Size = UDim2.new(0.48, 0, 0, 6) })
	moBg.Position = UDim2.new(0.52, 0, 0, 66)
	refs.mood = moFill

	-- Panel superior central: dinero y suscriptores
	local mid = UI.frame(gui, { Size = UDim2.fromOffset(340, 44), Position = UDim2.new(0.5, 0, 0, 12), Anchor = Vector2.new(0.5, 0), Color = T.Panel, Transparency = 0.1, Name = "HudMid" })
	refs.money = UI.label(mid, "$0", { Size = UDim2.new(0.5, 0, 1, 0), Font = Enum.Font.GothamBlack, TextSize = 20, Color = T.Ok, Align = Enum.TextXAlignment.Center })
	refs.subs = UI.label(mid, "0 subs", { Size = UDim2.new(0.5, 0, 1, 0), Position = UDim2.fromScale(0.5, 0), Font = Enum.Font.GothamBold, TextSize = 16, Color = T.Accent, Align = Enum.TextXAlignment.Center })

	-- Panel superior derecho: hora, clima, ubicación
	local right = UI.frame(gui, { Size = UDim2.fromOffset(260, 60), Position = UDim2.new(1, -12, 0, 12), Anchor = Vector2.new(1, 0), Color = T.Panel, Transparency = 0.1, Name = "HudRight" })
	UI.padding(right, 8)
	refs.clock = UI.label(right, "", { Font = Enum.Font.GothamBold, TextSize = 14, Height = 20, Align = Enum.TextXAlignment.Right })
	refs.place = UI.label(right, "", { Position = UDim2.fromOffset(0, 22), TextSize = 12, Color = T.Sub, Height = 20, Align = Enum.TextXAlignment.Right })
	refs.busy = UI.label(right, "⏳", { Size = UDim2.fromOffset(20, 20), Position = UDim2.fromOffset(-4, -4), TextSize = 14 })
	refs.busy.Visible = false
	Net.OnBusy = function(b)
		refs.busy.Visible = b
	end

	-- Objetivo actual (tutorial)
	local obj = UI.frame(gui, { Size = UDim2.fromOffset(300, 0), Auto = Enum.AutomaticSize.Y, Position = UDim2.fromOffset(12, 114), Color = Color3.fromRGB(30, 40, 70), Transparency = 0.1, Name = "Objective" })
	UI.padding(obj, 8)
	UI.list(obj, Enum.FillDirection.Vertical, 4)
	refs.objTitle = UI.label(obj, "", { Font = Enum.Font.GothamBold, TextSize = 13, Auto = Enum.AutomaticSize.Y, Height = 0 })
	refs.objHint = UI.label(obj, "", { TextSize = 12, Color = Color3.fromRGB(210, 215, 235), Auto = Enum.AutomaticSize.Y, Height = 0 })
	refs.obj = obj

	-- Botones de acción
	local bar = UI.frame(gui, { Size = UDim2.fromOffset(0, 64), Auto = Enum.AutomaticSize.X, Position = UDim2.new(0.5, 0, 1, -12), Anchor = Vector2.new(0.5, 1), Color = T.Panel, Transparency = 0.15, Name = "ActionBar" })
	UI.padding(bar, 6)
	UI.list(bar, Enum.FillDirection.Horizontal, 6)
	local function action(icon, label, key, fn, color)
		local b = UI.button(bar, icon .. "\n" .. label .. (key and (" (" .. key .. ")") or ""), fn, { Width = 78, Height = 52, TextSize = 11, Color = color or T.Panel3 })
		return b
	end
	action("📱", "Teléfono", "P", actions.phone)
	action("🎒", "Inventario", "I", actions.inventory)
	refs.missionsBtn = action("🏆", "Misiones", "M", actions.missions)
	refs.recBtn = action("🎬", "Grabar", "R", actions.record, Color3.fromRGB(150, 30, 50))
	action("📸", "Foto", "F", actions.photo)
	action("👕", "Estilo", "V", actions.style)
	refs.laptopBtn = action("💻", "Portátil", "C", actions.laptop)
	refs.buildBtn = action("🔨", "Construir", "B", actions.build, Color3.fromRGB(40, 110, 70))
	action("🏘", "Inmobiliaria", nil, actions.realty)
	action("⚙", "Ajustes", nil, actions.settings)

	HUD.refresh()
	State.on(HUD.refresh)
	task.spawn(function()
		while true do
			local h = workspace:GetAttribute("GameHour") or 12
			local w = workspace:GetAttribute("Weather") or "Clear"
			refs.clock.Text = string.format("%s %02d:%02d · %s · Día %d", weatherIcon[w] or "", math.floor(h), math.floor((h % 1) * 60), workspace:GetAttribute("TimeLabel") or "", workspace:GetAttribute("GameDay") or 1)
			local spot = player:GetAttribute("Spot")
			refs.place.Text = "📍 " .. tostring(player:GetAttribute("District") or "...") .. (spot and ("  ·  🎥 " .. spot) or "") .. "  ·  " .. (weatherName[w] or "")
			task.wait(0.5)
		end
	end)
end

function HUD.refresh()
	local data = State.Data
	if not data or not refs.money then
		return
	end
	local d = data.Derived
	local name = data.Channel.Name ~= "" and data.Channel.Name or player.DisplayName
	refs.channel.Text = "🎬 " .. name
	refs.rank.Text = d.RankName .. (data.EquippedTitle ~= "" and (" · «" .. data.EquippedTitle .. "»") or "")
	refs.xpFill.Size = UDim2.new(math.clamp(data.XP / d.XpNext, 0, 1), 0, 1, 0)
	refs.level.Text = "Nivel " .. data.Level .. " · " .. data.XP .. "/" .. d.XpNext .. " XP · Reputación " .. data.Reputation
	refs.money.Text = "$" .. Util.formatInt(data.Money)
	local n = data.Needs or { Energy = 100, Mood = 70 }
	refs.energy.Size = UDim2.new(n.Energy / 100, 0, 1, 0)
	refs.energy.BackgroundColor3 = n.Energy < 25 and T.Err or T.Ok
	refs.mood.Size = UDim2.new(n.Mood / 100, 0, 1, 0)
	refs.subs.Text = "👥 " .. Util.formatShort(data.Channel.Subs) .. " subs"
	-- Objetivo
	local q = data.Quests
	local step = QuestDefs.Tutorial[q.Step]
	if step and not q.Skipped then
		refs.obj.Visible = true
		refs.objTitle.Text = "🎯 " .. q.Step .. "/" .. #QuestDefs.Tutorial .. " " .. step.Name .. ((step.Target or 1) > 1 and (" (" .. q.StepProgress .. "/" .. step.Target .. ")") or "")
		refs.objHint.Text = data.Settings.Hints ~= false and step.Hint or ""
		refs.objHint.Visible = data.Settings.Hints ~= false
	else
		refs.obj.Visible = false
	end
	local pending = 0
	for id in pairs(q.Completed) do
		if not q.Claimed[id] then
			pending = pending + 1
		end
	end
	refs.missionsBtn.Text = "🏆\nMisiones (M)" .. (pending > 0 and (" 🎁" .. pending) or "")
	refs.recBtn.Text = d.Recording and "⏹\nGrabando (R)" or "🎬\nGrabar (R)"
	local hasLaptop = false
	for _, rec in pairs(data.Inventory) do
		if rec.Id:sub(1, 4) == "lap_" then
			hasLaptop = true
		end
	end
	refs.laptopBtn.Visible = hasLaptop
	refs.buildBtn.Visible = d.PropInside ~= nil
end

-- Texto flotante de dinero ganado
function HUD.cash(amount)
	if not refs.money then
		return
	end
	local l = UI.label(refs.money.Parent, (amount >= 0 and "+$" or "-$") .. Util.formatInt(math.abs(amount)), { Size = UDim2.new(0.5, 0, 0, 20), Position = UDim2.new(0, 0, 1, 0), Font = Enum.Font.GothamBlack, TextSize = 16, Color = T.Ok, Align = Enum.TextXAlignment.Center })
	UI.tween(l, { Position = UDim2.new(0, 0, 1, 26), TextTransparency = 1 }, 1.4)
	task.delay(1.5, function()
		l:Destroy()
	end)
end

return HUD
]]></ProtectedString></Properties></Item><Item class="LocalScript" referent="RBX000063"><Properties><string name="Name">Main</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Main (LocalScript): crea la interfaz, conecta los mensajes del servidor y los controles (PC y móvil).

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local StarterGui = game:GetService("StarterGui")

local Client = script.Parent
local UI = require(Client.UIKit)
local Net = require(Client.Net)
local State = require(Client.State)
local Sound = require(Client.Sound)
local Notify = require(Client.Notify)
local Actions = require(Client.Actions)
local Shell = require(Client.Shell)
local HUD = require(Client.HUD)
local Capture = require(Client.CaptureUI)
local WorldFX = require(Client.WorldFX)
local Build = require(Client.BuildUI)
local T = UI.Theme

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

pcall(function()
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
end)

local gui = Instance.new("ScreenGui")
gui.Name = "YoutuberLifeUI"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
gui.Parent = playerGui

UI.Sound = Sound
Net.Notify = Notify
Notify.init(gui, Sound)
Shell.init(gui)
Capture.init(gui, Sound)
Build.init(gui)
UI.attachScale(gui, function()
	return State.Data and State.Data.Settings.UIScale or 1
end)

-- Acciones globales
Actions.photoMode = function()
	Shell.close()
	Capture.togglePhoto()
end
Actions.record = function()
	Capture.toggleRecord(function()
		Shell.openApp("ideas")
	end)
end
Actions.openStyle = function()
	Shell.openPanel("style")
end

local function toggleApp(appId)
	if Shell.surface() == "panel" then
		Shell.close()
		return
	end
	if Shell.surface() == "pc" then
		Shell.openApp(appId)
	else
		Shell.openPanel(appId)
	end
end

HUD.build(gui, {
	phone = function()
		Shell.togglePhone()
	end,
	inventory = function()
		toggleApp("inventory")
	end,
	missions = function()
		toggleApp("missions")
	end,
	record = Actions.record,
	photo = Actions.photoMode,
	style = Actions.openStyle,
	laptop = function()
		Net.call("PC.OpenLaptop", {}, { quietOk = true })
	end,
	settings = function()
		toggleApp("settings")
	end,
	build = function()
		Build.toggle()
	end,
	realty = function()
		toggleApp("realty")
	end,
})
WorldFX.start()

---------------------------------------------------------------------------
-- Mensajes del servidor
---------------------------------------------------------------------------
local lastSettings
Net.on("profile", function(data)
	State.set(data)
	local st = data.Settings
	local key = st.Sfx .. ":" .. st.Music .. ":" .. tostring(st.ReduceMotion)
	if key ~= lastSettings then
		lastSettings = key
		Sound.setVolumes(st.Sfx, st.Music)
		UI.ReduceMotion = st.ReduceMotion
	end
end)
local liveFrame
local function liveOverlay(d)
	State.setLive(d)
	if d.kind == "end" then
		if liveFrame then
			liveFrame:Destroy()
			liveFrame = nil
		end
		Notify.banner("🔴 Directo terminado", "Pico " .. d.peak .. " · $" .. (d.total or 0) .. " ganados · +" .. d.subs .. " subs", T.Accent)
		return
	end
	if not liveFrame then
		liveFrame = UI.frame(gui, { Size = UDim2.fromOffset(380, 0), Auto = Enum.AutomaticSize.Y, Position = UDim2.new(1, -12, 0, 84), Anchor = Vector2.new(1, 0), Color = T.Panel, Name = "LiveOverlay" })
		UI.stroke(liveFrame, T.Accent, 2)
		UI.padding(liveFrame, 8)
		UI.list(liveFrame, Enum.FillDirection.Vertical, 4)
	end
	UI.clear(liveFrame)
	UI.label(liveFrame, "🔴 EN DIRECTO · 👀 " .. d.viewers .. " · 💸 $" .. d.donations .. " · +" .. d.subs .. " subs · " .. d.left .. " s", { Font = Enum.Font.GothamBold, TextSize = 13 })
	if d.donation then
		Notify.toast("💸 Donación de $" .. d.donation .. " en el directo", "gold")
	end
	if d.question then
		UI.label(liveFrame, "💬 " .. d.question, { TextSize = 13, Color = T.Gold, Height = 0, Auto = Enum.AutomaticSize.Y })
		for i, a in ipairs(d.answers) do
			UI.button(liveFrame, a, function()
				Net.call("Live.Answer", { choice = i })
				for _, c in ipairs(liveFrame:GetChildren()) do
					if c:IsA("TextButton") then
						c:Destroy()
					end
				end
			end, { Size = UDim2.new(1, 0, 0, 30), TextSize = 12, Color = T.Panel2 })
		end
	end
end
Net.on("live", liveOverlay)

Net.on("notify", function(d)
	Notify.toast(d.text, d.style)
end)
Net.on("cash", function(d)
	HUD.cash(d.amount)
	if d.amount >= 5 then
		Sound.play("Cash")
	end
end)
Net.on("openUI", function(d)
	if d.ui == "style" then
		Shell.openPanel("style")
	elseif d.ui == "store" then
		Shell.openPanel("shop", { store = d.store })
	elseif d.ui == "product" then
		Shell.openPanel("product", { item = d.item, store = d.store })
	elseif d.ui == "app" then
		Shell.openPanel(d.app)
	elseif d.ui == "food" then
		Shell.openPanel("food", { tab = d.tab, place = d.place })
	elseif d.ui == "realty" then
		Shell.openPanel("realty", { listing = d.listing })
	end
end)
Net.on("openComputer", function(d)
	Shell.openComputer(d.stats)
end)
Net.on("closeComputer", function()
	if Shell.surface() == "pc" then
		Shell.close()
		Notify.toast("Te alejaste del computador.", "info")
	end
end)
Net.on("achievement", function(d)
	Notify.banner("🏆 ¡Logro completado!", d.name .. " · cóbralo en Misiones (M)", T.Gold)
end)
Net.on("levelUp", function(d)
	Notify.banner("⬆ ¡Nivel " .. d.level .. "!", "Nuevos productos y oportunidades desbloqueados", T.Accent2)
end)
Net.on("rankUp", function(d)
	Notify.banner("🎖 Nuevo rango: " .. d.name, "Desbloqueado: " .. tostring(d.unlock), T.Gold)
end)
Net.on("tutorial", function(d)
	if d.finished then
		Notify.banner("🎓 ¡Tutorial completado!", "Ahora elige tu propio camino", T.Ok)
	else
		Notify.toast("✅ " .. d.done .. (d.next and (" → Siguiente: " .. d.next) or ""), "success")
	end
end)
Net.on("secret", function(d)
	Notify.banner("✨ Lugar secreto: " .. d.name, "+$" .. d.reward .. " · ahora puedes grabar aquí", T.Gold)
end)
Net.on("dialog", function(d)
	Notify.dialog(d.name, d.text, d.options, function(opt)
		if opt.ui == "store" then
			Shell.openPanel("shop", { store = opt.store })
		elseif opt.ui == "app" then
			Shell.openPanel(opt.app)
		end
	end)
end)
Net.on("travelFade", function()
	local f = UI.frame(gui, { Size = UDim2.fromScale(1, 1), Color = Color3.new(0, 0, 0), Transparency = 1, Radius = false })
	f.ZIndex = 100
	UI.label(f, "🚕 Viajando...", { Size = UDim2.fromScale(1, 1), Align = Enum.TextXAlignment.Center, TextSize = 28, Font = Enum.Font.GothamBlack })
	UI.tween(f, { BackgroundTransparency = 0 }, 0.3)
	task.wait(0.9)
	UI.tween(f, { BackgroundTransparency = 1 }, 0.4)
	for _, c in ipairs(f:GetChildren()) do
		if c:IsA("TextLabel") then
			UI.tween(c, { TextTransparency = 1 }, 0.4)
		end
	end
	task.wait(0.45)
	f:Destroy()
end)

---------------------------------------------------------------------------
-- Menú principal (al entrar)
---------------------------------------------------------------------------
local function mainMenu(isNew)
	local overlay = UI.frame(gui, { Size = UDim2.fromScale(1, 1), Color = Color3.fromRGB(8, 8, 14), Transparency = 0.15, Radius = false, Name = "MainMenu" })
	overlay.ZIndex = 90
	UI.new("UIGradient", { Color = ColorSequence.new(Color3.fromRGB(60, 10, 40), Color3.fromRGB(10, 20, 60)), Rotation = 30, Parent = overlay })
	local box = UI.frame(overlay, { Size = UDim2.fromOffset(560, 420), Position = UDim2.fromScale(0.5, 0.5), Anchor = Vector2.new(0.5, 0.5), Transparency = 1, Radius = false })
	UI.label(box, "▶ YOUTUBER LIFE", { Size = UDim2.new(1, 0, 0, 60), Font = Enum.Font.GothamBlack, TextSize = 46, Align = Enum.TextXAlignment.Center, Color = T.Accent })
	UI.label(box, "REAL WORLD ULTIMATE", { Size = UDim2.new(1, 0, 0, 30), Position = UDim2.fromOffset(0, 58), Font = Enum.Font.GothamBold, TextSize = 22, Align = Enum.TextXAlignment.Center })
	UI.label(box, "Vive, explora, compra, graba, edita y publica. 30 distritos, cientos de productos y tu propio canal.", { Size = UDim2.new(1, 0, 0, 44), Position = UDim2.fromOffset(0, 96), TextSize = 15, Align = Enum.TextXAlignment.Center, Color = T.Sub })
	local function close()
		UI.tween(overlay, { BackgroundTransparency = 1 }, 0.3)
		task.wait(0.3)
		overlay:Destroy()
	end
	UI.button(box, "▶ JUGAR", function()
		close()
		if isNew then
			Notify.banner("¡Bienvenido a la ciudad!", "Sigue el objetivo de la izquierda: te guiará paso a paso", T.Accent2)
		end
	end, { Size = UDim2.fromOffset(300, 56), Position = UDim2.fromOffset(130, 160), Color = T.Accent, TextSize = 22 })
	UI.button(box, "⚙ Ajustes", function()
		close()
		Shell.openPanel("settings")
	end, { Size = UDim2.fromOffset(300, 44), Position = UDim2.fromOffset(130, 228) })
	UI.button(box, "❓ Cómo jugar", function()
		Notify.confirm("1) Elige una idea en el computador o teléfono.\n2) Prepara la mochila en casa y viaja a un lugar 🎥.\n3) Graba escenas (R) y fotos (F).\n4) Vuelve a casa: importa, edita, exporta.\n5) Diseña una miniatura y publica en ViewTube Studio.\nCompra mejor equipo, trabaja, explora y descubre secretos.", function() end, "¡Entendido!")
	end, { Size = UDim2.fromOffset(300, 44), Position = UDim2.fromOffset(130, 284) })
	UI.label(box, "Teclas: P teléfono · I inventario · M misiones · R grabar · F foto · V estilo · C portátil · Shift correr", { Size = UDim2.new(1, 0, 0, 40), Position = UDim2.fromOffset(0, 350), TextSize = 12, Align = Enum.TextXAlignment.Center, Color = T.Sub })
end

local menuShown = false
local function maybeMenu(isNew)
	if not menuShown then
		menuShown = true
		mainMenu(isNew)
	end
end
Net.on("ready", function(d)
	maybeMenu(d.isNew)
end)
State.on(function(data)
	if not menuShown then
		maybeMenu((data.Counters.published or 0) == 0 and data.Quests.Step <= 1)
	end
end)

---------------------------------------------------------------------------
-- Teclado (PC). En móvil se usan los botones del HUD.
---------------------------------------------------------------------------
UserInputService.InputBegan:Connect(function(input, processed)
	if processed or UserInputService:GetFocusedTextBox() then
		return
	end
	local k = input.KeyCode
	if Build.isPlacing() then
		return -- R/Q/clic los gestiona el modo construcción
	end
	if k == Enum.KeyCode.B then
		Build.toggle()
		return
	end
	if k == Enum.KeyCode.P then
		Shell.togglePhone()
	elseif k == Enum.KeyCode.I then
		toggleApp("inventory")
	elseif k == Enum.KeyCode.M then
		toggleApp("missions")
	elseif k == Enum.KeyCode.R then
		Actions.record()
	elseif k == Enum.KeyCode.F then
		Actions.photoMode()
	elseif k == Enum.KeyCode.V then
		Actions.openStyle()
	elseif k == Enum.KeyCode.C then
		Net.call("PC.OpenLaptop", {}, { quietOk = true })
	elseif k == Enum.KeyCode.Escape or k == Enum.KeyCode.Backspace then
		if Shell.surface() then
			Shell.close()
		end
	end
end)

-- Pedir el estado por si el primer envío llegó antes de conectar
task.spawn(function()
	task.wait(2)
	if not State.Data then
		Net.call("Sync.Request", {}, { silent = true })
	end
end)
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000064"><Properties><string name="Name">Net</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Net (cliente): envía peticiones al servidor y reparte los mensajes que llegan.
-- El cliente nunca decide resultados: solo pide acciones y muestra lo que responde el servidor.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local HttpService = game:GetService("HttpService")

local Net = {}
local remotes = ReplicatedStorage:WaitForChild("Remotes")
local request = remotes:WaitForChild("Request")
local push = remotes:WaitForChild("Push")
local listeners = {}
local busy = 0

Net.Notify = nil -- lo asigna Main
Net.OnBusy = nil

function Net.nonce()
	return HttpService:GenerateGUID(false):sub(1, 30)
end

-- opts.silent: no mostrar mensajes; opts.quietOk: mostrar solo errores
function Net.call(action, payload, opts)
	opts = opts or {}
	busy = busy + 1
	if Net.OnBusy then
		Net.OnBusy(busy > 0)
	end
	local ok, result = pcall(function()
		return request:InvokeServer(action, payload)
	end)
	busy = busy - 1
	if Net.OnBusy then
		Net.OnBusy(busy > 0)
	end
	if not ok or type(result) ~= "table" then
		result = { ok = false, msg = "Sin conexión con el servidor. Inténtalo de nuevo." }
	end
	if Net.Notify and not opts.silent and result.msg then
		if result.ok then
			if not opts.quietOk then
				Net.Notify.toast(result.msg, "success")
			end
		else
			Net.Notify.toast(result.msg, "error")
		end
	end
	return result
end

function Net.on(kind, fn)
	listeners[kind] = listeners[kind] or {}
	table.insert(listeners[kind], fn)
end

push.OnClientEvent:Connect(function(kind, data)
	for _, fn in ipairs(listeners[kind] or {}) do
		task.spawn(fn, data)
	end
end)

return Net
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000065"><Properties><string name="Name">Notify</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Notify (cliente): avisos emergentes, diálogos de NPC, logros y confirmaciones.

local UI = require(script.Parent.UIKit)
local State = require(script.Parent.State)
local T = UI.Theme

local Notify = {}
local gui, stack, dialogFrame

function Notify.init(screenGui, sound)
	gui = screenGui
	Notify.Sound = sound
	stack = UI.frame(gui, { Size = UDim2.new(0, 360, 1, -140), Position = UDim2.new(1, -16, 0, 90), Anchor = Vector2.new(1, 0), Transparency = 1, Radius = false, Name = "Toasts" })
	stack.ZIndex = 50
	local layout = UI.list(stack, Enum.FillDirection.Vertical, 6, Enum.HorizontalAlignment.Right)
	stack.UIListLayout.VerticalAlignment = Enum.VerticalAlignment.Top
end

local colors = { success = T.Ok, error = T.Err, warn = T.Warn, info = T.Accent2, gold = T.Gold }

function Notify.toast(text, style)
	if not stack then
		return
	end
	style = style or "info"
	State.addMessage(text, style)
	if Notify.Sound then
		Notify.Sound.play(style == "error" and "Error" or "Notify")
	end
	local f = UI.frame(stack, { Size = UDim2.new(1, 0, 0, 0), Auto = Enum.AutomaticSize.Y, Color = T.Panel, Transparency = 0.05 })
	UI.stroke(f, colors[style] or T.Accent2, 2)
	UI.padding(f, 10)
	local l = UI.label(f, text, { Auto = Enum.AutomaticSize.Y, Height = 0, TextSize = 14 })
	l.Size = UDim2.new(1, 0, 0, 0)
	f.Position = UDim2.new(1, 40, 0, 0)
	task.delay(style == "error" and 5 or 4, function()
		if f.Parent then
			UI.tween(f, { BackgroundTransparency = 1 }, 0.3)
			UI.tween(l, { TextTransparency = 1 }, 0.3)
			task.wait(0.32)
			f:Destroy()
		end
	end)
	while #stack:GetChildren() > 7 do
		for _, c in ipairs(stack:GetChildren()) do
			if c:IsA("Frame") then
				c:Destroy()
				break
			end
		end
	end
end

-- Banner grande centrado (subida de nivel, logros, secretos)
function Notify.banner(title, subtitle, color)
	if not gui then
		return
	end
	if Notify.Sound then
		Notify.Sound.play("Cash")
	end
	local f = UI.frame(gui, { Size = UDim2.fromOffset(440, 90), Position = UDim2.new(0.5, 0, 0, -100), Anchor = Vector2.new(0.5, 0), Color = T.Panel })
	f.ZIndex = 60
	UI.stroke(f, color or T.Gold, 3)
	UI.label(f, title, { Size = UDim2.new(1, -20, 0, 40), Position = UDim2.fromOffset(10, 8), Font = Enum.Font.GothamBlack, TextSize = 24, Align = Enum.TextXAlignment.Center, Color = color or T.Gold })
	UI.label(f, subtitle or "", { Size = UDim2.new(1, -20, 0, 34), Position = UDim2.fromOffset(10, 48), TextSize = 15, Align = Enum.TextXAlignment.Center })
	UI.tween(f, { Position = UDim2.new(0.5, 0, 0, 90) }, 0.35, Enum.EasingStyle.Back)
	task.delay(3.2, function()
		UI.tween(f, { Position = UDim2.new(0.5, 0, 0, -100) }, 0.3)
		task.wait(0.35)
		f:Destroy()
	end)
end

-- Ventana de confirmación
function Notify.confirm(text, onYes, yesText)
	local overlay = UI.frame(gui, { Size = UDim2.fromScale(1, 1), Color = Color3.new(0, 0, 0), Transparency = 0.45, Radius = false, Name = "Confirm" })
	overlay.ZIndex = 80
	local box = UI.frame(overlay, { Size = UDim2.fromOffset(400, 170), Position = UDim2.fromScale(0.5, 0.5), Anchor = Vector2.new(0.5, 0.5), Color = T.Panel })
	UI.padding(box, 16)
	UI.label(box, text, { Size = UDim2.new(1, 0, 0, 90), TextSize = 16, VAlign = Enum.TextYAlignment.Top })
	UI.button(box, yesText or "Confirmar", function()
		overlay:Destroy()
		onYes()
	end, { Position = UDim2.new(1, 0, 1, 0), Anchor = Vector2.new(1, 1), Color = T.Accent, Width = 150 })
	UI.button(box, "Cancelar", function()
		overlay:Destroy()
	end, { Position = UDim2.new(0, 0, 1, 0), Anchor = Vector2.new(0, 1), Width = 150 })
end

-- Diálogo de NPC con opciones
function Notify.dialog(name, text, options, onOption)
	if dialogFrame then
		dialogFrame:Destroy()
	end
	dialogFrame = UI.frame(gui, { Size = UDim2.fromOffset(560, 150), Position = UDim2.new(0.5, 0, 1, -110), Anchor = Vector2.new(0.5, 1), Color = T.Panel })
	dialogFrame.ZIndex = 40
	UI.stroke(dialogFrame, T.Accent2, 2)
	UI.padding(dialogFrame, 12)
	UI.label(dialogFrame, "💬 " .. name, { Font = Enum.Font.GothamBlack, TextSize = 16, Height = 22 })
	UI.label(dialogFrame, text, { Position = UDim2.fromOffset(0, 26), Size = UDim2.new(1, 0, 0, 60), TextSize = 15, VAlign = Enum.TextYAlignment.Top })
	local row = UI.row(dialogFrame, 34)
	row.Position = UDim2.new(0, 0, 1, -34)
	for _, opt in ipairs(options or {}) do
		UI.button(row, opt.label, function()
			dialogFrame:Destroy()
			dialogFrame = nil
			onOption(opt)
		end, { Width = 150, Color = T.Accent2 })
	end
	UI.button(row, "Adiós", function()
		dialogFrame:Destroy()
		dialogFrame = nil
	end, { Width = 100 })
	local mine = dialogFrame
	task.delay(12, function()
		if dialogFrame == mine and mine.Parent then
			mine:Destroy()
			dialogFrame = nil
		end
	end)
end

return Notify
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000066"><Properties><string name="Name">PhotoView</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- PhotoView (cliente): muestra una fotografía virtual. Cada foto guarda la posición y dirección de la cámara,
-- así que se vuelve a "revelar" clonando las piezas cercanas de la ciudad dentro de un ViewportFrame.
-- Los filtros se simulan con capas de color. Si la foto no tiene cámara guardada, se dibuja una tarjeta.

local UI = require(script.Parent.UIKit)
local T = UI.Theme

local PhotoView = {}
local MAX_PARTS = 320
local RADIUS = 170

local filterTint = {
	[2] = { Color3.fromRGB(255, 60, 160), 0.92 }, -- Vívido
	[3] = { Color3.fromRGB(255, 150, 40), 0.82 }, -- Cálido
	[4] = { Color3.fromRGB(40, 140, 255), 0.82 }, -- Frío
	[5] = { Color3.fromRGB(128, 128, 128), 0.35 }, -- B/N (aproximado)
	[6] = { Color3.fromRGB(160, 110, 60), 0.6 }, -- Vintage
	[7] = { Color3.fromRGB(0, 40, 60), 0.85 }, -- Cine
}

local function skyColor(hour)
	if hour >= 7 and hour < 17 then
		return Color3.fromRGB(130, 190, 250)
	elseif (hour >= 5.5 and hour < 7) or (hour >= 17 and hour < 19.5) then
		return Color3.fromRGB(255, 160, 110)
	end
	return Color3.fromRGB(15, 20, 45)
end

function PhotoView.render(parent, photo, size)
	local holder = UI.frame(parent, { Size = size or UDim2.fromScale(1, 1), Color = T.Bg, Clip = true, Name = "Photo" })
	if not photo then
		UI.label(holder, "Sin foto", { Size = UDim2.fromScale(1, 1), Align = Enum.TextXAlignment.Center, Color = T.Sub })
		return holder
	end
	local cam = photo.Cam
	local city = workspace:FindFirstChild("City")
	if cam and city then
		local vp = UI.new("ViewportFrame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = skyColor(photo.Hour or 12), BorderSizePixel = 0, Parent = holder })
		local night = (photo.Hour or 12) < 6 or (photo.Hour or 12) >= 19.5
		vp.Ambient = night and Color3.fromRGB(70, 70, 110) or Color3.fromRGB(170, 170, 170)
		vp.LightColor = night and Color3.fromRGB(120, 120, 180) or Color3.fromRGB(255, 245, 230)
		vp.LightDirection = Vector3.new(-0.4, -1, -0.3)
		local camera = Instance.new("Camera")
		local pos = Vector3.new(cam[1], cam[2], cam[3])
		local look = Vector3.new(cam[4], cam[5], cam[6])
		if (look - pos).Magnitude < 0.01 then
			look = pos + Vector3.new(0, 0, -1)
		end
		camera.CFrame = CFrame.lookAt(pos, look)
		camera.FieldOfView = photo.Fov or 70
		camera.Parent = vp
		vp.CurrentCamera = camera
		local world = Instance.new("WorldModel")
		world.Parent = vp
		local dir = (look - pos).Unit
		local candidates = {}
		for _, d in ipairs(city:GetDescendants()) do
			if d:IsA("BasePart") and d.Transparency < 1 then
				local rel = d.Position - pos
				local reach = d.Size.Magnitude / 2
				local dist = rel.Magnitude - reach
				if dist < RADIUS and (rel:Dot(dir) > -reach - 5) then
					candidates[#candidates + 1] = { part = d, dist = dist }
				end
			end
		end
		table.sort(candidates, function(a, b)
			return a.dist < b.dist
		end)
		for i = 1, math.min(MAX_PARTS, #candidates) do
			local ok, clone = pcall(function()
				return candidates[i].part:Clone()
			end)
			if ok and clone then
				for _, child in ipairs(clone:GetChildren()) do
					if not child:IsA("SurfaceGui") and not child:IsA("Decal") then
						child:Destroy()
					end
				end
				clone.Parent = world
			end
		end
	else
		local g = UI.frame(holder, { Size = UDim2.fromScale(1, 1), Color = T.Panel2, Radius = false })
		UI.new("UIGradient", { Color = ColorSequence.new(skyColor(photo.Hour or 12), T.Panel2), Rotation = 90, Parent = g })
		UI.label(g, "📷 " .. (photo.SpotName or "Foto"), { Size = UDim2.fromScale(1, 1), Align = Enum.TextXAlignment.Center, Font = Enum.Font.GothamBold })
	end
	local tint = filterTint[photo.Filter or 1]
	if tint then
		local overlay = UI.frame(holder, { Size = UDim2.fromScale(1, 1), Color = tint[1], Transparency = tint[2], Radius = false })
		overlay.ZIndex = 3
		if photo.Filter == 7 then
			for _, y in ipairs({ 0, 0.88 }) do
				local bar = UI.frame(holder, { Size = UDim2.new(1, 0, 0.12, 0), Position = UDim2.fromScale(0, y), Color = Color3.new(0, 0, 0), Radius = false })
				bar.ZIndex = 4
			end
		end
	end
	return holder
end

return PhotoView
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000067"><Properties><string name="Name">Shell</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Shell (cliente): el "sistema operativo" del juego.
--  * Computador: escritorio con fondo, iconos, barra de tareas, menú de inicio, reloj, notificaciones y
--    ventanas que se pueden mover, minimizar, enfocar y cerrar. Las apps recuerdan su estado mientras la
--    ventana está abierta.
--  * Teléfono: pantalla de inicio con apps, una app a la vez con botón atrás.
--  * Panel: una app suelta (catálogo de tienda física, cajero, vestidor...).
-- Solo una de las tres superficies está abierta a la vez para no saturar la pantalla.

local UserInputService = game:GetService("UserInputService")
local UI = require(script.Parent.UIKit)
local State = require(script.Parent.State)
local Net = require(script.Parent.Net)
local Registry = require(script.Parent.AppRegistry)
local T = UI.Theme

local Shell = {}
local gui
local surface = nil -- "pc" | "phone" | "panel"
local root
local windows = {}
local zTop = 10
local session = nil

Shell.Wallpapers = {
	{ Color3.fromRGB(20, 30, 70), Color3.fromRGB(120, 20, 90) },
	{ Color3.fromRGB(10, 60, 60), Color3.fromRGB(10, 20, 30) },
	{ Color3.fromRGB(70, 20, 20), Color3.fromRGB(20, 10, 10) },
	{ Color3.fromRGB(40, 40, 50), Color3.fromRGB(10, 10, 14) },
	{ Color3.fromRGB(255, 140, 60), Color3.fromRGB(120, 30, 120) },
}

function Shell.init(screenGui)
	gui = screenGui
end

function Shell.surface()
	return surface
end

function Shell.session()
	return session
end

local function closeSurface()
	if root then
		for _, w in pairs(windows) do
			if w.cleanup then
				w.cleanup()
			end
		end
		windows = {}
		root:Destroy()
		root = nil
	end
	if surface == "pc" then
		Net.call("PC.Close", {}, { silent = true })
		session = nil
	end
	surface = nil
end
Shell.close = closeSurface

-- Construye una app dentro de un contenedor y devuelve la función de limpieza
local function mountApp(appId, container, kind, params, closeFn)
	local app = Registry.get(appId)
	local unsubs = {}
	local ctx = {
		kind = kind,
		params = params or {},
		close = closeFn,
		session = function()
			return session
		end,
		open = function(id, p)
			Shell.openApp(id, p)
		end,
		onState = function(fn)
			table.insert(unsubs, State.on(fn))
		end,
	}
	local ok, err = pcall(app.build, container, ctx)
	if not ok then
		UI.label(container, "Error en la app: " .. tostring(err), { Color = T.Err, Height = 60 })
		warn(err)
	end
	return function()
		for _, u in ipairs(unsubs) do
			u()
		end
		if ctx.cleanup then
			pcall(ctx.cleanup)
		end
	end
end

---------------------------------------------------------------------------
-- Ventanas del escritorio
---------------------------------------------------------------------------
local taskbarButtons
local function refreshTaskbar()
	if not taskbarButtons then
		return
	end
	UI.clear(taskbarButtons)
	for id, w in pairs(windows) do
		local app = Registry.get(id)
		UI.button(taskbarButtons, app.Icon .. " " .. app.Name, function()
			w.frame.Visible = true
			zTop = zTop + 1
			w.frame.ZIndex = zTop
		end, { Width = 140, Height = 30, TextSize = 12, Color = w.frame.Visible and T.Panel3 or T.Panel2 })
	end
end

local function makeDraggable(handle, frame)
	local dragging, startPos, startInput
	handle.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			startPos = frame.Position
			startInput = input.Position
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragging = false
				end
			end)
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			local scale = gui:FindFirstChild("AutoScale") and gui.AutoScale.Scale or 1
			local delta = (input.Position - startInput) / scale
			frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
		end
	end)
end

local function openWindow(appId, params)
	local app = Registry.get(appId)
	if not app then
		return
	end
	if windows[appId] then
		local w = windows[appId]
		w.frame.Visible = true
		zTop = zTop + 1
		w.frame.ZIndex = zTop
		return
	end
	local count = State.count(windows)
	if count >= 5 then
		require(script.Parent.Notify).toast("Demasiadas ventanas abiertas. Cierra alguna.", "warn")
		return
	end
	local desk = root:FindFirstChild("Desk")
	local w = UI.frame(desk, { Size = UDim2.new(0, app.Width or 720, 0, app.Height or 470), Position = UDim2.new(0, 60 + count * 30, 0, 20 + count * 26), Color = T.Panel, Clip = true, Name = "Window_" .. appId })
	zTop = zTop + 1
	w.ZIndex = zTop
	UI.stroke(w, T.Panel3, 1)
	local bar = UI.frame(w, { Height = 34, Color = T.Panel2, Radius = false, Name = "TitleBar" })
	UI.label(bar, app.Icon .. "  " .. app.Name, { Position = UDim2.fromOffset(12, 0), Size = UDim2.new(1, -110, 1, 0), Font = Enum.Font.GothamBold })
	local content = UI.frame(w, { Size = UDim2.new(1, 0, 1, -34), Position = UDim2.fromOffset(0, 34), Transparency = 1, Radius = false, Name = "Content", Clip = true })
	UI.padding(content, 10)
	local entry = { frame = w }
	windows[appId] = entry
	UI.button(bar, "✕", function()
		if entry.cleanup then
			entry.cleanup()
		end
		windows[appId] = nil
		w:Destroy()
		refreshTaskbar()
	end, { Width = 34, Height = 34, Position = UDim2.new(1, 0, 0, 0), Anchor = Vector2.new(1, 0), Color = T.Accent, Radius = 0 })
	UI.button(bar, "—", function()
		w.Visible = false
		refreshTaskbar()
	end, { Width = 34, Height = 34, Position = UDim2.new(1, -36, 0, 0), Anchor = Vector2.new(1, 0), Radius = 0 })
	w.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			zTop = zTop + 1
			w.ZIndex = zTop
		end
	end)
	makeDraggable(bar, w)
	entry.cleanup = mountApp(appId, content, "pc", params, function()
		if entry.cleanup then
			entry.cleanup()
		end
		windows[appId] = nil
		w:Destroy()
		refreshTaskbar()
	end)
	refreshTaskbar()
	if require(script.Parent.Notify).Sound then
		require(script.Parent.Notify).Sound.play("Open")
	end
end

function Shell.openComputer(stats)
	closeSurface()
	session = stats
	surface = "pc"
	local data = State.Data
	local wp = Shell.Wallpapers[(data and data.Settings.Wallpaper) or 1] or Shell.Wallpapers[1]
	root = UI.frame(gui, { Size = UDim2.new(1, -40, 1, -40), Position = UDim2.fromScale(0.5, 0.5), Anchor = Vector2.new(0.5, 0.5), Color = wp[1], Clip = true, Name = "Computer" })
	root.ZIndex = 5
	UI.new("UIGradient", { Color = ColorSequence.new(wp[1], wp[2]), Rotation = 45, Parent = root })
	UI.stroke(root, Color3.fromRGB(0, 0, 0), 4)
	local desk = UI.frame(root, { Size = UDim2.new(1, 0, 1, -44), Transparency = 1, Radius = false, Name = "Desk" })
	-- Iconos del escritorio
	local icons = UI.frame(desk, { Size = UDim2.new(0, 330, 1, -10), Position = UDim2.fromOffset(10, 10), Transparency = 1, Radius = false, Name = "Icons" })
	UI.grid(icons, 76, 76, 6)
	for _, app in ipairs(Registry.list("pc")) do
		local b = UI.button(icons, app.Icon .. "\n" .. app.Name, function()
			openWindow(app.Id)
		end, { Color = Color3.fromRGB(0, 0, 0), TextSize = 11 })
		b.BackgroundTransparency = 0.6
	end
	-- Barra de tareas
	local bar = UI.frame(root, { Height = 44, Position = UDim2.new(0, 0, 1, -44), Color = Color3.fromRGB(12, 12, 16), Radius = false, Name = "Taskbar" })
	bar.ZIndex = 1000
	local startMenu
	UI.button(bar, "⊞ Inicio", function()
		if startMenu then
			startMenu:Destroy()
			startMenu = nil
			return
		end
		startMenu = UI.frame(root, { Size = UDim2.fromOffset(260, 380), Position = UDim2.new(0, 6, 1, -50), Anchor = Vector2.new(0, 1), Color = T.Panel, Name = "StartMenu" })
		startMenu.ZIndex = 1001
		local s = UI.scroll(startMenu, { Pad = 4 })
		local stats = session or {}
		UI.label(s, "💻 " .. (stats.Kind == "laptop" and "Portátil" or (stats.Kind == "public" and "Computador público" or "Tu computador")), { Font = Enum.Font.GothamBold })
		UI.label(s, "Rendimiento: " .. tostring(stats.TierName or "?") .. " · " .. tostring(stats.MaxScenes or "?") .. " clips máx.", { Color = T.Sub, TextSize = 12 })
		for _, app in ipairs(Registry.list("pc")) do
			UI.button(s, app.Icon .. "  " .. app.Name, function()
				startMenu:Destroy()
				startMenu = nil
				openWindow(app.Id)
			end, { Size = UDim2.new(1, -8, 0, 30), TextSize = 13, Color = T.Panel2 })
		end
		UI.button(s, "⏻ Apagar", function()
			closeSurface()
		end, { Size = UDim2.new(1, -8, 0, 30), Color = T.Accent })
	end, { Width = 100, Height = 36, Position = UDim2.fromOffset(4, 4), Color = T.Accent })
	taskbarButtons = UI.frame(bar, { Size = UDim2.new(1, -330, 1, -8), Position = UDim2.fromOffset(110, 4), Transparency = 1, Radius = false })
	UI.list(taskbarButtons, Enum.FillDirection.Horizontal, 4)
	local clock = UI.label(bar, "", { Size = UDim2.new(0, 200, 1, 0), Position = UDim2.new(1, -210, 0, 0), Align = Enum.TextXAlignment.Right, TextSize = 13 })
	task.spawn(function()
		while root and root.Parent and clock.Parent do
			local h = workspace:GetAttribute("GameHour") or 12
			clock.Text = string.format("🔔 %d   %02d:%02d · Día %d", #State.Messages, math.floor(h), math.floor((h % 1) * 60), workspace:GetAttribute("GameDay") or 1)
			task.wait(1)
		end
	end)
	UI.button(bar, "✕", function()
		closeSurface()
	end, { Width = 40, Height = 36, Position = UDim2.new(1, -4, 0, 4), Anchor = Vector2.new(1, 0), Color = T.Panel3 })
	-- Bienvenida
	local hello = UI.label(desk, "Bienvenido a TuboOS · haz doble clic... o un clic 😉 en una app", { Size = UDim2.new(0, 500, 0, 30), Position = UDim2.new(1, -20, 1, -10), Anchor = Vector2.new(1, 1), Align = Enum.TextXAlignment.Right, Color = Color3.fromRGB(220, 220, 230), TextSize = 13 })
	hello.TextTransparency = 0.3
	if stats and stats.openApp then
		openWindow(stats.openApp)
	end
end

---------------------------------------------------------------------------
-- Teléfono
---------------------------------------------------------------------------
function Shell.openPhone(appId, params)
	closeSurface()
	surface = "phone"
	root = UI.frame(gui, { Size = UDim2.fromOffset(330, 620), Position = UDim2.new(1, -20, 0.5, 0), Anchor = Vector2.new(1, 0.5), Color = Color3.fromRGB(8, 8, 10), Name = "Phone", Radius = 30 })
	root.ZIndex = 5
	UI.stroke(root, Color3.fromRGB(70, 70, 80), 3)
	local screen = UI.frame(root, { Size = UDim2.new(1, -20, 1, -50), Position = UDim2.fromOffset(10, 30), Color = T.Bg, Radius = 20, Clip = true, Name = "Screen" })
	local status = UI.label(root, "", { Size = UDim2.new(1, -40, 0, 22), Position = UDim2.fromOffset(20, 6), TextSize = 12, Color = T.Sub })
	task.spawn(function()
		while root and root.Parent and status.Parent do
			local h = workspace:GetAttribute("GameHour") or 12
			local weather = ({ Clear = "☀️", Cloudy = "☁️", Rain = "🌧", Fog = "🌫", Storm = "⛈" })[workspace:GetAttribute("Weather") or "Clear"] or ""
			status.Text = string.format("%02d:%02d  %s   ·   %s", math.floor(h), math.floor((h % 1) * 60), weather, (State.Data and State.Data.Derived and "$" .. State.Data.Money) or "")
			task.wait(1)
		end
	end)
	local current
	local function home()
		if current then
			current()
			current = nil
		end
		UI.clear(screen)
		local grid = UI.scroll(screen, { Grid = { 86, 82 }, Pad = 6, Padding = 10 })
		for _, app in ipairs(Registry.list("phone")) do
			local b = UI.button(grid, app.Icon .. "\n" .. app.Name, function()
				UI.clear(screen)
				local content = UI.frame(screen, { Size = UDim2.new(1, 0, 1, -40), Transparency = 1, Radius = false, Clip = true })
				UI.padding(content, 8)
				local back = UI.button(screen, "◀ Inicio", home, { Size = UDim2.new(1, -16, 0, 32), Position = UDim2.new(0, 8, 1, -36), Color = T.Panel2 })
				current = mountApp(app.Id, content, "phone", params, home)
			end, { Color = T.Panel2, TextSize = 12 })
		end
	end
	home()
	UI.button(root, "✕", function()
		if current then
			current()
		end
		closeSurface()
	end, { Width = 30, Height = 22, Position = UDim2.new(1, -16, 0, 4), Anchor = Vector2.new(1, 0), Color = T.Accent, TextSize = 12 })
	Net.call("Phone.Opened", {}, { silent = true })
	if appId then
		local app = Registry.get(appId)
		if app then
			UI.clear(screen)
			local content = UI.frame(screen, { Size = UDim2.new(1, 0, 1, -40), Transparency = 1, Radius = false, Clip = true })
			UI.padding(content, 8)
			UI.button(screen, "◀ Inicio", home, { Size = UDim2.new(1, -16, 0, 32), Position = UDim2.new(0, 8, 1, -36), Color = T.Panel2 })
			current = mountApp(appId, content, "phone", params, home)
		end
	end
end

---------------------------------------------------------------------------
-- Panel suelto
---------------------------------------------------------------------------
function Shell.openPanel(appId, params)
	local app = Registry.get(appId)
	if not app then
		return
	end
	closeSurface()
	surface = "panel"
	root = UI.frame(gui, { Size = UDim2.fromOffset(app.Width or 760, app.Height or 500), Position = UDim2.fromScale(0.5, 0.5), Anchor = Vector2.new(0.5, 0.5), Color = T.Panel, Clip = true, Name = "Panel" })
	root.ZIndex = 5
	UI.stroke(root, T.Panel3, 2)
	local bar = UI.frame(root, { Height = 38, Color = T.Panel2, Radius = false })
	UI.label(bar, app.Icon .. "  " .. ((params and params.title) or app.Name), { Position = UDim2.fromOffset(12, 0), Size = UDim2.new(1, -60, 1, 0), Font = Enum.Font.GothamBlack, TextSize = 16 })
	local content = UI.frame(root, { Size = UDim2.new(1, 0, 1, -38), Position = UDim2.fromOffset(0, 38), Transparency = 1, Radius = false, Clip = true })
	UI.padding(content, 10)
	local cleanup = mountApp(appId, content, "panel", params, closeSurface)
	windows[appId] = { frame = root, cleanup = cleanup }
	UI.button(bar, "✕", function()
		closeSurface()
	end, { Width = 38, Height = 38, Position = UDim2.new(1, 0, 0, 0), Anchor = Vector2.new(1, 0), Color = T.Accent, Radius = 0 })
end

-- Abre una app en la superficie más adecuada
function Shell.openApp(appId, params)
	local app = Registry.get(appId)
	if not app then
		return
	end
	if surface == "pc" and Registry.allowed(app, "pc") then
		openWindow(appId, params)
	elseif surface == "phone" and Registry.allowed(app, "phone") then
		Shell.openPhone(appId, params)
	elseif Registry.allowed(app, "panel") then
		Shell.openPanel(appId, params)
	elseif Registry.allowed(app, "phone") then
		Shell.openPhone(appId, params)
	else
		require(script.Parent.Notify).toast(app.Name .. " solo funciona en un computador.", "warn")
	end
end

function Shell.togglePhone()
	if surface == "phone" then
		closeSurface()
	else
		Shell.openPhone()
	end
end

return Shell
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000068"><Properties><string name="Name">Sound</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Sound (cliente): efectos de interfaz y música ambiental con control de volumen.

local SoundService = game:GetService("SoundService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundConfig = require(ReplicatedStorage.Shared.SoundConfig)

local Sound = {}
local sfxVolume = 0.7
local musicVolume = 0.5
local cache = {}
local music

function Sound.setVolumes(sfx, mus)
	sfxVolume = sfx or sfxVolume
	musicVolume = mus or musicVolume
	if music then
		music.Volume = musicVolume * 0.4
	end
end

function Sound.play(name)
	local id = SoundConfig.Sfx[name]
	if not id or sfxVolume <= 0 then
		return
	end
	local s = cache[name]
	if not s then
		s = Instance.new("Sound")
		s.SoundId = id
		s.Parent = SoundService
		cache[name] = s
	end
	s.Volume = sfxVolume * 0.6
	s.PlaybackSpeed = (name == "Error") and 0.7 or ((name == "Cash") and 1.3 or 1)
	pcall(function()
		SoundService:PlayLocalSound(s)
	end)
end

function Sound.startMusic()
	local id = SoundConfig.Music.Ambient
	if not id or id == 0 then
		return -- sin ID configurado: no se reproduce nada (evita audio sin licencia)
	end
	music = Instance.new("Sound")
	music.SoundId = "rbxassetid://" .. id
	music.Looped = true
	music.Volume = musicVolume * 0.4
	music.Parent = SoundService
	music:Play()
end

return Sound
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000069"><Properties><string name="Name">State</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- State (cliente): copia de solo lectura del perfil enviada por el servidor + avisos de cambio.

local State = {}
State.Data = nil
State.Messages = {} -- historial de notificaciones de esta sesión (app Mensajes)
State.Context = {} -- tienda física actual, etc.

local listeners = {}
local nextId = 0

function State.set(data)
	State.Data = data
	for _, fn in pairs(listeners) do
		task.spawn(fn, data)
	end
end

-- Devuelve una función para dejar de escuchar
function State.on(fn)
	nextId = nextId + 1
	local id = nextId
	listeners[id] = fn
	return function()
		listeners[id] = nil
	end
end

-- Directo en curso (eventos "live" del servidor)
State.Live = nil
local liveListeners = {}
function State.setLive(d)
	State.Live = d
	for _, fn in pairs(liveListeners) do
		task.spawn(fn, d)
	end
end
function State.onLive(fn)
	nextId = nextId + 1
	local id = nextId
	liveListeners[id] = fn
	return function()
		liveListeners[id] = nil
	end
end

function State.addMessage(text, style)
	table.insert(State.Messages, 1, { Text = text, Style = style, T = os.time() })
	while #State.Messages > 60 do
		table.remove(State.Messages)
	end
end

function State.count(t)
	local n = 0
	for _ in pairs(t or {}) do
		n = n + 1
	end
	return n
end

-- Objetos del inventario como lista ordenada
function State.items(filterFn)
	local out = {}
	local Catalog = require(game:GetService("ReplicatedStorage").Shared.ItemCatalog)
	for uid, rec in pairs(State.Data and State.Data.Inventory or {}) do
		local def = Catalog.get(rec.Id)
		if def and (not filterFn or filterFn(rec, def, uid)) then
			out[#out + 1] = { Uid = uid, Rec = rec, Def = def }
		end
	end
	table.sort(out, function(a, b)
		if a.Def.Cat ~= b.Def.Cat then
			return a.Def.Cat < b.Def.Cat
		end
		return a.Def.Name < b.Def.Name
	end)
	return out
end

return State
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000070"><Properties><string name="Name">UIKit</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- UIKit: componentes de interfaz reutilizables con un estilo coherente (tema oscuro, acentos de color),
-- animaciones de botones, sonidos y diseño adaptable a distintas resoluciones.

local TweenService = game:GetService("TweenService")

local UI = {}

UI.Theme = {
	Bg = Color3.fromRGB(16, 17, 22),
	Panel = Color3.fromRGB(26, 28, 36),
	Panel2 = Color3.fromRGB(36, 39, 50),
	Panel3 = Color3.fromRGB(48, 52, 66),
	Text = Color3.fromRGB(240, 242, 248),
	Sub = Color3.fromRGB(160, 166, 184),
	Accent = Color3.fromRGB(255, 52, 82),
	Accent2 = Color3.fromRGB(0, 190, 255),
	Ok = Color3.fromRGB(60, 210, 120),
	Warn = Color3.fromRGB(255, 190, 40),
	Err = Color3.fromRGB(255, 80, 80),
	Gold = Color3.fromRGB(255, 214, 0),
}
local T = UI.Theme

UI.ReduceMotion = false
UI.Sound = nil -- lo asigna Main (módulo Sound)

function UI.new(class, props, children)
	local inst = Instance.new(class)
	for k, v in pairs(props or {}) do
		if k ~= "Parent" then
			inst[k] = v
		end
	end
	for _, c in ipairs(children or {}) do
		c.Parent = inst
	end
	if props and props.Parent then
		inst.Parent = props.Parent
	end
	return inst
end

function UI.tween(inst, props, t, style)
	if UI.ReduceMotion then
		for k, v in pairs(props) do
			inst[k] = v
		end
		return
	end
	local tw = TweenService:Create(inst, TweenInfo.new(t or 0.15, style or Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props)
	tw:Play()
	return tw
end

function UI.corner(inst, r)
	UI.new("UICorner", { CornerRadius = UDim.new(0, r or 8), Parent = inst })
	return inst
end

function UI.stroke(inst, color, thickness, transparency)
	UI.new("UIStroke", { Color = color or T.Panel3, Thickness = thickness or 1, Transparency = transparency or 0, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = inst })
	return inst
end

function UI.padding(inst, px)
	UI.new("UIPadding", { PaddingTop = UDim.new(0, px), PaddingBottom = UDim.new(0, px), PaddingLeft = UDim.new(0, px), PaddingRight = UDim.new(0, px), Parent = inst })
	return inst
end

function UI.list(inst, dir, pad, halign)
	UI.new("UIListLayout", {
		FillDirection = dir or Enum.FillDirection.Vertical,
		Padding = UDim.new(0, pad or 6),
		SortOrder = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = halign or Enum.HorizontalAlignment.Left,
		Parent = inst,
	})
	return inst
end

function UI.grid(inst, w, h, pad)
	UI.new("UIGridLayout", { CellSize = UDim2.fromOffset(w, h), CellPadding = UDim2.fromOffset(pad or 8, pad or 8), SortOrder = Enum.SortOrder.LayoutOrder, Parent = inst })
	return inst
end

function UI.frame(parent, props)
	props = props or {}
	local f = UI.new("Frame", {
		BackgroundColor3 = props.Color or T.Panel,
		BackgroundTransparency = props.Transparency or 0,
		BorderSizePixel = 0,
		Size = props.Size or UDim2.new(1, 0, 0, props.Height or 40),
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.Anchor or Vector2.new(),
		LayoutOrder = props.Order or 0,
		AutomaticSize = props.Auto or Enum.AutomaticSize.None,
		ClipsDescendants = props.Clip or false,
		Name = props.Name or "Frame",
		Parent = parent,
	})
	if props.Radius ~= false then
		UI.corner(f, props.Radius or 8)
	end
	return f
end

function UI.label(parent, text, props)
	props = props or {}
	return UI.new("TextLabel", {
		Text = text or "",
		BackgroundTransparency = 1,
		TextColor3 = props.Color or T.Text,
		Font = props.Font or Enum.Font.Gotham,
		TextSize = props.TextSize or 14,
		TextWrapped = props.Wrap ~= false,
		TextXAlignment = props.Align or Enum.TextXAlignment.Left,
		TextYAlignment = props.VAlign or Enum.TextYAlignment.Center,
		Size = props.Size or UDim2.new(1, 0, 0, props.Height or 20),
		Position = props.Position or UDim2.new(),
		AutomaticSize = props.Auto or Enum.AutomaticSize.None,
		RichText = props.Rich or false,
		LayoutOrder = props.Order or 0,
		TextScaled = props.Scaled or false,
		Name = props.Name or "Label",
		Parent = parent,
	})
end

function UI.title(parent, text, order)
	return UI.label(parent, text, { Font = Enum.Font.GothamBlack, TextSize = 18, Height = 26, Order = order })
end

function UI.button(parent, text, onClick, props)
	props = props or {}
	local base = props.Color or T.Panel3
	local b = UI.new("TextButton", {
		Text = text,
		AutoButtonColor = false,
		BackgroundColor3 = base,
		TextColor3 = props.TextColor or T.Text,
		Font = props.Font or Enum.Font.GothamBold,
		TextSize = props.TextSize or 14,
		TextWrapped = true,
		Size = props.Size or UDim2.new(0, props.Width or 120, 0, props.Height or 34),
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.Anchor or Vector2.new(),
		LayoutOrder = props.Order or 0,
		AutomaticSize = props.Auto or Enum.AutomaticSize.None,
		Name = props.Name or text,
		Parent = parent,
	})
	UI.corner(b, props.Radius or 8)
	local scale = UI.new("UIScale", { Parent = b })
	b.MouseEnter:Connect(function()
		UI.tween(b, { BackgroundColor3 = base:Lerp(Color3.new(1, 1, 1), 0.12) }, 0.1)
	end)
	b.MouseLeave:Connect(function()
		UI.tween(b, { BackgroundColor3 = base }, 0.1)
		UI.tween(scale, { Scale = 1 }, 0.1)
	end)
	b.MouseButton1Down:Connect(function()
		UI.tween(scale, { Scale = 0.95 }, 0.06)
	end)
	b.MouseButton1Up:Connect(function()
		UI.tween(scale, { Scale = 1 }, 0.08)
	end)
	if onClick then
		b.Activated:Connect(function()
			if props.Disabled then
				return
			end
			if UI.Sound then
				UI.Sound.play("Click")
			end
			onClick(b)
		end)
	end
	if props.Disabled then
		b.BackgroundTransparency = 0.5
		b.TextTransparency = 0.4
	end
	return b
end

function UI.scroll(parent, props)
	props = props or {}
	local s = UI.new("ScrollingFrame", {
		BackgroundTransparency = props.Transparency or 1,
		BackgroundColor3 = props.Color or T.Panel,
		BorderSizePixel = 0,
		Size = props.Size or UDim2.fromScale(1, 1),
		Position = props.Position or UDim2.new(),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = props.Horizontal and Enum.AutomaticSize.X or Enum.AutomaticSize.Y,
		ScrollBarThickness = 6,
		ScrollBarImageColor3 = T.Panel3,
		ScrollingDirection = props.Horizontal and Enum.ScrollingDirection.X or Enum.ScrollingDirection.Y,
		LayoutOrder = props.Order or 0,
		Name = props.Name or "Scroll",
		Parent = parent,
	})
	if props.Grid then
		UI.grid(s, props.Grid[1], props.Grid[2], props.Pad)
	elseif props.NoLayout ~= true then
		UI.list(s, props.Horizontal and Enum.FillDirection.Horizontal or Enum.FillDirection.Vertical, props.Pad or 6)
	end
	UI.padding(s, props.Padding or 4)
	return s
end

function UI.row(parent, height, order, pad)
	local r = UI.frame(parent, { Height = height or 34, Transparency = 1, Order = order, Radius = false })
	UI.list(r, Enum.FillDirection.Horizontal, pad or 6)
	r.UIListLayout.VerticalAlignment = Enum.VerticalAlignment.Center
	return r
end

function UI.input(parent, placeholder, default, props)
	props = props or {}
	local box = UI.new("TextBox", {
		PlaceholderText = placeholder or "",
		Text = default or "",
		ClearTextOnFocus = false,
		BackgroundColor3 = T.Bg,
		TextColor3 = T.Text,
		PlaceholderColor3 = T.Sub,
		Font = Enum.Font.Gotham,
		TextSize = 14,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextWrapped = props.Multi or false,
		MultiLine = props.Multi or false,
		Size = props.Size or UDim2.new(1, 0, 0, props.Height or 34),
		LayoutOrder = props.Order or 0,
		Parent = parent,
	})
	UI.corner(box, 6)
	UI.padding(box, 6)
	UI.stroke(box, T.Panel3)
	return box
end

-- Selector cíclico: [◀ texto ▶]
function UI.cycle(parent, label, options, index, onChange, props)
	props = props or {}
	local row = UI.row(parent, 32, props.Order)
	UI.label(row, label, { Size = UDim2.new(0, props.LabelWidth or 120, 1, 0), Color = T.Sub, TextSize = 13 })
	local idx = index or 1
	local value
	UI.button(row, "◀", function()
		idx = idx - 1
		if idx < 1 then
			idx = #options
		end
		value.Text = options[idx]
		onChange(idx)
	end, { Width = 30, Height = 28 })
	value = UI.label(row, options[idx] or "-", { Size = UDim2.new(0, props.ValueWidth or 170, 1, 0), Align = Enum.TextXAlignment.Center, Font = Enum.Font.GothamBold, TextSize = 13 })
	UI.button(row, "▶", function()
		idx = idx + 1
		if idx > #options then
			idx = 1
		end
		value.Text = options[idx]
		onChange(idx)
	end, { Width = 30, Height = 28 })
	return row
end

function UI.stepper(parent, label, value, min, max, step, onChange, props)
	props = props or {}
	local row = UI.row(parent, 32, props.Order)
	UI.label(row, label, { Size = UDim2.new(0, props.LabelWidth or 120, 1, 0), Color = T.Sub, TextSize = 13 })
	local v = value
	local txt
	local function fmt(x)
		return props.Format and props.Format(x) or tostring(x)
	end
	UI.button(row, "−", function()
		v = math.max(min, v - step)
		v = math.floor(v * 100 + 0.5) / 100
		txt.Text = fmt(v)
		onChange(v)
	end, { Width = 30, Height = 28 })
	txt = UI.label(row, fmt(v), { Size = UDim2.new(0, 70, 1, 0), Align = Enum.TextXAlignment.Center, Font = Enum.Font.GothamBold, TextSize = 13 })
	UI.button(row, "+", function()
		v = math.min(max, v + step)
		v = math.floor(v * 100 + 0.5) / 100
		txt.Text = fmt(v)
		onChange(v)
	end, { Width = 30, Height = 28 })
	return row
end

function UI.toggle(parent, label, value, onChange, props)
	props = props or {}
	local row = UI.row(parent, 32, props.Order)
	local state = value
	local b
	b = UI.button(row, (state and "✔ " or "✖ ") .. label, function()
		state = not state
		b.Text = (state and "✔ " or "✖ ") .. label
		b.BackgroundColor3 = state and T.Ok or T.Panel3
		onChange(state)
	end, { Width = props.Width or 220, Height = 28, Color = state and T.Ok or T.Panel3 })
	return row
end

function UI.progress(parent, ratio, color, props)
	props = props or {}
	local bg = UI.frame(parent, { Height = props.Height or 10, Color = T.Bg, Order = props.Order, Radius = 5, Size = props.Size })
	local fill = UI.frame(bg, { Size = UDim2.new(math.clamp(ratio or 0, 0, 1), 0, 1, 0), Color = color or T.Accent, Radius = 5, Name = "Fill" })
	return bg, fill
end

-- Gráfico de barras sencillo
function UI.bars(parent, values, labels, color, props)
	props = props or {}
	local box = UI.frame(parent, { Height = props.Height or 140, Color = T.Bg, Order = props.Order })
	UI.padding(box, 8)
	local maxV = 0
	for _, v in ipairs(values) do
		if v > maxV then
			maxV = v
		end
	end
	if maxV <= 0 then
		maxV = 1
	end
	local n = math.max(1, #values)
	for i, v in ipairs(values) do
		local col = UI.frame(box, { Size = UDim2.new(1 / n, -4, 1, -16), Position = UDim2.new((i - 1) / n, 2, 0, 0), Transparency = 1, Radius = false })
		local h = v / maxV
		UI.frame(col, { Size = UDim2.new(1, 0, h, 0), Position = UDim2.new(0, 0, 1 - h, 0), Color = color or T.Accent2, Radius = 3 })
		if labels and labels[i] then
			UI.label(box, labels[i], { Size = UDim2.new(1 / n, 0, 0, 14), Position = UDim2.new((i - 1) / n, 0, 1, -14), TextSize = 10, Color = T.Sub, Align = Enum.TextXAlignment.Center, Wrap = false })
		end
	end
	if #values == 0 then
		UI.label(box, "Sin datos todavía", { Size = UDim2.fromScale(1, 1), Align = Enum.TextXAlignment.Center, Color = T.Sub })
	end
	return box
end

function UI.clear(frame)
	for _, c in ipairs(frame:GetChildren()) do
		if not c:IsA("UIListLayout") and not c:IsA("UIGridLayout") and not c:IsA("UIPadding") and not c:IsA("UICorner") and not c:IsA("UIStroke") then
			c:Destroy()
		end
	end
end

function UI.card(parent, props)
	props = props or {}
	local f = UI.frame(parent, { Height = props.Height or 60, Color = props.Color or T.Panel2, Order = props.Order, Auto = props.Auto })
	UI.padding(f, props.Pad or 8)
	if props.List ~= false then
		UI.list(f, Enum.FillDirection.Vertical, props.Gap or 4)
	end
	return f
end

function UI.rgb(t)
	return Color3.fromRGB(t[1], t[2], t[3])
end

-- Escala automática de la interfaz según la pantalla
function UI.attachScale(gui, userScale)
	local scale = gui:FindFirstChild("AutoScale") or UI.new("UIScale", { Name = "AutoScale", Parent = gui })
	local camera = workspace.CurrentCamera
	local function update()
		local vp = camera.ViewportSize
		local s = math.clamp(math.min(vp.X / 1280, vp.Y / 760), 0.55, 1.25)
		scale.Scale = s * (userScale and userScale() or 1)
	end
	camera:GetPropertyChangedSignal("ViewportSize"):Connect(update)
	update()
	return update
end

return UI
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000071"><Properties><string name="Name">WorldFX</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- WorldFX (cliente): lluvia, relámpagos moderados, objetos giratorios, flecha guía del tutorial,
-- correr con Shift y ajustes gráficos locales.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Lighting = game:GetService("Lighting")
local CollectionService = game:GetService("CollectionService")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local WorldData = require(Shared.WorldData)
local QuestDefs = require(Shared.QuestDefs)
local State = require(script.Parent.State)

local FX = {}
local player = Players.LocalPlayer
local rainPart, rainEmitter
local guidePart, beam, guideTarget

local function ensureRain()
	if rainPart then
		return
	end
	rainPart = Instance.new("Part")
	rainPart.Name = "LocalRain"
	rainPart.Anchored = true
	rainPart.CanCollide = false
	rainPart.CanQuery = false
	rainPart.Transparency = 1
	rainPart.Size = Vector3.new(80, 1, 80)
	rainPart.Parent = workspace.CurrentCamera
	rainEmitter = Instance.new("ParticleEmitter")
	rainEmitter.Color = ColorSequence.new(Color3.fromRGB(190, 210, 240))
	rainEmitter.Size = NumberSequence.new(0.12)
	rainEmitter.Transparency = NumberSequence.new(0.3)
	rainEmitter.Speed = NumberRange.new(70, 90)
	rainEmitter.Lifetime = NumberRange.new(0.6, 0.9)
	rainEmitter.EmissionDirection = Enum.NormalId.Bottom
	rainEmitter.SpreadAngle = Vector2.new(4, 4)
	rainEmitter.LightEmission = 0.2
	rainEmitter.Rate = 0
	rainEmitter.Parent = rainPart
end

local function updateWeather()
	ensureRain()
	local w = workspace:GetAttribute("Weather") or "Clear"
	rainEmitter.Rate = (w == "Storm" and 900) or (w == "Rain" and 500) or 0
end

local function guidePosition()
	local data = State.Data
	if not data or data.Quests.Skipped then
		return nil
	end
	local step = QuestDefs.Tutorial[data.Quests.Step]
	if not step or not step.Marker then
		return nil
	end
	if step.Marker == "home" then
		local p = player:GetAttribute("HomePos")
		if data.Derived.AtHome then
			return nil
		end
		return p
	elseif step.Marker:sub(1, 6) == "store_" then
		local id = step.Marker:sub(7)
		for _, sp in ipairs(WorldData.Specials) do
			if sp.StoreId == id then
				return Vector3.new(sp.WX, 4, sp.WZ + 26)
			end
		end
	end
	return nil
end

local function updateGuide()
	local pos = guidePosition()
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if not pos or not root then
		if beam then
			beam.Enabled = false
		end
		if guidePart then
			guidePart.Billboard.Enabled = false
		end
		return
	end
	if not guidePart then
		guidePart = Instance.new("Part")
		guidePart.Name = "TutorialTarget"
		guidePart.Anchored = true
		guidePart.CanCollide = false
		guidePart.CanQuery = false
		guidePart.Transparency = 1
		guidePart.Size = Vector3.new(1, 1, 1)
		guidePart.Parent = workspace.CurrentCamera
		local a1 = Instance.new("Attachment")
		a1.Name = "Target"
		a1.Parent = guidePart
		local bb = Instance.new("BillboardGui")
		bb.Name = "Billboard"
		bb.Size = UDim2.fromOffset(160, 40)
		bb.AlwaysOnTop = true
		bb.StudsOffset = Vector3.new(0, 6, 0)
		bb.Parent = guidePart
		local t = Instance.new("TextLabel")
		t.Size = UDim2.fromScale(1, 1)
		t.BackgroundTransparency = 0.2
		t.BackgroundColor3 = Color3.fromRGB(255, 52, 82)
		t.TextColor3 = Color3.new(1, 1, 1)
		t.Font = Enum.Font.GothamBlack
		t.TextScaled = true
		t.Text = "📍 Objetivo"
		t.Parent = bb
	end
	guidePart.Position = pos
	guidePart.Billboard.Enabled = true
	local a0 = root:FindFirstChild("GuideAttachment")
	if not a0 then
		a0 = Instance.new("Attachment")
		a0.Name = "GuideAttachment"
		a0.Parent = root
	end
	if not beam or beam.Attachment0 ~= a0 then
		if beam then
			beam:Destroy()
		end
		beam = Instance.new("Beam")
		beam.Attachment0 = a0
		beam.Attachment1 = guidePart.Target
		beam.Color = ColorSequence.new(Color3.fromRGB(255, 52, 82), Color3.fromRGB(255, 214, 0))
		beam.Width0 = 0.6
		beam.Width1 = 0.6
		beam.FaceCamera = true
		beam.LightEmission = 1
		beam.Segments = 10
		beam.Parent = guidePart
	end
	beam.Enabled = true
end

function FX.applySettings()
	local data = State.Data
	if not data then
		return
	end
	Lighting.GlobalShadows = data.Settings.Shadows ~= false
end

function FX.start()
	updateWeather()
	workspace:GetAttributeChangedSignal("Weather"):Connect(updateWeather)
	-- Relámpagos moderados durante tormentas
	task.spawn(function()
		local cc = Instance.new("ColorCorrectionEffect")
		cc.Name = "Lightning"
		cc.Parent = Lighting
		while true do
			task.wait(math.random(12, 25))
			if workspace:GetAttribute("Weather") == "Storm" and not (State.Data and State.Data.Settings.ReduceMotion) then
				cc.Brightness = 0.35
				task.wait(0.08)
				cc.Brightness = 0
				task.wait(0.12)
				cc.Brightness = 0.2
				task.wait(0.06)
				cc.Brightness = 0
			end
		end
	end)
	-- Lluvia siguiendo a la cámara + objetos giratorios
	local spinAngle = 0
	RunService.RenderStepped:Connect(function(dt)
		if rainPart then
			rainPart.CFrame = CFrame.new(workspace.CurrentCamera.CFrame.Position + Vector3.new(0, 35, 0))
		end
		spinAngle = spinAngle + dt
		for _, obj in ipairs(CollectionService:GetTagged("Spin")) do
			if obj:IsA("Model") and obj.PrimaryPart then
				local base = obj:GetAttribute("BaseCF")
				if not base then
					obj:SetAttribute("BaseCF", obj.PrimaryPart.CFrame)
					base = obj.PrimaryPart.CFrame
				end
				obj:PivotTo(base * CFrame.Angles(0, 0, spinAngle * 0.15))
			elseif obj:IsA("BasePart") then
				obj.CFrame = obj.CFrame * CFrame.Angles(0, dt * 1.5, 0)
			end
		end
	end)
	-- Flecha guía
	task.spawn(function()
		while true do
			pcall(updateGuide)
			task.wait(0.5)
		end
	end)
	-- Correr con Shift
	UserInputService.InputBegan:Connect(function(input, processed)
		if processed then
			return
		end
		if input.KeyCode == Enum.KeyCode.LeftShift then
			local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
			if hum then
				hum.WalkSpeed = 28
			end
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.KeyCode == Enum.KeyCode.LeftShift then
			local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
			if hum then
				hum.WalkSpeed = 18
			end
		end
	end)
	State.on(FX.applySettings)
end

return FX
]]></ProtectedString></Properties></Item></Item></Item></Item><Item class="SoundService" referent="RBX000073"><Properties><string name="Name">SoundService</string></Properties></Item></roblox>