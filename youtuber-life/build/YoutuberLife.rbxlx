	{ Id = "hogarvivo", Name = "Hogar Vivo", Field = "Decoración", Cats = { "decor", "home", "tutorial" }, Products = { "dec_sofa_modern", "dec_lamp_modern", "dec_art_modern" }, MinRep = 0 },
