WorldData.Districts = D
WorldData.DistrictById = {}
for _, d in ipairs(D) do
	WorldData.DistrictById[d.Id] = d
end

function WorldData.totalSize()
	return WorldData.Cols * WorldData.CellSize, WorldData.Rows * WorldData.CellSize
end

-- Centro del distrito en coordenadas del mundo (x, z). El mapa está centrado en el origen.
function WorldData.center(d)
	local w, h = WorldData.totalSize()
	local x = -w / 2 + (d.Col - 0.5) * WorldData.CellSize
	local z = -h / 2 + (d.Row - 0.5) * WorldData.CellSize
	return x, z
end

function WorldData.districtAt(x, z)
	local w, h = WorldData.totalSize()
	local col = math.floor((x + w / 2) / WorldData.CellSize) + 1
	local row = math.floor((z + h / 2) / WorldData.CellSize) + 1
	for _, d in ipairs(D) do
		if d.Col == col and d.Row == row then
			return d
		end
	end
	return nil
end

-- Lista plana de lugares de grabación con posición absoluta.
WorldData.Spots = {}
for _, d in ipairs(D) do
	local cx, cz = WorldData.center(d)
	for i, s in ipairs(d.Spots) do
		local spot = {
			Id = d.Id .. "_" .. i,
			Name = s.Name,
			District = d.Id,
			X = cx + s.X,
			Z = cz + s.Z,
			Tags = s.Tags,
			Interest = s.Interest or 6,
			Noise = s.Noise or d.Noise or 3,
			Busy = s.Busy or d.Busy or 3,
			Indoor = s.Indoor or false,
		}
		WorldData.Spots[#WorldData.Spots + 1] = spot
	end
end

-- Lugares secretos: se descubren al acercarse.
WorldData.Secrets = {
	{ Id = "sec_peak", Name = "Mirador escondido", District = "mountains", X = -110, Z = -110, Reward = 250, Hint = "Lo más alto y apartado de las montañas." },
	{ Id = "sec_studio", Name = "Estudio abandonado", District = "industrial", X = -110, Z = 110, Reward = 300, Hint = "Una nave olvidada en la esquina del distrito industrial." },
	{ Id = "sec_cave", Name = "Cueva del lago", District = "lake", X = 115, Z = -110, Reward = 250, Hint = "Detrás de los árboles, al otro lado del lago." },
	{ Id = "sec_cove", Name = "Cala secreta", District = "beach", X = 120, Z = -115, Reward = 250, Hint = "Un rincón de la playa que casi nadie visita." },
	{ Id = "sec_garden", Name = "Jardín oculto", District = "luxury", X = -115, Z = 115, Reward = 300, Hint = "Tras las mansiones hay un jardín privado... ¿o no tanto?" },
	{ Id = "sec_arcade", Name = "Recreativa legendaria", District = "entertainment", X = 115, Z = 115, Reward = 300, Hint = "Una máquina de juegos que nadie recuerda." },
	{ Id = "sec_forest", Name = "Árbol milenario", District = "forest", X = -115, Z = 110, Reward = 250, Hint = "El árbol más viejo del bosque." },
	{ Id = "sec_dock", Name = "Barco fantasma", District = "port", X = 120, Z = -110, Reward = 300, Hint = "Un barco que nunca zarpa." },
}
for _, s in ipairs(WorldData.Secrets) do
	local cx, cz = WorldData.center(WorldData.DistrictById[s.District])
	s.WX = cx + s.X
	s.WZ = cz + s.Z
	-- El secreto también es un lugar de grabación especial
	WorldData.Spots[#WorldData.Spots + 1] = { Id = s.Id, Name = s.Name, District = s.District, X = s.WX, Z = s.WZ,
		Tags = { "tourism", "fun" }, Interest = 15, Noise = 1, Busy = 0, Indoor = false, Secret = true }
end

WorldData.SpotById = {}
for _, s in ipairs(WorldData.Spots) do
	WorldData.SpotById[s.Id] = s
end

-- Lista de edificios especiales con posición absoluta.
WorldData.Specials = {}
for _, d in ipairs(D) do
	local cx, cz = WorldData.center(d)
	for _, sp in ipairs(d.Specials or {}) do
		local s = {}
		for k, v in pairs(sp) do
			s[k] = v
		end
		s.District = d.Id
		s.WX = cx + sp.X
		s.WZ = cz + sp.Z
		WorldData.Specials[#WorldData.Specials + 1] = s
	end
end

WorldData.SpawnDistrict = "budget"

return WorldData
]]></ProtectedString></Properties></Item></Item></Item><Item class="ServerScriptService" referent="RBX000048"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Folder" referent="RBX000020"><Properties><string name="Name">Server</string></Properties><Item class="Script" referent="RBX000021"><Properties><string name="Name">Main</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Main (Script de servidor): arranca todos los servicios en orden y gestiona la entrada de jugadores.

local Players = game:GetService("Players")
local Services = script.Parent:WaitForChild("Services")

local S = {}
local order = {
	{ "Net", "Net" },
	{ "Text", "TextFilter" },
	{ "Data", "DataService" },
	{ "Time", "TimeWeatherService" },
	{ "Economy", "EconomyService" },
	{ "Monetization", "MonetizationService" },
	{ "Progress", "ProgressService" },
	{ "Quest", "QuestService" },
	{ "Inventory", "InventoryService" },
	{ "Computer", "ComputerService" },
	{ "Shop", "ShopService" },
	{ "Travel", "TravelService" },
	{ "Property", "PropertyService" },
	{ "World", "WorldBuilder" },
	{ "Home", "HomeService" },
	{ "Avatar", "AvatarService" },
	{ "Needs", "NeedsService" },
	{ "Events", "EventService" },
	{ "Sponsor", "SponsorService" },
	{ "Live", "LiveService" },
	{ "Video", "VideoService" },
	{ "Channel", "ChannelService" },
	{ "Jobs", "JobsService" },
	{ "NPC", "NPCService" },
	{ "Sync", "SyncService" },
}

for _, entry in ipairs(order) do
	S[entry[1]] = require(Services:WaitForChild(entry[2]))
end
for _, entry in ipairs(order) do
	S[entry[1]].Init(S)
end
for _, entry in ipairs(order) do
	local ok, err = true, nil
	if S[entry[1]].Start then
		ok, err = pcall(S[entry[1]].Start)
	end
	if not ok then
		warn("[YTLife] Error al iniciar " .. entry[2] .. ": " .. tostring(err))
	end
end

local Catalog = require(game:GetService("ReplicatedStorage").Shared.ItemCatalog)
local Config = require(game:GetService("ReplicatedStorage").Shared.Config)

local function giveStarterKit(player)
	local data = S.Data.get(player)
	local phone = S.Inventory.add(player, "phone_basic", { src = "starter", paid = 0 })
	data.Equipped.Phone = phone
	S.Inventory.add(player, "tripod_basic", { src = "starter", paid = 10 })
	S.Inventory.add(player, "mon_22", { src = "starter", paid = 40 })
	S.Inventory.add(player, "kb_basic", { src = "starter", paid = 5 })
	S.Inventory.add(player, "mouse_basic", { src = "starter", paid = 5 })
	S.Inventory.add(player, "chair_basic", { src = "starter", paid = 15 })
	S.Computer.createRigFromPrebuilt(player, Catalog.get("pc_old"), { src = "starter", paid = 150 })
	data.Counters.items_bought = 0
	S.Net.notify(player, "📱 Recibiste un teléfono básico y una habitación con un computador viejo.", "success")
end

local function onPlayerAdded(player)
	player.CharacterAdded:Connect(function(char)
		if S.Data.get(player) then
			S.Avatar.onCharacter(player, char)
		end
	end)
	local profile = S.Data.load(player)
	if not profile or not player.Parent then
		return
	end
	S.Monetization.onPlayerReady(player)
	S.Home.onPlayerReady(player)
	local data = profile.Data
	if next(data.Inventory) == nil then
		giveStarterKit(player)
	end
	-- Crecimiento de los vídeos mientras estaba desconectado (limitado)
	S.Channel.tickPlayer(player, Config.OfflineCatchUpHours * 3600)
	data.LastSeen = os.time()
	S.Shop.processOrders(player)
	pcall(S.Sponsor.refreshOffers, player)
	S.Quest.check(player)
	if player.Character then
		task.spawn(S.Avatar.onCharacter, player, player.Character)
	end
	S.Sync.send(player)
	S.Net.push(player, "ready", { isNew = profile.IsNew, readOnly = profile.ReadOnly })
	if profile.ReadOnly then
		S.Net.notify(player, "Modo de prueba en Studio: el progreso NO se guardará. Activa «Enable Studio Access to API Services» para guardar.", "warn")
	end
end

Players.PlayerAdded:Connect(function(player)
	local ok, err = pcall(onPlayerAdded, player)
	if not ok then
		S.Net.logError("PlayerAdded", err)
	end
end)
for _, player in ipairs(Players:GetPlayers()) do
	task.spawn(onPlayerAdded, player)
end

Players.PlayerRemoving:Connect(function(player)
	S.Computer.close(player)
	S.Data.release(player)
end)

print("[YTLife] Servidor listo: " .. Config.GameName .. " v" .. Config.Version)
]]></ProtectedString></Properties></Item><Item class="Folder" referent="RBX000022"><Properties><string name="Name">Services</string></Properties><Item class="ModuleScript" referent="RBX000023"><Properties><string name="Name">AvatarService</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- AvatarService: aparición en casa, apariencia (colores de ropa) y cartel sobre la cabeza
-- (nombre, rango, título y suscriptores). Respeta el avatar de Roblox si el jugador lo prefiere.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage.Shared
local Util = require(Shared.Util)
local VideoData = require(Shared.VideoData)

local Avatar = {}
local S

-- Colores disponibles para ropa (no se cambia el tono de piel)
Avatar.Colors = {
	{ 240, 240, 240 }, { 30, 30, 35 }, { 200, 40, 40 }, { 40, 90, 200 }, { 50, 160, 90 }, { 250, 200, 40 },
	{ 255, 120, 0 }, { 140, 70, 200 }, { 255, 110, 170 }, { 120, 85, 60 }, { 90, 100, 110 }, { 0, 170, 190 },
}

function Avatar.Init(services)
	S = services
end

local function rgb(t)
	return Color3.fromRGB(t[1], t[2], t[3])
end

function Avatar.applyAppearance(player)
	local data = S.Data.get(player)
	local char = player.Character
	if not data or not char then
		return
	end
	local a = data.Appearance
	if a.Mode ~= "custom" then
		return
	end
	for _, c in ipairs(char:GetChildren()) do
		if c:IsA("Shirt") or c:IsA("Pants") or c:IsA("ShirtGraphic") then
			c:Destroy()
		end
	end
	local shirt = rgb(Avatar.Colors[a.Shirt] or Avatar.Colors[5])
	local pants = rgb(Avatar.Colors[a.Pants] or Avatar.Colors[2])
	for _, part in ipairs(char:GetChildren()) do
		if part:IsA("BasePart") then
			local n = part.Name
			if n == "UpperTorso" or n == "LowerTorso" or n == "Torso" or n:find("UpperArm") or n == "Left Arm" or n == "Right Arm" then
				part.Color = shirt
			elseif n:find("Leg") or n:find("Foot") then
				part.Color = pants
			end
		end
	end
	local bc = char:FindFirstChildOfClass("BodyColors")
	if bc then
		bc.TorsoColor3 = shirt
		bc.LeftLegColor3 = pants
		bc.RightLegColor3 = pants
	end
end

function Avatar.refreshOverhead(player)
	local data = S.Data.get(player)
	local char = player.Character
	local head = char and char:FindFirstChild("Head")
	if not data or not head then
		return
	end
	local gui = head:FindFirstChild("CreatorTag")
	if not gui then
		gui = Instance.new("BillboardGui")
		gui.Name = "CreatorTag"
		gui.Size = UDim2.fromOffset(220, 64)
		gui.StudsOffset = Vector3.new(0, 2.6, 0)
		gui.MaxDistance = 80
		gui.AlwaysOnTop = false
		gui.Parent = head
		local name = Instance.new("TextLabel")
		name.Name = "NameLabel"
		name.BackgroundTransparency = 1
		name.Size = UDim2.new(1, 0, 0.45, 0)
		name.Font = Enum.Font.GothamBlack
		name.TextScaled = true
		name.TextColor3 = Color3.new(1, 1, 1)
		name.TextStrokeTransparency = 0.4
		name.Parent = gui
		local sub = Instance.new("TextLabel")
		sub.Name = "SubLabel"
		sub.BackgroundTransparency = 1
		sub.Position = UDim2.new(0, 0, 0.45, 0)
		sub.Size = UDim2.new(1, 0, 0.3, 0)
		sub.Font = Enum.Font.GothamBold
		sub.TextScaled = true
		sub.TextColor3 = Color3.fromRGB(255, 214, 0)
		sub.TextStrokeTransparency = 0.5
		sub.Parent = gui
		local title = Instance.new("TextLabel")
		title.Name = "TitleLabel"
		title.BackgroundTransparency = 1
		title.Position = UDim2.new(0, 0, 0.75, 0)
		title.Size = UDim2.new(1, 0, 0.25, 0)
		title.Font = Enum.Font.GothamMedium
		title.TextScaled = true
		title.TextColor3 = Color3.fromRGB(150, 220, 255)
		title.TextStrokeTransparency = 0.5
		title.Parent = gui
	end
	local _, rank = S.Progress.rank(data)
	local channel = data.Channel.Name ~= "" and data.Channel.Name or player.DisplayName
	local vip = S.Monetization.owns(player, "VIP") and "⭐ " or ""
	gui.NameLabel.Text = vip .. VideoData.Avatars[data.Channel.Avatar] .. " " .. channel
	gui.SubLabel.Text = rank.Name .. " · " .. Util.formatShort(data.Channel.Subs) .. " subs"
	gui.TitleLabel.Text = data.EquippedTitle ~= "" and ("«" .. data.EquippedTitle .. "»") or ""
	-- ocultar el nombre por defecto de Roblox
	local hum = char:FindFirstChildOfClass("Humanoid")
	if hum then
		hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	end
end

function Avatar.onCharacter(player, char)
	local hum = char:WaitForChild("Humanoid", 10)
	char:WaitForChild("HumanoidRootPart", 10)
	if not hum then
		return
	end
	hum.WalkSpeed = 18
	local cf = S.Home.spawnCFrame(player)
	if cf then
		task.wait(0.1)
		char:PivotTo(cf)
	end
	Avatar.applyAppearance(player)
	Avatar.refreshOverhead(player)
end

function Avatar.Start()
	local Net = S.Net

	Net.on("Style.Set", function(player, p)
		local data = S.Data.get(player)
		local a = data.Appearance
		if p.mode == "roblox" then
			a.Mode = "roblox"
			a.Chosen = true
			S.Quest.tutorialEvent(player, "appearance")
			player:LoadCharacter()
			return true, "Usarás tu avatar de Roblox."
		end
		local shirt, pants = tonumber(p.shirt), tonumber(p.pants)
		if not shirt or not pants or not Avatar.Colors[shirt] or not Avatar.Colors[pants] then
			return false, "Colores no válidos."
		end
		a.Mode = "custom"
		a.Shirt, a.Pants = shirt, pants
		a.Chosen = true
		Avatar.applyAppearance(player)
		S.Quest.tutorialEvent(player, "appearance")
		return true, "¡Nuevo estilo aplicado!"
	end)

	local settingRules = {
		Music = { "number", 0, 1 }, Sfx = { "number", 0, 1 }, UIScale = { "number", 0.7, 1.4 }, Wallpaper = { "number", 1, 5 },
		ReduceMotion = { "boolean" }, Hints = { "boolean" }, Shadows = { "boolean" },
	}
	Net.on("Settings.Set", function(player, p)
		local data = S.Data.get(player)
		local rule = settingRules[p.key or ""]
		if not rule or type(p.value) ~= rule[1] then
			return false, "Ajuste no válido."
		end
		local v = p.value
		if rule[1] == "number" then
			v = math.clamp(v, rule[2], rule[3])
			if p.key == "Wallpaper" then
				v = math.floor(v)
			end
		end
		data.Settings[p.key] = v
		return true, "Ajuste guardado."
	end)

	Net.on("Style.SaveOutfit", function(player, p)
		local data = S.Data.get(player)
		local slot = tonumber(p.slot)
		if not slot or slot < 1 or slot > 3 then
			return false, "Espacio no válido."
		end
		data.Appearance.Outfits = data.Appearance.Outfits or {}
		data.Appearance.Outfits[tostring(slot)] = { Shirt = data.Appearance.Shirt, Pants = data.Appearance.Pants }
		return true, "Conjunto guardado en el espacio " .. slot .. "."
	end)
end

return Avatar
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000024"><Properties><string name="Name">ChannelService</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- ChannelService: crecimiento progresivo de cada vídeo publicado (visitas, me gusta, comentarios,
-- suscriptores, ingresos), tendencias diarias, competencia, programa de socios y ajustes del canal.
-- Las cifras siguen curvas con límite (VideoFormulas.expectedViews), nunca números aleatorios absurdos.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local VideoData = require(Shared.VideoData)
local F = require(Shared.VideoFormulas)
local Util = require(Shared.Util)

local Channel = {}
local S
local trends = { Hot = {}, Cold = "", Competition = 0.95, Day = 0 }
local commenters = { "AnaVlogs", "PixelPedro", "LuciaTech", "Mateo_Viajes", "SofiCocina", "Leo2010", "CreadorX", "MarioFoto", "NoraGamer", "TomásReseñas", "Valen_Moda", "Diego_Motor" }

function Channel.Init(services)
	S = services
end

function Channel.onNewDay(day)
	trends.Day = day
	local ids = {}
	for _, c in ipairs(VideoData.Categories) do
		ids[#ids + 1] = c.Id
	end
	local hot = {}
	local salt = 0
	while #hot < 3 and salt < 100 do
		local idx = (Util.hashString("hot" .. day .. ":" .. salt) % #ids) + 1
		if not Util.indexOf(hot, ids[idx]) then
			hot[#hot + 1] = ids[idx]
		end
		salt = salt + 1
	end
	trends.Hot = hot
	local cold = ids[(Util.hashString("cold" .. day) % #ids) + 1]
	if Util.indexOf(hot, cold) then
		cold = ""
	end
	trends.Cold = cold
	trends.Competition = Util.seededRandom("comp" .. day, 0.85, 1.0)
	workspace:SetAttribute("TrendHot", table.concat(hot, ","))
	for _, player in ipairs(Players:GetPlayers()) do
		S.Data.markDirty(player)
	end
end

function Channel.trends()
	return trends
end

function Channel.trendFor(categoryId)
	if Util.indexOf(trends.Hot, categoryId) then
		return 1.4
	elseif trends.Cold == categoryId then
		return 0.85
	end
	return 1
end

function Channel.competition()
	return trends.Competition
end

local function pickComment(video, n)
	local pool = video.Q >= 70 and VideoData.Comments.high or (video.Q >= 40 and VideoData.Comments.mid or VideoData.Comments.low)
	local h = Util.hashString(video.Id .. ":" .. n)
	return { U = commenters[(h % #commenters) + 1], Txt = pool[(math.floor(h / 7) % #pool) + 1] }
end

-- Avanza las estadísticas de todos los vídeos del jugador hasta "ahora" (máximo `capSeconds` de retraso).
function Channel.tickPlayer(player, capSeconds)
	local data = S.Data.get(player)
	if not data then
		return
	end
	local now = os.time()
	local ch = data.Channel
	local partner = ch.Monetized
	local totalRevenue, totalNew = 0, 0
	for _, v in ipairs(data.Videos) do
		local age = now - v.At
		if capSeconds and data.LastSeen > 0 and v.At < data.LastSeen then
			-- recuperación tras estar desconectado: se limita el tiempo que cuenta
			local offline = now - data.LastSeen
			if offline > capSeconds then
				age = age - (offline - capSeconds)
			end
		end
		local minutes = math.max(0, age / 60)
		local target = v.Expected * F.viewCurve(minutes, Config.ViewCurveMinutes)
		-- cola larga: vídeos de calidad siguen sumando un poco durante varios días
		local days = minutes / (Config.DayLengthSeconds / 60)
		if v.Q >= 50 then
			target = target + v.Expected * 0.05 * math.min(days, 7) * (v.Q / 100)
		end
		target = math.floor(target)
		local new = target - v.Views
		if new > 0 then
			v.Views = target
			totalNew = totalNew + new
			local rate = F.likeRate(v.Q)
			v.Likes = math.floor(v.Views * rate)
			local comments = math.floor(v.Views * 0.004)
			while v.Comments < comments do
				v.Comments = v.Comments + 1
				if #v.CommentList < 6 then
					table.insert(v.CommentList, pickComment(v, v.Comments))
				end
			end
			local subs = new * F.subConversion(v.Q) * (v.SubMult or 1)
			ch.SubFrac = ch.SubFrac + subs
			local whole = math.floor(ch.SubFrac)
			ch.SubFrac = ch.SubFrac - whole
			ch.Subs = ch.Subs + whole
			v.SubsGained = (v.SubsGained or 0) + whole
			local rev = new * F.revenuePerView(v.Cat, partner) * (v.RpmMult or 1)
			if v.Unlisted then
				rev = 0
			end
			v.Revenue = Util.round((v.Revenue or 0) + rev, 2)
			totalRevenue = totalRevenue + rev
			ch.TotalViews = ch.TotalViews + new
		end
		-- historial (un punto cada 2 minutos durante las primeras horas)
		local slot = math.floor(minutes / 2)
		if slot < Config.HistoryPoints and (#v.Hist <= slot) then
			while #v.Hist <= slot do
				table.insert(v.Hist, v.Views)
			end
		end
	end
	ch.PendingRev = (ch.PendingRev or 0) + totalRevenue
	if ch.PendingRev >= 1 then
		local pay = math.floor(ch.PendingRev)
		ch.PendingRev = ch.PendingRev - pay
		ch.TotalRevenue = ch.TotalRevenue + pay
		S.Economy.add(player, pay, "Ingresos de vídeos", partner and "Publicidad del canal" or "Fondo para creadores", { taxable = true, silent = pay < 5 })
	end
	if not ch.Monetized and ch.Subs >= Config.PartnerSubs and (data.Counters.published or 0) >= Config.PartnerVideos then
		ch.Monetized = true
		S.Net.notify(player, "🎉 ¡Ya eres socio del programa de creadores! Tus vídeos ganan más por cada visita.", "success")
	end
	if totalNew > 0 then
		S.Data.markDirty(player)
		S.Quest.check(player)
	end
end

function Channel.Start()
	Channel.onNewDay(S.Time.day())
	local Net = S.Net

	Net.on("Channel.Update", function(player, p)
		local data = S.Data.get(player)
		local ch = data.Channel
		if p.name ~= nil then
			local name = Util.cleanText(p.name, 30)
			if not name or #name < 3 then
				return false, "El nombre del canal necesita al menos 3 caracteres."
			end
			local f = S.Text.filter(player, name)
			if not f then
				return false, "Ese nombre no está permitido."
			end
			ch.Name = f
		end
		if p.description ~= nil then
			local d = Util.cleanText(p.description, 200) or ""
			local f = S.Text.filter(player, d)
			if not f then
				return false, "No se pudo comprobar la descripción."
			end
			ch.Description = f
		end
		local banners = #VideoData.Banners
		local avatars = #VideoData.Avatars
		if tonumber(p.banner) then
			ch.Banner = Util.clamp(math.floor(tonumber(p.banner)), 1, banners)
		end
		if tonumber(p.avatar) then
			ch.Avatar = Util.clamp(math.floor(tonumber(p.avatar)), 1, avatars)
		end
		S.Avatar.refreshOverhead(player)
		return true, "Canal actualizado."
	end)

	Net.on("Channel.OpenAnalytics", function(player)
		S.Quest.tutorialEvent(player, "open_analytics")
		return true
	end)

	task.spawn(function()
		while true do
			task.wait(Config.StatsTickSeconds)
			for _, player in ipairs(Players:GetPlayers()) do
				local ok, err = pcall(Channel.tickPlayer, player)
				if not ok then
					S.Net.logError("channel", err)
				end
			end
		end
	end)
end

return Channel
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000025"><Properties><string name="Name">ComputerService</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- ComputerService: montajes de PC (rigs), sesiones de computador y rendimiento real.
-- Un rig es un conjunto de piezas del inventario (uids) instaladas juntas. Comprar un PC completo crea un rig
-- con piezas reales, que se puede desmontar, mejorar o vender por piezas.
-- Solo las piezas reconocidas por PCBuild afectan al rendimiento.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local Shared = ReplicatedStorage.Shared
local Catalog = require(Shared.ItemCatalog)
local PCBuild = require(Shared.PCBuild)
local Util = require(Shared.Util)

local Computer = {}
local S
local sessions = {} -- [player] = { Kind = "home"|"public"|"laptop", Pos = Vector3?, Uid = laptop uid }

Computer.MaxRigs = 4
Computer.SessionRadius = 16

function Computer.Init(services)
	S = services
end

local function rigLoc(rigId)
	return "rig:" .. rigId
end

-- Convierte un rig (uids) en IDs de catálogo para PCBuild
function Computer.rigParts(player, rig)
	local data = S.Data.get(player)
	local out = {}
	local condSum, condN = 0, 0
	for slot, v in pairs(rig.Parts) do
		if type(v) == "table" then
			out[slot] = {}
			for _, uid in ipairs(v) do
				local rec = data.Inventory[uid]
				if rec then
					table.insert(out[slot], rec.Id)
					condSum = condSum + rec.Cond
					condN = condN + 1
				end
			end
		else
			local rec = data.Inventory[v]
			if rec then
				out[slot] = rec.Id
				condSum = condSum + rec.Cond
				condN = condN + 1
			end
		end
	end
	local cond = condN > 0 and condSum / condN or 100
	return out, 0.85 + 0.15 * cond / 100
end

function Computer.rigStats(player, rigId)
	local data = S.Data.get(player)
	local rig = data.Rigs[rigId]
	if not rig then
		return nil
	end
	local parts, cf = Computer.rigParts(player, rig)
	local ok = PCBuild.validate(parts)
	if not ok then
		return nil
	end
	return PCBuild.stats(parts, cf)
end

function Computer.createRigFromPrebuilt(player, def, opts)
	local data = S.Data.get(player)
	if Util.count(data.Rigs) >= Computer.MaxRigs then
		S.Net.notify(player, "Ya tienes " .. Computer.MaxRigs .. " computadores montados: las piezas se guardarán sueltas en casa.", "warn")
	end
	opts = opts or {}
	local rigId = S.Data.nextUid(player, "r")
	local partsValue = 0
	for _, v in pairs(def.Parts) do
		if type(v) == "table" then
			for _, id in ipairs(v) do
				partsValue = partsValue + Catalog.get(id).Price
			end
		else
			partsValue = partsValue + Catalog.get(v).Price
		end
	end
	local ratio = (opts.paid or def.Price) / math.max(1, partsValue)
	local canMount = Util.count(data.Rigs) < Computer.MaxRigs
	local rig = { Name = def.Name, Parts = {}, From = def.Id }
	for slot, v in pairs(def.Parts) do
		local ids = type(v) == "table" and v or { v }
		local uids = {}
		for _, id in ipairs(ids) do
			local uid = S.Inventory.add(player, id, { src = opts.src or "shop", paid = math.floor(Catalog.get(id).Price * ratio + 0.5), loc = "home" })
			if uid then
				if canMount then
					data.Inventory[uid].Loc = rigLoc(rigId)
				end
				uids[#uids + 1] = uid
			end
		end
		if type(v) == "table" then
			rig.Parts[slot] = uids
		else
			rig.Parts[slot] = uids[1]
		end
	end
	if not canMount then
		return nil
	end
	data.Rigs[rigId] = rig
	if data.ActiveRig == "" or not data.Rigs[data.ActiveRig] then
		data.ActiveRig = rigId
	end
	S.Home.refreshRoom(player)
	return rigId
end

-- Estadísticas del puesto de trabajo de la sesión actual (incluye periféricos de casa)
function Computer.sessionStats(player)
	local s = sessions[player]
	if not s then
		return nil
	end
	local data = S.Data.get(player)
	local stats
	if s.Kind == "home" then
		stats = Computer.rigStats(player, data.ActiveRig) or PCBuild.publicStats()
	elseif s.Kind == "laptop" then
		local rec, def = S.Inventory.get(player, s.Uid)
		stats = def and PCBuild.laptopStats(def, S.Inventory.condFactor(rec)) or PCBuild.publicStats()
	else
		stats = PCBuild.publicStats()
	end
	stats.Kind = s.Kind
	-- Periféricos y mobiliario (solo cuentan en casa)
	stats.ColorAcc, stats.Screens, stats.EditSpeed, stats.Comfort, stats.AudioMix = 40, 1, 0, 0, 0
	if s.Kind == "home" then
		local mon = S.Inventory.bestCatAtHome(player, "monitor", nil, "ColorAcc")
		if mon then
			stats.ColorAcc = mon.Stats.ColorAcc
			stats.Screens = mon.Stats.Screens
		end
		for _, sub in ipairs({ "Teclado", "Ratón", "Alfombrilla" }) do
			local d = S.Inventory.bestCatAtHome(player, "peripheral", sub, "EditSpeed")
			if d then
				stats.EditSpeed = stats.EditSpeed + d.Stats.EditSpeed
			end
		end
		stats.EditSpeed = stats.EditSpeed + (stats.Screens - 1) * 4
		local chair = S.Inventory.bestCatAtHome(player, "furniture", "Silla", "Comfort")
		local desk = S.Inventory.bestCatAtHome(player, "furniture", "Escritorio", "Comfort")
		stats.Comfort = (chair and chair.Stats.Comfort or 0) + (desk and desk.Stats.Comfort or 0)
		local head = S.Inventory.bestCatAtHome(player, "peripheral", "Auriculares", "AudioMix")
		local spk = S.Inventory.bestCatAtHome(player, "peripheral", "Altavoces", "AudioMix")
		stats.AudioMix = math.max(head and head.Stats.AudioMix or 0, spk and spk.Stats.AudioMix or 0)
	elseif s.Kind == "laptop" then
		stats.ColorAcc = 60
		stats.AudioMix = 20
	end
	-- Almacenamiento externo (en casa o en la mochila según dónde estés)
	local where = s.Kind == "home" and "home" or "backpack"
	for _, rec in pairs(data.Inventory) do
		local def = Catalog.get(rec.Id)
		if def and def.Slot == "external" and (rec.Loc == where) then
			stats.StorageGb = stats.StorageGb + def.Stats.Gb
		end
	end
	-- Tableta Pro: edición ligera
	return stats
end

function Computer.storageUsed(player)
	local data = S.Data.get(player)
	local used = 0
	for _, proj in pairs(data.Projects) do
		for _, sc in ipairs(proj.Scenes) do
			if sc.Imported then
				used = used + (sc.Gb or 0)
			end
		end
	end
	return math.floor(used * 10 + 0.5) / 10
end

function Computer.hasSession(player)
	local s = sessions[player]
	if not s then
		return false
	end
	if s.Kind == "laptop" then
		local rec = S.Inventory.get(player, s.Uid)
		if not rec or (rec.Loc ~= "backpack" and not S.Home.isAtHome(player)) then
			sessions[player] = nil
			return false
		end
		return true
	end
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if not root or (root.Position - s.Pos).Magnitude > Computer.SessionRadius then
		sessions[player] = nil
		S.Net.push(player, "closeComputer", {})
		return false
	end
	return true
end

function Computer.session(player)
	if Computer.hasSession(player) then
		return sessions[player]
	end
	return nil
end

function Computer.open(player, kind, pos, uid)
	sessions[player] = { Kind = kind, Pos = pos, Uid = uid }
	S.Quest.tutorialEvent(player, "open_computer")
	S.Net.push(player, "openComputer", { kind = kind, stats = Computer.sessionStats(player) })
	S.Data.markDirty(player)
end

function Computer.close(player)
	sessions[player] = nil
end

-- Lo llama WorldBuilder/Home cuando se activa el aviso de un escritorio.
function Computer.onPrompt(player, part, kind, ownerUserId)
	if kind == "home" and ownerUserId ~= player.UserId then
		S.Net.notify(player, "Este no es tu computador.", "error")
		return
	end
	Computer.open(player, kind, part.Position)
end

local function validateRigInput(player, parts, rigId)
	local data = S.Data.get(player)
	if type(parts) ~= "table" then
		return nil, "Montaje no válido."
	end
	local used = {}
	local ids, uidParts = {}, {}
	for _, slot in ipairs(PCBuild.Slots) do
		local v = parts[slot.Key]
		local list = {}
		if slot.Multi then
			if v ~= nil and type(v) ~= "table" then
				return nil, "Montaje no válido."
			end
			list = v or {}
			if #list > 8 then
				return nil, "Demasiadas piezas."
			end
		elseif v ~= nil then
			list = { v }
		end
		local slotIds, slotUids = {}, {}
		for _, uid in ipairs(list) do
			if type(uid) ~= "string" or used[uid] then
				return nil, "Pieza repetida o no válida."
			end
			used[uid] = true
			local rec = data.Inventory[uid]
			if not rec then
				return nil, "No tienes una de las piezas."
			end
			if rec.Loc ~= "home" and rec.Loc ~= rigLoc(rigId or "") then
				return nil, Catalog.get(rec.Id).Name .. " no está disponible en casa (está en la mochila o en otro PC)."
			end
			slotIds[#slotIds + 1] = rec.Id
			slotUids[#slotUids + 1] = uid
		end
		if slot.Multi then
			ids[slot.Key] = slotIds
			uidParts[slot.Key] = slotUids
		else
			ids[slot.Key] = slotIds[1]
			uidParts[slot.Key] = slotUids[1]
		end
	end
	local ok, errors, warnings = PCBuild.validate(ids)
	if not ok then
		return nil, "No se puede montar: " .. table.concat(errors, " ")
	end
	return uidParts, nil, warnings
end

function Computer.Start()
	local Net = S.Net

	Net.on("PC.OpenLaptop", function(player, p)
		local uid = S.Inventory.best(player, "laptop", "backpack", "CpuScore")
		if not uid and S.Home.isAtHome(player) then
			uid = S.Inventory.best(player, "laptop", "home", "CpuScore")
		end
		if not uid then
			return false, "No llevas un portátil en la mochila."
		end
		Computer.open(player, "laptop", nil, uid)
		return true
	end)

	Net.on("PC.Close", function(player)
		Computer.close(player)
		return true
	end)

	Net.on("PC.Stats", function(player)
		if not Computer.hasSession(player) then
			return false, "No estás usando un computador."
		end
		return true, nil, { stats = Computer.sessionStats(player), used = Computer.storageUsed(player) }
	end)

	Net.on("PC.SaveRig", function(player, p)
		local data = S.Data.get(player)
		if not S.Home.isAtHome(player) then
			return false, "Monta tus computadores en casa."
		end
		local rigId = p.rigId
		if rigId ~= nil and not data.Rigs[rigId] then
			return false, "Ese computador no existe."
		end
		if rigId == nil and Util.count(data.Rigs) >= Computer.MaxRigs then
			return false, "Máximo " .. Computer.MaxRigs .. " computadores montados."
		end
		local uidParts, err, warnings = validateRigInput(player, p.parts, rigId)
		if not uidParts then
			return false, err
		end
		local isNew = rigId == nil
		if isNew then
			rigId = S.Data.nextUid(player, "r")
			data.Rigs[rigId] = { Name = "PC personalizado", Parts = {}, From = "custom" }
		end
		local rig = data.Rigs[rigId]
		-- liberar piezas anteriores
		for _, rec in pairs(data.Inventory) do
			if rec.Loc == rigLoc(rigId) then
				rec.Loc = "home"
			end
		end
		for _, v in pairs(uidParts) do
			if type(v) == "table" then
				for _, uid in ipairs(v) do
					data.Inventory[uid].Loc = rigLoc(rigId)
				end
			elseif v then
				data.Inventory[v].Loc = rigLoc(rigId)
			end
		end
		rig.Parts = uidParts
		local name = Util.cleanText(p.name, 30)
		if name and #name > 0 then
			rig.Name = S.Text.filter(player, name) or rig.Name
		end
		if isNew then
			data.Counters.pcs_built = (data.Counters.pcs_built or 0) + 1
			S.Progress.addXp(player, S.Progress.Xp.PCBuilt)
			S.Quest.check(player)
		end
		if data.ActiveRig == "" or not data.Rigs[data.ActiveRig] then
			data.ActiveRig = rigId
		end
		S.Home.refreshRoom(player)
		local msg = isNew and "¡Computador montado!" or "Computador actualizado."
		if warnings and #warnings > 0 then
			msg = msg .. " Aviso: " .. table.concat(warnings, " ")
		end
		return true, msg, { rigId = rigId, stats = Computer.rigStats(player, rigId) }
	end)

	Net.on("PC.Disassemble", function(player, p)
		local data = S.Data.get(player)
		if not S.Home.isAtHome(player) then
			return false, "Desmonta tus computadores en casa."
		end
		local rig = data.Rigs[p.rigId]
		if not rig then
			return false, "Ese computador no existe."
		end
		for _, rec in pairs(data.Inventory) do
			if rec.Loc == rigLoc(p.rigId) then
				rec.Loc = "home"
			end
		end
		data.Rigs[p.rigId] = nil
		if data.ActiveRig == p.rigId then
			data.ActiveRig = next(data.Rigs) or ""
		end
		S.Home.refreshRoom(player)
		return true, "Computador desmontado: las piezas están en casa."
	end)

	Net.on("PC.SetActive", function(player, p)
		local data = S.Data.get(player)
		if not data.Rigs[p.rigId] then
			return false, "Ese computador no existe."
		end
		data.ActiveRig = p.rigId
		S.Home.refreshRoom(player)
		return true, "Ahora usas " .. data.Rigs[p.rigId].Name .. " en tu escritorio."
	end)

	local lastBench = {}
	Net.on("PC.Benchmark", function(player, p)
		local data = S.Data.get(player)
		local stats = Computer.rigStats(player, p.rigId)
		if not stats then
			return false, "Ese computador no es válido."
		end
		if lastBench[player] and os.clock() - lastBench[player] < 5 then
			return false, "Espera a que termine la prueba anterior."
		end
		lastBench[player] = os.clock()
		local points = math.floor(stats.Score * 137 * (0.97 + math.random() * 0.06))
		data.Counters.benchmarks = (data.Counters.benchmarks or 0) + 1
		S.Quest.check(player)
		return true, "Prueba completada: " .. Util.formatInt(points) .. " puntos.", { points = points, stats = stats }
	end)

	Players.PlayerRemoving:Connect(function(player)
		sessions[player] = nil
		lastBench[player] = nil
	end)
end

return Computer
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000026"><Properties><string name="Name">DataService</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- DataService: carga y guardado seguro con DataStoreService.
--  * Reintentos limitados con espera creciente.
--  * Bloqueo de sesión: si otro servidor tiene los datos abiertos, se espera en lugar de sobrescribir.
--  * Si la carga falla en un servidor real, NUNCA se guarda encima: el jugador es expulsado con un mensaje claro.
--  * En Studio sin acceso a API, se usa un perfil temporal que no se guarda (modo de prueba).
--  * Guardado automático, al salir y al cerrar el servidor.

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Util = require(Shared.Util)

local DataService = {}
local S
local profiles = {}
local dirty = {}
local store = nil
local SCHEMA_VERSION = 1

DataService.Template = {
	Version = SCHEMA_VERSION,
	Money = Config.StartingMoney,
	LifetimeEarned = 0,
	XP = 0,
	Level = 1,
	Reputation = 10,
	BizRep = 50,
	Channel = { Name = "", Description = "", Banner = 1, Avatar = 1, Subs = 0, SubFrac = 0, TotalViews = 0, TotalRevenue = 0, Monetized = false },
	Inventory = {},
	Equipped = { Phone = "" },
	Rigs = {},
	ActiveRig = "",
	Orders = {},
	Processed = {},
	ProcessedOrder = {},
	Transactions = {},
	Monthly = {},
	Bank = { Savings = 0, Loan = 0, LoanRate = 0.1, Goals = {}, LastInterestDay = 0 },
	Projects = {},
	Photos = {},
	Albums = { "General", "Miniaturas", "Personal" },
	Thumbnails = {},
	Videos = {},
	Counters = {},
	Visited = { Districts = {}, Recorded = {}, Stores = {}, Categories = {}, Secrets = {}, Cameras = {} },
	Quests = { Completed = {}, Claimed = {}, Step = 1, StepProgress = 0, Skipped = false },
	Titles = {},
	EquippedTitle = "",
	Home = { Type = "room_cheap", Rent = Config.StarterRent, PlayDays = 0, NextDue = Config.RentPeriodDays, Debt = 0, Missed = 0, Paid = 0 },
	Appearance = { Shirt = 5, Pants = 2, Chosen = false },
	Settings = { Music = 0.5, Sfx = 0.7, ReduceMotion = false, UIScale = 1, Wallpaper = 1, Hints = true, Shadows = true },
	Receipts = {},
	ReceiptOrder = {},
	ExportTokens = 0,
	Job = {},
	Properties = {},
	HomeProperty = "",
	Sponsors = { Offers = {}, Active = {}, History = {}, Seq = 0, OffersDay = -1 },
	EventProg = { Day = 0, Done = {}, Scenes = 0, Published = 0, Joined = false },
	Lives = {},
	Needs = { Energy = 100, Mood = 70 },
	FoodOrders = {},
	Posts = {},
	Series = {},
	LastLive = 0,
	LastPost = 0,
	Uid = 0,
	CreatedAt = 0,
	LastSeen = 0,
}

function DataService.Init(services)
	S = services
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(Config.DataStoreName)
	end)
	if ok then
		store = result
	else
		warn("[YTLife] DataStore no disponible: " .. tostring(result))
	end
end

local function lockIsForeign(lock)
	return lock ~= nil and lock.Job ~= game.JobId and (os.time() - (lock.T or 0)) < Config.SessionLockTimeout
end

local function migrate(data)
	-- Aquí se añadirán migraciones cuando cambie el esquema (data.Version < SCHEMA_VERSION).
	Util.reconcile(data, DataService.Template)
	data.Version = SCHEMA_VERSION
	return data
end

-- Devuelve data, estado ("ok" | "new" | "locked" | "error")
local function tryLoad(key)
	local status = "error"
	local loaded = nil
	local ok, err = pcall(function()
		store:UpdateAsync(key, function(old)
			if old ~= nil and lockIsForeign(old.__lock) then
				status = "locked"
				return nil -- cancela la escritura
			end
			if old == nil then
				status = "new"
				old = Util.deepCopy(DataService.Template)
				old.CreatedAt = os.time()
			else
				status = "ok"
			end
			old.__lock = { Job = game.JobId, T = os.time() }
			loaded = old
			return old
		end)
	end)
	if not ok then
		return nil, "error", err
	end
	return loaded, status
end

function DataService.load(player)
	local key = "u_" .. player.UserId
	local data, status, lastErr
	if store then
		for attempt = 1, Config.LoadRetries do
			data, status, lastErr = tryLoad(key)
			if data then
				break
			end
			if not player.Parent then
				return
			end
			task.wait(attempt * 2 + (status == "locked" and 4 or 0))
		end
	end

	local readOnly = false
	if not data then
		if RunService:IsStudio() then
			-- Modo de prueba: perfil temporal que NO se guarda.
			data = Util.deepCopy(DataService.Template)
			data.CreatedAt = os.time()
			readOnly = true
			warn("[YTLife] Studio: usando perfil temporal (activa 'Studio Access to API Services' para guardar). " .. tostring(lastErr or status))
		else
			S.Net.logError("load " .. player.UserId, tostring(lastErr or status))
			player:Kick("No se pudieron cargar tus datos de forma segura (" .. tostring(status) .. "). Tu progreso está a salvo: vuelve a entrar en unos minutos.")
			return
		end
	end
	if not player.Parent then
		-- Se fue durante la carga: liberar el bloqueo sin cambiar nada más.
		if not readOnly then
			pcall(function()
				store:UpdateAsync(key, function(old)
					if old and old.__lock and old.__lock.Job == game.JobId then
						old.__lock = nil
						return old
					end
					return nil
				end)
			end)
		end
		return
	end

	data.__lock = nil
	migrate(data)
	local isNew = status == "new" or readOnly
	profiles[player] = { Data = data, ReadOnly = readOnly, Key = key, IsNew = isNew, LoadedAt = os.time() }
	return profiles[player]
end

-- Recorta listas para no superar el límite de tamaño del DataStore.
local function trimForSize(data)
	local ok, json = pcall(HttpService.JSONEncode, HttpService, data)
	if ok and #json > 3500000 then
		while #data.Videos > 50 do
			table.remove(data.Videos)
		end
		while #data.Photos > 60 do
			table.remove(data.Photos)
		end
		while #data.Transactions > 50 do
			table.remove(data.Transactions)
		end
	end
end

function DataService.save(player, release)
	local profile = profiles[player]
	if not profile or profile.ReadOnly or not store then
		return true
	end
	local data = profile.Data
	data.LastSeen = os.time()
	trimForSize(data)
	local success = false
	for attempt = 1, 3 do
		local ok, err = pcall(function()
			store:UpdateAsync(profile.Key, function(old)
				if old ~= nil and lockIsForeign(old.__lock) then
					-- Otro servidor tiene la sesión: no sobrescribir.
					return nil
				end
				local copy = data
				copy.__lock = (not release) and { Job = game.JobId, T = os.time() } or nil
				return copy
			end)
		end)
		data.__lock = nil
		if ok then
			success = true
			break
		end
		S.Net.logError("save " .. player.UserId, err)
		task.wait(attempt)
	end
	return success
end

function DataService.get(player)
	local p = profiles[player]
	return p and p.Data or nil
end

function DataService.getProfile(player)
	return profiles[player]
end

function DataService.isNew(player)
	local p = profiles[player]
	return p ~= nil and p.IsNew
end

function DataService.markDirty(player)
	dirty[player] = true
end

function DataService.nextUid(player, prefix)
	local data = DataService.get(player)
	data.Uid = data.Uid + 1
	return (prefix or "i") .. data.Uid
end

function DataService.release(player)
	if profiles[player] then
		DataService.save(player, true)
		profiles[player] = nil
		dirty[player] = nil
	end
end

function DataService.Start()
	-- Sincronización con el cliente (agrupa cambios cada 0,3 s)
	task.spawn(function()
		while true do
			task.wait(0.3)
			for player in pairs(dirty) do
				dirty[player] = nil
				if profiles[player] and player.Parent then
					local ok, err = pcall(S.Sync.send, player)
					if not ok then
						S.Net.logError("sync", err)
					end
				end
			end
		end
	end)

	-- Guardado automático
	task.spawn(function()
		while true do
			task.wait(Config.AutosaveInterval)
			for player in pairs(profiles) do
				task.spawn(DataService.save, player, false)
			end
		end
	end)

	game:BindToClose(function()
		local pending = 0
		for player in pairs(profiles) do
			pending = pending + 1
			task.spawn(function()
				DataService.save(player, true)
				pending = pending - 1
			end)
		end
		local start = os.clock()
		while pending > 0 and os.clock() - start < 25 do
			task.wait(0.2)
		end
	end)
end

return DataService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000027"><Properties><string name="Name">EconomyService</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- EconomyService: dinero virtual, movimientos, informes mensuales, ahorro, metas y préstamos.
-- El dinero del juego es independiente de Robux. Solo el servidor modifica el saldo.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Util = require(Shared.Util)

local Economy = {}
local S

local function monthKey()
	return "M" .. S.Time.monthIndex()
end

local function bucket(data)
	local key = monthKey()
	local m = data.Monthly[key]
	if not m then
		m = { Inc = {}, Exp = {} }
		data.Monthly[key] = m
		-- conservar solo los últimos meses
		local keys = {}
		for k in pairs(data.Monthly) do
			keys[#keys + 1] = k
		end
		table.sort(keys, function(a, b)
			return tonumber(a:sub(2)) > tonumber(b:sub(2))
		end)
		for i = Config.MonthsKept + 1, #keys do
			data.Monthly[keys[i]] = nil
		end
	end
	return m
end

local function log(data, amount, category, desc)
	Util.pushCapped(data.Transactions, { T = os.time(), A = amount, C = category, D = desc, B = data.Money }, Config.MaxTransactions)
	local m = bucket(data)
	if amount >= 0 then
		m.Inc[category] = (m.Inc[category] or 0) + amount
	else
		m.Exp[category] = (m.Exp[category] or 0) - amount
	end
end

function Economy.Init(services)
	S = services
end

-- Suma dinero. opts.taxable aplica el impuesto simulado; opts.silent no avisa.
function Economy.add(player, amount, category, desc, opts)
	local data = S.Data.get(player)
	if not data or amount <= 0 then
		return 0
	end
	amount = math.floor(amount + 0.5)
	opts = opts or {}
	data.Money = data.Money + amount
	data.LifetimeEarned = data.LifetimeEarned + amount
	log(data, amount, category, desc)
	local net = amount
	if opts.taxable then
		local tax = math.floor(amount * Config.IncomeTaxRate + 0.5)
		if tax > 0 then
			data.Money = data.Money - tax
			log(data, -tax, "Impuestos", "Impuesto (" .. math.floor(Config.IncomeTaxRate * 100) .. "%) sobre " .. desc)
			net = amount - tax
		end
	end
	-- Pago automático del préstamo: 10% de los ingresos imponibles
	if opts.taxable and data.Bank.Loan > 0 then
		local pay = math.min(data.Bank.Loan, math.floor(net * 0.1 + 0.5), data.Money)
		if pay > 0 then
			data.Money = data.Money - pay
			data.Bank.Loan = data.Bank.Loan - pay
			log(data, -pay, "Préstamo", "Cuota automática del préstamo")
		end
	end
	S.Data.markDirty(player)
	if not opts.silent then
		S.Net.push(player, "cash", { amount = net, desc = desc })
	end
	return net
end

function Economy.canAfford(player, amount)
	local data = S.Data.get(player)
	return data ~= nil and data.Money >= amount
end

-- Cobra dinero. Devuelve false si no alcanza (no deja saldo negativo).
function Economy.spend(player, amount, category, desc)
	local data = S.Data.get(player)
	amount = math.floor(amount + 0.5)
	if not data or amount < 0 or data.Money < amount then
		return false
	end
	if amount == 0 then
		return true
	end
	data.Money = data.Money - amount
	log(data, -amount, category, desc)
	S.Data.markDirty(player)
	return true
end

function Economy.balanceSummary(data)
	local m = data.Monthly[monthKey()] or { Inc = {}, Exp = {} }
	local inc, exp = 0, 0
	for _, v in pairs(m.Inc) do
		inc = inc + v
	end
	for _, v in pairs(m.Exp) do
		exp = exp + v
	end
	return inc, exp
end

function Economy.loanLimit(data)
	return 1000 + data.Level * 500
end

-- Interés semanal de ahorros (1% por semana de juego, hasta 500 por semana)
function Economy.onNewDay(player, day)
	local data = S.Data.get(player)
	if not data then
		return
	end
	local bank = data.Bank
	if day - bank.LastInterestDay >= Config.DaysPerMonth then
		bank.LastInterestDay = day
		local interest = math.min(500, math.floor(bank.Savings * 0.01))
		if interest > 0 then
			bank.Savings = bank.Savings + interest
			log(data, 0, "Ahorros", "Intereses de ahorro: +" .. interest .. " (en la cuenta de ahorro)")
			S.Net.notify(player, "Tus ahorros generaron $" .. interest .. " de interés.", "success")
		end
	end
end

function Economy.Start()
	local Net = S.Net

	Net.on("Bank.Deposit", function(player, p)
		local amount = math.floor(tonumber(p.amount) or 0)
		if amount <= 0 then
			return false, "Cantidad no válida."
		end
		if not Economy.spend(player, amount, "Ahorros", "Depósito en la cuenta de ahorro") then
			return false, "No tienes suficiente dinero."
		end
		local data = S.Data.get(player)
		data.Bank.Savings = data.Bank.Savings + amount
		return true, "Depositaste $" .. Util.formatInt(amount) .. " en ahorros."
	end)

	Net.on("Bank.Withdraw", function(player, p)
		local data = S.Data.get(player)
		local amount = math.floor(tonumber(p.amount) or 0)
		if amount <= 0 or amount > data.Bank.Savings then
			return false, "Cantidad no válida."
		end
		data.Bank.Savings = data.Bank.Savings - amount
		data.Money = data.Money + amount
		log(data, amount, "Ahorros", "Retiro de la cuenta de ahorro")
		return true, "Retiraste $" .. Util.formatInt(amount) .. "."
	end)

	Net.on("Bank.TakeLoan", function(player, p)
		local data = S.Data.get(player)
		local amount = math.floor(tonumber(p.amount) or 0)
		local limit = Economy.loanLimit(data)
		if amount < 100 then
			return false, "El préstamo mínimo es de $100."
		end
		if data.Bank.Loan + amount * (1 + data.Bank.LoanRate) > limit * (1 + data.Bank.LoanRate) then
			return false, "Superarías tu límite de préstamo ($" .. Util.formatInt(limit) .. ")."
		end
		local owed = math.floor(amount * (1 + data.Bank.LoanRate) + 0.5)
		data.Bank.Loan = data.Bank.Loan + owed
		data.Money = data.Money + amount
		log(data, amount, "Préstamo", "Préstamo recibido (devolverás $" .. owed .. ")")
		return true, "Préstamo concedido. Devolverás $" .. Util.formatInt(owed) .. " (10% fijo). Se descuenta el 10% de tus ingresos hasta saldarlo."
	end)

	Net.on("Bank.RepayLoan", function(player, p)
		local data = S.Data.get(player)
		local amount = math.min(math.floor(tonumber(p.amount) or 0), data.Bank.Loan)
		if amount <= 0 then
			return false, "No tienes deuda o la cantidad no es válida."
		end
		if not Economy.spend(player, amount, "Préstamo", "Pago manual del préstamo") then
			return false, "No tienes suficiente dinero."
		end
		data.Bank.Loan = data.Bank.Loan - amount
		return true, data.Bank.Loan == 0 and "¡Préstamo saldado!" or ("Quedan $" .. Util.formatInt(data.Bank.Loan) .. " por pagar.")
	end)

	Net.on("Bank.SetGoal", function(player, p)
		local data = S.Data.get(player)
		local name = Util.cleanText(p.name, 40)
		local target = math.floor(tonumber(p.target) or 0)
		if p.remove then
			local idx = tonumber(p.remove)
			if idx and data.Bank.Goals[idx] then
				table.remove(data.Bank.Goals, idx)
				return true, "Meta eliminada."
			end
			return false, "Meta no encontrada."
		end
		if not name or #name == 0 or target <= 0 then
			return false, "Escribe un nombre y una cantidad."
		end
		if #data.Bank.Goals >= 5 then
			return false, "Máximo 5 metas."
		end
		name = S.Text.filter(player, name)
		if not name then
			return false, "Ese nombre no está permitido."
		end
		table.insert(data.Bank.Goals, { Name = name, Target = target })
		return true, "Meta creada."
	end)
end

return Economy
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000028"><Properties><string name="Name">EventService</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- EventService: eventos dinámicos diarios (EventData). Cada evento tiene lugar, horario, efectos reales
-- (descuentos, más visitas, escenas más interesantes en el lugar, taxis más baratos) y objetivos con
-- recompensa que se cobran una vez por evento. Hay un escenario con luces en el lugar del evento.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local Shared = ReplicatedStorage.Shared
local EventData = require(Shared.EventData)
local WorldData = require(Shared.WorldData)
local Util = require(Shared.Util)

local Events = {}
local S
local beacon

function Events.Init(services)
	S = services
end

function Events.current()
	local day = S.Time.day()
	return EventData.forDay(day), day
end

function Events.isActive()
	local ev = Events.current()
	local h = S.Time.hour()
	return h >= ev.Hours[1] and h < ev.Hours[2]
end

local function effect(name)
	local ev = Events.current()
	return ev.Effects and ev.Effects[name] or nil
end

function Events.priceMultiplier(def)
	local d = effect("Discount")
	if d and (d.All or Util.indexOf(d.Cats or {}, def.Cat)) then
		return 1 - d.Rate
	end
	return 1
end

function Events.usedDiscount()
	return effect("UsedDiscount") or 0
end

function Events.taxiMultiplier()
	return effect("TaxiDiscount") and (1 - effect("TaxiDiscount")) or 1
end

function Events.viewMultiplier(categoryId)
	local v = effect("ViewBonus")
	if v and Util.indexOf(v.Cats or {}, categoryId) then
		return v.Mult
	end
	return 1
end

function Events.sceneBonus(spot)
	local ev = Events.current()
	if spot and spot.Id == ev.Spot and Events.isActive() then
		return ev.Effects.EventSpotBonus or 1.1
	end
	return 1
end

function Events.atEvent(player)
	local ev = Events.current()
	local spot = WorldData.SpotById[ev.Spot]
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if not spot or not root then
		return false
	end
	local dx, dz = root.Position.X - spot.X, root.Position.Z - spot.Z
	return dx * dx + dz * dz <= 50 * 50
end

local function progress(data)
	local ev, day = Events.current()
	local p = data.EventProg
	if not p or p.Day ~= day then
		p = { Day = day, Event = ev.Id, Done = {}, Scenes = 0, Published = 0, Joined = false }
		data.EventProg = p
	end
	return p, ev
end
Events.progress = progress

local function complete(player, index)
	local data = S.Data.get(player)
	local p, ev = progress(data)
	local key = tostring(index)
	if p.Done[key] then
		return
	end
	p.Done[key] = true
	local g = ev.Goals[index]
	if not p.Joined then
		p.Joined = true
		data.Counters.events_joined = (data.Counters.events_joined or 0) + 1
	end
	data.Counters.events_goals = (data.Counters.events_goals or 0) + 1
	S.Economy.add(player, g.Reward, "Eventos", ev.Name .. ": " .. EventData.goalText(g), {})
	S.Progress.addXp(player, 25)
	S.Net.notify(player, "🎪 " .. ev.Name .. " — objetivo cumplido: " .. EventData.goalText(g) .. " (+$" .. g.Reward .. ")", "success")
	S.Quest.check(player)
end

local function check(player, kind, value)
	local data = S.Data.get(player)
	if not data then
		return
	end
	local p, ev = progress(data)
	for i, g in ipairs(ev.Goals) do
		if not p.Done[tostring(i)] and g.Type == kind then
			local ok = false
			if kind == "checkin" then
				ok = value == true
			elseif kind == "photo" then
				ok = value >= g.MinQ
			elseif kind == "scene" then
				ok = p.Scenes >= g.N
			elseif kind == "decor" then
				ok = value >= g.Min
			elseif kind == "publish" then
				local v = value
				local catOk = not g.Cats or Util.indexOf(g.Cats, v.Cat) ~= nil
				local editOk = not g.MinEdit or (v.EditQ or 0) >= g.MinEdit
				if catOk and editOk then
					p["Pub" .. i] = (p["Pub" .. i] or 0) + 1
				end
				ok = (p["Pub" .. i] or 0) >= g.N
			end
			if ok then
				complete(player, i)
			end
		end
	end
end

function Events.onScene(player, spot)
	local data = S.Data.get(player)
	local p, ev = progress(data)
	if spot and spot.Id == ev.Spot and Events.isActive() then
		p.Scenes = p.Scenes + 1
		check(player, "scene")
	end
end

function Events.onPhoto(player, photo)
	local ev = Events.current()
	if photo.Spot == ev.Spot and Events.isActive() then
		check(player, "photo", photo.Q)
	end
end

function Events.onPublish(player, video)
	check(player, "publish", video)
end

function Events.onDecor(player, score)
	check(player, "decor", score)
end

local function moveBeacon()
	local ev = Events.current()
	local spot = WorldData.SpotById[ev.Spot]
	if not spot then
		return
	end
	if beacon then
		beacon:Destroy()
	end
	local m = Instance.new("Model")
	m.Name = "EventBeacon"
	local function part(name, size, pos, color, mat, transp)
		local p = Instance.new("Part")
		p.Name = name
		p.Anchored = true
		p.CanCollide = name == "Stage"
		p.Size = size
		p.CFrame = CFrame.new(pos)
		p.Color = color
		p.Material = mat or Enum.Material.Neon
		p.Transparency = transp or 0
		p.Parent = m
		return p
	end
	local base = Vector3.new(spot.X + 18, 0.5, spot.Z - 14)
	part("Stage", Vector3.new(16, 1.2, 10), base + Vector3.new(0, 0.6, 0), Color3.fromRGB(30, 30, 36), Enum.Material.Metal)
	local beam = part("LightBeam", Vector3.new(3, 120, 3), base + Vector3.new(0, 61, 0), Color3.fromRGB(255, 80, 200), Enum.Material.Neon, 0.6)
	beam.CastShadow = false
	for i = -1, 1, 2 do
		part("Flag", Vector3.new(0.4, 14, 0.4), base + Vector3.new(i * 8, 7, -5), Color3.fromRGB(240, 240, 240), Enum.Material.Metal)
		part("Banner", Vector3.new(0.2, 4, 3), base + Vector3.new(i * 8, 11, -3.4), Color3.fromRGB(255, 52, 82), Enum.Material.Fabric)
	end
	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.fromOffset(260, 50)
	bb.StudsOffset = Vector3.new(0, 14, 0)
	bb.MaxDistance = 400
	bb.Parent = m.Stage
	local t = Instance.new("TextLabel")
	t.Size = UDim2.fromScale(1, 1)
	t.BackgroundColor3 = Color3.fromRGB(120, 20, 90)
	t.BackgroundTransparency = 0.15
	t.TextColor3 = Color3.new(1, 1, 1)
	t.Font = Enum.Font.GothamBlack
	t.TextScaled = true
	t.Text = "🎪 " .. ev.Name
	t.Parent = bb
	m.Parent = workspace
	beacon = m
	workspace:SetAttribute("EventId", ev.Id)
end

function Events.Start()
	moveBeacon()
	local lastDay = S.Time.day()
	task.spawn(function()
		while true do
			task.wait(2)
			local day = S.Time.day()
			if day ~= lastDay then
				lastDay = day
				moveBeacon()
				local ev = Events.current()
				for _, player in ipairs(Players:GetPlayers()) do
					S.Net.notify(player, "🎪 Nuevo evento hoy: " .. ev.Name .. " — " .. ev.Desc, "info")
				end
			end
			workspace:SetAttribute("EventActive", Events.isActive())
			for _, player in ipairs(Players:GetPlayers()) do
				local data = S.Data.get(player)
				if data and Events.isActive() and Events.atEvent(player) then
					check(player, "checkin", true)
				end
			end
		end
	end)
end

return Events
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000029"><Properties><string name="Name">HomeService</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- HomeService: vivienda inicial alquilada (habitación en la Residencia Económica).
--  * Cada jugador recibe una habitación propia con escritorio, computador, cama y vestidor.
--  * Lo que compras se ve en tu habitación (PC activo, monitores, silla, escritorio, luces, fondos).
--  * Alquiler semanal (cada 7 días de juego jugados). Si no hay saldo: deuda + recargo y aviso.
--    Nunca se pierde el progreso ni se desaloja al jugador.
--  * Estar en casa recarga las baterías.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Catalog = require(Shared.ItemCatalog)
local Util = require(Shared.Util)

local Home = {}
local S
local assigned = {} -- [player] = room
local atHome = {}

function Home.Init(services)
	S = services
end

function Home.room(player)
	return assigned[player]
end

function Home.isAtHome(player)
	if S.Property.inside(player) then
		return true
	end
	local room = assigned[player]
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if not room or not root then
		return false
	end
	local rel = root.Position - room.Center
	return math.abs(rel.X) <= room.Size.X / 2 + 2 and math.abs(rel.Z) <= room.Size.Z / 2 + 2 and math.abs(rel.Y) < 20
end

function Home.spawnCFrame(player)
	local data = S.Data.get(player)
	if data and data.HomeProperty ~= "" and data.Properties[data.HomeProperty] then
		local cf = S.Property.enterCFrame(player, data.HomeProperty)
		if cf then
			return cf
		end
	end
	local room = assigned[player]
	if room then
		return CFrame.new(room.Center + Vector3.new(0, 4, room.Size.Z / 2 - 5))
	end
	return nil
end

local function makePart(parent, name, size, cf, color, material)
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end

local function rgb(t)
	return Color3.fromRGB(t[1], t[2], t[3])
end

-- Redibuja los muebles y equipos dinámicos de la habitación según el inventario.
function Home.refreshRoom(player)
	local room = assigned[player]
	local data = S.Data.get(player)
	if not room or not data then
		return
	end
	local folder = room.Dynamic
	folder:ClearAllChildren()
	local deskCF = room.DeskCFrame -- parte superior del escritorio, mirando a la pared

	local desk = S.Inventory.bestCatAtHome(player, "furniture", "Escritorio", "Comfort")
	local deskColor = desk and rgb(desk.Color) or Color3.fromRGB(150, 115, 80)
	local deskWidth = desk and (desk.Id == "desk_large" and 12 or (desk.Id == "desk_lux" and 11 or 9)) or 8
	makePart(folder, "DeskTop", Vector3.new(deskWidth, 0.6, 4), deskCF, deskColor, desk and desk.Id == "desk_lux" and Enum.Material.Wood or Enum.Material.WoodPlanks)
	for _, sx in ipairs({ -1, 1 }) do
		makePart(folder, "DeskLeg", Vector3.new(0.5, 3, 3.6), deskCF * CFrame.new(sx * (deskWidth / 2 - 0.4), -1.8, 0), deskColor)
	end

	-- Monitores
	local mon = S.Inventory.bestCatAtHome(player, "monitor", nil, "ColorAcc")
	local screens = mon and math.floor(mon.Stats.Screens + 0.5) or 1
	if screens < 1 then
		screens = 1
	end
	local wide = mon and mon.Id == "mon_uw34"
	for i = 1, screens do
		local x = (i - (screens + 1) / 2) * 3.4
		local w = wide and 5 or 3.2
		local screen = makePart(folder, "Monitor", Vector3.new(w, 2, 0.25), deskCF * CFrame.new(x, 1.6, 1.2), Color3.fromRGB(20, 20, 24))
		local glow = makePart(folder, "Screen", Vector3.new(w - 0.2, 1.8, 0.05), screen.CFrame * CFrame.new(0, 0, -0.15), Color3.fromRGB(70, 140, 255), Enum.Material.Neon)
		glow.CanCollide = false
	end

	-- Torre del PC activo
	local rig = data.Rigs[data.ActiveRig]
	if rig then
		local caseRec = data.Inventory[rig.Parts.case or ""]
		local caseDef = caseRec and Catalog.get(caseRec.Id)
		local tower = makePart(folder, "PCTower", Vector3.new(1.6, 3.2, 3), deskCF * CFrame.new(deskWidth / 2 + 1.4, -1.3, 0),
			caseDef and rgb(caseDef.Color) or Color3.fromRGB(50, 50, 55))
		if caseDef and caseDef.Id == "case_glass" then
			tower.Material = Enum.Material.Glass
			tower.Transparency = 0.3
			local light = Instance.new("PointLight")
			light.Color = Color3.fromRGB(200, 80, 255)
			light.Range = 8
			light.Brightness = 1.5
			light.Parent = tower
		end
	end

	-- Silla
	local chair = S.Inventory.bestCatAtHome(player, "furniture", "Silla", "Comfort")
	local chairColor = chair and rgb(chair.Color) or Color3.fromRGB(110, 110, 110)
	local seat = makePart(folder, "ChairSeat", Vector3.new(2.6, 0.5, 2.6), deskCF * CFrame.new(0, -1.4, -3.2), chairColor)
	makePart(folder, "ChairBack", Vector3.new(2.6, chair and chair.Id ~= "chair_basic" and 3.4 or 2.2, 0.4), seat.CFrame * CFrame.new(0, 1.7, -1.2), chairColor)

	-- Luces y fondos de casa
	local light = S.Inventory.best(player, "homelight", "home", "Light")
	if light then
		local ring = makePart(folder, "RingLight", Vector3.new(0.3, 2.4, 2.4), CFrame.new(room.Center) * CFrame.new(-room.Size.X / 2 + 4, 1, 0), Color3.fromRGB(255, 255, 240), Enum.Material.Neon)
		local l = Instance.new("SpotLight")
		l.Face = Enum.NormalId.Right
		l.Brightness = 2
		l.Range = 16
		l.Parent = ring
	end
	local _, backRec, backDef = S.Inventory.best(player, "homeextra", "home", "Decor")
	if backDef then
		local color = backDef.Id == "backdrop_neon" and Color3.fromRGB(255, 60, 200) or Color3.fromRGB(40, 200, 80)
		local wall = makePart(folder, "Backdrop", Vector3.new(0.2, 7, 9), CFrame.new(room.Center) * CFrame.new(room.Size.X / 2 - 1, 1.5, -2), color,
			backDef.Id == "backdrop_neon" and Enum.Material.Neon or Enum.Material.Fabric)
		wall.CanCollide = false
	end
end

local function assignRoom(player)
	for _, room in ipairs(S.World.HomeRooms or {}) do
		if room.Owner == nil then
			room.Owner = player
			assigned[player] = room
			room.Sign.Text = "Hab. " .. room.Index .. " · " .. player.DisplayName
			room.DeskPrompt:SetAttribute("Owner", player.UserId)
			room.Wardrobe:SetAttribute("Owner", player.UserId)
			return room
		end
	end
	return nil
end

local function freeRoom(player)
	local room = assigned[player]
	if room then
		room.Owner = nil
		room.Sign.Text = "Hab. " .. room.Index .. " · Libre"
		room.DeskPrompt:SetAttribute("Owner", 0)
		room.Wardrobe:SetAttribute("Owner", 0)
		room.Dynamic:ClearAllChildren()
		assigned[player] = nil
	end
	atHome[player] = nil
end

function Home.onPlayerReady(player)
	local room = assignRoom(player)
	if not room then
		S.Net.notify(player, "La residencia está llena en este servidor: usa el cibercafé de la Zona universitaria o tu portátil.", "warn")
		return
	end
	player:SetAttribute("HomePos", room.Center + Vector3.new(0, 2, room.Size.Z / 2 + 3))
	Home.refreshRoom(player)
end

-- Alquiler: se cobra cada 7 días de juego JUGADOS (no se cobra mientras estás desconectado)
function Home.onNewDay(player)
	local data = S.Data.get(player)
	if not data then
		return
	end
	local h = data.Home
	h.PlayDays = h.PlayDays + 1
	pcall(S.Property.onNewDay, player)
	pcall(S.Sponsor.onNewDay, player)
	if data.HomeProperty ~= "" then
		-- vive en otra propiedad: no se cobra la habitación de la residencia
		h.NextDue = h.PlayDays + Config.RentPeriodDays
		return
	end
	if h.PlayDays < h.NextDue then
		return
	end
	h.NextDue = h.PlayDays + Config.RentPeriodDays
	local due = h.Rent
	if S.Economy.spend(player, due, "Alquiler", "Alquiler semanal (" .. "Residencia Económica" .. ")") then
		h.Paid = h.Paid + due
		h.Missed = 0
		data.Counters.rent_paid = (data.Counters.rent_paid or 0) + 1
		S.Net.notify(player, "🏠 Alquiler pagado: $" .. due .. ".", "info")
	else
		local fee = math.floor(due * Config.LateFeeRate + 0.5)
		h.Debt = h.Debt + due + fee
		h.Missed = h.Missed + 1
		data.Reputation = math.max(0, data.Reputation - 1)
		S.Net.notify(player, "⚠️ No pudiste pagar el alquiler. Deuda: $" .. h.Debt .. " (incluye recargo). Págala en la app Banco." ..
			(h.Missed >= 2 and " Los pedidos online quedan bloqueados hasta pagar." or ""), "warn")
	end
	S.Data.markDirty(player)
end

function Home.Start()
	local Net = S.Net

	Net.on("Home.PayDebt", function(player)
		local data = S.Data.get(player)
		local h = data.Home
		if h.Debt <= 0 then
			return false, "No tienes deudas de alquiler."
		end
		if not S.Economy.spend(player, h.Debt, "Alquiler", "Pago de alquiler atrasado") then
			return false, "Necesitas $" .. Util.formatInt(h.Debt) .. "."
		end
		h.Paid = h.Paid + h.Debt
		h.Debt = 0
		h.Missed = 0
		return true, "Deuda de alquiler saldada. ¡Gracias!"
	end)

	Net.on("Home.Teleport", function(player)
		local data = S.Data.get(player)
		if data.HomeProperty ~= "" and data.Properties[data.HomeProperty] then
			local ok, msg = S.Travel.taxiTo(player, S.Property.exteriorOf(data.HomeProperty), "tu casa")
			if ok then
				local cf = S.Property.enterCFrame(player, data.HomeProperty)
				S.Travel.teleport(player, cf.Position)
			end
			return ok, msg
		end
		local cf = Home.spawnCFrame(player)
		if not cf or not player.Character then
			return false, "No tienes habitación asignada."
		end
		local data = S.Data.get(player)
		-- Volver a casa en taxi tiene coste normal
		return S.Travel.taxiTo(player, cf.Position, "tu casa")
	end)

	Players.PlayerRemoving:Connect(freeRoom)

	-- Detección de entrada en casa + recarga de baterías
	task.spawn(function()
		while true do
			task.wait(1)
			for _, player in ipairs(Players:GetPlayers()) do
				if S.Data.get(player) then
					local inside = Home.isAtHome(player)
					if inside and not atHome[player] then
						S.Quest.tutorialEvent(player, "enter_home")
						if S.Inventory.chargeAll(player) then
							S.Net.notify(player, "🔋 Baterías recargadas en casa.", "info")
						end
					end
					atHome[player] = inside
				end
			end
		end
	end)
end

return Home
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000030"><Properties><string name="Name">InventoryService</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- InventoryService: cada objeto comprado es una unidad con su propio identificador (uid),
-- condición, carga de batería y ubicación: "home" (en casa), "backpack" (mochila) o "rig:<id>" (instalado en un PC).

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Catalog = require(Shared.ItemCatalog)
local Util = require(Shared.Util)

local Inventory = {}
local S

Inventory.MaxItems = 300

function Inventory.Init(services)
	S = services
end

function Inventory.add(player, itemId, opts)
	local data = S.Data.get(player)
	local def = Catalog.get(itemId)
	if not data or not def then
		return nil, "Objeto desconocido."
	end
	if Util.count(data.Inventory) >= Inventory.MaxItems then
		return nil, "Tu inventario está lleno (" .. Inventory.MaxItems .. " objetos). Vende algo primero."
	end
	opts = opts or {}
	local uid = S.Data.nextUid(player, "i")
	local loc = opts.loc or "home"
	if loc == "backpack" and not (def.Portable and Inventory.canFit(player, def)) then
		loc = "home"
	end
	data.Inventory[uid] = {
		Id = itemId,
		Cond = opts.cond or 100,
		Loc = loc,
		Got = os.time(),
		GotDay = S.Time.day(),
		Src = opts.src or "shop",
		Paid = opts.paid or def.Price,
		Charge = 100,
	}
	if def.Cat == "camera" then
		data.Visited.Cameras[itemId] = true
	end
	S.Data.markDirty(player)
	return uid, loc
end

function Inventory.remove(player, uid)
	local data = S.Data.get(player)
	if data and data.Inventory[uid] then
		data.Inventory[uid] = nil
		if data.Equipped.Phone == uid then
			data.Equipped.Phone = ""
		end
		S.Data.markDirty(player)
		return true
	end
	return false
end

function Inventory.get(player, uid)
	local data = S.Data.get(player)
	local rec = data and data.Inventory[uid]
	if not rec then
		return nil
	end
	return rec, Catalog.get(rec.Id)
end

function Inventory.owns(player, itemId)
	local data = S.Data.get(player)
	for _, rec in pairs(data.Inventory) do
		if rec.Id == itemId then
			return true
		end
	end
	return false
end

function Inventory.backpackCap(player)
	local data = S.Data.get(player)
	local cap = Config.BaseBackpackSlots + S.Monetization.perk(player, "BackpackSlots")
	for _, rec in pairs(data.Inventory) do
		if rec.Loc == "backpack" then
			local def = Catalog.get(rec.Id)
			if def and def.Slot == "bag" then
				cap = cap + def.Stats.Slots
			end
		end
	end
	return cap
end

function Inventory.backpackUsed(player)
	local data = S.Data.get(player)
	local used = 0
	for _, rec in pairs(data.Inventory) do
		if rec.Loc == "backpack" then
			local def = Catalog.get(rec.Id)
			used = used + (def and def.Size or 1)
		end
	end
	return used
end

function Inventory.canFit(player, def)
	return Inventory.backpackUsed(player) + def.Size <= Inventory.backpackCap(player)
end

-- Mejor objeto de un tipo (Slot) en una ubicación según una estadística.
function Inventory.best(player, slot, where, stat)
	local data = S.Data.get(player)
	local bestUid, bestRec, bestDef, bestVal = nil, nil, nil, -1
	for uid, rec in pairs(data.Inventory) do
		local def = Catalog.get(rec.Id)
		local here = where == "any" or rec.Loc == where or (where == "home" and rec.Loc:sub(1, 5) == "prop:")
		if def and def.Slot == slot and here then
			local v = stat and (def.Stats[stat] or 0) or def.Quality
			if type(v) ~= "number" then
				v = def.Quality
			end
			v = v * (0.85 + 0.15 * rec.Cond / 100)
			if v > bestVal then
				bestUid, bestRec, bestDef, bestVal = uid, rec, def, v
			end
		end
	end
	return bestUid, bestRec, bestDef
end

-- Mejor objeto de una categoría en casa (monitores, sillas...)
function Inventory.bestCatAtHome(player, cat, sub, stat)
	local data = S.Data.get(player)
	local best, bestVal = nil, -1
	for _, rec in pairs(data.Inventory) do
		local def = Catalog.get(rec.Id)
		if def and def.Cat == cat and (sub == nil or def.Sub == sub) and (rec.Loc == "home" or rec.Loc:sub(1, 5) == "prop:") then
			local v = def.Stats[stat] or 0
			if v > bestVal then
				best, bestVal = def, v
			end
		end
	end
	return best
end

function Inventory.phone(player)
	local data = S.Data.get(player)
	local uid = data.Equipped.Phone
	local rec = data.Inventory[uid]
	if not rec then
		-- elegir el mejor teléfono disponible
		local u, r = Inventory.best(player, "phone", "any", "Photo")
		if u then
			data.Equipped.Phone = u
			return r, Catalog.get(r.Id), u
		end
		return nil
	end
	return rec, Catalog.get(rec.Id), uid
end

function Inventory.condFactor(rec)
	return 0.85 + 0.15 * (rec.Cond or 100) / 100
end

-- Recarga baterías (al estar en casa)
function Inventory.chargeAll(player)
	local data = S.Data.get(player)
	local changed = false
	for _, rec in pairs(data.Inventory) do
		if rec.Charge ~= nil and rec.Charge < 100 then
			rec.Charge = 100
			changed = true
		end
	end
	if changed then
		S.Data.markDirty(player)
	end
	return changed
end

function Inventory.sellValue(rec, def)
	return math.floor((rec.Paid or def.Price) * Config.SellBackRate * (rec.Cond / 100) + 0.5)
end

function Inventory.canReturn(rec)
	return (rec.Src == "shop" or rec.Src == "online") and rec.Cond >= 90
		and (S.Time.day() - (rec.GotDay or 0)) <= Config.ReturnWindowDays
end

function Inventory.Start()
	local Net = S.Net

	Net.on("Inv.Move", function(player, p)
		local data = S.Data.get(player)
		local rec = data.Inventory[p.uid]
		if not rec then
			return false, "No tienes ese objeto."
		end
		local def = Catalog.get(rec.Id)
		local to = p.to
		if to ~= "home" and to ~= "backpack" then
			return false, "Destino no válido."
		end
		if rec.Loc:sub(1, 4) == "rig:" then
			return false, "Está instalado en un computador. Desmóntalo en el Montador de PC."
		end
		if rec.Loc:sub(1, 5) == "prop:" then
			return false, "Está colocado en una propiedad. Recógelo con el modo construcción."
		end
		if rec.Loc == to then
			return true
		end
		if not S.Home.isAtHome(player) then
			return false, "Solo puedes preparar la mochila en casa."
		end
		if to == "backpack" then
			if not def.Portable then
				return false, def.Name .. " no es portátil."
			end
			if not Inventory.canFit(player, def) then
				return false, "La mochila está llena (" .. Inventory.backpackUsed(player) .. "/" .. Inventory.backpackCap(player) .. ")."
			end
		else
			-- Sacar una bolsa no puede dejar la mochila por encima de su capacidad
			if def.Slot == "bag" then
				local after = Inventory.backpackCap(player) - def.Stats.Slots
				if Inventory.backpackUsed(player) - def.Size > after then
					return false, "Primero saca otros objetos: no cabrían sin esta bolsa."
				end
			end
		end
		rec.Loc = to
		if to == "backpack" then
			S.Quest.tutorialEvent(player, "pack")
		end
		return true, (to == "backpack") and (def.Name .. " → mochila") or (def.Name .. " → casa")
	end)

	Net.on("Inv.EquipPhone", function(player, p)
		local data = S.Data.get(player)
		local rec = data.Inventory[p.uid]
		if not rec or Catalog.get(rec.Id).Slot ~= "phone" then
			return false, "Eso no es un teléfono."
		end
		data.Equipped.Phone = p.uid
		return true, "Ahora usas " .. Catalog.get(rec.Id).Name .. "."
	end)

	local function checkSellable(player, rec, def, uid)
		local data = S.Data.get(player)
		if not rec then
			return "No tienes ese objeto."
		end
		if rec.Loc:sub(1, 4) == "rig:" then
			return "Está instalado en un computador. Desmóntalo primero."
		end
		if rec.Loc:sub(1, 5) == "prop:" then
			return "Está colocado en una propiedad. Recógelo primero con el modo construcción."
		end
		if rec.Loan then
			return "Es equipo prestado por un patrocinador: se devuelve al terminar el contrato."
		end
		if def.Slot == "phone" then
			local phones = 0
			for _, r in pairs(data.Inventory) do
				if Catalog.get(r.Id).Slot == "phone" then
					phones = phones + 1
				end
			end
			if phones <= 1 then
				return "No puedes quedarte sin teléfono."
			end
		end
		if def.Slot == "bag" and rec.Loc == "backpack" then
			return "Saca la bolsa de la mochila antes de venderla."
		end
		return nil
	end

	Net.on("Inv.Sell", function(player, p)
		local data = S.Data.get(player)
		local rec = data.Inventory[p.uid]
		local def = rec and Catalog.get(rec.Id)
		local err = checkSellable(player, rec, def, p.uid)
		if err then
			return false, err
		end
		local value = Inventory.sellValue(rec, def)
		Inventory.remove(player, p.uid)
		S.Economy.add(player, value, "Ventas", "Venta de " .. def.Name, { silent = false })
		return true, "Vendiste " .. def.Name .. " por $" .. Util.formatInt(value) .. "."
	end)

	Net.on("Inv.Return", function(player, p)
		local data = S.Data.get(player)
		local rec = data.Inventory[p.uid]
		local def = rec and Catalog.get(rec.Id)
		local err = checkSellable(player, rec, def, p.uid)
		if err then
			return false, err
		end
		if not Inventory.canReturn(rec) then
			return false, "Ya no se puede devolver (máximo " .. Config.ReturnWindowDays .. " días y en buen estado)."
		end
		local value = math.floor(rec.Paid * Config.ReturnRefundRate + 0.5)
		Inventory.remove(player, p.uid)
		S.Economy.add(player, value, "Devoluciones", "Devolución de " .. def.Name, {})
		return true, "Devolución aceptada: +$" .. Util.formatInt(value) .. "."
	end)

	Net.on("Inv.Clean", function(player, p)
		local data = S.Data.get(player)
		local rec = data.Inventory[p.uid]
		if not rec then
			return false, "No tienes ese objeto."
		end
		if not S.Home.isAtHome(player) then
			return false, "Limpia tu equipo en casa."
		end
		if rec.Cond >= 90 then
			return false, "Ya está limpio y en buen estado."
		end
		if rec.CleanDay == S.Time.day() then
			return false, "Ya lo limpiaste hoy."
		end
		rec.CleanDay = S.Time.day()
		rec.Cond = math.min(90, rec.Cond + 10)
		return true, "Equipo limpiado: condición " .. math.floor(rec.Cond) .. "%."
	end)

	Net.on("Inv.Repair", function(player, p)
		local data = S.Data.get(player)
		local rec = data.Inventory[p.uid]
		if not rec then
			return false, "No tienes ese objeto."
		end
		local def = Catalog.get(rec.Id)
		if rec.Cond >= 100 then
			return false, "No necesita reparación."
		end
		local cost = math.max(5, math.floor(def.Price * 0.15 * (100 - rec.Cond) / 50 + 0.5))
		if not S.Economy.spend(player, cost, "Reparaciones", "Reparación de " .. def.Name) then
			return false, "La reparación cuesta $" .. cost .. "."
		end
		rec.Cond = 100
		return true, def.Name .. " reparado por $" .. cost .. "."
	end)
end

return Inventory
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000031"><Properties><string name="Name">JobsService</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- JobsService: encargos de trabajo para ganar dinero además del canal (adelanto de la Fase 5).
--  * Editor de vídeos freelance: ordenar los clips de un cliente en un computador.
--  * Fotógrafo: hacer una foto de un tipo concreto en un lugar concreto.
--  * Repartidor: llevar un paquete desde una tienda hasta un lugar de la ciudad.
-- Cada tipo tiene requisitos, recompensa, experiencia y ascensos (cada 10 encargos +5% de paga, máx. +50%).

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local Shared = ReplicatedStorage.Shared
local WorldData = require(Shared.WorldData)
local VideoData = require(Shared.VideoData)
local Util = require(Shared.Util)

local Jobs = {}
local S
local cooldown = {}

Jobs.Types = {
	edit = { Name = "Editor de vídeos freelance", Req = "Usar un computador", Base = 45, Cooldown = 40 },
	photo = { Name = "Fotógrafo por encargo", Req = "Cámara o teléfono", Base = 60, Cooldown = 30 },
	delivery = { Name = "Repartidor", Req = "Empezar en una tienda", Base = 30, Cooldown = 20 },
	cashier = { Name = "Cajero / dependiente", Req = "Empezar en una tienda", Base = 40, Cooldown = 30 },
	camera = { Name = "Camarógrafo", Req = "Grabar 2 escenas de calidad en un lugar", Base = 70, Cooldown = 40 },
	thumbs = { Name = "Diseñador de miniaturas", Req = "Computador o tableta", Base = 55, Cooldown = 40 },
	tech = { Name = "Técnico informático", Req = "Saber de compatibilidad de piezas", Base = 50, Cooldown = 30 },
	reporter = { Name = "Periodista de eventos", Req = "Foto y escena en el evento del día", Base = 90, Cooldown = 60 },
}
Jobs.Keywords = { "OFERTA", "NUEVO", "TOP 5", "REVIEW", "VIAJE", "RETO", "GRATIS", "VS" }
Jobs.ClipLabels = { "Gancho", "Presentación", "Desarrollo", "Momento clave", "Conclusión", "Despedida" }

function Jobs.Init(services)
	S = services
end

local function promotion(data, jobType)
	local n = data.Counters["job_" .. jobType] or 0
	return math.min(0.5, math.floor(n / 10) * 0.05), n
end

local function pay(player, jobType, base, detail)
	local data = S.Data.get(player)
	local promo, n = promotion(data, jobType)
	local bonus = S.Monetization.perk(player, "JobBonus")
	local amount = math.floor(base * (1 + promo + bonus) + 0.5)
	data.Counters["job_" .. jobType] = n + 1
	data.Counters.jobs_done = (data.Counters.jobs_done or 0) + 1
	if S.Needs then
		S.Needs.spend(player, 3)
	end
	data.Job = {}
	cooldown[player] = cooldown[player] or {}
	cooldown[player][jobType] = os.clock()
	S.Economy.add(player, amount, "Empleos", Jobs.Types[jobType].Name .. (detail and (": " .. detail) or ""), { taxable = true })
	S.Progress.addXp(player, S.Progress.Xp.Job)
	S.Quest.check(player)
	if (n + 1) % 10 == 0 and promo < 0.5 then
		S.Net.notify(player, "📈 ¡Ascenso como " .. Jobs.Types[jobType].Name .. "! Cobrarás un 5% más.", "success")
	end
	return amount
end

function Jobs.onScene(player, scene)
	local data = S.Data.get(player)
	local job = data.Job
	if job.Type == "camera" and scene.Spot == job.Spot and scene.Q >= job.MinQ then
		job.Count = (job.Count or 0) + 1
		if job.Count >= 2 then
			local amount = pay(player, "camera", Jobs.Types.camera.Base + scene.Q * 0.8, job.SpotName)
			S.Net.notify(player, "✅ Grabación para el cliente completada: +$" .. amount, "success")
		else
			S.Net.notify(player, "🎥 Toma válida para el cliente (" .. job.Count .. "/2).", "info")
		end
	elseif job.Type == "reporter" and scene.Spot == job.Spot then
		job.Scene = true
		Jobs.checkReporter(player)
	end
end

function Jobs.checkReporter(player)
	local data = S.Data.get(player)
	local job = data.Job
	if job.Type == "reporter" and job.Scene and job.Photo then
		local amount = pay(player, "reporter", Jobs.Types.reporter.Base, job.SpotName)
		S.Net.notify(player, "📰 Reportaje entregado: +$" .. amount, "success")
	end
end

function Jobs.onThumb(player, design, score)
	local data = S.Data.get(player)
	local job = data.Job
	if job.Type == "thumbs" then
		if not (design.text or ""):upper():find(job.Keyword, 1, true) then
			S.Net.notify(player, "El cliente quería la palabra «" .. job.Keyword .. "» en la miniatura.", "warn")
		elseif score < job.MinScore then
			S.Net.notify(player, "El cliente pide al menos " .. job.MinScore .. " puntos (tu diseño: " .. math.floor(score) .. ").", "warn")
		else
			local amount = pay(player, "thumbs", Jobs.Types.thumbs.Base + score * 0.6, "«" .. job.Keyword .. "»")
			S.Net.notify(player, "✅ Miniatura aceptada por el cliente: +$" .. amount, "success")
		end
	end
end

function Jobs.onPhoto(player, photo)
	local data = S.Data.get(player)
	local job = data.Job
	if job.Type == "reporter" and photo.Spot == job.Spot and photo.Q >= 45 then
		job.Photo = true
		Jobs.checkReporter(player)
		return
	end
	if job.Type == "photo" and photo.Spot == job.Spot and photo.Mode == job.Mode then
		local amount = pay(player, "photo", Jobs.Types.photo.Base + photo.Q * 0.8, job.SpotName)
		S.Net.notify(player, "✅ Encargo de fotografía completado: +$" .. amount, "success")
	end
end

function Jobs.Start()
	local Net = S.Net

	Net.on("Job.Start", function(player, p)
		local data = S.Data.get(player)
		local def = Jobs.Types[p.type or ""]
		if not def then
			return false, "Empleo no válido."
		end
		if data.Job.Type then
			return false, "Ya tienes un encargo en curso. Termínalo o cancélalo."
		end
		local last = cooldown[player] and cooldown[player][p.type]
		if last and os.clock() - last < def.Cooldown then
			return false, "Vuelve en " .. math.ceil(def.Cooldown - (os.clock() - last)) .. " s para otro encargo de este tipo."
		end
		local rng = Random.new()
		if p.type == "edit" then
			if not S.Computer.hasSession(player) then
				return false, "Necesitas estar usando un computador."
			end
			local stats = S.Computer.sessionStats(player)
			local n = math.min(#Jobs.ClipLabels, 3 + stats.Tier)
			local order = {}
			for i = 1, n do
				order[i] = Jobs.ClipLabels[i]
			end
			local shuffled = {}
			for i = 1, n do
				shuffled[i] = order[i]
			end
			for i = n, 2, -1 do
				local j = rng:NextInteger(1, i)
				shuffled[i], shuffled[j] = shuffled[j], shuffled[i]
			end
			data.Job = { Type = "edit", Answer = order, Clips = shuffled, Tier = stats.Tier, Started = os.time() }
			return true, "Encargo de edición: ordena los clips del cliente.", { clips = shuffled }
		elseif p.type == "photo" then
			local candidates = {}
			for _, s in ipairs(WorldData.Spots) do
				if not s.Secret then
					candidates[#candidates + 1] = s
				end
			end
			local spot = candidates[rng:NextInteger(1, #candidates)]
			local modes = {}
			for _, m in ipairs(VideoData.PhotoModes) do
				if not m.NeedsProduct and m.Id ~= "pet" and m.Id ~= "night" then
					for _, t in ipairs(m.Tags) do
						if Util.indexOf(spot.Tags, t) then
							modes[#modes + 1] = m
							break
						end
					end
				end
			end
			if #modes == 0 then
				modes = { VideoData.PhotoModeById.closeup }
			end
			local mode = modes[rng:NextInteger(1, #modes)]
			data.Job = { Type = "photo", Spot = spot.Id, SpotName = spot.Name, Mode = mode.Id, ModeName = mode.Name, Started = os.time() }
			return true, "Encargo: foto «" .. mode.Name .. "» en " .. spot.Name .. ".", { spot = spot.Id }
		elseif p.type == "delivery" then
			if not S.Shop.storeNear(player) then
				return false, "Los repartos empiezan en una tienda (MegaTec, FotoPro, Conecta o Creator Hub)."
			end
			local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
			local candidates = {}
			for _, s in ipairs(WorldData.Spots) do
				if not s.Secret and root then
					local d = math.sqrt((s.X - root.Position.X) ^ 2 + (s.Z - root.Position.Z) ^ 2)
					if d > 200 and d < 900 then
						candidates[#candidates + 1] = { s = s, d = d }
					end
				end
			end
			if #candidates == 0 then
				return false, "No hay repartos disponibles ahora."
			end
			local c = candidates[rng:NextInteger(1, #candidates)]
			data.Job = { Type = "delivery", Spot = c.s.Id, SpotName = c.s.Name, Dist = math.floor(c.d), Started = os.time() }
			return true, "Reparto: lleva el paquete a " .. c.s.Name .. " (" .. math.floor(c.d) .. " studs).", { spot = c.s.Id }
		elseif p.type == "cashier" then
			if not S.Shop.storeNear(player) then
				return false, "Este turno empieza dentro de una tienda."
			end
			local rounds, answers = {}, {}
			for i = 1, 3 do
				local price = rng:NextInteger(3, 95)
				local paid = price <= 10 and 10 or (price <= 20 and 20 or (price <= 50 and 50 or 100))
				rounds[i] = { Price = price, Paid = paid }
				answers[i] = paid - price
			end
			data.Job = { Type = "cashier", Rounds = rounds, Answer = answers, Started = os.time() }
			return true, "Turno de caja: calcula el cambio de 3 clientes.", { rounds = rounds }
		elseif p.type == "camera" then
			local candidates = {}
			for _, s in ipairs(WorldData.Spots) do
				if not s.Secret then
					candidates[#candidates + 1] = s
				end
			end
			local spot = candidates[rng:NextInteger(1, #candidates)]
			local minQ = math.min(70, 30 + data.Level * 2)
			data.Job = { Type = "camera", Spot = spot.Id, SpotName = spot.Name, MinQ = minQ, Count = 0, Started = os.time() }
			return true, "Encargo de grabación: 2 escenas de calidad " .. minQ .. "+ en " .. spot.Name .. " (en cualquier proyecto).", { spot = spot.Id }
		elseif p.type == "thumbs" then
			local kw = Jobs.Keywords[rng:NextInteger(1, #Jobs.Keywords)]
			local minScore = math.min(75, 45 + data.Level)
			data.Job = { Type = "thumbs", Keyword = kw, MinScore = minScore, Started = os.time() }
			return true, "Encargo: miniatura con la palabra «" .. kw .. "» y puntuación " .. minScore .. "+ (app Miniaturas).", {}
		elseif p.type == "tech" then
			local cpus, mobos = {}, {}
			for _, def in pairs(require(Shared.ItemCatalog).Items) do
				if def.Sub == "cpu" then
					cpus[#cpus + 1] = def
				elseif def.Sub == "mobo" then
					mobos[#mobos + 1] = def
				end
			end
			table.sort(cpus, function(a, b)
				return a.Id < b.Id
			end)
			table.sort(mobos, function(a, b)
				return a.Id < b.Id
			end)
			local questions, answers = {}, {}
			for i = 1, 3 do
				local cpu = cpus[rng:NextInteger(1, #cpus)]
				local good, bad = {}, {}
				for _, m in ipairs(mobos) do
					if m.Compat.Socket == cpu.Compat.Socket then
						good[#good + 1] = m
					else
						bad[#bad + 1] = m
					end
				end
				local correct = good[rng:NextInteger(1, #good)]
				local opts = { correct.Id }
				while #opts < 3 and #bad > 0 do
					local b = table.remove(bad, rng:NextInteger(1, #bad))
					opts[#opts + 1] = b.Id
				end
				for j = #opts, 2, -1 do
					local k = rng:NextInteger(1, j)
					opts[j], opts[k] = opts[k], opts[j]
				end
				questions[i] = { Cpu = cpu.Id, Options = opts }
				answers[i] = correct.Id
			end
			data.Job = { Type = "tech", Questions = questions, Answer = answers, Started = os.time() }
			return true, "Cliente con averías: elige la placa base compatible con cada procesador.", { questions = questions }
		elseif p.type == "reporter" then
			local ev = S.Events.current()
			local spot = WorldData.SpotById[ev.Spot]
			data.Job = { Type = "reporter", Spot = ev.Spot, SpotName = spot.Name .. " (" .. ev.Name .. ")", Started = os.time() }
			return true, "Reportaje: haz una foto (calidad 45+) y graba una escena en " .. spot.Name .. ".", { spot = ev.Spot }
		end
		return false, "Empleo no válido."
	end)

	Net.on("Job.Submit", function(player, p)
		local data = S.Data.get(player)
		local job = data.Job
		if job.Type == "edit" then
			if not S.Computer.hasSession(player) then
				return false, "Necesitas estar usando un computador."
			end
			if type(p.order) ~= "table" or #p.order ~= #job.Answer then
				return false, "Orden incompleto."
			end
			local correct = 0
			for i, label in ipairs(job.Answer) do
				if p.order[i] == label then
					correct = correct + 1
				end
			end
			local ratio = correct / #job.Answer
			if ratio < 0.5 then
				data.Job = {}
				cooldown[player] = cooldown[player] or {}
				cooldown[player].edit = os.clock()
				return false, "El cliente rechazó la edición (" .. correct .. "/" .. #job.Answer .. " clips bien). Inténtalo en otro encargo."
			end
			local amount = pay(player, "edit", (Jobs.Types.edit.Base + job.Tier * 15) * ratio, correct .. "/" .. #job.Answer .. " clips")
			return true, "✅ Edición entregada: +$" .. amount .. " (" .. correct .. "/" .. #job.Answer .. ")."
		elseif job.Type == "delivery" then
			local spot = WorldData.SpotById[job.Spot]
			local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
			if not spot or not root then
				return false, "No puedes entregar ahora."
			end
			local d = math.sqrt((spot.X - root.Position.X) ^ 2 + (spot.Z - root.Position.Z) ^ 2)
			if d > 30 then
				return false, "Aún no estás en " .. spot.Name .. " (a " .. math.floor(d) .. " studs)."
			end
			local amount = pay(player, "delivery", Jobs.Types.delivery.Base + job.Dist * 0.05, job.SpotName)
			return true, "✅ Paquete entregado: +$" .. amount .. "."
		elseif job.Type == "cashier" or job.Type == "tech" then
			if type(p.answers) ~= "table" or #p.answers ~= #job.Answer then
				return false, "Responde a todo."
			end
			local correct = 0
			for i, a in ipairs(job.Answer) do
				if tostring(p.answers[i]) == tostring(a) then
					correct = correct + 1
				end
			end
			if correct == 0 then
				data.Job = {}
				cooldown[player] = cooldown[player] or {}
				cooldown[player][job.Type] = os.clock()
				return false, "Ninguna respuesta correcta. El encargado te pide repasar."
			end
			local amount = pay(player, job.Type, Jobs.Types[job.Type].Base * correct / 3 + (job.Type == "tech" and data.Level * 3 or 0), correct .. "/3")
			return true, "✅ Turno completado: +$" .. amount .. " (" .. correct .. "/3 correctas)."
		elseif job.Type == "photo" then
			return false, "Este encargo se completa al hacer la foto pedida en el lugar indicado."
		end
		return false, "No tienes encargos en curso."
	end)

	Net.on("Job.Cancel", function(player)
		local data = S.Data.get(player)
		if not data.Job.Type then
			return false, "No tienes encargos en curso."
		end
		data.Job = {}
		return true, "Encargo cancelado (sin penalización)."
	end)

	Players.PlayerRemoving:Connect(function(player)
		cooldown[player] = nil
	end)
end

return Jobs
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000032"><Properties><string name="Name">LiveService</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- LiveService: directos simulados y publicaciones en redes sociales ficticias.
--  * Directo: desde un computador (casa, propiedad o portátil) con cámara o cámara web.
--    Los espectadores dependen de tus suscriptores, del equipo, de la decoración y de cómo respondas
--    a las preguntas del chat. Hay donaciones, nuevos suscriptores e ingresos al terminar.
--  * Publicación social: una foto del álbum con texto; consigue "me gusta" y algunos seguidores.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Util = require(Shared.Util)

local Live = {}
local S
local sessions = {}

Live.Duration = 75
Live.Cooldown = 180

Live.Topics = {
	{ Id = "gaming", Name = "Partida en directo", Cat = "gaming" },
	{ Id = "qa", Name = "Preguntas y respuestas", Cat = "vlog" },
	{ Id = "tech", Name = "Charla de tecnología", Cat = "tech" },
	{ Id = "cooking", Name = "Cocinando en directo", Cat = "cooking" },
	{ Id = "edit", Name = "Editando en directo", Cat = "tutorial" },
}

-- Preguntas del chat: la respuesta Best es la más adecuada para la comunidad
Live.Questions = {
	{ Q = "¿Qué cámara usas?", A = { "Te cuento mi equipo y por qué lo elegí", "Secreto", "La más cara, obvio" }, Best = 1 },
	{ Q = "¿Cada cuánto subes vídeos?", A = { "Cuando me apetece", "Intento publicar con constancia cada semana", "No sé" }, Best = 2 },
	{ Q = "¡Saludos desde la playa!", A = { "¡Hola! Gracias por pasarte 😊", "…", "Silencio, que me concentro" }, Best = 1 },
	{ Q = "¿Algún consejo para empezar?", A = { "Compra equipo caro", "Empieza con el teléfono y mejora poco a poco", "Copia a otros" }, Best = 2 },
	{ Q = "¿Harás un vídeo en la montaña?", A = { "¡Buena idea! Lo apunto", "Nunca", "Pregunta otra cosa" }, Best = 1 },
	{ Q = "Tu audio suena un poco bajo", A = { "Gracias por avisar, lo subo", "Será tu altavoz", "Ignorar" }, Best = 1 },
	{ Q = "¿Cuál es tu vídeo favorito?", A = { "Todos son malos", "El último, me costó mucho editarlo", "No me acuerdo" }, Best = 2 },
	{ Q = "¿Qué PC recomiendas para editar?", A = { "Depende del presupuesto; te explico", "El que sea", "No respondo eso" }, Best = 1 },
	{ Q = "¡Primera vez en tu directo!", A = { "¡Bienvenido a la comunidad!", "Vale", "¿Y?" }, Best = 1 },
	{ Q = "¿Cómo haces las miniaturas?", A = { "Texto corto, buen contraste y una foto clara", "Pongo mucho texto", "Al azar" }, Best = 1 },
}

function Live.Init(services)
	S = services
end

local function setupQuality(player)
	local stats = S.Computer.sessionStats(player) or {}
	local data = S.Data.get(player)
	local cam = S.Inventory.bestCatAtHome(player, "peripheral", "Cámara web", "Video")
	local video = cam and cam.Stats.Video or 0
	local _, _, camera = S.Inventory.best(player, "camera", "any", "Video")
	if camera then
		video = math.max(video, camera.Stats.Video * 0.9)
	end
	local _, _, mic = S.Inventory.best(player, "mic", "any", "Audio")
	local audio = mic and mic.Stats.Audio or 25
	local spot = S.Travel.currentSpot(player)
	local decor = spot and spot.Decor or 5
	local q = video * 0.4 + audio * 0.35 + math.min(45, decor) * 0.5 + math.min(20, (stats.Score or 20) / 5)
	return Util.clamp(q, 5, 100), video
end

local function pushState(player, s, kind, extra)
	local payload = { kind = kind, viewers = s.Viewers, peak = s.Peak, donations = s.Donations, subs = s.Subs, engagement = math.floor(s.Engagement * 100), left = math.max(0, math.floor(s.Ends - os.time())), topic = s.Topic.Name }
	for k, v in pairs(extra or {}) do
		payload[k] = v
	end
	S.Net.push(player, "live", payload)
end

local function finish(player)
	local s = sessions[player]
	if not s then
		return
	end
	sessions[player] = nil
	local data = S.Data.get(player)
	if not data then
		return
	end
	local avg = s.Ticks > 0 and math.floor(s.ViewerSum / s.Ticks) or 0
	local ads = math.floor(avg * 0.6)
	local total = ads + s.Donations
	data.Channel.Subs = data.Channel.Subs + s.Subs
	data.Counters.lives = (data.Counters.lives or 0) + 1
	data.Lives = data.Lives or {}
	Util.pushCapped(data.Lives, { Topic = s.Topic.Name, Peak = s.Peak, Avg = avg, Donations = s.Donations, Ads = ads, Subs = s.Subs, Engagement = math.floor(s.Engagement * 100), T = os.time() }, 20)
	if total > 0 then
		S.Economy.add(player, total, "Directos", "Directo: " .. s.Topic.Name, { taxable = true })
	end
	S.Progress.addXp(player, 30 + math.floor(s.Engagement * 30))
	S.Quest.check(player)
	pushState(player, s, "end", { avg = avg, ads = ads, total = total })
	S.Data.markDirty(player)
end

function Live.Start()
	local Net = S.Net

	Net.on("Live.Start", function(player, p)
		local data = S.Data.get(player)
		if sessions[player] then
			return false, "Ya estás en directo."
		end
		if not S.Computer.hasSession(player) then
			return false, "Haz el directo desde un computador o un portátil."
		end
		if os.time() - (data.LastLive or 0) < Live.Cooldown then
			return false, "Descansa un poco: podrás volver a emitir en " .. (Live.Cooldown - (os.time() - (data.LastLive or 0))) .. " s."
		end
		local topic = nil
		for _, t in ipairs(Live.Topics) do
			if t.Id == p.topic then
				topic = t
			end
		end
		if not topic then
			return false, "Elige un tema."
		end
		local q, video = setupQuality(player)
		if video <= 0 then
			return false, "Necesitas una cámara web en casa o una cámara para emitir."
		end
		data.LastLive = os.time()
		local s = { Topic = topic, Quality = q, Started = os.time(), Ends = os.time() + Live.Duration, Viewers = 1, Peak = 1, Donations = 0, Subs = 0, SubFrac = 0, Engagement = 0.35 + (S.Needs and S.Needs.mood(player) or 60) / 400, Ticks = 0, ViewerSum = 0, Question = nil, NextQ = os.time() + 8 }
		sessions[player] = s
		pushState(player, s, "start", { quality = math.floor(q) })
		return true, "🔴 ¡Estás en directo! Responde al chat para mantener a la audiencia."
	end)

	Net.on("Live.Answer", function(player, p)
		local s = sessions[player]
		if not s or not s.Question then
			return false, "No hay ninguna pregunta pendiente."
		end
		local q = s.Question
		s.Question = nil
		local choice = tonumber(p.choice)
		if choice == q.Best then
			s.Engagement = math.min(1, s.Engagement + 0.12)
			return true, "💬 ¡Buena respuesta! El chat se anima."
		end
		s.Engagement = math.max(0, s.Engagement - 0.06)
		return true, "💬 Al chat no le convenció mucho esa respuesta."
	end)

	Net.on("Live.Stop", function(player)
		if not sessions[player] then
			return false, "No estás en directo."
		end
		finish(player)
		return true, "Directo terminado."
	end)

	Net.on("Social.Post", function(player, p)
		local data = S.Data.get(player)
		if os.time() - (data.LastPost or 0) < 45 then
			return false, "Espera un poco antes de publicar otra vez."
		end
		local photo
		for _, ph in ipairs(data.Photos) do
			if ph.Id == p.photoId then
				photo = ph
			end
		end
		if not photo then
			return false, "Elige una foto del álbum."
		end
		local caption = Util.cleanText(p.caption or "", 80) or ""
		caption = S.Text.filter(player, caption)
		if not caption then
			return false, "No se pudo comprobar el texto."
		end
		data.LastPost = os.time()
		data.Counters.post_id = (data.Counters.post_id or 0) + 1
		local luck = Util.seededRandom("post" .. data.Counters.post_id .. player.UserId, 0.8, 1.2)
		local likes = math.floor((10 + data.Channel.Subs * 0.04 + math.sqrt(data.Channel.Subs) * 2) * (photo.Q / 60) * luck)
		local subs = math.floor(likes * 0.02 * (photo.Q / 70))
		data.Channel.Subs = data.Channel.Subs + subs
		data.Posts = data.Posts or {}
		Util.pushCapped(data.Posts, { Id = "s" .. data.Counters.post_id, PhotoId = photo.Id, Caption = caption, Likes = likes, Subs = subs, T = os.time(), Spot = photo.SpotName }, 30)
		data.Counters.posts = (data.Counters.posts or 0) + 1
		S.Progress.addXp(player, 5)
		S.Quest.check(player)
		return true, "📲 Publicado: ❤️ " .. likes .. " me gusta y +" .. subs .. " suscriptores."
	end)

	Players.PlayerRemoving:Connect(function(player)
		sessions[player] = nil
	end)

	task.spawn(function()
		while true do
			task.wait(3)
			for player, s in pairs(sessions) do
				local ok, err = pcall(function()
					local data = S.Data.get(player)
					if not data or not player.Parent then
						sessions[player] = nil
						return
					end
					if not S.Computer.hasSession(player) then
						finish(player)
						return
					end
					if s.Ticks % 10 == 0 and S.Needs then
						S.Needs.spend(player, 1)
					end
					local subs = data.Channel.Subs
					local trend = S.Channel.trendFor(s.Topic.Cat)
					local target = (4 + subs * 0.03 + math.sqrt(subs) * 2) * (0.5 + s.Quality / 100) * (0.6 + s.Engagement * 0.8) * trend
					s.Viewers = math.max(0, math.floor(s.Viewers + (target - s.Viewers) * 0.35 + (math.random() - 0.5) * target * 0.1))
					s.Peak = math.max(s.Peak, s.Viewers)
					s.Ticks = s.Ticks + 1
					s.ViewerSum = s.ViewerSum + s.Viewers
					s.SubFrac = s.SubFrac + s.Viewers * 0.004 * (0.5 + s.Engagement)
					local whole = math.floor(s.SubFrac)
					s.SubFrac = s.SubFrac - whole
					s.Subs = s.Subs + whole
					local extra = {}
					if math.random() < math.min(0.6, s.Viewers * 0.01) * (0.5 + s.Engagement) then
						local d = math.floor((1 + math.random() * 9) * (1 + subs / 5000))
						s.Donations = s.Donations + d
						extra.donation = d
					end
					if s.Question and os.time() > s.QuestionUntil then
						s.Question = nil
						s.Engagement = math.max(0, s.Engagement - 0.05)
					end
					if not s.Question and os.time() >= s.NextQ then
						local q = Live.Questions[math.random(1, #Live.Questions)]
						s.Question = q
						s.QuestionUntil = os.time() + 12
						s.NextQ = os.time() + 14
						extra.question = q.Q
						extra.answers = q.A
					end
					if os.time() >= s.Ends then
						finish(player)
					else
						pushState(player, s, "tick", extra)
					end
				end)
				if not ok then
					sessions[player] = nil
					S.Net.logError("live", err)
				end
			end
		end
	end)
end

return Live
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000033"><Properties><string name="Name">MonetizationService</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- MonetizationService: Game Passes (UserOwnsGamePassAsync) y Developer Products (ProcessReceipt).
--  * Los IDs vienen de ReplicatedStorage.Shared.MonetizationConfig (0 = no configurado).
--  * ProcessReceipt es idempotente: cada PurchaseId se registra en el perfil y nunca se entrega dos veces.
--  * Solo devuelve PurchaseGranted cuando la entrega quedó guardada; si el guardado falla, Roblox reintentará
--    y el registro evitará la entrega duplicada.

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local MonetizationConfig = require(ReplicatedStorage.Shared.MonetizationConfig)

local Monetization = {}
local S
local owned = {} -- [player] = { [key] = true }

function Monetization.Init(services)
	S = services
end

function Monetization.owns(player, key)
	return owned[player] ~= nil and owned[player][key] == true
end

function Monetization.ownedList(player)
	local list = {}
	for k in pairs(owned[player] or {}) do
		list[#list + 1] = k
	end
	return list
end

-- Suma de una ventaja numérica entre todos los pases que posee el jugador.
function Monetization.perk(player, perkName)
	local total = 0
	for key, pass in pairs(MonetizationConfig.GamePasses) do
		if Monetization.owns(player, key) then
			local v = pass.Perks[perkName]
			if type(v) == "number" then
				total = total + v
			elseif v == true then
				total = total + 1
			end
		end
	end
	return total
end

local function refresh(player)
	owned[player] = owned[player] or {}
	for key, pass in pairs(MonetizationConfig.GamePasses) do
		if MonetizationConfig.isConfigured(pass) then
			local ok, has = pcall(MarketplaceService.UserOwnsGamePassAsync, MarketplaceService, player.UserId, pass.Id)
			if ok and has then
				owned[player][key] = true
			end
		end
	end
end

function Monetization.onPlayerReady(player)
	refresh(player)
end

local function productById(id)
	for key, prod in pairs(MonetizationConfig.Products) do
		if MonetizationConfig.isConfigured(prod) and prod.Id == id then
			return key, prod
		end
	end
	return nil
end

local function processReceipt(info)
	local player = Players:GetPlayerByUserId(info.PlayerId)
	if not player then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local data = S.Data.get(player)
	if not data then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local purchaseId = tostring(info.PurchaseId)
	if data.Receipts[purchaseId] then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
	local key, prod = productById(info.ProductId)
	if not prod then
		S.Net.logError("receipt", "Producto desconocido " .. tostring(info.ProductId))
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	-- Entrega
	if prod.Grant.Money then
		S.Economy.add(player, prod.Grant.Money, "Tienda Robux", prod.Name, {})
	end
	if prod.Grant.ExportTokens then
		data.ExportTokens = data.ExportTokens + prod.Grant.ExportTokens
	end
	data.Receipts[purchaseId] = os.time()
	table.insert(data.ReceiptOrder, purchaseId)
	while #data.ReceiptOrder > 200 do
		data.Receipts[table.remove(data.ReceiptOrder, 1)] = nil
	end
	S.Net.notify(player, "¡Gracias por tu compra! Recibiste: " .. prod.Name, "success")
	S.Data.markDirty(player)
	if not S.Data.save(player, false) then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

function Monetization.Start()
	MarketplaceService.ProcessReceipt = processReceipt

	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
		if not purchased then
			return
		end
		for key, pass in pairs(MonetizationConfig.GamePasses) do
			if pass.Id == passId and MonetizationConfig.isConfigured(pass) then
				owned[player] = owned[player] or {}
				owned[player][key] = true
				S.Net.notify(player, "Game Pass activado: " .. pass.Name, "success")
				S.Avatar.refreshOverhead(player)
				S.Data.markDirty(player)
			end
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		owned[player] = nil
	end)

	S.Net.on("Shop.PassInfo", function(player)
		local list = {}
		for key, pass in pairs(MonetizationConfig.GamePasses) do
			list[#list + 1] = { Key = key, Name = pass.Name, Desc = pass.Description, Id = pass.Id, Configured = MonetizationConfig.isConfigured(pass), Owned = Monetization.owns(player, key) }
		end
		local prods = {}
		for key, prod in pairs(MonetizationConfig.Products) do
			prods[#prods + 1] = { Key = key, Name = prod.Name, Id = prod.Id, Configured = MonetizationConfig.isConfigured(prod) }
		end
		table.sort(list, function(a, b)
			return a.Name < b.Name
		end)
		table.sort(prods, function(a, b)
			return a.Name < b.Name
		end)
		return true, nil, { passes = list, products = prods }
	end)
end

return Monetization
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000034"><Properties><string name="Name">NPCService</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- NPCService: dependientes, barista, asesora del banco y vecinos con diálogos útiles.
-- Usa Players:CreateHumanoidModelFromDescription; si falla (por ejemplo en pruebas sin red),
-- crea un maniquí sencillo de Parts para que el NPC siga siendo funcional.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CollectionService = game:GetService("CollectionService")
local Shared = ReplicatedStorage.Shared
local Catalog = require(Shared.ItemCatalog)
local WorldData = require(Shared.WorldData)

local NPC = {}
local S
local npcs = {}

local tips = {
	"Los lugares con 🎥 son ideales para grabar. Cada distrito tiene los suyos.",
	"En la hora dorada (amanecer y atardecer) las tomas exteriores quedan más bonitas.",
	"Si llueve, una cámara resistente al agua evita gotas en la lente.",
	"Un trípode permite hacer time-lapses. ¡Al público le encantan!",
	"Un micrófono de solapa o de cañón mejora mucho el audio en la calle.",
	"Las reseñas con prueba real necesitan que tengas el producto en la mochila.",
	"Dicen que hay lugares secretos repartidos por la ciudad... busca destellos dorados.",
	"Con el taxi del teléfono llegas a cualquier distrito rápido, pero cuesta dinero.",
	"Las tendencias cambian cada día. Mira la app Tendencias antes de elegir idea.",
	"Un buen monitor mejora el etalonaje; un buen PC exporta mucho más rápido.",
}

local roleLines = {
	shopkeeper = { "¡Bienvenido! Puedes inspeccionar cualquier producto expuesto o ver todo el catálogo en el mostrador.",
		"Si compras aquí, te lo llevas al momento. Online tarda un poco más en llegar.",
		"¿Vas a grabar una reseña? Puedes probar los productos de exposición mientras estés en la tienda." },
	barista = { "Los computadores públicos son gratis. Perfectos para editar si aún no tienes uno bueno.",
		"Aquí vienen muchos estudiantes a editar sus vídeos." },
	waiter = { "¡Bienvenido! El menú del día es lo más popular. Pide en el mostrador.", "Comer bien sube tu energía y tu ánimo." },
	banker = { "Desde el cajero puedes ahorrar, crear metas y pedir préstamos con un 10% fijo.",
		"Revisa tu informe mensual: verás en qué gastas y cuánto ganas." },
}

function NPC.Init(services)
	S = services
end

local function buildDummy(name)
	local m = Instance.new("Model")
	m.Name = name
	local function part(n, size, offset, color)
		local p = Instance.new("Part")
		p.Name = n
		p.Size = size
		p.Anchored = true
		p.Color = color
		p.CFrame = CFrame.new(offset)
		p.Parent = m
		return p
	end
	local root = part("HumanoidRootPart", Vector3.new(2, 2, 1), Vector3.new(0, 3, 0), Color3.fromRGB(60, 120, 200))
	root.Transparency = 1
	part("Torso", Vector3.new(2, 2, 1), Vector3.new(0, 3, 0), Color3.fromRGB(60, 120, 200))
	part("Head", Vector3.new(1.2, 1.2, 1.2), Vector3.new(0, 4.6, 0), Color3.fromRGB(240, 200, 160))
	part("Legs", Vector3.new(2, 2, 1), Vector3.new(0, 1, 0), Color3.fromRGB(40, 40, 50))
	local hum = Instance.new("Humanoid")
	hum.Parent = m
	m.PrimaryPart = root
	return m
end

local function spawnNpc(point, index)
	local m
	local ok = pcall(function()
		local desc = Instance.new("HumanoidDescription")
		m = Players:CreateHumanoidModelFromDescription(desc, Enum.HumanoidRigType.R15)
	end)
	if not ok or not m then
		m = buildDummy(point.Name)
	end
	m.Name = point.Name
	for _, p in ipairs(m:GetDescendants()) do
		if p:IsA("BasePart") then
			p.Anchored = true
		end
	end
	local hum = m:FindFirstChildOfClass("Humanoid")
	if hum then
		hum.DisplayName = point.Name
		hum.NameDisplayDistance = 40
	end
	m.Parent = workspace:FindFirstChild("City") or workspace
	local look = Vector3.new(point.Look.X, point.Pos.Y + 3, point.Look.Z)
	local pos = Vector3.new(point.Pos.X, point.Pos.Y + 3, point.Pos.Z)
	if (look - pos).Magnitude < 0.1 then
		look = pos + Vector3.new(0, 0, 1)
	end
	m:PivotTo(CFrame.lookAt(pos, look))
	local root = m.PrimaryPart or m:FindFirstChild("HumanoidRootPart")
	local id = "npc" .. index
	local pp = Instance.new("ProximityPrompt")
	pp.ActionText = "Hablar"
	pp.ObjectText = point.Name
	pp.HoldDuration = 0
	pp.MaxActivationDistance = 10
	pp.RequiresLineOfSight = false
	pp:SetAttribute("Action", "npc")
	pp:SetAttribute("NpcId", id)
	pp.Parent = root
	pp.Triggered:Connect(function(player)
		local okTalk, err = pcall(S.World.onPrompt, pp, player)
		if not okTalk then
			S.Net.logError("npc", err)
		end
	end)
	npcs[id] = { Point = point, Count = 0 }
end

function NPC.talk(player, id)
	local npc = npcs[id or ""]
	if not npc then
		return
	end
	npc.Count = npc.Count + 1
	local p = npc.Point
	local lines = roleLines[p.Role] or tips
	local text = lines[(npc.Count % #lines) + 1]
	local options = {}
	if p.Role == "shopkeeper" and p.Store then
		options[#options + 1] = { label = "Ver catálogo", ui = "store", store = p.Store }
		S.Travel.markStoreVisit(player, p.Store)
	elseif p.Role == "banker" then
		options[#options + 1] = { label = "Abrir banco", ui = "app", app = "bank" }
	elseif p.Role == "citizen" then
		local d = WorldData.DistrictById[p.District or ""]
		text = tips[(npc.Count + #(p.Name)) % #tips + 1]
		if d then
			text = "¡Hola! Esto es " .. d.Name .. ". " .. text
		end
	end
	S.Net.push(player, "dialog", { name = p.Name, text = text, options = options })
end

function NPC.Start()
	task.defer(function()
		for i, point in ipairs(S.World.NpcPoints) do
			local ok, err = pcall(spawnNpc, point, i)
			if not ok then
				S.Net.logError("npc spawn", err)
			end
		end
	end)
end

return NPC
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000035"><Properties><string name="Name">NeedsService</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- NeedsService: energía y ánimo con efectos MODERADOS (nunca bloquean el juego).
--  * La energía baja despacio mientras juegas y al grabar, trabajar o emitir.
--  * Comer (supermercado, restaurante, cafetería, máquinas, cocina, domicilio) y descansar la recuperan.
--  * Energía < 25: escenas algo menos interesantes y exportaciones un 15% más lentas.
--  * Ánimo alto (> 80): escenas algo más interesantes y directos más animados.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local Shared = ReplicatedStorage.Shared
local FoodData = require(Shared.FoodData)
local Catalog = require(Shared.ItemCatalog)
local Util = require(Shared.Util)

local Needs = {}
local S
local lastRest = {}
local warned = {}

function Needs.Init(services)
	S = services
end

local function needs(data)
	data.Needs = data.Needs or { Energy = 100, Mood = 70 }
	return data.Needs
end
Needs.get = needs

function Needs.change(player, energy, mood)
	local data = S.Data.get(player)
	if not data then
		return
	end
	local n = needs(data)
	n.Energy = Util.clamp(n.Energy + (energy or 0), 0, 100)
	n.Mood = Util.clamp(n.Mood + (mood or 0), 0, 100)
	if n.Energy < 20 and not warned[player] then
		warned[player] = true
		S.Net.notify(player, "🥱 Estás cansado: come algo o descansa en una cama (efecto leve en tus vídeos).", "warn")
	elseif n.Energy >= 40 then
		warned[player] = nil
	end
	S.Data.markDirty(player)
end

function Needs.spend(player, amount)
	Needs.change(player, -amount, 0)
end

function Needs.interestBonus(player)
	local data = S.Data.get(player)
	if not data then
		return 0
	end
	local n = needs(data)
	local b = 0
	if n.Energy < 25 then
		b = b - 4
	end
	if n.Mood > 80 then
		b = b + 3
	elseif n.Mood < 30 then
		b = b - 2
	end
	return b
end

function Needs.exportMult(player)
	local data = S.Data.get(player)
	return (data and needs(data).Energy < 25) and 1.15 or 1
end

function Needs.mood(player)
	local data = S.Data.get(player)
	return data and needs(data).Mood or 60
end

local function eat(player, name, energy, mood)
	Needs.change(player, energy, mood)
	local data = S.Data.get(player)
	data.Counters.meals = (data.Counters.meals or 0) + 1
	S.Quest.check(player)
	return "🍽 " .. name .. ": energía +" .. energy .. ", ánimo +" .. mood .. "."
end

function Needs.rest(player)
	if not S.Home.isAtHome(player) then
		S.Net.notify(player, "Descansa en tu casa.", "info")
		return
	end
	if lastRest[player] and os.clock() - lastRest[player] < 90 then
		S.Net.notify(player, "Acabas de descansar.", "info")
		return
	end
	lastRest[player] = os.clock()
	Needs.change(player, 50, 6)
	S.Net.notify(player, "😴 Has descansado: energía +50.", "success")
end

local function placeNear(player, kind)
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if not root then
		return false
	end
	local list = {}
	if kind == "vending" then
		list = S.World.VendingMachines or {}
	else
		for _, sp in ipairs(S.World.Specials) do
			if (kind == "restaurant" and sp.Type == "restaurant") or (kind == "cafe" and sp.Type == "cafe") then
				list[#list + 1] = Vector3.new(sp.WX, 0, sp.WZ)
			end
		end
	end
	for _, pos in ipairs(list) do
		local dx, dz = root.Position.X - pos.X, root.Position.Z - pos.Z
		if dx * dx + dz * dz <= 40 * 40 then
			return true
		end
	end
	return false
end

function Needs.Start()
	local Net = S.Net

	Net.on("Food.Eat", function(player, p)
		local data = S.Data.get(player)
		local rec = data.Inventory[p.uid or ""]
		local def = rec and Catalog.get(rec.Id)
		if not def or def.Cat ~= "food" then
			return false, "Eso no se puede comer."
		end
		if rec.Loc ~= "home" and rec.Loc ~= "backpack" then
			return false, "No lo tienes a mano."
		end
		S.Inventory.remove(player, p.uid)
		return true, eat(player, def.Name, def.Stats.Energy, def.Stats.Mood)
	end)

	Net.on("Food.Order", function(player, p)
		local menu = FoodData.Menus[p.place or ""]
		if not menu then
			return false, "Lugar no válido."
		end
		if not placeNear(player, p.place) then
			return false, "Tienes que estar en " .. menu.Name .. "."
		end
		local item
		for _, it in ipairs(menu.Items) do
			if it[1] == p.item then
				item = it
			end
		end
		if not item then
			return false, "Ese plato no está en el menú."
		end
		if not S.Economy.spend(player, item[3], "Comida", item[2] .. " (" .. menu.Name .. ")") then
			return false, "Cuesta $" .. item[3] .. "."
		end
		local data = S.Data.get(player)
		if p.place == "restaurant" then
			data.Counters.restaurant_meals = (data.Counters.restaurant_meals or 0) + 1
		end
		return true, eat(player, item[2], item[4], item[5])
	end)

	Net.on("Food.Cook", function(player, p)
		local data = S.Data.get(player)
		if not S.Home.isAtHome(player) then
			return false, "Cocina en la cocina de tu casa."
		end
		local recipe
		for _, r in ipairs(FoodData.Recipes) do
			if r.Id == p.recipe then
				recipe = r
			end
		end
		if not recipe then
			return false, "Receta no válida."
		end
		local used = {}
		for _, need in ipairs(recipe.Needs) do
			local found = nil
			for uid, rec in pairs(data.Inventory) do
				if rec.Id == need and not used[uid] and (rec.Loc == "home" or rec.Loc == "backpack") then
					found = uid
					break
				end
			end
			if not found then
				return false, "Te falta: " .. Catalog.get(need).Name .. ". Cómpralo en el Supermercado Fresco."
			end
			used[found] = true
		end
		for uid in pairs(used) do
			S.Inventory.remove(player, uid)
		end
		S.Inventory.add(player, recipe.Id, { src = "cook", paid = 0, loc = "home" })
		data.Counters.cooked = (data.Counters.cooked or 0) + 1
		Needs.change(player, 0, 4)
		S.Quest.check(player)
		return true, "👨‍🍳 Has cocinado " .. Catalog.get(recipe.Id).Name .. ". Está en tu despensa."
	end)

	Net.on("Food.Delivery", function(player, p)
		local data = S.Data.get(player)
		local price = FoodData.Delivery.Prices[p.item or ""]
		if not price then
			return false, "Ese plato no está disponible a domicilio."
		end
		data.FoodOrders = data.FoodOrders or {}
		if #data.FoodOrders >= 3 then
			return false, "Ya tienes 3 pedidos de comida en camino."
		end
		local total = price + FoodData.Delivery.Fee
		if not S.Economy.spend(player, total, "Comida", "Comida a domicilio: " .. Catalog.get(p.item).Name) then
			return false, "Cuesta $" .. total .. " (incluye $" .. FoodData.Delivery.Fee .. " de envío)."
		end
		table.insert(data.FoodOrders, { Item = p.item, Eta = os.time() + FoodData.Delivery.Seconds })
		return true, "🛵 Pedido en camino: llega a tu casa en " .. FoodData.Delivery.Seconds .. " s."
	end)

	Net.on("Food.Rest", function(player)
		Needs.rest(player)
		return true
	end)

	Players.PlayerRemoving:Connect(function(player)
		lastRest[player] = nil
		warned[player] = nil
	end)

	task.spawn(function()
		while true do
			task.wait(10)
			for _, player in ipairs(Players:GetPlayers()) do
				local data = S.Data.get(player)
				if data then
					local n = needs(data)
					n.Energy = math.max(0, n.Energy - 0.25)
					n.Mood = n.Mood + (60 - n.Mood) * 0.01
					-- comida a domicilio
					local orders = data.FoodOrders or {}
					for i = #orders, 1, -1 do
						if os.time() >= orders[i].Eta then
							local item = orders[i].Item
							table.remove(orders, i)
							S.Inventory.add(player, item, { src = "delivery", paid = 0, loc = "home" })
							S.Net.notify(player, "🛵 Tu comida ha llegado a casa: " .. Catalog.get(item).Name, "success")
						end
					end
					S.Data.markDirty(player)
				end
			end
		end
	end)
end

return Needs
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000036"><Properties><string name="Name">Net</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Net: único punto de entrada de peticiones del cliente.
--   Remotes/Request (RemoteFunction): el cliente pide una acción -> { ok, msg, data }
--   Remotes/Push (RemoteEvent): el servidor envía estado, avisos y aperturas de interfaz.
-- Todas las acciones se validan en el servidor. Hay límite de peticiones por jugador
-- y los errores se registran sin tumbar el servidor.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

local Config = require(ReplicatedStorage.Shared.Config)

local Net = {}
local S
local handlers = {}
local buckets = {}
local errorLog = {}

Net.ErrorLog = errorLog

function Net.Init(services)
	S = services
	local folder = ReplicatedStorage:FindFirstChild("Remotes")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "Remotes"
		folder.Parent = ReplicatedStorage
	end
	local request = folder:FindFirstChild("Request") or Instance.new("RemoteFunction")
	request.Name = "Request"
	request.Parent = folder
	local push = folder:FindFirstChild("Push") or Instance.new("RemoteEvent")
	push.Name = "Push"
	push.Parent = folder
	Net.RequestRemote = request
	Net.PushRemote = push

	request.OnServerInvoke = function(player, action, payload)
		return Net.dispatch(player, action, payload)
	end
	Players.PlayerRemoving:Connect(function(player)
		buckets[player] = nil
	end)
end

function Net.logError(where, err)
	local entry = os.date("!%H:%M:%S") .. " [" .. tostring(where) .. "] " .. tostring(err)
	table.insert(errorLog, 1, entry)
	while #errorLog > 50 do
		table.remove(errorLog)
	end
	warn("[YTLife] " .. entry)
end

-- Registra una acción. opts.noProfile = no requiere datos cargados.
function Net.on(action, fn, opts)
	assert(handlers[action] == nil, "Acción duplicada: " .. action)
	handlers[action] = { fn = fn, opts = opts or {} }
end

local function allow(player)
	local now = os.clock()
	local b = buckets[player]
	if not b then
		b = { tokens = Config.RequestsPerSecond, last = now }
		buckets[player] = b
	end
	b.tokens = math.min(Config.RequestsPerSecond, b.tokens + (now - b.last) * Config.RequestsPerSecond)
	b.last = now
	if b.tokens < 1 then
		return false
	end
	b.tokens = b.tokens - 1
	return true
end

function Net.dispatch(player, action, payload)
	if type(action) ~= "string" then
		return { ok = false, msg = "Petición no válida." }
	end
	local h = handlers[action]
	if not h then
		return { ok = false, msg = "Acción desconocida: " .. action }
	end
	if not allow(player) then
		return { ok = false, msg = "Vas demasiado rápido. Espera un momento." }
	end
	if not h.opts.noProfile and not S.Data.get(player) then
		return { ok = false, msg = "Tus datos aún se están cargando." }
	end
	if payload ~= nil and type(payload) ~= "table" then
		payload = {}
	end
	payload = payload or {}
	local success, ok, msg, data = pcall(h.fn, player, payload)
	if not success then
		Net.logError(action, ok)
		return { ok = false, msg = "Ha ocurrido un error. Inténtalo de nuevo." }
	end
	if ok ~= false then
		S.Data.markDirty(player)
	end
	return { ok = ok ~= false, msg = msg, data = data }
end

function Net.push(player, kind, data)
	if player and player.Parent then
		Net.PushRemote:FireClient(player, kind, data)
	end
end

function Net.pushAll(kind, data)
	Net.PushRemote:FireAllClients(kind, data)
end

-- Atajos de notificación
function Net.notify(player, text, style)
	Net.push(player, "notify", { text = text, style = style or "info" })
end

return Net
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000037"><Properties><string name="Name">ProgressService</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- ProgressService: experiencia, niveles y rango de creador.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Progression = require(ReplicatedStorage.Shared.Progression)

local Progress = {}
local S

Progress.Xp = Progression.Xp

function Progress.Init(services)
	S = services
end

function Progress.rank(data)
	return Progression.rankFor(data.Level, data.Channel.Subs, data.Counters.published or 0, data.Reputation)
end

function Progress.addXp(player, amount)
	local data = S.Data.get(player)
	if not data or amount <= 0 then
		return
	end
	local oldRank = Progress.rank(data)
	local level, xp, ups = Progression.applyXp(data.Level, data.XP, amount)
	data.Level, data.XP = level, xp
	if ups > 0 then
		S.Net.push(player, "levelUp", { level = level })
		S.Quest.check(player)
	end
	local newRank, rank = Progress.rank(data)
	if newRank > oldRank then
		S.Net.push(player, "rankUp", { name = rank.Name, unlock = rank.Unlock })
		S.Avatar.refreshOverhead(player)
	end
	S.Data.markDirty(player)
end

function Progress.Start() end

return Progress
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000038"><Properties><string name="Name">PropertyService</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- PropertyService (Fase 2): inmobiliaria, contratos, interiores y modo construcción.
--  * Alquilar (primera semana + fianza), comprar, convertir alquiler en compra, terminar contrato, vender.
--  * Pagos cada 7 días JUGADOS: alquiler o mantenimiento. Impago = deuda + recargo. Tras 3 impagos un
--    alquiler se rescinde, pero los muebles vuelven al inventario (nunca se pierde nada).
--  * Cada jugador tiene un interior privado que se construye al entrar, con su decoración y muebles.
--  * Modo construcción: colocar, mover, rotar y recoger muebles; paredes, suelo, luz, cortinas, estilos,
--    mejoras (aislamiento, seguridad, almacenaje, iluminación) y diseños guardados.
--  * La decoración y las mejoras afectan de verdad a las grabaciones hechas dentro.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local CollectionService = game:GetService("CollectionService")
local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Catalog = require(Shared.ItemCatalog)
local PropertyData = require(Shared.PropertyData)
local WorldData = require(Shared.WorldData)
local Util = require(Shared.Util)

local Property = {}
local S
local interiors = {} -- [player] = { Id, Origin, Model, W, D }
local slots = {} -- [index] = player
local folderRoot

Property.WallHeight = 14

function Property.Init(services)
	S = services
end

local function rgb(t)
	return Color3.fromRGB(t[1], t[2], t[3])
end

---------------------------------------------------------------------------
-- Posiciones exteriores (carteles en cada distrito)
---------------------------------------------------------------------------
function Property.signPosition(listing)
	local d = WorldData.DistrictById[listing.District]
	local cx, cz = WorldData.center(d)
	local idx = 0
	for _, l in ipairs(PropertyData.Listings) do
		if l.District == listing.District then
			idx = idx + 1
		end
		if l == listing then
			break
		end
	end
	return Vector3.new(cx - 66 + (idx - 1) * 26, 0.5, cz + 121)
end

---------------------------------------------------------------------------
-- Consultas
---------------------------------------------------------------------------
local function held(data, id)
	return data.Properties[id]
end

function Property.count(data)
	return Util.count(data.Properties)
end

function Property.storageCap(player)
	local data = S.Data.get(player)
	local cap = PropertyData.StarterStorage
	for id, rec in pairs(data.Properties) do
		local l = PropertyData.ById[id]
		if l then
			cap = cap + math.floor(l.Storage * (rec.Upgrades.storage and 1.5 or 1))
		end
	end
	return cap
end

function Property.storedCount(player)
	local data = S.Data.get(player)
	local n = 0
	for _, rec in pairs(data.Inventory) do
		if rec.Loc ~= "backpack" then
			n = n + 1
		end
	end
	return n
end

function Property.canStore(player, n)
	return Property.storedCount(player) + (n or 1) <= Property.storageCap(player)
end

function Property.inside(player)
	local it = interiors[player]
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if not it or not root then
		return nil
	end
	local rel = root.Position - it.Origin
	if math.abs(rel.X) <= it.W / 2 + 2 and math.abs(rel.Z) <= it.D / 2 + 2 and rel.Y > -5 and rel.Y < 30 then
		return it.Id
	end
	return nil
end

function Property.interiorInfo(player)
	local it = interiors[player]
	if not it then
		return nil
	end
	return { Id = it.Id, Origin = { it.Origin.X, it.Origin.Y, it.Origin.Z }, W = it.W, D = it.D }
end

-- Puntuación de decoración de una propiedad (0-45)
function Property.decorScore(player, id)
	local data = S.Data.get(player)
	local rec = data.Properties[id]
	if not rec then
		return 0
	end
	local score, styles = 0, {}
	for uid in pairs(rec.Placed) do
		local item = data.Inventory[uid]
		local def = item and Catalog.get(item.Id)
		if def then
			score = score + (def.Stats.Decor or 0) * (0.7 + 0.3 * def.Quality / 100)
			if def.Style then
				styles[def.Style] = (styles[def.Style] or 0) + 1
			end
		end
	end
	local bonus = 0
	for _, n in pairs(styles) do
		if n >= 3 then
			bonus = bonus + 5
		end
	end
	score = score + math.min(10, bonus)
	-- Paredes/suelo/luz que coinciden con un estilo
	for _, st in ipairs(PropertyData.Styles) do
		if st.Wall == rec.Decor.Wall and st.Floor == rec.Decor.Floor and st.Light == rec.Decor.Light then
			score = score + 4
			break
		end
	end
	if rec.Decor.Curtain then
		score = score + 1
	end
	return math.floor(math.min(45, score) * 10 + 0.5) / 10
end

-- Lugar de grabación cuando estás dentro de una propiedad
function Property.spot(player)
	local id = Property.inside(player)
	if not id then
		return nil
	end
	local data = S.Data.get(player)
	local l = PropertyData.ById[id]
	local rec = data.Properties[id]
	local tags = { "home" }
	if l.Kind == "home" then
		tags[#tags + 1] = "food"
	end
	for _, t in ipairs(l.Tags or {}) do
		if not Util.indexOf(tags, t) then
			tags[#tags + 1] = t
		end
	end
	if l.Kind == "studio" and not Util.indexOf(tags, "studio") then
		tags[#tags + 1] = "studio"
	end
	local decor = Property.decorScore(player, id)
	if decor >= 15 and not Util.indexOf(tags, "studio") then
		tags[#tags + 1] = "studio"
	end
	local acoustic = 0
	for uid in pairs(rec.Placed) do
		local item = data.Inventory[uid]
		local def = item and Catalog.get(item.Id)
		if def and def.Stats.Acoustic then
			acoustic = acoustic + def.Stats.Acoustic
		end
	end
	local noise = math.max(0, 2 - (rec.Upgrades.soundproof and 3 or 0) - math.min(4, acoustic))
	local light = (rec.Upgrades.lightrig and 20 or 0) + (rec.Decor.Light == 5 and 8 or 0)
	return {
		Id = "prop_" .. id,
		Name = l.Name,
		Tags = tags,
		Indoor = true,
		Interest = 5 + math.floor((l.Env + (rec.Upgrades.security and 5 or 0)) / 10) + math.floor(l.Studio / 3),
		Noise = noise,
		Busy = 0,
		IsHome = true,
		Decor = 5 + decor,
		ExtraLight = light,
		District = l.District,
	}
end

---------------------------------------------------------------------------
-- Construcción de interiores
---------------------------------------------------------------------------
local function P(parent, name, size, cf, color, material, opts)
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.Size = size
	p.CFrame = cf
	p.Color = typeof(color) == "Color3" and color or rgb(color)
	p.Material = material or Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if opts then
		if opts.Shape then
			p.Shape = opts.Shape
		end
		if opts.Transparency then
			p.Transparency = opts.Transparency
		end
		if opts.NoCollide then
			p.CanCollide = false
		end
	end
	p.Parent = parent
	return p
end

local function addPrompt(part, action, text, objectText, attrs)
	local pp = Instance.new("ProximityPrompt")
	pp.ActionText = text
	pp.ObjectText = objectText or ""
	pp.HoldDuration = 0
	pp.MaxActivationDistance = 10
	pp.RequiresLineOfSight = false
	pp:SetAttribute("Action", action)
	for k, v in pairs(attrs or {}) do
		pp:SetAttribute(k, v)
	end
	pp.Parent = part
	CollectionService:AddTag(pp, "YTPrompt")
	return pp
end

-- Modelo de un mueble (huella en el suelo centrada en cf)
function Property.furnitureModel(parent, def, cf, uid)
	local m = Instance.new("Model")
	m.Name = def.Name
	m:SetAttribute("FurnitureUid", uid)
	local c = rgb(def.Color)
	local f = def.Foot or { 4, 4, 3 }
	local w, d, h = f[1], f[2], f[3]
	local shape = def.Shape
	if shape == "sofa" then
		P(m, "Seat", Vector3.new(w, 1.4, d), cf * CFrame.new(0, 0.9, 0), c, Enum.Material.Fabric)
		P(m, "Back", Vector3.new(w, 2.2, 0.8), cf * CFrame.new(0, 2.4, -d / 2 + 0.4), c, Enum.Material.Fabric)
		P(m, "ArmL", Vector3.new(0.8, 1.8, d), cf * CFrame.new(-w / 2 + 0.4, 1.6, 0), c, Enum.Material.Fabric)
		P(m, "ArmR", Vector3.new(0.8, 1.8, d), cf * CFrame.new(w / 2 - 0.4, 1.6, 0), c, Enum.Material.Fabric)
	elseif shape == "lamp" then
		P(m, "Pole", Vector3.new(0.3, h - 1, 0.3), cf * CFrame.new(0, (h - 1) / 2, 0), { 40, 40, 44 }, Enum.Material.Metal)
		local shade = P(m, "Shade", Vector3.new(w, 1.2, d), cf * CFrame.new(0, h - 0.6, 0), c, Enum.Material.Neon)
		local l = Instance.new("PointLight")
		l.Range = 16
		l.Brightness = 1.2
		l.Color = c
		l.Parent = shade
	elseif shape == "painting" then
		P(m, "Stand", Vector3.new(0.3, 3, 0.3), cf * CFrame.new(0, 1.5, 0), { 60, 45, 35 }, Enum.Material.Wood)
		P(m, "Frame", Vector3.new(w, h, 0.3), cf * CFrame.new(0, 3 + h / 2 - 1, 0), { 60, 45, 35 }, Enum.Material.Wood)
		P(m, "Canvas", Vector3.new(w - 0.6, h - 0.6, 0.1), cf * CFrame.new(0, 3 + h / 2 - 1, 0.2), c, Enum.Material.SmoothPlastic)
	elseif shape == "plant" then
		P(m, "Pot", Vector3.new(w * 0.7, 1.4, d * 0.7), cf * CFrame.new(0, 0.7, 0), { 170, 90, 60 }, Enum.Material.Slate)
		P(m, "Leaves", Vector3.new(w, h - 1.4, d), cf * CFrame.new(0, 1.4 + (h - 1.4) / 2, 0), c, Enum.Material.Grass, { Shape = Enum.PartType.Ball })
	elseif shape == "rug" then
		P(m, "Rug", Vector3.new(w, 0.15, d), cf * CFrame.new(0, 0.08, 0), c, Enum.Material.Fabric, { NoCollide = true })
	elseif shape == "shelf" then
		P(m, "Shelf", Vector3.new(w, h, d), cf * CFrame.new(0, h / 2, 0), c, Enum.Material.WoodPlanks)
		for i = 1, 3 do
			P(m, "Items", Vector3.new(w - 1, 1, d * 0.6), cf * CFrame.new(0, i * h / 4, d * 0.15), { 200, 60 + i * 40, 80 }, Enum.Material.SmoothPlastic)
		end
	elseif shape == "bed" then
		P(m, "Frame", Vector3.new(w, 1, d), cf * CFrame.new(0, 0.5, 0), { 110, 80, 60 }, Enum.Material.Wood)
		P(m, "Mattress", Vector3.new(w - 0.4, 1, d - 0.4), cf * CFrame.new(0, 1.5, 0), c, Enum.Material.Fabric)
		P(m, "Pillow", Vector3.new(w - 1.5, 0.6, 1.4), cf * CFrame.new(0, 2.2, -d / 2 + 1.2), { 255, 255, 255 }, Enum.Material.Fabric)
	elseif shape == "table" or shape == "desk" then
		P(m, "Top", Vector3.new(w, 0.4, d), cf * CFrame.new(0, h - 0.2, 0), c, Enum.Material.WoodPlanks)
		for _, sx in ipairs({ -1, 1 }) do
			for _, sz in ipairs({ -1, 1 }) do
				P(m, "Leg", Vector3.new(0.4, h - 0.4, 0.4), cf * CFrame.new(sx * (w / 2 - 0.4), (h - 0.4) / 2, sz * (d / 2 - 0.4)), c, Enum.Material.Wood)
			end
		end
	elseif shape == "curtain" then
		P(m, "Rod", Vector3.new(w, 0.3, 0.3), cf * CFrame.new(0, h, 0), { 50, 50, 55 }, Enum.Material.Metal)
		P(m, "Curtain", Vector3.new(w, h, 0.3), cf * CFrame.new(0, h / 2, 0.2), c, Enum.Material.Fabric)
	elseif shape == "panel" then
		for i = 0, 2 do
			P(m, "Foam", Vector3.new(w / 3 - 0.2, h, 0.6), cf * CFrame.new(-w / 3 + i * w / 3, h / 2 + 1, 0), c, Enum.Material.Fabric)
		end
	elseif shape == "partition" then
		P(m, "Partition", Vector3.new(w, h, d), cf * CFrame.new(0, h / 2, 0), c, Enum.Material.Plaster)
	elseif shape == "neon" then
		P(m, "Stand", Vector3.new(0.3, 4, 0.3), cf * CFrame.new(0, 2, 0), { 30, 30, 34 }, Enum.Material.Metal)
		local sign = P(m, "Neon", Vector3.new(w, h, 0.3), cf * CFrame.new(0, 4 + h / 2, 0), c, Enum.Material.Neon)
		local gui = Instance.new("SurfaceGui")
		gui.Face = Enum.NormalId.Front
		gui.Parent = sign
		local t = Instance.new("TextLabel")
		t.Size = UDim2.fromScale(1, 1)
		t.BackgroundTransparency = 1
		t.TextScaled = true
		t.Font = Enum.Font.GothamBlack
		t.TextColor3 = Color3.new(1, 1, 1)
		t.Text = "ON AIR"
		t.Parent = gui
	elseif shape == "beanbag" then
		P(m, "Bag", Vector3.new(w, w, w), cf * CFrame.new(0, w / 2 - 0.4, 0), c, Enum.Material.Fabric, { Shape = Enum.PartType.Ball })
	elseif shape == "seccam" then
		P(m, "Pole", Vector3.new(0.3, 9, 0.3), cf * CFrame.new(0, 4.5, 0), { 40, 40, 44 }, Enum.Material.Metal)
		local cam = P(m, "Camera", Vector3.new(1, 0.8, 1.4), cf * CFrame.new(0, 9.4, 0), c, Enum.Material.Metal)
		P(m, "Led", Vector3.new(0.2, 0.2, 0.1), cam.CFrame * CFrame.new(0.3, 0.2, -0.72), { 255, 30, 30 }, Enum.Material.Neon)
	elseif shape == "chair" then
		P(m, "Seat", Vector3.new(w, 0.5, d), cf * CFrame.new(0, 1.8, 0), c)
		P(m, "Back", Vector3.new(w, 2.6, 0.4), cf * CFrame.new(0, 3.2, -d / 2 + 0.2), c)
		P(m, "Base", Vector3.new(0.5, 1.6, 0.5), cf * CFrame.new(0, 0.8, 0), { 40, 40, 44 }, Enum.Material.Metal)
	else
		P(m, "Body", Vector3.new(w, h, d), cf * CFrame.new(0, h / 2, 0), c)
	end
	m.Parent = parent
	return m
end

local function slotFor(player)
	for i = 1, 60 do
		if slots[i] == player then
			return i
		end
	end
	for i = 1, 60 do
		if slots[i] == nil then
			slots[i] = player
			return i
		end
	end
	return 60
end

function Property.buildInterior(player, id)
	local data = S.Data.get(player)
	local rec = data.Properties[id]
	local l = PropertyData.ById[id]
	if not rec or not l then
		return nil
	end
	if not folderRoot then
		folderRoot = workspace:FindFirstChild("Interiors") or Instance.new("Folder")
		folderRoot.Name = "Interiors"
		folderRoot.Parent = workspace
	end
	local old = interiors[player]
	if old and old.Model then
		old.Model:Destroy()
	end
	local index = slotFor(player)
	local origin = Vector3.new(-4200 - (index - 1) % 6 * 260, 0, (math.floor((index - 1) / 6)) * 260)
	local base = CFrame.new(origin)
	local m = Instance.new("Model")
	m.Name = "Interior_" .. player.UserId
	local W, D, H = l.W, l.D, Property.WallHeight
	local wall = PropertyData.Walls[rec.Decor.Wall] or PropertyData.Walls[1]
	local floor = PropertyData.Floors[rec.Decor.Floor] or PropertyData.Floors[1]
	local light = PropertyData.Lights[rec.Decor.Light] or PropertyData.Lights[2]
	local isLand = l.Kind == "land"
	P(m, "Floor", Vector3.new(W, 1, D), base * CFrame.new(0, -0.5, 0), isLand and { 90, 150, 80 } or floor[3], isLand and Enum.Material.Grass or Enum.Material[floor[2]])
	if isLand then
		for _, side in ipairs({ { 0, -D / 2, W, 0.5 }, { 0, D / 2, W, 0.5 }, { -W / 2, 0, 0.5, D }, { W / 2, 0, 0.5, D } }) do
			P(m, "Fence", Vector3.new(side[3], 3, side[4]), base * CFrame.new(side[1], 1.5, side[2]), { 240, 240, 240 }, Enum.Material.WoodPlanks)
		end
		P(m, "OuterGround", Vector3.new(W + 200, 1, D + 200), base * CFrame.new(0, -0.6, 0), { 80, 140, 70 }, Enum.Material.Grass)
	else
		P(m, "Ceiling", Vector3.new(W, 1, D), base * CFrame.new(0, H + 0.5, 0), { 245, 245, 245 }, Enum.Material.SmoothPlastic)
		for _, side in ipairs({ { 0, -D / 2, W, 1 }, { 0, D / 2, W, 1 }, { -W / 2, 0, 1, D }, { W / 2, 0, 1, D } }) do
			P(m, "Wall", Vector3.new(side[3], H, side[4]), base * CFrame.new(side[1], H / 2, side[2]), wall[2], Enum.Material.Plaster)
		end
		for i = -1, 1, 2 do
			local lamp = P(m, "CeilingLight", Vector3.new(4, 0.3, 4), base * CFrame.new(i * W / 4, H - 0.2, 0), light[2], Enum.Material.Neon)
			local pl = Instance.new("PointLight")
			pl.Range = math.max(W, D) * 0.7
			pl.Brightness = light[3]
			pl.Color = rgb(light[2])
			pl.Parent = lamp
		end
		-- Ventana con vista
		local win = P(m, "Window", Vector3.new(math.min(16, W - 8), 6, 0.3), base * CFrame.new(0, 7, -D / 2 + 0.7), { 150, 200, 240 }, Enum.Material.Glass, { Transparency = 0.2 })
		local gui = Instance.new("SurfaceGui")
		gui.Face = Enum.NormalId.Back
		gui.Parent = win
		local t = Instance.new("TextLabel")
		t.Size = UDim2.fromScale(1, 1)
		t.BackgroundTransparency = 1
		t.TextScaled = true
		t.Font = Enum.Font.GothamBold
		t.TextColor3 = Color3.fromRGB(255, 255, 255)
		t.TextTransparency = 0.4
		t.Text = l.View or "Vista a la ciudad"
		t.Parent = gui
		if rec.Decor.Curtain then
			P(m, "WindowCurtain", Vector3.new(3, 8, 0.3), base * CFrame.new(-math.min(16, W - 8) / 2 - 1.5, 7, -D / 2 + 1), { 140, 30, 50 }, Enum.Material.Fabric)
			P(m, "WindowCurtain", Vector3.new(3, 8, 0.3), base * CFrame.new(math.min(16, W - 8) / 2 + 1.5, 7, -D / 2 + 1), { 140, 30, 50 }, Enum.Material.Fabric)
		end
	end
	if l.Pool then
		local pool = P(m, "Pool", Vector3.new(W * 0.35, 0.4, D * 0.25), base * CFrame.new(W * 0.25, 0.05, D * 0.25), { 60, 180, 230 }, Enum.Material.Glass, { Transparency = 0.2, NoCollide = true })
		pool.Name = "Pool"
	end
	-- Puerta de salida
	local door = P(m, "ExitDoor", Vector3.new(6, 9, 0.6), base * CFrame.new(0, 4.5, D / 2 - 0.6), { 90, 60, 40 }, Enum.Material.Wood)
	addPrompt(door, "prop_exit", "Salir", l.Name)
	-- Puesto de trabajo y vestidor (viviendas, estudios y negocios)
	if l.Kind ~= "garage" and l.Kind ~= "land" then
		local deskCF = base * CFrame.new(-W / 2 + 6, 3.4, -D / 2 + 4)
		P(m, "Workdesk", Vector3.new(8, 0.5, 4), deskCF, { 120, 85, 60 }, Enum.Material.WoodPlanks)
		P(m, "Monitor", Vector3.new(3.2, 2, 0.25), deskCF * CFrame.new(0, 1.4, -1.2), { 20, 20, 24 })
		P(m, "Screen", Vector3.new(3, 1.8, 0.05), deskCF * CFrame.new(0, 1.4, -1.05), { 70, 140, 255 }, Enum.Material.Neon)
		local anchor = P(m, "DeskAnchor", Vector3.new(8, 4, 4), deskCF * CFrame.new(0, -1.5, 0), { 0, 0, 0 }, nil, { Transparency = 1, NoCollide = true })
		addPrompt(anchor, "computer_home", "Usar computador", l.Name, { Owner = player.UserId })
		local kitchen = P(m, "Kitchen", Vector3.new(8, 4, 3), base * CFrame.new(W / 2 - 6, 2, D / 2 - 3), { 230, 230, 235 }, Enum.Material.Marble)
		addPrompt(kitchen, "cook", "Cocinar", "Cocina")
		local sofa = P(m, "RestSpot", Vector3.new(7, 1.5, 3), base * CFrame.new(-W / 2 + 5, 0.75, D / 2 - 4), { 90, 90, 110 }, Enum.Material.Fabric)
		addPrompt(sofa, "rest", "Descansar", "Sofá cama")
		local wardrobe = P(m, "Wardrobe", Vector3.new(2, 8, 5), base * CFrame.new(W / 2 - 1.6, 4, -D / 2 + 5), { 160, 120, 90 }, Enum.Material.WoodPlanks)
		addPrompt(wardrobe, "wardrobe", "Vestidor", "Cambiar estilo", { Owner = player.UserId })
	end
	-- Muebles colocados
	local furn = Instance.new("Folder")
	furn.Name = "Furniture"
	furn.Parent = m
	for uid, pos in pairs(rec.Placed) do
		local item = data.Inventory[uid]
		local def = item and Catalog.get(item.Id)
		if def then
			Property.furnitureModel(furn, def, base * CFrame.new(pos.X, 0, pos.Z) * CFrame.Angles(0, math.rad(pos.R or 0), 0), uid)
		end
	end
	m.Parent = folderRoot
	interiors[player] = { Id = id, Origin = origin, Model = m, W = W, D = D }
	S.Data.markDirty(player)
	return origin
end

function Property.enterCFrame(player, id)
	local origin = Property.buildInterior(player, id)
	if not origin then
		return nil
	end
	local l = PropertyData.ById[id]
	return CFrame.new(origin + Vector3.new(0, 3, l.D / 2 - 5))
end

---------------------------------------------------------------------------
-- Pagos periódicos
---------------------------------------------------------------------------
local function releaseFurniture(data, id)
	local rec = data.Properties[id]
	for uid in pairs(rec.Placed) do
		if data.Inventory[uid] then
			data.Inventory[uid].Loc = "home"
		end
	end
	rec.Placed = {}
end

function Property.onNewDay(player)
	local data = S.Data.get(player)
	if not data then
		return
	end
	local day = data.Home.PlayDays
	for id, rec in pairs(data.Properties) do
		local l = PropertyData.ById[id]
		if l and day >= rec.NextDue then
			rec.NextDue = day + Config.RentPeriodDays
			local amount = rec.Mode == "rent" and l.Rent or l.Upkeep
			local label = (rec.Mode == "rent" and "Alquiler de " or "Mantenimiento de ") .. l.Name
			if amount > 0 and S.Economy.spend(player, amount, rec.Mode == "rent" and "Alquiler" or "Mantenimiento", label) then
				rec.Missed = 0
			elseif amount > 0 then
				local fee = math.floor(amount * Config.LateFeeRate + 0.5)
				rec.Debt = rec.Debt + amount + fee
				rec.Missed = rec.Missed + 1
				S.Net.notify(player, "⚠️ Impago: " .. label .. ". Deuda $" .. rec.Debt .. ". Págala en la app Inmobiliaria.", "warn")
				if rec.Mode == "rent" and rec.Missed >= 3 then
					releaseFurniture(data, id)
					data.Properties[id] = nil
					if data.HomeProperty == id then
						data.HomeProperty = ""
					end
					S.Net.notify(player, "📄 Contrato de «" .. l.Name .. "» rescindido por impago. Tus muebles están en tu inventario.", "error")
				end
			end
		end
	end
	S.Data.markDirty(player)
end

---------------------------------------------------------------------------
-- Validación de colocación
---------------------------------------------------------------------------
local function footprint(def, r)
	local f = def.Foot or { 4, 4, 3 }
	local w, d = f[1], f[2]
	if math.floor((r or 0) / 90) % 2 == 1 then
		w, d = d, w
	end
	return w, d
end

local function overlaps(data, rec, uid, def, x, z, r)
	local w, d = footprint(def, r)
	if def.Shape == "rug" then
		return false
	end
	for other, pos in pairs(rec.Placed) do
		if other ~= uid then
			local item = data.Inventory[other]
			local odef = item and Catalog.get(item.Id)
			if odef and odef.Shape ~= "rug" then
				local ow, od = footprint(odef, pos.R)
				if math.abs(x - pos.X) * 2 < (w + ow) - 0.2 and math.abs(z - pos.Z) * 2 < (d + od) - 0.2 then
					return true
				end
			end
		end
	end
	return false
end

local function placeValid(player, id, uid, x, z, r)
	local data = S.Data.get(player)
	local rec = data.Properties[id]
	local l = PropertyData.ById[id]
	local item = data.Inventory[uid]
	local def = item and Catalog.get(item.Id)
	if not def or not def.Placeable then
		return "Ese objeto no se puede colocar."
	end
	local w, d = footprint(def, r)
	if math.abs(x) + w / 2 > l.W / 2 - 0.5 or math.abs(z) + d / 2 > l.D / 2 - 0.5 then
		return "No cabe ahí: queda fuera de la sala."
	end
	-- dejar libre la puerta y el puesto de trabajo
	if math.abs(x) < 5 and z > l.D / 2 - 6 then
		return "No bloquees la puerta."
	end
	if l.Kind ~= "garage" and l.Kind ~= "land" and x < -l.W / 2 + 12 and z < -l.D / 2 + 8 then
		return "Ese espacio es el puesto de trabajo."
	end
	if overlaps(data, rec, uid, def, x, z, r) then
		return "Choca con otro mueble."
	end
	return nil
end

local function insideOwn(player)
	local id = Property.inside(player)
	if not id then
		return nil, "Entra en tu propiedad para usar el modo construcción."
	end
	return id
end

---------------------------------------------------------------------------
-- Acciones
---------------------------------------------------------------------------
local function newRecord(mode, day)
	return { Mode = mode, Since = os.time(), NextDue = day + Config.RentPeriodDays, Debt = 0, Missed = 0, Deposit = 0,
		Decor = { Wall = 1, Floor = 1, Light = 2, Curtain = false }, Placed = {}, Upgrades = {}, Presets = {}, Spent = 0 }
end

local function checkReq(data, l)
	if data.Level < (l.Req.Level or 1) then
		return "Necesitas nivel " .. l.Req.Level .. "."
	end
	if data.Channel.Subs < (l.Req.Subs or 0) then
		return "Necesitas " .. Util.formatInt(l.Req.Subs) .. " suscriptores."
	end
	return nil
end

local function totalDebt(data)
	local n = 0
	for _, rec in pairs(data.Properties) do
		n = n + rec.Debt
	end
	return n
end

function Property.exteriorOf(id)
	local l = PropertyData.ById[id]
	return l and Property.signPosition(l) + Vector3.new(0, 3, -6) or nil
end

function Property.Start()
	local Net = S.Net

	Net.on("Prop.Rent", function(player, p)
		local data = S.Data.get(player)
		local l = PropertyData.ById[p.id or ""]
		if not l or not l.Rent then
			return false, "Esta propiedad no se alquila."
		end
		if held(data, l.Id) then
			return false, "Ya tienes esta propiedad."
		end
		local err = checkReq(data, l)
		if err then
			return false, err
		end
		if Property.count(data) >= PropertyData.maxProperties(data.Level) then
			return false, "Has alcanzado el máximo de propiedades para tu nivel (" .. PropertyData.maxProperties(data.Level) .. ")."
		end
		if totalDebt(data) > 0 then
			return false, "Paga primero tus deudas inmobiliarias."
		end
		local cost = l.Rent * 2
		if not S.Economy.spend(player, cost, "Alquiler", "Contrato de alquiler: " .. l.Name .. " (semana + fianza)") then
			return false, "Necesitas $" .. Util.formatInt(cost) .. " (primera semana + fianza)."
		end
		local rec = newRecord("rent", data.Home.PlayDays)
		rec.Deposit = l.Rent
		data.Properties[l.Id] = rec
		if (l.Kind == "home" or l.Kind == "studio") and data.HomeProperty == "" then
			data.HomeProperty = l.Id
		end
		data.Counters.rentals = (data.Counters.rentals or 0) + 1
		S.Quest.check(player)
		return true, "📄 Contrato firmado: " .. l.Name .. ". Alquiler $" .. l.Rent .. " cada 7 días jugados; fianza $" .. l.Rent .. " (se devuelve al terminar sin deudas)."
	end)

	Net.on("Prop.Buy", function(player, p)
		local data = S.Data.get(player)
		local l = PropertyData.ById[p.id or ""]
		if not l or not l.Buy then
			return false, "Esta propiedad no está a la venta."
		end
		local current = held(data, l.Id)
		if current and current.Mode == "own" then
			return false, "Ya es tuya."
		end
		local err = checkReq(data, l)
		if err then
			return false, err
		end
		if not current and Property.count(data) >= PropertyData.maxProperties(data.Level) then
			return false, "Has alcanzado el máximo de propiedades para tu nivel (" .. PropertyData.maxProperties(data.Level) .. ")."
		end
		if totalDebt(data) > 0 then
			return false, "Paga primero tus deudas inmobiliarias."
		end
		if not S.Economy.spend(player, l.Buy, "Inmuebles", "Compra de " .. l.Name) then
			return false, "Necesitas $" .. Util.formatInt(l.Buy) .. ". Puedes alquilarla mientras ahorras."
		end
		if current then
			-- de alquiler a propiedad: se devuelve la fianza
			if current.Deposit > 0 then
				S.Economy.add(player, current.Deposit, "Fianzas", "Devolución de fianza de " .. l.Name, {})
			end
			current.Mode = "own"
			current.Deposit = 0
		else
			data.Properties[l.Id] = newRecord("own", data.Home.PlayDays)
			if (l.Kind == "home" or l.Kind == "studio") and data.HomeProperty == "" then
				data.HomeProperty = l.Id
			end
		end
		data.Counters.properties_bought = (data.Counters.properties_bought or 0) + 1
		S.Quest.check(player)
		return true, "🔑 ¡" .. l.Name .. " es tuya! Mantenimiento: $" .. l.Upkeep .. " cada 7 días."
	end)

	Net.on("Prop.EndRent", function(player, p)
		local data = S.Data.get(player)
		local rec = held(data, p.id or "")
		local l = PropertyData.ById[p.id or ""]
		if not rec or rec.Mode ~= "rent" then
			return false, "No tienes un alquiler aquí."
		end
		if Property.inside(player) == p.id then
			return false, "Sal de la propiedad antes de terminar el contrato."
		end
		local back = rec.Deposit - rec.Debt
		releaseFurniture(data, p.id)
		data.Properties[p.id] = nil
		if data.HomeProperty == p.id then
			data.HomeProperty = ""
		end
		if back > 0 then
			S.Economy.add(player, back, "Fianzas", "Devolución de fianza de " .. l.Name, {})
		elseif back < 0 then
			S.Economy.spend(player, math.min(-back, data.Money), "Alquiler", "Deuda pendiente de " .. l.Name)
		end
		return true, "Contrato terminado. Muebles devueltos a tu inventario." .. (back > 0 and (" Fianza devuelta: $" .. back) or "")
	end)

	Net.on("Prop.Sell", function(player, p)
		local data = S.Data.get(player)
		local rec = held(data, p.id or "")
		local l = PropertyData.ById[p.id or ""]
		if not rec or rec.Mode ~= "own" then
			return false, "No eres propietario de esta propiedad."
		end
		if Property.inside(player) == p.id then
			return false, "Sal de la propiedad antes de venderla."
		end
		local value = math.floor(l.Buy * l.Resale + (rec.Spent or 0) * 0.5 - rec.Debt)
		releaseFurniture(data, p.id)
		data.Properties[p.id] = nil
		if data.HomeProperty == p.id then
			data.HomeProperty = ""
		end
		S.Economy.add(player, math.max(0, value), "Inmuebles", "Venta de " .. l.Name, {})
		return true, "Vendiste " .. l.Name .. " por $" .. Util.formatInt(math.max(0, value)) .. "."
	end)

	Net.on("Prop.PayDebt", function(player, p)
		local data = S.Data.get(player)
		local rec = held(data, p.id or "")
		if not rec or rec.Debt <= 0 then
			return false, "No hay deuda en esta propiedad."
		end
		if not S.Economy.spend(player, rec.Debt, "Alquiler", "Pago de deuda inmobiliaria") then
			return false, "Necesitas $" .. Util.formatInt(rec.Debt) .. "."
		end
		rec.Debt = 0
		rec.Missed = 0
		return true, "Deuda pagada."
	end)

	Net.on("Prop.MoveIn", function(player, p)
		local data = S.Data.get(player)
		local id = p.id or ""
		if id == "" then
			data.HomeProperty = ""
			return true, "Vuelves a vivir en la Residencia Económica."
		end
		local l = PropertyData.ById[id]
		if not held(data, id) or (l.Kind ~= "home" and l.Kind ~= "studio") then
			return false, "Solo puedes vivir en viviendas o estudios que tengas."
		end
		data.HomeProperty = id
		return true, "🏠 Ahora vives en " .. l.Name .. ". Aparecerás aquí al entrar al juego."
	end)

	Net.on("Prop.Enter", function(player, p)
		local data = S.Data.get(player)
		local id = p.id or ""
		if not held(data, id) then
			return false, "No tienes acceso a esta propiedad."
		end
		local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		local ext = Property.exteriorOf(id)
		if not root or (root.Position - ext).Magnitude > 30 then
			return false, "Ve a la entrada de la propiedad (usa el taxi de la app Inmobiliaria)."
		end
		local cf = Property.enterCFrame(player, id)
		S.Travel.teleport(player, cf.Position)
		S.Quest.tutorialEvent(player, "enter_home")
		return true
	end)

	Net.on("Prop.Exit", function(player)
		local id = Property.inside(player)
		if not id then
			return false, "No estás dentro de una propiedad."
		end
		S.Travel.teleport(player, Property.exteriorOf(id))
		return true
	end)

	Net.on("Prop.Go", function(player, p)
		local l = PropertyData.ById[p.id or ""]
		if not l then
			return false, "Propiedad no encontrada."
		end
		return S.Travel.taxiTo(player, Property.exteriorOf(l.Id), l.Name)
	end)

	-- Modo construcción
	Net.on("Prop.Place", function(player, p)
		local data = S.Data.get(player)
		local id, err = insideOwn(player)
		if not id then
			return false, err
		end
		local rec = data.Properties[id]
		local l = PropertyData.ById[id]
		local item = data.Inventory[p.uid or ""]
		if not item then
			return false, "No tienes ese objeto."
		end
		local already = rec.Placed[p.uid] ~= nil
		if not already and item.Loc ~= "home" then
			return false, "El objeto debe estar en casa (no en la mochila ni en otra propiedad)."
		end
		if not already and Util.count(rec.Placed) >= l.Slots then
			return false, "No hay más espacio para muebles aquí (" .. l.Slots .. ")."
		end
		local x, z = tonumber(p.x), tonumber(p.z)
		local r = math.floor((tonumber(p.r) or 0) / 90 + 0.5) % 4 * 90
		if not x or not z or x ~= x or z ~= z then
			return false, "Posición no válida."
		end
		x = math.floor(x * 2 + 0.5) / 2
		z = math.floor(z * 2 + 0.5) / 2
		local verr = placeValid(player, id, p.uid, x, z, r)
		if verr then
			return false, verr
		end
		rec.Placed[p.uid] = { X = x, Z = z, R = r }
		item.Loc = "prop:" .. id
		if not already then
			data.Counters.furniture_placed = (data.Counters.furniture_placed or 0) + 1
		end
		data.Counters.decor_max = math.max(data.Counters.decor_max or 0, math.floor(Property.decorScore(player, id)))
		S.Events.onDecor(player, Property.decorScore(player, id))
		Property.buildInterior(player, id)
		S.Quest.check(player)
		return true, (already and "Mueble movido." or "Mueble colocado.") .. " Decoración: " .. Property.decorScore(player, id) .. "/45"
	end)

	Net.on("Prop.Pick", function(player, p)
		local data = S.Data.get(player)
		local id, err = insideOwn(player)
		if not id then
			return false, err
		end
		local rec = data.Properties[id]
		if not rec.Placed[p.uid or ""] then
			return false, "Ese mueble no está colocado aquí."
		end
		rec.Placed[p.uid] = nil
		if data.Inventory[p.uid] then
			data.Inventory[p.uid].Loc = "home"
		end
		Property.buildInterior(player, id)
		return true, "Mueble guardado en el inventario."
	end)

	Net.on("Prop.Rotate", function(player, p)
		local data = S.Data.get(player)
		local id, err = insideOwn(player)
		if not id then
			return false, err
		end
		local pos = data.Properties[id].Placed[p.uid or ""]
		if not pos then
			return false, "Ese mueble no está colocado aquí."
		end
		local r = (pos.R + 90) % 360
		local verr = placeValid(player, id, p.uid, pos.X, pos.Z, r)
		if verr then
			return false, "No se puede girar: " .. verr
		end
		pos.R = r
		Property.buildInterior(player, id)
		return true
	end)

	Net.on("Prop.Decor", function(player, p)
		local data = S.Data.get(player)
		local id, err = insideOwn(player)
		if not id then
			return false, err
		end
		local rec = data.Properties[id]
		local l = PropertyData.ById[id]
		local d = rec.Decor
		local cost, changed = 0, {}
		local function setIdx(key, list, value)
			local v = tonumber(value)
			if v and list[v] and d[key] ~= v then
				d[key] = v
				cost = cost + 50
				changed[#changed + 1] = key
			end
		end
		if p.style then
			local st = PropertyData.StyleById[p.style]
			if not st then
				return false, "Estilo no válido."
			end
			if not l.Remodel then
				return false, "En esta propiedad no se permite remodelar (solo la luz y las cortinas)."
			end
			local before = Util.deepCopy(d)
			d.Wall, d.Floor, d.Light = st.Wall, st.Floor, st.Light
			cost = 120
			if not S.Economy.spend(player, cost, "Remodelación", "Estilo " .. st.Name .. " en " .. l.Name) then
				rec.Decor = before
				return false, "Aplicar un estilo cuesta $" .. cost .. "."
			end
		else
			if (p.wall or p.floor) and not l.Remodel then
				return false, "En esta propiedad no se permite cambiar paredes ni suelos."
			end
			local before = Util.deepCopy(d)
			setIdx("Wall", PropertyData.Walls, p.wall)
			setIdx("Floor", PropertyData.Floors, p.floor)
			setIdx("Light", PropertyData.Lights, p.light)
			if p.curtain ~= nil and (p.curtain == true) ~= d.Curtain then
				d.Curtain = p.curtain == true
				cost = cost + 50
			end
			if cost == 0 then
				return false, "No hay cambios."
			end
			if not S.Economy.spend(player, cost, "Remodelación", "Decoración de " .. l.Name) then
				rec.Decor = before
				return false, "Cuesta $" .. cost .. "."
			end
		end
		rec.Spent = (rec.Spent or 0) + cost
		data.Counters.remodels = (data.Counters.remodels or 0) + 1
		data.Counters.decor_max = math.max(data.Counters.decor_max or 0, math.floor(Property.decorScore(player, id)))
		S.Events.onDecor(player, Property.decorScore(player, id))
		Property.buildInterior(player, id)
		S.Quest.check(player)
		return true, "Remodelación hecha ($" .. cost .. "). Decoración: " .. Property.decorScore(player, id) .. "/45"
	end)

	Net.on("Prop.Upgrade", function(player, p)
		local data = S.Data.get(player)
		local id = p.id or ""
		local rec = held(data, id)
		local up = PropertyData.Upgrades[p.key or ""]
		if not rec or not up then
			return false, "Mejora no válida."
		end
		if rec.Mode ~= "own" and p.key ~= "lightrig" then
			return false, "En un alquiler solo puedes instalar el rig de iluminación (es desmontable)."
		end
		if rec.Upgrades[p.key] then
			return false, "Ya está instalada."
		end
		if not S.Economy.spend(player, up.Cost, "Mejoras", up.Name .. " en " .. PropertyData.ById[id].Name) then
			return false, "Cuesta $" .. Util.formatInt(up.Cost) .. "."
		end
		rec.Upgrades[p.key] = true
		rec.Spent = (rec.Spent or 0) + up.Cost
		if interiors[player] and interiors[player].Id == id then
			Property.buildInterior(player, id)
		end
		return true, "Mejora instalada: " .. up.Name .. "."
	end)

	Net.on("Prop.SavePreset", function(player, p)
		local data = S.Data.get(player)
		local id, err = insideOwn(player)
		if not id then
			return false, err
		end
		local rec = data.Properties[id]
		local name = Util.cleanText(p.name or "", 24) or ""
		if #name == 0 then
			name = "Diseño " .. (#rec.Presets + 1)
		end
		name = S.Text.filter(player, name) or ("Diseño " .. (#rec.Presets + 1))
		if #rec.Presets >= 3 then
			table.remove(rec.Presets, 1)
		end
		table.insert(rec.Presets, { Name = name, Layout = Util.deepCopy(rec.Placed), Decor = Util.deepCopy(rec.Decor) })
		return true, "Diseño «" .. name .. "» guardado."
	end)

	Net.on("Prop.LoadPreset", function(player, p)
		local data = S.Data.get(player)
		local id, err = insideOwn(player)
		if not id then
			return false, err
		end
		local rec = data.Properties[id]
		local preset = rec.Presets[tonumber(p.index) or 0]
		if not preset then
			return false, "Diseño no encontrado."
		end
		-- recoger todo y volver a colocar lo que siga disponible
		releaseFurniture(data, id)
		local placed, skipped = 0, 0
		for uid, pos in pairs(preset.Layout) do
			local item = data.Inventory[uid]
			if item and item.Loc == "home" and not placeValid(player, id, uid, pos.X, pos.Z, pos.R) then
				rec.Placed[uid] = { X = pos.X, Z = pos.Z, R = pos.R }
				item.Loc = "prop:" .. id
				placed = placed + 1
			else
				skipped = skipped + 1
			end
		end
		Property.buildInterior(player, id)
		return true, "Diseño aplicado: " .. placed .. " muebles colocados" .. (skipped > 0 and (", " .. skipped .. " no disponibles") or "") .. "."
	end)

	Players.PlayerRemoving:Connect(function(player)
		local it = interiors[player]
		if it and it.Model then
			it.Model:Destroy()
		end
		interiors[player] = nil
		for i = 1, 60 do
			if slots[i] == player then
				slots[i] = nil
			end
		end
	end)
end

return Property
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000039"><Properties><string name="Name">QuestService</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- QuestService: tutorial guiado (eventos) + logros (contadores).
--  * Un logro se marca completado una vez y su recompensa se cobra una sola vez (Claimed).
--  * Los pasos del tutorial se pueden saltar; los saltados no dan recompensa.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage.Shared
local QuestDefs = require(Shared.QuestDefs)
local Util = require(Shared.Util)

local Quest = {}
local S

function Quest.Init(services)
	S = services
end

-- Valor actual de un contador de logros
function Quest.valueOf(data, key)
	if key == "subs" then
		return data.Channel.Subs
	elseif key == "total_views" then
		return data.Channel.TotalViews
	elseif key == "revenue" then
		return data.Channel.TotalRevenue
	elseif key == "level" then
		return data.Level
	elseif key == "districts_visited" then
		return Util.count(data.Visited.Districts)
	elseif key == "districts_recorded" then
		return Util.count(data.Visited.Recorded)
	elseif key == "stores_visited" then
		return Util.count(data.Visited.Stores)
	elseif key == "categories_published" then
		return Util.count(data.Visited.Categories)
	elseif key == "secrets_found" then
		return Util.count(data.Visited.Secrets)
	elseif key == "cameras_owned" then
		return Util.count(data.Visited.Cameras)
	elseif key == "properties_owned" then
		local n = 0
		for _, rec in pairs(data.Properties or {}) do
			if rec.Mode == "own" then
				n = n + 1
			end
		end
		return n
	end
	return data.Counters[key] or 0
end

function Quest.check(player)
	local data = S.Data.get(player)
	if not data then
		return
	end
	local q = data.Quests
	for _, a in ipairs(QuestDefs.Achievements) do
		if not q.Completed[a.Id] and Quest.valueOf(data, a.Counter) >= a.Target then
			q.Completed[a.Id] = os.time()
			S.Net.push(player, "achievement", { id = a.Id, name = a.Name })
		end
	end
	S.Data.markDirty(player)
end

local function grant(player, reward, why)
	local data = S.Data.get(player)
	if reward.Money and reward.Money > 0 then
		S.Economy.add(player, reward.Money, "Recompensas", why, {})
	end
	if reward.Xp and reward.Xp > 0 then
		S.Progress.addXp(player, reward.Xp)
	end
	if reward.Title then
		data.Titles[reward.Title] = true
		S.Net.notify(player, "🏷 Nuevo título desbloqueado: «" .. reward.Title .. "»", "success")
	end
end

function Quest.tutorialEvent(player, event)
	local data = S.Data.get(player)
	if not data then
		return
	end
	local q = data.Quests
	if q.Skipped then
		return
	end
	local step = QuestDefs.Tutorial[q.Step]
	if not step or step.Event ~= event then
		return
	end
	q.StepProgress = q.StepProgress + 1
	if q.StepProgress >= (step.Target or 1) then
		q.Step = q.Step + 1
		q.StepProgress = 0
		grant(player, step.Reward, "Tutorial: " .. step.Name)
		local nxt = QuestDefs.Tutorial[q.Step]
		S.Net.push(player, "tutorial", { done = step.Name, next = nxt and nxt.Name or nil, finished = nxt == nil })
		if not nxt then
			S.Net.notify(player, "🎓 ¡Tutorial completado! El mundo es tuyo: elige tu propio camino.", "success")
		end
	end
	S.Data.markDirty(player)
end

function Quest.Start()
	local Net = S.Net

	Net.on("Quest.Claim", function(player, p)
		local data = S.Data.get(player)
		local def = QuestDefs.ById[p.id or ""]
		if not def or not def.Counter then
			return false, "Logro no encontrado."
		end
		if not data.Quests.Completed[def.Id] then
			return false, "Aún no has completado este logro."
		end
		if data.Quests.Claimed[def.Id] then
			return false, "Ya cobraste esta recompensa."
		end
		data.Quests.Claimed[def.Id] = os.time()
		grant(player, def.Reward, "Logro: " .. def.Name)
		Quest.tutorialEvent(player, "claim_reward")
		return true, "Recompensa cobrada: $" .. Util.formatInt(def.Reward.Money) .. " y " .. def.Reward.Xp .. " XP."
	end)

	Net.on("Quest.ClaimAll", function(player)
		local data = S.Data.get(player)
		local n = 0
		for _, def in ipairs(QuestDefs.Achievements) do
			if data.Quests.Completed[def.Id] and not data.Quests.Claimed[def.Id] then
				data.Quests.Claimed[def.Id] = os.time()
				grant(player, def.Reward, "Logro: " .. def.Name)
				n = n + 1
			end
		end
		if n == 0 then
			return false, "No hay recompensas pendientes."
		end
		Quest.tutorialEvent(player, "claim_reward")
		return true, n .. " recompensas cobradas."
	end)

	Net.on("Phone.Opened", function(player)
		Quest.tutorialEvent(player, "open_phone")
		return true
	end)

	Net.on("Quest.SkipTutorial", function(player)
		local data = S.Data.get(player)
		data.Quests.Skipped = true
		return true, "Tutorial omitido. Puedes ver las misiones en cualquier momento (tecla M)."
	end)

	Net.on("Quest.SkipStep", function(player)
		local data = S.Data.get(player)
		local q = data.Quests
		if QuestDefs.Tutorial[q.Step] then
			q.Step = q.Step + 1
			q.StepProgress = 0
			return true, "Paso saltado (sin recompensa)."
		end
		return false, "No hay paso que saltar."
	end)

	Net.on("Quest.RestartTutorial", function(player)
		local data = S.Data.get(player)
		-- Reactivar las explicaciones no vuelve a dar recompensas de pasos ya completados
		data.Quests.Skipped = false
		return true, "Explicaciones del tutorial reactivadas."
	end)

	Net.on("Title.Equip", function(player, p)
		local data = S.Data.get(player)
		if p.title ~= "" and not data.Titles[p.title or ""] then
			return false, "No tienes ese título."
		end
		data.EquippedTitle = p.title or ""
		S.Avatar.refreshOverhead(player)
		return true, p.title == "" and "Título quitado." or ("Título «" .. p.title .. "» equipado.")
	end)
end

return Quest
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000040"><Properties><string name="Name">ShopService</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- ShopService: compras en tiendas físicas y online.
--  * Física: hay que estar dentro de la tienda que vende el objeto. Entrega inmediata (mochila o casa).
--  * Online: carrito, cobro único por pedido, entrega simulada, cancelación con reembolso.
--  * Cada petición de compra lleva un "nonce": si se repite (doble clic, reintento) no se cobra dos veces.
--  * Los PC completos se entregan como un montaje real de piezas (se pueden desmontar).

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Catalog = require(Shared.ItemCatalog)
local Util = require(Shared.Util)

local Shop = {}
local S

Shop.StoreRadius = 45

function Shop.Init(services)
	S = services
end

local function rememberNonce(data, nonce, result)
	data.Processed[nonce] = result
	table.insert(data.ProcessedOrder, nonce)
	while #data.ProcessedOrder > 40 do
		local old = table.remove(data.ProcessedOrder, 1)
		data.Processed[old] = nil
	end
end

local function validNonce(nonce)
	return type(nonce) == "string" and #nonce >= 6 and #nonce <= 40
end

function Shop.storeNear(player)
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if not root then
		return nil
	end
	for _, sp in ipairs(S.World.Specials) do
		if sp.Type == "store" then
			local dx, dz = root.Position.X - sp.WX, root.Position.Z - sp.WZ
			if dx * dx + dz * dz <= Shop.StoreRadius * Shop.StoreRadius then
				return sp.StoreId
			end
		end
	end
	return nil
end

function Shop.priceOf(player, def)
	local mult = S.Events and S.Events.priceMultiplier and S.Events.priceMultiplier(def) or 1
	return math.floor(def.Price * mult + 0.5)
end

-- Entrega un objeto (o un PC completo como montaje de piezas). Devuelve texto de destino.
function Shop.deliver(player, def, opts)
	if def.Cat == "pc" then
		local rigId = S.Computer.createRigFromPrebuilt(player, def, opts)
		return rigId and "tu casa (montado)" or nil
	end
	local uid, loc = S.Inventory.add(player, def.Id, opts)
	if not uid then
		return nil
	end
	return loc == "backpack" and "tu mochila" or "tu casa"
end

local function units(def, qty)
	if def.Parts then
		local n = 0
		for _, v in pairs(def.Parts) do
			n = n + (type(v) == "table" and #v or 1)
		end
		return n * qty
	end
	return qty
end

local function storageError(player, n)
	if not S.Property.canStore(player, n) then
		return "Tu vivienda está llena (" .. S.Property.storedCount(player) .. "/" .. S.Property.storageCap(player) .. " objetos). Vende algo o consigue una propiedad con más almacenaje."
	end
	return nil
end

local function checkBuyable(player, def, qty)
	local data = S.Data.get(player)
	if not def or not Catalog.isForSale(def.Id) then
		return "Ese producto no está a la venta."
	end
	if data.Level < (def.Req.Level or 1) then
		return "Necesitas nivel " .. def.Req.Level .. " para comprar " .. def.Name .. "."
	end
	if qty < 1 or qty > 10 then
		return "Cantidad no válida (1-10)."
	end
	return nil
end

function Shop.afterPurchase(player, n, total)
	local data = S.Data.get(player)
	data.Counters.items_bought = (data.Counters.items_bought or 0) + n
	data.Counters.money_spent = (data.Counters.money_spent or 0) + total
	S.Progress.addXp(player, S.Progress.Xp.Purchase * math.min(n, 5))
	S.Quest.tutorialEvent(player, "buy_item")
	S.Quest.check(player)
end

-- Entregas pendientes de pedidos online
function Shop.processOrders(player)
	local data = S.Data.get(player)
	if not data then
		return
	end
	local now = os.time()
	for _, order in ipairs(data.Orders) do
		if order.Status == "En camino" and now >= order.Eta then
			order.Status = "Entregado"
			order.DeliveredAt = now
			for _, line in ipairs(order.Items) do
				local def = Catalog.get(line.Id)
				for _ = 1, line.Qty do
					Shop.deliver(player, def, { src = "online", paid = line.Unit, loc = "home" })
				end
			end
			S.Net.notify(player, "📦 Pedido #" .. order.Num .. " entregado en tu casa.", "success")
			S.Data.markDirty(player)
		end
	end
end

function Shop.Start()
	local Net = S.Net

	-- Compra en tienda física
	Net.on("Shop.BuyInStore", function(player, p)
		local data = S.Data.get(player)
		if not validNonce(p.nonce) then
			return false, "Petición de compra no válida."
		end
		if data.Processed[p.nonce] then
			return true, "Compra ya registrada (no se ha cobrado dos veces).", data.Processed[p.nonce]
		end
		local def = Catalog.get(p.itemId)
		local qty = math.floor(tonumber(p.qty) or 1)
		local err = checkBuyable(player, def, qty)
		if err then
			return false, err
		end
		local storeId = Shop.storeNear(player)
		if not storeId then
			return false, "Tienes que estar dentro de una tienda. También puedes pedirlo online desde la app Tienda."
		end
		if not Util.indexOf(def.Stores, storeId) then
			return false, "Esta tienda no vende " .. def.Name .. "."
		end
		local serr = storageError(player, units(def, qty))
		if serr then
			return false, serr
		end
		local unit = Shop.priceOf(player, def)
		local total = unit * qty
		if not S.Economy.spend(player, total, "Compras", def.Name .. (qty > 1 and (" x" .. qty) or "")) then
			return false, "No tienes suficiente dinero ($" .. Util.formatInt(total) .. ")."
		end
		local where
		for _ = 1, qty do
			where = Shop.deliver(player, def, { src = "shop", paid = unit, loc = "backpack" })
		end
		local result = { itemId = def.Id, qty = qty, total = total }
		rememberNonce(data, p.nonce, result)
		Shop.afterPurchase(player, qty, total)
		return true, "Compraste " .. def.Name .. " por $" .. Util.formatInt(total) .. ". Está en " .. tostring(where) .. ".", result
	end)

	-- Pedido online (carrito)
	Net.on("Shop.Checkout", function(player, p)
		local data = S.Data.get(player)
		if not validNonce(p.nonce) then
			return false, "Petición de compra no válida."
		end
		if data.Processed[p.nonce] then
			return true, "Pedido ya registrado (no se ha cobrado dos veces).", data.Processed[p.nonce]
		end
		if data.Home.Missed >= 2 then
			return false, "Tienes alquileres pendientes. Págalos en la app Banco antes de hacer pedidos online."
		end
		if type(p.items) ~= "table" or #p.items == 0 or #p.items > 20 then
			return false, "El carrito está vacío o es demasiado grande."
		end
		local lines, total, count = {}, 0, 0
		for _, line in ipairs(p.items) do
			local def = Catalog.get(type(line) == "table" and line.id or nil)
			local qty = math.floor(tonumber(type(line) == "table" and line.qty or 0) or 0)
			local err = checkBuyable(player, def, qty)
			if err then
				return false, err
			end
			local unit = Shop.priceOf(player, def)
			lines[#lines + 1] = { Id = def.Id, Qty = qty, Unit = unit }
			total = total + unit * qty
			count = count + units(def, qty)
		end
		local serr = storageError(player, count)
		if serr then
			return false, serr
		end
		local shipping = total >= 500 and 0 or 15
		total = total + shipping
		if not S.Economy.spend(player, total, "Compras online", "Pedido online (" .. count .. " artículos)") then
			return false, "No tienes suficiente dinero ($" .. Util.formatInt(total) .. ")."
		end
		data.Counters.order_num = (data.Counters.order_num or 0) + 1
		local hours = Config.OnlineDeliveryHours
		local order = {
			Num = data.Counters.order_num,
			Items = lines,
			Total = total,
			Shipping = shipping,
			Status = "En camino",
			Placed = os.time(),
			Eta = os.time() + math.floor(hours * Config.DayLengthSeconds / 24),
		}
		table.insert(data.Orders, 1, order)
		while #data.Orders > 30 do
			table.remove(data.Orders)
		end
		local result = { num = order.Num, total = total }
		rememberNonce(data, p.nonce, result)
		Shop.afterPurchase(player, count, total)
		return true, "Pedido #" .. order.Num .. " confirmado ($" .. Util.formatInt(total) .. "). Llegará a tu casa en unos " .. math.floor(hours * Config.DayLengthSeconds / 24 / 60 + 0.5) .. " minutos.", result
	end)

	Net.on("Shop.CancelOrder", function(player, p)
		local data = S.Data.get(player)
		for _, order in ipairs(data.Orders) do
			if order.Num == tonumber(p.num) then
				if order.Status ~= "En camino" then
					return false, "Este pedido ya no se puede cancelar."
				end
				order.Status = "Cancelado"
				S.Economy.add(player, order.Total, "Reembolsos", "Cancelación del pedido #" .. order.Num, {})
				return true, "Pedido #" .. order.Num .. " cancelado. Reembolso: $" .. Util.formatInt(order.Total) .. "."
			end
		end
		return false, "Pedido no encontrado."
	end)

	Net.on("Shop.VisitStore", function(player, p)
		-- El cliente avisa al abrir el catálogo físico; el servidor comprueba la posición.
		local storeId = Shop.storeNear(player)
		if storeId then
			S.Travel.markStoreVisit(player, storeId)
		end
		return true
	end)

	task.spawn(function()
		while true do
			task.wait(5)
			for _, player in ipairs(game:GetService("Players"):GetPlayers()) do
				local ok, err = pcall(Shop.processOrders, player)
				if not ok then
					S.Net.logError("orders", err)
				end
			end
		end
	end)
end

return Shop
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000041"><Properties><string name="Name">SponsorService</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- SponsorService: patrocinios con marcas ficticias.
--  * Cada día de juego llegan ofertas nuevas según tu reputación y suscriptores.
--  * Revisa requisitos, duración, pago, condiciones, producto y fecha de entrega antes de aceptar.
--  * Regalo: el producto es tuyo. Préstamo: se devuelve al terminar. Campaña: sin producto.
--  * Se cumple publicando un vídeo que respete el contrato (el servidor lo comprueba).
--  * Incumplir (pasar la fecha) baja la reputación comercial y devuelve el equipo prestado.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage.Shared
local SponsorData = require(Shared.SponsorData)
local VideoData = require(Shared.VideoData)
local Catalog = require(Shared.ItemCatalog)
local Util = require(Shared.Util)

local Sponsor = {}
local S

function Sponsor.Init(services)
	S = services
end

local function state(data)
	data.Sponsors = data.Sponsors or {}
	local sp = data.Sponsors
	sp.Offers = sp.Offers or {}
	sp.Active = sp.Active or {}
	sp.History = sp.History or {}
	sp.Seq = sp.Seq or 0
	sp.OffersDay = sp.OffersDay or 0
	return sp
end
Sponsor.state = state

function Sponsor.refreshOffers(player)
	local data = S.Data.get(player)
	local sp = state(data)
	local day = data.Home.PlayDays
	if sp.OffersDay == day and #sp.Offers > 0 then
		return
	end
	sp.OffersDay = day
	sp.Offers = {}
	local rng = Random.new(player.UserId * 1009 + day * 7919)
	local eligible = {}
	for _, b in ipairs(SponsorData.Brands) do
		if data.Reputation >= b.MinRep then
			eligible[#eligible + 1] = b
		end
	end
	if #eligible == 0 or data.BizRep < 10 then
		return
	end
	local subs = data.Channel.Subs
	for i = 1, SponsorData.OffersPerDay do
		local b = eligible[rng:NextInteger(1, #eligible)]
		local cat = b.Cats[rng:NextInteger(1, #b.Cats)]
		local product = (#b.Products > 0 and rng:NextNumber() < 0.75) and b.Products[rng:NextInteger(1, #b.Products)] or nil
		local def = product and Catalog.get(product)
		local kind = "campaign"
		if def then
			kind = def.Price >= 700 and "loan" or "gift"
		end
		local pay = math.floor((120 + 6 * math.sqrt(subs)) * (1 + data.Reputation / 100) * (0.5 + data.BizRep / 100) * (kind == "loan" and 1.3 or 1) * rng:NextNumber(0.85, 1.15))
		sp.Seq = sp.Seq + 1
		table.insert(sp.Offers, {
			Id = "o" .. sp.Seq,
			Brand = b.Id,
			Kind = kind,
			Category = cat,
			Product = product,
			MinQ = math.floor(math.min(85, 35 + math.sqrt(subs) * 0.3 + rng:NextInteger(0, 10))),
			Days = rng:NextInteger(2, 4),
			Pay = math.floor(pay / 5) * 5,
			Bonus = math.floor(pay * 0.3 / 5) * 5,
		})
	end
end

local function brandName(id)
	local b = SponsorData.BrandById[id]
	return b and b.Name or id
end

-- Comprueba si un proyecto cumple un contrato. Devuelve nil o el motivo.
function Sponsor.check(contract, proj, quality)
	if proj.Category ~= contract.Category then
		return "El contrato pide un vídeo de " .. (VideoData.CategoryById[contract.Category] or {}).Name .. "."
	end
	if quality < contract.MinQ then
		return "El contrato exige calidad " .. contract.MinQ .. " (tu vídeo tiene " .. math.floor(quality) .. ")."
	end
	if contract.Product then
		local shown = false
		for _, sc in ipairs(proj.Scenes) do
			if sc.Feat == contract.Product and sc.Own then
				shown = true
			end
		end
		if not shown then
			return "Debes mostrar el producto patrocinado (" .. Catalog.get(contract.Product).Name .. ") en un plano de producto, con el producto en tu mochila."
		end
	end
	return nil
end

-- Lo llama VideoService al publicar con contrato. Devuelve etiqueta o error.
function Sponsor.fulfill(player, contractId, proj, quality)
	local data = S.Data.get(player)
	local sp = state(data)
	local c = sp.Active[contractId]
	if not c then
		return nil, "Ese contrato no existe o ya terminó."
	end
	local err = Sponsor.check(c, proj, quality)
	if err then
		return nil, err
	end
	return c
end

function Sponsor.complete(player, contractId, quality)
	local data = S.Data.get(player)
	local sp = state(data)
	local c = sp.Active[contractId]
	if not c then
		return
	end
	sp.Active[contractId] = nil
	local total = c.Pay + (quality >= c.MinQ + 15 and c.Bonus or 0)
	if c.Kind == "loan" and c.ItemUid and data.Inventory[c.ItemUid] then
		S.Inventory.remove(player, c.ItemUid)
	end
	data.BizRep = math.min(100, data.BizRep + 5)
	data.Counters.sponsors_done = (data.Counters.sponsors_done or 0) + 1
	Util.pushCapped(sp.History, { Brand = c.Brand, Result = "Cumplido", Pay = total, T = os.time() }, 20)
	S.Economy.add(player, total, "Patrocinios", "Contrato con " .. brandName(c.Brand), { taxable = true })
	S.Net.notify(player, "🤝 Contrato con " .. brandName(c.Brand) .. " cumplido: +$" .. total .. (c.Kind == "loan" and " (equipo prestado devuelto)" or ""), "success")
	S.Quest.check(player)
end

function Sponsor.onNewDay(player)
	local data = S.Data.get(player)
	if not data then
		return
	end
	local sp = state(data)
	for id, c in pairs(sp.Active) do
		if data.Home.PlayDays > c.DueDay then
			sp.Active[id] = nil
			if c.Kind == "loan" and c.ItemUid and data.Inventory[c.ItemUid] then
				S.Inventory.remove(player, c.ItemUid)
			end
			data.BizRep = math.max(0, data.BizRep - 10)
			data.Reputation = math.max(0, data.Reputation - 2)
			Util.pushCapped(sp.History, { Brand = c.Brand, Result = "Incumplido", Pay = 0, T = os.time() }, 20)
			S.Net.notify(player, "⚠️ No cumpliste el contrato con " .. brandName(c.Brand) .. ". Reputación comercial −10." .. (c.Kind == "loan" and " El equipo prestado se ha devuelto." or ""), "warn")
		end
	end
	Sponsor.refreshOffers(player)
	S.Data.markDirty(player)
end

function Sponsor.Start()
	local Net = S.Net

	Net.on("Sponsor.Refresh", function(player)
		Sponsor.refreshOffers(player)
		return true
	end)

	Net.on("Sponsor.Accept", function(player, p)
		local data = S.Data.get(player)
		local sp = state(data)
		local offer, idx = nil, nil
		for i, o in ipairs(sp.Offers) do
			if o.Id == p.id then
				offer, idx = o, i
			end
		end
		if not offer then
			return false, "Esa oferta ya no está disponible."
		end
		if Util.count(sp.Active) >= 3 then
			return false, "Ya tienes 3 contratos activos. Cúmplelos antes de aceptar más."
		end
		if offer.Product then
			local def = Catalog.get(offer.Product)
			if def.Cat == "pc" then
				return false, "Esta oferta no está disponible."
			end
			if not S.Property.canStore(player, 1) then
				return false, "No tienes espacio en casa para recibir el producto."
			end
		end
		table.remove(sp.Offers, idx)
		local c = Util.deepCopy(offer)
		c.Accepted = os.time()
		c.DueDay = data.Home.PlayDays + offer.Days
		if offer.Product then
			local uid = S.Inventory.add(player, offer.Product, { src = offer.Kind == "loan" and "loan" or "sponsor", paid = 0, loc = "home" })
			c.ItemUid = uid
			if uid and offer.Kind == "loan" then
				data.Inventory[uid].Loan = offer.Id
			end
		end
		sp.Active[offer.Id] = c
		return true, "🤝 Contrato aceptado con " .. brandName(offer.Brand) .. ". Entrega antes de " .. offer.Days .. " días de juego." .. (offer.Product and (" Producto enviado a tu casa: " .. Catalog.get(offer.Product).Name .. (offer.Kind == "loan" and " (prestado)." or " (regalo).")) or "")
	end)

	Net.on("Sponsor.Decline", function(player, p)
		local data = S.Data.get(player)
		local sp = state(data)
		for i, o in ipairs(sp.Offers) do
			if o.Id == p.id then
				table.remove(sp.Offers, i)
				return true, "Oferta rechazada (sin penalización)."
			end
		end
		return false, "Oferta no encontrada."
	end)

	Net.on("Sponsor.Cancel", function(player, p)
		local data = S.Data.get(player)
		local sp = state(data)
		local c = sp.Active[p.id or ""]
		if not c then
			return false, "Contrato no encontrado."
		end
		sp.Active[p.id] = nil
		if c.Kind == "loan" and c.ItemUid and data.Inventory[c.ItemUid] then
			S.Inventory.remove(player, c.ItemUid)
		end
		data.BizRep = math.max(0, data.BizRep - 4)
		Util.pushCapped(sp.History, { Brand = c.Brand, Result = "Cancelado", Pay = 0, T = os.time() }, 20)
		return true, "Contrato cancelado. Reputación comercial −4 (menos que incumplirlo)."
	end)
end

return Sponsor
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000042"><Properties><string name="Name">SyncService</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- SyncService: construye la vista del perfil que recibe el cliente (solo lectura en el cliente).
-- Incluye valores derivados que el servidor calcula (rango, capacidad de mochila, rendimiento del PC...).

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage.Shared
local Progression = require(Shared.Progression)
local QuestDefs = require(Shared.QuestDefs)
local Catalog = require(Shared.ItemCatalog)

local Sync = {}
local S

local HIDDEN = { Receipts = true, ReceiptOrder = true, Processed = true, ProcessedOrder = true, __lock = true }

function Sync.Init(services)
	S = services
end

function Sync.build(player)
	local data = S.Data.get(player)
	local view = {}
	for k, v in pairs(data) do
		if not HIDDEN[k] then
			view[k] = v
		end
	end
	local rankIndex, rank = S.Progress.rank(data)
	view.Derived = {
		XpNext = Progression.xpToNext(data.Level),
		RankIndex = rankIndex,
		RankName = rank.Name,
		BackpackCap = S.Inventory.backpackCap(player),
		BackpackUsed = S.Inventory.backpackUsed(player),
		PhotoCap = S.Video.photoCapacity(player),
		StorageUsed = S.Computer.storageUsed(player),
		RigStats = {},
		Passes = S.Monetization.ownedList(player),
		Trends = S.Channel.trends(),
		ReadOnly = S.Data.getProfile(player).ReadOnly,
		LoanLimit = S.Economy.loanLimit(data),
		Day = S.Time.day(),
		Month = S.Time.monthIndex(),
		AtHome = S.Home.isAtHome(player),
		Recording = S.Video.isRecording(player),
		Session = S.Computer.session(player) and S.Computer.sessionStats(player) or nil,
		QuestValues = {},
		PropInside = S.Property.inside(player),
		EventId = S.Events.current().Id,
		EventActive = S.Events.isActive(),
		AtEvent = S.Events.atEvent(player),
		Interior = S.Property.interiorInfo(player),
		DecorScore = S.Property.inside(player) and S.Property.decorScore(player, S.Property.inside(player)) or nil,
		StorageCap = S.Property.storageCap(player),
		Stored = S.Property.storedCount(player),
		MaxProps = require(Shared.PropertyData).maxProperties(data.Level),
		Returnable = {},
		SellValues = {},
	}
	for rigId in pairs(data.Rigs) do
		view.Derived.RigStats[rigId] = S.Computer.rigStats(player, rigId)
	end
	for key in pairs(QuestDefs.TrackNames) do
		view.Derived.QuestValues[key] = S.Quest.valueOf(data, key)
	end
	for uid, rec in pairs(data.Inventory) do
		local def = Catalog.get(rec.Id)
		if def then
			view.Derived.SellValues[uid] = S.Inventory.sellValue(rec, def)
			if S.Inventory.canReturn(rec) then
				view.Derived.Returnable[uid] = math.floor(rec.Paid * 0.9 + 0.5)
			end
		end
	end
	local inc, exp = S.Economy.balanceSummary(data)
	view.Derived.MonthIncome, view.Derived.MonthExpense = inc, exp
	return view
end

function Sync.send(player)
	S.Net.push(player, "profile", Sync.build(player))
end

function Sync.Start()
	S.Net.on("Sync.Request", function(player)
		Sync.send(player)
		return true
	end)
end

return Sync
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000043"><Properties><string name="Name">TextFilter</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- TextFilter: filtra con TextService todo texto escrito por jugadores que otros puedan ver
-- (nombre del canal, títulos, descripciones, metas...). Si el filtro falla, se rechaza el texto.

local TextService = game:GetService("TextService")

local TextFilter = {}

function TextFilter.Init() end

function TextFilter.filter(player, text)
	if type(text) ~= "string" then
		return nil
	end
	if text == "" then
		return ""
	end
	local ok, result = pcall(function()
		local filtered = TextService:FilterStringAsync(text, player.UserId)
		return filtered:GetNonChatStringForBroadcastAsync()
	end)
	if ok and type(result) == "string" then
		return result
	end
	return nil
end

return TextFilter
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000044"><Properties><string name="Name">TimeWeatherService</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- TimeWeatherService: ciclo día/noche compartido y clima.
--  * 1 día de juego = Config.DayLengthSeconds segundos reales.
--  * El clima cambia cada pocas horas de juego (despejado, nublado, lluvia, niebla, tormenta moderada).
--  * Publica atributos en Workspace: GameHour, GameDay, Weather. El cliente dibuja la lluvia/relámpagos.
--  * Enciende farolas y ventanas de noche (etiqueta "NightLight").

local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)

local Time = {}
local S
local startOffset = 9 -- el servidor empieza a las 9:00
local startClock = os.time()
local lastDay = nil
local nightState = nil

Time.WeatherNames = { Clear = "Despejado", Cloudy = "Nublado", Rain = "Lluvia", Fog = "Niebla", Storm = "Tormenta" }
local weatherWeights = { { "Clear", 45 }, { "Cloudy", 25 }, { "Rain", 12 }, { "Fog", 10 }, { "Storm", 8 } }
Time.Weather = "Clear"
local nextWeatherAt = 0

function Time.Init(services)
	S = services
end

local function totalHours()
	return startOffset + (os.time() - startClock) / Config.DayLengthSeconds * 24
end

function Time.hour()
	return totalHours() % 24
end

function Time.day()
	return math.floor(totalHours() / 24) + 1
end

function Time.monthIndex()
	return math.floor((Time.day() - 1) / Config.DaysPerMonth) + 1
end

function Time.isNight()
	local h = Time.hour()
	return h < 6 or h >= 19.5
end

function Time.label()
	local h = Time.hour()
	if h >= 5 and h < 7 then
		return "Amanecer"
	elseif h >= 7 and h < 11.5 then
		return "Mañana"
	elseif h >= 11.5 and h < 14 then
		return "Mediodía"
	elseif h >= 14 and h < 17.5 then
		return "Tarde"
	elseif h >= 17.5 and h < 19.5 then
		return "Atardecer"
	end
	return "Noche"
end

local function pickWeather()
	local total = 0
	for _, w in ipairs(weatherWeights) do
		total = total + w[2]
	end
	local r = math.random() * total
	for _, w in ipairs(weatherWeights) do
		r = r - w[2]
		if r <= 0 then
			return w[1]
		end
	end
	return "Clear"
end

local atmosphere
local function applyWeather(w)
	Time.Weather = w
	workspace:SetAttribute("Weather", w)
	if atmosphere then
		local density = ({ Clear = 0.25, Cloudy = 0.32, Rain = 0.4, Fog = 0.62, Storm = 0.5 })[w] or 0.3
		atmosphere.Density = density
		atmosphere.Haze = (w == "Fog") and 3 or ((w == "Clear") and 0.5 or 1.5)
	end
	local clouds = workspace.Terrain:FindFirstChildOfClass("Clouds")
	if clouds then
		clouds.Cover = ({ Clear = 0.35, Cloudy = 0.75, Rain = 0.85, Fog = 0.6, Storm = 0.95 })[w] or 0.5
		clouds.Density = (w == "Storm" or w == "Rain") and 0.9 or 0.5
	end
	Lighting.Brightness = (w == "Storm") and 1.3 or ((w == "Rain") and 1.7 or 2.4)
	for _, player in ipairs(Players:GetPlayers()) do
		S.Net.notify(player, "Clima: " .. (Time.WeatherNames[w] or w), "info")
	end
end

local function setNight(isNight)
	if nightState == isNight then
		return
	end
	nightState = isNight
	for _, part in ipairs(CollectionService:GetTagged("NightLight")) do
		local light = part:FindFirstChildWhichIsA("Light")
		if light then
			light.Enabled = isNight
		end
		if part:GetAttribute("GlowNight") then
			part.Material = isNight and Enum.Material.Neon or Enum.Material.Glass
		end
	end
end

function Time.Start()
	atmosphere = Lighting:FindFirstChildOfClass("Atmosphere") or Instance.new("Atmosphere")
	atmosphere.Parent = Lighting
	if not Lighting:FindFirstChildOfClass("Sky") then
		Instance.new("Sky").Parent = Lighting
	end
	if not workspace.Terrain:FindFirstChildOfClass("Clouds") then
		local c = Instance.new("Clouds")
		c.Parent = workspace.Terrain
	end
	Lighting.OutdoorAmbient = Color3.fromRGB(120, 120, 130)
	applyWeather("Clear")
	nextWeatherAt = os.time() + math.random(4, 8) * Config.DayLengthSeconds / 24

	task.spawn(function()
		while true do
			local h = Time.hour()
			Lighting.ClockTime = h
			workspace:SetAttribute("GameHour", h)
			workspace:SetAttribute("GameDay", Time.day())
			workspace:SetAttribute("TimeLabel", Time.label())
			setNight(Time.isNight())
			if os.time() >= nextWeatherAt then
				local w = pickWeather()
				-- Las tormentas duran poco para no molestar
				local hours = (w == "Storm") and math.random(1, 2) or math.random(3, 7)
				nextWeatherAt = os.time() + hours * Config.DayLengthSeconds / 24
				if w ~= Time.Weather then
					applyWeather(w)
				end
			end
			local day = Time.day()
			if lastDay and day ~= lastDay then
				for _, player in ipairs(Players:GetPlayers()) do
					if S.Data.get(player) then
						pcall(S.Home.onNewDay, player)
						pcall(S.Economy.onNewDay, player, day)
					end
				end
				pcall(S.Channel.onNewDay, day)
			end
			lastDay = day
			task.wait(1)
		end
	end)
end

return Time
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000045"><Properties><string name="Name">TravelService</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- TravelService: dónde está cada jugador (distrito, lugar de grabación, tienda), descubrimientos,
-- lugares secretos, taxi y autobús.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local WorldData = require(Shared.WorldData)
local Catalog = require(Shared.ItemCatalog)
local Util = require(Shared.Util)

local Travel = {}
local S
local lastDistrict = {}
local lastTaxi = {}

Travel.BusLine = { "budget", "apartments", "studios", "entertainment", "events", "commercial", "park", "creators", "financial", "tourist", "university", "beach" }

local storeTags = {
	tech = { "shop", "tech" },
	camera = { "shop", "tech", "studio" },
	phone = { "shop", "tech" },
	creator = { "shop", "studio" },
	home = { "shop", "home" },
}

function Travel.Init(services)
	S = services
end

local function rootOf(player)
	return player.Character and player.Character:FindFirstChild("HumanoidRootPart")
end

-- Lugar de grabación en el que está el jugador (o nil)
function Travel.currentSpot(player)
	local root = rootOf(player)
	if not root then
		return nil
	end
	local pos = root.Position
	local district = WorldData.districtAt(pos.X, pos.Z)
	local pspot = S.Property.spot(player)
	if pspot then
		return pspot
	end
	if S.Home.isAtHome(player) then
		local _, _, decor = S.Inventory.best(player, "homeextra", "home", "Decor")
		local tags = { "home", "food" }
		if decor then
			tags[#tags + 1] = "studio"
		end
		return { Id = "home", Name = "Tu habitación", Tags = tags, Indoor = true, Interest = 5, Noise = 1, Busy = 0, IsHome = true, District = district and district.Id }
	end
	local vip = S.World.VipLounge
	if vip then
		local rel = pos - vip.Center
		if math.abs(rel.X) < vip.Size.X / 2 and math.abs(rel.Z) < vip.Size.Z / 2 and math.abs(rel.Y) < 15 then
			return { Id = "vip", Name = "Sala VIP", Tags = { "luxury", "event" }, Indoor = true, Interest = 12, Noise = 2, Busy = 3, District = "events", Decor = 20 }
		end
	end
	for _, sp in ipairs(WorldData.Specials) do
		local dx, dz = pos.X - sp.WX, pos.Z - sp.WZ
		if dx * dx + dz * dz <= 40 * 40 then
			if sp.Type == "store" then
				return { Id = "store_" .. sp.StoreId, Name = Catalog.Stores[sp.StoreId].Name, Tags = storeTags[sp.StoreId] or { "shop" }, Indoor = true, Interest = 8, Noise = 3, Busy = 5, District = sp.District, Decor = 12 }
			elseif sp.Type == "cafe" then
				return { Id = "cafe", Name = sp.Name, Tags = { "education", "tech", "food" }, Indoor = true, Interest = 6, Noise = 3, Busy = 5, District = sp.District, Decor = 8 }
			elseif sp.Type == "bank" then
				return { Id = "bank", Name = sp.Name, Tags = { "business" }, Indoor = true, Interest = 5, Noise = 2, Busy = 4, District = sp.District, Decor = 10 }
			end
		end
	end
	local best, bestD = nil, Config.RecordSpotRadius
	for _, s in ipairs(WorldData.Spots) do
		local d = math.sqrt((pos.X - s.X) ^ 2 + (pos.Z - s.Z) ^ 2)
		if d <= bestD and (not s.Secret or (S.Data.get(player).Visited.Secrets[s.Id])) then
			best, bestD = s, d
		end
	end
	if best then
		-- de noche, los lugares con etiqueta "night" son más interesantes
		if S.Time.isNight() and Util.indexOf(best.Tags, "night") then
			local copy = Util.deepCopy(best)
			copy.Interest = copy.Interest + 4
			return copy
		end
		return best
	end
	return nil
end

-- Lugar genérico para fotos fuera de los puntos de grabación
function Travel.genericSpot(player)
	local root = rootOf(player)
	local d = root and WorldData.districtAt(root.Position.X, root.Position.Z)
	if not d then
		return { Id = "outside", Name = "Afueras", Tags = { "nature" }, Indoor = false, Interest = 2, Noise = 2, Busy = 1 }
	end
	return { Id = "free_" .. d.Id, Name = d.Name, Tags = d.Tags, Indoor = false, Interest = 3, Noise = d.Noise, Busy = d.Busy, District = d.Id }
end

function Travel.markStoreVisit(player, storeId)
	local data = S.Data.get(player)
	if not data.Visited.Stores[storeId] then
		data.Visited.Stores[storeId] = true
		S.Quest.check(player)
	end
	S.Quest.tutorialEvent(player, "visit_store")
end

function Travel.taxiStop(district)
	local cx, cz = WorldData.center(district)
	return Vector3.new(cx + 24, 4, cz + WorldData.CellSize / 2 - WorldData.RoadWidth / 2 - 8)
end

function Travel.teleport(player, pos)
	local char = player.Character
	if not char or not rootOf(player) then
		return false
	end
	S.Net.push(player, "travelFade", {})
	task.delay(0.35, function()
		if char.Parent then
			char:PivotTo(CFrame.new(pos + Vector3.new(0, 3, 0)))
		end
	end)
	return true
end

function Travel.taxiTo(player, pos, label)
	local root = rootOf(player)
	if not root then
		return false, "No puedes viajar ahora."
	end
	if lastTaxi[player] and os.clock() - lastTaxi[player] < 4 then
		return false, "Espera un momento antes de pedir otro taxi."
	end
	local dist = (Vector3.new(pos.X, 0, pos.Z) - Vector3.new(root.Position.X, 0, root.Position.Z)).Magnitude
	if dist < 60 then
		return false, "Ya estás muy cerca."
	end
	local fare = math.floor((Config.TaxiBaseFare + dist * Config.TaxiPerStud) * S.Events.taxiMultiplier() + 0.5)
	if not S.Economy.spend(player, fare, "Transporte", "Taxi a " .. label) then
		return false, "El taxi cuesta $" .. fare .. "."
	end
	lastTaxi[player] = os.clock()
	local data = S.Data.get(player)
	data.Counters.taxi_rides = (data.Counters.taxi_rides or 0) + 1
	S.Quest.check(player)
	Travel.teleport(player, pos)
	return true, "🚕 Taxi a " .. label .. " ($" .. fare .. ")."
end

function Travel.Start()
	local Net = S.Net

	Net.on("Travel.Taxi", function(player, p)
		local d = WorldData.DistrictById[p.district or ""]
		if not d then
			return false, "Destino no válido."
		end
		return Travel.taxiTo(player, Travel.taxiStop(d), d.Name)
	end)

	Net.on("Travel.TaxiSpot", function(player, p)
		local spot = WorldData.SpotById[p.spot or ""]
		if not spot or spot.Secret then
			return false, "Destino no válido."
		end
		return Travel.taxiTo(player, Vector3.new(spot.X, 4, spot.Z + 12), spot.Name)
	end)

	Net.on("Travel.Bus", function(player, p)
		local d = WorldData.DistrictById[p.district or ""]
		if not d or not Util.indexOf(Travel.BusLine, d.Id) then
			return false, "El autobús no llega a ese distrito."
		end
		local root = rootOf(player)
		local here = root and WorldData.districtAt(root.Position.X, root.Position.Z)
		if not here or not Util.indexOf(Travel.BusLine, here.Id) then
			return false, "Aquí no hay parada de autobús. Las paradas están en: " .. #Travel.BusLine .. " distritos de la línea."
		end
		if here.Id == d.Id then
			return false, "Ya estás en ese distrito."
		end
		if not S.Economy.spend(player, 3, "Transporte", "Autobús a " .. d.Name) then
			return false, "El billete cuesta $3."
		end
		Travel.teleport(player, Travel.taxiStop(d) + Vector3.new(-40, 0, 0))
		return true, "🚌 Autobús a " .. d.Name .. " ($3)."
	end)

	Players.PlayerRemoving:Connect(function(player)
		lastDistrict[player] = nil
		lastTaxi[player] = nil
	end)

	task.spawn(function()
		while true do
			task.wait(1.5)
			for _, player in ipairs(Players:GetPlayers()) do
				local data = S.Data.get(player)
				local root = rootOf(player)
				if data and root then
					local pos = root.Position
					local d = WorldData.districtAt(pos.X, pos.Z)
					if d and d.Id ~= lastDistrict[player] then
						lastDistrict[player] = d.Id
						player:SetAttribute("District", d.Name)
						if not data.Visited.Districts[d.Id] then
							local first = Util.count(data.Visited.Districts) == 0
							data.Visited.Districts[d.Id] = true
							if not first then
								S.Net.notify(player, "🗺 Nuevo distrito descubierto: " .. d.Name, "success")
								S.Progress.addXp(player, S.Progress.Xp.District)
								S.Quest.tutorialEvent(player, "new_district")
							end
							S.Quest.check(player)
						end
					elseif not d then
						player:SetAttribute("District", "Afueras")
					end
					-- Tiendas
					local storeId = S.Shop.storeNear(player)
					if storeId and player:GetAttribute("InStore") ~= storeId then
						player:SetAttribute("InStore", storeId)
						Travel.markStoreVisit(player, storeId)
					elseif not storeId then
						player:SetAttribute("InStore", nil)
					end
					-- Lugar de grabación cercano (para el HUD)
					local spot = Travel.currentSpot(player)
					player:SetAttribute("Spot", spot and spot.Name or nil)
					-- Secretos
					for _, s in ipairs(WorldData.Secrets) do
						if not data.Visited.Secrets[s.Id] then
							local dx, dz = pos.X - s.WX, pos.Z - s.WZ
							if dx * dx + dz * dz < 20 * 20 then
								data.Visited.Secrets[s.Id] = true
								S.Economy.add(player, s.Reward, "Descubrimientos", "Lugar secreto: " .. s.Name, {})
								S.Net.push(player, "secret", { name = s.Name, reward = s.Reward })
								S.Progress.addXp(player, 50)
								S.Quest.check(player)
							end
						end
					end
				end
			end
		end
	end)
end

return Travel
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000046"><Properties><string name="Name">VideoService</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- VideoService: ciclo completo de creación de vídeos.
--   IDEA -> PLAN -> MOCHILA -> VIAJE -> GRABACIÓN (escenas) / FOTOS -> IMPORTAR -> EDICIÓN
--   -> EXPORTACIÓN -> MINIATURA -> PUBLICACIÓN -> RESULTADOS (ChannelService)
-- Todo se calcula en el servidor con VideoFormulas y el equipo REAL que lleva el jugador.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Catalog = require(Shared.ItemCatalog)
local VideoData = require(Shared.VideoData)
local F = require(Shared.VideoFormulas)
local Util = require(Shared.Util)

local Video = {}
local S
local recording = {} -- [player] = { Pid, UseCamera, Last }
local lastPhoto = {}

Video.GbScale = 10

function Video.Init(services)
	S = services
end

local function projectSlots(player)
	return Config.BaseProjectSlots + S.Monetization.perk(player, "ProjectSlots")
end

local function getProject(player, pid)
	local data = S.Data.get(player)
	return type(pid) == "string" and data.Projects[pid] or nil
end

local function newEdit()
	return { Timeline = {}, Titles = false, TitleText = "", Subtitles = false, Music = "none", MusicVol = 0.3, VoiceVol = 1,
		Effects = {}, Color = { b = 0, c = 0, s = 0 }, Intro = "none", Outro = "none" }
end

---------------------------------------------------------------------------
-- Equipo usado para grabar
---------------------------------------------------------------------------
-- Devuelve una descripción del equipo disponible ahora mismo (según dónde esté el jugador)
function Video.gear(player, preferPhone)
	local atHome = S.Home.isAtHome(player)
	local gear = {}
	local camUid, camRec, camDef = S.Inventory.best(player, "camera", "backpack", "Video")
	if not camUid and atHome then
		camUid, camRec, camDef = S.Inventory.best(player, "camera", "home", "Video")
	end
	local phoneRec, phoneDef, phoneUid = S.Inventory.phone(player)
	if camUid and not preferPhone then
		gear.DeviceUid, gear.DeviceRec, gear.Device, gear.IsPhone = camUid, camRec, camDef, false
	elseif phoneRec then
		gear.DeviceUid, gear.DeviceRec, gear.Device, gear.IsPhone = phoneUid, phoneRec, phoneDef, true
	end
	local function pick(slot, stat)
		local uid, rec, def = S.Inventory.best(player, slot, "backpack", stat)
		if not uid and atHome then
			uid, rec, def = S.Inventory.best(player, slot, "home", stat)
		end
		return def, rec, uid
	end
	gear.Mic = pick("mic", "Audio")
	if gear.Mic and not gear.Mic.Portable and not atHome then
		gear.Mic = nil
	end
	gear.Tripod = pick("tripod", "Stability")
	gear.Gimbal = pick("gimbal", "Stab")
	gear.Mount = gear.IsPhone and pick("mount", "Stab") or nil
	gear.Light = pick("light", "Light")
	gear.Drone = pick("drone")
	if atHome then
		gear.HomeLight = S.Inventory.best(player, "homelight", "home", "Light") and select(3, S.Inventory.best(player, "homelight", "home", "Light"))
		gear.Decor = select(3, S.Inventory.best(player, "homeextra", "home", "Decor"))
		local tp = nil
		for _, rec in pairs(S.Data.get(player).Inventory) do
			if rec.Id == "teleprompter" and rec.Loc == "home" then
				tp = Catalog.get("teleprompter")
			end
		end
		gear.Teleprompter = tp
	end
	gear.AtHome = atHome
	return gear
end

local function drainBattery(player, gear)
	local rec, def = gear.DeviceRec, gear.Device
	local drain = 100 / math.max(1, def.Stats.Battery or 10)
	if rec.Charge >= drain - 0.01 then
		rec.Charge = math.max(0, rec.Charge - drain)
		return true, rec.Charge < drain
	end
	if not gear.IsPhone then
		-- usar una batería de repuesto de la mochila
		local data = S.Data.get(player)
		for _, brec in pairs(data.Inventory) do
			local bdef = Catalog.get(brec.Id)
			if bdef.Slot == "battery" and brec.Loc == "backpack" and brec.Charge > 1 then
				brec.Charge = math.max(0, brec.Charge - 100 / bdef.Stats.Charges)
				rec.Charge = 100 - drain
				S.Net.notify(player, "🔋 Batería de repuesto colocada.", "info")
				return true, false
			end
		end
	end
	return false
end

---------------------------------------------------------------------------
-- Escena
---------------------------------------------------------------------------
local function featuredFrom(player, p, spot, gear)
	-- Producto propio (en la mochila o en casa si grabas en casa)
	local data = S.Data.get(player)
	if type(p.featuredUid) == "string" and data.Inventory[p.featuredUid] then
		local rec = data.Inventory[p.featuredUid]
		if rec.Loc == "backpack" or (gear.AtHome and rec.Loc == "home") then
			local def = Catalog.get(rec.Id)
			return def, true
		end
		return nil, nil, "Ese producto no está contigo: llévalo en la mochila."
	end
	-- Producto de exposición en la tienda donde estás (prueba en tienda, sin poseerlo)
	if type(p.featuredStoreItem) == "string" then
		local def = Catalog.get(p.featuredStoreItem)
		local storeId = S.Shop.storeNear(player)
		if def and storeId and Util.indexOf(def.Stores, storeId) then
			return def, false
		end
		return nil, nil, "Solo puedes probar productos de exposición dentro de la tienda que los vende."
	end
	return nil
end

function Video.recordScene(player, p)
	local data = S.Data.get(player)
	local rec = recording[player]
	if not rec then
		return false, "No estás grabando. Pulsa GRABAR primero."
	end
	local proj = data.Projects[rec.Pid]
	if not proj then
		recording[player] = nil
		return false, "El proyecto ya no existe."
	end
	if #proj.Scenes >= Config.MaxScenesPerProject then
		return false, "Este proyecto ya tiene el máximo de escenas (" .. Config.MaxScenesPerProject .. ")."
	end
	if os.clock() - (rec.Last or 0) < Config.SceneCooldown then
		return false, "Espera un momento entre tomas."
	end
	local shot = VideoData.ShotById[p.shot or ""]
	if not shot then
		return false, "Tipo de toma no válido."
	end
	local spot = S.Travel.currentSpot(player)
	if not spot then
		return false, "Aquí no hay nada interesante que grabar. Busca un lugar 🎥, una tienda o tu casa."
	end
	local gear = Video.gear(player, not rec.UseCamera)
	if not gear.Device then
		return false, "No tienes con qué grabar."
	end
	if shot.NeedsTripod and not gear.Tripod then
		return false, "El time-lapse necesita un trípode en la mochila."
	end
	if shot.NeedsDrone and (not gear.Drone or spot.Indoor) then
		return false, "La toma aérea necesita un dron en la mochila y estar al aire libre."
	end
	if shot.NeedsPeople and (spot.Busy or 0) < 4 and not Util.indexOf(spot.Tags, "event") then
		return false, "No hay nadie para entrevistar aquí. Prueba en un lugar concurrido."
	end
	local product, owned, perr = featuredFrom(player, p, spot, gear)
	if perr then
		return false, perr
	end
	if shot.NeedsProduct and not product then
		return false, "El plano de producto necesita un producto: elige uno de tu mochila o uno expuesto en la tienda."
	end
	local okBattery, low = drainBattery(player, gear)
	if not okBattery then
		return false, "Batería agotada. Vuelve a casa a cargar, lleva baterías de repuesto o cambia al teléfono."
	end

	local cat = VideoData.CategoryById[proj.Category]
	local hour = S.Time.hour()
	local stats = {}
	for k, v in pairs(gear.Device.Stats) do
		stats[k] = v
	end
	local cf = S.Inventory.condFactor(gear.DeviceRec)
	stats.Video = stats.Video * cf
	stats.Audio = gear.IsPhone and 25 or (gear.Device.Sub == "Vlog" and 42 or 30)
	local result = F.scene({
		shot = shot,
		device = stats,
		micAudio = gear.Mic and gear.Mic.Stats.Audio or nil,
		micPortable = gear.Mic and gear.Mic.Portable or false,
		tripod = gear.Tripod and gear.Tripod.Stats.Stability or 0,
		gimbal = gear.Gimbal and gear.Gimbal.Stats.Stab or 0,
		mount = gear.Mount and gear.Mount.Stats.Stab or 0,
		portableLight = gear.Light and gear.Light.Stats.Light or 0,
		homeLight = spot.IsHome and ((gear.HomeLight and gear.HomeLight.Stats.Light or 0) + (spot.ExtraLight or 0)) or 0,
		decor = spot.Decor or (spot.IsHome and (5 + (gear.Decor and gear.Decor.Stats.Decor or 0))) or 0,
		presentation = spot.IsHome and gear.Teleprompter and gear.Teleprompter.Stats.Presentation or 0,
		indoor = spot.Indoor,
		hour = hour,
		goldenHour = F.isGoldenHour(hour),
		weather = S.Time.Weather,
		spotTags = spot.Tags,
		spotInterest = spot.Interest * S.Events.sceneBonus(spot) + (S.Needs and S.Needs.interestBonus(player) or 0),
		spotNoise = spot.Noise,
		busy = spot.Busy,
		categoryTags = cat.Tags,
		productQuality = product and product.Quality or nil,
		batteryLow = low,
	})

	data.Counters.scene_id = (data.Counters.scene_id or 0) + 1
	local scene = {
		Id = "s" .. data.Counters.scene_id,
		Shot = shot.Id,
		Spot = spot.Id,
		SpotName = spot.Name,
		District = spot.District,
		Q = result.Quality,
		Img = result.Image,
		Aud = result.Audio,
		Light = result.Lighting,
		Int = result.Interest,
		Probs = result.Problems,
		Sec = result.Seconds,
		Dev = gear.Device.Name,
		Gb = Util.round((gear.Device.Stats.GbPerMin or 1) * result.Seconds / 60 * Video.GbScale, 1),
		Imp = false,
		Feat = product and product.Id or nil,
		Own = owned,
		Hour = Util.round(hour, 1),
		W = S.Time.Weather,
	}
	table.insert(proj.Scenes, scene)
	if proj.Status == "planning" then
		proj.Status = "recording"
	end
	rec.Last = os.clock()
	-- desgaste leve del equipo
	gear.DeviceRec.Cond = math.max(30, gear.DeviceRec.Cond - 0.15)

	data.Counters.scenes = (data.Counters.scenes or 0) + 1
	if F.isGoldenHour(hour) and not spot.Indoor then
		data.Counters.golden_scenes = (data.Counters.golden_scenes or 0) + 1
	end
	if spot.District then
		data.Visited.Recorded[spot.District] = true
	end
	S.Progress.addXp(player, S.Progress.Xp.Scene)
	S.Events.onScene(player, spot)
	S.Jobs.onScene(player, scene)
	if S.Needs then
		S.Needs.spend(player, 1)
	end
	S.Quest.tutorialEvent(player, "record_scene")
	S.Quest.check(player)
	local msg = "🎬 " .. shot.Name .. " en " .. spot.Name .. " — calidad " .. math.floor(scene.Q)
	if #scene.Probs > 0 then
		msg = msg .. " (" .. table.concat(scene.Probs, ", ") .. ")"
	end
	return true, msg, { scene = scene, charge = gear.DeviceRec.Charge }
end

---------------------------------------------------------------------------
-- Fotografías
---------------------------------------------------------------------------
function Video.photoCapacity(player)
	local phoneRec, phoneDef = S.Inventory.phone(player)
	local cap = phoneDef and phoneDef.Stats.PhotoStorage or 40
	if S.Inventory.best(player, "camera", "any", "Photo") then
		cap = cap + 60
	end
	return math.min(Config.MaxPhotos, cap)
end

local function num(v, lo, hi)
	v = tonumber(v)
	if not v or v ~= v then
		return nil
	end
	return Util.clamp(v, lo, hi)
end

function Video.takePhoto(player, p)
	local data = S.Data.get(player)
	if os.clock() - (lastPhoto[player] or 0) < Config.PhotoCooldown then
		return false, "Espera un momento."
	end
	local mode = VideoData.PhotoModeById[p.mode or ""]
	if not mode then
		return false, "Modo de foto no válido."
	end
	if #data.Photos >= Video.photoCapacity(player) then
		return false, "Álbum lleno (" .. #data.Photos .. " fotos). Borra fotos o consigue más almacenamiento (mejor teléfono o una cámara)."
	end
	local spot = S.Travel.currentSpot(player) or S.Travel.genericSpot(player)
	local gear = Video.gear(player, false)
	-- Para fotos se usa el dispositivo con mejor calidad fotográfica
	local camUid, camRec, camDef = S.Inventory.best(player, "camera", "backpack", "Photo")
	local phoneRec, phoneDef = S.Inventory.phone(player)
	local dev, devRec = phoneDef, phoneRec
	if camDef and (not phoneDef or camDef.Stats.Photo > phoneDef.Stats.Photo) then
		dev, devRec = camDef, camRec
	end
	if not dev then
		return false, "No tienes cámara ni teléfono."
	end
	local product = nil
	if mode.NeedsProduct then
		local def, owned, perr = featuredFrom(player, p, spot, gear)
		if not def then
			return false, perr or "Elige un producto para la foto de producto."
		end
		product = def
	end
	local hour = S.Time.hour()
	local stats = {}
	for k, v in pairs(dev.Stats) do
		stats[k] = v
	end
	stats.Photo = stats.Photo * S.Inventory.condFactor(devRec)
	local result = F.photo({
		mode = mode,
		device = stats,
		indoor = spot.Indoor,
		hour = hour,
		goldenHour = F.isGoldenHour(hour),
		weather = S.Time.Weather,
		spotTags = spot.Tags,
		homeLight = spot.IsHome and ((gear.HomeLight and gear.HomeLight.Stats.Light or 0) + (spot.ExtraLight or 0)) or 0,
		portableLight = gear.Light and gear.Light.Stats.Light or 0,
		tripod = gear.Tripod and gear.Tripod.Stats.Stability or 0,
		composition = num(p.composition, 0, 10) or 5,
	})
	data.Counters.photo_id = (data.Counters.photo_id or 0) + 1
	local cam = nil
	if type(p.cam) == "table" then
		local c = {}
		for i = 1, 6 do
			c[i] = num(p.cam[i], -5000, 5000)
		end
		if c[6] then
			cam = c
		end
	end
	local filter = math.floor(num(p.filter, 1, #VideoData.PhotoFilters) or 1)
	local photo = {
		Id = "f" .. data.Counters.photo_id,
		Mode = mode.Id,
		Q = result.Quality,
		Spot = spot.Id,
		SpotName = spot.Name,
		District = spot.District,
		Tags = spot.Tags,
		Hour = Util.round(hour, 1),
		W = S.Time.Weather,
		T = os.time(),
		Filter = filter,
		Cam = cam,
		Fov = num(p.fov, 20, 100) or 70,
		Album = "General",
		Dev = dev.Name,
		Prod = product and product.Id or nil,
		Probs = result.Problems,
	}
	table.insert(data.Photos, 1, photo)
	lastPhoto[player] = os.clock()
	data.Counters.photos = (data.Counters.photos or 0) + 1
	if mode.Night and S.Time.isNight() then
		data.Counters.night_photos = (data.Counters.night_photos or 0) + 1
	end
	S.Progress.addXp(player, S.Progress.Xp.Photo)
	S.Quest.check(player)
	-- Encargos de fotógrafo (JobsService) y concursos de eventos
	S.Jobs.onPhoto(player, photo)
	S.Events.onPhoto(player, photo)
	return true, "📸 Foto guardada (" .. mode.Name .. ", calidad " .. math.floor(photo.Q) .. ")", { photo = photo }
end

---------------------------------------------------------------------------
-- Edición
---------------------------------------------------------------------------
local function canEdit(player)
	if S.Computer.hasSession(player) then
		return true, S.Computer.sessionStats(player)
	end
	local _, _, tab = S.Inventory.best(player, "tablet", "backpack", "EditLite")
	if tab and (tab.Stats.EditLite or 0) > 0 then
		return true, { MaxScenes = tab.Stats.EditLite, ColorAcc = 55, ProColor = 0, AudioMix = 10, Kind = "tablet", RenderMult = 0.8, EditSpeed = 0, Comfort = 0 }
	end
	return false
end

local function validEdit(proj, data, edit, maxScenes)
	if type(edit) ~= "table" or type(edit.Timeline) ~= "table" then
		return nil, "Edición no válida."
	end
	if #edit.Timeline > maxScenes then
		return nil, "Tu equipo solo puede manejar " .. maxScenes .. " clips. Mejora el computador para proyectos más grandes."
	end
	local scenes = {}
	for _, sc in ipairs(proj.Scenes) do
		scenes[sc.Id] = sc
	end
	local photos = {}
	for _, ph in ipairs(data.Photos) do
		photos[ph.Id] = ph
	end
	local transitions = {}
	for _, t in ipairs(VideoData.Transitions) do
		transitions[t.Id] = true
	end
	local out = newEdit()
	for _, e in ipairs(edit.Timeline) do
		if type(e) ~= "table" then
			return nil, "Clip no válido."
		end
		if e.k == "s" then
			local sc = scenes[e.id]
			if not sc then
				return nil, "Una escena ya no existe."
			end
			if not sc.Imp then
				return nil, "Importa el material antes de editarlo."
			end
		elseif e.k == "p" then
			if not photos[e.id] then
				return nil, "Una foto ya no existe."
			end
		else
			return nil, "Clip no válido."
		end
		table.insert(out.Timeline, { k = e.k, id = e.id, trim = num(e.trim, 0.3, 1) or 1, tr = transitions[e.tr] and e.tr or "cut" })
	end
	out.Titles = edit.Titles == true
	out.TitleText = Util.cleanText(edit.TitleText or "", 40) or ""
	out.Subtitles = edit.Subtitles == true
	out.Music = VideoData.MusicById[edit.Music or ""] and edit.Music or "none"
	out.MusicVol = num(edit.MusicVol, 0, 1) or 0.3
	out.VoiceVol = num(edit.VoiceVol, 0, 1) or 1
	local fx = {}
	for _, id in ipairs(type(edit.Effects) == "table" and edit.Effects or {}) do
		for _, def in ipairs(VideoData.Effects) do
			if def.Id == id and not Util.indexOf(fx, id) then
				fx[#fx + 1] = id
			end
		end
	end
	out.Effects = fx
	local c = type(edit.Color) == "table" and edit.Color or {}
	out.Color = { b = math.floor(num(c.b, -100, 100) or 0), c = math.floor(num(c.c, -100, 100) or 0), s = math.floor(num(c.s, -100, 100) or 0) }
	local function validId(list, id)
		for _, it in ipairs(list) do
			if it.Id == id then
				return id
			end
		end
		return "none"
	end
	out.Intro = validId(VideoData.Intros, edit.Intro)
	out.Outro = validId(VideoData.Outros, edit.Outro)
	return out
end

function Video.evaluate(player, proj, stats)
	local data = S.Data.get(player)
	local scenes, photos = {}, {}
	for _, sc in ipairs(proj.Scenes) do
		scenes[sc.Id] = sc
	end
	for _, ph in ipairs(data.Photos) do
		photos[ph.Id] = ph
	end
	local entries, nPhotos, nTrans = {}, 0, 0
	for i, e in ipairs(proj.Edit.Timeline) do
		if e.k == "s" and scenes[e.id] then
			local sc = scenes[e.id]
			entries[#entries + 1] = { q = sc.Q, seconds = sc.Sec, trim = e.trim, shot = sc.Shot, transition = e.tr }
		elseif e.k == "p" and photos[e.id] then
			nPhotos = nPhotos + 1
			entries[#entries + 1] = { q = photos[e.id].Q * 0.8, seconds = 4, trim = 1, shot = "photo", transition = e.tr }
		end
		if i > 1 and e.tr ~= "cut" then
			nTrans = nTrans + 1
		end
	end
	local dur = VideoData.Durations[1]
	for _, d in ipairs(VideoData.Durations) do
		if d.Id == proj.Plan.Duration then
			dur = d
		end
	end
	local ed = proj.Edit
	local res = F.edit({
		entries = entries,
		targetSeconds = dur.Seconds,
		titles = ed.Titles,
		subtitles = ed.Subtitles,
		music = ed.Music,
		musicVol = ed.MusicVol,
		voiceVol = ed.VoiceVol,
		effects = ed.Effects,
		color = ed.Color,
		intro = ed.Intro,
		outro = ed.Outro,
		category = proj.Category,
		colorAcc = stats and stats.ColorAcc or 40,
		proColor = stats and stats.ProColor or 0,
		audioMix = stats and stats.AudioMix or 0,
	})
	local c = ed.Color
	local graded = (math.abs(c.b) + math.abs(c.c) + math.abs(c.s)) > 0
	return res, { seconds = res.Seconds, effects = ed.Effects, transitions = nTrans, photos = nPhotos, colorGraded = graded }
end

---------------------------------------------------------------------------
-- Publicación
---------------------------------------------------------------------------
local function classify(proj, cat)
	local owned, store = {}, {}
	local talking = false
	for _, sc in ipairs(proj.Scenes) do
		if sc.Feat then
			if sc.Own then
				owned[sc.Feat] = true
			else
				store[sc.Feat] = true
			end
		end
		if sc.Shot == "talking" then
			talking = true
		end
	end
	local nOwned, nStore = Util.count(owned), Util.count(store)
	local need = cat.NeedsProducts or 0
	local label, mult = nil, 1
	if need > 0 or cat.ProductBonus then
		if nOwned >= math.max(1, need) then
			label, mult = "Prueba real", 1.1
		elseif nOwned + nStore >= math.max(1, need) then
			label, mult = "Prueba en tienda", 1.0
		elseif need > 0 then
			label, mult = "Comparación de especificaciones", 0.8
		end
	end
	local tags = {}
	if label then
		tags[#tags + 1] = label
	end
	if talking then
		tags[#tags + 1] = "Opinión personal"
	end
	local products = {}
	for id in pairs(owned) do
		products[#products + 1] = id
	end
	for id in pairs(store) do
		products[#products + 1] = id
	end
	return label, mult, tags, products, nOwned
end

function Video.publish(player, p)
	local data = S.Data.get(player)
	local proj = getProject(player, p.pid)
	if not proj then
		return false, "Proyecto no encontrado."
	end
	if not proj.Export or proj.Export.ReadyAt == nil then
		return false, "Primero exporta el vídeo en el Editor."
	end
	if os.time() < proj.Export.ReadyAt then
		return false, "La exportación aún no ha terminado."
	end
	local title = Util.cleanText(p.title, Config.MaxTextTitle)
	if not title or #title < 3 then
		return false, "Escribe un título (mínimo 3 caracteres)."
	end
	local desc = Util.cleanText(p.description or "", Config.MaxTextDescription) or ""
	local tagList = {}
	if type(p.tags) == "table" then
		for i = 1, math.min(8, #p.tags) do
			local t = Util.cleanText(p.tags[i], 20)
			if t and #t > 0 then
				tagList[#tagList + 1] = t
			end
		end
	end
	local fTitle = S.Text.filter(player, title)
	local fDesc = S.Text.filter(player, desc)
	local fTags = S.Text.filter(player, table.concat(tagList, ","))
	if not fTitle or not fDesc or not fTags then
		return false, "No se pudo comprobar el texto. Inténtalo de nuevo."
	end
	local thumb = type(p.thumbId) == "string" and data.Thumbnails[p.thumbId] or nil
	local cat = VideoData.CategoryById[proj.Category]
	local res = proj.Export.Res
	local label, labelMult, labels, products, nOwned = classify(proj, cat)

	-- Formato
	local fmt = VideoData.FormatById[p.format or "video"] or VideoData.FormatById.video
	if fmt.MaxSeconds and res.Seconds > fmt.MaxSeconds then
		return false, "Un Short dura como máximo " .. fmt.MaxSeconds .. " s (el tuyo dura " .. res.Seconds .. " s). Recorta en el Editor."
	end
	if fmt.MinTalk then
		local talk, audio = 0, 0
		for _, sc in ipairs(proj.Scenes) do
			if sc.Shot == "talking" or sc.Shot == "interview" then
				talk = talk + 1
				audio = audio + sc.Aud
			end
		end
		if talk < fmt.MinTalk then
			return false, "Un podcast necesita al menos " .. fmt.MinTalk .. " tomas de presentación o entrevista."
		end
		if audio / talk < fmt.MinAudio then
			return false, "El audio de las tomas habladas es demasiado bajo para un podcast (usa un buen micrófono)."
		end
	end
	if fmt.MinScenes and (#proj.Scenes < fmt.MinScenes or res.Seconds < fmt.MinSeconds) then
		return false, "Un documental necesita al menos " .. fmt.MinScenes .. " escenas y " .. math.floor(fmt.MinSeconds / 60) .. " minutos."
	end
	local seriesName, episode, loyal = nil, nil, 1
	if fmt.Series then
		local n = Util.cleanText(p.series or "", 30)
		if not n or #n < 2 then
			return false, "Escribe el nombre de la serie."
		end
		seriesName = S.Text.filter(player, n)
		if not seriesName then
			return false, "No se pudo comprobar el nombre de la serie."
		end
		data.Series = data.Series or {}
		episode = (data.Series[seriesName] or 0) + 1
		loyal = 1 + math.min(0.3, 0.06 * (episode - 1))
	end
	-- Patrocinio
	local contract, contractId = nil, nil
	if type(p.sponsor) == "string" and p.sponsor ~= "" then
		local c, err = S.Sponsor.fulfill(player, p.sponsor, proj, res.Final)
		if not c then
			return false, "No cumple el contrato: " .. err
		end
		contract, contractId = c, p.sponsor
		labels[#labels + 1] = "Contenido patrocinado"
	end

	data.Counters.video_id = (data.Counters.video_id or 0) + 1
	local vid = "v" .. data.Counters.video_id
	local seed = vid .. ":" .. player.UserId
	local luck = Util.seededRandom(seed, 0.8, 1.25)
	local viral = nil
	if res.Final >= 75 and Util.seededRandom(seed .. ":viral", 0, 1) > 0.96 then
		viral = Util.seededRandom(seed .. ":mult", 2.5, 4)
	end
	local fatigue = 1
	local same = 0
	for i = 1, math.min(3, #data.Videos) do
		if data.Videos[i].Cat == proj.Category then
			same = same + 1
		end
	end
	if same >= 3 then
		fatigue = 0.85
	end
	local thumbScore = thumb and thumb.Score or 30
	local titleScore = F.title(fTitle, proj.Category)
	local ctr = F.ctr(thumbScore, titleScore)
	local trend = S.Channel.trendFor(proj.Category)
	local expected = F.expectedViews({
		subs = data.Channel.Subs,
		quality = res.Final,
		ctr = ctr,
		interest = cat.Interest * labelMult,
		trend = trend,
		reputation = data.Reputation,
		luck = luck,
		competition = S.Channel.competition(),
		fatigue = fatigue,
		viral = viral,
	})
	expected = math.floor(expected * (fmt.ViewMult or 1) * loyal * S.Events.viewMultiplier(proj.Category))
	local unlisted = p.visibility == "unlisted"
	if unlisted then
		expected = math.floor(expected * 0.1)
	end

	local video = {
		Id = vid,
		Title = fTitle,
		Desc = fDesc,
		Tags = fTags,
		Cat = proj.Category,
		Q = res.Final,
		EditQ = res.EditQuality,
		Footage = res.Footage,
		Sec = res.Seconds,
		Thumb = thumbScore,
		ThumbDesign = thumb and thumb.Design or nil,
		TitleScore = titleScore,
		Ctr = Util.round(ctr * 100, 2),
		Expected = expected,
		Views = 0,
		Likes = 0,
		Comments = 0,
		CommentList = {},
		Revenue = 0,
		SubsGained = 0,
		At = os.time(),
		Hist = {},
		Label = label,
		Labels = labels,
		Products = products,
		Trend = trend > 1,
		Viral = viral ~= nil,
		Unlisted = unlisted,
		Format = fmt.Id,
		RpmMult = fmt.RpmMult or 1,
		SubMult = fmt.SubMult or 1,
		Series = seriesName,
		Episode = episode,
		Sponsor = contract and contract.Brand or nil,
	}
	table.insert(data.Videos, 1, video)
	while #data.Videos > Config.MaxVideosKept do
		table.remove(data.Videos)
	end
	data.Projects[p.pid] = nil
	if recording[player] and recording[player].Pid == p.pid then
		recording[player] = nil
	end

	-- Progreso
	if seriesName then
		data.Series[seriesName] = episode
		data.Counters.series_eps = (data.Counters.series_eps or 0) + 1
	end
	if fmt.Id == "short" then
		data.Counters.shorts = (data.Counters.shorts or 0) + 1
	elseif fmt.Id == "podcast" then
		data.Counters.podcasts = (data.Counters.podcasts or 0) + 1
	elseif fmt.Id == "doc" then
		data.Counters.docs = (data.Counters.docs or 0) + 1
		if res.Final >= 65 then
			data.Reputation = math.min(100, data.Reputation + 1)
		end
	end
	if contractId then
		S.Sponsor.complete(player, contractId, res.Final)
	end
	S.Events.onPublish(player, video)
	data.Counters.published = (data.Counters.published or 0) + 1
	data.Visited.Categories[proj.Category] = true
	data.Counters.max_quality = math.max(data.Counters.max_quality or 0, math.floor(res.Final))
	if proj.Category == "compare" then
		data.Counters.comparisons = (data.Counters.comparisons or 0) + 1
	end
	if label == "Prueba real" and (proj.Category == "review" or proj.Category == "unboxing" or proj.Category == "tech" or proj.Category == "compare") then
		data.Counters.reviews = (data.Counters.reviews or 0) + 1
	end
	if res.Final >= 70 then
		data.Reputation = math.min(100, data.Reputation + 1)
	elseif res.Final < 30 then
		data.Reputation = math.max(0, data.Reputation - 1)
	end
	S.Progress.addXp(player, S.Progress.Xp.PublishBase + math.floor(res.Final / 2))
	S.Quest.tutorialEvent(player, "publish")
	S.Quest.check(player)
	S.Channel.tickPlayer(player)
	return true, "🎉 ¡Vídeo publicado! Calidad final " .. math.floor(res.Final) .. "/100. Mira cómo crece en Estadísticas.", { videoId = vid }
end

---------------------------------------------------------------------------
-- Registro de acciones
---------------------------------------------------------------------------
function Video.Start()
	local Net = S.Net

	Net.on("Video.CreateProject", function(player, p)
		local data = S.Data.get(player)
		local cat = VideoData.CategoryById[p.category or ""]
		if not cat then
			return false, "Elige una categoría."
		end
		if Util.count(data.Projects) >= projectSlots(player) then
			return false, "Tienes " .. projectSlots(player) .. " proyectos abiertos. Publica o borra alguno."
		end
		local name = Util.cleanText(p.name or "", 40)
		if not name or #name == 0 then
			name = cat.Name .. " #" .. ((data.Counters.project_id or 0) + 1)
		end
		name = S.Text.filter(player, name) or (cat.Name .. " #" .. ((data.Counters.project_id or 0) + 1))
		data.Counters.project_id = (data.Counters.project_id or 0) + 1
		local pid = "p" .. data.Counters.project_id
		data.Projects[pid] = {
			Id = pid,
			Name = name,
			Category = cat.Id,
			Status = "planning",
			Created = os.time(),
			Plan = { Style = 1, Duration = "short", Budget = 0, Goal = 1, Transport = 1, Location = "", Featured = {}, Time = "", Notes = "" },
			Scenes = {},
			Edit = newEdit(),
			Versions = {},
			Export = nil,
			ThumbId = "",
		}
		S.Quest.tutorialEvent(player, "create_project")
		return true, "Proyecto «" .. name .. "» creado. Planifícalo y sal a grabar.", { pid = pid }
	end)

	Net.on("Video.UpdatePlan", function(player, p)
		local proj = getProject(player, p.pid)
		if not proj then
			return false, "Proyecto no encontrado."
		end
		local plan = proj.Plan
		local q = type(p.plan) == "table" and p.plan or {}
		plan.Style = math.floor(num(q.Style, 1, #VideoData.Styles) or plan.Style)
		plan.Goal = math.floor(num(q.Goal, 1, #VideoData.Goals) or plan.Goal)
		plan.Transport = math.floor(num(q.Transport, 1, #VideoData.Transport) or plan.Transport)
		plan.Budget = math.floor(num(q.Budget, 0, 1000000) or plan.Budget)
		for _, d in ipairs(VideoData.Durations) do
			if d.Id == q.Duration then
				plan.Duration = d.Id
			end
		end
		if type(q.Location) == "string" and (q.Location == "" or S.World.SpotById[q.Location] or q.Location == "home") then
			plan.Location = q.Location
		end
		if type(q.Time) == "string" and #q.Time <= 20 then
			plan.Time = q.Time
		end
		if type(q.Featured) == "table" then
			local f = {}
			for i = 1, math.min(4, #q.Featured) do
				if Catalog.get(q.Featured[i]) then
					f[#f + 1] = q.Featured[i]
				end
			end
			plan.Featured = f
		end
		return true, "Plan guardado."
	end)

	Net.on("Video.DeleteProject", function(player, p)
		local data = S.Data.get(player)
		if not getProject(player, p.pid) then
			return false, "Proyecto no encontrado."
		end
		data.Projects[p.pid] = nil
		if recording[player] and recording[player].Pid == p.pid then
			recording[player] = nil
		end
		return true, "Proyecto movido a la papelera y eliminado."
	end)

	Net.on("Video.DuplicateProject", function(player, p)
		local data = S.Data.get(player)
		local proj = getProject(player, p.pid)
		if not proj then
			return false, "Proyecto no encontrado."
		end
		if Util.count(data.Projects) >= projectSlots(player) then
			return false, "No quedan espacios para proyectos."
		end
		data.Counters.project_id = (data.Counters.project_id or 0) + 1
		local pid = "p" .. data.Counters.project_id
		local copy = Util.deepCopy(proj)
		copy.Id = pid
		copy.Name = (proj.Name .. " (copia)"):sub(1, 40)
		copy.Export = nil
		copy.Versions = {}
		data.Projects[pid] = copy
		return true, "Proyecto duplicado.", { pid = pid }
	end)

	Net.on("Video.StartRecording", function(player, p)
		local proj = getProject(player, p.pid)
		if not proj then
			return false, "Elige un proyecto."
		end
		local gear = Video.gear(player, p.usePhone == true)
		if not gear.Device then
			return false, "No tienes cámara ni teléfono."
		end
		recording[player] = { Pid = p.pid, UseCamera = p.usePhone ~= true, Last = 0 }
		local spot = S.Travel.currentSpot(player)
		return true, "Grabando «" .. proj.Name .. "» con " .. gear.Device.Name .. ".", {
			device = gear.Device.Name,
			charge = gear.DeviceRec.Charge,
			spot = spot and spot.Name or nil,
			mic = gear.Mic and gear.Mic.Name or "Micrófono interno",
			tripod = gear.Tripod ~= nil,
			gimbal = gear.Gimbal ~= nil,
			light = gear.Light ~= nil,
			drone = gear.Drone ~= nil,
		}
	end)

	Net.on("Video.StopRecording", function(player)
		recording[player] = nil
		return true, "Grabación terminada. Vuelve a casa para importar y editar."
	end)

	Net.on("Video.RecordScene", Video.recordScene)
	Net.on("Video.DeleteScene", function(player, p)
		local proj = getProject(player, p.pid)
		if not proj then
			return false, "Proyecto no encontrado."
		end
		for i, sc in ipairs(proj.Scenes) do
			if sc.Id == p.sceneId then
				table.remove(proj.Scenes, i)
				local tl = {}
				for _, e in ipairs(proj.Edit.Timeline) do
					if not (e.k == "s" and e.id == p.sceneId) then
						tl[#tl + 1] = e
					end
				end
				proj.Edit.Timeline = tl
				proj.Export = nil
				return true, "Escena eliminada."
			end
		end
		return false, "Escena no encontrada."
	end)

	Net.on("Photo.Take", Video.takePhoto)
	Net.on("Photo.Delete", function(player, p)
		local data = S.Data.get(player)
		for i, ph in ipairs(data.Photos) do
			if ph.Id == p.id then
				table.remove(data.Photos, i)
				return true, "Foto eliminada."
			end
		end
		return false, "Foto no encontrada."
	end)
	Net.on("Photo.SetAlbum", function(player, p)
		local data = S.Data.get(player)
		if not Util.indexOf(data.Albums, p.album) then
			return false, "Álbum no válido."
		end
		for _, ph in ipairs(data.Photos) do
			if ph.Id == p.id then
				ph.Album = p.album
				return true, "Foto movida a «" .. p.album .. "»."
			end
		end
		return false, "Foto no encontrada."
	end)
	Net.on("Photo.CreateAlbum", function(player, p)
		local data = S.Data.get(player)
		local name = Util.cleanText(p.name, 20)
		if not name or #name == 0 or #data.Albums >= 10 or Util.indexOf(data.Albums, name) then
			return false, "Nombre no válido o demasiados álbumes."
		end
		name = S.Text.filter(player, name)
		if not name then
			return false, "Nombre no permitido."
		end
		table.insert(data.Albums, name)
		return true, "Álbum creado."
	end)

	Net.on("Video.Import", function(player, p)
		local proj = getProject(player, p.pid)
		if not proj then
			return false, "Proyecto no encontrado."
		end
		if not S.Computer.hasSession(player) then
			return false, "Importa el material desde un computador o un portátil."
		end
		local stats = S.Computer.sessionStats(player)
		local used = S.Computer.storageUsed(player)
		local need = 0
		local count = 0
		for _, sc in ipairs(proj.Scenes) do
			if not sc.Imp then
				need = need + sc.Gb
				count = count + 1
			end
		end
		if count == 0 then
			return false, "No hay material nuevo que importar."
		end
		if used + need > stats.StorageGb then
			return false, "Sin espacio: necesitas " .. math.ceil(need) .. " GB y quedan " .. math.floor(stats.StorageGb - used) .. " GB. Publica proyectos, borra escenas o compra almacenamiento."
		end
		for _, sc in ipairs(proj.Scenes) do
			sc.Imp = true
		end
		if proj.Status == "recording" or proj.Status == "planning" then
			proj.Status = "editing"
		end
		return true, count .. " escenas importadas (" .. math.ceil(need) .. " GB)."
	end)

	Net.on("Video.SaveEdit", function(player, p)
		local data = S.Data.get(player)
		local proj = getProject(player, p.pid)
		if not proj then
			return false, "Proyecto no encontrado."
		end
		local ok, stats = canEdit(player)
		if not ok then
			return false, "Necesitas un computador, un portátil o una tableta Pro para editar."
		end
		local edit, err = validEdit(proj, data, p.edit, math.min(stats.MaxScenes, Config.MaxScenesPerProject))
		if not edit then
			return false, err
		end
		proj.Edit = edit
		proj.Export = nil
		proj.Status = "editing"
		local res = Video.evaluate(player, proj, stats)
		S.Quest.tutorialEvent(player, "save_edit")
		return true, "Proyecto guardado. Calidad estimada " .. math.floor(res.Final) .. "/100.", { eval = res }
	end)

	Net.on("Video.Evaluate", function(player, p)
		local proj = getProject(player, p.pid)
		if not proj then
			return false, "Proyecto no encontrado."
		end
		local _, stats = canEdit(player)
		return true, nil, { eval = Video.evaluate(player, proj, stats) }
	end)

	Net.on("Video.SaveVersion", function(player, p)
		local proj = getProject(player, p.pid)
		if not proj then
			return false, "Proyecto no encontrado."
		end
		local label = Util.cleanText(p.label or "", 24) or ""
		if #label == 0 then
			label = "Versión " .. (#proj.Versions + 1)
		end
		table.insert(proj.Versions, 1, { Label = label, T = os.time(), Edit = Util.deepCopy(proj.Edit) })
		while #proj.Versions > Config.MaxVersionsPerProject do
			table.remove(proj.Versions)
		end
		return true, "Versión «" .. label .. "» guardada."
	end)

	Net.on("Video.RestoreVersion", function(player, p)
		local proj = getProject(player, p.pid)
		local idx = tonumber(p.index)
		if not proj or not idx or not proj.Versions[idx] then
			return false, "Versión no encontrada."
		end
		proj.Edit = Util.deepCopy(proj.Versions[idx].Edit)
		proj.Export = nil
		return true, "Versión restaurada."
	end)

	Net.on("Video.Export", function(player, p)
		local data = S.Data.get(player)
		local proj = getProject(player, p.pid)
		if not proj then
			return false, "Proyecto no encontrado."
		end
		if not S.Computer.hasSession(player) then
			return false, "Exporta desde un computador o un portátil."
		end
		if #proj.Edit.Timeline == 0 then
			return false, "La línea de tiempo está vacía."
		end
		if proj.Export and proj.Export.ReadyAt and os.time() < proj.Export.ReadyAt then
			return false, "Ya se está exportando."
		end
		local stats = S.Computer.sessionStats(player)
		local res, cx = Video.evaluate(player, proj, stats)
		local secs = math.floor(F.exportSeconds(cx, stats, stats.EditSpeed, stats.Comfort) * (S.Needs and S.Needs.exportMult(player) or 1) + 0.5)
		if p.useToken and data.ExportTokens > 0 then
			data.ExportTokens = data.ExportTokens - 1
			secs = 1
		end
		proj.Export = { Started = os.time(), ReadyAt = os.time() + secs, Secs = secs, Res = res }
		proj.Status = "exported"
		data.Counters.exports = (data.Counters.exports or 0) + 1
		S.Progress.addXp(player, S.Progress.Xp.Export)
		S.Quest.check(player)
		return true, "Exportando... tiempo estimado " .. secs .. " s (" .. stats.TierName .. ").", { secs = secs, readyAt = proj.Export.ReadyAt, eval = res }
	end)

	Net.on("Thumb.Save", function(player, p)
		local data = S.Data.get(player)
		local _, _, tab = S.Inventory.best(player, "tablet", "backpack")
		if not S.Computer.hasSession(player) and not tab then
			return false, "Diseña miniaturas en un computador o con una tableta en la mochila."
		end
		local d = type(p.design) == "table" and p.design or {}
		local text = Util.cleanText(d.text or "", 40) or ""
		local fText = S.Text.filter(player, text)
		if not fText then
			return false, "No se pudo comprobar el texto."
		end
		local design = {
			text = fText,
			font = VideoData.FontById[d.font or ""] and d.font or "GothamBlack",
			textColor = math.floor(num(d.textColor, 1, #VideoData.Palette) or 1),
			bg = math.floor(num(d.bg, 1, #VideoData.Palette) or 2),
			outline = d.outline == true,
			frame = "none",
			template = VideoData.ThumbTemplateById[d.template or ""] and d.template or "center",
			stickers = {},
			photoId = nil,
			textSize = num(d.textSize, 0.5, 1.5) or 1,
		}
		for _, f in ipairs(VideoData.Frames) do
			if f.Id == d.frame then
				design.frame = f.Id
			end
		end
		if type(d.stickers) == "table" then
			for i = 1, math.min(6, #d.stickers) do
				for _, st in ipairs(VideoData.Stickers) do
					if st.Id == d.stickers[i] then
						table.insert(design.stickers, st.Id)
					end
				end
			end
		end
		local photo = nil
		if type(d.photoId) == "string" then
			for _, ph in ipairs(data.Photos) do
				if ph.Id == d.photoId then
					photo = ph
				end
			end
			if not photo then
				return false, "La foto elegida no existe."
			end
			design.photoId = photo.Id
			design.photoCam = photo.Cam
			design.photoFilter = photo.Filter
			design.photoSpot = photo.SpotName
		end
		local proj = getProject(player, p.pid)
		local cat = proj and VideoData.CategoryById[proj.Category] or nil
		local kw = proj and F.categoryKeyword(proj.Category) or nil
		local score = F.thumbnail(design, {
			photoQuality = photo and photo.Q or nil,
			photoMatches = photo and cat and F.overlap(photo.Tags, cat.Tags) > 0 or false,
			keywordInText = kw ~= nil and fText:lower():find(kw, 1, true) ~= nil,
		})
		if Util.count(data.Thumbnails) >= Config.MaxThumbnails then
			-- eliminar la más antigua
			local oldestId, oldestT = nil, math.huge
			for id, t in pairs(data.Thumbnails) do
				if t.T < oldestT then
					oldestId, oldestT = id, t.T
				end
			end
			data.Thumbnails[oldestId] = nil
		end
		data.Counters.thumb_id = (data.Counters.thumb_id or 0) + 1
		local tid = "t" .. data.Counters.thumb_id
		data.Thumbnails[tid] = { Id = tid, Design = design, Score = score.Score, Read = score.Readability, Comp = score.Composition, Rel = score.Relevance, Details = score.Details, Pid = proj and proj.Id or nil, T = os.time() }
		if proj then
			proj.ThumbId = tid
		end
		data.Counters.thumbnails = (data.Counters.thumbnails or 0) + 1
		S.Jobs.onThumb(player, design, score.Score)
		S.Progress.addXp(player, S.Progress.Xp.Thumbnail)
		S.Quest.tutorialEvent(player, "thumbnail")
		S.Quest.check(player)
		return true, "Miniatura guardada: " .. math.floor(score.Score) .. "/100.", { thumbId = tid, score = score }
	end)

	Net.on("Thumb.Delete", function(player, p)
		local data = S.Data.get(player)
		if type(p.id) ~= "string" or not data.Thumbnails[p.id] then
			return false, "Miniatura no encontrada."
		end
		data.Thumbnails[p.id] = nil
		return true, "Miniatura eliminada."
	end)

	Net.on("Video.Publish", Video.publish)

	Players.PlayerRemoving:Connect(function(player)
		recording[player] = nil
		lastPhoto[player] = nil
	end)
end

function Video.isRecording(player)
	return recording[player] ~= nil
end

return Video
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000047"><Properties><string name="Name">WorldBuilder</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- WorldBuilder: construye la ciudad con Parts a partir de WorldData al arrancar el servidor.
--  * 30 distritos con suelo, aceras, calles, línea central, semáforos, farolas, señales y edificios con estilo propio.
--  * Edificios importantes con interior funcional: Residencia Económica (12 habitaciones), 4 tiendas,
--    cibercafé, banco y sala VIP.
--  * Lugares de grabación 🎥, paradas de taxi, bancos de parque, coches aparcados, árboles, agua, montañas.
-- Todo es anclado y reutiliza las mismas funciones, así que añadir distritos solo requiere editar WorldData.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CollectionService = game:GetService("CollectionService")
local Shared = ReplicatedStorage.Shared
local WorldData = require(Shared.WorldData)
local Catalog = require(Shared.ItemCatalog)
local Util = require(Shared.Util)
local PropertyData = require(Shared.PropertyData)

local World = {}
local S
local city

World.Specials = WorldData.Specials
World.SpotById = WorldData.SpotById
World.HomeRooms = {}
World.NpcPoints = {}
World.TrafficLights = {}
World.VendingMachines = {}

local CELL = WorldData.CellSize
local ROAD = WorldData.RoadWidth
local GROUND_TOP = 0.5

function World.Init(services)
	S = services
end

---------------------------------------------------------------------------
-- Utilidades de construcción
---------------------------------------------------------------------------
local function rgb(t)
	return Color3.fromRGB(t[1], t[2], t[3])
end

local function P(parent, name, size, cf, color, material, opts)
	local p = Instance.new(opts and opts.Class or "Part")
	p.Name = name
	p.Anchored = true
	p.Size = size
	p.CFrame = typeof(cf) == "Vector3" and CFrame.new(cf) or cf
	p.Color = typeof(color) == "Color3" and color or rgb(color)
	p.Material = material or Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if opts then
		if opts.Shape then
			p.Shape = opts.Shape
		end
		if opts.Transparency then
			p.Transparency = opts.Transparency
		end
		if opts.NoCollide then
			p.CanCollide = false
		end
		if opts.NoShadow then
			p.CastShadow = false
		end
	end
	p.Parent = parent
	return p
end

local function folder(parent, name)
	local f = Instance.new("Folder")
	f.Name = name
	f.Parent = parent
	return f
end

local function model(parent, name)
	local m = Instance.new("Model")
	m.Name = name
	m.Parent = parent
	return m
end

local function sign(part, face, text, bg, fg, font)
	local gui = Instance.new("SurfaceGui")
	gui.Face = face or Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 30
	gui.Parent = part
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundColor3 = bg or Color3.fromRGB(20, 20, 24)
	label.BackgroundTransparency = bg and 0 or 1
	label.TextColor3 = fg or Color3.new(1, 1, 1)
	label.Font = font or Enum.Font.GothamBlack
	label.TextScaled = true
	label.Text = text
	label.Parent = gui
	return label
end

local function prompt(part, action, actionText, objectText, attrs)
	local pp = Instance.new("ProximityPrompt")
	pp.ActionText = actionText
	pp.ObjectText = objectText or ""
	pp.HoldDuration = 0
	pp.MaxActivationDistance = 10
	pp.RequiresLineOfSight = false
	pp:SetAttribute("Action", action)
	for k, v in pairs(attrs or {}) do
		pp:SetAttribute(k, v)
	end
	pp.Parent = part
	CollectionService:AddTag(pp, "YTPrompt")
	return pp
end

local function nightLight(part, range, color)
	local l = Instance.new("PointLight")
	l.Range = range or 24
	l.Brightness = 1.4
	l.Color = color or Color3.fromRGB(255, 220, 160)
	l.Enabled = false
	l.Parent = part
	CollectionService:AddTag(part, "NightLight")
	return l
end

local function tree(parent, x, z, scale, rng)
	scale = scale or 1
	local h = (10 + rng:NextNumber() * 6) * scale
	P(parent, "Trunk", Vector3.new(h, 1.6 * scale, 1.6 * scale), CFrame.new(x, GROUND_TOP + h / 2, z) * CFrame.Angles(0, 0, math.rad(90)),
		{ 110, 80, 55 }, Enum.Material.Wood, { Shape = Enum.PartType.Cylinder })
	local leaf = { 60 + rng:NextInteger(0, 30), 130 + rng:NextInteger(0, 40), 60 }
	P(parent, "Leaves", Vector3.new(9, 9, 9) * scale, Vector3.new(x, GROUND_TOP + h + 2 * scale, z), leaf, Enum.Material.Grass,
		{ Shape = Enum.PartType.Ball, NoShadow = false })
end

local function bench(parent, x, z, rotY)
	local cf = CFrame.new(x, GROUND_TOP, z) * CFrame.Angles(0, rotY or 0, 0)
	P(parent, "BenchSeat", Vector3.new(6, 0.5, 2), cf * CFrame.new(0, 1.6, 0), { 140, 100, 60 }, Enum.Material.WoodPlanks)
	P(parent, "BenchBack", Vector3.new(6, 1.6, 0.4), cf * CFrame.new(0, 2.6, -0.9), { 140, 100, 60 }, Enum.Material.WoodPlanks)
	P(parent, "BenchLeg", Vector3.new(0.4, 1.4, 1.8), cf * CFrame.new(-2.6, 0.7, 0), { 50, 50, 55 }, Enum.Material.Metal)
	P(parent, "BenchLeg", Vector3.new(0.4, 1.4, 1.8), cf * CFrame.new(2.6, 0.7, 0), { 50, 50, 55 }, Enum.Material.Metal)
end

local function car(parent, x, z, color, rotY)
	local m = model(parent, "ParkedCar")
	local cf = CFrame.new(x, GROUND_TOP, z) * CFrame.Angles(0, rotY or 0, 0)
	P(m, "Body", Vector3.new(6, 2, 12), cf * CFrame.new(0, 1.8, 0), color, Enum.Material.SmoothPlastic)
	P(m, "Cabin", Vector3.new(5.6, 1.8, 6), cf * CFrame.new(0, 3.6, -0.5), { 40, 50, 60 }, Enum.Material.Glass, { Transparency = 0.2 })
	for _, w in ipairs({ { -3, 3.8 }, { 3, 3.8 }, { -3, -3.8 }, { 3, -3.8 } }) do
		P(m, "Wheel", Vector3.new(1.2, 2.2, 2.2), cf * CFrame.new(w[1], 1.1, w[2]), { 20, 20, 20 }, Enum.Material.SmoothPlastic, { Shape = Enum.PartType.Cylinder })
	end
	return m
end

local function streetLamp(parent, x, z)
	P(parent, "LampPole", Vector3.new(0.6, 14, 0.6), Vector3.new(x, GROUND_TOP + 7, z), { 60, 60, 66 }, Enum.Material.Metal)
	local head = P(parent, "LampHead", Vector3.new(1.6, 0.8, 1.6), Vector3.new(x, GROUND_TOP + 14.2, z), { 255, 240, 200 }, Enum.Material.Neon, { NoShadow = true })
	nightLight(head, 30)
end

---------------------------------------------------------------------------
-- Edificios genéricos por estilo
---------------------------------------------------------------------------
local shopNames = { "Panadería", "Café Central", "Moda Urbana", "Zapatería", "Librería", "Papelería", "Deportes", "Bicicletas",
	"Electrodomésticos", "Mascotas", "Jardinería", "Viajes", "Coleccionables", "Herramientas", "Juegos", "Instrumentos", "Supermercado", "Floristería" }
local foodNames = { "Pizzería Napoli", "Sushi Zen", "Tacos El Sol", "Hamburguesas 24", "Paella & Co.", "Ramen Nube", "Asador Brasa", "Heladería Polar", "Crepes París", "Arepas Doña Ana" }

local function windowBands(parent, cf, w, h, d, rng)
	local floors = math.min(10, math.floor(h / 10))
	for i = 1, floors do
		local y = -h / 2 + i * (h / (floors + 1))
		local band = P(parent, "Windows", Vector3.new(w + 0.3, 2.6, d + 0.3), cf * CFrame.new(0, y, 0), { 40, 60, 90 }, Enum.Material.Glass,
			{ Transparency = 0.1, NoShadow = true })
		band:SetAttribute("GlowNight", rng:NextNumber() < 0.7)
		band.Color = Color3.fromRGB(255, 225, 150)
		band.Material = Enum.Material.Glass
		CollectionService:AddTag(band, "NightLight")
	end
end

local styleBuilders = {}

styleBuilders.tower = function(parent, x, z, d, rng)
	local w, dd = rng:NextInteger(30, 42), rng:NextInteger(30, 42)
	local h = rng:NextInteger(60, 140)
	local cf = CFrame.new(x, GROUND_TOP + h / 2, z)
	local color = d.Palette[rng:NextInteger(1, #d.Palette)]
	P(parent, "Tower", Vector3.new(w, h, dd), cf, color, Enum.Material.Concrete)
	windowBands(parent, cf, w, h, dd, rng)
	if d.Neon then
		P(parent, "Crown", Vector3.new(w + 1, 1, dd + 1), cf * CFrame.new(0, h / 2 + 0.5, 0), d.Neon, Enum.Material.Neon, { NoShadow = true })
	end
end
styleBuilders.office = function(parent, x, z, d, rng)
	local w, dd, h = rng:NextInteger(34, 46), rng:NextInteger(28, 38), rng:NextInteger(28, 60)
	local cf = CFrame.new(x, GROUND_TOP + h / 2, z)
	P(parent, "Office", Vector3.new(w, h, dd), cf, d.Palette[rng:NextInteger(1, #d.Palette)], Enum.Material.Concrete)
	windowBands(parent, cf, w, h, dd, rng)
	P(parent, "Entrance", Vector3.new(8, 8, 1), cf * CFrame.new(0, -h / 2 + 4, dd / 2 + 0.5), { 30, 40, 50 }, Enum.Material.Glass, { Transparency = 0.3 })
end
styleBuilders.apartment = function(parent, x, z, d, rng)
	local w, dd, h = rng:NextInteger(36, 44), rng:NextInteger(26, 32), rng:NextInteger(30, 54)
	local cf = CFrame.new(x, GROUND_TOP + h / 2, z)
	P(parent, "Apartments", Vector3.new(w, h, dd), cf, d.Palette[rng:NextInteger(1, #d.Palette)], Enum.Material.Brick)
	windowBands(parent, cf, w, h, dd, rng)
	for i = 1, math.floor(h / 10) do
		P(parent, "Balcony", Vector3.new(w - 6, 0.6, 3), cf * CFrame.new(0, -h / 2 + i * 10, dd / 2 + 1.5), { 220, 220, 220 }, Enum.Material.Concrete)
	end
end
styleBuilders.house = function(parent, x, z, d, rng)
	local w, dd, h = rng:NextInteger(18, 24), rng:NextInteger(16, 22), 11
	local base = CFrame.new(x, GROUND_TOP, z)
	local color = d.Palette[rng:NextInteger(1, #d.Palette)]
	P(parent, "House", Vector3.new(w, h, dd), base * CFrame.new(0, h / 2, 0), color, Enum.Material.Plaster)
	local roofColor = { 150, 60, 50 }
	P(parent, "Roof", Vector3.new(w + 1, 5, dd / 2 + 0.5), base * CFrame.new(0, h + 2.5, dd / 4 + 0.25), roofColor, Enum.Material.Slate, { Class = "WedgePart" })
	P(parent, "Roof", Vector3.new(w + 1, 5, dd / 2 + 0.5), base * CFrame.new(0, h + 2.5, -dd / 4 - 0.25) * CFrame.Angles(0, math.pi, 0), roofColor, Enum.Material.Slate, { Class = "WedgePart" })
	P(parent, "Door", Vector3.new(4, 7, 0.4), base * CFrame.new(0, 3.5, dd / 2 + 0.2), { 90, 60, 40 }, Enum.Material.Wood)
	local win = P(parent, "Window", Vector3.new(4, 3, 0.4), base * CFrame.new(-w / 4 - 1, 6, dd / 2 + 0.2), { 255, 225, 150 }, Enum.Material.Glass)
	win:SetAttribute("GlowNight", true)
	CollectionService:AddTag(win, "NightLight")
	P(parent, "Fence", Vector3.new(w + 6, 2.5, 0.4), base * CFrame.new(0, 1.25, dd / 2 + 6), { 245, 245, 245 }, Enum.Material.WoodPlanks)
end
styleBuilders.mansion = function(parent, x, z, d, rng)
	local w, dd, h = 44, 30, 18
	local base = CFrame.new(x, GROUND_TOP, z)
	P(parent, "Mansion", Vector3.new(w, h, dd), base * CFrame.new(0, h / 2, 0), d.Palette[rng:NextInteger(1, #d.Palette)], Enum.Material.Marble)
	P(parent, "RoofTop", Vector3.new(w + 2, 1, dd + 2), base * CFrame.new(0, h + 0.5, 0), { 60, 60, 70 }, Enum.Material.Slate)
	for i = -2, 2 do
		P(parent, "Column", Vector3.new(h, 1.6, 1.6), base * CFrame.new(i * 8, h / 2, dd / 2 + 3) * CFrame.Angles(0, 0, math.rad(90)), { 250, 250, 245 }, Enum.Material.Marble, { Shape = Enum.PartType.Cylinder })
	end
	local pool = P(parent, "Pool", Vector3.new(20, 0.6, 10), base * CFrame.new(0, 0.4, dd / 2 + 14), { 60, 180, 230 }, Enum.Material.Glass, { Transparency = 0.25 })
	pool.CanCollide = false
	windowBands(parent, base * CFrame.new(0, h / 2, 0), w, h, dd, rng)
end
styleBuilders.shop = function(parent, x, z, d, rng)
	local w, dd, h = rng:NextInteger(26, 34), 22, rng:NextInteger(12, 18)
	local base = CFrame.new(x, GROUND_TOP, z)
	P(parent, "Shop", Vector3.new(w, h, dd), base * CFrame.new(0, h / 2, 0), d.Palette[rng:NextInteger(1, #d.Palette)], Enum.Material.Brick)
	local glass = P(parent, "ShopWindow", Vector3.new(w - 4, 7, 0.4), base * CFrame.new(0, 4.5, dd / 2 + 0.2), { 255, 230, 170 }, Enum.Material.Glass, { Transparency = 0.2 })
	glass:SetAttribute("GlowNight", true)
	CollectionService:AddTag(glass, "NightLight")
	local awningColor = ({ { 220, 60, 60 }, { 40, 140, 90 }, { 40, 90, 180 }, { 230, 160, 30 } })[rng:NextInteger(1, 4)]
	P(parent, "Awning", Vector3.new(w, 1.5, 4), base * CFrame.new(0, 9, dd / 2 + 2), awningColor, Enum.Material.Fabric, { Class = "WedgePart" })
	local list = Util.indexOf(d.Tags, "food") and foodNames or shopNames
	local board = P(parent, "Sign", Vector3.new(w - 6, 2.4, 0.4), base * CFrame.new(0, h - 2, dd / 2 + 0.3), { 20, 20, 24 }, Enum.Material.SmoothPlastic)
	sign(board, Enum.NormalId.Front, list[rng:NextInteger(1, #list)], nil, Color3.new(1, 1, 1), Enum.Font.FredokaOne)
end
styleBuilders.warehouse = function(parent, x, z, d, rng)
	local w, dd, h = rng:NextInteger(44, 56), rng:NextInteger(34, 44), rng:NextInteger(16, 22)
	local base = CFrame.new(x, GROUND_TOP, z)
	P(parent, "Warehouse", Vector3.new(w, h, dd), base * CFrame.new(0, h / 2, 0), d.Palette[rng:NextInteger(1, #d.Palette)], Enum.Material.CorrodedMetal)
	P(parent, "BigDoor", Vector3.new(16, 12, 0.4), base * CFrame.new(0, 6, dd / 2 + 0.2), { 70, 70, 75 }, Enum.Material.DiamondPlate)
	if d.Neon then
		P(parent, "NeonStrip", Vector3.new(w, 0.6, 0.4), base * CFrame.new(0, h - 1, dd / 2 + 0.3), d.Neon, Enum.Material.Neon, { NoShadow = true })
	end
end
styleBuilders.cabin = function(parent, x, z, d, rng)
	local base = CFrame.new(x, GROUND_TOP, z)
	P(parent, "Cabin", Vector3.new(16, 9, 14), base * CFrame.new(0, 4.5, 0), d.Palette[1] or { 120, 80, 50 }, Enum.Material.WoodPlanks)
	P(parent, "Roof", Vector3.new(17, 4, 7.5), base * CFrame.new(0, 11, 3.5), { 70, 50, 40 }, Enum.Material.Wood, { Class = "WedgePart" })
	P(parent, "Roof", Vector3.new(17, 4, 7.5), base * CFrame.new(0, 11, -3.5) * CFrame.Angles(0, math.pi, 0), { 70, 50, 40 }, Enum.Material.Wood, { Class = "WedgePart" })
end
styleBuilders.tent = function(parent, x, z, d, rng)
	local c = d.Palette[rng:NextInteger(1, #d.Palette)]
	local base = CFrame.new(x, GROUND_TOP, z) * CFrame.Angles(0, rng:NextNumber() * math.pi, 0)
	P(parent, "Tent", Vector3.new(8, 5, 4), base * CFrame.new(0, 2.5, 2), c, Enum.Material.Fabric, { Class = "WedgePart" })
	P(parent, "Tent", Vector3.new(8, 5, 4), base * CFrame.new(0, 2.5, -2) * CFrame.Angles(0, math.pi, 0), c, Enum.Material.Fabric, { Class = "WedgePart" })
end
styleBuilders.hotel = function(parent, x, z, d, rng)
	local w, dd, h = 40, 36, rng:NextInteger(60, 90)
	local cf = CFrame.new(x, GROUND_TOP + h / 2, z)
	P(parent, "Hotel", Vector3.new(w, h, dd), cf, d.Palette[rng:NextInteger(1, #d.Palette)], Enum.Material.Concrete)
	windowBands(parent, cf, w, h, dd, rng)
	local board = P(parent, "HotelSign", Vector3.new(20, 4, 0.5), cf * CFrame.new(0, h / 2 - 4, dd / 2 + 0.4), { 30, 30, 40 }, Enum.Material.SmoothPlastic)
	sign(board, Enum.NormalId.Front, "HOTEL ✦", nil, Color3.fromRGB(255, 214, 120))
end
styleBuilders.kiosk = function(parent, x, z, d, rng)
	local base = CFrame.new(x, GROUND_TOP, z)
	P(parent, "Kiosk", Vector3.new(10, 7, 8), base * CFrame.new(0, 3.5, 0), d.Palette[rng:NextInteger(1, #d.Palette)], Enum.Material.WoodPlanks)
	P(parent, "Umbrella", Vector3.new(0.6, 10, 10), base * CFrame.new(10, 8, 0) * CFrame.Angles(0, 0, math.rad(90)), { 255, 90, 90 }, Enum.Material.Fabric, { Shape = Enum.PartType.Cylinder })
	P(parent, "Pole", Vector3.new(0.4, 8, 0.4), base * CFrame.new(10, 4, 0), { 240, 240, 240 }, Enum.Material.Metal)
end
styleBuilders.containers = function(parent, x, z, d, rng)
	local base = CFrame.new(x, GROUND_TOP, z)
	for i = 0, rng:NextInteger(1, 3) do
		P(parent, "Container", Vector3.new(10, 9, 24), base * CFrame.new(0, 4.5 + i * 9, 0), d.Palette[rng:NextInteger(1, #d.Palette)], Enum.Material.CorrodedMetal)
	end
end
styleBuilders.showroom = function(parent, x, z, d, rng)
	local base = CFrame.new(x, GROUND_TOP, z)
	P(parent, "ShowroomFloor", Vector3.new(44, 0.4, 30), base * CFrame.new(0, 0.2, 0), { 235, 235, 240 }, Enum.Material.Marble)
	P(parent, "ShowroomRoof", Vector3.new(44, 1, 30), base * CFrame.new(0, 14, 0), { 40, 40, 45 }, Enum.Material.Metal)
	for _, cx in ipairs({ -20, 20 }) do
		for _, cz in ipairs({ -13, 13 }) do
			P(parent, "Pillar", Vector3.new(1, 14, 1), base * CFrame.new(cx, 7, cz), { 200, 200, 210 }, Enum.Material.Metal)
		end
	end
	car(parent, x - 10, z, { 220, 30, 40 }, 0.4)
	car(parent, x + 10, z, { 20, 20, 25 }, -0.4)
end
styleBuilders.arena = function(parent, x, z, d, rng)
	local base = CFrame.new(x, GROUND_TOP, z)
	P(parent, "Stage", Vector3.new(50, 3, 24), base * CFrame.new(0, 1.5, -40), { 30, 30, 36 }, Enum.Material.Wood)
	P(parent, "StageBack", Vector3.new(50, 24, 2), base * CFrame.new(0, 13, -52), { 20, 20, 26 }, Enum.Material.SmoothPlastic)
	local screen = P(parent, "Screen", Vector3.new(30, 14, 0.4), base * CFrame.new(0, 14, -50.8), { 255, 60, 200 }, Enum.Material.Neon, { NoShadow = true })
	sign(screen, Enum.NormalId.Front, "FESTIVAL DE CREADORES", Color3.fromRGB(40, 0, 70), Color3.fromRGB(255, 220, 255))
	for i = 1, 4 do
		P(parent, "Bleacher", Vector3.new(60, 2 * i, 4), base * CFrame.new(0, i, 10 + i * 4), { 120, 120, 130 }, Enum.Material.Concrete)
	end
end
styleBuilders.rides = function(parent, x, z, d, rng)
	local base = CFrame.new(x, GROUND_TOP, z)
	local wheel = model(parent, "FerrisWheel")
	local hub = P(wheel, "Hub", Vector3.new(4, 4, 4), base * CFrame.new(0, 34, 0), { 240, 240, 240 }, Enum.Material.Metal, { Shape = Enum.PartType.Ball })
	for i = 1, 12 do
		local a = i / 12 * math.pi * 2
		P(wheel, "Spoke", Vector3.new(0.6, 30, 0.6), hub.CFrame * CFrame.Angles(0, 0, a) * CFrame.new(0, 15, 0), { 255, 80, 80 }, Enum.Material.Metal)
		P(wheel, "Cabin", Vector3.new(4, 4, 4), hub.CFrame * CFrame.Angles(0, 0, a) * CFrame.new(0, 30, 0), d.Palette[(i % #d.Palette) + 1], Enum.Material.SmoothPlastic)
	end
	wheel.PrimaryPart = hub
	CollectionService:AddTag(wheel, "Spin")
	P(parent, "Support", Vector3.new(2, 36, 2), base * CFrame.new(-6, 17, 0) * CFrame.Angles(0, 0, math.rad(10)), { 200, 200, 210 }, Enum.Material.Metal)
	P(parent, "Support", Vector3.new(2, 36, 2), base * CFrame.new(6, 17, 0) * CFrame.Angles(0, 0, math.rad(-10)), { 200, 200, 210 }, Enum.Material.Metal)
end
styleBuilders.none = function() end

---------------------------------------------------------------------------
-- Interiores especiales
---------------------------------------------------------------------------
local function shell(parent, cx, cz, w, d, h, wallColor, floorColor, doorSide)
	-- doorSide: "S" (+Z) por defecto; hueco de puerta de 8 studs
	local base = CFrame.new(cx, GROUND_TOP, cz)
	P(parent, "Floor", Vector3.new(w, 0.6, d), base * CFrame.new(0, 0.3, 0), floorColor, Enum.Material.WoodPlanks)
	P(parent, "Roof", Vector3.new(w + 1, 1, d + 1), base * CFrame.new(0, h + 0.5, 0), { 60, 60, 66 }, Enum.Material.Concrete)
	P(parent, "WallN", Vector3.new(w, h, 1), base * CFrame.new(0, h / 2, -d / 2), wallColor, Enum.Material.Concrete)
	P(parent, "WallW", Vector3.new(1, h, d), base * CFrame.new(-w / 2, h / 2, 0), wallColor, Enum.Material.Concrete)
	P(parent, "WallE", Vector3.new(1, h, d), base * CFrame.new(w / 2, h / 2, 0), wallColor, Enum.Material.Concrete)
	local side = (w - 10) / 2
	P(parent, "WallS", Vector3.new(side, h, 1), base * CFrame.new(-w / 2 + side / 2, h / 2, d / 2), wallColor, Enum.Material.Concrete)
	P(parent, "WallS", Vector3.new(side, h, 1), base * CFrame.new(w / 2 - side / 2, h / 2, d / 2), wallColor, Enum.Material.Concrete)
	P(parent, "WallS", Vector3.new(10, h - 9, 1), base * CFrame.new(0, 9 + (h - 9) / 2, d / 2), wallColor, Enum.Material.Concrete)
	for _, lx in ipairs({ -w / 4, w / 4 }) do
		local lamp = P(parent, "CeilingLamp", Vector3.new(4, 0.4, 4), base * CFrame.new(lx, h - 0.3, 0), { 255, 250, 230 }, Enum.Material.Neon, { NoShadow = true })
		local l = Instance.new("PointLight")
		l.Range = 30
		l.Brightness = 1.2
		l.Parent = lamp
	end
	return base
end

-- Modelo de exposición de un objeto del catálogo
local function displayModel(parent, def, cf)
	local c = rgb(def.Color)
	local shape = def.Shape
	if shape == "monitor" then
		P(parent, "Display", Vector3.new(3.4, 2.2, 0.3), cf * CFrame.new(0, 1.4, 0), { 20, 20, 24 })
		P(parent, "DisplayScreen", Vector3.new(3.1, 1.9, 0.05), cf * CFrame.new(0, 1.4, 0.18), { 70, 140, 255 }, Enum.Material.Neon, { NoShadow = true })
	elseif shape == "tower" then
		local t = P(parent, "Display", Vector3.new(1.4, 3, 2.8), cf * CFrame.new(0, 1.5, 0), c)
		if def.Id == "pc_gamer" or def.Id == "pc_lux" then
			t.Material = Enum.Material.Glass
			t.Transparency = 0.25
			P(parent, "RGB", Vector3.new(1, 0.3, 2.4), cf * CFrame.new(0, 2.6, 0), { 200, 80, 255 }, Enum.Material.Neon, { NoShadow = true })
		end
	elseif shape == "camera" then
		P(parent, "Display", Vector3.new(1.6, 1.1, 0.9), cf * CFrame.new(0, 0.7, 0), { 25, 25, 28 })
		P(parent, "Lens", Vector3.new(0.9, 0.8, 0.8), cf * CFrame.new(0, 0.7, 0.8) * CFrame.Angles(0, math.rad(90), 0), { 40, 40, 45 }, Enum.Material.Metal, { Shape = Enum.PartType.Cylinder })
	elseif shape == "phone" then
		P(parent, "Display", Vector3.new(0.9, 1.7, 0.15), cf * CFrame.new(0, 1, 0) * CFrame.Angles(math.rad(-15), 0, 0), { 20, 20, 24 })
	elseif shape == "laptop" then
		P(parent, "Display", Vector3.new(2.6, 0.15, 1.8), cf * CFrame.new(0, 0.2, 0), { 160, 165, 175 }, Enum.Material.Metal)
		P(parent, "LaptopScreen", Vector3.new(2.6, 1.7, 0.1), cf * CFrame.new(0, 1, -0.9) * CFrame.Angles(math.rad(-15), 0, 0), { 70, 140, 255 }, Enum.Material.Neon, { NoShadow = true })
	elseif shape == "mic" then
		P(parent, "Display", Vector3.new(0.6, 1.4, 0.6), cf * CFrame.new(0, 0.9, 0), { 30, 30, 34 }, Enum.Material.Metal)
		P(parent, "MicHead", Vector3.new(0.9, 0.9, 0.9), cf * CFrame.new(0, 1.8, 0), { 120, 120, 125 }, Enum.Material.DiamondPlate, { Shape = Enum.PartType.Ball })
	elseif shape == "light" then
		P(parent, "Display", Vector3.new(0.3, 2, 2), cf * CFrame.new(0, 1.4, 0), { 255, 255, 240 }, Enum.Material.Neon, { NoShadow = true })
	elseif shape == "tripod" then
		for i = 0, 2 do
			P(parent, "Leg", Vector3.new(0.15, 2.6, 0.15), cf * CFrame.Angles(0, i * 2.1, 0) * CFrame.new(0, 1.2, 0.4) * CFrame.Angles(math.rad(15), 0, 0), { 40, 40, 44 }, Enum.Material.Metal)
		end
	elseif shape == "chair" then
		P(parent, "Display", Vector3.new(2, 0.4, 2), cf * CFrame.new(0, 1, 0), c)
		P(parent, "Back", Vector3.new(2, 2.2, 0.3), cf * CFrame.new(0, 2.2, -0.9), c)
	elseif shape == "desk" then
		P(parent, "Display", Vector3.new(4, 0.3, 2), cf * CFrame.new(0, 1.6, 0), c, Enum.Material.WoodPlanks)
	else
		P(parent, "Display", Vector3.new(1.4, 1, 1.4), cf * CFrame.new(0, 0.6, 0), c)
	end
end

local function buildStore(parent, sp, rng)
	local store = Catalog.Stores[sp.StoreId]
	local m = model(parent, "Store_" .. store.Name)
	m:SetAttribute("StoreId", sp.StoreId)
	local w, d, h = 64, 46, 16
	local base = shell(m, sp.WX, sp.WZ, w, d, h, { 235, 235, 240 }, { 200, 200, 205 })
	local board = P(m, "StoreSign", Vector3.new(30, 4, 0.6), base * CFrame.new(0, h - 2.5, d / 2 + 0.6), { 20, 20, 24 })
	sign(board, Enum.NormalId.Front, store.Name, Color3.fromRGB(255, 40, 70), Color3.new(1, 1, 1))
	-- Mostrador y dependiente
	local counter = P(m, "Counter", Vector3.new(18, 4, 3), base * CFrame.new(0, 2, -d / 2 + 7), { 40, 40, 48 }, Enum.Material.Wood)
	prompt(counter, "store_catalog", "Ver catálogo completo", store.Name, { StoreId = sp.StoreId })
	table.insert(World.NpcPoints, { Pos = (base * CFrame.new(0, 0, -d / 2 + 4)).Position, Look = (base * CFrame.new(0, 0, 0)).Position, Name = "Dependiente de " .. store.Name, Role = "shopkeeper", Store = sp.StoreId })
	-- Expositores (8 productos variados de la tienda)
	local items = Catalog.list({ Store = sp.StoreId })
	local picks = {}
	local step = math.max(1, math.floor(#items / 8))
	for i = 1, #items, step do
		if #picks < 8 then
			picks[#picks + 1] = items[i]
		end
	end
	for i, def in ipairs(picks) do
		local col = (i - 1) % 4
		local row = math.floor((i - 1) / 4)
		local px = -21 + col * 14
		local pz = -2 + row * 12
		local pedestal = P(m, "Pedestal", Vector3.new(5, 3, 5), base * CFrame.new(px, 1.5, pz), { 250, 250, 252 }, Enum.Material.Marble)
		displayModel(m, def, base * CFrame.new(px, 3, pz))
		local tag = P(m, "PriceTag", Vector3.new(4.6, 1, 0.2), base * CFrame.new(px, 2.2, pz + 2.6), { 255, 214, 0 })
		sign(tag, Enum.NormalId.Front, "$" .. Util.formatInt(def.Price), nil, Color3.fromRGB(20, 20, 24))
		prompt(pedestal, "inspect", "Inspeccionar", def.Name, { ItemId = def.Id, StoreId = sp.StoreId })
	end
end

local function buildCafe(parent, sp)
	local m = model(parent, "Cibercafe")
	local w, d, h = 48, 36, 14
	local base = shell(m, sp.WX, sp.WZ, w, d, h, { 250, 230, 200 }, { 150, 110, 80 })
	local board = P(m, "CafeSign", Vector3.new(24, 3.5, 0.6), base * CFrame.new(0, h - 2.5, d / 2 + 0.6), { 20, 20, 24 })
	sign(board, Enum.NormalId.Front, "☕ " .. sp.Name, Color3.fromRGB(90, 50, 30), Color3.fromRGB(255, 230, 190))
	for i = 1, 4 do
		local x = -18 + (i - 1) * 12
		local desk = P(m, "PublicDesk", Vector3.new(7, 0.5, 3.5), base * CFrame.new(x, 3, -d / 2 + 4), { 120, 85, 60 }, Enum.Material.WoodPlanks)
		P(m, "PublicMonitor", Vector3.new(3, 2, 0.3), base * CFrame.new(x, 4.6, -d / 2 + 3), { 20, 20, 24 })
		P(m, "PublicScreen", Vector3.new(2.7, 1.7, 0.05), base * CFrame.new(x, 4.6, -d / 2 + 3.2), { 70, 140, 255 }, Enum.Material.Neon, { NoShadow = true })
		prompt(desk, "computer_public", "Usar computador público", "Cibercafé")
	end
	table.insert(World.NpcPoints, { Pos = (base * CFrame.new(14, 0, 8)).Position, Look = (base * CFrame.new(0, 0, 8)).Position, Name = "Barista", Role = "barista" })
	local bar = P(m, "CafeCounter", Vector3.new(10, 4, 3), base * CFrame.new(14, 2, 12), { 90, 60, 40 }, Enum.Material.Wood)
	prompt(bar, "cafe", "Pedir", "Cafetería")
end

local function buildRestaurant(parent, sp)
	local m = model(parent, "Restaurante")
	local w, d, h = 54, 40, 14
	local base = shell(m, sp.WX, sp.WZ, w, d, h, { 250, 235, 215 }, { 120, 70, 50 })
	local board = P(m, "RestaurantSign", Vector3.new(26, 3.5, 0.6), base * CFrame.new(0, h - 2.5, d / 2 + 0.6), { 20, 20, 24 })
	sign(board, Enum.NormalId.Front, "🍽 " .. sp.Name, Color3.fromRGB(130, 30, 30), Color3.fromRGB(255, 230, 190))
	for i = 0, 5 do
		local tx, tz = -16 + (i % 3) * 16, -2 + math.floor(i / 3) * 12
		P(m, "Table", Vector3.new(5, 0.4, 5), base * CFrame.new(tx, 3, tz), { 245, 245, 245 }, Enum.Material.Fabric)
		P(m, "TableLeg", Vector3.new(0.6, 3, 0.6), base * CFrame.new(tx, 1.5, tz), { 60, 40, 30 }, Enum.Material.Wood)
		for _, sx in ipairs({ -3.4, 3.4 }) do
			P(m, "Chair", Vector3.new(2, 2, 2), base * CFrame.new(tx + sx, 1.6, tz), { 140, 40, 40 }, Enum.Material.Fabric)
		end
	end
	local counter = P(m, "Counter", Vector3.new(16, 4, 3), base * CFrame.new(0, 2, -d / 2 + 6), { 90, 50, 35 }, Enum.Material.Wood)
	prompt(counter, "restaurant", "Ver menú", sp.Name)
	table.insert(World.NpcPoints, { Pos = (base * CFrame.new(0, 0, -d / 2 + 3)).Position, Look = (base * CFrame.new(0, 0, 0)).Position, Name = "Camarero", Role = "waiter" })
end

local function vending(parent, x, z)
	local mach = P(parent, "VendingMachine", Vector3.new(4, 7, 3), Vector3.new(x, GROUND_TOP + 3.5, z), { 200, 30, 50 }, Enum.Material.SmoothPlastic)
	P(parent, "VendingGlass", Vector3.new(2.6, 4, 0.2), Vector3.new(x, GROUND_TOP + 4.5, z + 1.55), { 180, 220, 255 }, Enum.Material.Glass, { Transparency = 0.3 })
	prompt(mach, "vending", "Comprar", "Máquina expendedora")
	table.insert(World.VendingMachines, Vector3.new(x, 0, z))
end

local function buildBank(parent, sp)
	local m = model(parent, "Banco")
	local w, d, h = 50, 36, 18
	local base = shell(m, sp.WX, sp.WZ, w, d, h, { 230, 225, 210 }, { 240, 240, 240 })
	local board = P(m, "BankSign", Vector3.new(28, 4, 0.6), base * CFrame.new(0, h - 2.5, d / 2 + 0.6), { 20, 40, 70 })
	sign(board, Enum.NormalId.Front, "🏦 " .. sp.Name, Color3.fromRGB(20, 40, 70), Color3.fromRGB(255, 214, 120))
	for i = 1, 3 do
		local atm = P(m, "ATM", Vector3.new(3, 6, 2), base * CFrame.new(-14 + (i - 1) * 14, 3, -d / 2 + 2), { 60, 70, 90 }, Enum.Material.Metal)
		P(m, "ATMScreen", Vector3.new(2, 1.4, 0.1), base * CFrame.new(-14 + (i - 1) * 14, 4.2, -d / 2 + 3.05), { 80, 220, 140 }, Enum.Material.Neon, { NoShadow = true })
		prompt(atm, "atm", "Abrir banco", "Cajero automático")
	end
	table.insert(World.NpcPoints, { Pos = (base * CFrame.new(16, 0, 6)).Position, Look = (base * CFrame.new(0, 0, 6)).Position, Name = "Asesora del banco", Role = "banker" })
end

local function buildResidence(parent, sp)
	local m = model(parent, "ResidenciaEconomica")
	local roomW, roomD, h = 22, 20, 12
	local perRow = 6
	local corridor = 10
	local totalW = roomW * perRow
	local totalD = roomD * 2 + corridor
	local base = CFrame.new(sp.WX, GROUND_TOP, sp.WZ)
	P(m, "Floor", Vector3.new(totalW, 0.6, totalD), base * CFrame.new(0, 0.3, 0), { 120, 110, 100 }, Enum.Material.WoodPlanks)
	P(m, "Roof", Vector3.new(totalW + 2, 1, totalD + 2), base * CFrame.new(0, h + 0.5, 0), { 90, 80, 75 }, Enum.Material.Slate)
	P(m, "WallN", Vector3.new(totalW, h, 1), base * CFrame.new(0, h / 2, -totalD / 2), { 200, 185, 160 }, Enum.Material.Brick)
	P(m, "WallS", Vector3.new(totalW, h, 1), base * CFrame.new(0, h / 2, totalD / 2), { 200, 185, 160 }, Enum.Material.Brick)
	-- extremos con puertas (pasillo a lo largo del eje X)
	for _, sx in ipairs({ -1, 1 }) do
		local ex = sx * totalW / 2
		local side = (totalD - 10) / 2
		P(m, "WallEnd", Vector3.new(1, h, side), base * CFrame.new(ex, h / 2, -totalD / 2 + side / 2), { 200, 185, 160 }, Enum.Material.Brick)
		P(m, "WallEnd", Vector3.new(1, h, side), base * CFrame.new(ex, h / 2, totalD / 2 - side / 2), { 200, 185, 160 }, Enum.Material.Brick)
		P(m, "WallEnd", Vector3.new(1, h - 9, 10), base * CFrame.new(ex, 9 + (h - 9) / 2, 0), { 200, 185, 160 }, Enum.Material.Brick)
	end
	local board = P(m, "ResidenceSign", Vector3.new(0.6, 3, 16), base * CFrame.new(totalW / 2 + 0.6, h - 2, 0), { 30, 30, 36 })
	sign(board, Enum.NormalId.Right, "🏠 " .. sp.Name, nil, Color3.fromRGB(255, 214, 120))
	local index = 0
	for row = 0, 1 do
		for col = 0, perRow - 1 do
			index = index + 1
			local rx = -totalW / 2 + roomW / 2 + col * roomW
			local rz = (row == 0) and (-totalD / 2 + roomD / 2) or (totalD / 2 - roomD / 2)
			local rbase = base * CFrame.new(rx, 0, rz)
			local towardCorridor = (row == 0) and 1 or -1 -- dirección Z hacia el pasillo
			-- tabiques entre habitaciones
			P(m, "Partition", Vector3.new(0.6, h, roomD), rbase * CFrame.new(-roomW / 2, h / 2, 0), { 230, 225, 215 }, Enum.Material.Plaster)
			-- pared del pasillo con puerta
			local wz = towardCorridor * roomD / 2
			P(m, "RoomWall", Vector3.new(8, h, 0.6), rbase * CFrame.new(-7, h / 2, wz), { 230, 225, 215 }, Enum.Material.Plaster)
			P(m, "RoomWall", Vector3.new(8, h, 0.6), rbase * CFrame.new(7, h / 2, wz), { 230, 225, 215 }, Enum.Material.Plaster)
			P(m, "RoomWall", Vector3.new(6, h - 8, 0.6), rbase * CFrame.new(0, 8 + (h - 8) / 2, wz), { 230, 225, 215 }, Enum.Material.Plaster)
			local plate = P(m, "DoorSign", Vector3.new(6, 1.4, 0.2), rbase * CFrame.new(0, 9.2, wz + towardCorridor * 0.45), { 30, 30, 36 })
			local face = (towardCorridor > 0) and Enum.NormalId.Back or Enum.NormalId.Front
			local label = sign(plate, face, "Hab. " .. index .. " · Libre", nil, Color3.new(1, 1, 1), Enum.Font.GothamBold)
			-- alfombra, cama, ventana, luz, vestidor
			local inward = -towardCorridor
			P(m, "Rug", Vector3.new(10, 0.1, 8), rbase * CFrame.new(0, 0.65, 0), { 140 + (index * 13) % 80, 90, 110 }, Enum.Material.Fabric, { NoCollide = true })
			local bed = P(m, "Bed", Vector3.new(6, 1.6, 9), rbase * CFrame.new(-7, 1.4, inward * 4), { 250, 250, 255 }, Enum.Material.Fabric)
			prompt(bed, "rest", "Descansar", "Cama")
			P(m, "BedFrame", Vector3.new(6.4, 1, 9.4), rbase * CFrame.new(-7, 0.9, inward * 4), { 110, 80, 60 }, Enum.Material.Wood)
			P(m, "Pillow", Vector3.new(4, 0.6, 1.6), rbase * CFrame.new(-7, 2.4, inward * 7.6), { 255, 255, 255 }, Enum.Material.Fabric)
			local lamp = P(m, "RoomLamp", Vector3.new(3, 0.3, 3), rbase * CFrame.new(0, h - 0.3, 0), { 255, 245, 220 }, Enum.Material.Neon, { NoShadow = true })
			local pl = Instance.new("PointLight")
			pl.Range = 18
			pl.Brightness = 1
			pl.Parent = lamp
			local win = P(m, "Window", Vector3.new(8, 4, 0.3), rbase * CFrame.new(0, 6.5, inward * (roomD / 2) + inward * -0.2), { 180, 220, 255 }, Enum.Material.Glass, { Transparency = 0.4 })
			win.CanCollide = true
			local wardrobe = P(m, "Wardrobe", Vector3.new(2, 8, 5), rbase * CFrame.new(roomW / 2 - 1.6, 4, inward * -4), { 160, 120, 90 }, Enum.Material.WoodPlanks)
			local wp = prompt(wardrobe, "wardrobe", "Vestidor", "Cambiar estilo", { Owner = 0 })
			local fridge = P(m, "Fridge", Vector3.new(3, 6, 3), rbase * CFrame.new(roomW / 2 - 2, 3, inward * 6), { 230, 235, 240 }, Enum.Material.Metal)
			prompt(fridge, "cook", "Cocinar", "Cocina")
			-- Escritorio: los muebles visibles los dibuja HomeService según el inventario
			local deskCF = rbase * CFrame.new(5, 3.4, inward * (roomD / 2 - 3)) * CFrame.Angles(0, (inward > 0) and 0 or math.pi, 0)
			local anchor = P(m, "DeskAnchor", Vector3.new(8, 4, 4), deskCF * CFrame.new(0, -1.5, 0), { 0, 0, 0 }, Enum.Material.SmoothPlastic, { Transparency = 1, NoCollide = true })
			anchor.CanQuery = false
			local dp = prompt(anchor, "computer_home", "Usar computador", "Tu escritorio", { Owner = 0 })
			local dynamic = folder(m, "Room" .. index .. "Furniture")
			table.insert(World.HomeRooms, {
				Index = index,
				Center = (rbase * CFrame.new(0, 1, 0)).Position,
				Size = Vector3.new(roomW, h, roomD),
				DeskCFrame = deskCF,
				Dynamic = dynamic,
				Sign = label,
				DeskPrompt = dp,
				Wardrobe = wp,
			})
		end
	end
	-- Marcador para la flecha del tutorial
	World.HomePosition = Vector3.new(sp.WX + totalW / 2 + 6, GROUND_TOP + 3, sp.WZ)
end

local function buildVipLounge(parent, cx, cz)
	local m = model(parent, "SalaVIP")
	-- La sala está elevada y cerrada: solo se entra con el aviso de la puerta.
	local center = Vector3.new(cx, -60, cz) -- bajo tierra: invisible desde la ciudad
	local base = CFrame.new(center)
	local w, d, h = 40, 30, 12
	P(m, "Floor", Vector3.new(w, 1, d), base, { 30, 20, 40 }, Enum.Material.Marble)
	P(m, "Ceiling", Vector3.new(w, 1, d), base * CFrame.new(0, h, 0), { 20, 15, 30 }, Enum.Material.Marble)
	for _, wall in ipairs({ { 0, -d / 2, w, 1 }, { 0, d / 2, w, 1 }, { -w / 2, 0, 1, d }, { w / 2, 0, 1, d } }) do
		P(m, "Wall", Vector3.new(wall[3], h, wall[4]), base * CFrame.new(wall[1], h / 2, wall[2]), { 60, 30, 80 }, Enum.Material.Fabric)
	end
	P(m, "Sofa", Vector3.new(14, 2, 4), base * CFrame.new(0, 1.5, -10), { 200, 160, 60 }, Enum.Material.Fabric)
	local neon = P(m, "Neon", Vector3.new(w - 2, 0.4, 0.4), base * CFrame.new(0, h - 1, -d / 2 + 0.8), { 255, 200, 80 }, Enum.Material.Neon, { NoShadow = true })
	local l = Instance.new("PointLight")
	l.Range = 40
	l.Color = Color3.fromRGB(255, 200, 120)
	l.Parent = neon
	local exit = P(m, "ExitDoor", Vector3.new(6, 9, 0.5), base * CFrame.new(0, 5, d / 2 - 0.6), { 40, 40, 44 }, Enum.Material.Metal)
	prompt(exit, "vip_exit", "Salir", "Sala VIP")
	local door = P(m, "VipDoor", Vector3.new(8, 10, 1), Vector3.new(cx, GROUND_TOP + 5, cz + 20), { 20, 20, 24 }, Enum.Material.Metal)
	local s = P(m, "VipSign", Vector3.new(8, 2, 0.4), Vector3.new(cx, GROUND_TOP + 11, cz + 20.6), { 20, 20, 24 })
	sign(s, Enum.NormalId.Front, "⭐ SALA VIP", nil, Color3.fromRGB(255, 214, 0))
	prompt(door, "vip_enter", "Entrar", "Sala VIP (Game Pass VIP)")
	World.VipLounge = { Center = center + Vector3.new(0, 3, 0), Size = Vector3.new(w, h, d), Entry = Vector3.new(cx, GROUND_TOP + 3, cz + 26) }
end

-- Cartel de una propiedad en venta / alquiler
local function buildPropertySign(parent, l)
	local pos = S.Property.signPosition(l)
	P(parent, "PropertyPost", Vector3.new(0.5, 7, 0.5), Vector3.new(pos.X, GROUND_TOP + 3.5, pos.Z), { 240, 240, 240 }, Enum.Material.Metal)
	local board = P(parent, "PropertySign", Vector3.new(10, 5, 0.4), Vector3.new(pos.X, GROUND_TOP + 7.5, pos.Z), { 255, 255, 255 })
	local price = {}
	if l.Rent then
		price[#price + 1] = "Alquiler $" .. Util.formatInt(l.Rent) .. "/sem"
	end
	if l.Buy then
		price[#price + 1] = "Venta $" .. Util.formatInt(l.Buy)
	end
	local text = "🏠 " .. l.Type:upper() .. "\n" .. table.concat(price, " · ")
	sign(board, Enum.NormalId.Back, text, Color3.fromRGB(20, 110, 70), Color3.new(1, 1, 1), Enum.Font.GothamBold)
	sign(board, Enum.NormalId.Front, text, Color3.fromRGB(20, 110, 70), Color3.new(1, 1, 1), Enum.Font.GothamBold)
	local base = P(parent, "PropertyDoor", Vector3.new(6, 8, 1), Vector3.new(pos.X, GROUND_TOP + 4, pos.Z - 4), { 90, 60, 40 }, Enum.Material.Wood)
	prompt(base, "prop_view", "Ver anuncio", l.Name, { PropId = l.Id })
	local enter = prompt(base, "prop_enter", "Entrar", l.Name, { PropId = l.Id })
	enter.KeyboardKeyCode = Enum.KeyCode.G
end

---------------------------------------------------------------------------
-- Distritos
---------------------------------------------------------------------------
local function buildDistrict(d)
	local cx, cz = WorldData.center(d)
	local rng = Random.new(Util.hashString(d.Id))
	local m = model(city, d.Name)
	local inner = CELL - ROAD
	-- Acera (borde) y suelo del distrito
	P(m, "Sidewalk", Vector3.new(inner, 1, inner), Vector3.new(cx, GROUND_TOP - 0.6, cz), { 175, 175, 180 }, Enum.Material.Concrete)
	local material = Enum.Material[d.Material] or Enum.Material.Grass
	P(m, "Ground", Vector3.new(inner - 10, 0.2, inner - 10), Vector3.new(cx, GROUND_TOP, cz), d.Ground, material)

	-- Señal del distrito + parada de taxi
	local stop = S.Travel.taxiStop(d)
	P(m, "TaxiPole", Vector3.new(0.5, 9, 0.5), Vector3.new(stop.X, GROUND_TOP + 4.5, stop.Z + 4), { 40, 40, 44 }, Enum.Material.Metal)
	local board = P(m, "DistrictSign", Vector3.new(14, 4, 0.4), Vector3.new(stop.X, GROUND_TOP + 9.5, stop.Z + 4), { 20, 30, 50 })
	sign(board, Enum.NormalId.Front, d.Name, Color3.fromRGB(20, 30, 50), Color3.new(1, 1, 1))
	sign(board, Enum.NormalId.Back, d.Name, Color3.fromRGB(20, 30, 50), Color3.new(1, 1, 1))
	local taxi = P(m, "TaxiSign", Vector3.new(3, 1.6, 0.3), Vector3.new(stop.X + 4, GROUND_TOP + 6, stop.Z + 4), { 255, 210, 0 })
	sign(taxi, Enum.NormalId.Front, "TAXI", Color3.fromRGB(255, 210, 0), Color3.fromRGB(20, 20, 20))

	if (d.Busy or 0) >= 5 then
		vending(m, stop.X - 14, stop.Z + 4)
	end

	-- Farolas en las aceras
	local half = inner / 2 - 3
	for _, pos in ipairs({ { -half, -half / 2 }, { half, half / 2 }, { half / 2, -half }, { -half / 2, half } }) do
		streetLamp(m, cx + pos[1], cz + pos[2])
	end

	-- Agua
	if d.Water then
		local wc = Vector3.new(cx + d.Water.X, GROUND_TOP + 1, cz + d.Water.Z)
		workspace.Terrain:FillBlock(CFrame.new(wc), Vector3.new(d.Water.W, 4, d.Water.D), Enum.Material.Water)
		local rim = Util.indexOf(d.Tags, "beach") and { 230, 210, 160 } or { 120, 110, 100 }
		local rimMat = Util.indexOf(d.Tags, "beach") and Enum.Material.Sand or Enum.Material.Slate
		P(m, "Shore", Vector3.new(d.Water.W + 4, 2.4, 2), Vector3.new(wc.X, GROUND_TOP + 1.2, wc.Z - d.Water.D / 2 - 1), rim, rimMat)
		P(m, "Shore", Vector3.new(2, 2.4, d.Water.D), Vector3.new(wc.X - d.Water.W / 2 - 1, GROUND_TOP + 1.2, wc.Z), rim, rimMat)
		P(m, "Shore", Vector3.new(2, 2.4, d.Water.D), Vector3.new(wc.X + d.Water.W / 2 + 1, GROUND_TOP + 1.2, wc.Z), rim, rimMat)
		P(m, "Shore", Vector3.new(d.Water.W + 4, 2.4, 2), Vector3.new(wc.X, GROUND_TOP + 1.2, wc.Z + d.Water.D / 2 + 1), rim, rimMat)
		if d.Id == "lake" or d.Id == "port" then
			P(m, "Pier", Vector3.new(8, 1, 40), Vector3.new(wc.X, GROUND_TOP + 3, wc.Z + d.Water.D / 2 - 18), { 130, 95, 65 }, Enum.Material.WoodPlanks)
		end
	end

	-- Montañas
	if d.Hills then
		for i = 1, 6 do
			local hx, hz = rng:NextInteger(-100, 100), rng:NextInteger(-100, 100)
			local s = rng:NextInteger(40, 80)
			P(m, "Hill", Vector3.new(s, s * 0.8, s), CFrame.new(cx + hx, GROUND_TOP + s * 0.2, cz + hz) * CFrame.Angles(0, rng:NextNumber() * 6, 0),
				{ 120, 115, 105 }, Enum.Material.Slate, { Shape = Enum.PartType.Ball })
		end
		P(m, "SnowCap", Vector3.new(40, 30, 40), Vector3.new(cx + 40, GROUND_TOP + 30, cz - 60), { 245, 248, 255 }, Enum.Material.Snow, { Shape = Enum.PartType.Ball })
	end
	if d.Fields then
		for i = -3, 3 do
			P(m, "Crops", Vector3.new(80, 1.2, 4), Vector3.new(cx - 40, GROUND_TOP + 0.6, cz - 50 + i * 8), { 200, 180, 60 }, Enum.Material.Grass)
		end
	end
	if d.Runway then
		P(m, "Runway", Vector3.new(30, 0.3, 230), Vector3.new(cx + 80, GROUND_TOP + 0.15, cz), { 50, 50, 55 }, Enum.Material.Asphalt)
		for i = -5, 5 do
			P(m, "RunwayMark", Vector3.new(1.5, 0.05, 10), Vector3.new(cx + 80, GROUND_TOP + 0.33, cz + i * 20), { 250, 250, 250 }, Enum.Material.SmoothPlastic, { NoShadow = true })
		end
		local plane = model(m, "Plane")
		P(plane, "Fuselage", Vector3.new(40, 6, 6), CFrame.new(cx + 80, GROUND_TOP + 5, cz - 60) * CFrame.Angles(0, math.rad(90), math.rad(90)), { 245, 245, 250 }, Enum.Material.SmoothPlastic, { Shape = Enum.PartType.Cylinder })
		P(plane, "Wings", Vector3.new(44, 1, 8), Vector3.new(cx + 80, GROUND_TOP + 4, cz - 60), { 220, 220, 230 }, Enum.Material.SmoothPlastic)
	end
	if d.Monument then
		P(m, "MonumentBase", Vector3.new(16, 3, 16), Vector3.new(cx, GROUND_TOP + 1.5, cz - 18), { 200, 190, 170 }, Enum.Material.Marble)
		P(m, "Obelisk", Vector3.new(6, 40, 6), Vector3.new(cx, GROUND_TOP + 23, cz - 18), { 230, 220, 200 }, Enum.Material.Marble)
		local top = P(m, "ObeliskTop", Vector3.new(4, 4, 4), Vector3.new(cx, GROUND_TOP + 45, cz - 18), { 255, 214, 100 }, Enum.Material.Neon, { Shape = Enum.PartType.Ball })
		nightLight(top, 40)
	end

	-- Edificios: huecos en una cuadrícula 4x4 evitando lugares y edificios especiales
	local blocked = {}
	for _, s in ipairs(d.Spots) do
		blocked[#blocked + 1] = { cx + s.X, cz + s.Z, 40 }
	end
	for _, sp in ipairs(d.Specials or {}) do
		blocked[#blocked + 1] = { cx + sp.X, cz + sp.Z, sp.Type == "home" and 80 or 50 }
	end
	blocked[#blocked + 1] = { stop.X, stop.Z, 20 }
	if d.Water then
		blocked[#blocked + 1] = { cx + d.Water.X, cz + d.Water.Z, math.max(d.Water.W, d.Water.D) / 2 + 25 }
	end
	if d.Runway then
		blocked[#blocked + 1] = { cx + 80, cz, 60 }
		blocked[#blocked + 1] = { cx + 80, cz + 90, 50 }
		blocked[#blocked + 1] = { cx + 80, cz - 90, 50 }
	end
	local slots = {}
	for _, ox in ipairs({ -98, -33, 33, 98 }) do
		for _, oz in ipairs({ -98, -33, 33, 98 }) do
			local x, z = cx + ox, cz + oz
			local free = true
			for _, b in ipairs(blocked) do
				if (x - b[1]) ^ 2 + (z - b[2]) ^ 2 < b[3] ^ 2 then
					free = false
				end
			end
			if free then
				slots[#slots + 1] = { x, z }
			end
		end
	end
	for i = #slots, 2, -1 do
		local j = rng:NextInteger(1, i)
		slots[i], slots[j] = slots[j], slots[i]
	end
	local builder = styleBuilders[d.Style] or styleBuilders.none
	local built = 0
	local buildings = folder(m, "Buildings")
	for _, slot in ipairs(slots) do
		if built >= (d.Count or 0) then
			break
		end
		builder(buildings, slot[1], slot[2], d, rng)
		built = built + 1
	end
	-- Huecos sobrantes: árboles, bancos y coches para dar vida
	local deco = folder(m, "Decoration")
	local trees = d.Trees or 0
	local placed = 0
	local tries = 0
	while placed < trees and tries < trees * 6 do
		tries = tries + 1
		local x, z = cx + rng:NextInteger(-115, 115), cz + rng:NextInteger(-115, 115)
		local ok = true
		for _, b in ipairs(blocked) do
			if (x - b[1]) ^ 2 + (z - b[2]) ^ 2 < (b[3] * 0.6) ^ 2 then
				ok = false
			end
		end
		for _, slot in ipairs(slots) do
			if (x - slot[1]) ^ 2 + (z - slot[2]) ^ 2 < 26 ^ 2 and placed < built then
				ok = false
			end
		end
		if ok then
			tree(deco, x, z, 0.8 + rng:NextNumber() * 0.6, rng)
			placed = placed + 1
		end
	end
	for _, s in ipairs(d.Spots) do
		bench(deco, cx + s.X + 10, cz + s.Z + 10, rng:NextNumber() * 6)
	end
	if Util.indexOf(d.Tags, "urban") or Util.indexOf(d.Tags, "shop") or Util.indexOf(d.Tags, "vehicle") then
		local colors = { { 200, 30, 40 }, { 30, 90, 200 }, { 240, 240, 240 }, { 20, 20, 25 }, { 250, 200, 40 }, { 60, 160, 90 } }
		for i = 1, 3 do
			car(deco, cx - 110 + i * 9, cz + 112, colors[rng:NextInteger(1, #colors)], 0)
		end
	end

	-- Lugares de grabación
	for _, s in ipairs(d.Spots) do
		local marker = P(m, "RecordSpot", Vector3.new(0.3, 10, 10), CFrame.new(cx + s.X, GROUND_TOP + 0.2, cz + s.Z) * CFrame.Angles(0, 0, math.rad(90)),
			{ 255, 50, 90 }, Enum.Material.Neon, { Shape = Enum.PartType.Cylinder, NoCollide = true, Transparency = 0.45, NoShadow = true })
		marker.CanQuery = false
		CollectionService:AddTag(marker, "RecordSpot")
		local bb = Instance.new("BillboardGui")
		bb.Size = UDim2.fromOffset(200, 40)
		bb.StudsOffset = Vector3.new(0, 7, 0)
		bb.MaxDistance = 140
		bb.Parent = marker
		local t = Instance.new("TextLabel")
		t.Size = UDim2.fromScale(1, 1)
		t.BackgroundColor3 = Color3.fromRGB(20, 20, 24)
		t.BackgroundTransparency = 0.25
		t.TextColor3 = Color3.new(1, 1, 1)
		t.Font = Enum.Font.GothamBold
		t.TextScaled = true
		t.Text = "🎥 " .. s.Name
		t.Parent = bb
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0, 10)
		corner.Parent = t
	end

	-- Edificios especiales
	for _, sp in ipairs(WorldData.Specials) do
		if sp.District == d.Id then
			if sp.Type == "store" then
				buildStore(m, sp, rng)
			elseif sp.Type == "cafe" then
				buildCafe(m, sp)
			elseif sp.Type == "bank" then
				buildBank(m, sp)
			elseif sp.Type == "restaurant" then
				buildRestaurant(m, sp)
			elseif sp.Type == "home" then
				buildResidence(m, sp)
			end
		end
	end
	if d.Id == "events" then
		buildVipLounge(m, cx + 90, cz - 90)
	end
	for _, l in ipairs(PropertyData.Listings) do
		if l.District == d.Id then
			buildPropertySign(m, l)
		end
	end

	-- Ciudadanos (NPC) junto a lugares concurridos
	if (d.Busy or 0) >= 4 then
		local s = d.Spots[1]
		table.insert(World.NpcPoints, { Pos = Vector3.new(cx + s.X - 8, GROUND_TOP, cz + s.Z - 6), Look = Vector3.new(cx + s.X, GROUND_TOP, cz + s.Z), Name = "Vecino de " .. d.Name, Role = "citizen", District = d.Id })
	end
end

local function buildRoads()
	local roads = folder(city, "Roads")
	local W, H = WorldData.totalSize()
	for k = 0, WorldData.Cols do
		local x = -W / 2 + k * CELL
		P(roads, "RoadNS", Vector3.new(ROAD, 1, H + ROAD), Vector3.new(x, -0.5 + 0.05, 0), { 45, 45, 50 }, Enum.Material.Asphalt)
		P(roads, "LineNS", Vector3.new(0.5, 0.05, H), Vector3.new(x, 0.08, 0), { 240, 200, 40 }, Enum.Material.SmoothPlastic, { NoShadow = true, NoCollide = true })
	end
	for j = 0, WorldData.Rows do
		local z = -H / 2 + j * CELL
		P(roads, "RoadEW", Vector3.new(W + ROAD, 1, ROAD), Vector3.new(0, -0.5 + 0.06, z), { 45, 45, 50 }, Enum.Material.Asphalt)
		P(roads, "LineEW", Vector3.new(W, 0.05, 0.5), Vector3.new(0, 0.09, z), { 240, 200, 40 }, Enum.Material.SmoothPlastic, { NoShadow = true, NoCollide = true })
	end
	-- Semáforos en los cruces interiores
	for k = 1, WorldData.Cols - 1 do
		for j = 1, WorldData.Rows - 1 do
			local x = -W / 2 + k * CELL + ROAD / 2 + 2
			local z = -H / 2 + j * CELL + ROAD / 2 + 2
			P(roads, "TrafficPole", Vector3.new(0.6, 12, 0.6), Vector3.new(x, GROUND_TOP + 6, z), { 40, 40, 44 }, Enum.Material.Metal)
			P(roads, "TrafficBox", Vector3.new(1.4, 4.2, 1.4), Vector3.new(x, GROUND_TOP + 11, z), { 25, 25, 28 }, Enum.Material.Metal)
			local lights = {}
			for i, col in ipairs({ { 255, 40, 40 }, { 255, 200, 0 }, { 40, 255, 90 } }) do
				lights[i] = P(roads, "TrafficLight", Vector3.new(1, 1, 0.3), Vector3.new(x, GROUND_TOP + 12.4 - (i - 1) * 1.3, z - 0.75), col, Enum.Material.Neon, { NoShadow = true })
			end
			table.insert(World.TrafficLights, { Lights = lights, Phase = (k + j) % 2 })
			-- paso de cebra
			for s = -2, 2 do
				P(roads, "Crosswalk", Vector3.new(1.6, 0.05, 8), Vector3.new(x - ROAD / 2 - 2 + s * 3, 0.1, z + 8), { 240, 240, 240 }, Enum.Material.SmoothPlastic, { NoShadow = true, NoCollide = true })
			end
		end
	end
end

local function buildSecrets()
	local f = folder(city, "Secrets")
	for _, s in ipairs(WorldData.Secrets) do
		local star = P(f, "SecretGlow", Vector3.new(1.4, 1.4, 1.4), Vector3.new(s.WX, GROUND_TOP + 2.5, s.WZ), { 255, 240, 140 }, Enum.Material.Neon,
			{ Shape = Enum.PartType.Ball, NoCollide = true, NoShadow = true })
		local sp = Instance.new("Sparkles")
		sp.SparkleColor = Color3.fromRGB(255, 240, 140)
		sp.Parent = star
		CollectionService:AddTag(star, "Spin")
		if s.Id == "sec_studio" then
			P(f, "AbandonedStudio", Vector3.new(24, 12, 20), Vector3.new(s.WX - 14, GROUND_TOP + 6, s.WZ + 2), { 70, 65, 60 }, Enum.Material.CorrodedMetal)
		elseif s.Id == "sec_dock" then
			P(f, "GhostShip", Vector3.new(14, 6, 40), Vector3.new(s.WX - 16, GROUND_TOP + 3, s.WZ), { 60, 50, 45 }, Enum.Material.Wood)
			P(f, "Mast", Vector3.new(1, 22, 1), Vector3.new(s.WX - 16, GROUND_TOP + 15, s.WZ), { 60, 50, 45 }, Enum.Material.Wood)
		elseif s.Id == "sec_arcade" then
			local cab = P(f, "LegendArcade", Vector3.new(4, 7, 3), Vector3.new(s.WX - 4, GROUND_TOP + 3.5, s.WZ), { 40, 0, 80 }, Enum.Material.SmoothPlastic)
			P(f, "ArcadeScreen", Vector3.new(3, 2.4, 0.2), Vector3.new(s.WX - 4, GROUND_TOP + 5, s.WZ + 1.6), { 0, 255, 200 }, Enum.Material.Neon, { NoShadow = true })
			cab:SetAttribute("Secret", true)
		elseif s.Id == "sec_forest" then
			tree(f, s.WX - 8, s.WZ - 8, 2.6, Random.new(7))
		end
	end
end

---------------------------------------------------------------------------
-- Interacciones de los avisos (ProximityPrompt)
---------------------------------------------------------------------------
local function onPrompt(pp, player)
	local action = pp:GetAttribute("Action")
	if not S.Data.get(player) then
		return
	end
	if action == "computer_home" then
		S.Computer.onPrompt(player, pp.Parent, "home", pp:GetAttribute("Owner"))
	elseif action == "computer_public" then
		S.Computer.onPrompt(player, pp.Parent, "public")
	elseif action == "wardrobe" then
		if pp:GetAttribute("Owner") ~= player.UserId then
			S.Net.notify(player, "Este vestidor no es tuyo.", "error")
			return
		end
		S.Net.push(player, "openUI", { ui = "style" })
	elseif action == "store_catalog" then
		S.Travel.markStoreVisit(player, pp:GetAttribute("StoreId"))
		S.Net.push(player, "openUI", { ui = "store", store = pp:GetAttribute("StoreId") })
	elseif action == "inspect" then
		S.Travel.markStoreVisit(player, pp:GetAttribute("StoreId"))
		S.Net.push(player, "openUI", { ui = "product", item = pp:GetAttribute("ItemId"), store = pp:GetAttribute("StoreId") })
	elseif action == "atm" then
		S.Net.push(player, "openUI", { ui = "app", app = "bank" })
	elseif action == "npc" then
		S.NPC.talk(player, pp:GetAttribute("NpcId"))
	elseif action == "vip_enter" then
		if not S.Monetization.owns(player, "VIP") then
			S.Net.notify(player, "La sala VIP es para quienes tienen el Game Pass VIP (opcional). Hay muchos otros lugares para grabar gratis.", "info")
			return
		end
		S.Travel.teleport(player, World.VipLounge.Center)
	elseif action == "vip_exit" then
		S.Travel.teleport(player, World.VipLounge.Entry)
	elseif action == "rest" then
		S.Needs.rest(player)
	elseif action == "cook" then
		if not S.Home.isAtHome(player) then
			S.Net.notify(player, "Esta cocina no es tuya.", "error")
			return
		end
		S.Net.push(player, "openUI", { ui = "food", tab = "cook" })
	elseif action == "vending" or action == "restaurant" or action == "cafe" then
		S.Net.push(player, "openUI", { ui = "food", tab = "menu", place = action })
	elseif action == "prop_view" then
		S.Net.push(player, "openUI", { ui = "realty", listing = pp:GetAttribute("PropId") })
	elseif action == "prop_enter" then
		local id = pp:GetAttribute("PropId")
		local data = S.Data.get(player)
		if not data.Properties[id] then
			S.Net.notify(player, "No es tuya. Alquílala o cómprala desde el anuncio (E) o la app Inmobiliaria.", "info")
			return
		end
		local cf = S.Property.enterCFrame(player, id)
		S.Travel.teleport(player, cf.Position)
		S.Quest.tutorialEvent(player, "enter_home")
	elseif action == "prop_exit" then
		local id = S.Property.inside(player)
		if id then
			S.Travel.teleport(player, S.Property.exteriorOf(id))
		end
	end
end
World.onPrompt = onPrompt

function World.build()
	city = workspace:FindFirstChild("City")
	if city then
		city:Destroy()
	end
	city = folder(workspace, "City")
	local W, H = WorldData.totalSize()
	local base = P(city, "Baseplate", Vector3.new(W + 600, 2, H + 600), Vector3.new(0, -2, 0), { 90, 140, 80 }, Enum.Material.Grass)
	base.Locked = true
	-- Mar al sur
	workspace.Terrain:FillBlock(CFrame.new(0, -3, H / 2 + 300), Vector3.new(W + 600, 6, 560), Enum.Material.Water)
	buildRoads()
	for _, d in ipairs(WorldData.Districts) do
		buildDistrict(d)
	end
	buildSecrets()
	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "FallbackSpawn"
	spawn.Anchored = true
	spawn.Size = Vector3.new(8, 1, 8)
	local hp = World.HomePosition or Vector3.new(0, 2, 0)
	spawn.CFrame = CFrame.new(hp + Vector3.new(8, -2, 0))
	spawn.Transparency = 1
	spawn.CanCollide = false
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.Parent = city
end

function World.Start()
	local function connect(pp)
		pp:SetAttribute("Connected", true)
		pp.Triggered:Connect(function(player)
			local ok, err = pcall(onPrompt, pp, player)
			if not ok then
				S.Net.logError("prompt", err)
			end
		end)
	end
	-- Avisos creados más tarde (interiores de propiedades)
	CollectionService:GetInstanceAddedSignal("YTPrompt"):Connect(connect)
	World.build()
	for _, pp in ipairs(CollectionService:GetTagged("YTPrompt")) do
		if not pp:GetAttribute("Connected") then
			pp:SetAttribute("Connected", true)
			connect(pp)
		end
	end
	-- Semáforos
	task.spawn(function()
		local tick = 0
		while true do
			tick = tick + 1
			local phase = math.floor(tick / 2) % 2
			local amber = tick % 2 == 1
			for _, tl in ipairs(World.TrafficLights) do
				local green = (phase + tl.Phase) % 2 == 0
				tl.Lights[1].Transparency = (not green and not amber) and 0 or 0.8
				tl.Lights[2].Transparency = amber and 0 or 0.8
				tl.Lights[3].Transparency = (green and not amber) and 0 or 0.8
			end
			task.wait(4)
		end
	end)
end

return World
