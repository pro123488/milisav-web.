SponsorData.Brands = {
	{ Id = "nexo", Name = "Nexo", Field = "Computadores", Cats = { "tech", "review", "unboxing", "compare" }, Products = { "pc_home", "pc_office", "kb_mech", "mouse_gamer" }, MinRep = 0 },
