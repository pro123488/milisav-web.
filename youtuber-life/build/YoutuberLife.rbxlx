}

-- Pon aquí IDs numéricos de audio con licencia. 0 = desactivado.
SoundConfig.Music = {
	Ambient = 0,
	Event = 0,
	Shop = 0,
}

SoundConfig.Ambience = {
	City = 0,
	Nature = 0,
	Rain = 0,
}

return SoundConfig
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000017"><Properties><string name="Name">SponsorData</string><ProtectedString name="Source"><![CDATA[--!nonstrict
