<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4"><Item class="Workspace" referent="RBX000001"><Properties><string name="Name">Workspace</string><bool name="StreamingEnabled">false</bool></Properties></Item><Item class="Lighting" referent="RBX000002"><Properties><string name="Name">Lighting</string><float name="Brightness">2.5</float><bool name="GlobalShadows">true</bool></Properties></Item><Item class="ReplicatedStorage" referent="RBX000019"><Properties><string name="Name">ReplicatedStorage</string></Properties><Item class="Folder" referent="RBX000003"><Properties><string name="Name">Shared</string></Properties><Item class="ModuleScript" referent="RBX000004"><Properties><string name="Name">Config</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Config: valores de equilibrio del juego. Cambia aquí sin tocar la lógica.

local Config = {}

Config.Version = "0.4.0"
Config.GameName = "Youtuber Life: Real World Ultimate"

-- Guardado
Config.DataStoreName = "YTLife_PlayerData_v1"
Config.AutosaveInterval = 120 -- segundos
Config.SessionLockTimeout = 600 -- segundos tras los que un bloqueo de sesión se considera abandonado
Config.LoadRetries = 4

-- Economía (dinero virtual del juego, nunca Robux)
Config.StartingMoney = 1500
Config.MaxTransactions = 150
Config.MonthsKept = 6
Config.SellBackRate = 0.55 -- % del precio pagado al vender (multiplicado por la condición)
Config.ReturnWindowDays = 3 -- días de juego para devolver con reembolso casi completo
Config.ReturnRefundRate = 0.9
Config.IncomeTaxRate = 0.08 -- impuesto simulado sobre ingresos de vídeos y empleos

-- Tiempo del mundo
Config.DayLengthSeconds = 1200 -- 20 minutos reales = 1 día de juego
Config.DaysPerMonth = 7
Config.OnlineDeliveryHours = 3 -- horas de juego hasta entrega de pedidos online

-- Inventario
Config.BaseBackpackSlots = 6
Config.BaseProjectSlots = 6
Config.MaxPhotos = 120
Config.MaxThumbnails = 40
Config.MaxVideosKept = 150
Config.MaxVersionsPerProject = 5
Config.MaxScenesPerProject = 40

-- Grabación
Config.SceneCooldown = 2.5 -- segundos reales entre escenas
Config.PhotoCooldown = 1.0
Config.RecordSpotRadius = 45
Config.HomeRadius = 40

-- Canal
Config.StatsTickSeconds = 20
Config.ViewCurveMinutes = 8 -- minutos reales para que un vídeo alcance ~63% de sus visitas esperadas
Config.OfflineCatchUpHours = 12
Config.PartnerSubs = 100
Config.PartnerVideos = 3
Config.CreatorFundRPM = 0.6 -- $ por 1000 visitas antes de ser socio
Config.HistoryPoints = 24

-- Viviendas
Config.StarterRent = 120 -- por semana de juego (7 días)
Config.RentPeriodDays = 7
Config.LateFeeRate = 0.1

-- Seguridad
Config.RequestsPerSecond = 15
Config.MaxTextTitle = 80
Config.MaxTextDescription = 300

-- Taxi
Config.TaxiBaseFare = 8
Config.TaxiPerStud = 0.012

return Config
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000005"><Properties><string name="Name">EventData</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- EventData: eventos dinámicos reutilizables. Cada día de juego hay un evento distinto (rotación determinista),
-- con lugar, horario, actividades, efectos reales y recompensas. Añadir un evento = añadir una entrada aquí.
--
-- Effects:
--   Discount = { Cats = {...} | All = true, Rate = 0.2 }  → precios de las tiendas
--   ViewBonus = { Cats = {...}, Mult = 1.3 }              → visitas de vídeos publicados ese día
--   EventSpotBonus = 1.3                                    → escenas grabadas en el lugar del evento
--   TaxiDiscount = 0.5
-- Goals (recompensa una vez por evento):
--   checkin  = ir al lugar del evento
--   photo    = foto en el lugar con calidad mínima
--   publish  = publicar N vídeos (opcionalmente de ciertas categorías / calidad / edición mínima)
--   decor    = tener una propiedad con decoración mínima
--   scene    = grabar N escenas en el lugar del evento

local EventData = {}

EventData.Events = {
	{ Id = "techfair", Name = "Feria tecnológica", District = "tech", Spot = "tech_1", Hours = { 9, 21 },
		Desc = "Las marcas presentan novedades. 15% de descuento en tecnología y más visitas para vídeos de tecnología.",
		Effects = { Discount = { Cats = { "pc", "laptop", "monitor", "peripheral", "component", "storage" }, Rate = 0.15 }, ViewBonus = { Cats = { "tech", "review", "compare", "unboxing" }, Mult = 1.25 }, EventSpotBonus = 1.2 },
		Goals = { { Type = "checkin", Reward = 150 }, { Type = "scene", N = 3, Reward = 250 }, { Type = "publish", N = 1, Cats = { "tech", "review", "compare", "unboxing" }, Reward = 400 } } },
	{ Id = "phonelaunch", Name = "Lanzamiento del Zenit Pro", District = "commercial", Spot = "commercial_1", Hours = { 10, 20 },
		Desc = "Presentación de un teléfono ficticio. 20% de descuento en teléfonos y tabletas.",
		Effects = { Discount = { Cats = { "phone", "tablet" }, Rate = 0.2 }, ViewBonus = { Cats = { "tech", "unboxing", "review" }, Mult = 1.2 } },
		Goals = { { Type = "checkin", Reward = 100 }, { Type = "photo", MinQ = 55, Reward = 200 } } },
	{ Id = "saleweek", Name = "Semana de descuentos", District = "commercial", Spot = "commercial_2", Hours = { 8, 22 },
		Desc = "Todas las tiendas con un 20% de descuento. Vídeos de compras y económicos con más visitas.",
		Effects = { Discount = { All = true, Rate = 0.2 }, ViewBonus = { Cats = { "shopping", "budget" }, Mult = 1.3 } },
		Goals = { { Type = "checkin", Reward = 100 }, { Type = "publish", N = 1, Cats = { "shopping", "budget" }, Reward = 300 } } },
	{ Id = "musicfest", Name = "Festival de música", District = "events", Spot = "events_2", Hours = { 16, 24 },
		Desc = "Conciertos ficticios en el escenario principal. Grabar allí da escenas más interesantes.",
		Effects = { ViewBonus = { Cats = { "events", "vlog" }, Mult = 1.3 }, EventSpotBonus = 1.35 },
		Goals = { { Type = "checkin", Reward = 120 }, { Type = "scene", N = 3, Reward = 300 }, { Type = "photo", MinQ = 60, Reward = 200 } } },
	{ Id = "carshow", Name = "Exposición de vehículos", District = "dealers", Spot = "dealers_1", Hours = { 10, 20 },
		Desc = "Deportivos y clásicos expuestos. Vídeos de automóviles con más visitas.",
		Effects = { ViewBonus = { Cats = { "cars", "luxury" }, Mult = 1.35 }, EventSpotBonus = 1.25 },
		Goals = { { Type = "checkin", Reward = 120 }, { Type = "photo", MinQ = 60, Reward = 250 }, { Type = "publish", N = 1, Cats = { "cars" }, Reward = 350 } } },
	{ Id = "realestate", Name = "Feria inmobiliaria", District = "residential", Spot = "residential_1", Hours = { 9, 19 },
		Desc = "10% de descuento en muebles y decoración. Vídeos de decoración con más visitas.",
		Effects = { Discount = { Cats = { "decor", "furniture" }, Rate = 0.1 }, ViewBonus = { Cats = { "decor" }, Mult = 1.3 } },
		Goals = { { Type = "checkin", Reward = 100 }, { Type = "decor", Min = 20, Reward = 400 } } },
	{ Id = "photocontest", Name = "Concurso de fotografía", District = "park", Spot = "park_1", Hours = { 6, 20 },
		Desc = "Haz la mejor foto en la fuente del parque. Premios según la calidad.",
		Effects = {},
		Goals = { { Type = "photo", MinQ = 50, Reward = 200 }, { Type = "photo", MinQ = 70, Reward = 400 }, { Type = "photo", MinQ = 85, Reward = 800 } } },
	{ Id = "editcomp", Name = "Competición de edición", District = "studios", Spot = "studios_1", Hours = { 8, 22 },
		Desc = "Publica un vídeo con una edición excelente para ganar premios.",
		Effects = { ViewBonus = { Cats = { "tutorial", "education" }, Mult = 1.2 } },
		Goals = { { Type = "publish", N = 1, MinEdit = 60, Reward = 300 }, { Type = "publish", N = 1, MinEdit = 80, Reward = 700 } } },
	{ Id = "creatorfest", Name = "Festival de creadores", District = "events", Spot = "events_1", Hours = { 10, 22 },
		Desc = "Encuentro de creadores. Todo lo grabado en la explanada gusta más al público.",
		Effects = { ViewBonus = { Cats = { "vlog", "events", "interview", "challenge" }, Mult = 1.3 }, EventSpotBonus = 1.4 },
		Goals = { { Type = "checkin", Reward = 150 }, { Type = "scene", N = 4, Reward = 350 }, { Type = "publish", N = 1, Reward = 300 } } },
	{ Id = "storeopening", Name = "Inauguración de Hogar & Deco", District = "residential", Spot = "residential_2", Hours = { 9, 21 },
		Desc = "25% de descuento en Hogar & Deco por su reapertura.",
		Effects = { Discount = { Cats = { "decor" }, Rate = 0.25 } },
		Goals = { { Type = "checkin", Reward = 100 } } },
	{ Id = "sportsday", Name = "Día del deporte", District = "beach", Spot = "beach_1", Hours = { 8, 19 },
		Desc = "Torneo ficticio en la playa. Retos y aventuras con más visitas.",
		Effects = { ViewBonus = { Cats = { "challenge", "adventure" }, Mult = 1.3 }, EventSpotBonus = 1.25 },
		Goals = { { Type = "checkin", Reward = 120 }, { Type = "scene", N = 3, Reward = 300 } } },
	{ Id = "gamecon", Name = "Convención de videojuegos", District = "entertainment", Spot = "entertainment_2", Hours = { 12, 24 },
		Desc = "Novedades de juegos ficticios. Consolas y mandos un 20% más baratos.",
		Effects = { Discount = { Cats = { "gadget" }, Rate = 0.2 }, ViewBonus = { Cats = { "gaming" }, Mult = 1.35 }, EventSpotBonus = 1.2 },
		Goals = { { Type = "checkin", Reward = 120 }, { Type = "publish", N = 1, Cats = { "gaming" }, Reward = 350 } } },
	{ Id = "fleamarket", Name = "Mercado de segunda mano", District = "secondhand", Spot = "secondhand_1", Hours = { 7, 15 },
		Desc = "Puestos de objetos usados con precios aún más bajos.",
		Effects = { UsedDiscount = 0.2, ViewBonus = { Cats = { "budget", "shopping" }, Mult = 1.2 } },
		Goals = { { Type = "checkin", Reward = 100 }, { Type = "photo", MinQ = 45, Reward = 150 } } },
	{ Id = "decorcontest", Name = "Concurso de decoración", District = "apartments", Spot = "apartments_1", Hours = { 8, 22 },
		Desc = "Las mejores salas ganan premios (decoración de tu propiedad).",
		Effects = { ViewBonus = { Cats = { "decor" }, Mult = 1.25 } },
		Goals = { { Type = "decor", Min = 15, Reward = 250 }, { Type = "decor", Min = 30, Reward = 600 } } },
	{ Id = "tourism", Name = "Semana del turismo", District = "tourist", Spot = "tourist_1", Hours = { 8, 21 },
		Desc = "Taxis a mitad de precio y más interés por los vídeos de turismo.",
		Effects = { TaxiDiscount = 0.5, ViewBonus = { Cats = { "tourism", "travel", "places" }, Mult = 1.3 }, EventSpotBonus = 1.2 },
		Goals = { { Type = "checkin", Reward = 120 }, { Type = "photo", MinQ = 55, Reward = 200 }, { Type = "publish", N = 1, Cats = { "tourism", "travel", "places" }, Reward = 300 } } },
	{ Id = "videochallenge", Name = "Desafío de vídeos", District = "creators", Spot = "creators_1", Hours = { 0, 24 },
		Desc = "Publica dos vídeos hoy para completar el desafío.",
		Effects = { ViewBonus = { Cats = {}, Mult = 1.0 } },
		Goals = { { Type = "publish", N = 1, Reward = 150 }, { Type = "publish", N = 2, Reward = 400 } } },
}
EventData.ById = {}
for _, e in ipairs(EventData.Events) do
	EventData.ById[e.Id] = e
end

-- Evento del día (rotación determinista)
function EventData.forDay(day)
	local n = #EventData.Events
	return EventData.Events[((day * 7) % n) + 1]
end

function EventData.goalText(g)
	if g.Type == "checkin" then
		return "Ve al lugar del evento"
	elseif g.Type == "photo" then
		return "Foto en el lugar con calidad " .. g.MinQ .. "+"
	elseif g.Type == "scene" then
		return "Graba " .. g.N .. " escenas en el lugar"
	elseif g.Type == "publish" then
		local t = "Publica " .. g.N .. " vídeo" .. (g.N > 1 and "s" or "") .. " hoy"
		if g.MinEdit then
			t = t .. " con edición " .. g.MinEdit .. "+"
		end
		if g.Cats then
			t = t .. " (categoría del evento)"
		end
		return t
	elseif g.Type == "decor" then
		return "Ten una sala con decoración " .. g.Min .. "+"
	end
	return g.Type
end

return EventData
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000006"><Properties><string name="Name">FoodData</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- FoodData: comida, recetas y menús. Los alimentos son objetos del inventario (categoría "food")
-- que se consumen. Energía y ánimo tienen efectos moderados y nunca impiden jugar.

local FoodData = {}

-- Ingredientes y productos del supermercado: { id, nombre, precio, energía, ánimo }
FoodData.Groceries = {
	{ "food_eggs", "Huevos (6)", 4, 6, 1 }, { "food_bread", "Pan", 2, 6, 1 }, { "food_tomato", "Tomates", 3, 3, 1 },
	{ "food_pasta", "Pasta", 3, 8, 1 }, { "food_rice", "Arroz", 3, 8, 1 }, { "food_chicken", "Pollo", 8, 10, 2 },
	{ "food_veggies", "Verduras variadas", 5, 5, 2 }, { "food_cheese", "Queso", 5, 6, 2 }, { "food_milk", "Leche", 2, 5, 1 },
	{ "food_fruit", "Fruta fresca", 4, 6, 3 }, { "food_flour", "Harina", 2, 2, 0 }, { "food_fish", "Pescado", 10, 10, 2 },
	{ "food_water", "Agua", 1, 4, 1 }, { "food_juice", "Zumo", 3, 8, 3 }, { "food_bar", "Barrita energética", 3, 18, 1 },
	{ "food_chips", "Patatas fritas", 2, 6, 4 }, { "food_soda", "Refresco", 2, 8, 3 }, { "food_sandwich", "Bocadillo", 5, 16, 3 },
}

-- Platos cocinados en casa (no se venden: se cocinan) o pedidos a domicilio
FoodData.Meals = {
	{ "meal_omelette", "Tortilla de patatas", 30, 10 }, { "meal_pasta", "Pasta con tomate", 34, 9 },
	{ "meal_chickenrice", "Arroz con pollo", 42, 12 }, { "meal_salad", "Ensalada fresca", 22, 14 },
	{ "meal_pizza", "Pizza casera", 38, 18 }, { "meal_fish", "Pescado al horno", 44, 14 },
	{ "meal_smoothie", "Batido de frutas", 20, 16 }, { "meal_gourmet", "Sándwich gourmet", 36, 15 },
	{ "meal_burger", "Hamburguesa a domicilio", 36, 16 }, { "meal_sushi", "Sushi a domicilio", 34, 20 },
	{ "meal_noodles", "Fideos a domicilio", 32, 14 },
}

FoodData.Recipes = {
	{ Id = "meal_omelette", Needs = { "food_eggs", "food_veggies" }, Time = 3 },
	{ Id = "meal_pasta", Needs = { "food_pasta", "food_tomato" }, Time = 3 },
	{ Id = "meal_chickenrice", Needs = { "food_rice", "food_chicken", "food_veggies" }, Time = 5 },
	{ Id = "meal_salad", Needs = { "food_veggies", "food_tomato", "food_cheese" }, Time = 2 },
	{ Id = "meal_pizza", Needs = { "food_flour", "food_tomato", "food_cheese" }, Time = 5 },
	{ Id = "meal_fish", Needs = { "food_fish", "food_veggies" }, Time = 4 },
	{ Id = "meal_smoothie", Needs = { "food_fruit", "food_milk" }, Time = 1 },
	{ Id = "meal_gourmet", Needs = { "food_bread", "food_cheese", "food_chicken" }, Time = 2 },
}

-- Menús de lugares (se comen allí mismo): { id, nombre, precio, energía, ánimo }
FoodData.Menus = {
	restaurant = { Name = "Restaurante La Plaza", Items = {
		{ "r_menu", "Menú del día", 14, 40, 14 }, { "r_paella", "Paella", 18, 42, 18 }, { "r_steak", "Filete con patatas", 22, 48, 16 },
		{ "r_dessert", "Postre de la casa", 6, 10, 14 }, { "r_tasting", "Menú degustación", 60, 55, 30 } } },
	cafe = { Name = "Cafetería", Items = {
		{ "c_coffee", "Café", 2, 12, 5 }, { "c_latte", "Café con leche", 3, 14, 6 }, { "c_croissant", "Cruasán", 3, 12, 6 },
		{ "c_cake", "Tarta", 5, 14, 10 }, { "c_tea", "Té", 2, 8, 6 } } },
	vending = { Name = "Máquina expendedora", Items = {
		{ "v_water", "Agua", 1, 4, 1 }, { "v_soda", "Refresco", 2, 8, 3 }, { "v_bar", "Barrita energética", 3, 18, 1 }, { "v_chips", "Patatas fritas", 2, 6, 4 } } },
}
FoodData.Delivery = { Fee = 5, Seconds = 60, Items = { "meal_burger", "meal_sushi", "meal_noodles", "meal_pizza" }, Prices = { meal_burger = 12, meal_sushi = 16, meal_noodles = 11, meal_pizza = 14 } }

return FoodData
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000007"><Properties><string name="Name">ItemCatalog</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- ItemCatalog: catálogo único de objetos. Lo usan tiendas, inventario, montaje de PC,
-- grabación, comparador y misiones. Todas las marcas son ficticias.
--
-- Campos de cada objeto:
--   Id, Name, Brand, Cat, Sub, Price, Quality (1-100), Desc, Stats, Compat, Req {Level},
--   Slot (uso), Portable (se puede llevar en la mochila), Size (espacios de mochila),
--   Stores (tiendas físicas que lo venden), Color {r,g,b}, Shape (modelo de exposición),
--   Hidden (no se vende), Upgradable.

local ItemCatalog = {}

ItemCatalog.Categories = {
	{ Key = "pc", Name = "Computadores" },
	{ Key = "laptop", Name = "Portátiles" },
	{ Key = "monitor", Name = "Monitores" },
	{ Key = "peripheral", Name = "Periféricos" },
	{ Key = "furniture", Name = "Sillas y escritorios" },
	{ Key = "storage", Name = "Almacenamiento" },
	{ Key = "component", Name = "Componentes" },
	{ Key = "camera", Name = "Cámaras" },
	{ Key = "audio", Name = "Micrófonos" },
	{ Key = "accessory", Name = "Accesorios" },
	{ Key = "phone", Name = "Teléfonos" },
	{ Key = "tablet", Name = "Tabletas" },
	{ Key = "gadget", Name = "Gadgets y consolas" },
	{ Key = "decor", Name = "Muebles y decoración" },
	{ Key = "food", Name = "Comida y bebida" },
}

ItemCatalog.Stores = {
	tech = { Name = "MegaTec", Cats = { "pc", "laptop", "monitor", "peripheral", "storage", "component" } },
	camera = { Name = "FotoPro", Cats = { "camera", "accessory", "audio" } },
	phone = { Name = "Conecta Móvil", Cats = { "phone", "tablet", "gadget" } },
	creator = { Name = "Creator Hub", Cats = { "accessory", "audio", "furniture", "peripheral" } },
	home = { Name = "Hogar & Deco", Cats = { "decor", "furniture" } },
	market = { Name = "Supermercado Fresco", Cats = { "food" } },
}

local Items = {}
local Order = {}

local defaultShape = {
	pc = "tower", laptop = "laptop", monitor = "monitor", peripheral = "box", furniture = "box",
	storage = "box", component = "box", camera = "camera", audio = "mic", accessory = "box",
	phone = "phone", tablet = "phone", gadget = "box",
}

local function add(cat, sub, data)
	data.Cat = cat
	data.Sub = sub
	data.Stats = data.Stats or {}
	data.Compat = data.Compat or {}
	data.Req = data.Req or { Level = 1 }
	data.Size = data.Size or 1
	if data.Portable == nil then
		data.Portable = false
	end
	data.Shape = data.Shape or defaultShape[cat] or "box"
	data.Color = data.Color or { 60, 64, 72 }
	data.Quality = data.Quality or 50
	assert(Items[data.Id] == nil, "Id duplicado: " .. data.Id)
	Items[data.Id] = data
	Order[#Order + 1] = data.Id
	return data
end

---------------------------------------------------------------------------
-- COMPONENTES
---------------------------------------------------------------------------
-- Procesadores (Score = rendimiento relativo, Tdp = calor/consumo en W)
add("component", "cpu", { Id = "cpu_n3_210", Name = "Nexo C3-210", Brand = "Nexo", Price = 90, Quality = 25,
	Desc = "Procesador básico de 4 núcleos con gráficos integrados.",
	Stats = { Score = 20, Tdp = 45, IGpu = 6, Cores = 4 }, Compat = { Socket = "N4" } })
add("component", "cpu", { Id = "cpu_n5_420", Name = "Nexo C5-420", Brand = "Nexo", Price = 180, Quality = 45,
	Desc = "6 núcleos equilibrados para oficina y edición ligera. Con gráficos integrados.",
	Stats = { Score = 38, Tdp = 65, IGpu = 9, Cores = 6 }, Compat = { Socket = "N4" } })
add("component", "cpu", { Id = "cpu_n7_640", Name = "Nexo C7-640", Brand = "Nexo", Price = 340, Quality = 65,
	Desc = "8 núcleos de alto rendimiento. Necesita tarjeta gráfica.",
	Stats = { Score = 60, Tdp = 105, IGpu = 0, Cores = 8 }, Compat = { Socket = "N4" } })
add("component", "cpu", { Id = "cpu_n9_880", Name = "Nexo C9-880", Brand = "Nexo", Price = 590, Quality = 84,
	Desc = "Tope de gama de Nexo. Mucho calor: usa refrigeración líquida.",
	Stats = { Score = 82, Tdp = 150, IGpu = 0, Cores = 16 }, Compat = { Socket = "N4" }, Req = { Level = 4 } })
add("component", "cpu", { Id = "cpu_k5_500", Name = "Kairo R5 500", Brand = "Kairo", Price = 210, Quality = 50,
	Desc = "6 núcleos eficientes con gráficos integrados decentes.",
	Stats = { Score = 42, Tdp = 65, IGpu = 10, Cores = 6 }, Compat = { Socket = "K5" } })
add("component", "cpu", { Id = "cpu_k7_700", Name = "Kairo R7 700", Brand = "Kairo", Price = 360, Quality = 68,
	Desc = "8 núcleos rápidos y fríos. Ideal para edición 4K.",
	Stats = { Score = 66, Tdp = 95, IGpu = 0, Cores = 8 }, Compat = { Socket = "K5" } })
add("component", "cpu", { Id = "cpu_k9_900", Name = "Kairo R9 900", Brand = "Kairo", Price = 640, Quality = 88,
	Desc = "16 núcleos para creadores exigentes.",
	Stats = { Score = 88, Tdp = 140, IGpu = 0, Cores = 16 }, Compat = { Socket = "K5" }, Req = { Level = 5 } })
add("component", "cpu", { Id = "cpu_kx_thread", Name = "Kairo Threadmax 64", Brand = "Kairo", Price = 1400, Quality = 98,
	Desc = "Procesador de estación de trabajo. Requiere placa KX.",
	Stats = { Score = 100, Tdp = 220, IGpu = 0, Cores = 64 }, Compat = { Socket = "KX" }, Req = { Level = 8 } })

-- Placas base
add("component", "mobo", { Id = "mobo_n4_basic", Name = "Ferro B4 mATX (N4)", Brand = "Ferro", Price = 80, Quality = 35,
	Desc = "Placa básica para Nexo. DDR4, 2 ranuras de almacenamiento.",
	Compat = { Socket = "N4", RamType = "DDR4", Form = "mATX", StorageSlots = 2, FanHeaders = 3 } })
add("component", "mobo", { Id = "mobo_n4_pro", Name = "Ferro Z4 Pro ATX (N4)", Brand = "Ferro", Price = 190, Quality = 70,
	Desc = "Placa ATX con DDR5 y 4 ranuras de almacenamiento.",
	Compat = { Socket = "N4", RamType = "DDR5", Form = "ATX", StorageSlots = 4, FanHeaders = 6 } })
add("component", "mobo", { Id = "mobo_n4_itx", Name = "Ferro Mini ITX (N4)", Brand = "Ferro", Price = 170, Quality = 62,
