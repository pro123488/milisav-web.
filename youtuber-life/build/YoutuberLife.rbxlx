	add("gadget", g[3], { Id = g[1], Name = g[2], Brand = "", Price = g[4], Quality = g[5],
		Desc = g[3] .. " para usar y reseñar. Llévalo en la mochila para grabar una prueba real.",
		Stats = g[6], Portable = portable, Slot = g[1] == "drone_mini" and "drone" or "product", Size = (g[3] == "Consola" and 2) or 1 })
end

---------------------------------------------------------------------------
-- MUEBLES Y DECORACIÓN (colocables en tus propiedades con el modo construcción)
-- Decor = cuánto mejora la sala para grabar. Foot = huella {ancho, fondo, alto} en studs.
---------------------------------------------------------------------------
local styles = {
	{ "modern", "Moderno", 1.0, { 230, 230, 235 } }, { "minimal", "Minimalista", 0.9, { 245, 245, 245 } },
	{ "industrial", "Industrial", 1.0, { 90, 85, 80 } }, { "classic", "Clásico", 1.2, { 140, 90, 60 } },
	{ "tech", "Tecnológico", 1.3, { 40, 120, 200 } }, { "gamer", "Gamer", 1.2, { 200, 40, 220 } },
	{ "luxury", "Lujoso", 3.0, { 230, 190, 90 } }, { "budget", "Económico", 0.45, { 170, 170, 160 } },
	{ "natural", "Natural", 1.0, { 120, 160, 100 } }, { "futuristic", "Futurista", 1.8, { 80, 230, 230 } },
	{ "pro", "Profesional", 1.5, { 50, 55, 65 } }, { "creative", "Creativo", 1.1, { 255, 120, 90 } },
}
local pieces = {
	{ "sofa", "Sofá", 220, 6, "sofa", { 8, 3, 3 } },
	{ "lamp", "Lámpara", 60, 3, "lamp", { 2, 2, 6 } },
	{ "art", "Cuadro", 90, 4, "painting", { 5, 1, 4 } },
}
for _, st in ipairs(styles) do
	for _, pc in ipairs(pieces) do
		local price = math.floor(pc[3] * st[3] / 5 + 0.5) * 5
		local q = math.floor(math.min(98, 30 + st[3] * 22))
		add("decor", pc[2], { Id = "dec_" .. pc[1] .. "_" .. st[1], Name = pc[2] .. " " .. st[2]:lower(), Brand = "", Price = price, Quality = q,
			Desc = pc[2] .. " de estilo " .. st[2]:lower() .. ". Combina 3 piezas del mismo estilo para un bonus de decoración.",
			Stats = { Decor = math.floor(pc[4] * (0.7 + st[3] * 0.3) + 0.5) }, Style = st[1], Placeable = true, Foot = pc[6], Shape = pc[5], Color = st[4],
			Req = { Level = st[1] == "luxury" and 6 or 1 } })
	end
end
local generic = {
	{ "dec_plant_small", "Planta pequeña", "Planta", 25, 2, "plant", { 2, 2, 3 }, { 60, 150, 70 } },
	{ "dec_plant_big", "Palmera de interior", "Planta", 80, 4, "plant", { 3, 3, 7 }, { 50, 140, 60 } },
	{ "dec_rug", "Alfombra grande", "Alfombra", 70, 3, "rug", { 10, 7, 0.2 }, { 160, 60, 70 } },
	{ "dec_bookshelf", "Estantería con libros", "Estantería", 130, 4, "shelf", { 6, 2, 8 }, { 120, 85, 55 } },
	{ "dec_bed_single", "Cama individual", "Cama", 160, 3, "bed", { 5, 8, 2 }, { 240, 240, 250 } },
	{ "dec_bed_double", "Cama de matrimonio", "Cama", 380, 5, "bed", { 8, 9, 2 }, { 230, 230, 245 } },
	{ "dec_table", "Mesa de comedor", "Mesa", 150, 3, "table", { 8, 5, 3 }, { 140, 100, 70 } },
	{ "dec_coffee", "Mesa de centro", "Mesa", 70, 2, "table", { 5, 3, 1.6 }, { 90, 70, 50 } },
	{ "dec_curtain", "Cortinas de terciopelo", "Cortinas", 90, 3, "curtain", { 8, 1, 10 }, { 140, 30, 50 } },
	{ "dec_acoustic", "Paneles acústicos", "Acústica", 240, 6, "panel", { 8, 1, 6 }, { 60, 60, 70 }, true },
	{ "dec_rack", "Estantería de almacenaje", "Almacenaje", 110, 1, "shelf", { 6, 2, 8 }, { 80, 80, 85 } },
	{ "dec_partition", "Tabique móvil", "Distribución", 120, 0, "partition", { 10, 1, 12 }, { 225, 220, 210 } },
	{ "dec_lightstand", "Foco de estudio con soporte", "Iluminación", 320, 7, "lamp", { 2, 2, 8 }, { 255, 255, 240 } },
	{ "dec_neon", "Letrero de neón ON AIR", "Decoración", 150, 6, "neon", { 6, 1, 2 }, { 255, 40, 80 } },
	{ "dec_trophy", "Vitrina de trofeos", "Decoración", 260, 6, "shelf", { 5, 2, 7 }, { 230, 190, 90 } },
	{ "dec_beanbag", "Puf gamer", "Asiento", 60, 2, "beanbag", { 3, 3, 2 }, { 200, 40, 220 } },
	{ "dec_seccam", "Cámara de seguridad", "Seguridad", 140, 0, "seccam", { 1, 1, 1 }, { 30, 30, 34 } },
}
for _, g in ipairs(generic) do
	add("decor", g[3], { Id = g[1], Name = g[2], Brand = "", Price = g[4], Quality = math.min(90, 30 + g[5] * 8),
		Desc = g[2] .. (g[9] and ". Reduce el ruido al grabar en la sala." or ".") .. " Se coloca con el modo construcción.",
		Stats = { Decor = g[5], Acoustic = g[9] and 2 or nil }, Placeable = true, Foot = g[7], Shape = g[6], Color = g[8] })
end
-- Las sillas y escritorios también se pueden colocar
for _, id in ipairs(Order) do
	local it = Items[id]
	if it.Cat == "furniture" then
		it.Placeable = true
		it.Foot = it.Shape == "chair" and { 3, 3, 4 } or { 8, 4, 3 }
		it.Stats.Decor = math.floor(it.Quality / 25)
	end
end

---------------------------------------------------------------------------
-- COMIDA (consumible: se come desde el inventario, no ocupa espacio en la mochila)
---------------------------------------------------------------------------
local FoodData = require(script.Parent.FoodData)
for _, g in ipairs(FoodData.Groceries) do
	add("food", "Alimento", { Id = g[1], Name = g[2], Brand = "", Price = g[3], Quality = 40,
		Desc = "Energía +" .. g[4] .. ", ánimo +" .. g[5] .. ". Se usa como ingrediente o se come tal cual.",
		Stats = { Energy = g[4], Mood = g[5] }, Portable = true, Size = 0, Slot = "food", Color = { 230, 170, 90 } })
end
for _, m in ipairs(FoodData.Meals) do
	add("food", "Plato", { Id = m[1], Name = m[2], Brand = "", Price = 0, Quality = 70,
		Desc = "Plato preparado. Energía +" .. m[3] .. ", ánimo +" .. m[4] .. ".",
		Stats = { Energy = m[3], Mood = m[4] }, Portable = true, Size = 0, Slot = "food", Hidden = true, Color = { 240, 120, 80 } })
end

---------------------------------------------------------------------------
-- Finalización: precio de los PC completos = suma de piezas (con 5% de descuento de montaje)
---------------------------------------------------------------------------
for _, id in ipairs(Order) do
	local item = Items[id]
	if item.Cat == "pc" then
		local total = 0
		for slot, partId in pairs(item.Parts) do
			if type(partId) == "table" then
				for _, p in ipairs(partId) do
					total = total + assert(Items[p], "Pieza inexistente " .. p).Price
				end
			else
				total = total + assert(Items[partId], "Pieza inexistente " .. partId).Price
			end
		end
		item.Price = math.floor(total * 0.95 / 10 + 0.5) * 10
		if item.Id == "pc_old" then
			item.Hidden = true
			item.Price = 150
		end
	end
	-- Tiendas físicas que lo venden
	item.Stores = {}
	for storeId, store in pairs(ItemCatalog.Stores) do
		for _, cat in ipairs(store.Cats) do
			if cat == item.Cat then
				table.insert(item.Stores, storeId)
			end
		end
	end
	table.sort(item.Stores)
end

ItemCatalog.Items = Items
ItemCatalog.Order = Order

function ItemCatalog.get(id)
	return Items[id]
end

function ItemCatalog.isForSale(id)
	local item = Items[id]
	return item ~= nil and not item.Hidden and item.Price > 0
end

function ItemCatalog.list(filter)
	local out = {}
	for _, id in ipairs(Order) do
		local item = Items[id]
		if not item.Hidden then
			local ok = true
			if filter then
				if filter.Cat and item.Cat ~= filter.Cat then
					ok = false
				end
				if filter.Store and not table.concat(item.Stores, ","):find(filter.Store, 1, true) then
					ok = false
				end
			end
			if ok then
				out[#out + 1] = item
			end
		end
	end
	return out
end

function ItemCatalog.categoryName(key)
	for _, c in ipairs(ItemCatalog.Categories) do
		if c.Key == key then
			return c.Name
		end
	end
	return key
end

-- Ventajas y desventajas generadas a partir de las estadísticas reales (para el comparador).
function ItemCatalog.prosCons(item)
	local pros, cons = {}, {}
	local s = item.Stats
	if item.Quality >= 80 then
		pros[#pros + 1] = "Calidad muy alta"
	elseif item.Quality <= 30 then
		cons[#cons + 1] = "Calidad básica"
	end
	if item.Price <= 100 and item.Price > 0 then
		pros[#pros + 1] = "Muy asequible"
	elseif item.Price >= 1500 then
		cons[#cons + 1] = "Precio elevado"
	end
	if item.Portable then
		pros[#pros + 1] = "Portátil (cabe en la mochila)"
	end
	if s.Weather then
		pros[#pros + 1] = "Resistente a la lluvia"
	end
	if s.LowLight and s.LowLight >= 75 then
		pros[#pros + 1] = "Excelente con poca luz"
	elseif s.LowLight and s.LowLight < 35 then
		cons[#cons + 1] = "Sufre con poca luz"
	end
	if s.Battery and s.Battery >= 18 then
		pros[#pros + 1] = "Gran autonomía"
	elseif s.Battery and s.Battery <= 10 then
		cons[#cons + 1] = "Batería corta"
	end
	if s.Tdp and s.Tdp >= 140 then
		cons[#cons + 1] = "Necesita mucha refrigeración"
	end
	if s.Watts and item.Sub == "gpu" and s.Watts >= 300 then
		cons[#cons + 1] = "Consumo muy alto"
	end
	if s.Noise and s.Noise >= 5 then
		cons[#cons + 1] = "Ruidoso"
	end
	if s.GbPerMin and s.GbPerMin >= 4 then
		cons[#cons + 1] = "Archivos muy pesados"
	end
	if item.Req and item.Req.Level and item.Req.Level >= 5 then
		cons[#cons + 1] = "Requiere nivel " .. item.Req.Level
	end
	return pros, cons
end

return ItemCatalog
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000008"><Properties><string name="Name">MonetizationConfig</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- MonetizationConfig: COLOCA AQUÍ TUS IDS REALES.
--
-- Todos los Id están en 0 a propósito: no se inventan identificadores.
-- Mientras un Id sea 0, el producto aparece como "No configurado" y no se puede comprar.
-- Crea los Game Passes y Developer Products en create.roblox.com (Monetización) y pega sus números.
--
-- Las ventajas están limitadas para no romper el equilibrio: el juego es completo sin pagar.

local MonetizationConfig = {}

MonetizationConfig.GamePasses = {
	VIP = {
		Id = 0,
		Name = "VIP",
		Description = "Etiqueta VIP, +10% de dinero en empleos y acceso a la sala VIP del Distrito de eventos.",
		Perks = { JobBonus = 0.10, VipRoom = true, ChatTag = true },
	},
	BigBackpack = {
		Id = 0,
		Name = "Mochila ampliada",
		Description = "+4 espacios de mochila para llevar más equipo.",
		Perks = { BackpackSlots = 4 },
	},
	MoreProjects = {
		Id = 0,
		Name = "Más espacios para proyectos",
		Description = "+6 proyectos de vídeo simultáneos.",
		Perks = { ProjectSlots = 6 },
	},
	PCTheme = {
		Id = 0,
		Name = "Tema exclusivo del computador",
		Description = "Fondos de escritorio y colores exclusivos para el sistema operativo del juego (cosmético).",
		Perks = { Wallpapers = true },
	},
	LightingPack = {
		Id = 0,
		Name = "Paquete de iluminación",
		Description = "Filtros de foto y estilos de miniatura adicionales (cosmético, sin bonus de calidad).",
		Perks = { ExtraFilters = true },
	},
	ChannelPack = {
		Id = 0,
		Name = "Personalización del canal",
		Description = "Banners y avatares de canal exclusivos (cosmético).",
		Perks = { ExtraBanners = true },
	},
}

-- Developer Products: se procesan con ProcessReceipt de forma idempotente.
MonetizationConfig.Products = {
	CashSmall = { Id = 0, Name = "Paquete de dinero pequeño", Grant = { Money = 2500 } },
	CashMedium = { Id = 0, Name = "Paquete de dinero mediano", Grant = { Money = 8000 } },
	CashLarge = { Id = 0, Name = "Paquete de dinero grande", Grant = { Money = 20000 } },
	ExportBoost = { Id = 0, Name = "Exportación instantánea (1 uso)", Grant = { ExportTokens = 1 } },
}

function MonetizationConfig.isConfigured(entry)
	return entry ~= nil and type(entry.Id) == "number" and entry.Id > 0
end

return MonetizationConfig
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000009"><Properties><string name="Name">PCBuild</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- PCBuild: compatibilidad y rendimiento de computadores.
-- Recibe tablas de IDs de catálogo: { case=, cpu=, mobo=, ram=, gpu=, psu=, cooling=, storage={...}, fans={...} }
-- El servidor SIEMPRE vuelve a validar; el cliente lo usa solo para la vista previa.

local ItemCatalog = require(script.Parent.ItemCatalog)

local PCBuild = {}

PCBuild.Slots = {
	{ Key = "case", Name = "Gabinete", Sub = "case", Required = true },
	{ Key = "mobo", Name = "Placa base", Sub = "mobo", Required = true },
	{ Key = "cpu", Name = "Procesador", Sub = "cpu", Required = true },
	{ Key = "ram", Name = "Memoria RAM", Sub = "ram", Required = true },
	{ Key = "gpu", Name = "Tarjeta gráfica", Sub = "gpu", Required = false },
	{ Key = "storage", Name = "Almacenamiento", Sub = "internal", Multi = true, Required = true },
	{ Key = "cooling", Name = "Refrigeración", Sub = "cooling", Required = true },
	{ Key = "psu", Name = "Fuente de alimentación", Sub = "psu", Required = true },
	{ Key = "fans", Name = "Ventiladores", Sub = "fan", Multi = true, Required = false },
}

PCBuild.BaseWatts = 60
PCBuild.MaxScenesByTier = { 6, 10, 16, 22, 30, 40 }
PCBuild.TierNames = { "Básico", "Oficina", "Medio", "Avanzado", "Profesional", "Estación de trabajo" }

local function get(id)
	if id == nil then
		return nil
	end
	return ItemCatalog.get(id)
end

local function slotMatches(item, slot)
	if item == nil then
		return false
	end
	if slot.Key == "storage" then
		return item.Cat == "storage" and item.Sub == "internal"
	end
	return item.Cat == "component" and item.Sub == slot.Sub
end

function PCBuild.slotFor(item)
	for _, slot in ipairs(PCBuild.Slots) do
		if slotMatches(item, slot) then
			return slot
		end
	end
	return nil
end

local function contains(list, v)
	for _, x in ipairs(list) do
		if x == v then
			return true
		end
	end
	return false
end

function PCBuild.totalWatts(parts)
	local w = PCBuild.BaseWatts
	local cpu, gpu = get(parts.cpu), get(parts.gpu)
	if cpu then
		w = w + cpu.Stats.Tdp
	end
	if gpu then
		w = w + gpu.Stats.Watts
	end
	w = w + #(parts.storage or {}) * 6 + #(parts.fans or {}) * 3
	return w
end

-- Devuelve ok, errores (impiden montar), avisos (se puede montar pero con penalización)
function PCBuild.validate(parts)
	local errors, warnings = {}, {}
	parts = parts or {}

	for _, slot in ipairs(PCBuild.Slots) do
		local v = parts[slot.Key]
		if slot.Multi then
			v = v or {}
			if slot.Required and #v == 0 then
				errors[#errors + 1] = "Falta: " .. slot.Name
			end
			for _, id in ipairs(v) do
				if not slotMatches(get(id), slot) then
					errors[#errors + 1] = "Pieza no válida en " .. slot.Name
				end
			end
		else
			if v == nil then
				if slot.Required then
					errors[#errors + 1] = "Falta: " .. slot.Name
				end
			elseif not slotMatches(get(v), slot) then
				errors[#errors + 1] = "Pieza no válida en " .. slot.Name
			end
		end
	end

	-- Si alguna pieza está en una ranura que no le corresponde, no seguir comprobando
	if #errors > 0 then
		return false, errors, warnings
	end

	local case, mobo, cpu, ram, gpu, psu, cool = get(parts.case), get(parts.mobo), get(parts.cpu), get(parts.ram), get(parts.gpu), get(parts.psu), get(parts.cooling)

	if cpu and mobo and cpu.Compat.Socket ~= mobo.Compat.Socket then
		errors[#errors + 1] = "El procesador (" .. cpu.Compat.Socket .. ") no encaja en la placa (" .. mobo.Compat.Socket .. ")."
	end
	if ram and mobo and ram.Compat.RamType ~= mobo.Compat.RamType then
		errors[#errors + 1] = "La placa usa " .. mobo.Compat.RamType .. " y la memoria es " .. ram.Compat.RamType .. "."
	end
	if case and mobo and not contains(case.Compat.Forms, mobo.Compat.Form) then
		errors[#errors + 1] = "La placa " .. mobo.Compat.Form .. " no cabe en el gabinete " .. case.Name .. "."
	end
	if case and gpu and gpu.Compat.Length > case.Compat.MaxGpu then
		errors[#errors + 1] = "La gráfica mide " .. gpu.Compat.Length .. " cm y el gabinete admite " .. case.Compat.MaxGpu .. " cm."
	end
	if mobo and parts.storage and #parts.storage > mobo.Compat.StorageSlots then
		errors[#errors + 1] = "La placa solo admite " .. mobo.Compat.StorageSlots .. " unidades de almacenamiento."
	end
	if case and parts.fans and #parts.fans > case.Stats.FanSlots then
		errors[#errors + 1] = "El gabinete solo admite " .. case.Stats.FanSlots .. " ventiladores."
	end
	if cpu and not gpu and (cpu.Stats.IGpu or 0) <= 0 then
		errors[#errors + 1] = "Este procesador no tiene gráficos integrados: añade una tarjeta gráfica."
	end
	if psu then
		local watts = PCBuild.totalWatts(parts)
		if watts > psu.Stats.Watts then
			errors[#errors + 1] = "Consumo " .. watts .. " W supera la fuente de " .. psu.Stats.Watts .. " W."
		elseif watts > psu.Stats.Watts * 0.85 then
			warnings[#warnings + 1] = "La fuente va al límite (" .. watts .. "/" .. psu.Stats.Watts .. " W)."
		end
	end
	if cpu and cool and cool.Stats.Capacity < cpu.Stats.Tdp then
		warnings[#warnings + 1] = "Refrigeración insuficiente: el procesador reducirá su velocidad (-20%)."
	end

	return #errors == 0, errors, warnings
end

local function ramFactor(gb)
	if gb >= 128 then
		return 1.25
	elseif gb >= 64 then
		return 1.18
	elseif gb >= 32 then
		return 1.1
	elseif gb >= 16 then
		return 1.0
	end
	return 0.8
end

function PCBuild.tierFromScore(score)
	if score < 25 then
		return 1
	elseif score < 40 then
		return 2
	elseif score < 55 then
		return 3
	elseif score < 70 then
		return 4
	elseif score < 85 then
		return 5
	end
	return 6
end

local function finish(stats)
	stats.Tier = PCBuild.tierFromScore(stats.Score)
	stats.TierName = PCBuild.TierNames[stats.Tier]
	stats.MaxScenes = PCBuild.MaxScenesByTier[stats.Tier]
	-- multiplicador de velocidad de render (más alto = exporta más rápido)
	stats.RenderMult = (0.6 + stats.Score / 50) * (1 + ((stats.StorageSpeed or 1) - 1) * 0.04)
	return stats
end

-- Estadísticas de un montaje (asume que validate() ya pasó o devuelve valores parciales)
function PCBuild.stats(parts, conditionFactor)
	parts = parts or {}
	local cpu, gpu, ram, cool, case = get(parts.cpu), get(parts.gpu), get(parts.ram), get(parts.cooling), get(parts.case)
	local cpuScore = cpu and cpu.Stats.Score or 0
	local gpuScore = gpu and gpu.Stats.Score or ((cpu and cpu.Stats.IGpu or 0) * 1.5)
	local ramGb = ram and ram.Stats.Gb or 0
	local score = (cpuScore * 0.55 + gpuScore * 0.45) * ramFactor(ramGb)

	local throttled = false
	if cpu and cool and cool.Stats.Capacity < cpu.Stats.Tdp then
		score = score * 0.8
		throttled = true
	end
	score = score * (conditionFactor or 1)

	local airflow = case and case.Stats.Airflow or 3
	local noise = cool and cool.Stats.Noise or 6
	for _, f in ipairs(parts.fans or {}) do
		local fan = get(f)
		if fan then
			airflow = airflow + fan.Stats.Airflow
			noise = noise + fan.Stats.Noise
		end
	end
	if gpu then
		noise = noise + gpu.Stats.Watts / 120
	end
	local tdp = cpu and cpu.Stats.Tdp or 50
	local capacity = cool and cool.Stats.Capacity or 50
	local temp = 30 + 50 * (tdp / capacity) - airflow * 1.6
	if temp < 32 then
		temp = 32
	end
	if temp > 98 then
		temp = 98
	end

	local gb, speed = 0, 1
	for _, s in ipairs(parts.storage or {}) do
		local d = get(s)
		if d then
			gb = gb + d.Stats.Gb
			if d.Stats.Speed > speed then
				speed = d.Stats.Speed
			end
		end
	end

	local value = 0
	for _, slot in ipairs(PCBuild.Slots) do
		local v = parts[slot.Key]
		if type(v) == "table" then
			for _, id in ipairs(v) do
				local it = get(id)
				value = value + (it and it.Price or 0)
			end
		elseif v then
			local it = get(v)
			value = value + (it and it.Price or 0)
		end
	end

	return finish({
		Score = math.floor(score * 10 + 0.5) / 10,
		Watts = PCBuild.totalWatts(parts),
		Temp = math.floor(temp + 0.5),
		Noise = math.floor(math.min(10, noise) * 10 + 0.5) / 10,
		Throttled = throttled,
		Ram = ramGb,
		StorageGb = gb,
		StorageSpeed = speed,
		ProColor = gpu and gpu.Stats.ProColor or 0,
		PartsValue = value,
	})
end

function PCBuild.laptopStats(item, conditionFactor)
	local s = item.Stats
	local score = (s.CpuScore * 0.55 + s.GpuScore * 0.45) * ramFactor(s.Ram) * (conditionFactor or 1)
	return finish({
		Score = math.floor(score * 10 + 0.5) / 10,
		Watts = 90,
		Temp = 60,
		Noise = 3,
		Throttled = false,
		Ram = s.Ram,
		StorageGb = s.Gb,
		StorageSpeed = 6,
		ProColor = s.ProColor or 0,
		PartsValue = item.Price,
	})
end

-- Equipo público (cibercafé / biblioteca)
function PCBuild.publicStats()
	return finish({ Score = 18, Watts = 0, Temp = 50, Noise = 5, Throttled = false, Ram = 8, StorageGb = 200, StorageSpeed = 1, ProColor = 0, PartsValue = 0 })
end

return PCBuild
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000010"><Properties><string name="Name">Progression</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Progression: niveles de experiencia y rangos de creador.

local Progression = {}

function Progression.xpToNext(level)
	return math.floor(100 * level ^ 1.45)
end

-- Aplica XP y devuelve el nuevo nivel, la XP restante y cuántos niveles subió.
function Progression.applyXp(level, xp, gained)
	xp = xp + gained
	local ups = 0
	while xp >= Progression.xpToNext(level) and level < 100 do
		xp = xp - Progression.xpToNext(level)
		level = level + 1
		ups = ups + 1
	end
	return level, xp, ups
end

Progression.Ranks = {
	{ Name = "Creador principiante", Level = 1, Subs = 0, Videos = 0, Rep = 0, Unlock = "Funciones básicas" },
	{ Name = "Aficionado", Level = 2, Subs = 0, Videos = 1, Rep = 0, Unlock = "Tienda de tecnología completa" },
	{ Name = "Creador emergente", Level = 4, Subs = 50, Videos = 3, Rep = 12, Unlock = "Cámaras de vlog y equipo profesional" },
	{ Name = "Creador constante", Level = 6, Subs = 250, Videos = 8, Rep = 18, Unlock = "Componentes de gama alta" },
	{ Name = "Especialista", Level = 9, Subs = 1000, Videos = 15, Rep = 25, Unlock = "Cámaras de estudio" },
	{ Name = "Creador reconocido", Level = 12, Subs = 5000, Videos = 25, Rep = 35, Unlock = "Invitaciones a eventos" },
	{ Name = "Profesional", Level = 16, Subs = 20000, Videos = 40, Rep = 45, Unlock = "Estaciones de trabajo" },
	{ Name = "Estrella digital", Level = 20, Subs = 100000, Videos = 60, Rep = 55, Unlock = "Experiencias de lujo" },
	{ Name = "Empresario de contenido", Level = 25, Subs = 300000, Videos = 80, Rep = 65, Unlock = "Empresa de producción" },
	{ Name = "Magnate de medios", Level = 30, Subs = 1000000, Videos = 120, Rep = 75, Unlock = "Todo el contenido" },
}

function Progression.rankFor(level, subs, videos, rep)
	local best = 1
	for i, r in ipairs(Progression.Ranks) do
		if level >= r.Level and subs >= r.Subs and videos >= r.Videos and rep >= r.Rep then
			best = i
		end
	end
	return best, Progression.Ranks[best]
end

Progression.Xp = {
	Scene = 5,
	Photo = 2,
	Thumbnail = 8,
	Export = 10,
	PublishBase = 30,
	Purchase = 5,
	PCBuilt = 40,
	Job = 15,
	District = 10,
}

return Progression
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000011"><Properties><string name="Name">PropertyData</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- PropertyData: mercado inmobiliario (Fase 2). Cada anuncio es una propiedad concreta en un distrito,
-- con precio de compra y/o alquiler, mantenimiento, almacenamiento, espacio para muebles, calidad del entorno,
-- espacio para grabar, posibilidad de remodelar, valor de reventa y requisitos.

local PropertyData = {}

PropertyData.Kinds = {
	home = "Vivienda", studio = "Estudio", business = "Negocio", garage = "Garaje", land = "Terreno",
}

-- Mejora: coste y efecto real (lo aplica PropertyService)
PropertyData.Upgrades = {
	soundproof = { Name = "Aislamiento acústico", Cost = 2000, Desc = "−3 de ruido en las grabaciones dentro de la propiedad." },
	security = { Name = "Sistema de seguridad", Cost = 1500, Desc = "+5 de calidad del entorno (tranquilidad para grabar)." },
	storage = { Name = "Ampliación de almacenaje", Cost = 2500, Desc = "+50% de capacidad de almacenamiento." },
	lightrig = { Name = "Rig de iluminación de estudio", Cost = 3000, Desc = "+20 de luz en grabaciones y fotos de interior." },
}

PropertyData.Walls = {
	{ "Blanco", { 240, 240, 236 } }, { "Gris cálido", { 190, 182, 170 } }, { "Grafito", { 60, 62, 70 } }, { "Azul noche", { 30, 40, 80 } },
	{ "Verde salvia", { 150, 175, 145 } }, { "Terracota", { 190, 110, 80 } }, { "Rosa pastel", { 240, 190, 200 } }, { "Negro gamer", { 20, 20, 26 } },
	{ "Madera", { 150, 110, 75 } }, { "Ladrillo", { 160, 80, 60 } },
}
PropertyData.Floors = {
	{ "Parqué", "WoodPlanks", { 160, 120, 85 } }, { "Mármol", "Marble", { 235, 235, 235 } }, { "Moqueta", "Fabric", { 90, 90, 110 } },
	{ "Hormigón pulido", "Concrete", { 150, 150, 150 } }, { "Baldosa", "Slate", { 120, 115, 110 } }, { "Madera oscura", "Wood", { 90, 60, 40 } },
}
PropertyData.Lights = {
	{ "Cálida", { 255, 220, 170 }, 1.2 }, { "Neutra", { 255, 250, 240 }, 1.4 }, { "Fría", { 200, 225, 255 }, 1.4 },
	{ "Neón gamer", { 200, 80, 255 }, 1.6 }, { "Estudio", { 255, 255, 255 }, 2.2 },
}

-- Estilos de decoración: combinación sugerida de pared/suelo/luz
PropertyData.Styles = {
	{ Id = "modern", Name = "Moderno", Wall = 1, Floor = 1, Light = 2 },
	{ Id = "minimal", Name = "Minimalista", Wall = 1, Floor = 4, Light = 2 },
	{ Id = "industrial", Name = "Industrial", Wall = 10, Floor = 4, Light = 1 },
	{ Id = "classic", Name = "Clásico", Wall = 2, Floor = 6, Light = 1 },
	{ Id = "tech", Name = "Tecnológico", Wall = 3, Floor = 4, Light = 3 },
	{ Id = "gamer", Name = "Gamer", Wall = 8, Floor = 3, Light = 4 },
	{ Id = "luxury", Name = "Lujoso", Wall = 2, Floor = 2, Light = 1 },
	{ Id = "budget", Name = "Económico", Wall = 1, Floor = 5, Light = 2 },
	{ Id = "natural", Name = "Natural", Wall = 5, Floor = 1, Light = 1 },
	{ Id = "futuristic", Name = "Futurista", Wall = 4, Floor = 2, Light = 3 },
	{ Id = "pro", Name = "Profesional", Wall = 3, Floor = 3, Light = 5 },
	{ Id = "creative", Name = "Creativo", Wall = 7, Floor = 1, Light = 2 },
}
PropertyData.StyleById = {}
for _, s in ipairs(PropertyData.Styles) do
	PropertyData.StyleById[s.Id] = s
end

-- Anuncios. W/D = tamaño interior. Slots = muebles colocables. Storage = objetos guardados.
-- Env = calidad del entorno (0-100). Studio = bonus de interés al grabar dentro.
local L = {}
local function listing(t)
	t.Resale = t.Resale or 0.8
	t.Req = t.Req or { Level = 1, Subs = 0 }
	t.Remodel = t.Remodel ~= false
	L[#L + 1] = t
end

listing({ Id = "hotel_room", Name = "Habitación en el Gran Hotel", Type = "Habitación de hotel", Kind = "home", District = "hotels", Rent = 300, Upkeep = 0, Storage = 40, Slots = 6, Env = 70, Studio = 2, W = 26, D = 22, Remodel = false, Tags = { "luxury", "tourism" } })
listing({ Id = "apt_small", Name = "Apartamento pequeño en la Zona de apartamentos", Type = "Apartamento pequeño", Kind = "home", District = "apartments", Buy = 9000, Rent = 220, Upkeep = 30, Storage = 90, Slots = 10, Env = 45, Studio = 3, W = 30, D = 26, Tags = { "urban", "home" } })
listing({ Id = "apt_modern", Name = "Apartamento moderno con balcón", Type = "Apartamento moderno", Kind = "home", District = "apartments", Buy = 22000, Rent = 450, Upkeep = 60, Storage = 130, Slots = 14, Env = 60, Studio = 5, W = 36, D = 30, Tags = { "urban", "home" } })
listing({ Id = "apt_luxury", Name = "Apartamento de lujo en el Centro financiero", Type = "Apartamento de lujo", Kind = "home", District = "financial", Buy = 85000, Rent = 1200, Upkeep = 200, Storage = 180, Slots = 20, Env = 80, Studio = 8, W = 44, D = 36, Req = { Level = 8, Subs = 0 }, Tags = { "luxury", "home", "business" } })
listing({ Id = "house_family", Name = "Casa familiar con jardín", Type = "Casa familiar", Kind = "home", District = "residential", Buy = 45000, Rent = 700, Upkeep = 120, Storage = 220, Slots = 22, Env = 65, Studio = 6, W = 46, D = 40, Tags = { "home", "urban" } })
listing({ Id = "house_modern", Name = "Casa moderna de diseño", Type = "Casa moderna", Kind = "home", District = "residential", Buy = 70000, Rent = 1000, Upkeep = 160, Storage = 240, Slots = 26, Env = 75, Studio = 8, W = 50, D = 42, Req = { Level = 5, Subs = 0 }, Tags = { "home", "luxury" } })
listing({ Id = "mansion", Name = "Mansión de la Avenida", Type = "Mansión", Kind = "home", District = "luxury", Buy = 400000, Upkeep = 900, Storage = 500, Slots = 50, Env = 95, Studio = 14, W = 80, D = 64, Req = { Level = 15, Subs = 50000 }, Pool = true, Tags = { "luxury", "home" } })
listing({ Id = "penthouse", Name = "Ático con vistas", Type = "Ático", Kind = "home", District = "financial", Buy = 250000, Rent = 3500, Upkeep = 600, Storage = 300, Slots = 36, Env = 92, Studio = 12, W = 60, D = 48, Req = { Level = 12, Subs = 10000 }, View = "Vista panorámica", Tags = { "luxury", "home", "night" } })
listing({ Id = "beach_house", Name = "Casa de playa", Type = "Casa de playa", Kind = "home", District = "coast", Buy = 150000, Rent = 1800, Upkeep = 300, Storage = 220, Slots = 28, Env = 88, Studio = 10, W = 52, D = 42, Req = { Level = 9, Subs = 0 }, View = "Vista al mar", Tags = { "beach", "home", "luxury" } })
listing({ Id = "rural_house", Name = "Casa rural", Type = "Casa rural", Kind = "home", District = "rural", Buy = 30000, Rent = 400, Upkeep = 70, Storage = 260, Slots = 22, Env = 70, Studio = 6, W = 46, D = 40, View = "Vista al campo", Tags = { "rural", "home", "nature" } })
listing({ Id = "mountain_cabin", Name = "Casa en la montaña", Type = "Casa de montaña", Kind = "home", District = "mountains", Buy = 40000, Rent = 500, Upkeep = 90, Storage = 160, Slots = 18, Env = 78, Studio = 7, W = 40, D = 34, View = "Vista a las cumbres", Tags = { "mountain", "home", "nature" } })
listing({ Id = "pool_house", Name = "Casa con piscina", Type = "Casa con piscina", Kind = "home", District = "luxury", Buy = 120000, Rent = 1500, Upkeep = 280, Storage = 260, Slots = 30, Env = 85, Studio = 9, W = 56, D = 46, Req = { Level = 7, Subs = 0 }, Pool = true, Tags = { "luxury", "home", "water" } })
listing({ Id = "pro_studio", Name = "Estudio profesional", Type = "Estudio profesional", Kind = "studio", District = "creators", Buy = 60000, Rent = 900, Upkeep = 150, Storage = 160, Slots = 24, Env = 70, Studio = 15, W = 44, D = 36, Req = { Level = 4, Subs = 0 }, Tags = { "studio" } })
listing({ Id = "shop_local", Name = "Local comercial", Type = "Local comercial", Kind = "business", District = "commercial", Buy = 50000, Rent = 800, Upkeep = 140, Storage = 200, Slots = 22, Env = 55, Studio = 5, W = 44, D = 34, Tags = { "shop", "business" } })
listing({ Id = "office", Name = "Oficina en la Zona de oficinas", Type = "Oficina", Kind = "business", District = "offices", Buy = 80000, Rent = 1000, Upkeep = 180, Storage = 180, Slots = 24, Env = 65, Studio = 6, W = 46, D = 36, Req = { Level = 6, Subs = 0 }, Tags = { "business" } })
listing({ Id = "rec_studio", Name = "Estudio de grabación insonorizado", Type = "Estudio de grabación", Kind = "studio", District = "studios", Buy = 110000, Rent = 1500, Upkeep = 250, Storage = 200, Slots = 28, Env = 75, Studio = 20, W = 50, D = 40, Req = { Level = 8, Subs = 0 }, Tags = { "studio" } })
listing({ Id = "warehouse", Name = "Almacén industrial", Type = "Almacén", Kind = "business", District = "industrial", Buy = 35000, Rent = 600, Upkeep = 100, Storage = 900, Slots = 30, Env = 35, Studio = 4, W = 60, D = 50, Tags = { "business" } })
listing({ Id = "garage", Name = "Garaje en el Barrio económico", Type = "Garaje", Kind = "garage", District = "budget", Buy = 8000, Rent = 150, Upkeep = 20, Storage = 160, Slots = 10, Env = 25, Studio = 2, W = 30, D = 26, Tags = { "urban" } })
listing({ Id = "land_lot", Name = "Terreno edificable", Type = "Terreno edificable", Kind = "land", District = "rural", Buy = 20000, Upkeep = 10, Storage = 60, Slots = 60, Env = 60, Studio = 4, W = 70, D = 70, Tags = { "rural", "nature" } })
listing({ Id = "loft_creators", Name = "Loft en el Barrio de creadores", Type = "Apartamento moderno", Kind = "home", District = "creators", Buy = 35000, Rent = 600, Upkeep = 80, Storage = 140, Slots = 18, Env = 62, Studio = 9, W = 40, D = 32, Tags = { "urban", "studio", "home" } })

PropertyData.Listings = L
PropertyData.ById = {}
for _, p in ipairs(L) do
	PropertyData.ById[p.Id] = p
end

-- Máximo de propiedades simultáneas según el nivel (no se pierde lo que ya tienes)
function PropertyData.maxProperties(level)
	if level >= 10 then
		return 6
	elseif level >= 5 then
		return 3
	end
	return 1
end

PropertyData.StarterStorage = 80

return PropertyData
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000012"><Properties><string name="Name">QuestDefs</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- QuestDefs: tutorial guiado + logros progresivos generados de forma reutilizable.
-- Cada logro se completa UNA sola vez y su recompensa se cobra una sola vez.

local QuestDefs = {}

-- Tutorial: avanza cuando ocurre el evento indicado en el paso actual.
-- Target: veces que debe ocurrir el evento. Marker: lugar al que apunta la flecha guía.
QuestDefs.Tutorial = {
	{ Id = "t_style", Name = "Elige tu apariencia", Event = "appearance", Hint = "Pulsa el botón ESTILO (o tecla V) y elige los colores de tu ropa.", Reward = { Money = 50, Xp = 20 } },
	{ Id = "t_phone", Name = "Abre tu teléfono", Event = "open_phone", Hint = "Pulsa el botón TELÉFONO o la tecla P. Siempre lo llevas contigo.", Reward = { Money = 50, Xp = 20 } },
	{ Id = "t_home", Name = "Conoce tu primera vivienda", Event = "enter_home", Hint = "Sigue la flecha hasta tu habitación en la Residencia Económica.", Marker = "home", Reward = { Money = 50, Xp = 20 } },
	{ Id = "t_pc", Name = "Usa un computador", Event = "open_computer", Hint = "Acércate al escritorio de tu habitación y pulsa E (o toca el aviso) para encender el computador.", Marker = "home", Reward = { Money = 75, Xp = 25 } },
	{ Id = "t_idea", Name = "Elige una idea", Event = "create_project", Hint = "En el computador abre la app IDEAS y crea un proyecto (prueba con «Compras» o «Tecnología»).", Reward = { Money = 75, Xp = 25 } },
	{ Id = "t_pack", Name = "Prepara la mochila", Event = "pack", Hint = "Abre INVENTARIO (tecla I) y mueve el trípode a la mochila. El teléfono siempre va contigo.", Reward = { Money = 50, Xp = 20 } },
	{ Id = "t_store", Name = "Visita una tienda", Event = "visit_store", Hint = "Sal de casa y entra en MegaTec (Zona comercial). Usa el TAXI del teléfono (app Mapa) si quieres llegar rápido.", Marker = "store_tech", Reward = { Money = 75, Xp = 25 } },
	{ Id = "t_record", Name = "Graba 3 escenas", Event = "record_scene", Target = 3, Hint = "Ve a un lugar de grabación (icono 🎥), pulsa GRABAR (tecla R), elige tu proyecto y graba 3 tomas.", Reward = { Money = 100, Xp = 40 } },
	{ Id = "t_return", Name = "Regresa a casa", Event = "enter_home", Hint = "Vuelve a tu habitación para organizar el material.", Marker = "home", Reward = { Money = 50, Xp = 20 } },
	{ Id = "t_edit", Name = "Edita el proyecto", Event = "save_edit", Hint = "En el computador abre EDITOR, importa el material, ordena las escenas y pulsa GUARDAR.", Marker = "home", Reward = { Money = 100, Xp = 40 } },
	{ Id = "t_thumb", Name = "Crea una miniatura", Event = "thumbnail", Hint = "Abre MINIATURAS, elige una foto o escena, añade texto y guarda el diseño.", Reward = { Money = 75, Xp = 30 } },
	{ Id = "t_publish", Name = "Publica el vídeo", Event = "publish", Hint = "En el EDITOR exporta el proyecto y luego publícalo desde YOUTUBE STUDIO.", Reward = { Money = 150, Xp = 60 } },
	{ Id = "t_stats", Name = "Consulta las estadísticas", Event = "open_analytics", Hint = "Abre ESTADÍSTICAS (en el computador o en el teléfono) y mira cómo crece tu vídeo.", Reward = { Money = 50, Xp = 20 } },
	{ Id = "t_claim", Name = "Cobra tus primeras recompensas", Event = "claim_reward", Hint = "Abre MISIONES (tecla M) y cobra un logro completado.", Reward = { Money = 50, Xp = 20 } },
	{ Id = "t_upgrade", Name = "Compra una mejora", Event = "buy_item", Hint = "Compra equipo en una tienda física o en la app TIENDA. ¡Una cámara mejora mucho tus vídeos!", Reward = { Money = 100, Xp = 40 } },
	{ Id = "t_explore", Name = "Explora una nueva zona", Event = "new_district", Hint = "Visita un distrito en el que no hayas estado. Hay 30 y algunos esconden secretos.", Reward = { Money = 150, Xp = 60 } },
}

