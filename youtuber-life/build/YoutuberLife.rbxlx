---------------------------------------------------------------------------
-- TELÉFONOS Y TABLETAS
---------------------------------------------------------------------------
local phones = {
	{ "phone_basic", "Nexo Fon A1", 0, 20, 30, 25, 8, 40, false, false, true },
	{ "phone_mid", "Orbis Phone 12", 450, 50, 55, 50, 12, 80, false, false, false },
